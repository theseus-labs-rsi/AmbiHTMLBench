        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>宝宝腹泻怎么办</title>\n<style>\n    body {\n        background-color: #e3d5f0;\n        margin: 0;\n        padding: 40px 20px;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        min-height: 100vh;\n        font-family: -apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Microsoft YaHei\", \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n        box-sizing: border-box;\n    }\n\n    .container {\n        background-color: #ffffff;\n        border-radius: 24px;\n        padding: 30px 25px 35px 25px;\n        width: 100%;\n        max-width: 700px;\n        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);\n    }\n\n    .main-title {\n        font-size: 44px;\n        font-weight: 900;\n        color: #ffffff;\n        text-align: center;\n        margin: 0 0 35px 0;\n        letter-spacing: 2px;\n        /* Simulate thick stroke and drop shadow */\n        -webkit-text-stroke: 2px #7152a5;\n        text-shadow: \n            -1px -1px 0 #7152a5,\n             1px -1px 0 #7152a5,\n            -1px  1px 0 #7152a5,\n             1px  1px 0 #7152a5,\n             0px  5px 0 #7152a5;\n    }\n\n    .grid-layout {\n        display: grid;\n        grid-template-columns: 1fr 1fr;\n        gap: 35px 20px;\n    }\n\n    .card {\n        background-color: #f3ecfb;\n        border-radius: 16px;\n        padding: 28px 16px 16px 16px;\n        position: relative;\n    }\n\n    .card-title {\n        position: absolute;\n        top: -18px;\n        left: 50%;\n        transform: translateX(-50%);\n        background-color: #b19bdd;\n        color: #ffffff;\n        font-size: 17px;\n        font-weight: bold;\n        padding: 5px 20px;\n        border-radius: 20px;\n        border: 4px solid #ffffff;\n        white-space: nowrap;\n        letter-spacing: 1px;\n    }\n\n    .row {\n        display: flex;\n        align-items: flex-start;\n        margin-bottom: 10px;\n    }\n\n    .row:last-child {\n        margin-bottom: 0;\n    }\n\n    .label {\n        background-color: #b19bdd;\n        color: #ffffff;\n        font-size: 13px;\n        font-weight: bold;\n        padding: 2px 6px;\n        border-radius: 4px;\n        margin-right: 8px;\n        flex-shrink: 0;\n        margin-top: 2px;\n        letter-spacing: 1px;\n    }\n\n    .text {\n        font-size: 14px;\n        color: #333333;\n        line-height: 1.5;\n        flex-grow: 1;\n    }\n\n    @media (max-width: 600px) {\n        .grid-layout {\n            grid-template-columns: 1fr;\n        }\n        .main-title {\n            font-size: 36px;\n        }\n    }\n</style>\n</head>\n<body>\n\n<div class=\"container\">\n    <h1 class=\"main-title\">宝宝腹泻怎么办</h1>\n    \n    <div class=\"grid-layout\">\n        <!-- Card 1 -->\n        <div class=\"card\">\n            <div class=\"card-title\">病毒性腹泻</div>\n            <div class=\"row\">\n                <span class=\"label\">原因</span>\n                <span class=\"text\">轮状病毒引起秋冬季多发</span>\n            </div>\n            <div class=\"row\">\n                <span class=\"label\">症状</span>\n                <span class=\"text\">呕吐发烧，上呼吸道感染</span>\n            </div>\n            <div class=\"row\">\n                <span class=\"label\">大便</span>\n                <span class=\"text\">大便呈水样</span>\n            </div>\n            <div class=\"row\">\n                <span class=\"label\">护理</span>\n                <span class=\"text\">辅食清淡易消化</span>\n            </div>\n        </div>\n\n        <!-- Card 2 -->\n        <div class=\"card\">\n            <div class=\"card-title\">过敏性腹泻</div>\n            <div class=\"row\">\n                <span class=\"label\">原因</span>\n                <span class=\"text\">食物中的蛋白质过敏</span>\n            </div>\n            <div class=\"row\">\n                <span class=\"label\">症状</span>\n                <span class=\"text\">湿疹、荨麻疹、哮喘</span>\n            </div>\n            <div class=\"row\">\n                <span class=\"label\">大便</span>\n                <span class=\"text\">大便增多，无明显水样便</span>\n            </div>\n            <div class=\"row\">\n                <span class=\"label\">护理</span>\n                <span class=\"text\">辅食避开过敏原，<br>换深度水解奶粉</span>\n            </div>\n        </div>\n\n        <!-- Card 3 -->\n        <div class=\"card\">\n            <div class=\"card-title\">喂养不当腹泻</div>\n            <div class=\"row\">\n                <span class=\"label\">原因</span>\n                <span class=\"text\">辅食添加过早过杂致消化不良</span>\n            </div>\n            <div class=\"row\">\n                <span class=\"label\">症状</span>\n                <span class=\"text\">呕吐，哭闹</span>\n            </div>\n            <div class=\"row\">\n                <span class=\"label\">大便</span>\n                <span class=\"text\">有泡沫，混有颗粒物/黏液</span>\n            </div>\n            <div class=\"row\">\n                <span class=\"label\">护理</span>\n                <span class=\"text\">暂停或减少辅食，清淡<br>饮食，少量多次治疗</span>\n            </div>\n        </div>\n\n        <!-- Card 4 -->\n        <div class=\"card\">\n            <div class=\"card-title\">细菌性腹泻</div>\n            <div class=\"row\">\n                <span class=\"label\">原因</span>\n                <span class=\"text\">病原微生物引起在夏季高发</span>\n            </div>\n            <div class=\"row\">\n                <span class=\"label\">症状</span>\n                <span class=\"text\">腹痛恶心，发热，没食欲</span>\n            </div>\n            <div class=\"row\">\n                <span class=\"label\">大便</span>\n                <span class=\"text\">大便稀且有黏液，严重时便血</span>\n            </div>\n            <div class=\"row\">\n                <span class=\"label\">护理</span>\n                <span class=\"text\">补液避免脱水，<br>注意饮食卫生</span>\n            </div>\n        </div>\n\n        <!-- Card 5 -->\n        <div class=\"card\">\n            <div class=\"card-title\">乳糖不耐受腹泻</div>\n            <div class=\"row\">\n                <span class=\"label\">原因</span>\n                <span class=\"text\">由于肠道中缺乏乳糖酶引起</span>\n            </div>\n            <div class=\"row\">\n                <span class=\"label\">症状</span>\n                <span class=\"text\">肠胀气、肠绞痛，吃奶就拉</span>\n            </div>\n            <div class=\"row\">\n                <span class=\"label\">大便</span>\n                <span class=\"text\">次数多，大便有奶瓣泡沫状</span>\n            </div>\n            <div class=\"row\">\n                <span class=\"label\">护理</span>\n                <span class=\"text\">母乳妈妈忌口高糖和奶制品</span>\n            </div>\n        </div>\n\n        <!-- Card 6 -->\n        <div class=\"card\">\n            <div class=\"card-title\">受凉引起腹泻</div>\n            <div class=\"row\">\n                <span class=\"label\">原因</span>\n                <span class=\"text\">由腹部或身体受凉引起</span>\n            </div>\n            <div class=\"row\">\n                <span class=\"label\">症状</span>\n                <span class=\"text\">胃胀，恶心，呕吐，屁多</span>\n            </div>\n            <div class=\"row\">\n                <span class=\"label\">大便</span>\n                <span class=\"text\">大便水样，有泡沫</span>\n            </div>\n            <div class=\"row\">\n                <span class=\"label\">护理</span>\n                <span class=\"text\">注意身体和肚子保暖，<br>不吃生冷辛辣</span>\n            </div>\n        </div>\n    </div>\n</div>\n\n</body>\n</html>"
