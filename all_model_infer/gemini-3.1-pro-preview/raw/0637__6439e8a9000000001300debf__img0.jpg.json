\n        }\n\n        .faces-placeholder {\n            width: 100%;\n            height: 70px;\n            margin-bottom: 15px;\n            border-radius: 5px;\n        }\n\n        .poem-wrapper {\n            display: flex;\n            align-items: stretch;\n            width: 100%;\n        }\n\n        .poem-wrapper .text-box {\n            flex: 1;\n        }\n\n        .boy-placeholder {\n            width: 90px;\n            height: 220px;\n            margin-left: 15px;\n            border-radius: 5px;\n        }\n\n        /* Word Lists */\n        .section-title {\n            font-size: 26px;\n            font-weight: bold;\n            margin-bottom: 25px;\n            font-family: \"Comic Sans MS\", cursive, sans-serif;\n            color: #111;\n        }\n\n        .word-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            row-gap: 20px;\n            column-gap: 10px;\n            font-size: 24px;\n            font-weight: bold;\n            color: #111;\n        }\n\n        .highlight {\n            color: #e63946;\n        }\n\n        /* Footer */\n        .footer {\n            text-align: center;\n            position: relative;\n            margin-top: 60px;\n            padding-bottom: 10px;\n        }\n\n        .footer-line {\n            height: 18px;\n            background-color: #e5f4ce;\n            width: 100%;\n            position: absolute;\n            top: 40px;\n            left: 0;\n            z-index: 1;\n        }\n\n        .bear-placeholder {\n            width: 180px;\n            height: 120px;\n            margin: 0 auto;\n            position: relative;\n            z-index: 2;\n            background-color: #fff;\n            border: 2px dashed #f4a261;\n            border-radius: 10px;\n        }\n\n        .footer-text-group {\n            position: relative;\n            z-index: 2;\n            margin-top: 15px;\n        }\n\n        .footer-text {\n            font-size