ample-item {\n    margin-bottom: 16px;\n  }\n  .eng-line {\n    color: #1e70b8;\n    font-size: 19px;\n    font-weight: 600;\n    line-height: 1.5;\n    margin-bottom: 4px;\n  }\n  .chn-line {\n    color: #2b2b2b;\n    font-size: 17px;\n    font-weight: 500;\n    line-height: 1.5;\n    padding-left: 24px;\n  }\n  .red {\n    color: #c93a4a;\n    font-weight: 700;\n  }\n  .highlight {\n    background-color: #cdf0cb;\n    padding: 1px 4px;\n    border-radius: 2px;\n  }\n</style>\n</head>\n<body>\n\n  <div class=\"header-banner-area\">\n    <div class=\"yellow-pill\">就近原则总结</div>\n  </div>\n\n  <div class=\"content-container\">\n    <div class=\"watermark\">五口<br>英语</div>\n\n    <div class=\"main-title\">就近原则</div>\n\n    <div class=\"rules-table\">\n      <div class=\"rule-row\">\n        <div class=\"rule-left\">1.or</div>\n        <div class=\"rule-right\">或者</div>\n      </div>\n      <div class=\"rule-row\">\n        <div class=\"rule-left\">2.there be</div>\n        <div class=\"rule-right\">有</div>\n      </div>\n      <div class=\"rule-row\">\n        <div class=\"rule-left\">3.either...or...</div>\n        <div class=\"rule-right\">要么...要么.../或者...或者...</div>\n      </div>\n      <div class=\"rule-row\">\n        <div class=\"rule-left\">4.neither ...nor...</div>\n        <div class=\"rule-right\">既不... 也不...</div>\n      </div>\n      <div class=\"rule-row\">\n        <div class=\"rule-left\">5.not only ... but also...</div>\n        <div class=\"rule-right\">不但...而且...</div>\n      </div>\n      <div class=\"rule-row\">\n        <div class=\"rule-left\">6.not...but...</div>\n        <div class=\"rule-right\">不是...而是...</div>\n      </div>\n      <div class=\"rule-row\">\n        <div class=\"rule-left\">7.whether ...or...</div>\n        <div class=\"rule-right\">是...还是...</div>\n      </div>\n    </div>\n\n    <div class=\"examples-section\">\n      <div class=\"example-item\">\n        <div class=\"eng-line\">1. Kids <span class=\"red\">or</span> <span clas