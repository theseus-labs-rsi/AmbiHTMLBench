        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>NIST SP 800-160, Vol. 2, Rev. 1 Table</title>\n<style>\n  body {\n    font-family: Arial, sans-serif;\n    margin: 0;\n    padding: 20px;\n    background-color: #fff;\n    color: #000;\n  }\n  .header, .footer {\n    display: flex;\n    justify-content: space-between;\n    font-size: 0.75rem;\n    margin-bottom: 10px;\n  }\n  .footer {\n    margin-top: 20px;\n    margin-bottom: 0;\n  }\n  .header-line {\n    border-bottom: 1px solid #000;\n    margin-bottom: 20px;\n  }\n  table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 0.8rem;\n    table-layout: fixed;\n  }\n  th, td {\n    border: 1px solid #000;\n    padding: 8px;\n    vertical-align: top;\n    word-wrap: break-word;\n  }\n  th {\n    background-color: #1a426f;\n    color: white;\n    text-align: center;\n    font-weight: bold;\n  }\n  td {\n    background-color: #c9dbf1;\n  }\n  .sideways-text {\n    position: fixed;\n    left: -250px;\n    top: 50%;\n    transform: translateY(-50%) rotate(-90deg);\n    font-size: 0.6rem;\n    color: #888;\n    white-space: nowrap;\n  }\n  a {\n    color: blue;\n    text-decoration: underline;\n  }\n  /* Column widths */\n  th:nth-child(1), td:nth-child(1) { width: 15%; }\n  th:nth-child(2), td:nth-child(2) { width: 25%; }\n  th:nth-child(3), td:nth-child(3) { width: 20%; }\n  th:nth-child(4), td:nth-child(4) { width: 15%; }\n  th:nth-child(5), td:nth-child(5) { width: 25%; }\n\n</style>\n</head>\n<body>\n\n<div class=\"sideways-text\">This publication is available free of charge from: https://doi.org/10.6028/NIST.SP.800-160v2r1</div>\n\n<div class=\"header\">\n  <span>NIST SP 800-160, VOL. 2, REV. 1</span>\n  <span>DEVELOPING CYBER-RESILIENT SYSTEMS</span>\n</div>\n<div class=\"header-line\"></div>\n\n<table>\n  <thead>\n    <tr>\n      <th>ATT&CK<br>Technique</th>\n      <th>Mitiga