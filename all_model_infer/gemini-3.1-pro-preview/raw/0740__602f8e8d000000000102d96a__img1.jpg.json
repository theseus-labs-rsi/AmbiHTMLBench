rder: 1.5px solid #8b7355;\n        border-radius: 12px;\n        position: relative;\n        padding: 35px 8px 15px 8px;\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        box-sizing: border-box;\n    }\n    \n    .col-title-wrapper {\n        position: absolute;\n        top: -15px;\n        left: 50%;\n        transform: translateX(-50%);\n        background-color: #fdf6e6;\n        padding: 0 8px;\n    }\n    \n    .col-title {\n        background-color: #ffeba8;\n        color: #6b5947;\n        font-weight: bold;\n        font-size: 1.1rem;\n        padding: 4px 12px;\n        border-radius: 15px;\n        white-space: nowrap;\n        letter-spacing: 1px;\n    }\n    \n    .flow-item {\n        font-size: 0.95rem;\n        text-align: center;\n        margin: 6px 0;\n        font-weight: 500;\n        width: 100%;\n    }\n    \n    .text-red {\n        color: #d9281c;\n    }\n    \n    .arrow {\n        width: 0;\n        height: 0;\n        border-left: 8px solid transparent;\n        border-right: 8px solid transparent;\n        border-top: 10px solid #d9281c;\n        margin: 4px 0;\n    }\n\n    /* Tips section */\n    .tips-container {\n        font-size: 0.95rem;\n        line-height: 1.6;\n        letter-spacing: 0.5px;\n    }\n    \n    .tip-item {\n        display: flex;\n        align-items: flex-start;\n        margin-bottom: 8px;\n    }\n    \n    .bullet {\n        color: #ff9a00;\n        margin-right: 6px;\n        font-size: 1.1rem;\n        line-height: 1.5;\n    }\n    \n    .tip-text {\n        flex: 1;\n    }\n    \n    .ul-yellow {\n        border-bottom: 3px solid #ffcc00;\n        padding-bottom: 1px;\n    }\n    \n    .ul-pink {\n        border-bottom: 2px solid #ff99cc;\n        padding-bottom: 1px;\n    }\n    \n    .ul-blue {\n        border-bottom: 3px solid #6699ff;\n        padding-bottom: 1px;\n    }\n    \n    .circle-hl {\n        border: 2px solid #e68a2e;\n        border-radius: 50%;\n        padding: 2px 4px;\n        margin: 0 2px;\n    }\n    \n    .inline-star {\n        color: #ffcc00;\n        font-size: 1.1em;\n        margin-right: 2px;\n        margin-left: 4px;\n    }\n</style>\n</head>\n<body>\n\n<div class=\"document-container\">\n    <!-- Header -->\n    <div class=\"header\">\n        <div class=\"yellow-circles\">\n            <div class=\"circle\"></div>\n            <div class=\"circle\"></div>\n            <div class=\"circle\"></div>\n            <div class=\"circle\"></div>\n            <div class=\"circle\"></div>\n        </div>\n        <div class=\"title-text\">PP追奶法</div>\n        <div class=\"sparkle\" style=\"top: -5px; left: 18%; transform: rotate(-15deg); font-size: 22px;\">✦</div>\n        <div class=\"sparkle\" style=\"top: 35px; left: 12%; font-size: 14px;\">✦</div>\n        <div class=\"sparkle\" style=\"top: -2px; right: 22%; font-size: 18px;\">✦</div>\n        <div class=\"sparkle\" style=\"top: 30px; right: 12%; transform: rotate(15deg); font-size: 26px;\">✦</div>\n    </div>\n\n    <!-- Columns -->\n    <div class=\"columns-container\">\n        <!-- Left Box -->\n        <div class=\"column\">\n            <div class=\"col-title-wrapper\">\n                <div class=\"col-title\">单边吸奶器</div>\n            </div>\n            \n            <div class=\"flow-item\">左边吸10分钟，右边吸10分钟</div>\n            <div class=\"arrow\"></div>\n            \n            <div class=\"flow-item text-red\">休息5分钟</div>\n            <div class=\"arrow\"></div>\n            \n            <div class=\"flow-item\">左边吸10分钟，右边吸10分钟</div>\n            <div class=\"arrow\"></div>\n            \n            <div class=\"flow-item text-red\">休息5分钟</div>\n            <div class=\"arrow\"></div>\n            \n            <div class=\"flow-item\">左边吸10分钟，右边吸10分钟</div>\n        </div>\n        \n        <!-- Right Box -->\n        <div class=\"column\">\n            <div class=\"col-title-wrapper\">\n                <div class=\"col-title\">双边吸奶器</div>\n            </div>\n            \n            <div class=\"flow-item\">双边吸20分钟基础排空</div>\n            <div class=\"arrow\"></div>\n            \n            <div class=\"flow-item text-red\">按摩10分钟预备排后奶</div>\n            <div class=\"arrow\"></div>\n            \n            <div class=\"flow-item\">双边吸10分钟排出后奶</div>\n            <div class=\"arrow\"></div>\n            \n            <div class=\"flow-item text-red\">休息10分钟</div>\n            <div class=\"arrow\"></div>\n            \n            <div class=\"flow-item\">双边吸10分钟泌乳信号</div>\n        </div>\n    </div>\n\n    <!-- Tips -->\n    <div class=\"tips-container\">\n        <div class=\"tip-item\">\n            <div class=\"bullet\">◆</div>\n            <div class=\"tip-text\">\n                PP法进行的最佳时间是晚上11点到次日凌晨5点，这个时间段是<span class=\"ul-yellow\">泌乳高峰期</span>，<span class=\"inline-star\">✦</span>尽量每天选固定的一个小时进行。\n            </div>\n        </div>\n        \n        <div class=\"tip-item\">\n            <div class=\"bullet\">◆</div>\n            <div class=\"tip-text\">\n                三次吸奶中间有5~10分钟的休息时间，<span class=\"ul-pink\">小口喝一些温开水</span>，有助于血液循环，另外，配合手掌<span class=\"ul-pink\">轻轻按摩乳头</span>，或者用<span class=\"ul-pink\">热毛巾敷一敷</span>乳房，有助于刺激奶阵的产生。\n            </div>\n        </div>\n        \n        <div class=\"tip-item\">\n            <div class=\"bullet\">◆</div>\n            <div class=\"tip-text\">\n                后续如果没有<span class=\"circle-hl\">奶阵</span>了不要空吸，将吸奶器换成按摩泌乳模式继续可以吸出奶阵。\n            </div>\n        </div>\n        \n        <div class=\"tip-item\">\n            <div class=\"bullet\">◆</div>\n            <div class=\"tip-text\">\n                吸奶器是否适合自己<span class=\"ul-blue\">也很关键</span>，有时候吸不出奶和吸奶器也有关系。\n            </div>\n        </div>\n    </div>\n</div>\n\n</body>\n</html>"
