  <td>Lockstep</td>\n                    <td class=\"center-text blue\">Optional<sup>(1)</sup></td>\n                </tr>\n                <tr>\n                    <td>Device Management Security Controller</td>\n                    <td>DMSC</td>\n                    <td class=\"center-text\">Yes</td>\n                </tr>\n                <tr>\n                    <td>C7x Floating Point, Vector DSP</td>\n                    <td>C7x DSP</td>\n                    <td class=\"center-text\">Yes</td>\n                </tr>\n                <tr>\n                    <td>Deep Learning Accelerator</td>\n                    <td>MMA</td>\n                    <td class=\"center-text\">Yes</td>\n                </tr>\n                <tr>\n                    <td>Two C66x Floating Point DSP</td>\n                    <td>C66x DSP</td>\n                    <td class=\"center-text\">Dual Core</td>\n                </tr>\n                <tr>\n                    <td>Graphics Accelerator 3D GPU PowerVR Rogue 8XE GE8430</td>\n                    <td>GPU</td>\n                    <td class=\"center-text\">Yes</td>\n                </tr>\n                <tr>\n                    <td>Depth and Motion Processing Accelerators</td>\n                    <td>DMPAC</td>\n                    <td class=\"center-text\">Yes</td>\n                </tr>\n                <tr>\n                    <td>Vision Processing Accelerators</td>\n                    <td>VPAC</td>\n                    <td class=\"center-text\">Yes</td>\n                </tr>\n                <tr>\n                    <td>Security Accelerators</td>\n                    <td>SA</td>\n                    <td class=\"center-text\">Yes</td>\n                </tr>\n                <tr>\n                    <td>Video Encoder / Decoder</td>\n                    <td>VENC/ VDEC</td>\n                    <td class=\"center-text\">Yes</td>\n                </tr>\n                <tr class=\"section-header\">\n                    <td c