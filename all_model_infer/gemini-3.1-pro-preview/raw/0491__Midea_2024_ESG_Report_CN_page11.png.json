        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>美的集团ESG报告 - 气候变化与治理</title>\n<style>\n    * {\n        box-sizing: border-box;\n        margin: 0;\n        padding: 0;\n        font-family: \"PingFang SC\", \"Microsoft YaHei\", \"Heiti SC\", sans-serif;\n    }\n    body {\n        display: flex;\n        justify-content: center;\n        background-color: #e0e0e0;\n        padding: 20px;\n    }\n    .spread {\n        display: flex;\n        width: 1400px;\n        height: 960px;\n        background: #fff;\n        box-shadow: 0 4px 15px rgba(0,0,0,0.2);\n        overflow: hidden;\n    }\n    \n    /* --- Page General --- */\n    .page {\n        width: 50%;\n        height: 100%;\n        position: relative;\n    }\n    .page-number {\n        position: absolute;\n        bottom: 30px;\n        font-size: 14px;\n        z-index: 10;\n    }\n    \n    /* --- Left Page (Page 19) --- */\n    .left-page {\n        padding: 60px 50px;\n        color: #333;\n    }\n    .left-page .page-number {\n        left: 50px;\n        color: #fff;\n    }\n    .bg-placeholder {\n        position: absolute;\n        top: 0;\n        left: 0;\n        width: 100%;\n        height: 100%;\n        z-index: 1;\n        background: linear-gradient(180deg, #d2e8e5 0%, #b8dad5 30%, #87bfae 100%);\n        display: flex;\n        align-items: flex-end;\n    }\n    .photo-placeholder {\n        width: 100%;\n        height: 70%;\n        border-top: 2px dashed #00A3A0;\n        background: rgba(0,0,0,0.1);\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        color: #fff;\n        font-size: 18px;\n        text-shadow: 1px 1px 3px rgba(0,0,0,0.5);\n    }\n    .left-content {\n        position: relative;\n        z-index: 2;\n    }\n    .doc-header {\n        font-size: 13px;\n        color: #555;\n        margin-bottom: 90px;\n        letter-spacing: 0.5px;\n    }\n    .badge {\n        display: inline-block;\n        background-color: #00A3A0;\n        color: #fff;\n        font-size: 24px;\n        padding: 6px 28px;\n        border-radius: 30px;\n        margin-bottom: 25px;\n    }\n    .main-title {\n        font-size: 38px;\n        color: #00A3A0;\n        font-weight: 500;\n        margin-bottom: 35px;\n        letter-spacing: 1px;\n    }\n    .intro-text {\n        font-size: 13.5px;\n        line-height: 2;\n        color: #444;\n        text-align: justify;\n        width: 90%;\n    }\n\n    /* --- Right Page (Page 20) --- */\n    .right-page {\n        padding: 60px 50px;\n        background: #fff;\n        display: flex;\n        flex-direction: column;\n    }\n    .right-page .page-number {\n        right: 50px;\n        color: #666;\n    }\n    .nav {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        font-size: 13px;\n        color: #888;\n        margin-bottom: 60px;\n        width: 100%;\n    }\n    .nav span {\n        cursor: default;\n    }\n    .nav .active {\n        color: #00A3A0;\n        border: 1px solid #00A3A0;\n        padding: 2px 12px;\n        border-radius: 12px;\n    }\n    .section-title {\n        font-size: 28px;\n        color: #00A3A0;\n        font-weight: 500;\n        margin-bottom: 25px;\n    }\n    .gov-text {\n        font-size: 13.5px;\n        line-height: 1.9;\n        color: #444;\n        text-align: justify;\n        margin-bottom: 30px;\n    }\n\n    /* --- Org Chart --- */\n    .chart-container {\n        background-color: #eff9f8;\n        padding: 40px 20px 25px;\n        border-radius: 4px;\n        flex-grow: 1;\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        position: relative;\n    }\n    .org-card {\n        background: #fff;\n        border: 1.5px solid #00A3A0;\n        border-radius: 6px;\n        position: relative;\n        width: 100%;\n        margin-bottom: 0;\n        padding: 20px 10px 15px;\n    }\n    .org-pill {\n        background: #00A3A0;\n        color: #fff;\n        padding: 6px 24px;\n        border-radius: 20px;\n        font-size: 14px;\n        position: absolute;\n        top: -16px;\n        left: 50%;\n        transform: translateX(-50%);\n        white-space: nowrap;\n    }\n    .card-content {\n        display: flex;\n        font-size: 12px;\n        color: #555;\n        line-height: 1.6;\n    }\n    \n    /* Level 1 */\n    .level-1 { width: 75%; }\n    .level-1 .card-content { justify-content: space-around; text-align: center; }\n    \n    /* Level 2 */\n    .level-2 { width: 96%; }\n    .level-2 .card-content { justify-content: space-between; gap: 15px; text-align: left; }\n    .level-2 .card-content > div { flex: 1; }\n    \n    /* Lines */\n    .vline { width: 1.5px; background: #00A3A0; height: 25px; margin: 0 auto; }\n    \n    /* Level 3 & 4 Layout */\n    .l3-wrapper {\n        width: 96%;\n        display: flex;\n        justify-content: space-between;\n        gap: 20px;\n    }\n    .l3-left {\n        flex: 2.7;\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n    }\n    .l3-right {\n        flex: 1;\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n    }\n    \n    .l4-pill {\n        background: #00A3A0;\n        color: #fff;\n        padding: 5px 12px;\n        border-radius: 20px;\n        font-size: 11px;\n        text-align: center;\n        margin-bottom: 15px;\n        display: inline-block;\n        line-height: 1.3;\n    }\n    .l4-col {\n        flex: 1;\n        text-align: left;\n        padding: 0 5px;\n    }\n    .l4-text {\n        font-size: 11.5px;\n        color: #555;\n        line-height: 1.6;\n    }\n</style>\n</head>\n<body>\n\n<div class=\"spread\">\n    <!-- Left Page (19) -->\n    <div class=\"page left-page\">\n        <div class=\"bg-placeholder placeholder\">\n            <div class=\"photo-placeholder\">\n                [Photo: Modern building with lawn and lake]\n            </div>\n        </div>\n        <div class=\"left-content\">\n            <div class=\"doc-header\">2024 · 美的集团ESG报告</div>\n            <div class=\"badge\">专题</div>\n            <h1 class=\"main-title\">向零笃行 应对气候挑战</h1>\n            <p class=\"intro-text\">\n                气候变化是全球面临的共同挑战。为了响应国家适应气候变化的<br>\n                战略，美的集团参考国际可持续发展准则理事会（ISSB）发布的<br>\n                IFRS S2《国际财务报告可持续披露准则第2号 — 气候相关披露》<br>\n                的披露建议，进一步完善气候变化治理框架及气候风险的识别与<br>\n                管理流程，识别与自身经营相关的气候变化风险与机遇并落实气<br>\n                候变化应对措施，助力全球气候变化治理，全面推进美的集团可<br>\n                持续发展。\n            </p>\n        </div>\n        <div class=\"page-number\">19</div>\n    </div>\n\n    <!-- Right Page (20) -->\n    <div class=\"page right-page\">\n        <!-- Navigation Header -->\n        <div class=\"nav\">\n            <span>关于本报告</span>\n            <span>走进美的</span>\n            <span>可持续发展治理</span>\n            <span class=\"active\">守护蓝色星球</span>\n            <span>构建和谐社区</span>\n            <span>践行科技尽善</span>\n            <span>共创繁荣生态</span>\n            <span>附录</span>\n        </div>\n        \n        <!-- Content -->\n        <h2 class=\"section-title\">治理</h2>\n        <p class=\"gov-text\">\n            美的集团高度重视气候变化治理工作，将气候问题的治理纳入整体的ESG管治架构中，搭建了由董事会、ESG<br>\n            委员会、ESG执行组及ESG秘书处、三大ESG分委会组成的四层级气候变化治理架构，明确管理层在评估和管<br>\n            理气候风险方面的职责，确保对气候变化相关事宜进行妥善管理。此外，董事会薪酬与考核委员会负责对核心<br>\n            经营指标进行评估，这些指标涵盖了可持续发展绩效。委员会将评估结果与相关管理层的绩效紧密挂钩，并据<br>\n            此进行考核。\n        </p>\n\n        <!-- Organizational Chart -->\n        <div class=\"chart-container\">\n            <!-- Level 1 -->\n            <div class=\"org-card level-1\">\n                <div class=\"org-pill\">美的集团董事会</div>\n                <div class=\"card-content\">\n                    <div style=\"width: 45%;\">监督气候管理方法的有效性</div>\n                    <div style=\"width: 45%;\">监督气候议题的管理进展及表现，<br>包括目标进度等</div>\n                </div>\n            </div>\n            \n            <div class=\"vline\"></div>\n\n            <!-- Level 2 -->\n            <div class=\"org-card level-2\">\n                <div class=\"org-pill\">ESG委员会</div>\n                <div class=\"card-content\">\n                    <div>负责监督和指导美的集团<br>气候变化相关事宜，并向<br>董事会进行汇报</div>\n                    <div>制定并检讨气候相关策<br>略、管理及考核方法</div>\n                    <div>评估气候相关风险和机遇，<br>定期审阅与检讨气候相关<br>的目标及主要举措</div>\n                    <div>确定并管理用于识别、<br>缓解和监测气候相关的<br>预算、资源和投资情况</div>\n                </div>\n            </div>\n            \n            <div class=\"vline\"></div>\n\n            <!-- Fork L2 to L3 -->\n            <div style=\"position: relative; width: 100%; height: 20px;\">\n                <div style=\"position: absolute; top: 0; left: 36%; width: 50%; border-top: 1.5px solid #00A3A0;\"></div>\n                <div style=\"position: absolute; top: 0; left: 36%; height: 100%; border-left: 1.5px solid #00A3A0;\"></div>\n                <div style=\"position: absolute; top: 0; left: 86%; height: 100%; border-left: 1.5px solid #00A3A0;\"></div>\n            </div>\n\n            <!-- Level 3 & 4 -->\n            <div class=\"l3-wrapper\">\n                <!-- Left Branch (ESG执行组) -->\n                <div class=\"l3-left\">\n                    <div class=\"org-card\" style=\"padding-top: 25px;\">\n                        <div class=\"org-pill\">ESG执行组</div>\n                        <div class=\"card-content\" style=\"text-align: center; justify-content: center;\">\n                            推进落实与定期检讨美的集团气候变化战<br>略及风险与机遇管理等事宜\n                        </div>\n                    </div>\n                    \n                    <div class=\"vline\"></div>\n                    \n                    <!-- Fork L3 to L4 (3 sub-committees) -->\n                    <div style=\"position: relative; width: 100%; height: 25px;\">\n                        <div style=\"position: absolute; top: 0; left: 16.66%; width: 66.66%; border-top: 1.5px solid #00A3A0;\"></div>\n                        <div style=\"position: absolute; top: 0; left: 16.66%; height: 100%; border-left: 1.5px solid #00A3A0;\"></div>\n                        <div style=\"position: absolute; top: 0; left: 50%; height: 100%; border-left: 1.5px solid #00A3A0;\"></div>\n                        <div style=\"position: absolute; top: 0; left: 83.33%; height: 100%; border-left: 1.5px solid #00A3A0;\"></div>\n                    </div>\n\n                    <div style=\"display: flex; width: 100%;\">\n                        <div class=\"l4-col\">\n                            <div style=\"text-align: center;\"><div class=\"l4-pill\">绿色制造与碳排放管理分委会</div></div>\n                            <div class=\"l4-text\">负责落实气候相关风险<br>和机遇的日常管理和执<br>行工作</div>\n                        </div>\n                        <div class=\"l4-col\">\n                            <div style=\"text-align: center;\"><div class=\"l4-pill\">绿色设计与产品碳足迹分委会</div></div>\n                            <div class=\"l4-text\">识别气候变化相关风险、<br>积极采取应对措施</div>\n                        </div>\n                        <div class=\"l4-col\">\n                            <div style=\"text-align: center;\"><div class=\"l4-pill\">绿色供应与冲突矿产分委会</div></div>\n                            <div class=\"l4-text\">协调各事业群/事业部，<br>促进其有效合作</div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Right Branch (ESG秘书处) -->\n                <div class=\"l3-right\">\n                    <div class=\"org-card\" style=\"padding-top: 25px;\">\n                        <div class=\"org-pill\">ESG秘书处</div>\n                        <div class=\"card-content\" style=\"text-align: center; justify-content: center;\">\n                            跟踪事业群/事业部气候相关绩效及具体管<br>理举措的执行和实施情况\n                        </div>\n                    </div>\n                    \n                    <div class=\"vline\" style=\"height: 60px;\"></div>\n                    \n                    <div style=\"width: 100%; padding: 0 5px;\">\n                        <div class=\"l4-text\">评估、管理和监测气候相<br>关问题，提供全面的分析、<br>建议和更新内容，供董事<br>会和ESG委员会审议</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        \n        <div class=\"page-number\">20</div>\n    </div>\n</div>\n\n</body>\n</html>"
