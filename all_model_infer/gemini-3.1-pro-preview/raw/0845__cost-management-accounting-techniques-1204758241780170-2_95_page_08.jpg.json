&nbsp; 9</td>\n                <td class=\"col-make\">180,000</td>\n                <td class=\"col-buy\"></td>\n            </tr>\n            <!-- Row: Direct labor -->\n            <tr>\n                <td class=\"col-desc\">Direct labor</td>\n                <td class=\"col-unit\">5</td>\n                <td class=\"col-make\">100,000</td>\n                <td class=\"col-buy\"></td>\n            </tr>\n            <!-- Row: Variable overhead -->\n            <tr>\n                <td class=\"col-desc\">Variable overhead</td>\n                <td class=\"col-unit\">1</td>\n                <td class=\"col-make\">20,000</td>\n                <td class=\"col-buy\"></td>\n            </tr>\n            <!-- Row: Depreciation of equip. -->\n            <tr>\n                <td class=\"col-desc\">Depreciation of equip.</td>\n                <td class=\"col-unit\">3</td>\n                <td class=\"col-make dash\">-</td>\n                <td class=\"col-buy\"></td>\n            </tr>\n            <!-- Row: Supervisor's salary -->\n            <tr>\n                <td class=\"col-desc\">Supervisor's salary</td>\n                <td class=\"col-unit\">2</td>\n                <td class=\"col-make\">40,000</td>\n                <td class=\"col-buy\"></td>\n            </tr>\n            <!-- Row: General factory overhead -->\n            <tr>\n                <td class=\"col-desc\">General factory overhead</td>\n                <td class=\"col-unit\">10</td>\n                <td class=\"col-make dash\">-</td>\n                <td class=\"col-buy\"></td>\n            </tr>\n            <!-- Row: Total cost -->\n            <tr>\n                <td class=\"col-desc\">Total cost</td>\n                <td class=\"col-unit total-cell-unit\">$ 30</td>\n                <td class=\"col-make total-cell-make\">$ 340,000</td>\n                <td class=\"col-buy total-cell-buy green-text\">$ 500,000</td>\n            </tr>\n        </table>\n    </div>\n\n    <!-- Formula Box --