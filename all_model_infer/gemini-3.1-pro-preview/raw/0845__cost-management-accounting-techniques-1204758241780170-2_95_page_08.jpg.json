        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>The Make or Buy Decision</title>\n    <style>\n        * {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n\n        body {\n            background-color: #1a1a1a;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            font-family: Arial, Helvetica, sans-serif;\n        }\n\n        .slide-container {\n            position: relative;\n            width: 960px;\n            height: 720px;\n            background: #5d2e06;\n            background: linear-gradient(180deg, #6e380a 0%, #4e2505 100%);\n            background-image: repeating-linear-gradient(\n                0deg,\n                rgba(0, 0, 0, 0.3) 0px,\n                rgba(0, 0, 0, 0.3) 2px,\n                rgba(255, 255, 255, 0.06) 2px,\n                rgba(255, 255, 255, 0.06) 4px,\n                transparent 4px,\n                transparent 7px\n            );\n            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);\n            overflow: hidden;\n        }\n\n        /* Watermark Scale Graphic */\n        .scale-watermark {\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n            z-index: 1;\n            opacity: 0.35;\n        }\n\n        .slide-title {\n            position: relative;\n            z-index: 2;\n            text-align: center;\n            font-size: 46px;\n            font-weight: bold;\n            color: #deb673;\n            margin-top: 30px;\n            margin-bottom: 25px;\n            letter-spacing: 0.5px;\n            text-shadow: \n                -1.5px -1.5px 0 #000,  \n                 1.5px -1.5px 0 #000,\n               