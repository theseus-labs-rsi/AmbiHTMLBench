tom: 3.5px solid #000;\n            padding-bottom: 1px;\n            width: 88px;\n            text-align: right;\n        }\n\n        .thick-underline-lg {\n            display: inline-block;\n            border-bottom: 3.5px solid #000;\n            padding-bottom: 1px;\n            width: 145px;\n            text-align: right;\n        }\n\n        .total-cell-unit {\n            border-top: 2px solid #000;\n            border-bottom: 3.5px solid #000;\n            padding-top: 2px;\n            padding-bottom: 2px;\n        }\n\n        .total-cell-make {\n            border-top: 2px solid #000;\n            border-bottom: 3.5px solid #000;\n            padding-top: 2px;\n            padding-bottom: 2px;\n        }\n\n        .total-cell-buy {\n            border-bottom: 3.5px solid #000;\n            padding-top: 2px;\n            padding-bottom: 2px;\n        }\n\n        .dash {\n            text-align: center;\n            padding-right: 25px;\n        }\n\n        /* Formula Callout Box */\n        .formula-box {\n            position: absolute;\n            bottom: 58px;\n            left: 195px;\n            background: #ffffff;\n            border: 2px solid #000;\n            padding: 8px 24px;\n            font-size: 24px;\n            font-weight: bold;\n            color: #0b1a60;\n            z-index: 10;\n            box-shadow: 2px 2px 6px rgba(0,0,0,0.3);\n            white-space: nowrap;\n        }\n\n        /* Overlay SVG for red arrow */\n        .arrow-overlay {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n            z-index: 15;\n        }\n    </style>\n</head>\n<body>\n\n<div class=\"slide-container\">\n    <!-- Watermark Background Graphic (Scales of Justice) -->\n    <svg class=\"scale-watermark\" viewBox=\"0 0 960 720\">\n        <!-- Scale Pillar -->\n        <rect x=\"474\" y=\"320\" width=\"12\" height=\"400\" f