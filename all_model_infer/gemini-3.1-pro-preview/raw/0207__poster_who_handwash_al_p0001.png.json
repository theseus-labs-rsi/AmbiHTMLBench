        "content": "<!DOCTYPE html>\n<html lang=\"sq\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Si të lahen duart</title>\n    <style>\n        * {\n            box-sizing: border-box;\n        }\n        body {\n            font-family: Arial, Helvetica, sans-serif;\n            margin: 0;\n            padding: 40px;\n            display: flex;\n            justify-content: center;\n            background-color: #ffffff;\n            color: #2b2b2b;\n        }\n        .container {\n            width: 100%;\n            max-width: 1100px;\n        }\n        .header {\n            margin-bottom: 50px;\n        }\n        .main-title {\n            font-size: 110px;\n            font-weight: 900;\n            margin: 0 0 10px 0;\n            line-height: 0.9;\n            letter-spacing: -2px;\n        }\n        .main-title .dark {\n            color: #2b2b2b;\n        }\n        .main-title .light {\n            color: #a7a9ac;\n        }\n        .subtitle {\n            font-size: 22px;\n            color: #a7a9ac;\n            font-weight: bold;\n            margin: 0 0 40px 0;\n            letter-spacing: 0.5px;\n        }\n        .duration {\n            display: flex;\n            align-items: center;\n            font-size: 24px;\n            font-weight: bold;\n        }\n        .duration .light {\n            color: #a7a9ac;\n        }\n        .clock-icon {\n            width: 36px;\n            height: 36px;\n            border-radius: 50%;\n            margin-right: 15px;\n            font-size: 10px;\n            background-color: #8c8c8c;\n            color: white;\n            border: none;\n        }\n        \n        .grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            column-gap: 50px;\n            row-gap: 40px;\n            margin-bottom: 60px;\n        }\n        .step {\n            display: flex;\n     