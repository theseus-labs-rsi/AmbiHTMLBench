-color: #fdb913;\n    color: #fff;\n    text-align: center;\n    padding: 10px;\n    border-radius: 4px;\n    margin-bottom: 15px;\n    font-size: 16px;\n  }\n  .col-content {\n    background-color: #fff;\n    border: 1px solid #fdb913;\n    border-radius: 4px;\n    padding: 30px 20px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    flex: 1;\n  }\n  .icon-placeholder {\n    width: 50px;\n    height: 50px;\n    background-color: #f0f0f0;\n    border: 1px dashed #ccc;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    font-size: 12px;\n    color: #999;\n    margin-bottom: 20px;\n    border-radius: 4px;\n  }\n  .col-title {\n    color: #fdb913;\n    font-size: 18px;\n    margin-bottom: 15px;\n    text-align: center;\n  }\n  .col-text {\n    font-size: 14px;\n    color: #666;\n    line-height: 1.6;\n    text-align: center;\n  }\n\n  /* Right Page */\n  .cert-section {\n    background-color: #fdf8e4;\n    padding: 40px;\n    border-radius: 8px;\n    display: flex;\n    gap: 40px;\n    margin-top: 40px;\n    margin-bottom: 50px;\n    align-items: center;\n  }\n  .cert-text {\n    flex: 1;\n    font-size: 15px;\n    line-height: 1.8;\n    color: #666;\n  }\n  .cert-image-container {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n  }\n  .cert-placeholder {\n    width: 180px;\n    height: 240px;\n    background-color: #fff;\n    border: 1px solid #ddd;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    font-size: 12px;\n    color: #999;\n    margin-bottom: 15px;\n  }\n  .cert-caption {\n    font-size: 13px;\n    color: #666;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n  }\n  .cert-caption::before {\n    content: '';\n    display: inline-block;\n    width: 6px;\n    height: 6px;\n    background-color: #fdb913;\n    border-radius: 50%;\n  }\n\n  .mechanism-list {\n    display: flex;\n    flex-direction: column;\n    gap: 25px;\n  }\n  .mechanism-item {\n    display: flex;\n    align-items: center;\n    gap: 20px;\n  }\n  .mech-left {\n    background-color: #fdf8e4;\n    width: 200px;\n    padding: 25px 20px;\n    border-radius: 4px;\n    text-align: center;\n    font-size: 16px;\n    color: #666;\n    box-sizing: border-box;\n  }\n  .mech-arrow {\n    width: 0;\n    height: 0;\n    border-top: 6px solid transparent;\n    border-bottom: 6px solid transparent;\n    border-left: 12px solid #fdb913;\n  }\n  .mech-right {\n    flex: 1;\n    border: 1px solid #fdb913;\n    border-radius: 4px;\n    padding: 25px 30px;\n    font-size: 15px;\n    color: #666;\n    line-height: 1.6;\n    background-color: #fff;\n  }\n\n  footer {\n    display: flex;\n    justify-content: space-between;\n    padding: 20px 60px 40px;\n    font-size: 14px;\n    color: #999;\n  }\n</style>\n</head>\n<body>\n  <div class=\"container\">\n    <header>\n      <div>2024·美的集团ESG报告</div>\n      <div class=\"header-nav\">\n        <span>关于本报告</span>\n        <span>走进美的</span>\n        <span>可持续发展治理</span>\n        <span>守护蓝色星球</span>\n        <span>构建和谐社区</span>\n        <span>践行科技尽善</span>\n        <span class=\"active\">共创繁荣生态</span>\n        <span>附录</span>\n      </div>\n    </header>\n    \n    <main>\n      <!-- Left Page -->\n      <div class=\"page\">\n        <h1>合规运营保障者</h1>\n        <p>合法合规经营是企业长远发展的根本保障，同时也是企业迈向国际化的重要必修课。美的集团始终将合规与稳健视为经营底线，通过从组织架构、制度体系、运行机制到企业文化等多方面着手，逐步构建起覆盖全方位的合规管理体系。</p>\n        \n        <h2>管理架构</h2>\n        <p>依托于三道防线的建设，我们不断完善相关机制，大力推进合规风险的识别、评估与防控工作落地。</p>\n        \n        <div class=\"diagram-container\">\n          <div class=\"diagram-title\">合规管理体系</div>\n          <div class=\"diagram-main-block\">美的集团合规管理三道防线</div>\n          \n          <div class=\"diagram-columns\">\n            <div class=\"diagram-col\">\n              <div class=\"col-header\">第一道防线</div>\n              <div class=\"col-content\">\n                <div class=\"icon-placeholder placeholder\">[Icon: People]</div>\n                <div class=\"col-title\">管理者、员工</div>\n                <div class=\"col-text\">合规风险所有者、管理者，负责本业务部门合规风险识别、评估、处置等</div>\n              </div>\n            </div>\n            \n            <div class=\"diagram-col\">\n              <div class=\"col-header\">第二道防线</div>\n              <div class=\"col-content\">\n                <div class=\"icon-placeholder placeholder\">[Icon: Person & Gear]</div>\n                <div class=\"col-title\">合规专门组织</div>\n                <div class=\"col-text\">牵头统筹协调、组织推动、督促落实</div>\n              </div>\n            </div>\n            \n            <div class=\"diagram-col\">\n              <div class=\"col-header\">第三道防线</div>\n              <div class=\"col-content\">\n                <div class=\"icon-placeholder placeholder\">[Icon: Document & Magnifier]</div>\n                <div class=\"col-title\">审计、调查、稽查</div>\n                <div class=\"col-text\">监督与持续改进</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Right Page -->\n      <div class=\"page\">\n        <div class=\"cert-section\">\n          <div class=\"cert-text\">\n            为持续完善合规体系建设和不断提升合规管理能力，美的集团由法务大合规中心和中国区域法务团队统筹，信息安全部门协助，成功获得ISO 37301:2021合规管理体系认证。该认证彰显了美的集团在合规管理方面的成熟度和专业水准，同时也为美的集团业务的持续稳健发展提供了坚实的基础。\n          </div>\n          <div class=\"cert-image-container\">\n            <div class=\"cert-placeholder placeholder\">[Certificate Image]</div>\n            <div class=\"cert-caption\">ISO 37301: 2021合规管理体系认证</div>\n          </div>\n        </div>\n\n        <h2>管理制度与运行机制</h2>\n        <p>为强化合规管理，美的集团：</p>\n\n        <div class=\"mechanism-list\">\n          <div class=\"mechanism-item\">\n            <div class=\"mech-left\">建立动态风险<br>防控机制</div>\n            <div class=\"mech-arrow\"></div>\n            <div class=\"mech-right\">定期开展风险自评，结合法律研究与风险预警体系，构建“信息收集 - 风险标注 - 政策解读 - 预警发布 - 升级推送 - 反馈处理”闭环机制。</div>\n          </div>\n          \n          <div class=\"mechanism-item\">\n            <div class=\"mech-left\">推进数字化合规建设</div>\n            <div class=\"mech-arrow\"></div>\n            <div class=\"mech-right\">开发合规数字化系统，集成普适性服务功能与定制化场景解决方案，实现合规要求与业务流程深度融合。</div>\n          </div>\n          \n          <div class=\"mechanism-item\">\n            <div class=\"mech-left\">深化重点领域合规</div>\n            <div class=\"mech-arrow\"></div>\n            <div class=\"mech-right\">2024 年持续强化贸易合规与数据合规建设，进一步夯实管理基础，确保全球监管适应性。</div>\n          </div>\n        </div>\n      </div>\n    </main>\n\n    <footer>\n      <div>115</div>\n      <div>116</div>\n    </footer>\n  </div>\n</body>\n</html>"
