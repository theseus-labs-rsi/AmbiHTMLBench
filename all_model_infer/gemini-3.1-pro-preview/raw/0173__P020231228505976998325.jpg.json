        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>开放环境下的可信智能算法</title>\n    <style>\n        body {\n            background-color: #555;\n            margin: 0;\n            padding: 20px 0;\n            display: flex;\n            justify-content: center;\n        }\n        .poster {\n            width: 1000px;\n            background-color: #fff;\n            box-shadow: 0 4px 15px rgba(0,0,0,0.3);\n            font-family: 'SimSun', 'Songti SC', 'Times New Roman', serif;\n            color: #222;\n            overflow: hidden;\n            background-image: url('data:image/svg+xml;utf8,<svg width=\"100%\" height=\"100%\" xmlns=\"http://www.w3.org/2000/svg\"><rect width=\"100%\" height=\"100%\" fill=\"white\"/></svg>');\n        }\n        \n        .header {\n            background: linear-gradient(90deg, #f18c0c 0%, #e2570b 50%, #db3114 100%);\n            padding: 25px 40px;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            color: #fff;\n        }\n        .header-left {\n            display: flex;\n            align-items: center;\n        }\n        .header-logo {\n            font-size: 55px;\n            font-weight: 900;\n            font-style: italic;\n            font-family: Arial, Helvetica, sans-serif;\n            margin-right: 20px;\n            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);\n            letter-spacing: -2px;\n        }\n        .header-text-col {\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n            font-family: 'SimHei', 'Heiti SC', sans-serif;\n        }\n        .header-title-top {\n            font-size: 24px;\n            letter-spacing: 1px;\n            display: flex;\n            align-items: baseline;\n        }\n        .header-title-year {\n            font-