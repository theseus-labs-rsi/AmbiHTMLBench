        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>毕业答辩回复技巧</title>\n<style>\n    body {\n        margin: 0;\n        padding: 0;\n        font-family: \"Microsoft YaHei\", \"SimHei\", sans-serif;\n        background-color: #ffffff;\n        display: flex;\n        justify-content: center;\n        overflow-x: hidden;\n    }\n\n    .container {\n        position: relative;\n        width: 800px;\n        padding: 40px;\n        box-sizing: border-box;\n        background-color: #ffffff;\n        overflow: hidden;\n    }\n\n    /* Background Large Watermarks */\n    .bg-text {\n        position: absolute;\n        font-size: 350px;\n        font-weight: bold;\n        color: rgba(150, 150, 150, 0.2);\n        z-index: 0;\n        line-height: 1;\n        user-select: none;\n    }\n    .bg-text-1 { top: -80px; left: -80px; }\n    .bg-text-2 { top: -80px; right: -80px; }\n    .bg-text-3 { bottom: -80px; left: -80px; }\n    .bg-text-4 { bottom: -80px; right: -80px; }\n\n    /* Secondary Watermarks */\n    .watermark-vertical {\n        position: absolute;\n        writing-mode: vertical-rl;\n        color: rgba(150, 150, 150, 0.4);\n        font-weight: bold;\n        z-index: 1;\n        user-select: none;\n    }\n    .wm-side {\n        left: 20px;\n        top: 200px;\n        font-size: 14px;\n        letter-spacing: 2px;\n    }\n    .wm-center1 {\n        left: 350px;\n        top: 200px;\n        font-size: 24px;\n        letter-spacing: 5px;\n        color: rgba(200, 200, 200, 0.3);\n    }\n    .wm-center2 {\n        right: 250px;\n        bottom: 250px;\n        font-size: 40px;\n        letter-spacing: 10px;\n        color: rgba(200, 200, 200, 0.25);\n    }\n\n    /* Content Wrapper */\n    .content {\n        position: relative;\n        z-index: 2;\n    }\n\n    /* Header */\n    .main-title {\n        text-align: center;\n        font-size: 36px;\n        font-weight: bold;\n        margin: 10px 0 5px 0;\n        color: #000;\n        letter-spacing: 2px;\n    }\n\n    .sub-title {\n        text-align: center;\n        font-size: 24px;\n        font-weight: bold;\n        margin: 0 0 20px 0;\n        color: #333;\n        letter-spacing: 1px;\n    }\n\n    .header-bar {\n        background-color: #9fb3e6;\n        color: #fff;\n        text-align: center;\n        padding: 10px 0;\n        font-size: 20px;\n        font-weight: bold;\n        letter-spacing: 2px;\n        margin-bottom: 0;\n    }\n\n    /* Tree Lines Top */\n    .tree-stem-container {\n        display: flex;\n        justify-content: center;\n        width: 100%;\n    }\n    .tree-stem {\n        width: 2px;\n        height: 15px;\n        background-color: #d9703a;\n    }\n    .tree-branch-container {\n        display: flex;\n        justify-content: space-around;\n        width: 76%;\n        margin: 0 auto;\n        border-top: 2px solid #d9703a;\n        height: 15px;\n    }\n    .tree-drop {\n        width: 2px;\n        height: 100%;\n        background-color: #d9703a;\n    }\n\n    /* Top 4 Columns */\n    .row-4-cols {\n        display: flex;\n        justify-content: space-between;\n        margin-bottom: 20px;\n    }\n\n    .col-orange {\n        width: 23%;\n        border: 2px solid #d9703a;\n        box-sizing: border-box;\n        padding: 10px 8px;\n        background-color: rgba(255, 255, 255, 0.8);\n    }\n\n    .col-title-red {\n        text-align: center;\n        color: #c00000;\n        font-weight: bold;\n        font-size: 18px;\n        line-height: 1.2;\n        margin-bottom: 10px;\n    }\n\n    .col-orange ol {\n        margin: 0;\n        padding-left: 20px;\n        font-size: 14px;\n        line-height: 1.5;\n        color: #000;\n    }\n    .col-orange ol li {\n        margin-bottom: 5px;\n    }\n\n    /* Middle Section */\n    .middle-section {\n        background-color: #f8cbad;\n        padding: