container-yellow {\n        display: flex;\n        justify-content: space-around;\n        width: 76%;\n        margin: 0 auto;\n        border-top: 2px solid #f2c05d;\n        height: 0px;\n    }\n    .tree-stem-container-yellow {\n        display: flex;\n        justify-content: center;\n        width: 100%;\n        height: 15px;\n    }\n    .tree-stem-yellow {\n        width: 2px;\n        height: 100%;\n        background-color: #f2c05d;\n    }\n\n    /* Summary Section */\n    .summary-section {\n        background-color: #ffe699;\n        padding: 20px;\n        position: relative;\n    }\n\n    .summary-title-wrapper {\n        display: flex;\n        justify-content: center;\n        margin-top: -10px;\n        margin-bottom: 10px;\n    }\n\n    .summary-title {\n        color: #2f5496;\n        font-size: 18px;\n        font-weight: bold;\n        border: 2px solid #9fb3e6;\n        padding: 2px 10px;\n        background-color: transparent;\n    }\n\n    .summary-section ol {\n        margin: 0;\n        padding-left: 0;\n        list-style-position: inside;\n        font-size: 14px;\n        line-height: 1.6;\n        color: #000;\n        text-align: center;\n    }\n    \n    .summary-section ol li {\n        margin-bottom: 5px;\n    }\n\n</style>\n</head>\n<body>\n\n<div class=\"container\">\n    <!-- Background Watermarks -->\n    <div class=\"bg-text bg-text-1\">比</div>\n    <div class=\"bg-text bg-text-2\">业</div>\n    <div class=\"bg-text bg-text-3\">答</div>\n    <div class=\"bg-text bg-text-4\">辩</div>\n    \n    <div class=\"watermark-vertical wm-side\">科研大喵喵叫大|Paper_the_Cat|严禁抄袭转载|PDF资料仅在知识星球传播下载</div>\n    <div class=\"watermark-vertical wm-center1\">科研大喵原创</div>\n    <div class=\"watermark-vertical wm-center2\">严禁抄袭</div>\n\n    <!-- Main Content -->\n    <div class=\"content\">\n        <div class=\"main-title\">一张图说清楚毕业答辩</div>\n        <div class=\"sub-title\">不要道歉！不要道歉！不要道歉！</div>\n\n        <div class=\"header-bar\">四类质疑回复技巧</div>\n\n        <!-- Connection Lines to Top 4 Boxes -->\n        <div class=\"tree-stem-container\">\n            <div class=\"tree-stem\"></div>\n        </div>\n        <div class=\"tree-branch-container\">\n            <div class=\"tree-drop\"></div>\n            <div class=\"tree-drop\"></div>\n            <div class=\"tree-drop\"></div>\n            <div class=\"tree-drop\"></div>\n        </div>\n\n        <!-- Top 4 Columns (Orange Boxes) -->\n        <div class=\"row-4-cols\">\n            <div class=\"col-orange\">\n                <div class=\"col-title-red\">类型一<br>WHAT</div>\n                <ol>\n                    <li>你的研究有什么创新点</li>\n                    <li>你的研究有什么主要发现</li>\n                    <li>此发现有何理论现实意义</li>\n                </ol>\n            </div>\n            <div class=\"col-orange\">\n                <div class=\"col-title-red\">类型二<br>WHY</div>\n                <ol>\n                    <li>为什么选取这个研究课题</li>\n                    <li>为什么采取这个研究方法</li>\n                    <li>为什么运用这个理论角度</li>\n                </ol>\n            </div>\n            <div class=\"col-orange\">\n                <div class=\"col-title-red\">类型三<br>WHY NOT</div>\n                <ol>\n                    <li>为什么没有参考XX文献</li>\n                    <li>为什么没有做XX测试</li>\n                    <li>为什么没有考虑xx因素</li>\n                </ol>\n            </div>\n            <div class=\"col-orange\">\n                <div class=\"col-title-red\">类型四<br>无言以对</div>\n                <ol>\n                    <li>论文没有新意</li>\n                    <li>讨论没有逻辑</li>\n                    <li>遗漏重要文献</li>\n                    <li>没有亮眼发现</li>\n                    <li>格式混乱</li>\n                    <li>漏洞百出</li>\n                </ol>\n            </div>\n        </div>\n\n        <!-- Middle Section (Peach) -->\n        <div class=\"middle-section\">\n            <div class=\"middle-title\">\n                感谢老师提问 <span>-</span> 复述问题要点 <span>-</span> 承认论文存在进步空间\n            </div>\n            <ul>\n                <li>理解/确认老师的具体质疑点</li>\n                <li>放缓问答节奏，为自己思考应对创造时间</li>\n                <li>消除和老师观点的对抗性，为进一步答辩创造轻松氛围</li>\n            </ul>\n        </div>\n\n        <!-- Connection Lines to Bottom 4 Boxes -->\n        <div class=\"tree-stem-container-green\">\n            <div class=\"tree-stem-green\"></div>\n        </div>\n        <div class=\"tree-branch-container-green\">\n            <div class=\"tree-drop-green\"></div>\n            <div class=\"tree-drop-green\"></div>\n            <div class=\"tree-drop-green\"></div>\n            <div class=\"tree-drop-green\"></div>\n        </div>\n\n        <!-- Bottom 4 Columns (Green Boxes) -->\n        <div class=\"row-4-cols\" style=\"margin-bottom: 0;\">\n            <div class=\"col-green\">\n                <div class=\"col-title-blue-green\">回复方式一<br>Elaboration</div>\n                <div class=\"col-title-bold-green\">具体说明</div>\n                <ul>\n                    <li>针对问题展开具体说明</li>\n                    <li>结合PPT中提及具体内容</li>\n                </ul>\n            </div>\n            <div class=\"col-green\">\n                <div class=\"col-title-blue-green\">回复方式二<br>Clarification</div>\n                <div class=\"col-title-bold-green\">解释澄清</div>\n                <ul>\n                    <li>解释自己的具体考虑</li>\n                    <li>结合研究中的合理局限</li>\n                </ul>\n            </div>\n            <div class=\"col-green\">\n                <div class=\"col-title-blue-green\">回复方式三<br>Justification</div>\n                <div class=\"col-title-bold-green\">论证说明</div>\n                <ul>\n                    <li>论证和老师分歧点的合理性</li>\n                    <li>结合前人研究和自己的观点</li>\n                </ul>\n            </div>\n            <div class=\"col-green\">\n                <div class=\"col-title-blue-green\">回复方式四<br>Appreciation</div>\n                <div class=\"col-title-bold-green\">虚心接受</div>\n                <ul>\n                    <li>老师指出论文核心问题</li>\n                   