nt: '•';\n        position: absolute;\n        left: -12px;\n        color: var(--text-light);\n    }\n\n    /* Flowchart Styles */\n    .flowchart {\n        display: flex;\n        flex-direction: column;\n    }\n\n    .flow-row {\n        display: flex;\n        align-items: stretch;\n        gap: 20px;\n    }\n\n    .flow-step {\n        width: 80px;\n        flex-shrink: 0;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        color: #fff;\n        font-size: 16px;\n        border-radius: 4px;\n    }\n\n    .flow-step.step1 { background-color: var(--primary-blue); }\n    .flow-step.step2 { background-color: var(--light-blue-1); }\n    .flow-step.step3 { background-color: var(--light-blue-2); }\n\n    .flow-content {\n        flex-grow: 1;\n        border: 1px solid var(--primary-blue);\n        border-radius: 8px;\n        padding: 20px;\n        font-size: 13px;\n        color: var(--text-gray);\n        line-height: 1.8;\n        background-color: #fff;\n    }\n\n    .flow-content.border-light-1 { border-color: var(--light-blue-1); }\n    .flow-content.border-light-2 { border-color: var(--light-blue-2); }\n\n    .flow-content.has-dot {\n        position: relative;\n    }\n\n    .flow-content.has-dot::before {\n        content: '';\n        position: absolute;\n        left: -5px;\n        top: 50%;\n        width: 9px;\n        height: 9px;\n        background-color: var(--light-blue-1);\n        border-radius: 50%;\n        transform: translateY(-50%);\n    }\n\n    .flow-arrow-row {\n        display: flex;\n        height: 30px;\n        align-items: center;\n        gap: 20px;\n    }\n\n    .flow-arrow-left {\n        width: 80px;\n        flex-shrink: 0;\n        display: flex;\n        justify-content: center;\n    }\n\n    .flow-arrow-triangle {\n        width: 0;\n        height: 0;\n        border-left: 10px solid transparent;\n        border-right: 10px solid transparent;\n        border-top: 12px solid var(