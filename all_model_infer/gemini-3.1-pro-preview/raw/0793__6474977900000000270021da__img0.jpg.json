        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>诉讼实现公平正义 - 知识结构笔记</title>\n  <script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      background-color: #e9e5dc;\n      font-family: \"KaiTi\", \"STKaiti\", \"BiauKai\", \"Microsoft YaHei\", serif;\n      color: #222;\n      padding: 30px 20px;\n      display: flex;\n      justify-content: center;\n      align-items: flex-start;\n      min-height: 100vh;\n    }\n\n    /* 模拟原图活页网格笔记本样式 */\n    .notebook-page {\n      background-color: #f7f5f0;\n      background-image: \n        linear-gradient(rgba(165, 190, 190, 0.35) 1px, transparent 1px),\n        linear-gradient(90deg, rgba(165, 190, 190, 0.35) 1px, transparent 1px);\n      background-size: 24px 24px;\n      width: 100%;\n      max-width: 1300px;\n      min-width: 960px;\n      padding: 50px 60px 60px 70px;\n      border-radius: 8px;\n      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);\n      position: relative;\n      overflow-x: auto;\n    }\n\n    /* 左侧活页装订孔模拟 */\n    .binder-column {\n      position: absolute;\n      left: 15px;\n      top: 0;\n      bottom: 0;\n      width: 24px;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-evenly;\n      align-items: center;\n      padding: 20px 0;\n    }\n\n    .hole {\n      width: 16px;\n      height: 16px;\n      background-color: #dfdbcf;\n      border: 1px solid #bcbaae;\n      border-radius: 50%;\n      box-shadow: inset 1px 1px 3px rgba(0, 0, 0, 0.25);\n    }\n\n    /* 树状布局核心样式 */\n    .tree-container {\n      display: flex;\n      align-items: flex-start;\n      position: relative;\n      z-index: 1;\n    }\n\n    .tree-node {\n      display: flex;\n      align-items: flex-start;\n      margin: 6px 0;\n      position: relative;\n    }\n\n    .node-content {\n      display: inline-flex;\n      align-items: center;\n      padding: 2px 6px;\n      line-height: 1.5;\n      font-size: 1.05em;\n      white-space: nowrap;\n    }\n\n    .node-content.wrap {\n      white-space: normal;\n    }\n\n    .children {\n      display: flex;\n      flex-direction: column;\n      justify-content: center;\n      margin-left: 20px;\n      padding-left: 20px;\n      border-left: 2px solid #206864; /* 匹配手写手记墨水绿色 */\n      position: relative;\n    }\n\n    /* 分支横向连接线 */\n    .children > .tree-node::before {\n      content: \"\";\n      position: absolute;\n      left: -20px;\n      top: 14px;\n      width: 16px;\n      height: 2px;\n      background-color: #206864;\n    }\n\n    /* 主根节点（顶部标题） */\n    .root-title {\n      font-size: 1.6em;\n      font-weight: bold;\n      color: #155853;\n      padding: 4px 10px;\n      letter-spacing: 2px;\n    }\n\n    /* 一级分类层级（绿色重点文字） */\n    .level-1-title {\n      font-size: 1.25em;\n      font-weight: bold;\n      color: #155853;\n    }\n\n    /* 辅助标注文字与颜色 */\n    .sub-text {\n      color: #333;\n      margin-left: 4px;\n    }\n\n    /* 红色手写补充文字笔记 */\n    .red-note {\n      color: #c92a2a;\n      line-height: 1.45;\n      font-size: 0.95em;\n      margin-left: 20px;\n      display: inline-block;\n      vertical-align: top;\n    }\n\n    .red-underline {\n      color: #c92a2a;\n      border-bottom: 2px wavy #c92a2a;\n      padding-bottom: 1px;\n    }\n\n    .annotation-block {\n      display: flex;\n      flex-direction: column;\n      align-items: flex-start;\n      margin-top: 4px;\n      margin-left: 85px;\n    }\n\n    .annotation-text {\n      color: #c92a2a;\n      font-size: 0.95em;\n    }\n\n    /* 页面右下角独立悬浮注记 */\n    .floating-note {\n      position: absolute;\n      bottom: 40px;\n      right: 70px;\n      font-size: 1.1em;\n      color: #333;\n      transform: rotate(-3deg);\n    }\n\n    /* 弹性对齐内容容器 */\n    .flex-row {\n      display: flex;\n      align-items: flex-start;\n    }\n\n    .inline-block {\n      display: inline-block;\n    }\n  </style>\n</head>\n<body>\n\n  <div class=\"notebook-page\">\n    <!-- 装订孔栏 -->\n    <div class=\"binder-column\">\n      <div class=\"hole\"></div>\n      <div class=\"hole\"></div>\n      <div class=\"hole\"></div>\n      <div class=\"hole\"></div>\n      <div class=\"hole\"></div>\n      <div class=\"hole\"></div>\n      <div class=\"hole\"></div>\n      <div class=\"hole\"></div>\n      <div class=\"hole\"></div>\n      <div class=\"hole\"></div>\n      <div class=\"hole\"></div>\n      <div class=\"hole\"></div>\n      <div class=\"hole\"></div>\n      <div class=\"hole\"></div>\n      <div class=\"hole\"></div>\n    </div>\n\n    <!-- 树状笔记正文内容 -->\n    <div class=\"tree-container\">\n      \n      <!-- 根节点：诉讼实现公平正义 -->\n      <div class=\"tree-node\">\n        <div class=\"node-content root-title\">诉讼实现公平正义</div>\n        \n        <!-- 主一级分类分支 -->\n        <div class=\"children\">\n          \n          <!-- 1. 诉讼权利 -->\n          <div class=\"tree-node\">\n            <div class=\"node-content level-1-title\">诉讼权利</div>\n            <div class=\"children\">\n              \n              <!-- 权利一 -->\n              <div class=\"tree-node\">\n                <div class=\"node-content\">当事人有委托诉讼代理人或辩护人的权利</div>\n                <div class=\"children\">\n                  <div class=\"tree-node\">\n                    <div class=\"node-content\">民事诉讼、行政诉讼 —— 诉讼代理人</div>\n                  </div>\n                  <div class=\"tree-node\">\n                    <div class=\"node-content\">刑事诉讼 —— 辩护人</div>\n                  </div>\n                </div>\n              </div>\n\n              <!-- 权利二 -->\n              <div class=\"tree-node\">\n                <div class=\"node-content\">当事人有申请回避的权利</div>\n              </div>\n\n              <!-- 权利三 -->\n              <div class=\"tree-node\">\n                <div class=\"node-content\">当事人有上诉的权利：两审终审制</div>\n              </div>\n\n            </div>\n          </div>\n\n          <!-- 2. 不服判决或裁定 -->\n          <div class=\"tree-node\">\n            <div class=\"node-content level-1-title\">不服判决或裁定</div>\n            <div class=\"children\">\n              <div class=\"tree-node\">\n                <div class=\"node-content\">民事诉讼、行政诉讼 = 上诉期限分别为15日、10日.</div>\n              </div>\n              <div class=\"tree-node\">\n                <div class=\"node-content\">刑事诉讼 = 上诉期限分别为10日、5日</div>\n              </div>\n            </div>\n          </div>\n\n          <!-- 3. 诉讼程序 -->\n          <div class=\"tree-node\">\n            <div class=\"node-content level-1-title\">诉讼程序</div>\n            <div class=\"children\">\n              \n              <!-- 起诉 -->\n              <div class=\"tree-node\">\n                <div class=\"node-content\">\n                  <span class=\"level-1-title\" style=\"font-size:1em;\">起诉</span>\n                  <span class=\"sub-text\">—— 民事诉讼程序第一步.</span>\n                </div>\n                <div class=\"children\">\n                  <div class=\"tree-node\">\n                    <div class=\"node-content wrap\">\n                      <div class=\"flex-row\">\n                        <span>民事诉讼和行政诉讼实行“不告不理”原则·</span>\n                        <!-- 红色旁注文字 -->\n                        <div class=\"red-note\">\n                          向人民法院请求保护<br>\n                          民事权利的诉讼时效期<br>\n                          间为3年，但如果关系集体利益不受<br>\n                          限制·\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <div class=\"tree-node\">\n                    <div class=\"node-content\">应向有管辖权的人民法院提出.</div>\n                  </div>\n                </div>\n              </div>\n\n              <!-- 立案 -->\n              <div class=\"tree-node\">\n                <div class=\"node-content\">\n                  <span class=\"level-1-title\" style=\"font-size:1em;\">立案</span>\n                  <span class=\"sub-text\">= 诉讼即告开始.</span>\n                </div>\n              </div>\n\n              <!-- 应诉 -->\n              <div class=\"tree-node\">\n                <div class=\"node-content level-1-title\" style=\"font-size:1em;\">应诉</div>\n              </div>\n\n              <!-- 开庭审理 -->\n              <div class=\"tree-node\">\n                <div class=\"node-content\">\n                  <span class=\"level-1-title\" style=\"font-size:1em;\">开庭审理</span>\n                  <span class=\"sub-text\">—— 是诉讼过程中最重要的环节.</span>\n                </div>\n                <div class=\"children\">\n                  <div class=\"tree-node\">\n                    <div class=\"node-content wrap\">\n                      <div>\n                        <span>开庭准备、</span><span class=\"red-underline\">法庭调查</span><span>、法庭辩论、休庭评议、宣告判决</span>\n                        <div class=\"annotation-block\">\n                          <span class=\"annotation-text\">↑ 开庭审理的核心</span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              <!-- 终审裁判 -->\n              <div class=\"tree-node\">\n                <div class=\"node-content level-1-title\" style=\"font-size:1em;\">终审裁判</div>\n                <div class=\"children\">\n                  <div class=\"tree-node\">\n                    <div class=\"node-content\">“两审终审、一审终审”原则</div>\n                  </div>\n                  <div class=\"tree-node\">\n                    <div class=\"node-content\">诉讼到此层级败诉</div>\n                  </div>\n                </div>\n              </div>\n\n            </div>\n          </div>\n\n          <!-- 4. 举证责任 -->\n          <div class=\"tree-node\">\n            <div class=\"node-content level-1-title\">举证责任</div>\n            <div class=\"children\">\n              \n              <!-- 民事诉讼 -->\n              <div class=\"tree-node\">\n                <div class=\"node-content\">民事诉讼</div>\n                <div class=\"children\">\n                  <div class=\"tree-node\">\n                    <div class=\"node-content\">“谁主张，谁举证”原则</div>\n                  </div>\n                  <div class=\"tree-node\">\n                    <div class=\"node-content\">举证倒置原则</div>\n                  </div>\n                </div>\n              </div>\n\n              <!-- 行政诉讼 -->\n              <div class=\"tree-node\">\n                <div class=\"node-content wrap\">\n                  行政诉讼 = 作为被告的行政机关应当根据其作出的行政行为对同公民、法人和所作的局机关承担举证责任·\n                </div>\n              </div>\n\n              <!-- 刑事诉讼 -->\n              <div class=\"tree-node\">\n                <div class=\"node-content wrap\">\n                  刑事诉讼 = 公诉案件的举证责任由人民检察院承担，自诉案件由自诉人承担·\n                </div>\n              </div>\n\n            </div>\n          </div>\n\n        </div>\n      </div>\n      \n    </div>\n\n    <!-- 右下角悬浮文字 -->\n    <div class=\"floating-note\">我的文件夹</div>\n\n  </div>\n\n</body>\n</html>"
