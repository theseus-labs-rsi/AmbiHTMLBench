        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>光明日报 - 2025年2月23日</title>\n<style>\n    body {\n        font-family: \"SimSun\", \"Songti SC\", serif;\n        margin: 0;\n        padding: 20px;\n        background-color: #fdfdfd;\n        color: #111;\n        line-height: 1.6;\n    }\n    .container {\n        max-width: 1400px;\n        margin: 0 auto;\n        background: #fff;\n        padding: 20px;\n        box-shadow: 0 0 10px rgba(0,0,0,0.1);\n    }\n    /* Header Styles */\n    .header {\n        display: flex;\n        justify-content: space-between;\n        border-bottom: 3px solid #a00;\n        padding-bottom: 15px;\n        margin-bottom: 20px;\n    }\n    .header-left {\n        width: 45%;\n        display: flex;\n        flex-direction: column;\n    }\n    .logo-area {\n        display: flex;\n        align-items: baseline;\n        gap: 20px;\n        margin-bottom: 10px;\n    }\n    .logo-text {\n        font-family: \"Kaiti\", \"STKaiti\", serif;\n        font-size: 64px;\n        color: #c00;\n        font-weight: bold;\n        letter-spacing: 10px;\n        margin: 0;\n        line-height: 1;\n    }\n    .logo-en {\n        font-family: sans-serif;\n        font-size: 18px;\n        color: #555;\n        letter-spacing: 2px;\n    }\n    .date-bar {\n        background-color: #0056b3;\n        color: #fff;\n        padding: 8px 15px;\n        display: flex;\n        justify-content: space-between;\n        font-size: 14px;\n        font-family: sans-serif;\n    }\n    .info-bar {\n        font-size: 12px;\n        margin-top: 8px;\n        display: flex;\n        justify-content: space-between;\n        color: #333;\n    }\n    .header-right {\n        width: 50%;\n    }\n    .header-article-pretitle {\n        text-align: center;\n        font-size: 20px;\n        font-weight: bold;\n        margin-bottom: 5px;\n  