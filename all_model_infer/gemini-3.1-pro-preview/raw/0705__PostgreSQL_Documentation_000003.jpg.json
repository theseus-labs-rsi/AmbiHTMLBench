adius: 4px 0 0 4px;\n            width: 300px;\n            outline: none;\n        }\n\n        .doc-search button {\n            background: #fff;\n            border: 1px solid #ccc;\n            border-radius: 0 4px 4px 0;\n            padding: 5px 12px;\n            cursor: pointer;\n            color: var(--pg-blue);\n        }\n\n        /* Document Navigation (Prev/Up/Next) */\n        .doc-nav {\n            border-top: 1px solid var(--border-color);\n            border-bottom: 1px solid var(--border-color);\n            padding: 10px 0;\n            margin-bottom: 30px;\n            font-size: 14px;\n            color: #555;\n        }\n\n        .doc-nav-top {\n            text-align: center;\n            margin-bottom: 5px;\n        }\n\n        .doc-nav-bottom {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-links {\n            display: flex;\n            gap: 40px;\n        }\n\n        .nav-links a {\n            color: var(--pg-link-red);\n            font-weight: bold;\n        }\n        \n        .doc-title-center {\n            text-align: center;\n            flex-grow: 1;\n        }\n\n        /* Main Content Typography */\n        h1 {\n            color: var(--pg-blue);\n            font-size: 32px;\n            font-weight: normal;\n            margin-top: 0;\n            margin-bottom: 20px;\n        }\n\n        p {\n            margin-bottom: 16px;\n            font-size: 15px;\n            color: #222;\n        }\n\n        p a {\n            color: var(--pg-link-red);\n        }\n\n        /* Table of Contents */\n        .toc-heading {\n            font-size: 16px;\n            font-weight: bold;\n            margin-top: 30px;\n            margin-bottom: 10px;\n        }\n\n        .toc {\n            list-style: none;\n            padding-left: 0;\n            margin: 0;\n            font-size: 14px;\n        }\n\n        .toc > li {\n            m