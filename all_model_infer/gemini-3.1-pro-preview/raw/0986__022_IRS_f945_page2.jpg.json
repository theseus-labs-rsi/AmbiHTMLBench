        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Form 945 Page 2</title>\n<style>\n  body {\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 11px;\n    line-height: 1.3;\n    max-width: 850px;\n    margin: 0 auto;\n    padding: 20px;\n    box-sizing: border-box;\n    color: #000;\n  }\n  * {\n    box-sizing: border-box;\n    border-radius: 0;\n  }\n  .bold { font-weight: bold; }\n  .italic { font-style: italic; }\n  .h-line { border-bottom: 1px solid #000; margin: 10px 0; width: 100%; }\n  \n  /* Top Section */\n  .top-section { border-top: 2px solid #000; border-bottom: 1px solid #000; display: flex; align-items: stretch;}\n  .name-col { width: 65%; border-right: 1px solid #000; padding: 3px 5px 15px 0; font-weight: bold; font-size: 10px;}\n  .ein-col { width: 35%; padding: 3px 0 15px 5px; font-weight: bold; font-size: 10px; }\n  \n  /* Bullets */\n  .bullet-list { margin: 15px 0; padding-left: 5px; font-size: 11px; }\n  .bullet-list-item { display: flex; align-items: baseline; margin-bottom: 5px; }\n  .bullet { font-size: 16px; line-height: 10px; margin-right: 8px; }\n  \n  .checkbox { width: 14px; height: 14px; border: 1px solid #000; display: inline-block; vertical-align: middle; background: #fff; flex-shrink: 0;}\n  .dots-spacer { flex-grow: 1; overflow: hidden; white-space: nowrap; margin: 0 10px; color: #000; font-size: 11px; letter-spacing: 5px;}\n  \n  /* Section 7 */\n  .section-7-header { display: flex; margin-bottom: 15px; margin-top: 20px;}\n  .section-7-header .num { font-weight: bold; font-size: 12px; margin-right: 15px; margin-left: 20px;}\n  .section-7-header .text { font-weight: bold; font-size: 11px;}\n  .section-7-header .text span.normal { font-weight: normal; }\n  \n  .months-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-bottom: 15px; padding-left: 60px; padding-right: 20px;