ass=\"unit\"><span class=\"en\">seal</span><span class=\"zh\">海豹</span></div>\n        <span class=\"plain\">with</span>\n        <div class=\"unit\"><span class=\"en red\">sharp teeth</span><span class=\"zh\">锋利的牙齿</span></div>\n        <div class=\"unit\"><span class=\"en\">appeared</span><span class=\"zh\">出现</span></div>\n        <div class=\"unit\"><span class=\"en red\">opposite</span><span class=\"zh\">在...对面</span></div>\n      </div>\n\n      <!-- Line 6 -->\n      <div class=\"line\">\n        <span class=\"plain\">him. Every</span>\n        <div class=\"unit\"><span class=\"en\">cell</span><span class=\"zh\">细胞</span></div>\n        <span class=\"plain\">in his</span>\n        <div class=\"unit\"><span class=\"en red\">body</span><span class=\"zh\">身体</span></div>\n        <span class=\"plain\">was</span>\n        <div class=\"unit\"><span class=\"en red\">scared</span><span class=\"zh\">被吓到</span></div>\n        <span class=\"plain\">to death.</span>\n        <div class=\"unit\"><span class=\"en red\">But</span><span class=\"zh\">但是</span></div>\n        <span class=\"plain\">soon, he was</span>\n        <div class=\"unit\"><span class=\"en\">aware</span><span class=\"zh\">察觉到</span></div>\n      </div>\n\n      <!-- Line 7 -->\n      <div class=\"line\">\n        <span class=\"plain\">that he wasn't the</span>\n        <div class=\"unit\"><span class=\"en\">target</span><span class=\"zh\">目标</span></div>\n        <span class=\"plain\">of an</span>\n        <div class=\"unit\"><span class=\"en red\">attack</span><span class=\"zh\">袭击</span></div>\n        <span class=\"plain\">. With a</span>\n        <div class=\"unit\"><span class=\"en\">neat wound</span><span class=\"zh\">整齐的伤口</span></div>\n        <span class=\"plain\">in its</span>\n        <div class=\"unit\"><span class=\"en red\">lip</span><span class=\"zh\">嘴唇</span></div>\n        <div class=\"unit\"><span class=\"en\">caused</span><span class=\"zh\">造成</span></div>\n      </div>\n\n      <!--