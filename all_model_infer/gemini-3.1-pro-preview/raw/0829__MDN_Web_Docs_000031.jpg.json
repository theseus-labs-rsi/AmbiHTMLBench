ft: 8px;\n        }\n\n        /* Breadcrumbs Bar */\n        .breadcrumbs-bar {\n            background-color: var(--bg-muted);\n            padding: 10px 20px;\n            border-bottom: 1px solid var(--border-color);\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            font-size: 14px;\n        }\n        .breadcrumbs {\n            color: var(--text-muted);\n        }\n        .breadcrumbs a {\n            color: var(--text-main);\n        }\n        .breadcrumbs-actions {\n            display: flex;\n            gap: 20px;\n            color: var(--text-main);\n        }\n        .breadcrumbs-actions span {\n            display: flex;\n            align-items: center;\n            gap: 5px;\n            cursor: pointer;\n        }\n\n        /* Main Layout */\n        .container {\n            display: grid;\n            grid-template-columns: 260px 1fr 260px;\n            gap: 40px;\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 20px;\n        }\n\n        /* Left Sidebar */\n        .sidebar-left {\n            font-size: 14px;\n        }\n        .filter-box {\n            display: flex;\n            align-items: center;\n            border: 1px solid var(--border-color);\n            border-radius: 20px;\n            padding: 6px 12px;\n            margin-bottom: 15px;\n        }\n        .filter-box input {\n            border: none;\n            outline: none;\n            width: 100%;\n            margin-left: 8px;\n        }\n        .nav-list {\n            list-style: none;\n        }\n        .nav-list li {\n            margin-bottom: 2px;\n        }\n        .nav-list a {\n            display: block;\n            padding: 8px 12px;\n            color: var(--text-main);\n            border-left: 3px solid transparent;\n        }\n        .nav-list a:hover {\n            background-color: var(--bg-muted);\n        }\n        .nav-list a.active {\n  