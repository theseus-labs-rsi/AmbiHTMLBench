solid var(--text-main);\n            margin-left: -2px;\n        }\n\n        .ad-block {\n            background-color: #29235c;\n            color: white;\n            padding: 20px;\n            border-radius: 8px;\n            position: relative;\n        }\n        .ad-block .ad-label {\n            position: absolute;\n            top: 10px;\n            right: 10px;\n            font-size: 10px;\n            border: 1px solid rgba(255,255,255,0.5);\n            padding: 2px 4px;\n            color: rgba(255,255,255,0.8);\n        }\n        .ad-block .placeholder {\n            width: 100%;\n            height: 120px;\n            background-color: #1e1945;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            margin-bottom: 15px;\n            border-radius: 4px;\n        }\n        .ad-block h4 {\n            font-size: 16px;\n            margin-bottom: 10px;\n        }\n        .ad-block p {\n            font-size: 12px;\n            color: #d1d5da;\n            margin-bottom: 15px;\n            line-height: 1.4;\n        }\n        .ad-block button {\n            background-color: transparent;\n            color: white;\n            border: 1px solid white;\n            padding: 6px 12px;\n            border-radius: 20px;\n            cursor: pointer;\n            font-size: 12px;\n        }\n        .ad-block-remove {\n            display: block;\n            margin-top: 10px;\n            font-size: 12px;\n            color: var(--text-muted);\n            text-align: left;\n        }\n    </style>\n</head>\n<body>\n\n    <!-- Top Banner -->\n    <div class=\"top-banner\">\n        <div class=\"top-banner-content\">\n            <div class=\"top-banner-logo\">\n                <span style=\"color: #47a248;\">🍃</span> MongoDB\n            </div>\n            <span>Build smarter search with MongoDB Atlas — your vector database for AI apps. Start free.</span>\n            <a href=\"#\" class=\"top-banner-btn\">Get started for free</a>\n        </div>\n        <div class=\"ad-label-top\">广告</div>\n        <a href=\"#\" class=\"ad-remove-link\">不想看到广告？</a>\n    </div>\n\n    <!-- Header -->\n    <header class=\"header\">\n        <div class=\"logo\">\n            <i>//</i> mdn<span>_</span>\n        </div>\n        <nav class=\"main-nav\">\n            <a href=\"#\">HTML ⌄</a>\n            <a href=\"#\">CSS ⌄</a>\n            <a href=\"#\">JavaScript ⌄</a>\n            <a href=\"#\">Web APIs ⌄</a>\n            <a href=\"#\">All ⌄</a>\n            <a href=\"#\">🎓 Learn ⌄</a>\n            <a href=\"#\">🔧 Tools ⌄</a>\n            <a href=\"#\">About ⌄</a>\n            <a href=\"#\">Blog</a>\n        </nav>\n        <div class=\"header-actions\">\n            <div class=\"search-bar\">\n                <span>🔍</span>\n                <input type=\"text\" placeholder=\"\">\n            </div>\n            <span class=\"icon\">→]</span>\n        </div>\n    </header>\n\n    <!-- Breadcrumbs -->\n    <div class=\"breadcrumbs-bar\">\n        <div class=\"breadcrumbs\">\n            <a href=\"#\">学习 Web 开发</a> > <a href=\"#\">核心学习模块</a> > <a href=\"#\">使用 HTML 构建 Web</a> > Mozilla 欢迎页面\n        </div>\n        <div class=\"breadcrumbs-actions\">\n            <span>◑ 主题</span>\n            <span>文A 中文 (简体)</span>\n        </div>\n    </div>\n\n    <!-- Main Content -->\n    <div class=\"container\">\n        \n        <!-- Left Sidebar -->\n        <aside class=\"sidebar-left\">\n            <div class=\"filter-box\">\n                <span>▽</span>\n                <input type=\"text\" placeholder=\"筛选\">\n            </div>\n            <ul class=\"nav-list\">\n                <li class=\"disabled\">挑战：标记信件</li>\n                <li><a href=\"#\">构建文档</a></li>\n                <li><a href=\"#\">创建超链接</a></li>\n                <li><a href=\"#\">Test: Links (英语)</a></li>\n                <li><a href=\"#\">挑战：构建网页内容</a></li>\n                <li><a href=\"#\">HTML 中的图片</a></li>\n                <li><a href=\"#\">Test: Images (英语)</a></li>\n                <li><a href=\"#\">视频和音频内容</a></li>\n                <li><a href=\"#\">Test: Audio and video (英语)</a></li>\n                <li><a href=\"#\" class=\"active\">Mozilla 欢迎页面</a></li>\n                <li><a href=\"#\">HTML 表格基础</a></li>\n                <li><a href=\"#\">HTML 表格进阶特性和无障碍</a></li>\n                <li><a href=\"#\">挑战：构建行星数据表</a></li>\n                <li><a href=\"#\">表单和按钮</a></li>\n                <li><a href=\"#\">Test: Forms and buttons (英语)</a></li>\n                <li><a href=\"#\">Challenge: Feedback form<br>(英语)</a></li>\n                <li><a href=\"#\">HTML 调试</a></li>\n                <li><a href=\"#\">测试你的技能：使用 HTML 构建<br>内容</a></li>\n                <li><a href=\"#\" class=\"sub-item\">> Additional tutorials</a></li>\n                <li><a href=\"#\" class=\"sub-item\">> CSS 样式基础</a></li>\n                <li><a href=\"#\" class=\"sub-item\">> CSS 文本样式</a></li>\n                <li><a href=\"#\" class=\"sub-item\">> CSS 排版</a></li>\n                <li><a href=\"#\" class=\"sub-item\">> 使用 JavaScript 添加脚本交互</a></li>\n                <li><a href=\"#\" class=\"sub-item\">> JavaScript 框架和库</a></li>\n                <li><a href=\"#\" class=\"sub-item\">> 无障碍</a></li>\n                <li><a href=\"#\">给开发者的设计课 (英语)</a></li>\n                <li><a href=\"#\">版本控制</a></li>\n                <li class=\"category\">扩展模块</li>\n                <li><a href=\"#\" class=\"sub-item\">> Advanced JavaScript objects</a></li>\n                <li><a href=\"#\" class=\"sub-item\">> 客户端 Web API</a></li>\n                <li><a href=\"#\" class=\"sub-item\">> 异步 JavaScript</a></li>\n                <li><a href=\"#\" class=\"sub-item\">> Web 表单</a></li>\n                <li><a href=\"#\" class=\"sub-item\">> 理解客户端工具</a></li>\n            </ul>\n        </aside>\n\n        <!-- Center Content -->\n        <main class=\"content-main\">\n            <div class=\"info-box\">\n                <div class=\"info-box-header\">\n                    <span>ⓘ</span>\n                    <span>此页面由社区从英文翻译而来。<a href=\"#\">了解更多并加入 MDN Web Docs 社区。</a></span>\n                </div>\n                <div class=\"info-box-actions\">\n                    <a href=\"#\" class=\"btn-dark\">View in English</a>\n                    <span>Always switch to English</span>\n                </div>\n            </div>\n\n            <h1>Mozilla 欢迎页面</h1>\n\n            <div class=\"pagination\">\n                <a href=\"#\">← 上一页</a>\n                <a href=\"#\">概述: 使用 HTML 构建 Web</a>\n                <a href=\"#\">下一页 →</a>\n            </div>\n\n            <p>在本测验中，我们将测试你对于本模块文章所介绍的技术的掌握程度。你需要将一些有关于 Mozilla 的图片和视频添加到一个漂亮的页面上！</p>\n\n            <table class=\"prereq-table\">\n                <tr>\n                    <td>前提:</td>\n                    <td>在开始这个测验之前，你应该已经学过本模块的其他文章。</td>\n                </tr>\n                <tr>\n                    <td>目标:</td>\n                    <td>测试对这些知识的掌握程度：在页面中嵌入图片和视频、框架，以及 HTML 响应式图片技术。</td>\n                </tr>\n            </table>\n\n            <h2>起点</h2>\n            <p>要开始本测试，你需要获取 <a href=\"#\">mdn-splash-page-start</a> GitHub 目录中的 HTML 文件和所有可用的图片。将 <a href=\"#\">index.html</a> 的内容保存在本地磁盘上的一个名为 <code>index.html</code> 的文件中，并且将其放在一个新目录中。然后将 <a href=\"#\">pattern.png</a> 保存在同一目录中（右键单击图像后选择保存选项）。</p>\n            \n            <p>以同样的方式访问 <a href=\"#\">originals</a> 目录中的多个图片，并将它们保存下来；你需要将它们保存在不同的目录中，因为你需要在使之用前使用图形编辑器对其中一些图片进行处理。</p>\n            \n            <p>或者，你可以使用在线编辑器，如 <a href=\"#\">CodePen</a>、<a href=\"#\">JSFiddle</a> 或 <a href=\"#\">Glitch</a>。</p>\n\n            <div class=\"info-box\">\n                <div class=\"info-box-header\">\n                    <span>ⓘ</span>\n                    <div>\n                        <p><strong>备注：</strong>示例 HTML 文件包含大量 CSS，用于为页面设置样式。你不需要修改 CSS，只需修改 <code>&lt;body&gt;</code> 元素内的 HTML 即可。只要插入正确的标记，样式就会使其显示正确。</p>\n                        <p style=\"margin-bottom: 0;\">如果你遇到困难，可以在我们的<a href=\"#\">沟通渠道</a>中联系我们。</p>\n                    </div>\n                </div>\n            </div>\n\n            <h2>项目概要</h2>\n            <p>在本测试中，我们为你呈现了一个基本完成的 Mozilla 欢迎页面，其旨在积极有趣地描绘 Mozilla 的价值观，同时提供一些更进一步的资源的链接。不幸的是，页面上还没有添加任何图片或视频，这就是你要完成的任务！你需要添加一些媒体元素，使页面更加美观且更容易理解。下面的小节详细说明了你需要做的事情：</p>\n\n            <h3>准备图片</h3>\n            <p>使用你最爱的图片编辑器，创建下面几张图片的 400px 宽和 120px 宽的版本：</p>\n            <ul>\n                <li><code>firefox_logo-only_RGB.png</code></li>\n                <li><code>firefox-addons.jpg</code></li>\n                <li><code>mozilla-dinosaur-head.png</code></li>\n            </ul>\n            <p>给它们取些有意义的名字，例如 <code>firefoxlogo400.png</code> 和 <code>firefoxlogo120.png</code>。</p>\n            \n            <p>这些图片将与 <code>mdn.svg</code> 一起，作为链接到其他资源的图标，放在 <code>further-info</code> 区域内。你还需要在站点头部中链接 Firefox 标志。你应该将所有这些图片的副本保存在与 <code>index.html</code> 相同的目录中。</p>\n            \n            <p>接下来，创建一个宽度为 1200 像素的横向版 <code>red-panda.jpg</code>，以及一个宽度为 600 像素的纵向版，展示更近距离的熊猫照片。再次，给它们取一个合理的名称，以便你能够轻松识别它们。你应该将这两张图片的副本保存在与 <code>index.html</code> 相同的目录中。</p>\n\n        </main>\n\n        <!-- Right Sidebar -->\n        <aside class=\"sidebar-right\">\n            <div class=\"toc\">\n                <h3>本文内容</h3>\n                <ul>\n                    <li><a href=\"#\" class=\"active\">起点</a></li>\n                    <li><a href=\"#\">项目概要</a></li>\n                    <li><a href=\"#\">提示和技巧</a></li>\n                    <li><a href=\"#\">示例</a></li>\n                </ul>\n            </div>\n\n            <div class=\"ad-block\">\n                <div class=\"ad-label\">广告</div>\n                <div class=\"placeholder\">\n                    <span style=\"font-size: 40px; color: #e24329;\">🦊</span>\n                </div>\n                <h4>Start building faster today</h4>\n                <p>Improve collaboration and visibility with one DevSecOps platform. Learn more from our team.</p>\n           