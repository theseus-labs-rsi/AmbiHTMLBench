        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>The Importance of Ocean Conservation</title>\n<style>\n    body {\n        margin: 0;\n        padding: 0;\n        background-color: #222;\n        display: flex;\n        justify-content: center;\n        font-family: Arial, Helvetica, sans-serif;\n    }\n    .poster {\n        width: 1000px;\n        background-color: #000;\n        color: #fff;\n        box-shadow: 0 0 15px rgba(0,0,0,0.8);\n        position: relative;\n        padding-bottom: 20px; /* space for bottom band */\n    }\n    /* Header styles */\n    .header {\n        background-color: #0d5f76;\n        background-image: linear-gradient(120deg, #0d5f76 0%, #063140 100%);\n        padding: 50px 60px;\n        box-sizing: border-box;\n    }\n    .logo-container {\n        margin-bottom: 50px;\n        display: inline-block;\n    }\n    .logo-main {\n        font-size: 22px;\n        font-weight: 700;\n        line-height: 1.1;\n        letter-spacing: 0.5px;\n    }\n    .logo-sub {\n        font-size: 9px;\n        font-weight: bold;\n        background-color: rgba(255, 255, 255, 0.3);\n        padding: 2px 4px;\n        margin-top: 4px;\n        display: inline-block;\n        letter-spacing: 0.5px;\n    }\n    .header-title {\n        font-size: 26px;\n        font-weight: 400;\n        margin: 0 0 10px 0;\n    }\n    .header-subtitle {\n        font-size: 52px;\n        font-weight: 700;\n        margin: 0 0 25px 0;\n        line-height: 1.2;\n    }\n    .header-intro {\n        font-size: 16px;\n        line-height: 1.5;\n        max-width: 75%;\n        margin: 0;\n    }\n\n    /* Main Body styles */\n    .content {\n        padding: 40px 60px 60px 60px;\n    }\n    .section-heading {\n        color: #5ec0a5;\n        font-size: 18px;\n        margin: 0 0 15px 0;\n        font-weight: 700;\n    }\n    p {\n        font-size: