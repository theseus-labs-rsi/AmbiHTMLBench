        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>STOP TB Infographic</title>\n<style>\n    body {\n        font-family: Arial, Helvetica, sans-serif;\n        margin: 0;\n        padding: 0;\n        background-color: #f4f4f4;\n        color: #333;\n    }\n    .container {\n        max-width: 1000px;\n        margin: 0 auto;\n        background-color: #fff;\n        box-shadow: 0 0 10px rgba(0,0,0,0.1);\n        overflow: hidden;\n    }\n    .placeholder {\n        background-color: #e0e0e0;\n        border: 2px dashed #999;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        text-align: center;\n        color: #666;\n        font-size: 14px;\n        box-sizing: border-box;\n        padding: 10px;\n    }\n    \n    /* Header */\n    .header {\n        background-color: #c1272d;\n        color: white;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        padding: 20px 0;\n        font-size: 110px;\n        font-weight: bold;\n        letter-spacing: 2px;\n    }\n    .header .placeholder {\n        width: 140px;\n        height: 140px;\n        border-radius: 50%;\n        background-color: white;\n        border: 8px solid #c1272d;\n        margin: 0 30px;\n    }\n\n    /* Section 1 */\n    .section1 {\n        display: flex;\n        padding: 40px;\n        background-color: white;\n    }\n    .sec1-left {\n        flex: 1;\n        padding-right: 30px;\n    }\n    .sec1-left h2 {\n        font-size: 28px;\n        font-weight: normal;\n        margin-top: 0;\n        color: #222;\n        line-height: 1.3;\n    }\n    .sec1-left h2 strong {\n        font-weight: bold;\n    }\n    .sec1-left ul {\n        padding-left: 20px;\n        font-size: 18px;\n        line-height: 1.5;\n        margin-top: 20px;\n    }\n    .sec1-left li {\n        margin-bottom: 15px;\n    }\n    .sec1-right {\n        flex: 1.2;\n    }\n    .sec1-right .placeholder {\n        width: 100%;\n        height: 320px;\n        border: none;\n        background-color: #f9f9f9;\n    }\n\n    /* Section 2 */\n    .section2 {\n        display: flex;\n        align-items: stretch;\n    }\n    .sec2-left {\n        flex: 0.35;\n        background-color: #fff;\n    }\n    .sec2-left .placeholder {\n        width: 100%;\n        height: 100%;\n        min-height: 350px;\n        border: none;\n        background-color: #f0f0f0;\n    }\n    .sec2-right {\n        flex: 0.65;\n        display: flex;\n        flex-direction: column;\n    }\n    .sec2-box1 {\n        background-color: #f59c27;\n        padding: 25px 30px;\n        font-size: 28px;\n        color: #1b365d;\n        line-height: 1.2;\n    }\n    .sec2-box2 {\n        background-color: white;\n        padding: 15px 30px;\n        font-size: 24px;\n        color: #333;\n    }\n    .sec2-box2 strong {\n        color: #c1272d;\n    }\n    .sec2-box3 {\n        background-color: #f8b154;\n        padding: 25px 30px;\n        flex-grow: 1;\n    }\n    .sec2-box3 ul {\n        margin: 0;\n        padding-left: 20px;\n        font-size: 16px;\n        line-height: 1.5;\n        color: #222;\n    }\n    .sec2-box3 li {\n        margin-bottom: 15px;\n    }\n\n    /* Bottom Section */\n    .bottom-section {\n        display: flex;\n        background-color: #d9e8f5;\n        padding: 40px;\n        gap: 40px;\n    }\n    .sec3 {\n        flex: 1;\n        display: flex;\n        flex-direction: column;\n    }\n    .sec3 h2 {\n        font-size: 28px;\n        font-weight: normal;\n        margin-top: 0;\n        color: #222;\n        line-height: 1.3;\n    }\n    .sec3 ul {\n        padding-left: 20px;\n        font-size: 18px;\n        line-height: 1.5;\n    }\n    .sec3 li {\n        margin-bottom: 15px;\n    }\n    .sec3 .placeholder {\n        width: 100%;\n        height: 280px;\n        margin-top: auto;\n        border: none;\n        background-color: transparent;\n    }\n\n    .sec4 {\n        flex: 1.2;\n        display: flex;\n        flex-direction: column;\n    }\n    .symptoms-box {\n        background-color: white;\n        border: 3px solid #1b365d;\n        padding: 25px;\n        border-radius: 5px;\n    }\n    .symptoms-box h3 {\n        margin-top: 0;\n        color: #1b365d;\n        font-size: 24px;\n        text-align: center;\n        margin-bottom: 25px;\n    }\n    .symptoms-grid {\n        display: grid;\n        grid-template-columns: repeat(4, 1fr);\n        gap: 20px 10px;\n        text-align: center;\n    }\n    .symptom-item {\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        font-size: 12px;\n        line-height: 1.3;\n    }\n    .symptom-item .placeholder {\n        width: 65px;\n        height: 65px;\n        border-radius: 50%;\n        margin-bottom: 10px;\n        border: none;\n        background-color: #eee;\n    }\n    .symptom-item em {\n        font-size: 10px;\n        color: #555;\n        font-style: italic;\n        display: block;\n        margin-top: 2px;\n    }\n    .sec4-text {\n        margin-top: 35px;\n        font-size: 34px;\n        color: #1b365d;\n        line-height: 1.2;\n    }\n\n    /* Footer */\n    .footer {\n        background-color: #c1272d;\n        color: white;\n        padding: 20px 30px;\n        position: relative;\n        display: flex;\n        align-items: center;\n        height: 40px;\n    }\n    .footer-left {\n        font-size: 18px;\n    }\n    .footer-right {\n        position: absolute;\n        right: 0;\n        bottom: 0;\n        background-color: #1b365d;\n        padding: 15px 20px;\n        display: flex;\n        align-items: center;\n        border-top-left-radius: 15px;\n    }\n    .footer-right .placeholder {\n        width: 100px;\n        height: 40px;\n        margin-right: 15px;\n        background-color: transparent;\n        border: 1px solid rgba(255,255,255,0.3);\n        color: white;\n    }\n    .footer-right-text {\n        font-size: 11px;\n        line-height: 1.3;\n        color: white;\n    }\n</style>\n</head>\n<body>\n\n<div class=\"container\">\n    <!-- Header -->\n    <div class=\"header\">\n        <div>STOP</div>\n        <div class=\"placeholder\">[Lung Icon]</div>\n        <div>TB</div>\n    </div>\n\n    <!-- Section 1 -->\n    <div class=\"section1\">\n        <div class=\"sec1-left\">\n            <h2>Tuberculosis (TB) spreads<br><strong>through the air</strong> from one<br>person to another.</h2>\n            <ul>\n                <li>TB germs spread when a person with infectious<br>TB disease <strong>coughs, speaks, or sings.</strong></li>\n                <li>TB germs usually <strong>attack the lungs</strong> but can<br>also move to any part of the body.</li>\n            </ul>\n        </div>\n        <div class=\"sec1-right\">\n            <div class=\"placeholder\">[Illustration: Two people, one coughing, spreading germs. Magnified lungs showing germs.]</div>\n        </div>\n    </div>\n\n    <!-- Section 2 -->\n    <div class=\"section2\">\n        <div class=\"sec2-left\">\n            <div class=\"placeholder\">[Illustration: Man with magnified lung showing contained germ.]</div>\n        </div>\n        <div class=\"sec2-right\">\n            <div class=\"sec2-box1\">\n                TB germs can live in the body <strong>without<br>making you sick.</strong>\n            </div>\n            <div class=\"sec2-box2\">\n                This is called <strong>latent TB infection</strong> or <strong>inactive TB.</strong>\n            </div>\n            <div class=\"sec2-box3\">\n                <ul>\n                    <li>TB germs can live in your body for years without causing symptoms. Without<br>treatment, <strong>inactive TB can develop into active TB disease</strong> and make you sick.</li>\n                    <li>If you have inactive TB, you can take TB medicine to <strong>prevent the development<br>of active TB disease</strong> even if you do not feel sick.</li>\n                </ul>\n            </div>\n        </div>\n    </div>\n\n    <!-- Bottom Section -->\n    <div class=\"bottom-section\">\n        <div class=\"sec3\">\n            <h2>If your body cannot stop TB<br>germs from growing, <strong>you<br>develop active TB disease.</strong></h2>\n            <ul>\n                <li>You may <strong>feel sick</strong> and <strong>spread TB germs</strong> to<br>your family, friends, and others around you.</li>\n                <li>You need to <strong>take and finish all your<br>TB medicine</strong> to help you feel better and<br>prevent other people from getting sick.</li>\n            </ul>\n            <div class=\"placeholder\">[Illustration: Patient and doctor with medicine bottles.]</div>\n        </div>\n        <div class=\"sec4\">\n            <div class=\"symptoms-box\">\n                <h3>Symptoms of active TB disease:</h3>\n                <div class=\"symptoms-grid\">\n                    <div class=\"symptom-item\">\n                        <div class=\"placeholder\">[Icon]</div>\n                        <span>Cough lasting<br>3+ weeks</span>\n                    </div>\n                    <div class=\"symptom-item\">\n                        <div class=\"placeholder\">[Icon]</div>\n                        <span>Coughing up blood or<br>sputum <em>(phlegm from<br>deep inside the lungs)</em></span>\n                    </div>\n                    <div class=\"symptom-item\">\n                        <div class=\"placeholder\">[Icon]</div>\n                        <span>Chest pain</span>\n                    </div>\n                    <div class=\"symptom-item\">\n                        <div class=\"placeholder\">[Icon]</div>\n                        <span>Weakness<br>or fatigue</span>\n                    </div>\n                    <div class=\"symptom-item\">\n                        <div class=\"placeholder\">[Icon]</div>\n                        <span>No appetite</span>\n                    </div>\n                    <div class=\"symptom-item\">\n                        <div class=\"placeholder\">[Icon]</div>\n                        <span>Weight loss</span>\n                    </div>\n                    <div class=\"symptom-item\">\n                        <div class=\"placeholder\">[Icon]</div>\n                        <span>Fever and/or chills</span>\n                    </div>\n                    <div class=\"symptom-item\">\n                        <div class=\"placeholder\">[Icon]</div>\n                        <span>Night sweats</span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"sec4-text\">\n                Take and finish all of<br>\n                your TB medicine to <strong>kill<br>\n                TB germs</strong> and <strong>STOP TB!</strong>\n            </div>\n        </div>\n    </div>\n\n    <!-- Footer -->\n    <div class=\"footer\">\n        <div class=\"footer-left\">\n            Publication Number: 6474\n        </div>\n        <div class=\"footer-right\">\n            <div class=\"placeholder\">[CDC Logos]</div>\n            <div class=\"footer-right-text\">\n                Centers for Disease<br>\n                Control and Prevention<br>\n                National Center for HIV,<br>\n                Viral Hepatitis, STD, and<br>\n                TB Prevention\n            </div>\n        </div>\n    </div>\n</div>\n\n</body>\n</html>"
