ue);\n            border-bottom: 1px solid var(--border-blue);\n            display: flex;\n            flex-direction: column;\n            background-color: #fff;\n        }\n\n        .tool-header {\n            display: flex;\n            align-items: center;\n            padding: 12px;\n            gap: 8px;\n        }\n\n        .tool-num {\n            background-color: var(--dark-blue);\n            color: white;\n            width: 22px;\n            height: 22px;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 14px;\n            font-weight: bold;\n            flex-shrink: 0;\n        }\n\n        .tool-name {\n            color: var(--dark-blue);\n            font-weight: bold;\n            font-size: 16px;\n            letter-spacing: 1px;\n        }\n\n        .tool-img-box {\n            height: 120px;\n            margin: 0 10px 10px;\n        }\n\n        .tool-desc-box {\n            background-color: var(--light-blue-bg);\n            padding: 10px;\n            font-size: 12px;\n            color: var(--text-dark);\n            flex-grow: 1;\n            display: flex;\n            flex-direction: column;\n            gap: 4px;\n        }\n\n        .desc-row {\n            display: flex;\n            align-items: flex-start;\n        }\n\n        .desc-label {\n            font-weight: bold;\n            color: var(--dark-blue);\n            width: 40px;\n            flex-shrink: 0;\n        }\n\n        .desc-text {\n            flex-grow: 1;\n            line-height: 1.4;\n        }\n\n        /* Grid 2: Tutorials */\n        .tutorial-grid {\n            display: grid;\n            grid-template-columns: repeat(6, 1fr);\n            gap: 15px;\n            margin-top: 10px;\n        }\n\n        .tutorial-item {\n            display: flex;\n            flex-direction: column;\n        }\n\n        .tutorial-title {\n            color: var(--teal);\n            font-size: 16px;\n            font-weight: bold;\n            text-align: center;\n            margin-bottom: 10px;\n        }\n\n        .tutorial-img-box {\n            height: 100px;\n            margin-bottom: 10px;\n        }\n\n        .tutorial-desc {\n            background-color: var(--light-teal-bg);\n            padding: 10px;\n            font-size: 12px;\n            color: var(--text-dark);\n            line-height: 1.5;\n            flex-grow: 1;\n        }\n\n        /* Safety Section */\n        .safety-section {\n            display: flex;\n            margin: 0 20px 20px;\n            border: 1px solid #ddd;\n            background-color: #fafafa;\n        }\n\n        .safety-left {\n            background-color: var(--safety-red);\n            color: white;\n            width: 140px;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            padding: 20px 10px;\n        }\n\n        .safety-icon-large {\n            width: 50px;\n            height: 50px;\n            margin-bottom: 10px;\n            border: none;\n            background: transparent;\n            font-size: 40px;\n        }\n\n        .safety-left-text {\n            font-size: 20px;\n            font-weight: bold;\n            text-align: center;\n            line-height: 1.2;\n        }\n\n        .safety-middle {\n            flex-grow: 1;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            padding: 20px;\n            gap: 15px 30px;\n        }\n\n        .safety-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 10px;\n            font-size: 14px;\n            color: var(--text-dark);\n            line-height: 1.4;\n        }\n\n        .s-marker {\n            width: 20px;\n            height: 20px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            font-size: 12px;\n            font-weight: bold;\n            flex-shrink: 0;\n            margin-top: 2px;\n        }\n\n        .s-marker.circle {\n            background-color: var(--dark-blue);\n            border-radius: 50%;\n        }\n\n        .s-marker.square {\n            background-color: #3b65a5;\n            border-radius: 3px;\n        }\n\n        .s-marker.icon-ph {\n            background-color: transparent;\n            border: 1px solid #ccc;\n            color: #666;\n        }\n        \n        .s-marker.icon-ph-warn {\n            width: auto;\n            border: none;\n            color: #e5a910;\n            font-size: 18px;\n            background: transparent;\n        }\n\n        .safety-right {\n            width: 180px;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            padding: 10px;\n            border-left: 1px dashed #ccc;\n            position: relative;\n        }\n        \n        .helmet-ph {\n            width: 80px;\n            height: 70px;\n            margin-bottom: 5px;\n            border-radius: 50%;\n        }\n\n        .safety-right-text {\n            font-size: 16px;\n            font-weight: bold;\n            color: var(--text-dark);\n            text-align: center;\n            line-height: 1.4;\n        }\n\n        .watermark {\n            position: absolute;\n            bottom: 5px;\n            right: 10px;\n            color: #e0e0e0;\n            font-size: 30px;\n            font-weight: bold;\n            z-index: 0;\n            pointer-events: none;\n        }\n    </style>\n</head>\n<body>\n\n<div class=\"poster\">\n    <!-- Header -->\n    <div class=\"header\">\n        <div class=\"placeholder header-left\">[工具箱图片]</div>\n        <div class=\"header-center\">\n            <div class=\"main-title-container\">\n                <h1 class=\"main-