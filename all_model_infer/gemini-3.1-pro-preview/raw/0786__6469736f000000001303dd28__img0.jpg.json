        "content": "<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>金陵十二钗正册判词</title>\n    <style>\n        body {\n            background-color: #fdfaf6;\n            background-image: \n                linear-gradient(#f0e8dc 1px, transparent 1px),\n                linear-gradient(90deg, #f0e8dc 1px, transparent 1px);\n            background-size: 25px 25px;\n            font-family: 'KaiTi', '楷体', STKaiti, serif;\n            color: #9c3f35;\n            margin: 0;\n            padding: 40px 20px;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n        }\n\n        .title-wrapper {\n            margin-bottom: 50px;\n            background-color: #fdfaf6;\n            padding: 0 15px;\n        }\n\n        .main-title {\n            border: 2px solid #bd4b41;\n            padding: 10px 25px;\n            font-size: 28px;\n            font-weight: bold;\n            letter-spacing: 2px;\n            color: #bd4b41;\n        }\n\n        .grid-container {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 40px 30px;\n            width: 100%;\n            max-width: 1100px;\n        }\n\n        .card {\n            position: relative;\n            display: flex;\n            align-items: center;\n            min-height: 140px;\n        }\n\n        .img-placeholder {\n            position: absolute;\n            left: -10px;\n            top: 50%;\n            transform: translateY(-50%);\n            width: 75px;\n            height: 130px;\n            background-color: #fdfaf6;\n            border: 1px dashed #bd4b41;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 12px;\n            color: #bd4b41;\n            text-align: center;\n            padding: 5px;\n            box-sizing: border-box;\n            z-index: 2;\n        }\n\n        .text-box {\n            border: 1px solid #d4a39f;\n            width: 100%;\n            margin-left: 20px;\n            padding: 15px 15px 15px 55px;\n            box-sizing: border-box;\n            z-index: 1;\n        }\n\n        .char-name {\n            font-size: 18px;\n            font-weight: bold;\n            margin-bottom: 8px;\n            color: #9c3f35;\n        }\n\n        .poem {\n            font-size: 16px;\n            line-height: 1.6;\n            margin: 0;\n            color: #9c3f35;\n        }\n\n        @media (max-width: 900px) {\n            .grid-container {\n                grid-template-columns: repeat(2, 1fr);\n            }\n        }\n\n        @media (max-width: 600px) {\n            .grid-container {\n                grid-template-columns: 1fr;\n            }\n        }\n    </style>\n</head>\n<body>\n\n    <div class=\"title-wrapper\">\n        <div class=\"main-title\">金陵十二钗正册判词</div>\n    </div>\n\n    <div class=\"grid-container\">\n        \n        <!-- Row 1 -->\n        <div class=\"card\">\n            <div class=\"img-placeholder placeholder\">[Illustration:<br>林黛玉]</div>\n            <div class=\"text-box\">\n                <div class=\"char-name\">林黛玉 (情情)</div>\n                <div class=\"poem\">\n                    可叹停机德，<br>\n                    堪怜咏絮才。<br>\n                    玉带林中挂，<br>\n                    金簪雪里埋。\n                </div>\n            </div>\n        </div>\n\n        <div class=\"card\">\n            <div class=\"img-placeholder placeholder\">[Illustration:<br>薛宝钗]</div>\n            <div class=\"text-box\">\n                <div class=\"char-name\">薛宝钗 (无情)</div>\n                <div class=\"poem\">\n                    可叹停机德，<br>\n                    堪怜咏絮才。<br>\n                    玉带林中挂，<br>\n                    金簪雪里埋。\n                </div>\n            </div>\n        </div>\n\n        <div class=\"card\">\n            <div class=\"img-placeholder placeholder\">[Illustration:<br>王熙凤]</div>\n            <div class=\"text-box\">\n                <div class=\"char-name\">王熙凤 (情雄)</div>\n                <div class=\"poem\">\n                    凡鸟偏从末世来，<br>\n                    都知爱慕此生才。<br>\n                    一从二令三人木，<br>\n                    哭向金陵事更哀。\n                </div>\n            </div>\n        </div>\n\n        <!-- Row 2 -->\n        <div class=\"card\">\n            <div class=\"img-placeholder placeholder\">[Illustration:<br>贾元春]</div>\n            <div class=\"text-box\">\n                <div class=\"char-name\">贾元春 (情尊)</div>\n                <div class=\"poem\">\n                    二十年来辨是非，<br>\n                    榴花开处照宫闱。<br>\n                    三春争及初春景，<br>\n                    虎兕相逢大梦归。\n                </div>\n            </div>\n        </div>\n\n        <div class=\"card\">\n            <div class=\"img-placeholder placeholder\">[Illustration:<br>贾迎春]</div>\n            <div class=\"text-box\">\n                <div class=\"char-name\">贾迎春 (情懦)</div>\n                <div class=\"poem\">\n                    子系中山狼，<br>\n                    得志便猖狂。<br>\n                    金闺花柳质，<br>\n                    一载赴黄粱。\n                </div>\n            </div>\n        </div>\n\n        <div class=\"card\">\n            <div class=\"img-placeholder placeholder\">[Illustration:<br>贾探春]</div>\n            <div class=\"text-box\">\n                <div class=\"char-name\">贾探春 (情敏)</div>\n                <div class=\"poem\">\n                    才自精明志自高，<br>\n                    生于末世运偏消。<br>\n                    清明涕送江边望，<br>\n                    千里东风一梦遥。\n                </div>\n            </div>\n        </div>\n\n        <!-- Row 3 -->\n        <div class=\"card\">\n            <div class=\"img-placeholder placeholder\">[Illustration:<br>贾惜春]</div>\n            <div class=\"text-box\">\n                <div class=\"char-name\">贾惜春 (情冷)</div>\n                <div class=\"poem\">\n                    勘破三春景不长，<br>\n                    缁衣顿改昔年妆。<br>\n                    可怜绣户侯门女，<br>\n                    独卧青灯古佛旁。\n                </div>\n            </div>\n        </div>\n\n        <div class=\"card\">\n            <div class=\"img-placeholder placeholder\">[Illustration:<br>史湘云]</div>\n            <div class=\"text-box\">\n                <div class=\"char-name\">史湘云 (情憨)</div>\n                <div class=\"poem\">\n                    富贵又何为？<br>\n                    襁褓之间父母违。<br>\n                    展眼吊斜晖，<br>\n                    湘江水逝楚云飞。\n                </div>\n            </div>\n        </div>\n\n        <div class=\"card\">\n            <div class=\"img-placeholder placeholder\">[Illustration:<br>秦可卿]</div>\n            <div class=\"text-box\">\n                <div class=\"char-name\">秦可卿 (情孽)</div>\n                <div class=\"poem\">\n                    情天情海幻情身，<br>\n                    情既相逢必主淫。<br>\n                    漫言不肖皆荣出，<br>\n                    造衅开端实在宁。\n                </div>\n            </div>\n        </div>\n\n        <!-- Row 4 -->\n        <div class=\"card\">\n            <div class=\"img-placeholder placeholder\">[Illustration:<br>妙玉]</div>\n            <div class=\"text-box\">\n                <div class=\"char-name\">妙玉 (情隐)</div>\n                <div class=\"poem\">\n                    欲洁何曾洁？<br>\n                    云空未必空。<br>\n                    可怜金玉质，<br>\n                    终陷淖泥中。\n                </div>\n            </div>\n        </div>\n\n        <div class=\"card\">\n            <div class=\"img-placeholder placeholder\">[Illustration:<br>贾巧姐]</div>\n            <div class=\"text-box\">\n                <div class=\"char-name\">贾巧姐 (情缘)</div>\n                <div class=\"poem\">\n                    势败休云贵，<br>\n                    家亡莫论亲。<br>\n                    偶因济刘氏，<br>\n                    巧得遇恩人。\n                </div>\n            </div>\n        </div>\n\n        <div class=\"card\">\n            <div class=\"img-placeholder placeholder\">[Illustration:<br>李纨]</div>\n            <div class=\"text-box\">\n                <div class=\"char-name\">李纨 (情槁)</div>\n                <div class=\"poem\">\n                    桃李春风结子完，<br>\n                    到头谁似一盆兰。<br>\n                    如冰水好空相妒，<br>\n                    枉与他人作笑谈。\n                </div>\n            </div>\n        </div>\n\n    </div>\n\n</body>\n</html>"
