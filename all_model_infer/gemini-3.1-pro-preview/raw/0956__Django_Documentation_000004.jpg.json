        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Django Documentation</title>\n<style>\n    /* Reset and Base Styles */\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body {\n        font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n        line-height: 1.6;\n        color: #333;\n        background-color: #fff;\n        font-size: 15px;\n    }\n    a { color: #1e7e54; text-decoration: none; }\n    a:hover { text-decoration: underline; }\n    code {\n        font-family: Consolas, Monaco, \"Andale Mono\", \"Ubuntu Mono\", monospace;\n        background-color: #f4f4f4;\n        padding: 0.1em 0.3em;\n        border-radius: 3px;\n        font-size: 0.9em;\n    }\n\n    /* Header */\n    .top-bar {\n        background-color: #0c4b33;\n        color: white;\n        display: flex;\n        align-items: center;\n        padding: 0 20px;\n        height: 50px;\n        font-size: 12px;\n        font-weight: bold;\n    }\n    .logo {\n        font-size: 22px;\n        font-weight: bold;\n        margin-right: 30px;\n        letter-spacing: -0.5px;\n    }\n    .main-nav {\n        display: flex;\n        gap: 15px;\n        flex-grow: 1;\n    }\n    .main-nav a {\n        color: white;\n        text-transform: uppercase;\n    }\n    .main-nav a.active { color: #44b78b; }\n    .main-nav a.donate { color: white; }\n    .search-container {\n        display: flex;\n        align-items: center;\n        background: white;\n        border-radius: 3px;\n        padding: 4px 8px;\n        margin-right: 15px;\n    }\n    .search-container input {\n        border: none;\n        outline: none;\n        font-size: 13px;\n        width: 120px;\n    }\n    .search-icon { color: #666; font-size: 12px; }\n    .theme-toggle { font-size: 16px; cursor: pointer; }\n\n    /* Sub-header */\n    .sub-header {\n        background-color: #44b78b;\n        color: white;\n        padding: 12px 20px;\n    }\n    .sub-header h1 {\n        font-size: 22px;\n        font-weight: 300;\n        max-width: 1100px;\n        margin: 0 auto;\n    }\n\n    /* Survey Banner */\n    .survey-banner {\n        background-color: #a3e4c6;\n        text-align: center;\n        padding: 30px 20px;\n    }\n    .survey-banner h2 {\n        font-size: 20px;\n        margin-bottom: 15px;\n        font-weight: 400;\n        color: #000;\n    }\n    .survey-banner p {\n        max-width: 850px;\n        margin: 0 auto 15px auto;\n        color: #111;\n        font-size: 14px;\n    }\n    .survey-banner button {\n        background-color: #44b78b;\n        color: white;\n        border: none;\n        padding: 10px 20px;\n        font-size: 14px;\n        font-weight: bold;\n        border-radius: 3px;\n        cursor: pointer;\n        margin-top: 5px;\n    }\n\n    /* Main Layout */\n    .main-container {\n        display: flex;\n        max-width: 1100px;\n        margin: 0 auto;\n    }\n    .content {\n        flex: 1;\n        padding: 30px 40px 30px 0;\n    }\n    .sidebar {\n        width: 320px;\n        background-color: #f8f9fa;\n        padding: 30px 20px;\n    }\n\n    /* Content Area */\n    .content h1 {\n        font-size: 28px;\n        font-weight: 400;\n        margin-bottom: 5px;\n        color: #0c4b33;\n    }\n    .content h2 {\n        font-size: 20px;\n        font-weight: 400;\n        margin-top: 25px;\n        margin-bottom: 15px;\n        color: #0c4b33;\n    }\n    .pilcrow { color: #44b78b; margin-left: 5px; }\n    .date {\n        font-style: italic;\n        color: #555;\n        margin-bottom: 20px;\n        font-size: 13px;\n    }\n    .content p { margin-bottom: 15px; }\n    .content strong { font-weight: 600; }\n    .pagination {\n        display: flex;\n        justify-content: space-between;\n        margin-top: 40px;\n        padding-top: 15px;\n        border-top: 1px solid #eee;\n        font-weight: bold;\n        font-size: 13px;\n    }\n\n    /* Sidebar */\n    .sidebar section { margin-bottom: 30px; }\n    .sidebar h3 {\n        font-size: 16px;\n        font-weight: 400;\n        margin-bottom: 15px;\n        color: #333;\n        border-bottom: 1px solid #e0e0e0;\n        padding-bottom: 5px;\n    }\n    .support-content {\n        display: flex;\n        gap: 15px;\n        font-size: 12px;\n        line-height: 1.4;\n    }\n    .heart-icon {\n        width: 40px;\n        height: 40px;\n        background-color: #e83e8c;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        color: white;\n        font-size: 10px;\n        flex-shrink: 0;\n    }\n    .sidebar ul {\n        list-style-type: none;\n        padding-left: 0;\n        font-size: 13px;\n    }\n    .sidebar ul li { margin-bottom: 8px; }\n    \n    /* Specific List Styles */\n    .contents-list > ul > li { list-style-type: disc; margin-left: 15px; }\n    .contents-list > ul > li > ul { margin-top: 5px; }\n    .contents-list > ul > li > ul > li { list-style-type: circle; margin-left: 20px; }\n    \n    .browse > ul > li { list-style-type: disc; margin-left: 15px; }\n    \n    .you-are-here > ul > li { list-style-type: disc; margin-left: 15px; }\n    .you-are-here > ul > li > ul { margin-top: 5px; }\n    .you-are-here > ul > li > ul > li { list-style-type: circle; margin-left: 20px; }\n    .you-are-here > ul > li > ul > li > ul { margin-top: 5px; }\n    .you-are-here > ul > li > ul > li > ul > li { list-style-type: square; margin-left: 20px; color: #333; }\n\n    .sidebar dl { font-size: 13px; }\n    .sidebar dt { margin-top: 12px; }\n    .sidebar dd { margin-left: 0; color: #555; margin-bottom: 5px; line-height: 1.4; }\n\n    /* Floating Controls */\n    .floating-controls {\n        position: fixed;\n        bottom: 20px;\n        right: 20px;\n        display: flex;\n        flex-direction: column;\n        align-items: flex-end;\n        gap: 8px;\n        z-index: 1000;\n    }\n    .control-row {\n        display: flex;\n        gap: 8px;\n        align-items: center;\n    }\n    .control-box {\n        background: #fff;\n        border: 1px solid #e0e0e0;\n        padding: 6px 10px;\n        font-size: 11px;\n        color: #333;\n        border-radius: 2px;\n        box-shadow: 0 1px 2px rgba(0,0,0,0.05);\n    }\n    .control-box.green-text { color: #1e7e54; }\n    .back-to-top {\n        padding: 6px 12px;\n        color: #1e7e54;\n        font-weight: bold;\n        cursor: pointer;\n    }\n</style>\n</head>\n<body>\n\n<header class=\"top-bar\">\n    <div class=\"logo\">django</div>\n    <nav class=\"main-nav\">\n        <a href=\"#\">OVERVIEW</a>\n        <a href=\"#\">DOWNLOAD</a>\n        <a href=\"#\" class=\"active\">DOCUMENTATION</a>\n        <a href=\"#\">NEWS</a>\n        <a href=\"#\">CODE</a>\n        <a href=\"#\">ISSUES</a>\n        <a href=\"#\">COMMUNITY</a>\n        <a href=\"#\">FOUNDATION</a>\n        <a href=\"#\" class=\"donate\">♥ DONATE</a>\n    </nav>\n    <div class=\"search-container\">\n        <input type=\"text\" placeholder=\"Search (⌘ K)\">\n        <span class=\"search-icon\">🔍</span>\n    </div>\n    <div class=\"theme-toggle\">◑</div>\n</header>\n\n<div class=\"sub-header\">\n    <h1>Documentation</h1>\n</div>\n\n<div class=\"survey-banner\">\n    <h2>Django Developer Survey</h2>\n    <p>The Django Software Foundation is once again partnering with JetBrains to run the 2026 Django Developer Survey 📊 Help us better understand how Django is being used around the world and guide future technical and community decisions. <strong>Read more on the Django blog.</strong></p>\n    <p>Please help us spread the word by sharing the survey with your communities and on social media 📣 The more diverse the responses, the better the results for everyone.</p>\n    <button>Take the survey ✨</button>\n</div>\n\n<div class=\"main-container\">\n    <main class=\"content\">\n        <h1>Django 4.1.12 release notes <a href=\"#\" class=\"pilcrow\">¶</a></h1>\n        <p class=\"date\">October 4, 2023</p>\n        <p>Django 4.1.12 fixes a security issue with severity \"moderate\" in 4.1.11.</p>\n\n        <h2>CVE-2023-43665: Denial-of-service possibility in <code>django.utils.text.Truncator</code> <a href=\"#\" class=\"pilcrow\">¶</a></h2>\n        <p>Following the fix for <strong>CVE 2019-14232</strong>, the regular expressions used in the implementation of <code>django.utils.text.Truncator</code>'s <code>chars()</code> and <code>words()</code> methods (with <code>html=True</code>) were revised and improved. However, these regular expressions still exhibited linear backtracking complexity, so when given a very long, potentially malformed HTML input, the evaluation would still be slow, leading to a potential denial of service vulnerability.</p>\n        <p>The <code>chars()</code> and <code>words()</code> methods are used to implement the <code>truncatechars_html</code> and <code>truncatewords_html</code> template filters, which were thus also vulnerable.</p>\n        <p>The input processed by <code>Truncator</code>, when operating in HTML mode, has been limited to the first five million characters in order to avoid potential performance and memory issues.</p>\n\n        <div class=\"pagination\">\n            <a href=\"#\" class=\"prev\">&lt; Django 4.1.13 release notes</a>\n            <a href=\"#\" class=\"next\">Django 4.1.11 release notes &gt;</a>\n        </div>\n    </main>\n\n    <aside class=\"sidebar\">\n        <section class=\"support\">\n            <h3>Support Django!</h3>\n            <div class=\"support-content\">\n                <div class=\"placeholder heart-icon\" title=\"[Pixel Heart Graphic]\">[Heart]</div>\n                <p><a href=\"#\">Agence Debord donated to the Django Software Foundation to support Django development. Donate today!</a></p>\n            </div>\n        </section>\n\n        <section class=\"contents-list\">\n            <h3>Contents</h3>\n            <ul>\n                <li><a href=\"#\">Django 4.1.12 release notes</a>\n                    <ul>\n                        <li><a href=\"#\">CVE-2023-43665: Denial-of-service possibility in <code>django.utils.text.Truncator</code></a></li>\n                    </ul>\n                </li>\n            </ul>\n        </section>\n\n        <section class=\"browse\">\n            <h3>Browse</h3>\n            <ul>\n                <li>Prev: <a href=\"#\">Django 4.1.13 release notes</a></li>\n                <li>Next: <a href=\"#\">Django 4.1.11 release notes</a></li>\n                <li><a href=\"#\">Table of contents</a></li>\n                <li><a href=\"#\">General Index</a></li>\n                <li><a href=\"#\">Python Module Index</a></li>\n            </ul>\n        </section>\n\n        <section class=\"you-are-here\">\n            <h3>You are here:</h3>\n            <ul>\n                <li><a href=\"#\">Django 5.2 documentation</a>\n                    <ul>\n                        <li><a href=\"#\">Release notes</a>\n                            <ul>\n                                <li>Django 4.1.12 release notes</li>\n                            </ul>\n                        </li>\n                    </ul>\n                </li>\n            </ul>\n        </section>\n\n        <section class=\"getting-help\">\n            <h3>Getting help</h3>\n            <dl>\n                <dt><a href=\"#\">FAQ</a></dt>\n                <dd>Try the FAQ — it's got answers to many common questions.</dd>\n                <dt><a href=\"#\">Index</a>, <a href=\"#\">Module Index</a>, or <a href=\"#\">Table of Contents</a></dt>\n                <dd>Handy when looking for specific information.</dd>\n                <dt><a href=\"#\">Django Discord Server</a></dt>\n                <dd>Join the Django Discord Community.</dd>\n            </dl>\n        </section>\n    </aside>\n</div>\n\n<div class=\"floating-controls\">\n    <div class=\"control-box green-text\">Getting Help</div>\n    <div class=\"control-box\">Language: en</div>\n    <div class=\"control-row\">\n        <div class=\"control-box\">Documentation version: 5.2</div>\n        <div class=\"control-box back-to-top\">^</div>\n    </div>\n</div>\n\n</body>\n</html>"
