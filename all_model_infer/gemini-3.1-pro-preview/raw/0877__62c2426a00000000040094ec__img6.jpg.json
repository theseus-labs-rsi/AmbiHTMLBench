        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Medical Notes</title>\n    <style>\n        body {\n            font-family: \"SimSun\", \"Songti SC\", serif;\n            background-color: #e0e0e0;\n            display: flex;\n            justify-content: center;\n            padding: 20px;\n            color: #000;\n            margin: 0;\n        }\n        .document {\n            background-color: #fff;\n            padding: 40px 50px;\n            width: 750px;\n            box-shadow: 0 4px 10px rgba(0,0,0,0.2);\n        }\n        .section-title {\n            font-size: 1.25em;\n            font-weight: bold;\n            margin-top: 35px;\n            margin-bottom: 20px;\n            letter-spacing: 1px;\n        }\n        .table-caption {\n            text-align: center;\n            font-size: 1.1em;\n            font-weight: bold;\n            margin-bottom: 12px;\n            letter-spacing: 1px;\n        }\n        table {\n            width: 100%;\n            border-collapse: collapse;\n            margin-bottom: 8px;\n            font-size: 0.95em;\n        }\n        th, td {\n            border: 1px solid #000;\n            padding: 10px 12px;\n            vertical-align: middle;\n            line-height: 1.4;\n        }\n        .bg-gray {\n            background-color: #e8e8e8;\n        }\n        .text-center {\n            text-align: center;\n        }\n        .note {\n            font-size: 0.85em;\n            margin-top: 5px;\n            margin-bottom: 30px;\n            color: #222;\n            padding-left: 5px;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"document\">\n        <!-- Section 14 -->\n        <div class=\"section-title\">14. 鹅口疮与外阴阴道假丝酵母菌病</div>\n        <div class=\"table-caption\">鹅口疮与外阴阴道假丝酵母菌病异同点</div>\n        <table>\n            <tr>\n                <th class=\"bg-gray text-center\" style=\"width: 20%;\">疾病</th>\n                <th class=\"bg-gray text-center\" style=\"width: 40%;\">鹅口疮</th>\n                <th class=\"bg-gray text-center\" style=\"width: 40%;\">外阴阴道假丝酵母菌病</th>\n            </tr>\n            <tr>\n                <td class=\"bg-gray text-center\">致病菌</td>\n                <td>白色念珠菌</td>\n                <td>白色念珠菌</td>\n            </tr>\n            <tr>\n                <td class=\"bg-gray text-center\">临床表现</td>\n                <td>口腔黏膜白色乳凝块</td>\n                <td>白带呈豆渣样</td>\n            </tr>\n            <tr>\n                <td class=\"bg-gray text-center\">治疗</td>\n                <td>2% 碳酸氢钠</td>\n                <td>2%~4% 碳酸氢钠</td>\n            </tr>\n        </table>\n        <div class=\"note\">注：白色念珠菌属于真菌，又名白假丝酵母菌</div>\n\n        <!-- Section 15 -->\n        <div class=\"section-title\">15. 胃溃疡和十二指肠溃疡</div>\n        <div class=\"table-caption\">胃溃疡和十二指肠溃疡的特点</div>\n        <table>\n            <tr>\n                <th class=\"bg-gray text-center\" style=\"width: 20%;\"></th>\n                <th class=\"bg-gray text-center\" style=\"width: 40%;\">胃溃疡(GU)</th>\n                <th class=\"bg-gray text-center\" style=\"width: 40%;\">十二指肠溃疡(DU)</th>\n            </tr>\n            <tr>\n                <td class=\"bg-gray text-center\">病变部位</td>\n                <td>胃角和胃窦小弯</td>\n                <td>球部前壁</td>\n            </tr>\n            <tr>\n                <td class=\"bg-gray text-center\">发病机制</td>\n                <td>主要是保护因素减弱</td>\n                <td>主要是侵袭因素增强</td>\n            </tr>\n            <tr>\n                <td class=\"bg-gray text-center\">疼痛部位</td>\n                <td>剑突下正中或偏左</td>\n                <td>上腹正中或偏右</td>\n            </tr>\n            <tr>\n                <td class=\"bg-gray text-center\">疼痛性质</td>\n                <td>烧灼感或痉挛感</td>\n                <td>饥饿感或烧灼感</td>\n            </tr>\n            <tr>\n                <td class=\"bg-gray text-center\">疼痛时间</td>\n                <td>餐后痛即进食后 0.5~1<br>小时出现，至下餐前消失</td>\n                <td>空腹痛即进食后 2~3 小时出现，<br>下次进餐后缓解，可有夜间痛</td>\n            </tr>\n            <tr>\n                <td class=\"bg-gray text-center\">疼痛节律</td>\n                <td>进食-疼痛-缓解</td>\n                <td>疼痛-进食-缓解</td>\n            </tr>\n        </table>\n\n        <!-- Section 16 -->\n        <div class=\"section-title\">16. 小儿腹泻脱水临床表现</div>\n        <div class=\"table-caption\">不同程度脱水的临床表现</div>\n        <table>\n            <tr>\n                <th class=\"bg-gray text-center\" style=\"width: 25%;\">脱水程度</th>\n                <th class=\"bg-gray text-center\" style=\"width: 25%;\">轻度</th>\n                <th class=\"bg-gray text-center\" style=\"width: 25%;\">中度</th>\n                <th class=\"bg-gray text-center\" style=\"width: 25%;\">重度</th>\n            </tr>\n            <tr>\n                <td class=\"bg-gray text-center\">体重减少</td>\n                <td>&lt;5%</td>\n                <td>5%~10%</td>\n                <td>&gt;10%</td>\n            </tr>\n            <tr>\n                <td class=\"bg-gray text-center\">皮肤、黏膜</td>\n                <td>弹性可、稍干燥</td>\n                <td>弹性差、干燥</td>\n                <td>弹性极差、极干燥</td>\n            </tr>\n            <tr>\n                <td class=\"bg-gray text-center\">眼窝、前囟</td>\n                <td>稍凹陷</td>\n                <td>明显凹陷</td>\n                <td>深度凹陷</td>\n            </tr>\n            <tr>\n                <td class=\"bg-gray text-center\">尿量</td>\n                <td>略少</td>\n                <td>明显减少</td>\n                <td>少尿/无尿</td>\n            </tr>\n            <tr>\n                <td class=\"bg-gray text-center\">末梢循环</td>\n                <td>正常</td>\n                <td>四肢稍凉</td>\n                <td>四肢厥冷</td>\n            </tr>\n            <tr>\n                <td class=\"bg-gray text-center\">精神状态</td>\n                <td>稍差</td>\n                <td>烦躁/萎靡</td>\n                <td>昏睡/昏迷</td>\n            </tr>\n        </table>\n        <div class=\"note\">注：轻度往往描述为稍或略，重度往往描述为极或无</div>\n    </div>\n</body>\n</html>"
