        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>江海证券投资日历</title>\n    <style>\n        body { \n            margin: 0; \n            padding: 20px; \n            background-color: #ebebeb; \n            display: flex; \n            justify-content: center; \n        }\n        .document-wrapper {\n            background-color: #fbb341;\n            padding: 15px 15px 0 15px;\n            width: 100%;\n            max-width: 800px;\n            box-sizing: border-box;\n            box-shadow: 0 4px 10px rgba(0,0,0,0.1);\n        }\n        .inner-content {\n            background-color: #fff;\n            background-image: \n                linear-gradient(rgba(0,0,0,0.04) 1px, transparent 1px),\n                linear-gradient(90deg, rgba(0,0,0,0.04) 1px, transparent 1px);\n            background-size: 15px 15px;\n            padding: 30px;\n            box-sizing: border-box;\n        }\n        header { \n            display: flex; \n            justify-content: space-between; \n            align-items: flex-start; \n            margin-bottom: 40px; \n        }\n        .logo { \n            display: flex; \n            align-items: center; \n            gap: 10px; \n        }\n        .logo-placeholder {\n            width: 35px;\n            height: 35px;\n            border-radius: 50%;\n            background-color: #002fa7;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            font-size: 10px;\n            text-align: center;\n            line-height: 1.1;\n        }\n        .logo-text { \n            display: flex; \n            flex-direction: column; \n        }\n        .logo-cn { \n            font-size: 22px; \n            font-weight: 900; \n            color: #000; \n            letter-spacing: 2px; \n            font-family: 'SimHei', 'Heiti SC', sans-serif;\n        }\n        .logo-en { \n            font-size: 9px; \n            color: #666; \n            font-family: Arial, sans-serif; \n            letter-spacing: 1px;\n        }\n        .badge-container { \n            position: relative; \n            margin-top: 5px; \n            margin-right: 15px;\n        }\n        .badge { \n            border: 2px solid #000; \n            border-radius: 6px; \n            padding: 6px 14px; \n            font-size: 18px; \n            font-weight: bold; \n            background: #fff;\n            font-family: 'SimHei', 'Heiti SC', sans-serif;\n            letter-spacing: 1px;\n        }\n        .badge-icon {\n            position: absolute;\n            top: -18px;\n            right: -22px;\n            width: 34px;\n            height: 34px;\n            background-color: #ffe600;\n            border: 2px solid #000;\n            border-radius: 6px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 10px;\n            font-weight: bold;\n            transform: rotate(15deg);\n            text-align: center;\n            line-height: 1.2;\n        }\n        \n        .timeline-section { \n            position: relative; \n            margin-bottom: 40px; \n        }\n        .bg-line { \n            position: absolute; \n            top: 25px; \n            left: 5%; \n            right: 5%; \n            height: 3px; \n            background-color: #d3d3d3; \n            z-index: 1; \n        }\n        .grid-container {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 20px;\n            position: relative;\n            z-index: 2;\n        }\n        .column { \n            display: flex; \n            flex-direction: column; \n            align-items: center; \n        }\n        \n        .triangle { \n            width: 0; \n            height: 0; \n            border-left: 15px solid transparent; \n            border-right: 15px solid transparent; \n            border-top: 25px solid; \n        }\n        .t-blue { border-top-color: #4a77bc; }\n        .t-green { border-top-color: #72ac58; }\n        .t-red { border-top-color: #c00000; }\n        .t-yellow { border-top-color: #ffc000; }\n        \n        .month-label { \n            margin-top: 15px; \n            margin-bottom: 20px; \n            font-size: 18px; \n            color: #333; \n            font-family: 'SimSun', 'Songti SC', serif; \n        }\n        \n        .card { \n            width: 100%; \n            display: flex; \n            flex-direction: column; \n            height: 100%; \n        }\n        .card-header { \n            padding: 12px 5px; \n            text-align: center; \n            color: #fff; \n            font-size: 18px; \n            font-weight: bold; \n            font-family: 'SimHei', 'Heiti SC', sans-serif;\n            letter-spacing: 1px;\n        }\n        .bg-blue { background-color: #4a77bc; }\n        .bg-green { background-color: #72ac58; }\n        .bg-red { background-color: #c00000; }\n        .bg-yellow { background-color: #ffc000; }\n        \n        .card-body { \n            background-color: #f7f7f7; \n            padding: 15px; \n            flex-grow: 1; \n            font-size: 14px; \n            line-height: 1.7; \n            color: #333; \n            font-family: 'SimSun', 'Songti SC', serif; \n            text-align: justify;\n        }\n        .text-red { \n            color: #c00000; \n        }\n        \n        footer {\n            display: flex;\n            justify-content: space-between;\n            padding: 12px 10px;\n            color: #fff;\n            font-size: 12px;\n            font-family: 'SimHei', 'Heiti SC', sans-serif;\n            opacity: 0.9;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"document-wrapper\">\n        <div class=\"inner-content\">\n      