box li {\n        margin-bottom: 3px;\n    }\n\n    /* Specific Box Layouts */\n    .box-transactional {\n        top: 125px;\n        left: 285px;\n        width: 225px;\n        border: 2px solid #b3d334;\n    }\n    .box-transactional .personal-header {\n        margin-top: 15px;\n    }\n\n    .box-fractured {\n        top: 115px;\n        left: 765px;\n        width: 245px;\n        border: 2px solid #3fa9f5;\n    }\n\n    .box-systemic {\n        top: 545px;\n        left: 455px;\n        width: 410px;\n        border: 2px solid #002b5e;\n    }\n    .box-systemic h3 {\n        text-align: center;\n        margin-bottom: 8px;\n    }\n\n    /* Central Diagram Placeholder & SVG */\n    .diagram-area {\n        position: absolute;\n        top: 135px;\n        left: 440px;\n        width: 380px;\n        height: 380px;\n    }\n    .diagram-svg {\n        position: absolute;\n        width: 100%;\n        height: 100%;\n        top: 0;\n        left: 0;\n    }\n    .tri-text {\n        position: absolute;\n        color: #ffffff;\n        font-size: 32px;\n        font-weight: bold;\n        z-index: 10;\n        letter-spacing: 0.5px;\n    }\n    .text-incentives {\n        transform: rotate(-62deg);\n        top: 160px;\n        left: 25px;\n    }\n    .text-rationalisation {\n        transform: rotate(62deg);\n        top: 160px;\n        left: 200px;\n    }\n    .text-opportunity {\n        bottom: 50px;\n        left: 110px;\n    }\n\n    /* Footer */\n    .footer {\n        position: absolute;\n        bottom: 20px;\n        left: 45px;\n        width: 934px;\n        display: flex;\n        justify-content: space-between;\n        align-items: flex-end;\n    }\n    .page-number {\n        font-size: 13px;\n        font-weight: bold;\n        color: #002b5e;\n    }\n    .copyright {\n        font-size: 11px;\n        color: #002b5e;\n    }\n</style>\n</head>\n<body>\n<div class=\"slide-container\">\n    <h1 class=\"title\">Fraud risk assessment</h1>\n    <h2 class=\"subtitle\">Why does financial crime occur?</h2>\n\n    <div class=\"intro-block\">\n        <div class=\"hr-line\"></div>\n        <div class=\"intro-text\">\n            At scale, financial<br>\n            crime WILL occur<br>\n            with statistical<br>\n            regularity if the<br>\n            right combination<br>\n            of elements are<br>\n            present.\n        </div>\n    </div>\n\n    <div class=\"box box-transactional\">\n        <h3>TRANSACTIONAL</h3>\n        <ul>\n            <li>Expectations to meet<br>(financial) targets</li>\n            <li>Hide failing projects or<br>contracts</li>\n            <li>Need for new financing</li>\n        </ul>\n        <h3 class=\"personal-header\">PERSONAL</h3>\n        <ul>\n            <li>Financial problems</li>\n            <li>Extravagant life style</li>\n            <li>Addictions (drug or<br>gambling habits)</li>\n            <li>Greed or revenge</li>\n            <li>Character flaws (i.e.<br>sociopathic disorder)</li>\n        </ul>\n    </div>\n\n    <div class=\"diagram-area placeholder\">\n        <svg class=\"diagram-svg\" viewBox=\"0 0 400 380\">\n            <!-- Left Green Triangle -->\n            <polygon points=\"200,10 15,315 195,210\" fill=\"#8cc63f\" />\n            <!-- Right Light Blue Triangle -->\n            <polygon points=\"210,10 205,210 385,315\" fill=\"#009cd9\" />\n            <!-- Bottom Dark Blue Triangle -->\n            <polygon points=\"10,325 200,220 390,325\" fill=\"#002b5e\" />\n        </svg>\n        <div class=\"tri-text text-incentives\">Incentives</div>\n        <div class=\"tri-text text-rationalisation\">Rationalisation</div>\n        <div class=\"tri-text text-opportunity\">Opportunity</div>\n    </div>\n\n    <div class=\"box box-fractured\">\n        <h3>FRACTURED LOGIC...</h3>\n        <ul>\n            <li>\"My performance isn't<br>recognized\"</li>\n            <li>\"Management doesn't care\"</li>\n            <li>\"Everyone else is does it\"</li>\n            <li>\"I'm only borrowing\"</li>\n            <li>\"It's the cost of doing<br>business\"</li>\n            <li>\"I have been mistreated and<br>deserve compensation\"</li>\n        </ul>\n    </div>\n\n    <div class=\"box box-systemic\">\n        <h3>SYSTEMIC WEAKNESSES</h3>\n        <ul>\n            <li>Lack of oversight</li>\n            <li>Conflict</li>\n            <li>Implementation of new accounting software</li>\n            <li>High volume transactions (easy hiding)</li>\n            <li>New & complex products</li>\n            <li>Grey areas in the rules</li>\n            <li>Ineffective internal controls</li>\n        </ul>\n    </div>\n\n    <div class=\"footer\">\n        <div class=\"page-number\">15</div>\n        <div class=\"copyright\">© 2014 Deloitte The Netherlands</div>\n    </div>\n</div>\n</body>\n</html>"
