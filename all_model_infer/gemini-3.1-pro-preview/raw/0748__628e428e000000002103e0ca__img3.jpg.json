        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Document</title>\n    <style>\n        body {\n            font-family: sans-serif;\n            margin: 0;\n            padding: 20px;\n            color: #333;\n        }\n\n        .header {\n            display: flex;\n            align-items: center;\n            border-top: 5px solid #ccc;\n            padding-top: 10px;\n            margin-bottom: 20px;\n        }\n\n        .logo {\n            font-size: 32px;\n            font-weight: 900;\n            color: #1a428a;\n            margin-right: 10px;\n            letter-spacing: -1px;\n        }\n\n        .logo-sub {\n            font-size: 32px;\n            font-weight: 900;\n            color: #8bb5e3;\n            letter-spacing: -1px;\n        }\n        \n        .sub-logo {\n            font-size: 10px;\n            color: #1a428a;\n            margin-right: 20px;\n            align-self: flex-end;\n            margin-bottom: 5px;\n        }\n\n        .url {\n            font-size: 8px;\n            color: #666;\n            align-self: flex-end;\n            margin-bottom: 5px;\n        }\n\n        .table-container {\n            width: 100%;\n            border-collapse: collapse;\n            margin-bottom: 20px;\n            border: 1px solid #7da6cf;\n        }\n\n        .table-container td {\n            padding: 15px;\n            vertical-align: top;\n            border: 1px solid #7da6cf;\n        }\n\n        .table-col-1 {\n            width: 60%;\n            font-family: serif;\n            color: #1f4e79;\n            font-size: 14px;\n            line-height: 2;\n            text-align: justify;\n        }\n\n        .table-col-2 {\n            width: 40%;\n            font-family: sans-serif;\n            color: #1f4e79;\n            font-size: 14px;\n            line-height: 2;\n            text-