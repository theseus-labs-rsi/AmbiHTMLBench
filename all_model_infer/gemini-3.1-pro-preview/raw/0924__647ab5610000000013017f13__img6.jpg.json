% 50%, calc(100% - 12px) 100%, 0 100%);\n            letter-spacing: 1px;\n            z-index: 2;\n        }\n\n        /* Main Title */\n        .main-title {\n            font-size: 34px;\n            font-weight: 900;\n            color: #222222;\n            letter-spacing: 1.5px;\n            margin-bottom: 28px;\n            display: flex;\n            align-items: baseline;\n            gap: 14px;\n        }\n\n        .main-title .num {\n            font-family: \"Impact\", \"Arial Black\", sans-serif;\n            font-weight: 900;\n            font-size: 36px;\n        }\n\n        /* Content Paragraphs */\n        .section-text {\n            font-size: 15px;\n            line-height: 1.7;\n            color: #222222;\n            margin-bottom: 22px;\n        }\n\n        .section-text p {\n            margin: 0;\n        }\n\n        /* Key Points List */\n        .list-container {\n            font-size: 15px;\n            line-height: 1.6;\n            color: #222222;\n            display: flex;\n            flex-direction: column;\n            gap: 6px;\n        }\n\n        .list-item-title {\n            font-weight: bold;\n            color: #1a1a1a;\n        }\n\n        .list-item-desc {\n            padding-left: 24px;\n            color: #333333;\n            margin-bottom: 4px;\n        }\n\n        /* Tear line effect */\n        .tear-divider {\n            position: relative;\n            height: 16px;\n            background-color: #fbf8f5;\n            display: flex;\n            align-items: center;\n        }\n\n        .tear-divider::before,\n        .tear-divider::after {\n            content: '';\n            position: absolute;\n            width: 14px;\n            height: 14px;\n            background-color: #dfc7b4;\n            border-radius: 50%;\n            top: 1px;\n            z-index: 3;\n        }\n\n        .tear-divider::before {\n            left: -7px;\n        }\n\n        .tear-divider::after {\n            right