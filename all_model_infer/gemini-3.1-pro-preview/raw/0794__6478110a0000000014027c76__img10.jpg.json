ap: break-word;\n            margin-top: 5px;\n        }\n        .placeholder {\n            position: absolute;\n            bottom: 20px;\n            right: 20px;\n            width: 90px;\n            height: 90px;\n            border: 2px dashed #ff9999;\n            background-color: rgba(255, 200, 200, 0.3);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 12px;\n            color: #cc0000;\n            text-align: center;\n            border-radius: 50%;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"page\">\n        <div class=\"header\">\n            <h1>高考语文答题技巧汇总</h1>\n        </div>\n        <div class=\"divider\"></div>\n        <div class=\"content\">\n            \n            <div class=\"section item-list\">\n                <div>分类别：条理清晰</div>\n                <div>下定义：科学准确</div>\n                <div>引用：更具体</div>\n            </div>\n\n            <div class=\"section item-list\">\n                <div class=\"teal-text indent-1\">议论文阅读</div>\n                <div class=\"teal-text indent-1\">论证方法</div>\n                <div>1举例论证：具体有力</div>\n                <div>2·道理论证：具有权威性</div>\n                <div>3·比喻论证：生动形象</div>\n                <div>4·对比论证：全面深刻</div>\n                <div class=\"teal-text indent-1\" style=\"margin-top: 10px;\">句子作用是：</div>\n                <div class=\"inline-list\">（1）总领全文【在开头】 （2）承上启下 （3）引出下文 （4）提纲挈领【在最后】</div>\n            </div>\n\n            <div class=\"section item-list\">\n                <div class=\"indent-1\"><span class=\"teal-text highlight\">小说</span></div>\n                <div class=\"teal-text indent-1\">小说三要素</div>\n                <div class=\"indent-1\"><span class=\"teal-text highlight\">（一）人物形象</span></div>\n                \n                <div style=\"margin-top: 10px;\"><span class=\"teal-text highlight\">1、人物描写角度</span></div>\n                <div>（1）、正面描写（直接）：外貌、语言、动作、心理、细节</div>\n                <div>（2）、侧面描写（间接）：借助他人对比、衬托;借助物象、环境衬托</div>\n                \n                <div style=\"margin-top: 10px;\"><span class=\"teal-text highlight\">2、人物描写作用</span></div>\n                <div>（1）、外貌动作：更好的展现人物的内心及性格特征；</div>\n                <div>（2）、语言：刻画人物性格，反应人物心理，促进故事情节发展。<br>\n                描摹人物语态，使形象刻画栩栩如生，跃然纸上。</div>\n                <div>（3）、心理：直接表现人物思想和内在情感（矛盾、焦虑、担心、喜悦、兴奋）表现人物思想品质，推动故事情节发展。</div>\n                <div>（4）、细节：刻画人物形象、深化主题、推动故事情节发展、渲染时代气氛，地方特色、渲染人物心情，心理活动。</div>\n                <div>（5）侧面：引发读者联想、想象、含蓄曲折地表现人物。</div>\n            </div>\n\n            <div class=\"placeholder\">[Cartoon Logo:<br>bottom-right]</div>\n        </div>\n    </div>\n</body>\n</html>"
