        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>English Grammar Notes</title>\n<style>\n  * {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n  }\n\n  body {\n    background-color: #f7f5ee;\n    font-family: \"Caveat\", \"Segoe Print\", \"STKaiti\", \"KaiTi\", \"Comic Sans MS\", -apple-system, BlinkMacSystemFont, \"PingFang SC\", cursive, sans-serif;\n    color: #1e1b4b;\n    display: flex;\n    justify-content: center;\n    padding: 20px 10px;\n  }\n\n  .notebook-page {\n    background-color: #faf8f2;\n    background-image: \n      linear-gradient(to right, rgba(210, 205, 190, 0.35) 1px, transparent 1px),\n      linear-gradient(to bottom, rgba(210, 205, 190, 0.35) 1px, transparent 1px);\n    background-size: 16px 16px;\n    width: 100%;\n    max-width: 860px;\n    min-height: 1100px;\n    padding: 16px 24px 30px 24px;\n    box-shadow: 0 4px 15px rgba(0,0,0,0.06);\n    position: relative;\n    border-radius: 4px;\n  }\n\n  /* Top Navigation Bar */\n  .top-nav {\n    display: flex;\n    justify-content: space-between;\n    font-size: 11px;\n    color: #8c887b;\n    margin-bottom: 6px;\n    font-family: sans-serif;\n  }\n\n  .top-nav-btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 2px;\n  }\n\n  /* Header Line */\n  .header-meta {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    border-top: 1px solid #dcd7c9;\n    border-bottom: 1px solid #dcd7c9;\n    padding: 4px 0;\n    margin-bottom: 16px;\n    font-size: 10px;\n    color: #9c978b;\n    font-family: sans-serif;\n  }\n\n  .meta-left {\n    display: flex;\n    gap: 60px;\n  }\n\n  .washi-tape-container {\n    position: relative;\n    top: -6px;\n  }\n\n  .washi-tape {\n    background-color: #d69c64;\n    color: #fff;\n    padding: 2px 14px;\n    font-size: 14px;\n    font-weight: bold;\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    transform: rotate(-1deg);\n    box-shadow: 1px 2px 4px rgba(0,0,0,0.12);\n    clip-path: polygon(5% 0%, 95% 0%, 100% 50%, 95% 100%, 5% 100%, 0% 50%);\n    letter-spacing: 2px;\n  }\n\n  .battery-icon {\n    width: 14px;\n    height: 9px;\n    border: 1.5px solid #2d6a4f;\n    background-color: #52b788;\n    border-radius: 1px;\n    position: relative;\n    display: inline-block;\n  }\n\n  .battery-icon::after {\n    content: '';\n    position: absolute;\n    right: -3.5px;\n    top: 1.5px;\n    width: 2px;\n    height: 3px;\n    background-color: #2d6a4f;\n    border-radius: 0 1px 1px 0;\n  }\n\n  /* Highlight Banner */\n  .highlight-title {\n    display: inline-block;\n    background-color: #c5c3f8;\n    color: #0f0c41;\n    font-weight: bold;\n    font-size: 16px;\n    padding: 2px 10px;\n    border-radius: 12px;\n    margin-bottom: 8px;\n    letter-spacing: 0.5px;\n  }\n\n  /* Section 3 Grid (4 columns) */\n  .section-top {\n    margin-bottom: 24px;\n  }\n\n  .grid-4-col {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    column-gap: 12px;\n    row-gap: 4px;\n    font-size: 13.5px;\n    line-height: 1.35;\n    font-weight: 500;\n  }\n\n  .col-group {\n    display: flex;\n    flex-direction: column;\n    gap: 1.5px;\n  }\n\n  .entry-block {\n    margin-bottom: 7px;\n  }\n\n  .en-text {\n    font-style: italic;\n    color: #1a164b;\n    word-break: break-word;\n  }\n\n  .zh-text {\n    color: #1a164b;\n    font-size: 13px;\n  }\n\n  /* Section Bottom Grid (3 columns) */\n  .section-bottom {\n    display: grid;\n    grid-template-columns: 1.15fr 1.25fr 1.1fr;\n    column-gap: 16px;\n    font-size: 13.5px;\n    line-height: 1.38;\n    position: relative;\n  }\n\n  .bottom-col {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .bottom-item {\n    color: #1a164b;\n    word-break: break-word;\n    margin-bottom: 1.5px;\n  }\n\n  .bottom-item .en-part {\n    font-style: italic;\n  }\n\n  .mt-title {\n    margin-top: 10px;\n  }\n\n  /* Decorative sparkle */\n  .sparkle {\n    position: absolute;\n    right: 18px;\n    top: 55px;\n    color: #8ecae6;\n    font-size: 20px;\n    opacity: 0.8;\n    user-select: none;\n  }\n\n  @media (max-width: 700px) {\n    .notebook-page {\n      padding: 12px 10px;\n    }\n    .grid-4-col {\n      grid-template-columns: repeat(2, 1fr);\n      row-gap: 16px;\n    }\n    .section-bottom {\n      grid-template-columns: 1fr;\n      row-gap: 16px;\n    }\n  }\n</style>\n</head>\n<body>\n\n<div class=\"notebook-page\">\n  <!-- Top Navigation -->\n  <div class=\"top-nav\">\n    <div class=\"top-nav-btn\">&lt; Content</div>\n    <div class=\"top-nav-btn\">Template &gt;</div>\n  </div>\n\n  <!-- Header Meta -->\n  <div class=\"header-meta\">\n    <div class=\"meta-left\">\n      <span>Keyword</span>\n      <span>Note</span>\n    </div>\n    <div class=\"washi-tape-container\">\n      <div class=\"washi-tape\">\n        <span class=\"battery-icon\"></span>\n        <span>充电</span>\n      </div>\n    </div>\n    <div>\n      <span>Date &nbsp;&nbsp;&nbsp;&nbsp;/ &nbsp;&nbsp;&nbsp;&nbsp;/</span>\n    </div>\n  </div>\n\n  <!-- Section 3: to do/doing 结构 -->\n  <div class=\"section-top\">\n    <div class=\"highlight-title\">三、to do/doing结构</div>\n    \n    <div class=\"grid-4-col\">\n      <!-- Column 1 -->\n      <div class=\"col-group\">\n        <div class=\"entry-block\">\n          <div class=\"en-text\">like to do sth</div>\n          <div class=\"en-text\">like doing sth.</div>\n          <div class=\"zh-text\">喜欢做某事</div>\n        </div>\n        <div class=\"entry-block\">\n          <div class=\"en-text\">love to do sth</div>\n          <div class=\"en-text\">love doing sth.</div>\n          <div class=\"zh-text\">喜欢做某事</div>\n        </div>\n        <div class=\"entry-block\">\n          <div class=\"en-text\">hate to do sth</div>\n          <div class=\"en-text\">hate doing sth.</div>\n          <div class=\"zh-text\">憎恨做某事</div>\n        </div>\n        <div class=\"entry-block\">\n          <div class=\"en-text\">try to do sth.</div>\n          <div class=\"zh-text\">设法要做某事</div>\n          <div class=\"zh-text\"><span class=\"en-text\">try doing sth.</span>做某事试试看有何效果</div>\n        </div>\n        <div class=\"entry-block\">\n          <div class=\"en-text\">forget to do sth.</div>\n          <div class=\"zh-text\">忘记要做某事</div>\n          <div class=\"en-text\">forget doing sth.</div>\n          <div class=\"zh-text\">忘记曾做过某事</div>\n        </div>\n      </div>\n\n      <!-- Column 2 -->\n      <div class=\"col-group\">\n        <div class=\"entry-block\">\n          <div class=\"en-text\">bother to do sth</div>\n          <div class=\"en-text\">bother doing sth.</div>\n          <div class=\"zh-text\">麻烦做某事</div>\n        </div>\n        <div class=\"entry-block\">\n          <div class=\"en-text\">intend to do sth</div>\n          <div class=\"en-text\">intend doing sth.</div>\n          <div class=\"zh-text\">想要做某事</div>\n        </div>\n        <div class=\"entry-block\">\n          <div class=\"en-text\">continue to do sth</div>\n          <div class=\"en-text\">continue doing sth.</div>\n          <div class=\"zh-text\">继续做某事</div>\n        </div>\n        <div class=\"entry-block\">\n          <div class=\"zh-text\"><span class=\"en-text\">go on to do sth.</span> 做完某事接着做另事</div>\n          <div class=\"zh-text\"><span class=\"en-text\">go on doing sth</span> 继续做一直在做的事</div>\n        </div>\n        <div class=\"entry-block\">\n          <div class=\"en-text\">mean to do sth.</div>\n          <div class=\"zh-text\">打算做某事</div>\n          <div class=\"en-text\">mean doing sth.</div>\n          <div class=\"zh-text\">意味着做某事</div>\n        </div>\n      </div>\n\n      <!-- Column 3 -->\n      <div class=\"col-group\">\n        <div class=\"entry-block\">\n          <div class=\"en-text\">start to do sth</div>\n          <div class=\"en-text\">start doing sth.</div>\n          <div class=\"zh-text\">开始做某事</div>\n        </div>\n        <div class=\"entry-block\">\n          <div class=\"en-text\">prefer to do sth</div>\n          <div class=\"en-text\">prefer doing sth.</div>\n          <div class=\"zh-text\">宁可做某事</div>\n        </div>\n        <div class=\"entry-block\">\n          <div class=\"en-text\">begin to do sth</div>\n          <div class=\"en-text\">begin doing sth.</div>\n          <div class=\"zh-text\">开始做某事</div>\n        </div>\n        <div class=\"entry-block\">\n          <div class=\"zh-text\"><span class=\"en-text\">remember to do sth.</span> 记住要做某事</div>\n          <div class=\"zh-text\"><span class=\"en-text\">remember doing sth.</span> 记住做过某事</div>\n        </div>\n        <div class=\"entry-block\">\n          <div class=\"en-text\">regret to do sth.</div>\n          <div class=\"zh-text\">后悔要做某事</div>\n          <div class=\"en-text\">regret doing sth.</div>\n          <div class=\"zh-text\">后悔曾做过某事</div>\n        </div>\n      </div>\n\n      <!-- Column 4 -->\n      <div class=\"col-group\">\n        <div class=\"entry-block\">\n          <div class=\"en-text\">attempt to do sth</div>\n          <div class=\"en-text\">attempt doing sth</div>\n          <div class=\"zh-text\">试图做某事</div>\n        </div>\n        <div class=\"entry-block\">\n          <div class=\"en-text\">cease to do sth</div>\n          <div class=\"en-text\">cease doing sth.</div>\n          <div class=\"zh-text\">停止做某事</div>\n        </div>\n        <div class=\"entry-block\">\n          <div class=\"en-text\">can't bear to do sth /can't bear doing sth.</div>\n          <div class=\"zh-text\">不能忍受做某事</div>\n        </div>\n        <div class=\"entry-block\">\n          <div class=\"zh-text\"><span class=\"en-text\">can't help doing sth.</span> 禁不住做某事</div>\n          <div class=\"zh-text\"><span class=\"en-text\">can't help to do sth.</span> 不能帮助做某事</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Bottom Sections: 动词 + 介词 -->\n  <div class=\"section-bottom\">\n    <div class=\"sparkle\">✦</div>\n\n    <!-- Bottom Column 1: 动词+with -->\n    <div class=\"bottom-col\">\n      <div><span class=\"highlight-title\">四、动词+with</span></div>\n      <div class=\"bottom-item\"><span class=\"en-part\">deal with</span>处理;对付</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">meet with</span>遇到;遭受</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">end with</span>以...结束</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">compare with</span>与...相比</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">equip with</span>以...装备</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">cover with</span>用...覆盖</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">agree with</span> 与...一致</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">provide with</span>以...供给</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">begin with</span>以...开始</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">supply with</span>以...供给</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">play with</span> 玩弄</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">do with</span>处理;需要</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">talk with</span> 同...交流</div>\n    </div>\n\n    <!-- Bottom Column 2: 动词+from & 动词+through -->\n    <div class=\"bottom-col\">\n      <div><span class=\"highlight-title\">五、动词+from</span></div>\n      <div class=\"bottom-item\"><span class=\"en-part\">hear from</span>收到...的来信</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">keep...from</span> 阻止;制止</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">suffer from</span>受...苦</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">learn from</span>向...学习</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">die from</span>因...而死</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">separate...from</span>把...分离</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">differ from</span> 与...不同</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">date from</span>始于...时候</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">stop...from</span> 阻止;制止</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">prevent...from</span> 阻止;制止</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">result from</span>由于</div>\n      <div class=\"mt-title\"><span class=\"highlight-title\">六、动词+through</span></div>\n      <div class=\"bottom-item\"><span class=\"en-part\">get through</span>接通电话</div>\n    </div>\n\n    <!-- Bottom Column 3: through entries cont., 动词+back & 动词+away -->\n    <div class=\"bottom-col\">\n      <div class=\"bottom-item\"><span class=\"en-part\">look through</span>翻阅;看一遍</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">put through</span>接通电话</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">check through</span>核对</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">go through</span>检查学习</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">see through</span>识破</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">pull through</span>渡过危机</div>\n      <div class=\"mt-title\"><span class=\"highlight-title\">七、动词+back</span></div>\n      <div class=\"bottom-item\"><span class=\"en-part\">keep back</span>隐瞒;忍住</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">look back</span> 回顾</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">give back</span>归还</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">take back</span>拿回，收回</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">hold back</span>控制住</div>\n      <div class=\"bottom-item\"><span class=\"en-part\">call back</span> 回电话</div>\n      <div class=\"mt-title\"><span class=\"highlight-title\">八、动词+away</span></div>\n    </div>\n  </di