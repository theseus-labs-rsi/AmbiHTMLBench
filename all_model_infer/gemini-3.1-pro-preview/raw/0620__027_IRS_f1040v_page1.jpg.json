        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>2025 Form 1040-V</title>\n    <style>\n        body {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 11.5px;\n            line-height: 1.25;\n            margin: 0;\n            padding: 20px;\n            background-color: #fff;\n            color: #000;\n        }\n        .page-container {\n            max-width: 850px;\n            margin: 0 auto;\n        }\n        \n        /* Top Header */\n        .top-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: flex-end;\n            border-bottom: 3px solid black;\n            padding-bottom: 5px;\n            margin-bottom: 15px;\n        }\n        .header-left {\n            display: flex;\n            align-items: baseline;\n        }\n        .year-outline {\n            font-size: 64px;\n            font-weight: bold;\n            -webkit-text-stroke: 1.5px black;\n            color: white;\n            letter-spacing: 1px;\n            line-height: 0.75;\n        }\n        .form-title {\n            font-size: 42px;\n            font-weight: bold;\n            margin-left: 15px;\n            line-height: 0.85;\n        }\n        .header-right {\n            display: flex;\n            align-items: center;\n        }\n        .irs-logo-placeholder {\n            width: 45px;\n            height: 45px;\n            border: 1px solid black;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 9px;\n            margin-right: 10px;\n            text-align: center;\n        }\n        .dept-text {\n            font-size: 16px;\n            line-height: 1.1;\n        }\n        \n        /* Columns */\n        .content-columns {\n            display: flex;\n            gap