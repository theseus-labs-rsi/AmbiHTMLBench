        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Matplotlib Documentation - Images, contours and fields</title>\n<style>\n    :root {\n        --primary-color: #11557c;\n        --text-color: #333;\n        --text-light: #555;\n        --border-color: #e5e7eb;\n        --bg-color: #ffffff;\n        --bg-hover: #f3f4f6;\n        --sidebar-width: 280px;\n    }\n\n    body {\n        font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n        margin: 0;\n        padding: 0;\n        color: var(--text-color);\n        background-color: var(--bg-color);\n        line-height: 1.5;\n    }\n\n    a {\n        text-decoration: none;\n        color: inherit;\n    }\n\n    /* Navbar */\n    .navbar {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        padding: 0 24px;\n        height: 60px;\n        border-bottom: 1px solid var(--border-color);\n        position: sticky;\n        top: 0;\n        background-color: var(--bg-color);\n        z-index: 100;\n    }\n\n    .nav-brand {\n        display: flex;\n        align-items: center;\n        font-size: 22px;\n        font-weight: 600;\n        color: var(--primary-color);\n        letter-spacing: -0.5px;\n    }\n\n    .logo-icon {\n        width: 20px;\n        height: 20px;\n        border-radius: 50%;\n        border: 2px solid var(--primary-color);\n        position: relative;\n        margin-right: 8px;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n    }\n\n    .logo-icon::before {\n        content: '';\n        position: absolute;\n        width: 100%;\n        height: 1px;\n        background-color: var(--primary-color);\n    }\n\n    .logo-icon::after {\n        content: '';\n        position: absolute;\n        height: 100%;\n        width: 1px;\n        background-color: var(--primary-color);\n    }\n\n    .logo-inner-circle {\n        width: 10px;\n        height: 10px;\n        border-radius: 50%;\n        border: 1px solid var(--primary-color);\n        position: absolute;\n    }\n\n    .nav-links {\n        display: flex;\n        gap: 20px;\n        font-size: 14px;\n    }\n\n    .nav-links a:hover {\n        color: var(--primary-color);\n    }\n\n    .nav-controls {\n        display: flex;\n        align-items: center;\n        gap: 16px;\n    }\n\n    .nav-icon {\n        font-size: 16px;\n        color: var(--text-light);\n        cursor: pointer;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n    }\n\n    .version-selector {\n        padding: 4px 8px;\n        border: 1px solid var(--border-color);\n        border-radius: 4px;\n        background-color: #f9fafb;\n        font-size: 13px;\n        color: var(--text-color);\n    }\n\n    /* Layout */\n    .layout {\n        display: flex;\n        min-height: calc(100vh - 60px);\n    }\n\n    /* Sidebar */\n    .sidebar {\n        width: var(--sidebar-width);\n        flex-shrink: 0;\n        border-right: 1px solid var(--border-color);\n        padding: 24px 0;\n        overflow-y: auto;\n        height: calc(100vh - 60px);\n        position: sticky;\n        top: 60px;\n    }\n\n    .sidebar-title {\n        font-size: 16px;\n        font-weight: 600;\n        padding: 0 24px;\n        margin-bottom: 16px;\n    }\n\n    .sidebar-nav {\n        list-style: none;\n        padding: 0;\n        margin: 0;\n    }\n\n    .sidebar-item {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        padding: 8px 24px;\n        font-size: 14px;\n        color: var(--text-light);\n        cursor: pointer;\n    }\n\n    .sidebar-item:hover {\n        background-color: var(--bg-hover);\n    }\n\n    .sidebar-item.active {\n        color: var(--primary-color);\n        font-weight: 600;