      padding: 16px 22px;\n            border-radius: 8px;\n            font-size: 14px;\n            line-height: 1.7;\n            flex: 1;\n            text-align: justify;\n        }\n        .long-text-red {\n            background-color: #fadbd8;\n            color: #78281f;\n        }\n        .long-text-orange {\n            background-color: #fdebd0;\n            color: #7e5109;\n        }\n        \n        /* SVG Path Colors */\n        .path-red { stroke: #e74c3c; }\n        .path-orange { stroke: #f39c12; }\n        .path-yellow { stroke: #f1c40f; }\n        .path-green { stroke: #2ecc71; }\n        .path-blue { stroke: #3498db; }\n\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <div class=\"header\">\n            <h1>精酿、原浆、鲜啤、生啤、<br>扎啤、干啤、冰啤的区别</h1>\n        </div>\n        \n        <div class=\"main-card\">\n            \n            <!-- Section 1: 啤酒原浆 -->\n            <div class=\"section\">\n                <div class=\"root-col\">\n                    <div class=\"root-node\">啤酒原浆</div>\n                </div>\n                <div class=\"svg-col\">\n                    <svg viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\" style=\"width: 100%; height: 100%; position: absolute; top: 0; left: 0; overflow: visible;\">\n                        <path d=\"M 0 50 C 40 50, 60 10, 100 10\" fill=\"none\" class=\"path-red\" stroke-width=\"2\" vector-effect=\"non-scaling-stroke\"/>\n                        <path d=\"M 0 50 C 40 50, 60 30, 100 30\" fill=\"none\" class=\"path-orange\" stroke-width=\"2\" vector-effect=\"non-scaling-stroke\"/>\n                        <path d=\"M 0 50 L 100 50\" fill=\"none\" class=\"path-yellow\" stroke-width=\"2\" vector-effect=\"non-scaling-stroke\"/>\n                        <path d=\"M 0 50 C 40 50, 60 70, 100 70\" fill=\"none\" class=\"path-green\" stroke-width=\"2\" vector-effect=\"non-scaling-stroke\"/>\n                        <path d=\"M 0 50 C 40 50, 60 90, 100 90\" fill=\"none\" class=\"path-blue\" stroke-width=\"2\" vector-effect=\"non-scaling-stroke\"/>\n                    </svg>\n                </div>\n                <div class=\"branches-col\">\n                    <div class=\"branch-row\">\n                        <div class=\"process-tag bg-red\">不杀菌+不滤清</div>\n                        <div class=\"connector-line\"></div>\n                        <div class=\"result-tag text-light-red\">原浆啤酒</div>\n                    </div>\n                    <div class=\"branch-row\">\n                        <div class=\"process-tag bg-orange\">不杀菌+滤清</div>\n                        <div class=\"connector-line\"></div>\n                        <div class=\"result-tag text-light-orange\">鲜啤</div>\n                    </div>\n                    <div class=\"branch-row\">\n                        <div class=\"process-tag bg-yellow\">不杀菌+滤清+膜过滤除菌(非高温)</div>\n                        <div class=\"connector-line\"></div>\n                        <div class=\"result-tag text-light-yellow\">生啤</div>\n                    </div>\n                    <div class=\"branch-row\">\n                        <div class=\"process-tag bg-green\">桶装鲜啤+二氧化碳+冰镇</div>\n                        <div class=\"connector-line\"></div>\n                        <div class=\"result-tag text-light-green\">扎啤</div>\n                    </div>\n                    <div class=\"branch-row\">\n                        <div class=\"process-tag bg-blue\">滤清+巴氏杀菌或瞬时高温杀菌</div>\n                        <div class=\"connector-line\"></div>\n                        <div class=\"result-tag text-light-blue\">熟啤</div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Section 2: 啤酒 -->\n            <div class=\"section\">\n                <div class=\"root-col\">\n                    <div class=\"root-node\">啤酒</div>\n                </div>\n                <div class=\"svg-col\">\n                    <svg viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\" style=\"width: 100%; height: 100%; position: absolute; top: 0; left: 0; overflow: visible;\">\n                        <path d=\"M 0 50 C 40 50, 60 25, 100 25\" fill=\"none\" class=\"path-red\" stroke-width=\"2\" vector-effect=\"non-scaling-stroke\"/>\n                        <path d=\"M 0 50 C 40 50, 60 75, 100 75\" fill=\"none\" class=\"path-orange\" stroke-width=\"2\" vector-effect=\"non-scaling-stroke\"/>\n                    </svg>\n                </div>\n                <div class=\"branches-col\" style=\"justify-content: space-around;\">\n                    <div class=\"branch-row\">\n                        <div class=\"process-tag bg-red\">精酿啤酒</div>\n                        <div class=\"connector-line\"></div>\n                        <div class=\"result-tag text-light-red\">追求独特的口味</div>\n                    </div>\n                    <div class=\"branch-row\">\n                        <div class=\"process-tag bg-orange\">工业啤酒</div>\n                        <div class=\"connector-line\"></div>\n                        <div class=\"result-tag text-light-orange\">追求工业标准化</div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Section 3: 按工艺区分 -->\n            <div class=\"section\">\n                <div class=\"root-col\">\n                    <div class=\"root-node\">按工艺区分</div>\n                </div>\n                <div class=\"svg-col\">\n                    <svg viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\" style=\"width: 100%; height: 100%; position: absolute; top: 0; left: 0; overflow: visible;\">\n                        <path d=\"M 0 50 C 40 50, 60 25, 100 25\" fill=\"none\" class=\"path-red\" stroke-width=\"2\" vector-effect=\"non-scaling-stroke\"/>\n                        <path d=\"M 0 50 C 40 50, 60 75, 100 75\" fill=\"none\" class=\"path-orange\" stroke-width=\"2\" vector-effect=\"non-scaling-stroke\"/>\n                    </svg>\n                </div>\n                <div class=\"branches-col\" style=\"justify-content: space-around;\">\n                    <div class=\"branch-row\">\n                        <div class=\"process-tag bg-red\" style=\"min-width: 60px;\">冰啤</div>\n                        <div class=\"connector-line\"></div>\n                        <div class=\"long-text-box long-text-red\">\n                            先把啤酒的温度降到冰点，使啤酒因低温而产生冷浑浊，然后再进行过滤使啤酒变清，和普通啤酒最大的不同之处在于降温的冰晶化处理，使酒色更亮丽，口感更清爽醇厚，酒精度数也有一定提高。\n                        </div>\n                    </div>\n                    <div class=\"branch-row\">\n                        <div class=\"process-tag bg-orange\" style=\"min-width: 60px;\">干啤</div>\n                        <div class=\"connector-line\"></div>\n                        <div class=\"long-text-box long-text-orange\">\n                            干啤采用了特殊的酵母进行发酵酿制，使啤酒中所含的糖分完全转化为酒精，比普通啤酒要低，让干啤喝起来的口感干爽而不甜，清爽而无余味。\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</body>\n</html>"
