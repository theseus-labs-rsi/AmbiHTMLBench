        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>啤酒的区别</title>\n    <style>\n        body {\n            margin: 0;\n            padding: 30px 20px;\n            background: linear-gradient(135deg, #e6f0fa 0%, #e8e2f8 100%);\n            font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;\n            display: flex;\n            justify-content: center;\n            color: #333;\n        }\n        .container {\n            width: 100%;\n            max-width: 850px;\n        }\n        .header {\n            background-color: rgba(255, 255, 255, 0.95);\n            border-radius: 15px;\n            padding: 25px 30px;\n            text-align: center;\n            margin-bottom: 25px;\n            box-shadow: 0 4px 15px rgba(0,0,0,0.03);\n        }\n        .header h1 {\n            margin: 0;\n            color: #2c3e50;\n            font-size: 34px;\n            line-height: 1.5;\n            letter-spacing: 2px;\n            font-weight: 800;\n        }\n        .main-card {\n            background-color: #ffffff;\n            border-radius: 20px;\n            padding: 40px 30px;\n            box-shadow: 0 8px 25px rgba(0,0,0,0.04);\n        }\n        .section {\n            display: flex;\n            align-items: stretch;\n            margin-bottom: 50px;\n        }\n        .section:last-child {\n            margin-bottom: 0;\n        }\n        .root-col {\n            display: flex;\n            align-items: center;\n            width: 150px;\n            z-index: 2;\n        }\n        .root-node {\n            background-color: #0a0b10;\n            color: #fff;\n            font-size: 22px;\n            font-weight: bold;\n            padding: 18px 20px;\n            border-radius: 6px;\n            text-align: center;\n            width: 100%;\n            letter-spacing: 1px;\n            /* Subtle shadow to