margin-bottom: 20px;\n        }\n        .large-image-container .caption {\n            text-align: right;\n            font-family: \"Microsoft YaHei\", \"PingFang SC\", sans-serif;\n            font-size: 13px;\n            margin-top: 8px;\n            line-height: 1.5;\n        }\n\n        .lower-split {\n            display: flex;\n            justify-content: space-between;\n            gap: 20px;\n        }\n        .left-column {\n            width: 35%;\n            display: flex;\n            flex-direction: column;\n            gap: 40px;\n            padding-top: 10px;\n        }\n        .side-image-item {\n            display: flex;\n            align-items: center;\n            justify-content: flex-end;\n        }\n        .side-image-item .caption {\n            font-family: \"Microsoft YaHei\", \"PingFang SC\", sans-serif;\n            font-size: 13px;\n            text-align: right;\n            margin-right: 15px;\n            line-height: 1.5;\n            width: 110px;\n        }\n\n        .center-column {\n            width: 62%;\n            font-size: 15px;\n            line-height: 1.9;\n            text-align: justify;\n        }\n        .center-column p {\n            margin: 0 0 12px 0;\n            text-indent: 2em;\n        }\n        .author-info {\n            text-align: right;\n            font-family: \"Microsoft YaHei\", \"PingFang SC\", sans-serif;\n            font-size: 14px;\n            font-weight: bold;\n            margin-top: 30px;\n            margin-bottom: 30px;\n        }\n        .qr-section {\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .qr-text {\n            font-family: \"Microsoft YaHei\", \"PingFang SC\", sans-serif;\n            font-size: 13px;\n            margin-left: 15px;\n            line-height: 1.5;\n        }\n\n        /* Right Area Details */\n        .right-image-item {\n            display: flex;\n            flex-direction: column;\n        }\n        .right-image-item .caption {\n            font-family: \"Microsoft YaHei\", \"PingFang SC\", sans-serif;\n            font-size: 13px;\n            text-align: center;\n            margin-top: 8px;\n            line-height: 1.5;\n        }\n\n        /* Footer */\n        .footer-line {\n            border-top: 1px solid #666;\n            margin-top: 40px;\n            margin-bottom: 10px;\n        }\n        footer {\n            font-family: \"Microsoft YaHei\", \"PingFang SC\", sans-serif;\n            font-size: 11px;\n            text-align: center;\n            line-height: 1.5;\n            color: #333;\n        }\n\n        /* Placeholder Styling */\n        .placeholder {\n            background-color: #f0f0f0;\n            border: 1px solid #ccc;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: #888;\n            font-size: 14px;\n            overflow: hidden;\n            box-sizing: border-box;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <div class=\"header-left\">\n                <span class=\"page-num\">4</span>\n                <span class=\"section-title\">求是苑·剪影</span>\n            </div>\n            <div class=\"header-center\">\n                <div>2018年9月14日 星期五</div>\n                <div>责任编辑：张岚 联系电话：0571-88981339</div>\n            </div>\n            <div class=\"header-right\">\n                <span class=\"paper-title\">浙江大学报</span>\n                <span class=\"paper-subtitle\">ZHE JIANG DA XUE BAO</span>\n            </div>\n        </header>\n\n        <div class=\"top-images\">\n            <div class=\"top-image-item\">\n                <div class=\"caption\">汗水流过坚毅的脸庞<br>陈佳轩 摄</div>\n                <div class=\"placeholder\" style=\"width: 100%; height: 140px;\">[Photo: Soldier face]</div>\n            </div>\n            <div class=\"top-image-item\">\n                <div class=\"caption\">挥旗<br>施良辰 摄</div>\n                <div class=\"placeholder\" style=\"width: 100%; height: 140px;\">[Photo: Soldier with red flag]</div>\n            </div>\n            <div class=\"top-image-item\">\n                <div class=\"caption\">别担心，我不累<br>梁汉卿 摄</div>\n                <div class=\"placeholder\" style=\"width: 100%; height: 140px;\">[Photo: Soldier helping another]</div>\n            </div>\n            <div class=\"top-image-item\">\n                <div class=\"caption\">关怀<br>何念泽 摄</div>\n                <div class=\"placeholder\" style=\"width: 100%; height: 140px;\">[Photo: Soldiers marching]</div>\n            </div>\n        </div>\n\n        <div class=\"main-title\">\n            <h1>在军训中磨砺青春</h1>\n            <h2>——浙江大学2018年学生军训掠影</h2>\n        </div>\n\n        <div class=\"content-layout\">\n            <div class=\"left-center-area\">\n                <div class=\"large-image-container\">\n                    <div class=\"placeholder\" style=\"width: 100%; height: 450px;\">[Photo: Soldiers lined up in corridor]</div>\n                    <div class=\"caption\">在校园的每个角落练习着<br>军姿<br>陈佳轩 摄</div>\n                </div>\n                \n                <div class=\"lower-split\">\n                    <div class=\"left-column\">\n                        <div class=\"side-image-item\">\n                            <div class=\"caption\">用一场合唱<br>比赛铭记这些闪<br>亮的日子<br>胡琪宣 摄</div>\n                            <div class=\"placeholder\" style=\"width: 160px; height: 110px;\">[Photo: Choir singing]</div>\n                        </div>\n                        <div class=\"side-image-item\">\n                            <div class=\"caption\">用一份入党<br>申请书见证理想<br>与信念<br>胡琪宣 摄</div>\n                            <div class=\"placeholder\" style=\"width: 160px; height: 110px;\">[Photo: Soldier writing]</div>\n                        </div>\n                        <div class=\"side-image-item\">\n                            <div class=\"caption\">用一场拔河<br>比赛演绎青春的<br>力量<br>陈佳轩 摄</div>\n                            <div class=\"placeholder\" style=\"width: 160px; height: 110px;\">[Photo: Tug-of-war]</div>\n                        </div>\n                    </div>\n                    \n                    <div class=\"center-column\">\n                        <p>紫金港，你五点钟的晨曦真美。</p>\n                        <p>见过早晨五点钟的校园吗？柔亮的光里忽地划出几声嘹亮的口号，然后映出大团的绿，不同于大自然肆意的绿色，那是一种属于军人的——规矩的绿！军装整齐，步伐一致、口号嘹亮，浙大的新人们迎来了他们军训的一天。</p>\n                        <p>谁言书生只善文，军训场上显神威！既怀得鲲鹏之志，岂能无钢铁之躯？壮志凌云，跃跃欲试；意气风发，摩拳擦掌。能文善武，成大国之器；握笔挥刀，铸全能之材！</p>\n                        <p>紫金港，你日光下汗浸衣襟的战士们真帅。</p>\n                        <p>“向左转！向右转！”“齐步走！”一遍两遍，百遍千遍。不骄不惧，不悔不怕。浙大人不怕苦，浙大人要磨炼钢铁意志！心中有理想，脚下有力量。目光坚定，我们向往成为钢铁一般的战士，故我们忍耐，我们奋发，至刚至坚，长空亮剑，气贯云天！</p>\n                        <p>烈日炎炎，熔不了心中激情；汗水涔涔，带不走崇高信念。青春年华，用汗水诠释；前路漫漫，用血泪征服！</p>\n                        <p>宣父犹能畏后生，丈夫未可轻年少！不屈——不屈——！</p>\n                        <p>紫金港，你夕阳里的蹁跹路真好看。</p>\n                        <p>屈原道：“路漫漫其修远兮，吾将上下而求索。”竺老校长二问犹然在耳，唯有向前，全力以赴，才可不负重托。前人栽树，竺老同众多浙大的学长学姐一起，为我们守护着这方生机盎然的土地。战火中的西迁故事，林俊德院士的事迹……既传达了力量，更是我们的榜样！传承的重任在肩，要传承的是一代代浙大人艰苦创业的精神，要传承的是一代代浙大人求是创新的灵魂！</p>\n                        <p>紫金港，你路灯下的湖水轻轻泛起涟漪，你黑暗中的荷枝柔柔地扭动腰肢，你月牙楼边传来的歌声微微回响。</p>\n                        <p>这一天末了，战士们都进入梦乡。</p>\n                        <p>紫金港，你今天真好看。我想，明天的你一定更加美丽！</p>\n                        \n                        <div class=\"author-info\">本版文字 包蓉 杨萝萝</div>\n                        \n                        <div class=\"qr-section\">\n                            <div class=\"placeholder\" style=\"width: 80px; height: 80px;\">[QR Code]</div>\n                            <div class=\"qr-text\">用手机QQ<br>扫二维码<br>加入浙江大学<br>QQ智慧校园</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"right-area\">\n                <div class=\"right-image-item\">\n                    <div class=\"placeholder\" style=\"width: 100%; height: 220px;\">[Photo: Soldier running]</div>\n                    <div class=\"caption\">在定向越野中奋力奔跑<br>陈佳轩 摄</div>\n                </div>\n                <div class=\"right-image-item\">\n                    <div class=\"placeholder\" style=\"width: 100%; height: 420px;\">[Photo: Soldiers casting shadows]</div>\n                    <div class=\"caption\">一排男生站成一列，用<br>自己的影子给姑娘挡住烈日</div>\n                </div>\n                <div class=\"right-image-item\">\n                    <div class=\"placeholder\" style=\"width: 100%; height: 260px;\">[Photo: Large formation on field]</div>\n                    <div class=\"caption\">迷彩的颜色是今夏紫金<br>港最靓丽的风景线<br>陈佳轩 摄</div>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"footer-line\"></div>\n        <footer>\n            本报通讯地址：浙江大学紫金港校区东三105 《浙江大学报》编辑部 邮编：310058 电子信箱：zdxb@zju.edu.cn 电话：0571-88981339 88273707 总编：应 飚 副总编：章旻 电子编辑：李岑 承印：新华通讯社浙江分社印刷厂\n        </footer>\n    </div>\n</body>\n</html>"
