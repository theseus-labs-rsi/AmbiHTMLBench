        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Clinical Trial Results</title>\n<style>\n  body {\n    font-family: sans-serif;\n    margin: 0;\n    padding: 0;\n    background-color: #f4f4f4;\n  }\n  .slide {\n    background-color: white;\n    width: 960px;\n    margin: 20px auto;\n    box-shadow: 0 0 10px rgba(0,0,0,0.1);\n    position: relative;\n    padding-bottom: 20px;\n  }\n  .header {\n    background-color: #3b5998;\n    color: white;\n    padding: 10px 40px;\n    display: flex;\n    align-items: center;\n    position: relative;\n  }\n  .header-item {\n    font-size: 20px;\n    margin-right: 40px;\n  }\n  .header-item.active {\n    font-weight: bold;\n    position: relative;\n  }\n  .header-item.active::after {\n    content: '';\n    position: absolute;\n    bottom: -20px;\n    left: 50%;\n    transform: translateX(-50%);\n    border-width: 10px;\n    border-style: solid;\n    border-color: #3b5998 transparent transparent transparent;\n  }\n  .content {\n    padding: 40px;\n  }\n  .red-text {\n    color: #e60000;\n    font-weight: bold;\n  }\n  ul {\n    list-style-type: disc;\n    margin-bottom: 20px;\n  }\n  li {\n    margin-bottom: 10px;\n    line-height: 1.5;\n  }\n  .footer {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    color: #999;\n    font-size: 14px;\n    margin-top: 40px;\n  }\n  .footer-item {\n    margin: 0 20px;\n    padding-bottom: 5px;\n  }\n  .footer-item.active {\n    color: black;\n    font-weight: bold;\n    border-bottom: 2px solid black;\n  }\n  .page-number {\n    position: absolute;\n    right: 20px;\n    bottom: 20px;\n    color: #999;\n    font-size: 12px;\n  }\n  \n  /* Slide 2 specific styles */\n  .slide2 .header-item:first-child {\n    font-weight: normal;\n  }\n  .slide2 .header-item:first-child::after {\n    display: none;\n  }\n  .slide2 .header-item:nth-child(2) {\n    font-weight: bold;\n  }\n  .slide2 .header-item:nth-child(2)::after {\n    content: '';\n    position: absolute;\n    bottom: -20px;\n    left: 50%;\n    transform: translateX(-50%);\n    border-width: 10px;\n    border-style: solid;\n    border-color: #3b5998 transparent transparent transparent;\n  }\n  .slide2-content {\n    display: flex;\n    justify-content: space-between;\n  }\n  table {\n    border-collapse: collapse;\n    width: 65%;\n    font-size: 12px;\n    margin-right: 20px;\n  }\n  th, td {\n    border: 1px solid #ccc;\n    padding: 5px;\n    text-align: center;\n  }\n  th {\n    font-weight: bold;\n  }\n  .table-header-row {\n    border-top: 2px solid #666;\n    border-bottom: 2px solid #666;\n  }\n  .table-section-header {\n    text-align: left;\n    font-weight: bold;\n    padding-left: 10px;\n    background-color: #f9f9f9;\n  }\n  .stats-column {\n    width: 30%;\n  }\n  .stats-column h3 {\n    margin-top: 0;\n    margin-bottom: 10px;\n    font-size: 18px;\n  }\n  .stats-list {\n    list-style-type: none;\n    padding-left: 20px;\n    margin-bottom: 20px;\n  }\n  .stats-list li {\n    margin-bottom: 5px;\n    font-size: 16px;\n  }\n  .citation {\n    text-align: right;\n    font-size: 12px;\n    font-weight: bold;\n    margin-top: 20px;\n    margin-right: 20px;\n  }\n</style>\n</head>\n<body>\n\n<div class=\"slide\">\n  <div class=\"header\">\n    <div class=\"header-item active\">Safety</div>\n    <div class=\"header-item\">Therapeutic effect</div>\n  </div>\n  <div class=\"content\">\n    <ul>\n      <li class=\"red-text\" style=\"font-size: 20px;\">In this clinical trial:</li>\n      <ul style=\"list-style-type: lower-alpha; margin-left: 20px; font-size: 18px;\">\n        <li>Treatment-related events of grade ≥3 severity were noted for<br><b>only 2 patients in the vaccinated group, with 1 case each of<br>hypokalemia and rash.</b></li>\n        <li>1 patient in the vaccinated group discontinued treatment for<br>grade 2 gastritis.</li>\n        <li>No treatment-related serious adverse events were observed.</li>\n      </ul>\n    </ul>\n  </div>\n  <div class=\"footer\">\n    <div class=\"footer-item\">Background</div>\n    <div class=\"footer-item\">Study Design</div>\n    <div class=\"footer-item active\">Result</div>\n    <div class=\"footer-item\">Conclusion</div>\n  </div>\n  <div class=\"page-number\">13</div>\n</div>\n\n<div class=\"slide slide2\">\n  <div class=\"header\">\n    <div class=\"header-item\">Safety</div>\n    <div class=\"header-item active\">Therapeutic effect</div>\n  </div>\n  <div class=\"content slide2-content\">\n    <table>\n      <tr class=\"table-header-row\">\n        <th colspan=\"3\" class=\"table-section-header\">Melanoma</th>\n        <th style=\"color:red; font-size:10px;\">客观缓解率</th>\n        <th style=\"font-size:10px;\">(中位)<br>无进展生存期</th>\n        <th style=\"font-size:10px;\">1年总生存率</th>\n      </tr>\n      <tr class=\"table-header-row\">\n        <th></th>\n        <th>N</th>\n        <th>Follow<br>Up*</th>\n        <th>Prior<br>Therapy</th>\n        <th>ORR (months)</th>\n        <th>Median<br>PFS (months)</th>\n        <th>12-Month<br>OS</th>\n      </tr>\n      <tr>\n        <td style=\"text-align:left;\">ITT Set (NT-001)</td>\n        <td>34</td>\n        <td>20</td>\n        <td>41%</td>\n        <td>47%<br>(30%, 65%)</td>\n        <td>15.1<br>(4.3, NE)</td>\n        <td>85%<br>(68%, 94%)</td>\n      </tr>\n      <tr>\n        <td style=\"text-align:left;\">Vaccinated Set (NT-001)</td>\n        <td>27</td>\n        <td>20</td>\n        <td>30%</td>\n        <td>59%<br>(39%, 78%)</td>\n        <td>23.5<br>(6.6, NE)</td>\n        <td>96%<br>(76%, 99%)</td>\n      </tr>\n      <tr class=\"table-header-row\">\n        <th colspan=\"7\" class=\"table-section-header\">Non-Small Cell Lung Cancer</th>\n      </tr>\n      <tr class=\"table-header-row\">\n        <th></th>\n        <th>N</th>\n        <th>Follow<br>Up (months)</th>\n        <th>Prior<br>Therapy</th>\n        <th>ORR</th>\n        <th>Median<br>PFS (months)</th>\n        <th>12-Month<br>OS</th>\n      </tr>\n      <tr>\n        <td style=\"text-align:left;\">ITT Set (NT-001)</td>\n        <td>27</td>\n        <td>15</td>\n        <td>67%</td>\n        <td>26%<br>(11%, 46%)</td>\n        <td>4.4<br>(2.0, 8.5)</td>\n        <td>59%<br>(39%, 75%)</td>\n      </tr>\n      <tr>\n        <td style=\"text-align:left;\">Vaccinated Set (NT-001)</td>\n        <td>18</td>\n        <td>15</td>\n        <td>61%</td>\n        <td>39%<br>(17%, 64%)</td>\n        <td>8.5<br>(3.9, NE)</td>\n        <td>83%<br>(57%, 94%)</td>\n      </tr>\n      <tr class=\"table-header-row\">\n        <th colspan=\"7\" class=\"table-section-header\">Transitional Cell Carcinoma of the Bladder</th>\n      </tr>\n      <tr class=\"table-header-row\">\n        <th></th>\n        <th>N</th>\n        <th>Follow<br>Up (months)</th>\n        <th>Prior<br>Therapy</th>\n        <th>ORR</th>\n        <th>Median<br>PFS (months)</th>\n        <th>12-Month<br>OS</th>\n      </tr>\n      <tr>\n        <td style=\"text-align:left;\">ITT Set (NT-001)</td>\n        <td>21</td>\n        <td>18</td>\n        <td>67%</td>\n        <td>19%<br>(5%, 42%)</td>\n        <td>5.6<br>(2.0, 12.0)</td>\n        <td>60%<br>(36%, 78%)</td>\n      </tr>\n      <tr style=\"border-bottom: 2px solid #666;\">\n        <td style=\"text-align:left;\">Vaccinated Set (NT-001)</td>\n        <td>15</td>\n        <td>18</td>\n        <td>61%</td>\n        <td>27%<br>(8%, 55%)</td>\n        <td>5.8<br>(2.8, 12.7)</td>\n        <td>67%<br>(38%, 85%)</td>\n      </tr>\n    </table>\n    \n    <div class=\"stats-column\">\n      <h3>a. Melanoma</h3>\n      <ul class=\"stats-list\">\n        <li>ORR: 47%<span style=\"color:#d9d9d9;\">→</span><span style=\"color:red;\">59%</span></li>\n        <li>PFS: 15.1<span style=\"color:#d9d9d9;\">→</span>23.5</li>\n        <li>OS: 85%<span style=\"color:#d9d9d9;\">→</span>96%</li>\n      </ul>\n      \n     