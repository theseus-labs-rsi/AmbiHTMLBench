        "content": "<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>商业长图 设计分享</title>\n    <style>\n        body {\n            margin: 0;\n            padding: 20px;\n            background-color: #333;\n            font-family: \"Microsoft YaHei\", \"PingFang SC\", sans-serif;\n            display: flex;\n            justify-content: center;\n        }\n        .container {\n            width: 800px;\n            background-color: #000;\n            box-sizing: border-box;\n            border: 5px solid #000;\n        }\n        .header {\n            background-color: #000;\n            color: #fff;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            padding: 15px 20px;\n        }\n        .header-title {\n            font-size: 24px;\n            font-weight: bold;\n            letter-spacing: 2px;\n        }\n        .header-center {\n            display: flex;\n            align-items: center;\n            flex-grow: 1;\n            margin: 0 30px;\n        }\n        .line-arrow {\n            flex-grow: 1;\n            border-top: 1px solid #fff;\n            position: relative;\n        }\n        .line-arrow-left::before {\n            content: \"←\";\n            position: absolute;\n            left: -5px;\n            top: -11px;\n            font-size: 16px;\n        }\n        .line-arrow-right::after {\n            content: \"→\";\n            position: absolute;\n            right: -5px;\n            top: -11px;\n            font-size: 16px;\n        }\n        .design-badge {\n            border: 1px solid #fff;\n            border-radius: 20px;\n            padding: 2px 20px;\n            margin: 0 10px;\n            font-size: 18px;\n        }\n        .main-content {\n            display: flex;\n            gap: 5px;\n            background-color: #000;\n        }\n        .col-left {\n            flex: 1;\n            background-color: #C3FF2B;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            flex-direction: column;\n        }\n        .col-right {\n            flex: 1;\n            display: flex;\n            flex-direction: column;\n            box-sizing: border-box;\n        }\n        .col-right-top {\n            background-color: #7A37FF;\n            height: 320px;\n            padding: 20px;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            border-bottom: 5px solid #000;\n        }\n        .col-right-bottom {\n            background-color: #C3FF2B;\n            flex-grow: 1;\n            padding: 20px;\n            display: flex;\n            flex-direction: column;\n        }\n        .placeholder {\n            background: rgba(200, 200, 200, 0.4);\n            border: 2px dashed #666;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            text-align: center;\n            color: #333;\n            font-weight: bold;\n            font-size: 14px;\n            box-sizing: border-box;\n        }\n        .text-lines div {\n            border-bottom: 1px solid #000;\n            margin-bottom: 2px;\n            height: 28px;\n            line-height: 28px;\n        }\n        .checkered {\n            background-image: linear-gradient(45deg, #000 25%, transparent 25%, transparent 75%, #000 75%, #000), \n                              linear-gradient(45deg, #000 25%, transparent 25%, transparent 75%, #000 75%, #000);\n            background-size: 10px 10px;\n            background-position: 0 0, 5px 5px;\n            height: 10px;\n            width: 100%;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header class=\"header\">\n            <div class=\"header-title\">商业长图</div>\n            <div class=\"header-center\">\n                <div class=\"line-arrow line-arrow-left\"></div>\n                <div class=\"design-badge\">DESIGN</div>\n                <div class=\"line-arrow line-arrow-right\"></div>\n            </div>\n            <div class=\"header-title\">设计分享</div>\n        </header>\n\n        <div class=\"main-content\">\n            <!-- Left Column -->\n            <div class=\"col-left\">\n                <div class=\"text-lines\" style=\"font-size: 16px; margin-bottom: 30px;\">\n                    <div style=\"text-align: center; padding-right: 20%;\">两大征稿专栏</div>\n                    <div style=\"padding-left: 10%;\">将在本期</div>\n                    <div style=\"text-align: center; padding-left: 10%;\">与大家做个正式的告别</div>\n                </div>\n\n                <div style=\"display: flex; flex-direction: column; align-items: center; margin-bottom: 15px; position: relative;\">\n                    <div style=\"background: #fff; border: 2px solid #000; padding: 5px 15px; font-size: 22px; font-weight: 900; position: relative; z-index: 2; margin-bottom: 15px;\">江湖从不缺传奇</div>\n                    \n                    <div class=\"placeholder\" style=\"position: absolute; top: 15px; left: 0; width: 70px; height: 60px; border-radius: 20px; background: #6B52FF; border: 2px solid #000; color: #fff;\">[Blue Glove]</div>\n                    <div class=\"placeholder\" style=\"position: absolute; top: 5px; right: 0; width: 70px; height: 60px; border-radius: 20px; background: #FF0055; border: 2px solid #000; color: #fff;\">[Red Glove]</div>\n                    \n                    <div style=\"background: #fff; border: 2px solid #000; padding: 3px 15px; font-size: 18px; font-weight: 900; margin-bottom: 15px; position: relative; z-index: 2;\">这一次</div>\n                    <div style=\"background: #fff; border: 2px solid #000; padding: 5px 10px; font-size: 22px; font-weight: 900; position: relative; z-index: 2;\">TA燃情出炉，战力拉满</div>\n                </div>\n\n                <div class=\"placeholder\" style=\"width: 100%; height: 260px; margin-bottom: 20px;\">\n                    [Graphic: 3D \"PK\" Text, Boxing Ring, Banners \"天都擂台专栏今日上线\"]\n                </div>\n\n                <div style=\"background: #fff; border: 2px solid #000; display: flex; margin-bottom: 30px;\">\n                    <div style=\"width: 30px; border-right: 2px solid #000; display: flex; flex-direction: column; align-items: center; justify-content: space-around; padding: 5px 0;\">\n                        <div style=\"font-weight: bold; font-size: 16px;\">↘</div>\n                        <div style=\"font-weight: bold; font-size: 14px;\">曲</div>\n                        <div style=\"font-size: 16px;\">☺</div>\n                        <div style=\"font-weight: bold; font-size: 16px;\">↗</div>\n                    </div>\n                    <div style=\"padding: 15px 10px; text-align: center; flex-grow: 1;\">\n                        <div style=\"font-weight: 900; font-size: 16px; margin-bottom: 10px;\">正反两派 互相PK</div>\n                        <div style=\"font-size: 13px; margin-bottom: 8px; font-weight: bold;\">征稿玩法大升级，狂掀对垒浪潮</div>\n                        <div style=\"font-size: 12px; margin-bottom: 8px; font-weight: bold;\">注意！ 注意！ 注意！</div>\n                        <div style=\"background: #000; color: #fff; display: inline-block; padding: 4px 6px; font-size: 12px; font-weight: bold;\">入选参赛的投稿者都将收获礼品一份</div>\n                    </div>\n                </div>\n\n                <div class=\"text-lines\" style=\"font-size: 15px;\">\n                    <div style=\"text-align: center; width: 40%; margin: 0 auto;\">但！</div>\n                    <div style=\"position: relative;\">\n                        <span style=\"position: absolute; left: 0; bottom: 4px; border: 2px solid #6B5AE1; color: #6B5AE1; font-weight: bold; font-size: 14px; padding: 0 5px; transform: rotate(-2deg); background: #C3FF2B; line-height: normal;\">胜者一方</span>\n      