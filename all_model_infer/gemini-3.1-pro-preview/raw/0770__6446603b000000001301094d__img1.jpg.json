solute;\n    left: -10px;\n    top: -15px;\n    font-size: 24px;\n    color: #f39c12;\n    -webkit-text-stroke: 0;\n    text-shadow: none;\n  }\n  .logo-placeholder {\n    width: 160px;\n    height: 45px;\n    background-color: #f9f9f9;\n    border: 1px dashed #ccc;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    color: #999;\n    font-size: 12px;\n  }\n  .info-row {\n    margin: 6px 0;\n    font-size: 14px;\n    line-height: 1.6;\n    color: #222;\n  }\n  .label {\n    color: #c0392b;\n    font-weight: bold;\n  }\n</style>\n</head>\n<body>\n\n<div class=\"poster\">\n  <div class=\"header\">\n    <div class=\"placeholder decor-hearts\">[Hearts Icon]</div>\n    <h1 class=\"title\">传媒公司春招倒计时</h1>\n  </div>\n  \n  <div class=\"content\">\n    <!-- Card 1 -->\n    <div class=\"card\">\n      <div class=\"card-header\">\n        <div class=\"badge\">壹心娱乐</div>\n        <div class=\"logo-placeholder placeholder\">[Logo: easyent 壹心]</div>\n      </div>\n      <div class=\"info-row\">\n        <span class=\"label\">推荐理由：</span>是一家提供定制化服务的经纪公司，业务范围涉及艺人影视剧拍摄、广告代言、形象包装、演出、法律咨询等多项经纪业务。旗下艺人有白宇、卜冠今、李现、马思纯等。\n      </div>\n      <div class=\"info-row\">\n        <span class=\"label\">网申时间：</span>4月11日起-招满即止\n      </div>\n      <div class=\"info-row\">\n        <span class=\"label\">招聘岗位：</span>宣传主管、执行经纪、影视经纪、平面设计、段视频编导等\n      </div>\n      <div class=\"info-row\">\n        <span class=\"label\">工作地点：</span>北京\n      </div>\n    </div>\n\n    <!-- Card 2 -->\n    <div class=\"card\">\n      <div class=\"card-header\">\n        <div class=\"badge\">光线传媒</div>\n        <div class=\"logo-placeholder placeholder\">[Logo: 光线传媒]</div>\n      </div>\n      <div class=\"info-row\">\n        <span class=\"label\">推荐理由：</span>中国最大的民营传媒娱乐集团。主营业务包括电视节目制作与发行，电影投资、制作、宣发，电视剧投资、发行，艺人经纪等，发行作品有《西游记之大圣归来》等动画电影，旗下艺人有任敏、孙千、胡先煦等。\n      </div>\n      <div class=\"info-row\">\n        <span class=\"label\">网申时间：</span>3月26日起-招满即止\n      </div>\n      <div class=\"info-r