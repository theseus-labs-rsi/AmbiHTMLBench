 display: flex;\n        align-items: center;\n    }\n    .col-2 {\n        display: grid;\n        grid-template-columns: 1fr 1fr;\n        gap: 15px;\n        margin-bottom: 12px;\n        align-items: center;\n    }\n    .flex-between {\n        display: flex;\n        justify-content: space-between;\n        margin-bottom: 12px;\n        align-items: center;\n    }\n\n    /* Specific Colors based on image */\n    .card-file { border-color: #548fa8; background-color: #f0fcff; }\n    .card-file .card-title { border-color: #548fa8; background-color: #d7f4fc; }\n\n    .card-text { border-color: #ba9256; background-color: #fefaf0; }\n    .card-text .card-title { border-color: #ba9256; background-color: #fbeac6; }\n\n    .card-nav { border-color: #cc8585; background-color: #fff5f5; }\n    .card-nav .card-title { border-color: #cc8585; background-color: #fcd7d7; }\n\n    .card-edit { border-color: #b06a6a; background-color: #fff2f2; }\n    .card-edit .card-title { border-color: #b06a6a; background-color: #f7d7d7; }\n\n    .card-para { border-color: #7ea87c; background-color: #f2fcf1; }\n    .card-para .card-title { border-color: #7ea87c; background-color: #dcf5da; }\n\n    /* Placeholders for non-text elements */\n    .placeholder {\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        border: 2px dashed #888;\n        color: #666;\n        font-size: 0.85rem;\n        background-color: rgba(255,255,255,0.6);\n        border-radius: 12px;\n        text-align: center;\n        padding: 5px;\n        font-weight: normal;\n    }\n</style>\n</head>\n<body>\n\n<div class=\"header-container\">\n    <div class=\"placeholder\" style=\"position: absolute; top: 0; left: 10%; width: 70px; height: 70px;\">\n        [Diagram: Bear Face]\n    </div>\n    <div class=\"placeholder\" style=\"position: absolute; top: -10px; right: 10%; width: 80px; height: 60px;\">\n        [Diagram: Bird & Envelope]\n    </div>\n    <span class=\"word-title\">Word</span>\n    <span class=\"main-title\">常用快捷键大全</span>\n</div>\n\n<div class=\"container\">\n    <!-- Left Column -->\n    <div class=\"col\">\n        <!-- 1. 文件与基本 -->\n        <div class=\"card card-file\">\n            <div class=\"card-title\">文件与基本</div>\n            <div class=\"col-2\">\n                <div>Ctrl+N 新建</div>\n                <div>Ctrl+S 保存</div>\n            </div>\n            <div class=\"col-2\">\n                <div>Ctrl+O 打开</div>\n                <div>Ctrl+P 打印</div>\n            </div>\n            <div class=\"placeholder\" style=\"width: 140px; height: 90px; margin: 15px auto 0 auto;\">\n                [Diagram: Bear typing on keyboard]\n            </div>\n        </div>\n\n        <!-- 2. 文本与排版 -->\n        <div class=\"card card-text\">\n            <div class=\"card-title\">文本与排版</div>\n            <div class=\"placeholder\" style=\"position: absolute; top: -15px; left: -20px; width: 40px; height: 40px; transform: rotate(-20deg);\">\n                [Diagram: Paintbrush]\n            </div>\n            <div class=\"row\">Ctrl+K 超链接 🔗</div>\n            <div class=\"col-2\">\n                <div>Ctrl+E 居中 ≡</div>\n                <div>Ctrl+D 格式 ▤</div>\n            </div>\n            <div class=\"row\">Ctrl+1 单倍行距 [1.0]</div>\n            <div class=\"row\">Ctrl+2 双倍行距 [2.0]</div>\n            <div class=\"row\">Alt+Shift+Up 上移段落 ↑</div>\n            <div class=\"row\">Alt+Shift+Down 下移段落 ↓</div>\n            <div class=\"col-2\" style=\"margin-bottom: 0;\">\n                <div>Ctrl+L 左对齐 ≡</div>\n                <div>Ctrl+R 右对齐 ≡</div>\n            </div>\n        </div>\n\n        <!-- 3. 导航与查找 -->\n        <div class=\"card card-nav\">\n            <div class=\"card-title\">导航与查找</div>\n            <div class=\"placeholder\" style=\"position: absolute; top: -15px; left: 10px; width: 40px; height: 30px;\">\n                [Diagram: Bird]\n            </div>\n            <div class=\"col-2\">\n                <div>Ctrl+F 查找 🔍</div>\n                <div>Ctrl+H 替换 🔄</div>\n            </div>\n            <div class=\"row\">Ctrl+G 定位 🔍</div>\n            <div class=\"row\">Ctrl+Home 光标移至文首 🏠</div>\n            <div class=\"row\">Ctrl+End 光标移至文尾 ➡️</div>\n            <div class=\"row\" style=\"margin-bottom: 0;\">Ctrl+Alt+A QQ截图 📝</div>\n        </div>\n    </div>\n\n    <!-- Right Column -->\n    <div class=\"col\">\n        <!-- 4. 编辑与格式 -->\n        <div class=\"card card-edit\">\n            <div class=\"card-title\">编辑与格式</div>\n            <div class=\"col-2\">\n                <div>Ctrl+C 复制 📋</div>\n                <div>Ctrl+Z 撤销</div>\n            </div>\n            <div class=\"col-2\">\n                <div>Ctrl+Y 恢复 ✂️</div>\n                <div>Ctrl+V 粘贴</div>\n            </div>\n            <div class=\"col-2\">\n                <div>Ctrl+X 剪切 🖌️</div>\n                <div>Ctrl+U 下划线</div>\n            </div>\n            <div class=\"col-2\">\n                <div>Ctrl+A 全选 ⭐</div>\n                <div>增大字号 ↗</div>\n            </div>\n            <div class=\"col-2\">\n                <div>Ctrl+B 加粗 𝑰</div>\n                <div>减小字号 ↘</div>\n            </div>\n            <div class=\"flex-between\">\n                <div>Ctrl+Shift+F</div>\n                <div>删除文本格式</div>\n            </div>\n            <div class=\"flex-between\">\n                <div>Ctrl+Shift+N</div>\n                <div>更改格式 🧹</div>\n            </div>\n            <div class=\"flex-between\">\n                <div>Delete 🗑️</div>\n                <div>删除选中</div>\n            </div>\n            <div class=\"flex-between\" style=\"margin-bottom: 0;\">\n                <div>Backspace ⌫</div>\n                <div>删除表格</div>\n            </div>\n        </div>\n\n        <!-- 5. 段落与高级 -->\n        <div class=\"card card-para\">\n            <div class=\"card-title\">段落与高级</div>\n            <div class=\"placeholder\" style=\"position: absolute; top: -15px; left: -10px; width: 50px; height: 35px;\">\n                [Diagram: Envelope]\n            </div>\n            <div class=\"flex-between\">\n                <div>Ctrl+L 左对齐</div>\n                <div>Shift+Enter</div>\n            </div>\n            <div class=\"flex-between\">\n                <div>Ctrl+R 右对齐</div>\n                <div>换行</div>\n            </div>\n            <div class=\"flex-between\">\n                <div>Ctrl+K</div>\n                <div>隐藏功能区</div>\n            </div>\n            <div class=\"flex-between\">\n                <div>Win+R</div>\n                <div>运行</div>\n            </div>\n            <div class=\"flex-between\">\n                <div>Win+Tab</div>\n                <div>3D桌面</div>\n            </div>\n            <div class=\"flex-between\">\n                <div>Alt+Shift+Up</div>\n                <div>上移段落</div>\n            </div>\n            <div class=\"flex-between\">\n                <div>Alt+Shift+Down</div>\n                <div>下移段落</div>\n            </div>\n            <div class=\"flex-between\">\n                <div>Shift+Delete</div>\n                <div>永久删除</div>\n            </div>\n            <div class=\"flex-between\">\n                <div>Ctrl+Alt+M 📝</div>\n                <div>新建批注</div>\n            </div>\n            <div class=\"flex-between\">\n                <div>Ctrl+Alt+O 📄</div>\n                <div>大纲视图</div>\n            </div>\n            <div class=\"flex-between\">\n                <div>Ctrl+Alt+P 📄</div>\n                <div>页面视图</div>\n            </div>\n            <div class=\"flex-between\">\n                <div>Ctrl+F2 🖨️</div>\n                <div>打印</div>\n            </div>\n            <div class=\"flex-between\" style=\"margin-bottom: 0;\">\n                <div>Ctrl+Enter</div>\n                <div>分页</div>\n            </div>\n            \n            <div class=\"placeholder\" style=\"position: absolute; bottom: -20px; right: -25px; width: 90px; height: 130px; border-color: #7