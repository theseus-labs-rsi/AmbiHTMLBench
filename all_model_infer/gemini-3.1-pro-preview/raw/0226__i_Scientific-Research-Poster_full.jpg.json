ght: 160px; \n            border-radius: 50%; \n            margin: 0 auto 20px auto; \n        }\n        .legend { \n            display: flex; \n            flex-direction: column; \n            gap: 12px; \n            width: 85%; \n            margin: 0 auto; \n        }\n        .legend-item { \n            display: flex; \n            align-items: center; \n            font-size: 0.85em; \n            color: #555; \n        }\n        .legend-color { \n            width: 14px; \n            height: 14px; \n            margin-right: 12px; \n            flex-shrink: 0; \n        }\n        .c1 { background: #6bc4f4; }\n        .c2 { background: #3b82f6; }\n        .c3 { background: #dbeafe; }\n        .legend-label { \n            flex: 1; \n            text-align: left; \n        }\n        .legend-val { \n            margin-left: 10px; \n        }\n        \n        .col-image { \n            width: 100%; \n            height: 280px; \n            margin-top: 20px; \n        }\n        .placeholder { \n            background: #f0f0f0; \n            border: 2px dashed #bbb; \n            display: flex; \n            align-items: center; \n            justify-content: center; \n            color: #777; \n            font-style: italic; \n        }\n        \n        .footer { \n            text-align: center; \n            padding: 30px 50px; \n            border-top: 4px solid #5eb2e8; \n            margin: 0 50px 30px 50px; \n            color: #444; \n            line-height: 1.6; \n            font-size: 0.95em; \n        }\n    </style>\n</head>\n<body>\n    <div class=\"poster\">\n        <div class=\"banner\">\n            <div class=\"banner-text\">\n                <h1>Uncontrolled type 1 diabetes among Egyptian<br><span class=\"highlight\">adolescents; risk determinants and clinical outcomes</span></h1>\n                <div class=\"authors\">Safinaz Adel Elhabashya, Eman M Mounir Sherifa, Nouran Yousef Salaha,<br>Mostafa Ahmed Elsayed Abd Elkaderb, Dina Ahmed Hosney Youssefa</div>\n                <div class=\"affiliation\">Pediatrics Department, Faculty of Medicine, Ain Shams University, Cairo, Egypt</div>\n            </div>\n            <div class=\"placeholder banner-image\">[Photo: Hands shaping a heart with a stethoscope]</div>\n        </div>\n        \n        <div class=\"content\">\n            <div class=\"column\">\n                <h2>Introduction</h2>\n                <p>Adolescents are exposed to multiple developmental, cognitive and emotional challenges, including independence and autonomy acquisition, identity and self esteem development, and social bond creation.</p>\n                \n                <h2>Aim</h2>\n                <p>To assess the risk determinants and clinical outcomes of uncontrolled diabetes among Egyptian adolescents with T1D.</p>\n                \n                <h2>Methodology</h2>\n                <div class=\"method-list\">\n                    <div class=\"method-item\">\n                        <div class=\"method-number\">1</div>\n                        <div class=\"method-text\">Six hundred adolescents with T1D were recruited from the Pediatric and Adolescents Diabetology Clinic, Ain-Shams University.</div>\n                    </div>\n                    <div class=\"method-item\">\n                        <div class=\"method-number\">2</div>\n                        <div class=\"method-text\">From the studied cohort, 200 with good glycemic control (≤7%) and 200 with poor control (>7%) were assessed for diabetes-duration, insulin regimen, frequency of diabetic-ketoacidosis, clinically significant hypoglycemia and the Mini-International Neuropsychiatric-Interview for Children and Adolescents.</div>\n                    </div>\n                    <div class=\"method-item\">\n                        <div class=\"method-number\">3</div>\n                        <div class=\"method-text\">Auxological assessment, fundus and clinical screening for complications were done.</div>\n                    </div>\n                    <div class=\"method-item\">\n                        <div class=\"method-number\">4</div>\n                        <div class=\"method-text\">Neuropathy was confirmed by nerve conduction velocity.</div>\n                    </div>\n                    <div class=\"method-item\">\n                        <div class=\"method-number\">5</div>\n                        <div class=\"method-text\">Thyroid profile, anti-tissue transglutaminase-IgG, fasting lipids and urinary albumin/excretion ratio (UAE) were measured.</div>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"column\">\n                <h2>Results</h2>\n                <p>Adolescents having uncontrolled diabetes have significantly higher diabetes onset age (p = 0.037), diabetes-duration (p = 0.038), eating disorders (p = 0.027), sadness (p = 0.038), depression (p = 0.003), suicidal manifestations (p = 0.001) and anxiety (p&lt;0.001) than the well-controlled group.</p>\n                \n                <table>\n                    <thead>\n                        <tr>\n                            <th>Variables</th>\n                            <th>Adolescents with<br>T1D (n = 400)</th>\n                            <th>Well controlled<br>Adolescents with<br>T1D (n = 200)</th>\n                            <th>Well controlled<br>Adolescents with<br>T1D (n = 200)</th>\n                        </tr>\n                        <tr>\n                            <th>Empty Cell</th>\n                            <th>r</th>\n                            <th>p-value</th>\n                            <th>r</th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        <tr>\n                            <td>Age (years)</td>\n                            <td>-0.054</td>\n                            <td>0.282</td>\n                            <td>0.000</td>\n                        </tr>\n                        <tr>\n                            <td>Age at diabetes<br>onset (y)</td>\n                            <td>0.122*</td>\n                            <td>0.014</td>\n                            <td>-0.011</td>\n                        </tr>\n                        <tr>\n                            <td>Diabetes<br>duration (y)</td>\n                            <td>0.103*</td>\n                            <td>0.039</td>\n                            <td>0.098</td>\n                        </tr>\n                        <tr>\n                            <td>Insulin dosage<br>(U/kg/day)</td>\n                            <td>-0.051</td>\n                            <td>0.312</td>\n                            <td>0.082</td>\n                        </tr>\n                        <tr>\n                            <td>Parent social<br>standard</td>\n                            <td>-0.021</td>\n                            <td>0.671</td>\n                            <td>-0.121</td>\n                        </tr>\n                        <tr>\n                            <td>Weight z-score</td>\n                            <td>-0.043</td>\n                            <td>0.391</td>\n                            <td>-0.025</td>\n                        </tr>\n                        <tr>\n                            <td>Height z-score</td>\n                            <td>-0.081</td>\n                            <td>0.106</td>\n                            <td>0.065</td>\n                        </tr>\n                        <tr>\n                            <td>BMI z-score</td>\n                            <td>0.040</td>\n                            <td>0.425</td>\n                            <td>-0.067</td>\n                        </tr>\n                    </tbody>\n                </table>\n                \n                <div class=\"placeholder col-image\">[Photo: Doctor examining a patient or writing notes]</div>\n            </div>\n            \n            <div class=\"column\">\n                <div class=\"chart-section\">\n                    <div class=\"chart-title\">Generalized anxiety</div>\n                    <div class=\"placeholder chart-placeholder\">[Donut Chart]</div>\n                    <div class=\"legend\">\n                        <div class=\"legend-item\">\n                            <div class=\"legend-color c1\"></div>\n                            <div class=\"legend-label\">Adolescents with T1D</div>\n                            <div class=\"legend-val\">20%</div>\n                        </div>\n                        <div class=\"legend-item\">\n                            <div class=\"legend-color c2\"></div>\n                            <div class=\"legend-label\">Well controlled Adolescents</div>\n                            <div class=\"legend-val\">20%</div>\n                        </div>\n                        <div class=\"legend-item\">\n                            <div class=\"legend-color c3\"></div>\n                            <div class=\"legend-label\">Poorly controlled Adolescents</div>\n                            <div class=\"legend-val\">60%</div>\n                        </div>\n                    </div>\n                </div>\n                \n                <div class=\"chart-section\">\n                    <div class=\"chart-title\">Frequency of DKA /yeared anxiety</div>\n                    <div class=\"placeholder chart-placeholder\">[Donut Chart]</div>\n                    <div class=\"legend\">\n                        <div class=\"legend-item\">\n                            <div class=\"legend-color c1\"></div>\n                            <div class=\"legend-label\">Adolescents with T1D</div>\n                            <div class=\"legend-val\">20%</div>\n                        </div>\n                        <div class=\"legend-item\">\n                            <div class=\"legend-color c2\"></div>\n                            <div class=\"legend-label\">Well controlled Adolescents</div>\n                            <div class=\"legend-val\">20%</div>\n                        </div>\n                        <div class=\"legend-item\">\n                            <div class=\"legend-color c3\"></div>\n                            <div class=\"legend-label\">Poorly controlled Adolescents</div>\n                            <div class=\"legend-val\">60%</div>\n                        </div>\n                    </div>\n                </div>\n                \n                <h2>Conclusion</h2>\n                <p>Uncontrolled T1D among adolescents is associated with older age and psychiatric comorbidities. Furthermore, it is linked to school absenteeism, hyperlipidemia, diabetic nephropathy and neuropathy.</p>\n                \n                <div class=\"placeholder col-image\" style=\"height: 180px;\">[Photo: Hand holding a syringe]</div>\n            </div>\n        </div>\n        \n        <div class=\"footer\">\n            Elhabashy, S.A., Sherif, E.M.M., Salah, N.Y., Abd Elkader, M.A.E. and Youssef, D.A.H., 2022. Uncontrolled type 1 diabetes among Egyptian<br>adolescents; risk determinants and clinical outcomes. Diabetes Epidemiology and Management, 6, p.100051.\n        </div>\n    </div>\n</body>\n</html>"
