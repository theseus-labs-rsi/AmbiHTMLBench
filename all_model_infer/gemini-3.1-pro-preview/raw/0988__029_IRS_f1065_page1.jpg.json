        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Form 1065 (2025)</title>\n<style>\n  body {\n    font-family: Arial, sans-serif;\n    font-size: 10px;\n    margin: 0;\n    padding: 20px;\n    line-height: 1.2;\n  }\n  .form-container {\n    width: 100%;\n    max-width: 800px;\n    margin: 0 auto;\n    border: 1px solid #000;\n    padding: 10px;\n    box-sizing: border-box;\n  }\n  \n  /* Header Section */\n  .header {\n    display: flex;\n    border-bottom: 2px solid #000;\n    margin-bottom: 5px;\n  }\n  .header-left {\n    flex: 0 0 20%;\n    padding-right: 10px;\n  }\n  .header-center {\n    flex: 1;\n    text-align: center;\n    border-left: 1px solid #000;\n    border-right: 1px solid #000;\n    padding: 0 10px;\n  }\n  .header-right {\n    flex: 0 0 15%;\n    padding-left: 10px;\n    text-align: center;\n  }\n  \n  .form-number {\n    font-size: 24px;\n    font-weight: bold;\n  }\n  .form-title {\n    font-size: 18px;\n    font-weight: bold;\n    margin-top: 5px;\n  }\n  \n  /* General Info Section */\n  .info-grid {\n    display: grid;\n    grid-template-columns: 20% 40% 15% 10% 15%;\n    border-bottom: 2px solid #000;\n  }\n  .info-cell {\n    border: 1px solid #000;\n    padding: 2px 5px;\n    min-height: 25px;\n  }\n  .info-cell.no-border-left { border-left: none; }\n  .info-cell.no-border-right { border-right: none; }\n  .info-cell.no-border-top { border-top: none; }\n  .info-cell.no-border-bottom { border-bottom: none; }\n  \n  .bold-label { font-weight: bold; }\n  \n  /* Checkbox Section */\n  .checkbox-row {\n    display: flex;\n    align-items: center;\n    padding: 2px 0;\n    border-bottom: 1px solid #ccc;\n  }\n  .checkbox-label {\n    margin-right: 10px;\n  }\n  \n  /* Caution Section */\n  .caution {\n    font-weight: bold;\n    border-top: 2px solid #000;\n    border-bottom: 1px solid #000;\n    padding: 2px 0;\n    margin-bottom: 5px;\n  }\n  \n  /* Lines Table Section */\n  table {\n    width: 100%;\n    border-collapse: collapse;\n  }\n  th, td {\n    border: 1px solid #000;\n    padding: 2px 5px;\n    vertical-align: bottom;\n  }\n  .line-num {\n    width: 20px;\n    text-align: right;\n    font-weight: bold;\n    border-right: none;\n  }\n  .line-desc {\n    border-left: none;\n  }\n  .amount-col {\n    width: 80px;\n    text-align: right;\n  }\n  .section-label {\n    writing-mode: vertical-rl;\n    transform: rotate(180deg);\n    text-align: center;\n    font-weight: bold;\n    width: 15px;\n    padding: 0;\n    background-color: #f0f0f0;\n  }\n  \n  /* Specific Line Layouts */\n  .nested-amount {\n    display: flex;\n    justify-content: flex-end;\n  }\n  .nested-amount span {\n    border-bottom: 1px dashed #000;\n    width: 100px;\n    display: inline-block;\n  }\n  \n  .dotted-leader {\n    display: flex;\n    align-items: flex-end;\n  }\n  .dotted-leader span:first-child {\n    flex-grow: 1;\n    overflow: hidden;\n    white-space: nowrap;\n  }\n  .dotted-leader span:first-child::after {\n    content: \" . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . \";\n  }\n  \n  /* Routing / Account Number */\n  .account-boxes {\n    display: flex;\n    align-items: center;\n  }\n  .account-box {\n    width: 15px;\n    height: 15px;\n    border: 1px solid #000;\n    margin-right: 2px;\n  }\n  \n  /* Sign Here Section */\n  .signature-section {\n    border-top: 2px solid #000;\n    margin-top: 5px;\n  }\n  .sign-grid {\n    display: grid;\n    grid-template-columns: 80px 1fr 100px;\n    border-bottom: 1px solid #000;\n  }\n  .sign-label {\n    font-size: 14px;\n    font-weight: bold;\n    padding: 5px;\n    display: flex;\n    align-items: center;\n    border-right: 1px solid #000;\n  }\n  .sign-area {\n    padding: 5px;\n  }\n  .sign-date {\n    padding: 5px;\n    border-left: 1px solid #000;\n  }\n  \n  /* Paid Preparer Section */\n  .preparer-grid {\n    display: grid;\n    grid-template-columns: 80px 2fr 2fr 1fr 1fr;\n    border-bottom: 2px solid #000;\n  }\n  .preparer-cell {\n    border-right: 1px solid #000;\n    border-bottom: 1px solid #000;\n    padding: 2px 5px;\n  }\n  .preparer-label {\n    font-size: 12px;\n    font-weight: bold;\n    padding: 5px;\n    display: flex;\n    align-items: center;\n  }\n  \n  /* Footer */\n  .footer {\n    display: flex;\n    justify-content: space-between;\n    font-size: 9px;\n    margin-top: 5px;\n  }\n  \n  .gray-bg {\n    background-color: #d3d3d3;\n  }\n</style>\n</head>\n<body>\n\n<div class=\"form-container\">\n  \n  <!-- Header -->\n  <div class=\"header\">\n    <div class=\"header-left\">\n      <div>Form <span class=\"form-number\">1065</span></div>\n      <div style=\"font-size: 8px;\">Department of the Treasury<br>Internal Revenue Service</div>\n    </div>\n    <div class=\"header-center\">\n      <div class=\"form-title\">U.S. Return of Partnership Income</div>\n      <div style=\"font-size: 11px; margin-top: 5px;\">\n        For calendar year 2025, or tax year beginning <span style=\"border-bottom: 1px dashed #000; width: 80px; display: inline-block;\"></span>, 2025, ending <span style=\"border-bottom: 1px dashed #000; width: 80px; display: inline-block;\"></span>, 20<span style=\"border-bottom: 1px dashed #000; width: 30px; display: inline-block;\"></span>\n      </div>\n      <div style=\"font-size: 11px; font-weight: bold; margin-top: 5px;\">\n        Go to <a href=\"http://www.irs.gov/Form1065\">www.irs.gov/Form1065</a> for instructions and the latest information.\n      </div>\n    </div>\n    <div class=\"header-right\">\n      <div style=\"font-size: 9px;\">OMB No. 1545-0123</div>\n      <div style=\"font-size: 28px; font-weight: bold; color: #ccc;\">2025</div>\n    </div>\n  </div>\n  \n  <!-- General Info Grid -->\n  <div style=\"border-top: 1px solid #000; border-bottom: 1px solid #000;\">\n      <div style=\"display: flex;\">\n          <div style=\"width: 20%; border-right: 1px solid #000; padding: 2px;\"><b>A</b> Principal business activity</div>\n          <div style=\"width: 60%; border-right: 1px solid #000; padding: 2px;\">Name of partnership</div>\n          <div style=\"width: 20%; padding: 2px;\"><b>D</b> Employer<br>identification number</div>\n      </div>\n      <div style=\"display: flex; border-top: 1px solid #000;\">\n          <div style=\"width: 20%; border-right: 1px solid #000; padding: 2px;\"><b>B</b> Principal product or service</div>\n          <div style=\"width: 45%; border-right: 1px solid #000; padding: 2px;\">Number and street</div>\n          <div style=\"width: 15%; border-right: 1px solid #000; padding: 2px;\">Room or suite no.</div>\n          <div style=\"width: 20%; padding: 2px;\"><b>E</b> Date business started</div>\n      </div>\n      <div style=\"display: flex; border-top: 1px solid #000;\">\n          <div style=\"width: 20%; border-right: 1px solid #000; padding: 2px;\"><b>C</b> Business code number</div>\n          <div style=\"width: 25%; border-right: 1px solid #000; padding: 2px;\">City or town</div>\n          <div style=\"width: 15%; border-right: 1px solid #000; padding: 2px;\">State or province</div>\n          <div style=\"width: 10%; border-right: 1px solid #000; padding: 2px;\">Country</div>\n          <div style=\"width: 10%; border-right: 1px solid #000; padding: 2px;\">ZIP or foreign<br>postal code</div>\n          <div style=\"width: 20%; padding: 2px;\"><b>F</b> Total assets (see instructions)<br>$</div>\n      </div>\n  </div>\n\n  <!-- Checkboxes Section -->\n  <div class=\"checkbox-row\" style=\"border-bottom: none;\">\n    <div style=\"width: 150px;\"><b>G</b> Check applicable boxes:</div>\n    <div style=\"flex: 1;\">\n      <b>(1)</b> <input type=\"checkbox\"> Initial return &nbsp;\n      <b>(2)</b> <input type=\"checkbox\"> Final return &nbsp;\n      <b>(3)</b> <input type=\"checkbox\"> Name change &nbsp;\n      <b>(4)</b> <input type=\"checkbox\"> Address change &nbsp;\n      <b>(5)</b> <input type=\"checkbox\"> Amended return\n    </div>\n  </div>\n  <div class=\"checkbox-row\" style=\"border-bottom: none;\">\n    <div style=\"width: 150px;\"><b>H</b> Check accounting method:</div>\n    <div style=\"flex: 1;\">\n      <b>(1)</b> <input type=\"checkbox\"> Cash &nbsp;\n      <b>(2)</b> <input type=\"checkbox\"> Accrual &nbsp;\n      <b>(3)</b> <input type=\"checkbox\"> Other (specify): <span style=\"border-bottom: 1px dashed #000; width: 150px; display: inline-block;\"></span>\n    </div>\n  </div>\n  <div class=\"checkbox-row\" style=\"border-bottom: none;\">\n    <div><b>I</b> Number of Schedules K-1. Attach one for each person who was a partner at any time during the tax year: <span style=\"border-bottom: 1px dashed #000; width: 150px; display: inline-block;\"></span></div>\n  </div>\n  <div class=\"checkbox-row\" style=\"border-bottom: none; display: flex; justify-content: space-between;\">\n    <div><b>J</b> Check if Schedules C and M-3 are attached</div>\n    <div><span style=\"letter-spacing: 2px;\">. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .</span> <input type=\"checkbox\"></div>\n  </div>\n  <div class=\"checkbox-row\">\n    <div><b>K</b> Check if partnership: &nbsp; <b>(1)</b> <input type=\"checkbox\"> Aggregated activities for section 465 at-risk purposes &nbsp; <b>(2)</b> <input type=\"checkbox\"> Grouped activities for section 469 passive activity purposes</div>\n  </div>\n  \n  <!-- Caution -->\n  <div class=\"caution\">\n    Caution: Include only trade or business income and expenses on lines 1a through 23 below. See instructions for more information.\n  </div>\n  \n  <!-- Lines Table -->\n  <table>\n    <!-- Income Section -->\n    <tr>\n      <td rowspan=\"8\" class=\"section-label\">Income</td>\n      <td class=\"line-num\">1a</td>\n      <td class=\"line-desc\" colspan=\"3\">Gross receipts or sales <span style=\"float:right;\"><b>b</b> Less returns and allowances <span style=\"border-bottom: 1px dashed #000; width: 150px; display: inline-block;\"></span></span></td>\n      <td style=\"width: 60px; text-align: center;\"><b>c</b> Balance</td>\n      <td style=\"width: 20px; font-weight: bold; text-align: center;\">1c</td>\n      <td class=\"amount-col gray-bg\"></td>\n    </tr>\n    <tr>\n      <td class=\"line-num\">2</td>\n      <td class=\"line-desc\" colspan=\"4\"><div class=\"dotted-leader\"><span>Cost of goods sold (attach Form 1125-A)</span></div></td>\n      <td style=\"font-weight: bold; text-align: center;\">2</td>\n      <td class=\"amount-col gray-bg\"></td>\n    </tr>\n    <tr>\n      <td class=\"line-num\">3</td>\n      <td class=\"line-desc\" colspan=\"4\"><div class=\"dotted-leader\"><span>Gross profit. Subtract line 2 from line 1c</span></div></td>\n      <td style=\"font-weight: bold; text-align: center;\">3</td>\n      <td class=\"amount-col gray-bg\"></td>\n    </tr>\n    <tr>\n      <td class=\"line-num\">4</td>\n      <td class=\"line-desc\" colspan=\"4\"><div class=\"dotted-leader\"><span>Ordinary income (loss) from other partnerships, estates, and trusts (attach statement)</span></div></td>\n      <td style=\"font-weight: bold; text-align: center;\">4</td>\n      <td class=\"amount-col gray-bg\"></td>\n    </tr>\n    <tr>\n      <td class=\"line-num\">5</td>\n      <td class=\"line-desc\" colspan=\"4\"><div class=\"dotted-leader\"><span>Net farm profit (loss) (attach Schedule F (Form 1040))</span></div></td>\n      <td style=\"font-weight: bold; text-align: center;\">5</td>\n      <td class=\"amount-col gray-bg\"></td>\n    </tr>\n    <tr>\n      <td class=\"line-num\">6</td>\n      <td class=\"line-desc\" colspan=\"4\"><div class=\"dotted-leader\"><span>Net gain (loss) from Form 4797, Part II, line 17 (attach Form 4797)</span></div></td>\n      <td style=\"font-weight: bold; text-align: center;\">6</td>\n      <td class=\"amount-col gray-bg\"></td>\n    </tr>\n    <tr>\n      <td class=\"line-num\">7</td>\n      <td class=\"line-desc\" colspan=\"4\"><div class=\"dotted-leader\"><span>Other income (loss) (attach statement)</span></div></td>\n      <td style=\"font-weight: bold; text-align: center;\">7</td>\n      <td class=\"amount-col gray-bg\"></td>\n    </tr>\n    <tr>\n      <td class=\"line-num\" style=\"border-bottom: 2px solid #000;\">8</td>\n      <td class=\"line-desc\" colspan=\"4\" style=\"border-bottom: 2px solid #000;\"><div class=\"dotted-leader\"><span><b>Total income (loss).</b> Combine lines 3 through 7</span></div></td>\n      <td style=\"font-weight: bold; text-align: center; border-bottom: 2px solid #000;\">8</td>\n      <td class=\"amount-col gray-bg\" style=\"border-bottom: 2px solid #000;\"></td>\n    </tr>\n    \n    <!-- Deductions Section -->\n    <tr>\n      <td rowspan=\"14\" class=\"section-label\">Deductions <span style=\"font-weight: normal;\">(see instructions for limitations)</span></td>\n      <td class=\"line-num\">9</td>\n      <td class=\"line-desc\" colspan=\"4\"><div class=\"dotted-leader\"><span>Salaries and wages (other than to partners) (less employment credits)</span></div></td>\n      <td style=\"font-weight: bold; text-align: center;\">9</td>\n      <td class=\"amount-col gray-bg\"></td>\n    </tr>\n    <tr>\n      <td class=\"line-num\">10</td>\n      <td class=\"line-desc\" colspan=\"4\"><div class=\"dotted-leader\"><span>Guaranteed payments to partners</span></div></td>\n      <td style=\"font-weight: bold; text-align: center;\">10</td>\n      <td class=\"amount-col gray-bg\"></td>\n    </tr>\n    <tr>\n      <td class=\"line-num\">11</td>\n      <td class=\"line-desc\" colspan=\"4\"><div class=\"dotted-leader\"><span>Repairs and maintenance</span></div></td>\n      <td style=\"font-weight: bold; text-align: center;\">11</td>\n      <td class=\"amount-col gray-bg\"></td>\n    </tr>\n    <tr>\n      <td class=\"line-num\">12</td>\n      <td class=\"line-desc\" colspan=\"4\"><div class=\"dotted-leader\"><span>Bad debts</span></div></td>\n      <td style=\"font-weight: bold; text-align: center;\">12</td>\n      <td class=\"amount-col gray-bg\"></td>\n    </tr>\n    <tr>\n      <td class=\"line-num\">13</td>\n      <td class=\"line-desc\" colspan=\"4\"><div class=\"dotted-leader\"><span>Rent</span></div></td>\n      <td style=\"font-weight: bold; text-align: center;\">13</td>\n      <td class=\"amount-col gray-bg\"></td>\n    </tr>\n    <tr>\n      <td class=\"line-num\">14</td>\n      <td class=\"line-desc\" colspan=\"4\"><div class=\"dotted-leader\"><span>Taxes and licenses</span></div></td>\n      <td style=\"font-weight: bold; text-align: center;\">14</td>\n      <td class=\"amount-col gray-bg\"></td>\n    </tr>\n    <tr>\n      <td class=\"line-num\">15</td>\n      <td class=\"line-desc\" colspan=\"4\"><div class=\"dotted-leader\"><span>Interest (see instructions)</span></div></td>\n      <td style=\"font-weight: bold; text-align: center;\">15</td>\n      <td class=\"amount-col gray-bg\"></td>\n    </tr>\n    <tr>\n      <td class=\"line-num\">16a</td>\n      <td class=\"line-desc\" colspan=\"2\"><div class=\"dotted-leader\"><span>Depreciation (if required, attach Form 4562)</span></div></td>\n      <td style=\"font-weight: bold; text-align: center; width: 25px;\">16a</td>\n      <td class=\"amount-col gray-bg\"></td>\n      <td class=\"gray-bg\" style=\"border-bottom: none;\"></td>\n      <td class=\"gray-bg\" style=\"border-bottom: none;\"></td>\n    </tr>\n    <tr>\n      <td class=\"line-num\">b</td>\n      <td class=\"line-desc\" colspan=\"2\"><div class=\"dotted-leader\"><span>Less depreciation reported on Form 1125-A and elsewhere on return</span></div></td>\n      <td style=\"font-weight: bold; text-align: center;\">16b</td>\n      <td class=\"amount-col gray-bg\"></td>\n      <td style=\"font-weight: bold; text-align: center;\">16c</td>\n      <td class=\"amount-col gray-bg\"></td>\n    </tr>\n    <tr>\n      <td class=\"line-num\">17</td>\n      <td class=\"line-desc\" colspan=\"4\"><div class=\"dotted-leader\"><span>Depletion <b>(Do not deduct oil and gas depletion.)</b></span></div></td>\n      <td style=\"font-weight: bold; text-align: center;\">17</td>\n      <td class=\"amount-col gray-bg\"></td>\n    </tr>\n    <tr>\n      <td class=\"line-num\">18</td>\n      <td class=\"line-desc\" colspan=\"4\"><div class=\"dotted-leader\"><span>Retirement plans, etc.</span></div></td>\n      <td style=\"font-weight: bold; text-align: center;\">18</td>\n      <td class=\"amount-col gray-bg\"></td>\n    </tr>\n    <tr>\n      <td class=\"line-num\">19</td>\n      <td class=\"line-desc\" colspan=\"4\"><div class=\"dotted-leader\"><span>Employee benefit programs</span></div></td>\n      <td style=\"font-weight: bold; text-align: center;\">19</td>\n      <td class=\"amount-col gray-bg\"></td>\n    </tr>\n    <tr>\n      <td class=\"line-num\">20</td>\n      <td class=\"line-desc\" colspan=\"4\"><div class=\"dotted-leader\"><span>Energy efficient commercial buildings deduction (attach Form 7205)</span></div></td>\n      <td style=\"font-weight: bold; text-align: center;\">20</td>\n      <td class=\"amount-col gray-bg\"></td>\n    </tr>\n    <tr>\n      <td class=\"line-num\">21</td>\n      <td class=\"line-desc\" colspan=\"4\"><div class=\"dotted-leader\"><span>Other deductions (attach statement)</span></div></td>\n      <td style=\"font-weight: bold; text-align: center;\">21</td>\n      <td class=\"amount-col gray-bg\"></td>\n    </tr>\n    <tr>\n      <td style=\"border-top: 1px solid #000; border-bottom: 2px solid #000;\"></td>\n      <td class=\"line-num\" style=\"border-top: 1px solid #000; border-bottom: 2px solid #000;\">22</td>\n      <td class=\"line-desc\" colspan=\"4\" style=\"border-top: 1px solid #000; border-bottom: 2px solid #000;\"><div class=\"dotted-leader\"><span><b>Total deductions.</b> Add the amounts shown in the far right 