        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Safety - Therapeutic Effect</title>\n<script>\nwindow.MathJax = { tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] } };\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\" async></script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    font-family: \"Segoe UI\", Arial, sans-serif;\n    margin: 0;\n    padding: 0;\n    background: #eaeaea;\n  }\n  .slide {\n    width: 900px;\n    margin: 20px auto;\n    background: #fff;\n    position: relative;\n    padding-bottom: 10px;\n    box-shadow: 0 0 4px rgba(0,0,0,0.2);\n  }\n  .header-bar {\n    background: #2e4374;\n    color: #fff;\n    display: flex;\n    align-items: center;\n    padding: 10px 25px;\n  }\n  .header-bar .safety {\n    width: 130px;\n    font-weight: bold;\n    font-size: 18px;\n  }\n  .header-bar .divider {\n    width: 1px;\n    height: 22px;\n    background: rgba(255,255,255,0.5);\n    margin-right: 25px;\n  }\n  .header-bar .effect {\n    font-size: 16px;\n  }\n  .header-bar.slide2 .effect {\n    font-weight: bold;\n    font-size: 19px;\n  }\n  .content {\n    padding: 20px 40px 10px 40px;\n    font-size: 15px;\n    color: #222;\n  }\n  .bullet-lead {\n    font-weight: bold;\n    margin: 15px 0 10px 0;\n    font-size: 15px;\n  }\n  ol.lettered {\n    list-style: none;\n    padding-left: 0;\n    margin: 0;\n  }\n  ol.lettered li {\n    position: relative;\n    padding-left: 30px;\n    margin-bottom: 18px;\n    line-height: 1.5;\n  }\n  ol.lettered li .letter {\n    position: absolute;\n    left: 0;\n  }\n  .footer-nav {\n    display: flex;\n    justify-content: center;\n    gap: 60px;\n    padding: 15px 0 10px 0;\n    border-top: 1px solid #ddd;\n    margin-top: 30px;\n    font-size: 13px;\n    color: #999;\n  }\n  .footer-nav .active {\n    color: #111;\n    font-weight: bold;\n    border-bottom: 2px solid #111;\n    padding-bottom: 3px;\n  }\n  .page-num {\n    position: absolute;\n    right: 15px;\n    bottom: 8px;\n    font-size: 12px;\n    color: #999;\n  }\n\n  /* Slide 2 layout */\n  .slide2-body {\n    display: flex;\n    padding: 15px 25px 5px 25px;\n    gap: 15px;\n  }\n  .table-col {\n    flex: 0 0 62%;\n  }\n  .side-col {\n    flex: 1;\n    font-size: 13px;\n    padding-top: 5px;\n  }\n  .side-col h4 {\n    margin: 12px 0 5px 0;\n    font-size: 14px;\n  }\n  .side-col ul {\n    margin: 0 0 5px 0;\n    padding-left: 18px;\n  }\n  .side-col li {\n    margin-bottom: 4px;\n  }\n  .citation {\n    font-size: 11px;\n    color: #333;\n    margin-top: 10px;\n    text-align: right;\n  }\n  .up { color: #d35400; font-weight: bold; }\n\n  table.data {\n    border-collapse: collapse;\n    width: 100%;\n    font-size: 10.5px;\n  }\n  table.data th, table.data td {\n    border: 1px solid #999;\n    padding: 3px 4px;\n    text-align: center;\n  }\n  .section-title {\n    font-weight: bold;\n    font-size: 11px;\n    margin: 8px 0 3px 0;\n  }\n  .red-label {\n    color: #c0392b;\n    font-size: 9.5px;\n  }\n  .subhead {\n    font-size: 9.5px;\n    font-weight: normal;\n  }\n  td.rowlabel {\n    text-align: left;\n    font-size: 10px;\n  }\n</style>\n</head>\n<body>\n\n<!-- SLIDE 1 -->\n<div class=\"slide\">\n  <div class=\"header-bar\">\n    <div class=\"safety\">Safety</div>\n    <div class=\"divider\"></div>\n    <div class=\"effect\">Therapeutic effect</div>\n  </div>\n  <div class=\"content\">\n    <div class=\"bullet-lead\">• In this clinical trial:</div>\n    <ol class=\"lettered\">\n      <li><span class=\"letter\">c.</span>Treatment-related events of grade &ge;3 severity were noted for<br>\n        <strong>only 2 patients in the vaccinated group, with 1 case each of</strong><br>\n        <strong>hypokalemia and rash.</strong>\n      </li>\n      <li><span class=\"letter\">d.</span>1 patient in the vaccinated group discontinued treatment for<br>\n        grade 2 gastritis.\n      </li>\n      <li><span class=\"letter\">e.</span>No treatment-related serious adverse events were observed.</li>\n    </ol>\n  </div>\n  <div class=\"footer-nav\">\n    <span>Background</span>\n    <span>Study Design</span>\n    <span class=\"active\">Result</span>\n    <span>Conclusion</span>\n  </div>\n  <div class=\"page-num\">13</div>\n</div>\n\n<!-- SLIDE 2 -->\n<div class=\"slide\">\n  <div class=\"header-bar slide2\">\n    <div class=\"safety\">Safety</div>\n    <div class=\"divider\"></div>\n    <div class=\"effect\">Therapeutic effect</div>\n  </div>\n\n  <div class=\"slide2-body\">\n    <div class=\"table-col\">\n\n      <div class=\"section-title\">Melanoma</div>\n      <table class=\"data\">\n        <tr>\n          <th rowspan=\"2\"></th>\n          <th rowspan=\"2\">N</th>\n          <th rowspan=\"2\">Follow<br>Up*</th>\n          <th rowspan=\"2\">Prior<br>Therapy</th>\n          <th rowspan=\"2\"><span class=\"red-label\">客观缓解率</span><br>ORR (months)</th>\n          <th><span class=\"red-label\">(中位)<br>无进展生存期</span><br><span class=\"subhead\">Median<br>PFS (months)</span></th>\n          <th><span class=\"red-label\">1年生存率</span><br><span class=\"subhead\">12-Month<br>OS</span></th>\n        </tr>\n        <tr></tr>\n        <tr>\n          <td class=\"rowlabel\">ITT Set (NT-001)</td>\n          <td>34</td><td>20</td><td>41%</td>\n          <td>47%<br>(30%, 65%)</td>\n          <td>15.1<br>(4.3, NE)</td>\n          <td>85%<br>(68%, 94%)</td>\n        </tr>\n        <tr>\n          <td class=\"rowlabel\">Vaccinated Set (NT-001)</td>\n          <td>27</td><td>20</td><td>30%</td>\n          <td>59%<br>(39%, 78%)</td>\n          <td>23.5<br>(6.6, NE)</td>\n          <td>96%<br>(76%, 99%)</td>\n        </tr>\n      </table>\n\n      <div class=\"section-title\">Non-Small Cell Lung Cancer</div>\n      <table class=\"data\">\n        <tr>\n          <th></th><th>N</th><th>Follow<br>Up (months)</th><th>Prior<br>Therapy</th>\n          <th>ORR</th><th>Median<br>PFS (months)</th><th>12-Month<br>OS</th>\n        </tr>\n        <tr>\n          <td class=\"rowlabel\">ITT Set (NT-001)</td>\n          <td>27</td><td>15</td><td>67%</td>\n          <td>26%<br>(11%, 46%)</td>\n          <td>4.4<br>(2.0, 8.5)</td>\n          <td>59%<br>(39%, 75%)</td>\n        </tr>\n        <tr>\n          <td class=\"rowlabel\">Vaccinated Set (NT-001)</td>\n          <td>18</td><td>15</td><td>61%</td>\n          <td>39%<br>(17%, 64%)</td>\n          <td>8.5<br>(3.9, NE)</td>\n          <td>83%<br>(57%, 94%)</td>\n        </tr>\n      </table>\n\n      <div class=\"section-title\">Transitional Cell Carcinoma of the Bladder</div>\n      <table class=\"data\">\n        <tr>\n          <th></th><th>N</th><th>Follow<br>Up (months)</th><th>Prior<br>Therapy</th>\n          <th>ORR</th><th>Median<br>PFS (months)</th><th>12-Month<br>OS</th>\n        </tr>\n        <tr>\n          <td class=\"rowlabel\">ITT Set (NT-001)</td>\n          <td>21</td><td>18</td><td>67%</td>\n          <td>19%<br>(5%, 42%)</td>\n          <td>5.6<br>(2.0, 12.0)</td>\n          <td>60%<br>(36%, 78%)</td>\n        </tr>\n        <tr>\n          <td class=\"rowlabel\">Vaccinated Set (NT-001)</td>\n          <td>15</td><td>18</td><td>61%</td>\n          <td>27%<br>(8%, 55%)</td>\n          <td>5.8<br>(2.8, 12.7)</td>\n          <td>67%<br>(38%, 85%)</td>\n        </tr>\n      </table>\n\n    </div>\n\n    <div class=\"side-col\">\n      <h4>a. Melanoma</h4>\n      <ul>\n        <li>ORR: 47%&rarr;<span class=\"up\">59%</span></li>\n        <li>PFS: 15.1&rarr;23.5</li>\n        <li>OS: 85%&rarr;96%</li>\n      </ul>\n      <h4>b. NSCLC</h4>\n      <ul>\n        <li>ORR: 26%&rarr;<span class=\"up\">39%</span></li>\n        <li>PFS: 4.4&rarr;8.5</li>\n        <li>OS: 59%&rarr;83%</li>\n      </ul>\n      <h4>c. Bladder Cancer</h4>\n      <ul>\n        <li>ORR: 19%&rarr;<span class=\"up\">27%</span></li>\n        <li>PFS: 5.6&rarr;5.8</li>\n        <li>OS: 60%&rarr;67%</li>\n      </ul>\n      <div class=\"citation\">Patrick A. Ott, Cell, 2020</div>\n    </div>\n  </div>\n\n  <div class=\"footer-nav\">\n    <span>Background</span>\n    <span>Study Design</span>\n    <span class=\"active\">Result</span>\n    <span>Conclusion</span>\n  </div>\n  <div class=\"page-num\">14</div>\n</div>\n\n</body>\n</html>"
