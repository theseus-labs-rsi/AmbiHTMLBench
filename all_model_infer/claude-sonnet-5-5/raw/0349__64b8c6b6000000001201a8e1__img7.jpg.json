        "content": "<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>单元词汇表 - Words in each unit</title>\n<script>\nwindow.MathJax = { tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] } };\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\" async></script>\n<style>\n  body {\n    background-color: #f7ecd8;\n    font-family: \"Segoe UI\", Arial, sans-serif;\n    margin: 0;\n    padding: 20px 30px;\n    color: #3a2a1a;\n    position: relative;\n  }\n  .header {\n    display: flex;\n    align-items: flex-start;\n    justify-content: center;\n    position: relative;\n    margin-bottom: 4px;\n  }\n  .header .placeholder {\n    position: absolute;\n    left: 0;\n    top: -5px;\n    width: 70px;\n    height: 60px;\n    border: 1px dashed #b09060;\n    background: #fdf6ea;\n    font-size: 9px;\n    text-align: center;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #999;\n  }\n  .title-block {\n    text-align: center;\n  }\n  .title-block .en-title {\n    font-size: 22px;\n    font-weight: bold;\n    color: #4a3a2a;\n    margin: 0;\n  }\n  .title-block .cn-title {\n    font-size: 18px;\n    font-weight: bold;\n    color: #4a3a2a;\n    margin: 2px 0 0 0;\n  }\n  .term-mark {\n    position: absolute;\n    right: 20px;\n    top: 0;\n    font-size: 26px;\n    font-weight: bold;\n    color: #cc2222;\n    font-family: \"KaiTi\", cursive, sans-serif;\n    transform: rotate(-3deg);\n  }\n  .note {\n    text-align: center;\n    font-size: 11px;\n    color: #4a3a2a;\n    margin: 6px 0 18px 0;\n  }\n  .columns {\n    display: flex;\n    justify-content: space-between;\n    gap: 40px;\n  }\n  .column {\n    flex: 1;\n    max-width: 48%;\n  }\n  .unit-title {\n    font-size: 17px;\n    font-weight: bold;\n    color: #4a3a2a;\n    margin: 14px 0 8px 0;\n  }\n  .entry {\n    display: flex;\n    justify-content: space-between;\n    align-items: baseline;\n    font-size: 13px;\n    line-height: 1.55;\n    margin: 0;\n  }\n  .entry .text {\n    flex: 1;\n  }\n  .entry .page {\n    flex-shrink: 0;\n    margin-left: 8px;\n    color: #3a2a1a;\n  }\n  .bold {\n    font-weight: bold;\n  }\n  .regular {\n    font-weight: normal;\n  }\n  .sub {\n    font-size: 12px;\n    padding-left: 14px;\n    display: block;\n  }\n  .bg-watermark {\n    position: absolute;\n    right: 10px;\n    bottom: 10px;\n    width: 120px;\n    height: 100px;\n    opacity: 0.5;\n    border: 1px dashed #cbb890;\n    font-size: 9px;\n    color: #bbb;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n  }\n</style>\n</head>\n<body>\n\n  <div class=\"header\">\n    <div class=\"placeholder\">[Icon: squirrel]</div>\n    <div class=\"title-block\">\n      <p class=\"en-title\">Words in each unit</p>\n      <p class=\"cn-title\">单元词汇表</p>\n    </div>\n    <div class=\"term-mark\">3下</div>\n  </div>\n\n  <div class=\"note\">（注：黑体词要求学生能够听、说、认读；白体词只作听、说要求。）</div>\n\n  <div class=\"columns\">\n\n    <!-- Left column -->\n    <div class=\"column\">\n      <div class=\"unit-title\">Unit 1</div>\n\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">UK</span> 英国</span><span class=\"page\">p.5</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">Canada</span> /'kænədə/ 加拿大</span><span class=\"page\">p.5</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">USA</span> 美国</span><span class=\"page\">p.5</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">China</span> /'tʃainə/ 中国</span><span class=\"page\">p.5</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"regular\">she</span> /ʃi:/ 她</span><span class=\"page\">p.8</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"regular\">student</span> /stju:dnt/ 学生</span><span class=\"page\">p.8</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">pupil</span> /pju:pl/ 学生;（尤指）小学生</span><span class=\"page\">p.8</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"regular\">he</span> /hi:/ 他</span><span class=\"page\">p.8</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">teacher</span> /'ti:tʃə(r)/ 教师</span><span class=\"page\">p.8</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"regular\">boy</span> /bɔi/ 男孩</span><span class=\"page\">p.4</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"regular\">and</span> /ənd/ 和；和</span><span class=\"page\">p.4</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">girl</span> /gɜ:l/ 女孩</span><span class=\"page\">p.4</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"regular\">new</span> /nju:/ 新的</span><span class=\"page\">p.4</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">friend</span> /frend/ 朋友</span><span class=\"page\">p.4</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"regular\">today</span> /tə'deɪ/ 今天</span><span class=\"page\">p.4</span></div>\n\n      <div class=\"unit-title\">Unit 2</div>\n\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">father</span> /'fɑ:ðə(r)/ 父亲；爸爸</span><span class=\"page\">p.15</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">dad</span> /dæd/（口语）爸爸；爹爹</span><span class=\"page\">p.15</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"regular\">man</span> /mæn/ 男人</span><span class=\"page\">p.15</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"regular\">woman</span> /'womən/ 女人</span><span class=\"page\">p.15</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">mother</span> /'mʌðə(r)/ 母亲；妈妈</span><span class=\"page\">p.15</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">sister</span> /'sɪstə(r)/ 姐；妹</span><span class=\"page\">p.18</span></div>\n    </div>\n\n    <!-- Right column -->\n    <div class=\"column\">\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">brother</span> /'brʌðə(r)/ 兄；弟</span><span class=\"page\">p.18</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">grandmother</span> /'grænmʌðə(r)/<span class=\"sub\">（外）祖母</span></span><span class=\"page\">p.18</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">grandma</span> /'grænmɑ:/<span class=\"sub\">（口语）（外）祖母</span></span><span class=\"page\">p.18</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">grandfather</span> /'grænfɑ:ðə(r)/<span class=\"sub\">（外）祖父</span></span><span class=\"page\">p.18</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">grandpa</span> /'grænpɑ:/<span class=\"sub\">（口语）（外）祖父</span></span><span class=\"page\">p.18</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">family</span> /'fæməli/ 家；家庭</span><span class=\"page\">p.18</span></div>\n\n      <div class=\"unit-title\">Unit 3</div>\n\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">thin</span> /θɪn/ 瘦的</span><span class=\"page\">p.25</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">fat</span> /fæt/ 胖的；肥的</span><span class=\"page\">p.25</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">tall</span> /tɔ:l/ 高的</span><span class=\"page\">p.25</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">short</span> /ʃɔ:t/ 矮的；短的</span><span class=\"page\">p.25,28</span></div>\n      <div class=\"entry\"><span class=\"text\"><span class=\"bold\">long</span> /lɒŋ/ 长的</span><span class=\