        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>中国中车股份有限公司2024年年度报告</title>\n<script>\nwindow.MathJax = { tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] } };\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\" async></script>\n<style>\n  body {\n    font-family: \"SimSun\", \"Songti SC\", serif;\n    font-size: 15px;\n    color: #000;\n    max-width: 1000px;\n    margin: 0 auto;\n    padding: 30px 40px;\n    line-height: 1.6;\n  }\n  .header {\n    text-align: center;\n    font-size: 15px;\n    padding-bottom: 8px;\n    border-bottom: 1.5px solid #000;\n    margin-bottom: 25px;\n  }\n  table {\n    width: 100%;\n    border-collapse: collapse;\n    margin-bottom: 20px;\n    font-size: 14px;\n  }\n  table, th, td {\n    border: 1px solid #000;\n  }\n  th, td {\n    padding: 6px 8px;\n    text-align: right;\n  }\n  td.label, th.label {\n    text-align: left;\n  }\n  .center-cell {\n    text-align: center;\n  }\n  .section-title {\n    font-weight: bold;\n    margin: 25px 0 10px 0;\n  }\n  .checkbox-line {\n    margin: 8px 0 20px 0;\n  }\n  .unit-line {\n    text-align: right;\n    margin-bottom: 5px;\n  }\n  .gap {\n    height: 20px;\n  }\n  .page-number {\n    text-align: center;\n    margin-top: 40px;\n    font-size: 13px;\n  }\n  .bold-row td {\n    font-weight: bold;\n  }\n</style>\n</head>\n<body>\n\n<div class=\"header\">中国中车股份有限公司2024年年度报告</div>\n\n<table>\n  <tr>\n    <td class=\"label\">营销支出</td>\n    <td>1,194,174</td>\n    <td>1,123,100</td>\n  </tr>\n  <tr>\n    <td class=\"label\">产品质量保证支出</td>\n    <td>811,227</td>\n    <td>687,099</td>\n  </tr>\n  <tr>\n    <td class=\"label\">行政办公支出</td>\n    <td>766,907</td>\n    <td>675,347</td>\n  </tr>\n  <tr>\n    <td class=\"label\">水电动能等支出</td>\n    <td>139,584</td>\n    <td>136,236</td>\n  </tr>\n  <tr>\n    <td class=\"label\">其他</td>\