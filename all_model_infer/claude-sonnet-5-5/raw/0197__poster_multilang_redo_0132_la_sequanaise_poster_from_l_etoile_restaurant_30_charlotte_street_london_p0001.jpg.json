ial {\n    text-align: center;\n    color: #1a2a4a;\n    font-size: 14px;\n    font-weight: bold;\n    line-height: 1.4;\n    margin-bottom: 10px;\n  }\n\n  .siege-social .addr {\n    font-size: 17px;\n  }\n\n  .fonds-garantie {\n    text-align: center;\n    font-size: 26px;\n    font-weight: bold;\n    margin-bottom: 10px;\n  }\n  .fonds-garantie .label { color: #1a2a4a; }\n  .fonds-garantie .amount { color: #b5121b; }\n\n  /* IMAGE PLACEHOLDER */\n  .illustration-frame {\n    border: 2px solid #5b4a2f;\n    padding: 4px;\n    margin: 10px 0;\n  }\n\n  .placeholder {\n    width: 100%;\n    height: 560px;\n    box-sizing: border-box;\n    background: repeating-linear-gradient(45deg, #e8dfc7, #e8dfc7 10px, #ded3b4 10px, #ded3b4 20px);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    color: #6b5a3a;\n    font-size: 15px;\n    font-style: italic;\n    border: 1px solid #a89a72;\n  }\n\n  /* BOTTOM SECTION */\n  .bottom-section {\n    background: #ecd98f;\n    padding: 8px 20px 15px 20px;\n    position: relative;\n  }\n\n  .year-row {\n    display: flex;\n    justify-content: space-between;\n    font-size: 20px;\n    font-weight: bold;\n    color: #b5121b;\n    font-style: italic;\n    margin-bottom: -8px;\n  }\n\n  .fondee-line {\n    text-align: center;\n    font-size: 11px;\n    color: #1a2a4a;\n  }\n  .fondee-line .strong {\n    font-weight: bold;\n    font-size: 15px;\n  }\n\n  .plus-importante {\n    text-align: center;\n    color: #b5121b;\n    font-size: 26px;\n    font-weight: bold;\n    margin: 4px 0 0 0;\n  }\n\n  .institutions-line {\n    text-align: center;\n    font-size: 11px;\n    color: #1a2a4a;\n    margin-bottom: 8px;\n  }\n\n  .sommes-line {\n    font-size: 15px;\n    color: #1a2a4a;\n    font-weight: bold;\n    margin-bottom: 2px;\n  }\n\n  .stats-table {\n    width: 100%;\n    border-collapse: collapse;\n    margin-top: 4px;\n  }\n  .stats-table td {\n    padding: 3px 0;\n    font-size: 15px;