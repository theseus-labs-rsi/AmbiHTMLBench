ht: bold;\n    margin-bottom: 4px;\n  }\n  .type-box .head .cn {\n    font-size: 12px;\n  }\n  .type-box .head .en {\n    font-size: 15px;\n    display: block;\n  }\n  .type-box ol {\n    margin: 4px 0 0 0;\n    padding-left: 16px;\n  }\n  .type-box ol li {\n    margin-bottom: 3px;\n  }\n\n  /* Green statement bar + bullets */\n  .green-bar {\n    background: #6aa84f;\n    color: #fff;\n    text-align: center;\n    font-size: 13px;\n    font-weight: bold;\n    padding: 6px 8px;\n    margin-bottom: 6px;\n  }\n  .green-bullets {\n    background: #eef5ea;\n    border: 1px solid #6aa84f;\n    border-top: none;\n    padding: 8px 14px 10px 14px;\n    font-size: 12px;\n    margin-bottom: 12px;\n  }\n  .green-bullets ul {\n    margin: 0;\n    padding-left: 18px;\n    list-style: disc;\n  }\n  .green-bullets li {\n    margin-bottom: 4px;\n  }\n\n  /* Row 2: 4 colored reply boxes */\n  .row-replies {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 8px;\n    margin-bottom: 10px;\n  }\n  .reply-box {\n    border-radius: 4px;\n    overflow: hidden;\n    font-size: 11px;\n    display: flex;\n    flex-direction: column;\n  }\n  .reply-box .head {\n    color: #fff;\n    text-align: center;\n    padding: 5px 4px;\n    font-weight: bold;\n  }\n  .reply-box .head .cn { font-size: 12px; display: block; }\n  .reply-box .head .en { font-size: 12px; display: block; }\n  .reply-box .body {\n    padding: 6px 8px 10px 8px;\n    flex: 1;\n  }\n  .reply-box .body .bold-title {\n    text-align: center;\n    font-weight: bold;\n    font-size: 13px;\n    margin-bottom: 6px;\n  }\n  .reply-box .body ul {\n    margin: 0;\n    padding-left: 16px;\n    list-style: disc;\n  }\n  .reply-box .body li {\n    margin-bottom: 4px;\n  }\n\n  .box1 .head { background: #3d85c6; }\n  .box1 .body { background: #eaf1fa; border: 1px solid #3d85c6; border-top: none; }\n  .box2 .head { background: #6fa8dc; }\n  .box2 .body { background: #eef4fb; border: 1px solid #6fa8dc; border-top: none; }\n  .box3 .head { background: #e69138; }\n  .box3 .body { background: #fdf1e4; border: 1px solid #e69138; border-top: none; }\n  .box4 .head { background: #cc7a1e; }\n  .box4 .body { background: #fbeee0; border: 1px solid #cc7a1e; border-top: none; }\n\n  /* Bottom summary */\n  .summary-bar {\n    background: #e69138;\n    color: #fff;\n    text-align: center;\n    font-size: 15px;\n    font-weight: bold;\n    padding: 6px 0;\n    margin-bottom: 0;\n  }\n  .summary-body {\n    border: 1px solid #e69138;\n    border-top: none;\n    background: #fdf1e4;\n    padding: 8px 16px 10px 16px;\n    font-size: 12px;\n  }\n  .summary-body ol {\n    margin: 0;\n    padding-left: 18px;\n  }\n  .summary-body li {\n    margin-bottom: 4px;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <div class=\"watermark\">\n    <span style=\"top:20px; left:-60px;\">科研大喵</span>\n    <span style=\"top:120px; left:200px;\">同福大字</span>\n    <span style=\"top:220px; left:-80px;\">科研大喵</span>\n    <span style=\"top:320px; left:180px;\">科研大喵</span>\n    <span style=\"top:420px; left:-60px;\">科研大喵</span>\n    <span style=\"top:520px; left:200px;\">科研大喵</span>\n    <span style=\"top:620px; left:-80px;\">科研大喵</span>\n  </div>\n\n  <div class=\"content\">\n    <h1 class=\"title\">一张图说清楚毕业答辩</h1>\n    <p class=\"subtitle\">不要道歉！不要道歉！不要道歉！</p>\n\n    <div class=\"section-bar\">四类质疑回复技巧</div>\n\n    <div class=\"row-types\">\n      <div class=\"type-box\">\n        <div class=\"head\"><span class=\"cn\">类型一</span><span class=\"en\">WHAT</span></div>\n        <ol>\n          <li>你的研究有什么创新点?</li>\n          <li>你的研究有什么主要发现?</li>\n          <li>此发现有何理论现实意义?</li>\n        </ol>\n      </div>\n      <div class=\"type-box\">\n        <div class=\"head\"><span class=\"cn\">类型二</span><span class=\"en\">WHY</span></div>\n        <ol>\n          <li>为什么选取这个研究课题?</li>\n          <li>为什么采用这个研究方法?</li>\n          <li>为什么运用这个理论角度?</li>\n        </ol>\n      </div>\n      <div class=\"type-box\">\n        <div class=\"head\"><span class=\"cn\">类型三</span><span class=\"en\">WHY NOT</span></div>\n        <ol>\n          <li>为什么没有参考XX文献?</li>\n          <li>为什么没有做XX测试?</li>\n          <li>为什么没有考虑XX因素?</li>\n        </ol>\n      </div>\n      <div class=\"type-box\">\n        <div class=\"head\"><span class=\"cn\">类型四</span><span class=\"en\">无言以对</span></div>\n        <ol>\n          <li>论文没有新意</li>\n          <li>讨论没有逻辑</li>\n          <li>遗漏重要文献</li>\n          <li>没有亮眼发现</li>\n          <li>格式混乱</li>\n          <li>漏洞百出</li>\n        </ol>\n      </div>\n    </div>\n\n    <div class=\"green-bar\">感谢老师提问－复述问题要点－承认论文存在进步空间</div>\n    <div class=\"green-bullets\">\n      <ul>\n        <li>理解/确认老师的具体质疑点</li>\n        <li>放缓问答节奏，对自己思考应对创造时间</li>\n        <li>消除和老师观点的对抗，为进一步答辩创造轻松氛围</li>\n      </ul>\n    </div>\n\n    <div class=\"row-replies\">\n      <div class=\"reply-box box1\">\n        <div class=\"head\"><span class=\"cn\">回复方式一</span><span class=\"en\">Elaboration</span></div>\n        <div class=\"body\">\n          <div class=\"bold-title\">具体说明</div>\n          <ul>\n            <li>针对问题展开具体说明</li>\n            <li>结合PPT中提及具体内容</li>\n          </ul>\n        </div>\n      </div>\n      <div class=\"reply-box box2\">\n        <div class=\"head\"><span class=\"cn\">回复方式二</span><span class=\"en\">Clarification</span></div>\n        <div class=\"body\">\n          <div class=\"bold-title\">解释澄清</div>\n          <ul>\n            <li>解释自己的具体考虑</li>\n            <li>结合研究中的合理局限</li>\n          </ul>\n        </div>\n      </div>\n      <div class=\"reply-box box3\">\n        <div class=\"head\"><span class=\"cn\">回复方式三</span><span class=\"en\">Justification</span></div>\n        <div class=\"body\">\n          <div class=\"bold-title\">论证说理</div>\n          <ul>\n            <li>论证和老师分歧点的合理性</li>\n            <li>结合前人研究和自己的观点</li>\n          </ul>\n        </div>\n      </div>\n      <div class=\"reply-box box4\">\n        <div class=\"head\"><span class=\"cn\">回复方式四</span><span class=\"en\">Appreciation</span></div>\n        <div class=\"body\">\n          <div class=\"bold-title\">虚心接受</div>\n          <ul>\n            <li>老师指出论文核心问题</li>\n            <li>虚心接受诚恳感谢/修改</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"summary-bar\">回顾总结</div>\n    <div class=\"summary-body\">\n      <ol>\n        <li>总结回复的主要内容，突出\"我的\"考虑，\"我的\"研究亮点</li>\n        <li>再次确认老师给出的建议，并表示已经认真记录</li>\n        <li>提出简要修改思路，和老师口头沟通，后续会认真修改，谢谢老师</li>\n      </ol>\n    </div>\n  </div>\n</div>\n</body>\n</html>"
