 font-size: 22px;\n    font-weight: bold;\n    color: #222;\n    letter-spacing: 1px;\n  }\n\n  .content-panel {\n    background: #ffffff;\n    border-radius: 4px;\n    padding: 30px 26px;\n    box-sizing: border-box;\n  }\n\n  .row {\n    display: flex;\n    align-items: baseline;\n    margin-bottom: 22px;\n  }\n  .row:last-child {\n    margin-bottom: 0;\n  }\n\n  .key {\n    width: 150px;\n    flex-shrink: 0;\n    font-weight: bold;\n    font-size: 15px;\n    color: #111;\n  }\n\n  .desc {\n    font-size: 14.5px;\n    color: #222;\n    font-weight: 500;\n  }\n</style>\n</head>\n<body>\n  <div class=\"page\">\n    <div class=\"spikes\">\n      <div class=\"spike\"></div>\n      <div class=\"spike\"></div>\n    </div>\n\n    <div class=\"title-box\">\n      <div class=\"hatch left\">\n        <div class=\"hatch-line\"></div>\n        <div class=\"hatch-line\"></div>\n        <div class=\"hatch-line\"></div>\n        <div class=\"hatch-line\"></div>\n      </div>\n      <span class=\"check\">&#10003;</span>\n      <span class=\"title-text\">PPT快捷键</span>\n      <div class=\"hatch right\">\n        <div class=\"hatch-line\"></div>\n        <div class=\"hatch-line\"></div>\n        <div class=\"hatch-line\"></div>\n        <div class=\"hatch-line\"></div>\n      </div>\n    </div>\n\n    <div class=\"content-panel\">\n      <div class=\"row\"><div class=\"key\">B</div><div class=\"desc\">黑屏(在演示时)</div></div>\n      <div class=\"row\"><div class=\"key\">W</div><div class=\"desc\">切换至白屏/从黑白屏恢复放映</div></div>\n      <div class=\"row\"><div class=\"key\">F4</div><div class=\"desc\">重复上一步操作</div></div>\n      <div class=\"row\"><div class=\"key\">Ctrl+D</div><div class=\"desc\">快速复制选中对象</div></div>\n      <div class=\"row\"><div class=\"key\">Ctrl+G</div><div class=\"desc\">组合对象</div></div>\n      <div class=\"row\"><div class=\"key\">Ctrl+ Shift+ G</div><div class=\"desc\">取消组合</div></div>\n      <div class=\"row\"><div class=\"key\">Ctrl+Alt+V</div><div class=\"desc\">打开选择