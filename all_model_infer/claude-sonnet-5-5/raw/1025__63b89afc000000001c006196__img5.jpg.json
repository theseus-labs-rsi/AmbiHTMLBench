        "content": "<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>古诗词情感表达笔记</title>\n<script>\nwindow.MathJax = { tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] } };\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\" async></script>\n<style>\n  body {\n    background: #f5f1e8;\n    margin: 0;\n    padding: 0;\n    display: flex;\n    justify-content: center;\n  }\n  .page {\n    position: relative;\n    width: 560px;\n    min-height: 900px;\n    background: #f7f3ea;\n    background-image: repeating-linear-gradient(\n      to bottom,\n      transparent 0px,\n      transparent 27px,\n      #d9d3c0 28px\n    );\n    padding: 10px 20px 40px 45px;\n    box-sizing: border-box;\n    font-family: \"KaiTi\", \"STKaiti\", \"Ma Shan Zheng\", cursive, sans-serif;\n    color: #2b2b8f;\n    font-size: 15px;\n    line-height: 27px;\n  }\n  /* red vertical margin line like a notebook */\n  .page::before {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    bottom: 0;\n    left: 40px;\n    width: 1px;\n    background: #d16a6a;\n  }\n  /* yellow tab strip on left edge simulating tape/binding */\n  .tab-strip {\n    position: absolute;\n    left: 0;\n    top: 60%;\n    width: 14px;\n    height: 160px;\n    background: repeating-linear-gradient(\n      to bottom,\n      #e8c34a 0px, #e8c34a 8px,\n      #d1a83a 8px, #d1a83a 16px\n    );\n    opacity: 0.85;\n  }\n  .entry {\n    margin-bottom: 4px;\n  }\n  .title {\n    font-weight: bold;\n    white-space: nowrap;\n  }\n  .desc {\n    display: block;\n    margin-left: 2px;\n  }\n  .footer-mark {\n    position: absolute;\n    bottom: 10px;\n    right: 25px;\n    text-align: right;\n    font-family: sans-serif;\n    font-size: 12px;\n    color: #333;\n  }\n  .footer-mark .badge {\n    display: inline-block;\n    background: #d33;\n    color: #fff;\n    border-radius: 4px;\n    padding: 2px 6px;\n    font-size: 11px;\n    margin-bottom: 4px;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <div class=\"tab-strip\"></div>\n\n  <div class=\"entry\">\n    <span class=\"title\">《咏鹅》</span>\n    <span class=\"desc\">表达了作者对于我鹅的喜爱赞美之情</span>\n  </div>\n\n  <div class=\"entry\">\n    <span class=\"title\">《江南》</span>\n    <span class=\"desc\">表达了诗人对江南的深深热爱，也激发着读者对那美丽风光的向往</span>\n  </div>\n\n  <div class=\"entry\">\n    <span class=\"title\">《画》</span>\n    <span class=\"desc\">表达了诗人对画中景对事物的问和对视觉的忧伤</span>\n  </div>\n\n  <div class=\"entry\">\n    <span class=\"title\">《小阂歌》</span>\n    <span class=\"desc\">表达了作者对于[?]大丰劳劳作的赞美之情，同时也表达出作者对丰收大的同情</span>\n  </div>\n\n  <div class=\"entry\">\n    <span class=\"title\">《古朗月行》</span>\n    <span class=\"desc\">表达了作者对儿童的天真心漫，及他们丰富的想象力的喜爱之情</span>\n  </div>\n\n  <div class=\"entry\">\n    <span class=\"title\">《风》</span>\n    <span class=\"desc\">表达了诗人对大自然的敬畏之情</span>\n  </div>\n\n  <div class=\"entry\">\n    <span class=\"title\">《春晓》</span>\n    <span class=\"desc\">表达了诗人对春天的热爱和怜惜之情，抒发了诗人热爱春天，珍惜春光的思想感情</span>\n  </div>\n\n  <div class=\"entry\">\n    <span class=\"title\">《闻官军收[?]化》</span>\n    <span class=\"desc\">表达了李白对[?]化的深厚情谊</span>\n  </div>\n\n  <div class=\"entry\">\n    <span class=\"title\">《静夜思》</span>\n    <span class=\"desc\">表达了诗人在寂静的月夜思念家乡的思想感情</span>\n  </div>\n\n  <div class=\"entry\">\n    <span class=\"title\">《寻隐者不遇》</span>\n    <span class=\"desc\">表达了作者对隐者生活的向往之情，体现了他追求宁静朴实的生活和淡泊的心境</span>\n  </div>\n\n  <div class=\"entry\">\n    <span class=\"title\">《池上》</span>\n    <span class=\"desc\">表达了诗人对诗中主人公的天真幼稚，活泼淘气的形象的喜爱，以及对田园生活的赞美之情</span>\n  </div>\n\n  <div class=\"entry\">\n    <span class=\"title\">《小池》</span>\n    <span class=\"desc\">表达了作者对大自然景物的喜爱之情</span>\n  </div>\n\n  <div class=\"entry\">\n    <span class=\"title\">《画鸡》</span>\n    <span class=\"desc\">表达了作者对优美高洁雄鸡的赞美与喜爱之情</span>\n  </div>\n\n  <div class=\"entry\">\n    <span class=\"title\">《梅花》</span>\n    <span class=\"desc\">表达了作者坚持自我的信念，说明坚强高洁的人格所具有的伟大魅力</span>\n  </div>\n\n  <div class=\"entry\">\n    <span class=\"title\">《小儿垂钓》</span>\n    <span class=\"desc\">表达了作者对孩童的喜爱之情，也表达了对小孩认真态度的赞叹之情</span>\n  </div>\n\n  <div class=\"entry\">\n    <span class=\"title\">《登鹳雀楼》</span>\n    <span class=\"desc\">表现出诗人开阔的胸襟和抱负，表达了诗人昂扬向上的进取精神</span>\n  </div>\n\n  <div class=\"footer-mark\">\n    <div class=\"badge\">小红书</div>\n    <div>小红书号：4130673107</div>\n  </div>\n</div>\n</body>\n</html>"
