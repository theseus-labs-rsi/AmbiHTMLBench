n    flex-direction: column;\n  }\n  .filter-list a {\n    padding: 10px 16px;\n    font-size: 14px;\n    color: #3c4043;\n    text-decoration: none;\n  }\n\n  .results-panel {\n    flex: 1;\n  }\n  .filter-results-input {\n    width: 100%;\n    padding: 12px 16px;\n    border: 1px solid #dadce0;\n    border-radius: 8px;\n    font-size: 14px;\n    margin-bottom: 24px;\n  }\n  .results-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 20px;\n  }\n  .result-card {\n    border: 1px solid #e0e0e0;\n    border-radius: 8px;\n    padding: 20px;\n  }\n  .result-card h4 {\n    margin: 0 0 8px 0;\n    font-size: 16px;\n    font-weight: 400;\n  }\n  .result-card h4 a {\n    color: #1a73e8;\n    text-decoration: none;\n  }\n  .result-date {\n    font-size: 12px;\n    color: #5f6368;\n    margin-bottom: 10px;\n  }\n  .result-card p {\n    font-size: 13px;\n    color: #3c4043;\n    line-height: 1.5;\n    margin: 0;\n  }\n</style>\n</head>\n<body>\n\n<header>\n  <div class=\"nav-left\">\n    <div class=\"logo\"><span>Google</span> Cloud</div>\n    <div class=\"navitem\">Technology areas ▾</div>\n    <div class=\"navitem\">Cross-product tools ▾</div>\n  </div>\n  <div class=\"nav-right\">\n    <div class=\"search-box\">🔍 Search &nbsp;&nbsp;&nbsp;&nbsp; /</div>\n    <div class=\"console-btn\">🖥 Console</div>\n    <div class=\"icon-btn\">☀</div>\n    <div class=\"lang\">🌐 English ▾</div>\n    <div class=\"signin\">Sign in</div>\n  </div>\n</header>\n\n<section class=\"hero\">\n  <h1>Cloud Architecture Center</h1>\n  <p>Discover reference architectures, design guidance, and best practices for building, migrating, and managing your cloud workloads.</p>\n  <p>See <a href=\"#\">what's new</a>!</p>\n  <div class=\"hero-graphic\">\n    <div class=\"placeholder\">[Illustration: cloud, hexagon, circles, arch shapes]</div>\n  </div>\n</section>\n\n<section class=\"section-foundational\">\n  <h2>Review foundational architecture guidance for enterprise deployments in Google Cloud</h2>\n  <div class=\"card-grid\">\n    <div class=\"card\">\n      <h3><a href=\"#\">Google Cloud Well-Architected Framework</a></h3>\n      <p>Design cloud topologies that are secure, efficient, resilient, high-performing, cost-effective, and sustainable.</p>\n    </div>\n    <div class=\"card\">\n      <h3><a href=\"#\">Deployment archetypes</a></h3>\n      <p>Learn about basic archetypes for cloud deployments: zonal, regional, multi-regional, global, hybrid, and multicloud.</p>\n    </div>\n    <div class=\"card\">\n      <h3><a href=\"#\">Infrastructure reliability guide</a></h3>\n      <p>Design and build infrastructure to run workloads reliably in Google Cloud.</p>\n    </div>\n    <div class=\"card\">\n      <h3><a href=\"#\">Landing zone design</a></h3>\n      <p>Build a landing zone that includes identity onboarding, resource hierarchy, network design, and security controls.</p>\n    </div>\n    <div class=\"card\">\n      <h3><a href=\"#\">Enterprise foundations blueprint</a></h3>\n      <p>Build a foundation for governance, security scale, visibility, and access.</p>\n    </div>\n    <div class=\"card\">\n      <h3><a href=\"#\">Delivery Navigator <span class=\"ext-icon\">↗</span></a></h3>\n      <p>Accelerate cloud solution deployments with implementation plans and technical guides from Google Cloud Consulting.</p>\n    </div>\n  </div>\n</section>\n\n<section class=\"section-domain\">\n  <h2>Discover domain-specific architecture guidance</h2>\n  <div class=\"domain-layout\">\n    <div class=\"filter-panel\">\n      <div class=\"filter-header\">☰ FILTER BY</div>\n      <div class=\"filter-list\">\n        <a href=\"#\">AI and ML</a>\n        <a href=\"#\">Application development</a>\n        <a href=\"#\">Big data and analytics</a>\n        <a href=\"#\">Databases</a>\n        <a href=\"#\">Hybrid and multicoud</a>\n        <a href=\"#\">Migration</a>\n        <a href=\"#\">Monitoring and Logging</a>\n        <a href=\"#\">Networking</a>