        "content": "<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>环境类万能思路</title>\n<script>\nwindow.MathJax = { tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] } };\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\" async></script>\n<style>\n  body {\n    font-family: \"SimSun\", \"Microsoft YaHei\", Arial, sans-serif;\n    margin: 0;\n    padding: 20px;\n    background: #fff;\n    color: #000;\n    font-size: 13px;\n  }\n  .container {\n    max-width: 700px;\n    margin: 0 auto;\n    border: 1px solid #444;\n  }\n  .title-bar {\n    background: #f4c9a8;\n    text-align: center;\n    font-weight: bold;\n    font-size: 17px;\n    padding: 6px 0;\n    border-bottom: 2px solid #444;\n  }\n  .section-header {\n    text-align: center;\n    color: #ff0000;\n    font-weight: bold;\n    font-size: 14px;\n    padding: 3px 0;\n    border-bottom: 1px solid #999;\n  }\n  table {\n    width: 100%;\n    border-collapse: collapse;\n  }\n  table td {\n    border-bottom: 1px solid #ccc;\n    padding: 5px 8px;\n    vertical-align: top;\n  }\n  td.cn {\n    width: 40%;\n    color: #000;\n  }\n  td.en {\n    width: 60%;\n    color: #000;\n  }\n  .vocab-header {\n    color: #ff0000;\n    font-weight: bold;\n    padding: 4px 8px 2px 8px;\n  }\n  .vocab-body {\n    padding: 0 8px 10px 8px;\n    line-height: 1.6;\n    text-align: justify;\n  }\n  .vocab-body .cn-word {\n    color: #000;\n  }\n  .vocab-body .en-word {\n    color: #ff0000;\n  }\n</style>\n</head>\n<body>\n<div class=\"container\">\n\n  <div class=\"title-bar\">环境类万能思路</div>\n\n  <div class=\"section-header\">常见环境问题</div>\n  <table>\n    <tr>\n      <td class=\"cn\">气候变化，全球变暖</td>\n      <td class=\"en\">Climate change, global warming</td>\n    </tr>\n    <tr>\n      <td class=\"cn\">空气污染，垃圾增多</td>\n      <td class=\"en\">Air pollution, increase of rubbish/garbage</td>\n    </tr>\n    <tr>\n      <td class=\"cn\">能源危机，水资源匮乏，森林减少</td>\n      <td class=\"en\">Energy crisis, water shortage, deforestation</td>\n    </tr>\n    <tr>\n      <td class=\"cn\">自然灾害，酸雨，沙尘暴，干旱，水灾</td>\n      <td class=\"en\">Natural disasters, acid rain, sand storms, drought, flood</td>\n    </tr>\n  </table>\n\n  <div class=\"section-header\">所有这些问题的根本原因</div>\n  <table>\n    <tr>\n      <td class=\"cn\">人口增长，工业发展，长期的人类活动</td>\n      <td class=\"en\">Population growth, industrial development, long-term human activities</td>\n    </tr>\n  </table>\n\n  <div class=\"section-header\">正确的解决方法</div>\n  <table>\n    <tr>\n      <td class=\"cn\">世界方面：全球合作，达成共识，制定环境保护的国际标准</td>\n      <td class=\"en\">Global cooperation, reach the agreement, set international standards for environmental protection</td>\n    </tr>\n    <tr>\n      <td class=\"cn\">政府方面：制定环保政策，鼓励低碳经济</td>\n      <td class=\"en\">Make laws, encourage low carbon economy</td>\n    </tr>\n    <tr>\n      <td class=\"cn\">科技方面：大力开发可再生的，清洁的新能源，投资环保节能科技</td>\n      <td class=\"en\">Exploit renewable, green energy, invest in energy-saving technologies</td>\n    </tr>\n    <tr>\n      <td class=\"cn\">公司方面：推出环保产品，引领大众绿色消费习惯</td>\n      <td class=\"en\">Promote environmental-friendly products, lead green consuming habits</td>\n    </tr>\n    <tr>\n      <td class=\"cn\">个人方面：提升环保意识，倡导低碳生活方式</td>\n      <td class=\"en\">raise public's green awareness, encourage low carbon lifestyle</td>\n    </tr>\n  </table>\n\n  <div class=\"vocab-header\">核心词汇及短语:</div>\n  <div class=\"vocab-body\">\n    <span class=\"en-word\">low carbon</span> <span class=\"cn-word\">低碳</span>&nbsp;&nbsp;\n    <span class=\"en-word\">green</span> <span class=\"cn-word\">adj. 环保的</span>&nbsp;&nbsp;\n    <span class=\"en-word\">environmental-friendly</span> <span class=\"cn-word\">adj. 环保的</span>&nbsp;&nbsp;\n    <span class=\"en-word\">eco-friendly</span> <span class=\"cn-word\">adj. 环保的</span>&nbsp;&nbsp;\n    <span class=\"en-word\">ecosystem</span> <span class=\"cn-word\">n. 生态系统</span>&nbsp;&nbsp;\n    <span class=\"en-word\">environmental protection</span> <span class=\"cn-word\">环境保护</span>&nbsp;&nbsp;\n    <span class=\"en-word\">preserve</span> <span class=\"cn-word\">vt. 保护</span>&nbsp;&nbsp;\n    <span class=\"en-word\">sustainable development</span> <span class=\"cn-word\">可持续发展</span>&nbsp;&nbsp;\n    <span class=\"en-word\">deplete natural resources</span> <span class=\"cn-word\">耗尽自然资源</span>&nbsp;&nbsp;\n    <span class=\"en-word\">leave a carbon footprint</span> <span class=\"cn-word\">留下一个碳化足迹</span>&nbsp;&nbsp;\n    <span class=\"en-word\">discharge/release pollutants into the environment</span> <span class=\"cn-word\">向环境排放污染物</span>&nbsp;&nbsp;\n    <span class=\"en-word\">greenhouse effect</span> <span class=\"cn-word\">温室效应</span>&nbsp;&nbsp;\n    <span class=\"en-word\">global warming</span> <span class=\"cn-word\">全球变暖</span>&nbsp;&nbsp;\n    <span class=\"en-word\">discharge</span> <span class=\"cn-word\">vt. 排放</span>&nbsp;&nbsp;\n    <span class=\"en-word\">toxic</span> <span class=\"cn-word\">adj. 有毒的</span>&nbsp;&nbsp;\n    <span class=\"en-word\">contaminate</span> <span class=\"cn-word\">v. 污染</span>&nbsp;&nbsp;\n    <span class=\"en-word\">degrade</span> <span class=\"cn-word\">v. 恶化 降级</span>&nbsp;&nbsp;\n    <span class=\"en-word\">deteriorate</span> <span class=\"cn-word\">v. 恶化</span>&nbsp;&nbsp;\n    <span class=\"en-word\">shortage</span> <span class=\"cn-word\">n. 缺乏</span>&nbsp;&nbsp;\n    <span class=\"en-word\">lack</span> <span class=\"cn-word\">vt. 缺少</span>&nbsp;&nbsp;\n    <span class=\"en-word\">deficiency</span> <span class=\"cn-word\">n. 缺乏 不足</span>&nbsp;&nbsp;\n    <span class=\"en-word\">fight climate change</span> <span class=\"cn-word\">抵制气候变化</span>&nbsp;&nbsp;\n    <span class=\"en-word\">improve air quality</span> <span class=\"cn-word\">改善空气质量</span>&nbsp;&nbsp;\n    <span class=\"en-word\">conserve energy</span> <span class=\"cn-word\">节约能源</span>&nbsp;&nbsp;\n    <span class=\"en-word\">renewable energies such as wind, hydro and solar powers</span> <span class=\"cn-word\">可再生能源，例如风光、水能和太阳能</span>&nbsp;&nbsp;\n    <span class=\"en-word\">fuel-efficient vehicles</span> <span class=\"cn-word\">燃油高效汽车</span>&nbsp;&nbsp;\n    <span class=\"en-word\">take public transit, carpool or ride a bicycle</span> <span class=\"cn-word\">乘坐公共交通，拼车或骑自行车</span>&nbsp;&nbsp;\n    <span class=\"en-word\">avoid using throw-away products</span> <span class=\"cn-word\">避免使用一次性产品</span>&nbsp;&nbsp;\n    <span class=\"en-word\">environmental-friendly products</span> <span class=\"cn-word\">环保产品</span>&nbsp;&nbsp;\n    <span class=\"en-word\">eco-friendly alternatives/substitutions/replacements</span> <span class=\"cn-word\">生态友好的替代品</span>&nbsp;&nbsp;\n    <span class=\"en-word\">sort the daily garbage</span> <span class=\"cn-word\">生活垃圾分类</span>&nbsp;&nbsp;\n    <span class=\"en-word\">consume less and recycle more</span>\n  </div>\n\n</div>\n</body>\n</html>"
