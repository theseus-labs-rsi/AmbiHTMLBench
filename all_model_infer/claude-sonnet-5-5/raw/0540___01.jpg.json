        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Word常用快捷键大全</title>\n<script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  body {\n    margin: 0;\n    padding: 20px;\n    background: #a9c8e0;\n    font-family: \"Microsoft YaHei\", \"PingFang SC\", sans-serif;\n  }\n  .page {\n    max-width: 900px;\n    margin: 0 auto;\n    background: #fdfbf3;\n    border: 6px solid #cfe0ee;\n    border-radius: 10px;\n    padding: 20px 30px 40px 30px;\n    position: relative;\n  }\n  .title-bar {\n    text-align: center;\n    font-size: 46px;\n    font-weight: bold;\n    padding: 10px 0 20px 0;\n    letter-spacing: 2px;\n  }\n  .title-bar .en {\n    color: #5aa9e6;\n    -webkit-text-stroke: 1px #3d7db8;\n  }\n  .title-bar .cn1 { color: #f2b6c8; }\n  .title-bar .cn2 { color: #f5a623; }\n  .title-bar .cn3 { color: #7fc97f; }\n  .title-bar .cn4 { color: #f2b6c8; }\n\n  .corner-deco {\n    position: absolute;\n    font-size: 22px;\n  }\n\n  .columns {\n    display: flex;\n    gap: 30px;\n  }\n  .col {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    gap: 25px;\n  }\n\n  .box {\n    border: 3px solid #f2b6c8;\n    border-radius: 18px;\n    padding: 20px 18px 15px 18px;\n    position: relative;\n    background: #fffefb;\n  }\n  .box.green { border-color: #b7d99a; }\n  .box.blue-box { border-color: #a9d3e5; }\n\n  .box-title {\n    display: inline-block;\n    background: #cfe6f5;\n    border-radius: 20px;\n    padding: 6px 22px;\n    font-size: 22px;\n    font-weight: bold;\n    color: #333;\n    margin: -38px 0 15px 10px;\n    border: 2px solid #a9c8e0;\n  }\n  .box-title.pink { background: #fbdbe6; border-color: #f2b6c8; }\n  .box-title.yellow { background: #fcedb0; border-color: #e8c96a; }\n  .box-title.green-t { background: #dcefc9; border-color: #b7d99a; }\n\n  .row {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 6px 18px;\n    font-size: 20px;\n    font-weight: bold;\n    margin: 10px 0;\n    align-items: center;\n  }\n  .cmd {\n    color: #333;\n    white-space: nowrap;\n  }\n  .desc {\n    color: #444;\n    font-weight: bold;\n    margin-right: 20px;\n    white-space: nowrap;\n  }\n  .pair {\n    display: flex;\n    gap: 8px;\n    align-items: center;\n    flex: 1 1 45%;\n  }\n  .icon {\n    font-size: 16px;\n  }\n\n  .placeholder {\n    background: #f3f3ea;\n    border: 1px dashed #c9c2a8;\n    border-radius: 10px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #999;\n    font-size: 14px;\n    text-align: center;\n  }\n\n  .bear-placeholder {\n    width: 100%;\n    height: 130px;\n    margin: 10px 0;\n  }\n\n  .tree-placeholder {\n    position: absolute;\n    width: 100px;\n    height: 140px;\n  }\n\n  .single-row {\n    font-size: 20px;\n    font-weight: bold;\n    margin: 10px 0;\n    color: #333;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n  }\n\n  .decor-birds, .decor-flowers, .decor-misc {\n    position: absolute;\n  }\n\n  .signature {\n    position: absolute;\n    bottom: 30px;\n    right: 30px;\n    text-align: center;\n    color: #b0a99f;\n    font-size: 12px;\n    opacity: 0.6;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <!-- Top decorative row placeholder -->\n  <div class=\"placeholder\" style=\"width:100%; height:40px; margin-bottom:10px;\">\n    [装饰: 顶部小图标 - 花朵/星星/蝴蝶结/信封/表情贴纸]\n  </div>\n\n  <div class=\"title-bar\">\n    <span class=\"en\">Word</span><span class=\"cn1\">常</span><span class=\"cn2\">用</span><span class=\"cn3\">快</span><span class=\"cn2\">捷</span><span class=\"cn4\">键</span><span class=\"cn1\">大</span><span class=\"cn3\">全</span>\n  </div>\n\n  <div class=\"columns\">\n    <!-- LEFT COLUMN -->\n    <div class=\"col\">\n\n      <div class=\"box\">\n        <div class=\"box-title\">📩 文件与基本</div>\n        <div class=\"row\">\n          <div class=\"pair\"><span class=\"cmd\">Ctrl+N</span><span class=\"desc\">新建</span></div>\n          <div class=\"pair\"><span class=\"cmd\">Ctrl+S</span><span class=\"desc\">保存</span></div>\n          <div class=\"pair\"><span class=\"cmd\">Ctrl+O</span><span class=\"desc\">打开</span></div>\n          <div class=\"pair\"><span class=\"cmd\">Ctrl+P</span><span class=\"desc\">打印</span></div>\n        </div>\n        <div class=\"placeholder bear-placeholder\">[插画: 小熊敲键盘，云朵背景]</div>\n      </div>\n\n      <div class=\"box\">\n        <div class=\"box-title yellow\">🖌 文本与排版</div>\n        <div class=\"row\">\n          <div class=\"pair\" style=\"flex-basis:100%;\"><span class=\"cmd\">Ctrl+K</span><span class=\"desc\">超链接 🔗</span></div>\n          <div class=\"pair\"><span class=\"cmd\">Ctrl+E</span><span class=\"desc\">居中 ☰</span></div>\n          <div class=\"pair\"><span class=\"cmd\">Ctrl+D</span><span class=\"desc\">格式 ☰</span></div>\n          <div class=\"pair\"><span class=\"cmd\">Ctrl+1</span><span class=\"desc\">单倍行距 1.0</span></div>\n          <div class=\"pair\"><span class=\"cmd\">Ctrl+2</span><span class=\"desc\">双倍行距 2.0</span></div>\n          <div class=\"pair\" style=\"flex-basis:100%;\"><span class=\"cmd\">Alt+Shift+Up</span><span class=\"desc\">上移段落 ⬆</span></div>\n          <div class=\"pair\" style=\"flex-basis:100%;\"><span class=\"cmd\">Alt+Shift+Down</span><span class=\"desc\">下移段落 ⬇</span></div>\n          <div class=\"pair\"><span class=\"cmd\">Ctrl+L</span><span class=\"desc\">左对齐 ☰</span></div>\n          <div class=\"pair\"><span class=\"cmd\">Ctrl+R</span><span class=\"desc\">右对齐</span></div>\n        </div>\n      </div>\n\n      <div class=\"box\">\n        <div class=\"box-title pink\">🐦 导航与查找</div>\n        <div class=\"row\">\n          <div class=\"pair\"><span class=\"cmd\">Ctrl+F</span><span class=\"desc\">查找 🔍</span></div>\n          <div class=\"pair\"><span class=\"cmd\">Ctrl+H</span><span class=\"desc\">替换 🔄</span></div>\n          <div class=\"pair\" style=\"flex-basis:100%;\"><span class=\"cmd\">Ctrl+G</span><span class=\"desc\">定位 🔍</span></div>\n          <div class=\"pair\" style=\"flex-basis:100%;\"><span class=\"cmd\">Ctrl+Home</span><span class=\"desc\">光标移至文首 🏠</span></div>\n          <div class=\"pair\" style=\"flex-basis:100%;\"><span class=\"cmd\">Ctrl+End</span><span class=\"desc\">光标移至文尾 ➡</span></div>\n          <div class=\"pair\" style=\"flex-basis:100%;\"><span class=\"cmd\">Ctrl+Alt+A</span><span class=\"desc\">QQ截图 ✂</span></div>\n        </div>\n        <div class=\"placeholder\" style=\"width:110px; height:150px; position:absolute; right:10px; bottom:-10px;\">[插画: 小树 + 键盘按键贴纸]</div>\n      </div>\n\n    </div>\n\n    <!-- RIGHT COLUMN -->\n    <div class=\"col\">\n\n      <div class=\"box\">\n        <div class=\"box-title pink\">✏️ 编辑与格式</div>\n        <div class=\"row\">\n          <div class=\"pair\"><span class=\"cmd\">Ctrl+C</span><span class=\"desc\">复制 📋</span></div>\n          <div class=\"pair\"><span class=\"cmd\">Ctrl+Z</span><span class=\"desc\">撤销</span></div>\n          <div class=\"pair\"><span class=\"cmd\">Ctrl+Y</span><span class=\"desc\">恢复</span></div>\n          <div class=\"pair\"><span class=\"cmd\">Ctrl+V</span><span class=\"desc\">粘贴 ✂</span></div>\n          <div class=\"pair\"><span class=\"cmd\">Ctrl+X</span><span class=\"desc\">剪切 ✂</span></div>\n          <div class=\"pair\"><span class=\"cmd\">Ctrl+U</span><span class=\"desc\">下划线</span></div>\n          <div class=\"pair\"><span class=\"cmd\">Ctrl+A</span><span class=\"desc\">全选 ✨</span></div>\n          <div class=\"pair\"><span class=\"cmd\">增大字号</span><span class=\"desc\">↗</span></div>\n          <div class=\"pair\"><span class=\"cmd\">Ctrl+B</span><span class=\"desc\">加粗 ✏️</span></div>\n          <div class=\"pair\"><span class=\"cmd\">减小字号</span><span class=\"desc\">↘</span></div>\n          <div class=\"pair\" style=\"flex-basis:100%;\"><span class=\"cmd\">Ctrl+Shift+F</span><span class=\"desc\">删除文本格式</span></div>\n          <div class=\"pair\" style=\"flex-basis:100%;\"><span class=\"cmd\">Ctrl+Shift+N</span><span class=\"desc\">更改格式 ✏️</span></div>\n          <div class=\"pair\"><span class=\"cmd\">Delete</span><span class=\"desc\">删除选中 🗑</span></div>\n          <div class=\"pair\"><span class=\"cmd\">Backspace</span><span class=\"desc\">删除表格 ❌</span></div>\n        </div>\n        <div class=\"placeholder\" style=\"width:90px; height:70px; position:absolute; right:0px; top:-10px;\">[插画: 小鸟]</div>\n      </div>\n\n      <div class=\"box green\">\n        <div class=\"box-title green-t\">📧 段落与高级</div>\n        <div class=\"row\">\n          <div class=\"pair\"><span class=\"cmd\">Ctrl+L</span><span class=\"desc\">左对齐</span></div>\n          <div class=\"pair\"><span class=\"cmd\">Shift+Enter</span><span class=\"desc\">换行</span></div>\n          <div class=\"pair\" style=\"flex-basis:100%;\"><span class=\"cmd\">Ctrl+R</span><span class=\"desc\">右对齐</span></div>\n          <div class=\"pair\" style=\"flex-basis:100%;\"><span class=\"cmd\">Ctrl+K</span><span class=\"desc\">隐藏功能区</span></div>\n          <div class=\"pair\" style=\"flex-basis:100%;\"><span class=\"cmd\">Win+R</span><span class=\"desc\">运行</span></div>\n          <div class=\"pair\" style=\"flex-basis:100%;\"><span class=\"cmd\">Win+Tab</span><span class=\"desc\">3D桌面</span></div>\n          <div class=\"pair\" style=\"flex-basis:100%;\"><span class=\"cmd\">Alt+Shift+Up</span><span class=\"desc\">上移段落</span></div>\n          <div class=\"pair\" style=\"flex-basis:100%;\"><span class=\"cmd\">Alt+Shift+Down</span><span class=\"desc\">下移段落</span></div>\n          <div class=\"pair\" style=\"flex-basis:100%;\"><span class=\"cmd\">Shift+Delete</span><span class=\"desc\">永久删除</span></div>\n          <div class=\"pair\" style=\"flex-basis:100%;\"><span class=\"cmd\">Ctrl+Alt+M</span><span class=\"desc\">✏️ 新建批注</span></div>\n          <div class=\"pair\" style=\"flex-basis:100%;\"><span class=\"cmd\">Ctrl+Alt+O</span><span class=\"desc\">📝 大纲视图</span></div>\n          <div class=\"pair\" style=\"flex-basis:100%;\"><span class=\"cmd\">Ctrl+Alt+P</span><span class=\"desc\">📄 页面视图</span></div>\n          <div class=\"pair\" style=\"flex-basis:100%;\"><span class=\"cmd\">Ctrl+F2</span><span class=\"desc\">🖨 打印预览</span></div>\n          <div class=\"pair\" style=\"flex-basis:100%;\"><span class=\"cmd\">Ctrl+Enter</span><span class=\"desc\">分页</span></div>\n        </div>\n        <div class=\"placeholder\" style=\"width:130px; height:170px; position:absolute; right:5px; bottom:-40px;\">[插画: 大树 + 键盘按键标签 (Ctrl, Shift, Enter, Esc, Caps Lock)]</div>\n      </div>\n\n    </div>\n  </div>\n\n  <div class=\"placeholder\" style=\"width:100%; height:30px; margin-top:20px;\">\n    [装饰: 底部小动物/图标贴纸一排]\n  </div>\n\n  <div class=\"signature\">\n    [签名印章: VINCENT]\n  </div>\n\n</div>\n</body>\n</html>"
