#ccc;\n    font-size: 11px;\n  }\n  .container {\n    position: relative;\n  }\n</style>\n</head>\n<body>\n<div class=\"container\">\n\n<h1>政治</h1>\n\n<!-- Table 1 -->\n<table class=\"table1\">\n  <colgroup>\n    <col class=\"c1\"><col class=\"c2\"><col class=\"c3\">\n  </colgroup>\n  <tr>\n    <th></th>\n    <th>考点</th>\n    <th>记忆方式</th>\n  </tr>\n  <tr>\n    <td class=\"label\">工党领袖Tony Blair</td>\n    <td>introduced a Scottish Parliament and a Welsh Assembly. 招苏格兰议会和威尔士议会</td>\n    <td>工党Labour Party，劳动是<span class=\"redbold\">理发师Tony</span></td>\n  </tr>\n  <tr>\n    <td class=\"label\">总理问答 'Prime Minister's Questions</td>\n    <td>每周一次</td>\n    <td></td>\n  </tr>\n  <tr>\n    <td class=\"label\">2012年联盟的党派</td>\n    <td>保守党<b>The Conservative Party</b>和自由民主党<b>The Liberal Democrats Party</b>卡梅伦</td>\n    <td>选两个最长的选项</td>\n  </tr>\n  <tr>\n    <td class=\"label\">英联邦Commonwealth</td>\n    <td><b>Commonwealth</b> 是association of countries国家联盟</td>\n    <td>该国家联盟（group、组织、social都是不对的）</td>\n  </tr>\n  <tr>\n    <td class=\"label\">上议院House of Lords<br>下议院House of Commons</td>\n    <td>上议院是贵族君主<br>下议院需要 The Speaker</td>\n    <td>Lord老爷就是高高在上，就是上议院</td>\n  </tr>\n</table>\n\n<!-- Table 2 -->\n<table class=\"table2\">\n  <colgroup>\n    <col class=\"c1\"><col class=\"c2\">\n  </colgroup>\n  <tr>\n    <th>议员MPs= Member of Parliament</th>\n    <th>考点</th>\n  </tr>\n  <tr>\n    <td class=\"label\">MPs的责任</td>\n    <td>1.对选民负责2.参加辩论和对新法律进行投票 Law</td>\n  </tr>\n  <tr>\n    <td class=\"label\">MP的选举制度</td>\n    <td>By-election补缺选举，死了或者辞职补缺</td>\n  </tr>\n  <tr>\n    <td class=\"label\">MP竞选</td>\n    <td>18岁可以竞选议员MP<br>1.votc.之前会有一个a poll card</td>\n  </tr>\n  <tr>\n    <td></td>\n    <td>1.电视和broadcast公开-这个过程叫<span class=\"redbold\">Hansard</span><br><span class=\"redbold\">2. Canvassing</span>拉票</td>\n  </tr>\n</table>\n\n<!-- Table 3 -->\n<table class=\"table2\">\n  <colgroup>\n    <col class=\"c1\"><col class=\"c2\">\n  </colgroup>\n  <tr>\n    <th>议员MPs= Member of