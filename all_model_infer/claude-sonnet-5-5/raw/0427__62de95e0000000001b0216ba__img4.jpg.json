n    height: 210px;\n    background: linear-gradient(135deg, #d6e84a 60%, #8fc31f 100%);\n    border: 2px dashed #555;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    color: #333;\n    font-size: 12px;\n    margin: 8px 0;\n    position: relative;\n    overflow: hidden;\n  }\n  .pk-text {\n    position: absolute;\n    top: 30%;\n    left: 50%;\n    transform: translate(-50%, -50%) rotate(-3deg);\n    font-size: 46px;\n    font-weight: 900;\n    color: #4b2aad;\n    text-shadow: 3px 3px 0 #fff, -2px -2px 0 #ff2a6d;\n    letter-spacing: 4px;\n  }\n  .glove {\n    position: absolute;\n    width: 46px;\n    height: 46px;\n    background: #ff5fa0;\n    border-radius: 50% 50% 50% 10%;\n    top: 15px;\n  }\n  .glove.left { left: 5px; transform: rotate(-20deg); }\n  .glove.right { right: 5px; transform: rotate(20deg) scaleX(-1); }\n  .ring-caption {\n    position: absolute;\n    bottom: 8px;\n    width: 100%;\n    text-align: center;\n    font-size: 11px;\n    color: #666;\n  }\n  .banner-strip {\n    background: linear-gradient(90deg, #3f2a8f 0%, #3f2a8f 40%, #ff2a6d 40%, #ff2a6d 100%);\n    color: #fff;\n    font-weight: bold;\n    font-size: 15px;\n    padding: 6px 8px;\n    text-align: center;\n    margin-bottom: 12px;\n    letter-spacing: 1px;\n  }\n  .white-box {\n    background: #fff;\n    border: 1px solid #999;\n    padding: 8px 8px 8px 26px;\n    font-size: 10.5px;\n    color: #333;\n    line-height: 1.6;\n    position: relative;\n    margin-bottom: 14px;\n  }\n  .white-box .title {\n    font-weight: bold;\n    font-size: 12px;\n    margin-bottom: 4px;\n    color: #111;\n  }\n  .arrow-icon {\n    position: absolute;\n    left: 4px;\n    top: 6px;\n    font-size: 14px;\n    color: #222;\n  }\n  .pink-text {\n    color: #d6006e;\n    font-weight: bold;\n    text-align: center;\n    font-size: 13px;\n    line-height: 1.9;\n  }\n  .pink-text .small {\n    font-size: 11px;\n    color: #333;\n    font-weight: normal;\n  }\n\n  /* RIGHT COLUMN TOP */\n  .bracelet-placeholder {\n    width: 100%;\n    height: 190px;\n    background: repeating-linear-gradient(45deg, #7a4fc0, #7a4fc0 10px, #8f66d0 10px, #8f66d0 20px);\n    border: 2px dashed #ddd;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #eee;\n    font-size: 12px;\n    text-align: center;\n  }\n  .star-deco {\n    position: absolute;\n    color: #f9e400;\n    font-size: 22px;\n  }\n\n  /* RIGHT COLUMN BOTTOM */\n  .black-title-box {\n    background: #111;\n    color: #f9e400;\n    font-weight: 900;\n    font-size: 22px;\n    padding: 10px 14px;\n    line-height: 1.5;\n    margin-bottom: 14px;\n    position: relative;\n  }\n  .black-title-box .arrows {\n    position: absolute;\n    right: 10px;\n    bottom: -22px;\n    color: #111;\n    font-size: 16px;\n    font-weight: bold;\n  }\n  .green-text {\n    color: #1a1a1a;\n    font-size: 12px;\n    line-height: 2;\n    text-align: center;\n    margin-top: 26px;\n  }\n  .quote {\n    font-weight: bold;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"header\">\n    <span>商业长图</span>\n    <span class=\"mid\">◇ ────── DESIGN ────── ◇</span>\n    <span>设计分享</span>\n  </div>\n\n  <div class=\"columns\">\n\n    <!-- LEFT COLUMN -->\n    <div class=\"col col-left\">\n      <div class=\"intro-text\">\n        两大征稿专栏<br>\n        将在本期<br>\n        与大家做个正式的告别\n      </div>\n\n      <div class=\"yellow-box\">\n        江湖从不缺传奇<br>\n        这一次<br>\n        T A 燃情出炉，战力拉满\n      </div>\n\n      <div class=\"ring-placeholder\">\n        <div class=\"glove left\"></div>\n        <div class=\"glove right\"></div>\n        <div class=\"pk-text\">PK</div>\n        <div class=\"ring-caption\">[Illustration: 拳击台 / PK 立体字, 箭头装饰]</div>\n      </div>\n\n      <div class=\"banner-strip\">天都擂台　毦今日上线</div>\n\n      <div class=\"white-box\">\n        <span class=\"arrow-icon\">↗</span>\n        <div class=\"title\">正反两派 互相PK</div>\n        征