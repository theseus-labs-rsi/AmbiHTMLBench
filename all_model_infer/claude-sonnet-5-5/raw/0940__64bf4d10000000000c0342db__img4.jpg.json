d;\n    margin-top: 2px;\n  }\n  .use-text {\n    text-align: left;\n    line-height: 1.7;\n    padding: 0 6px;\n  }\n  .placeholder {\n    width: 70px;\n    height: 55px;\n    margin: 0 auto;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    font-size: 10px;\n    color: #888;\n    background: repeating-linear-gradient(\n      45deg,\n      #eee,\n      #eee 6px,\n      #f7f7f7 6px,\n      #f7f7f7 12px\n    );\n    border: 1px dashed #ccc;\n    border-radius: 4px;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"header\">\n    <h1>钩针工具选择指南</h1>\n    <p class=\"subtitle\">——only手作集——</p>\n  </div>\n\n  <table>\n    <colgroup>\n      <col class=\"col-tool\">\n      <col class=\"col-use\">\n      <col class=\"col-tip\">\n      <col class=\"col-img\">\n    </colgroup>\n    <thead>\n      <tr>\n        <th>工具</th>\n        <th>用途</th>\n        <th>初学者建议</th>\n        <th>实物图</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        <td>\n          <div class=\"tool-name\">钩针</div>\n          <div class=\"tool-required\">(必备)</div>\n        </td>\n        <td class=\"use-text\">\n          钩针是钩针编织的必备工具，有多种尺寸与规格，具体如何选择可参考《钩针毛线对照表》、《如何选择钩针和毛线》\n        </td>\n        <td>3mm左右的钩针最实用</td>\n        <td>\n          <div class=\"placeholder\">[Photo: 彩色钩针]</div>\n        </td>\n      </tr>\n      <tr>\n        <td>\n          <div class=\"tool-name\">毛线</div>\n          <div class=\"tool-required\">(必备)</div>\n        </td>\n        <td class=\"use-text\">\n          毛线种类很多，新手建议选择股数较少的，可减少失误次数。具体如何选择参考《如何选择钩针和毛线》\n        </td>\n        <td>中粗的宝宝棉/牛奶棉</td>\n        <td>\n          <div class=\"placeholder\">[Photo: 毛线团]</div>\n        </td>\n      </tr>\n      <tr>\n        <td>\n          <div class=\"tool-name\">剪刀</div>\n          <div class=\"tool-required\">(必备)</div>\n        </td>\n        <td class=\"use-text\">剪断编织过程中的编织线</td>\n        <td>必备</td>\n        <td>\n          <div class=