        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>我写的 vs 人民日报写的</title>\n  <style>\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box;\n    }\n\n    body {\n      font-family: \"SimSun\", \"宋体\", serif;\n      width: 420px;\n      margin: 0 auto;\n    }\n\n    /* ── Top Section (tan/khaki background) ── */\n    .top-section {\n      background-color: #c8b888;\n      padding: 20px 20px 10px 20px;\n      position: relative;\n      min-height: 200px;\n    }\n\n    .top-label-row {\n      display: flex;\n      align-items: center;\n      gap: 16px;\n      margin-bottom: 18px;\n    }\n\n    .top-label {\n      font-size: 26px;\n      font-weight: bold;\n      color: #1a1a1a;\n      white-space: nowrap;\n    }\n\n    .red-circle {\n      width: 48px;\n      height: 48px;\n      border-radius: 50%;\n      border: 6px solid #cc2222;\n      background: transparent;\n      display: inline-block;\n      flex-shrink: 0;\n    }\n\n    .top-content-row {\n      display: flex;\n      align-items: flex-start;\n      justify-content: space-between;\n    }\n\n    .top-text {\n      font-size: 17px;\n      color: #1a1a1a;\n      line-height: 1.8;\n      max-width: 200px;\n    }\n\n    .child-photo-wrapper {\n      position: relative;\n      width: 160px;\n      flex-shrink: 0;\n    }\n\n    .child-photo {\n      width: 160px;\n      height: 145px;\n      background-color: #b0a070;\n      border-radius: 4px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 12px;\n      color: #555;\n      overflow: hidden;\n    }\n\n    .child-photo-caption {\n      position: absolute;\n      bottom: 0;\n      left: 0;\n      right: 0;\n      background-color: #c8a800;\n      color: #1a1a1a;\n      font-size: 15px;\n      font-weight: bold;\n      text-align: center;\n      padding: 3px 4px;\n    }\n\n    /* watermark text on top section */\n    .watermark-top {\n      position: absolute;\n      top: 50%;\n      left: 50%;\n      transform: translate(-50%, -50%) rotate(-30deg);\n      font-size: 22px;\n      color: rgba(180, 140, 80, 0.35);\n      white-space: nowrap;\n      pointer-events: none;\n      font-weight: bold;\n      letter-spacing: 2px;\n    }\n\n    /* ── Bottom Section (dark navy/slate background) ── */\n    .bottom-section {\n      background-color: #3a3f5c;\n      padding: 22px 22px 20px 22px;\n      position: relative;\n    }\n\n    .bottom-label-row {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      margin-bottom: 16px;\n    }\n\n    .bottom-label {\n      font-size: 26px;\n      font-weight: bold;\n      color: #f0e8d0;\n      white-space: nowrap;\n    }\n\n    .green-check {\n      font-size: 38px;\n      color: #44bb44;\n      font-weight: bold;\n      line-height: 1;\n    }\n\n    .bottom-text {\n      font-size: 15.5px;\n      color: #e8dfc8;\n      line-height: 1.95;\n      text-align: justify;\n    }\n\n    .bottom-citation {\n      text-align: right;\n      font-size: 13px;\n      color: #c8c0a8;\n      margin-top: 12px;\n    }\n\n    /* watermark text on bottom section */\n    .watermark-bottom {\n      position: absolute;\n      top: 50%;\n      left: 50%;\n      transform: translate(-50%, -50%) rotate(-30deg);\n      font-size: 22px;\n      color: rgba(200, 180, 120, 0.18);\n      white-space: nowrap;\n      pointer-events: none;\n      font-weight: bold;\n      letter-spacing: 2px;\n    }\n  </style>\n</head>\n<body>\n\n  <!-- TOP SECTION -->\n  <div class=\"top-section\">\n    <div class=\"watermark-top\">管中窥豹美女纸</div>\n\n    <div class=\"top-label-row\">\n      <span class=\"top-label\">我写的：</span>\n      <span class=\"red-circle\"></span>\n    </div>\n\n    <div class=\"top-content-row\">\n      <div class=\"top-text\">\n        我们民族的追梦史充满<br>艰辛。\n      </div>\n      <div class=\"child-photo-wrapper\">\n        <div class=\"child-photo\">\n          [Photo: crying child in red shirt]\n        </div>\n        <div class=\"child-photo-caption\">学习使我妈快乐</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- BOTTOM SECTION -->\n  <div class=\"bottom-section\">\n    <div class=\"watermark-bottom\">管中窥豹美女纸</div>\n\n    <div class=\"bottom-label-row\">\n      <span class=\"bottom-label\">人民日报写的：</span>\n      <span class=\"green-check\">✔</span>\n    </div>\n\n    <div class=\"bottom-text\">\n      我们这个民族，有数千年辉煌文明、有数百年深重苦难，也有百余年不息奋斗，追寻梦想的道路尤其艰难曲折。百余年来的救亡图存、道路探索，多少仁人志士留下\"有心杀贼，无力回天\"的悲愤，付出\"春云碧血，秋雨黄花\"的牺牲，发出\"拼将十万头颅血，须把乾坤力挽回\"的呐喊。\n    </div>\n\n    <div class=\"bottom-citation\">\n      ——2013.4.1《筑就民族复兴的\"中国梦\"》\n    </div>\n  </div>\n\n</body>\n</html>"
