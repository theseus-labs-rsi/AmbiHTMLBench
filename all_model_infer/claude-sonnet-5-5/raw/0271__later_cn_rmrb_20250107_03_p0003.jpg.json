        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>人民日报 2025年1月7日 星期二 第3版 要闻</title>\n<script>\nwindow.MathJax = { tex: { inlineMath: [['$','$']], displayMath: [['$$','$$']] } };\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\" async></script>\n<style>\n  body {\n    font-family: \"SimSun\", \"Songti SC\", serif;\n    background: #fff;\n    color: #111;\n    margin: 0;\n    padding: 10px 20px;\n    font-size: 12px;\n    line-height: 1.55;\n  }\n  .page {\n    max-width: 1000px;\n    margin: 0 auto;\n  }\n  .masthead {\n    display: flex;\n    justify-content: space-between;\n    align-items: baseline;\n    border-bottom: 3px solid #000;\n    padding-bottom: 4px;\n  }\n  .masthead .logo {\n    font-size: 26px;\n    font-weight: bold;\n    letter-spacing: 2px;\n  }\n  .masthead .date {\n    font-size: 13px;\n  }\n  .masthead .pagenum {\n    font-size: 13px;\n    font-weight: bold;\n  }\n  hr.thin { border: none; border-top: 1px solid #000; margin: 4px 0; }\n\n  .main-grid {\n    display: grid;\n    grid-template-columns: 3fr 1.3fr;\n    gap: 8px;\n    margin-top: 8px;\n  }\n\n  .headline-block { text-align: center; margin-bottom: 6px; }\n  .headline-block h1 {\n    font-size: 24px;\n    font-weight: bold;\n    margin: 4px 0 2px 0;\n  }\n  .headline-block .subtitle {\n    font-size: 13px;\n    margin: 2px 0 6px 0;\n  }\n  .byline {\n    text-align: right;\n    font-size: 11px;\n    margin: 2px 0 6px 0;\n  }\n\n  .columns4 {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    column-gap: 10px;\n    border-top: 1px solid #000;\n    padding-top: 6px;\n    font-size: 11.5px;\n    text-align: justify;\n  }\n  .columns4 p { margin: 0 0 6px 0; text-indent: 1em; }\n  .sec-title {\n    font-weight: bold;\n    font-size: 13px;\n    margin: 8px 0 4px 0;\n    text-indent: 0;\n  }\n\n  /* Right side box