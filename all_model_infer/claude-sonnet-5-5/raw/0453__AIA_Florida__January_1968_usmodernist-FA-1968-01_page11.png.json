        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Organizational Chart - Commissions</title>\n<script type=\"text/javascript\" id=\"MathJax-script\" async\n  src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\">\n</script>\n<style>\n  body {\n    font-family: 'Times New Roman', Times, serif;\n    background: #fff;\n    margin: 0;\n    padding: 40px 20px;\n    position: relative;\n  }\n\n  .chart-container {\n    display: flex;\n    justify-content: space-between;\n    position: relative;\n    padding-top: 60px;\n    max-width: 2150px;\n    margin: 0 auto;\n  }\n\n  /* Top connecting lines */\n  .top-line {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 60px;\n  }\n\n  .top-line .vertical-stub {\n    position: absolute;\n    top: 0;\n    left: 50%;\n    width: 2px;\n    height: 20px;\n    background: #000;\n  }\n\n  .top-line .horizontal-bar {\n    position: absolute;\n    top: 20px;\n    left: 3%;\n    width: 94%;\n    height: 2px;\n    background: #000;\n  }\n\n  .top-line .drop {\n    position: absolute;\n    top: 20px;\n    width: 2px;\n    height: 40px;\n    background: #000;\n  }\n\n  .column {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    width: 19%;\n  }\n\n  .connector {\n    width: 2px;\n    height: 30px;\n    background: #000;\n  }\n\n  .box {\n    border: 2px solid #000;\n    width: 100%;\n    box-sizing: border-box;\n    text-align: center;\n    padding: 15px 10px;\n  }\n\n  .box .title {\n    font-size: 15px;\n    font-weight: normal;\n    text-transform: uppercase;\n    margin-bottom: 10px;\n    line-height: 1.3;\n  }\n\n  .box .name {\n    font-size: 14px;\n    margin: 2px 0;\n  }\n\n  .box .role {\n    font-size: 14px;\n    margin: 2px 0 10px 0;\n  }\n\n  .sub-box {\n    border: 2px solid #000;\n    width: 100%;\n    box-sizing: border-box;\n  }\n\n  .sub-section {\n    border-bottom: 2px solid #000;\n    padding: 12px 14px;\n    text-align: center;\n  }\n\n  .sub-section:last-child {\n    border-bottom: none;\n  }\n\n  .sub-section .heading {\n    font-size: 15px;\n    text-transform: uppercase;\n    margin-bottom: 6px;\n  }\n\n  .sub-section .name {\n    font-size: 14px;\n    margin: 2px 0;\n  }\n\n  .sub-section .role {\n    font-size: 14px;\n    margin: 2px 0 6px 0;\n  }\n\n  .sub-section ol {\n    text-align: left;\n    list-style: lower-alpha;\n    font-size: 13.5px;\n    margin: 6px 0 6px 30px;\n    padding: 0;\n  }\n\n  .sub-section ol li {\n    margin: 2px 0;\n  }\n\n  .empty-space {\n    width: 100%;\n  }\n\n  .footer-lines {\n    margin-top: 60px;\n    display: flex;\n    gap: 200px;\n    padding-left: 10px;\n  }\n\n  .footer-line {\n    width: 150px;\n    height: 1px;\n    background: repeating-linear-gradient(to right, #000 0, #000 4px, transparent 4px, transparent 8px);\n  }\n</style>\n</head>\n<body>\n\n<div class=\"top-line\">\n  <div class=\"vertical-stub\"></div>\n  <div class=\"horizontal-bar\"></div>\n  <div class=\"drop\" style=\"left:3%;\"></div>\n  <div class=\"drop\" style=\"left:26.5%;\"></div>\n  <div class=\"drop\" style=\"left:50%;\"></div>\n  <div class=\"drop\" style=\"left:73.5%;\"></div>\n  <div class=\"drop\" style=\"left:97%;\"></div>\n</div>\n\n<div class=\"chart-container\">\n\n  <!-- Column 1: Professional Society -->\n  <div class=\"column\">\n    <div class=\"box\">\n      <div class=\"title\">Commission on the Professional Society</div>\n      <div class=\"name\">Thomas H. Daniels</div>\n      <div class=\"role\">Chairman</div>\n      <div class=\"name\">Robert J. Boerema</div>\n      <div class=\"role\">Vice Chairman</div>\n    </div>\n    <div class=\"connector\"></div>\n    <div class=\"sub-box\">\n      <div class=\"sub-section\">\n        <div class=\"heading\">Coordination</div>\n        <div class=\"name\">Richard E. Pryor</div>\n        <div class=\"role\">Chairman</div>\n        <ol>\n          <li>Chapter Affairs</li>\n          <li>Student Affairs</li>\n          <li>Membership</li>\n        </ol>\n      </div>\n      <div class=\"sub-section\">\n        <div class=\"heading\">Rules and Regulations</div>\n        <div class=\"name\">Jack West</div>\n        <div class=\"role\">Chairman</div>\n        <ol>\n          <li>Credentials Committee</li>\n          <li>Resolutions Committee</li>\n          <li>Nominating Committee</li>\n        </ol>\n      </div>\n      <div class=\"sub-section\">\n        <div class=\"heading\">Honors and Awards</div>\n        <div class=\"name\">John B. Marion</div>\n        <div class=\"role\">Chairman</div>\n        <ol>\n          <li>Craftsman Awards</li>\n          <li>Student Awards</li>\n          <li>Honor Awards</li>\n        </ol>\n      </div>\n      <div class=\"sub-section\">\n        <div class=\"heading\">Regional Judiciary</div>\n        <div class=\"name\">Walter B. Schultz</div>\n        <div class=\"role\">Chairman</div>\n      </div>\n      <div class=\"sub-section\">\n        <div class=\"heading\">Convention</div>\n        <div class=\"name\">Frank Folsom Smith</div>\n        <div class=\"role\">Chairman</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Column 2: Education and Research -->\n  <div class=\"column\">\n    <div class=\"box\">\n      <div class=\"title\">Commission on Education and Research</div>\n      <div class=\"name\">James E. Garland</div>\n      <div class=\"role\">Chairman</div>\n      <div class=\"name\">John E. Sweet</div>\n      <div class=\"role\">Vice Chairman</div>\n    </div>\n    <div class=\"connector\"></div>\n    <div class=\"sub-box\">\n      <div class=\"sub-section\">\n        <div class=\"heading\">Training</div>\n        <div class=\"name\">John E. Sweet</div>\n        <div class=\"role\">Chairman</div>\n      </div>\n      <div class=\"sub-section\">\n        <div class=\"heading\">Professional Education</div>\n        <div cla