        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Surgical Site Infection Prevention Recommendations</title>\n<script type=\"text/javascript\" id=\"MathJax-script\" async\n  src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    font-family: Arial, Helvetica, sans-serif;\n    background: #fff;\n    margin: 0;\n    padding: 30px 40px;\n    color: #222;\n  }\n  .header {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    margin-bottom: 10px;\n  }\n  .title h1 {\n    font-size: 34px;\n    line-height: 1.1;\n    margin: 0;\n    color: #16205c;\n    font-weight: 900;\n    text-transform: uppercase;\n  }\n  .title h1 span.orange {\n    color: #f39200;\n  }\n  .who-logo {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    margin-top: 10px;\n  }\n  .who-logo img {\n    width: 50px;\n    height: 50px;\n  }\n  .who-text {\n    font-weight: bold;\n    color: #16205c;\n    font-size: 16px;\n    line-height: 1.1;\n  }\n\n  .content-wrap {\n    display: flex;\n    margin-top: 30px;\n    background: linear-gradient(to bottom, #f2f2f2, #d9d9d9);\n    border-radius: 6px;\n    padding: 20px 30px;\n    border-top: 3px solid #16205c;\n    position: relative;\n  }\n\n  .side-label {\n    writing-mode: vertical-rl;\n    transform: rotate(180deg);\n    color: #f39200;\n    font-weight: 900;\n    font-size: 13px;\n    letter-spacing: 0.5px;\n    text-align: center;\n    margin-right: 20px;\n    padding-top: 40px;\n    white-space: nowrap;\n  }\n\n  .main-section {\n    flex: 1;\n    border-left: 3px solid #f39200;\n    padding-left: 30px;\n  }\n\n  .section-title h2 {\n    color: #16205c;\n    font-size: 26px;\n    font-weight: 900;\n    margin: 0 0 2px 0;\n    text-transform: uppercase;\n  }\n  .section-title p {\n    color: #16205c;\n    font-weight: bold;\n    font-size: 12px;\n    margin: 0 0 20px 0;\n    text-transform: uppercase;\n  }\n\n  .col-headers {\n    display: flex;\n    justify-content: flex-end;\n    gap: 60px;\n    margin-bottom: 8px;\n    padding-right: 10px;\n  }\n  .col-headers span {\n    color: #16205c;\n    font-weight: 900;\n    font-size: 13px;\n    text-transform: uppercase;\n    width: 160px;\n    text-align: center;\n  }\n\n  .row {\n    display: flex;\n    align-items: center;\n    border-bottom: 1px solid #bbb;\n    padding: 18px 0;\n    gap: 15px;\n  }\n  .row:last-child { border-bottom: none; }\n\n  .icon-circle {\n    flex: 0 0 90px;\n    width: 90px;\n    height: 90px;\n    border-radius: 50%;\n    border: 3px solid #16205c;\n    background: #fff;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 30px;\n    text-align: center;\n    color: #16205c;\n    overflow: hidden;\n  }\n\n  .text-box {\n    flex: 1;\n    background: #fff;\n    border-radius: 30px;\n    padding: 15px 25px;\n    font-size: 14px;\n    min-height: 60px;\n    display: flex;\n    align-items: center;\n  }\n  .text-box b { display: block; margin-bottom: 2px; }\n  .text-box em { font-size: 12.5px; color: #333; }\n\n  .arrow {\n    flex: 0 0 24px;\n    font-size: 26px;\n    color: #f39200;\n    font-weight: bold;\n    text-align: center;\n  }\n\n  .action-col, .support-col {\n    flex: 0 0 160px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n    gap: 4px;\n  }\n  .support-col {\n    flex: 0 0 200px;\n  }\n  .support-people {\n    display: flex;\n    gap: 8px;\n    justify-content: center;\n  }\n  .person-icon {\n    width: 40px;\n    height: 40px;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 20px;\n    background: #eee;\n  }\n  .label {\n    font-size: 10.5px;\n    font-weight: 900;\n    color: #111;\n    text-transform: uppercase;\n    line-height: 1.2;\n  }\n  .label i {\n    font-weight: normal;\n    font-style: italic;\n  }\n\n  .placeholder {\n    width: 40px;\n    height: 40px;\n    background: #eee;\n    border: 1px dashed #999;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 8px;\n    text-align: center;\n    color: #666;\n    border-radius: 4px;\n  }\n</style>\n</head>\n<body>\n\n<div class=\"header\">\n  <div class=\"title\">\n    <h1>SURGICAL SITE INFECTION<br>PREVENTION <span class=\"orange\">RECOMMENDATIONS</span></h1>\n  </div>\n  <div class=\"who-logo\">\n    <div class=\"placeholder\" style=\"width:55px;height:55px;border-radius:50%;\">[WHO Logo]</div>\n    <div class=\"who-text\">World Health<br>Organization</div>\n  </div>\n</div>\n\n<div class=\"content-wrap\">\n  <div class=\"side-label\">INFECTION PREVENTION<br>AND CONTROL (IPC) TEAM</div>\n\n  <div class=\"main-section\">\n    <div class=\"section-title\">\n      <h2>PREOPERATIVE PERIOD</h2>\n      <p>PATIENT, CLINICAL AND SUPPORT STAFF AND SURGICAL TEAM ACTIONS</p>\n    </div>\n\n    <div class=\"col-headers\">\n      <span>ACTION</span>\n      <span>SUPPORTED BY</span>\n    </div>\n\n    <!-- Row 1 -->\n    <div class=\"row\">\n      <div class=\"icon-circle\">🚿</div>\n      <div class=\"text-box\">\n        <span><b>Patient bathes or showers prior to surgery with either plain or antimicrobial soap</b></span>\n      </div>\n      <div class=\"arrow\">&rsaquo;</div>\n      <div class=\"action-col\">\n        <div class=\"person-icon\">🧑</div>\n        <div class=\"label\">PATIENT</div>\n      </div>\n      <div class=\"support-col\">\n        <div class=\"support-people\">\n          <div class=\"person-icon\">👩‍⚕️</div>\n          <div class=\"person-icon\">🧑‍💼</div>\n          <div class=\"person-icon\">👩</div>\n        </div>\n        <div class=\"label\">SURGICAL TEAM<br>AT PREOPERATIVE CONSULTATION</div>\n      </div>\n    </div>\n\n    <!-- Row 2 -->\n    <div class=\"row\">\n      <div class=\"icon-circle\">💊</div>\n      <div class=\"text-box\">\n        <span><b>Use 2% mupirocin decolonization in known nasal carriers of <i>Staphylococcus aureus</i> in cardiac and orthopaedic surgery</b><br><em>(consider for other surgeries)</em></span>\n      </div>\n      <div class=\"arrow\">&rsaquo;</div>\n      <div class=\"action-col\">\n        <div class=\"person-icon\">👩‍⚕️</div>\n        <div class=\"label\">WARD NURSE</div>\n      </div>\n      <div class=\"support-col\">\n        <div class=\"support-people\">\n          <div class=\"person-icon\">🧔‍♂️</div>\n          <div class=\"placeholder\">[Rx pack]</div>\n        </div>\n        <div class=\"label\">DOCTOR &nbsp; PHARMACY</div>\n      </div>\n    </div>\n\n    <!-- Row 3 -->\n    <div class=\"row\">\n      <div class=\"icon-circle\" style=\"color:#c0392b; font-size:40px;\">✂️❌</div>\n      <div class=\"text-box\">\n        <span><b>Do NOT remove patient hair, or if absolutely necessary, remove with a clipper, do not shave</b></span>\n      </div>\n      <div class=\"arrow\">&rsaquo;</div>\n      <div class=\"action-col\">\n        <div class=\"support-people\">\n          <div class=\"person-icon\">👩‍⚕️</div>\n          <div class=\"person-icon\">👩</div>\n        </div>\n        <div class=\"label\">SURGICAL TEAM</div>\n      </div>\n      <div class=\"support-col\">\n        <div class=\"person-icon\">🧑</div>\n        <div class=\"label\">PATIENT INFORMATION<br>AND EDUCATION</div>\n      </div>\n    </div>\n\n    <!-- Row 4 -->\n    <div class=\"row\">\n      <div class=\"icon-circle\">🕐</div>\n      <div class=\"text-box\">\n        <span><b>Administer surgical antibiotic prophylaxis in the 120 minutes preceding surgical incision</b><br><em>(depending on the type of operation and the half life of the antibiotic)</em></span>\n      </div>\n      <div class=\"arrow\">&rsaquo;</div>\n      <div class=\"action-col\">\n        <div class=\"person-icon\">💉</div>\n        <div class=\"label\">ANAESTHETIST<br>(OR OTHER IN SURGICAL TEAM)</div>\n      </div>\n      <div class=\"support-col\">\n        <div class=\"support-people\">\n          <div class=\"person-icon\">🧑‍💼</div>\n          <div class=\"placeholder\">[Rx pack]</div>\n          <div class=\"person-icon\">👩‍⚕️</div>\n        </div>\n        <div class=\"label\">IPC TEAM/PHARMACY</div>\n      </div>\n    </div>\n\n    <!-- Row 5 -->\n    <div class=\"row\">\n      <div class=\"icon-circle\">🧴</div>\n      <div class=\"text-box\">\n        <span><b>Prepare hands for surgery by scrubbing, using the correct technique with a suitable antimicrobial soap and water OR an alcohol-based handrub</b><br><em>(before donning sterile gloves)</em></span>\n      </div>\n      <div class=\"arrow\">&rsaquo;</div>\n      <div class=\"action-col\">\n        <div class=\"person-icon\">👩‍⚕️</div>\n        <div class=\"label\">SURGEON</div>\n      </div>\n      <div class=\"support-col\">\n        <div class=\"support-people\">\n          <div class=\"placeholder\">[Rx pack]</div>\n          <div class=\"placeholder\" style=\"width:50px;\">[Boxes]</div>\n        </div>\n        <div class=\"label\">PHARMACY/<br>PROCUREMENT</div>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n</body>\n</html>"
