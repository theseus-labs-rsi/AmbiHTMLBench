        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>浙江大学报 - 2018年1月12日</title>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/mathjax/3.2.2/es5/tex-mml-chtml.min.js\" async></script>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  body {\n    font-family: \"SimSun\", \"Songti SC\", \"STSong\", serif;\n    background: #f5f5f5;\n    color: #000;\n    font-size: 14px;\n    line-height: 1.55;\n  }\n  .page {\n    max-width: 1100px;\n    margin: 0 auto;\n    background: #fff;\n    border: 1px solid #ccc;\n    padding-bottom: 20px;\n  }\n  /* ===== TOP HEADER ===== */\n  .top-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    padding: 8px 12px 4px;\n    border-bottom: none;\n  }\n  .logo-area {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n  }\n  .logo-seal {\n    width: 70px;\n    height: 70px;\n    border: 2px solid #c00;\n    border-radius: 50%;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    color: #c00;\n    font-size: 9px;\n    text-align: center;\n    line-height: 1.2;\n    flex-shrink: 0;\n  }\n  .logo-seal .year { font-size: 8px; }\n  .masthead {\n    font-family: \"SimHei\", \"Heiti SC\", sans-serif;\n    font-size: 52px;\n    font-weight: bold;\n    color: #c00;\n    letter-spacing: 6px;\n    line-height: 1.1;\n  }\n  .date-info {\n    text-align: right;\n    font-size: 13px;\n    line-height: 1.6;\n    padding-top: 4px;\n  }\n  .date-info .qr-row {\n    display: flex;\n    gap: 6px;\n    justify-content: flex-end;\n    margin-top: 4px;\n  }\n  .qr-placeholder {\n    width: 48px;\n    height: 48px;\n    background: #eee;\n    border: 1px solid #999;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 9px;\n    color: #666;\n  }\n  .issue-info {\n 