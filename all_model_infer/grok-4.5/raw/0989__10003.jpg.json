grid;\n    grid-template-columns: 1fr 200px 1fr;\n    gap: 10px;\n    font-size: 13px;\n    text-align: justify;\n    line-height: 1.6;\n  }\n  .mid-content p { text-indent: 2em; margin-bottom: 4px; }\n  .mid-content .byline { text-indent: 0; margin-bottom: 4px; }\n  .photo-placeholder {\n    width: 200px;\n    height: 150px;\n    background: #e8e8e8;\n    border: 1px solid #aaa;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    font-size: 12px;\n    color: #555;\n    text-align: center;\n  }\n  .photo-placeholder .caption {\n    margin-top: 4px;\n    font-size: 11px;\n    color: #333;\n  }\n  .sub-heading {\n    font-family: \"SimHei\", \"Heiti SC\", sans-serif;\n    font-size: 15px;\n    font-weight: bold;\n    text-align: center;\n    margin: 8px 0 4px;\n    text-indent: 0 !important;\n  }\n  /* ===== BOTTOM SECTION ===== */\n  .bottom-section {\n    display: grid;\n    grid-template-columns: 240px 1fr;\n    gap: 0;\n    margin-top: 10px;\n    padding: 0 10px;\n    border-top: 2px solid #333;\n    padding-top: 8px;\n  }\n  .bottom-left { padding-right: 10px; border-right: 1px solid #ccc; }\n  .bottom-left h2 {\n    font-family: \"SimHei\", \"Heiti SC\", sans-serif;\n    font-size: 26px;\n    font-weight: bold;\n    text-align: center;\n    letter-spacing: 4px;\n    line-height: 1.4;\n    margin-bottom: 2px;\n  }\n  .bottom-left .sub-title {\n    text-align: center;\n    font-size: 13px;\n    margin-bottom: 6px;\n    color: #333;\n  }\n  .service-badge {\n    display: inline-block;\n    background: #c00;\n    color: #fff;\n    font-size: 12px;\n    padding: 2px 8px;\n    font-family: \"SimHei\", \"Heiti SC\", sans-serif;\n    margin-bottom: 6px;\n  }\n  .bottom-left .article-body {\n    font-size: 12.5px;\n    text-align: justify;\n    line-height: 1.6;\n  }\n  .bottom-left .article-body p { text-indent: 2em; margin-bottom: 4px; }\n  .bottom-left .byline { text-indent: 0; font-size: 12px; }\n  .bottom-right { padding-left: 10px; }\n  .news-ten h2 {\n    font-family: \"SimHei\", \"Heiti SC\", sans-serif;\n    font-size: 22px;\n    font-weight: bold;\n    text-align: center;\n    margin-bottom: 6px;\n    letter-spacing: 2px;\n  }\n  .news-ten .article-body {\n    font-size: 13px;\n    text-align: justify;\n    line-height: 1.6;\n  }\n  .news-ten .article-body p { text-indent: 2em; margin-bottom: 3px; }\n  .news-ten .byline { text-indent: 0; }\n  /* zheng qiang section */\n  .zheng-section {\n    margin-top: 10px;\n    padding: 0 10px;\n    border-top: 2px solid #c00;\n    padding-top: 8px;\n  }\n  .zheng-section h2 {\n    font-family: \"SimHei\", \"Heiti SC\", sans-serif;\n    font-size: 22px;\n    font-weight: bold;\n    text-align: center;\n    letter-spacing: 1px;\n  }\n  .zheng-section .sub-title {\n    text-align: center;\n    font-size: 14px;\n    margin: 4px 0 8px;\n    font-family: \"SimHei\", \"Heiti SC\", sans-serif;\n  }\n  .zheng-body {\n    display: grid;\n    grid-template-columns: 1fr 1fr 1fr;\n    gap: 10px;\n    font-size: 13px;\n    text-align: justify;\n    line-height: 1.6;\n  }\n  .zheng-body p { text-indent: 2em; margin-bottom: 3px; }\n  .zheng-body .byline { text-indent: 0; }\n  /* footer */\n  .page-footer {\n    text-align: center;\n    font-size: 12px;\n    padding: 10px;\n    border-top: 1px solid #999;\n    margin-top: 12px;\n    color: #333;\n  }\n  .continue { color: #666; font-size: 12px; }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <!-- TOP HEADER -->\n  <div class=\"top-header\">\n    <div class=\"logo-area\">\n      <div class=\"logo-seal\">\n        <div>求是创新</div>\n        <div class=\"year\">1897</div>\n        <div>ZHEJIANG<br>UNIVERSITY</div>\n      </div>\n      <div class=\"masthead\">浙江大学报</div>\n    </div>\n    <div class=\"date-info\">\n      <div><strong>2018年1月12日 星期五</strong></div>\n      <div>农历丁酉年十一月廿六</div>\n      <div class=\"qr-row\">\n        <div class=\"qr-placeholder\">[QR]</div>\n        <div class=\"qr-placeholder\">[QR]</div>\n      </div>\n      <div class=\"issue-info\">周报　本期4版<br>总1479(新) 第659期</div>\n    </div>\n  </div>\n\n  <div class=\"red-bar\">\n    <div class=\"left-info\">\n      <span>中共浙江大学委员会主办</span>\n      <span>《浙江大学报》编辑部出版</span>\n    </div>\n    <div>国内统一刊号 CN33-0801(G)</div>\n  </div>\n  <div class=\"url-bar\">\n    <span>网址：http://www.zdxb.zju.edu.cn</span>\n    <span>E-mail:zdxb@zju.edu.cn</span>\n  </div>\n\n  <!-- MAIN BODY -->\n  <div class=\"main-body\">\n    <!-- LEFT COLUMN -->\n    <div class=\"left-col\">\n      <div class=\"vert-title-block\">\n        <div class=\"vert-title\">浙大在全国第四轮学科评估中表现优异</div>\n        <div class=\"vert-sub\">A类学科数全国高校第一，优秀率第二；A+学科数第三</div>\n      </div>\n      <div class=\"left-article\">\n        <p class=\"byline no-indent\">本报讯（记者 吴雅兰 柯溢能）2017年12月28日，教育部学位与研究生教育发展中心公布全国第四轮学科评估结果。浙江大学11个一级学科评为A+、11个一级学科评为A、17个一级学科评为A-，A类学科数全国高校第一，优秀率第二，A+学科数第三。</p>\n        <p>根据本轮学科评估的结果，浙江大学评为A+的一级学科有：0713生态学、0803光学工程、0811控制科学与工程、0812计算机科学与技术、0828农业工程、0835软件工程、0902园艺学、0903农业资源与环境、0904植物保护、1001基础医学、1203农林经济管理；</p>\n        <p>评为A的一级学科有：0502中国语言文学、0502外国语言文学、0802机械工程、0805材料科学与工程、0807动力工程及工程热物理、0814土木工程、0817化学工程与技术、0830环境科学与工程、1007药学、1201管理科学与工程、1204公共管理；</p>\n        <p>评为A-的一级学科有：0201理论经济学、0301法学、0305马克思主义理论、0401教育学、0701数学、0702物理学、0703化学、0710生物学、0808电气工程、0809电子科学与技术、0831生物医学工程、0832食品科学与工程、0901作物学、0906畜牧学、1001基础医学、1202工商管理、1305设计学。</p>\n        <p>教育部学位中心第四轮学科评估在继承前三轮评估经验的基础上，对指标体系、评估方法及结果发布方式等方面进行了多项富有建设性的改革与创新，充分体现了兼顾中国特色与世界一流导向，强化了针对高校人才培养和社会服务贡献水平的多维度评估，能够比较科学地检验学科整体发展状况和人才培养成效，成功地引导高校及社会各界将注意力从转移到学科内涵建设上来。</p>\n        <p>近年来，浙大始终把一流学科建设作为带动一流大学建设事业发展的“牛鼻子”，按照分类统筹、一流牵引、主干强身、交叉驱动、生态优化的方针，着力构建综合交叉的一流学科体系，以人才队伍为核心，不断增强学科发展实力和水平。</p>\n        <p>学校相关负责人表示，浙江大学将深入分析新一轮学科评估结果，进一步凝聚共识，加强学科发展的动态监测、动态评估和动态管理，推动一流学科、人才、科研之间的良性互动，引导师生实现追求办学品质声誉的观念转变，在培养拔尖创新人才、建设顶尖学科、汇聚顶尖学者等方面取得更大突破，形成群峰竞秀、人才辈出的良好局面。</p>\n      </div>\n    </div>\n\n    <!-- RIGHT COLUMN -->\n    <div class=\"right-col\">\n      <div class=\"big-headline\">\n        <h1>浙江大学首获国家科技进步奖特等奖</h1>\n        <div class=\"sub-head\">同时首次以第一完成单位获得国家技术发明奖一等奖</div>\n      </div>\n\n      <div class=\"party-banner\">\n        <div class=\"hammer\">☭</div>\n        <div class=\"banner-text\">\n          <div class=\"line1\">贯彻十九大　创造新业绩</div>\n          <div class=\"line2\">新时代　新征程</div>\n        </div>\n      </div>\n\n      <div class=\"two-col-article\">\n        <div>\n          <p class=\"byline\">本报讯（记者 吴雅兰 柯溢能）1月8日上午，中共中央、国务院在北京人民大会堂隆重举行国家科学技术奖励大会，对我国科学技术进步、经济社会发展、国防现代化建设作出突出贡献的科学技术人员和组织给予奖励。此次奖励大会上，我校作为第一完成单位荣获科学技术进步奖特等奖1项、技术发明奖一等奖1项、二等奖1项，科学技术进步奖二等奖1项；我校</p>\n          <p>蔡天新老师荣获科技进步奖二等奖（科普组）1项。</p>\n          <p>浙江大学传染病诊治国家重点实验室、感染性疾病诊治协同创新中心主任李兰娟院士领衔，联合中国疾病预防控制中心、汕头大学、香港大学、复旦大学等11家单位组成的项目组，取得了六项重大创新和技术突破，创建了新发突发传染病防治的“中国方案”和“中国技术”，成功控制了人</p>\n        </div>\n        <div>\n          <p>感染H7N9禽流感，避免了类似SARS的悲剧重演，有效阻击了MERS、寨卡等传染病的输入传播，成功援助非洲控制埃博拉疫情。“以防控人感染H7N9禽流感为代表的新发传染病防治体系重大创新和技术突破”项目获2017年度国家科学技术进步奖特等奖。这是该奖项设立以来，我国医药卫生行业和高等教育领域的“零的突破”，也是首次花落浙江。</p>\n          <p>浙江大学能源工程学院高翔教授领衔，与浙江省能源集团有限公司合作的“燃煤机组超低排放关键技术研发及应用”项目获国家技术发明奖一等奖，这是浙江大学首次</p>\n          <p>以第一完成单位获得该奖项，也是浙江省的第一个国家技术发明奖一等奖。</p>\n          <p>浙江大学生物医学工程与仪器科学学院陈耀武教授领衔的“超高速数码喷印设备关键技术研发及应用”获国家技术发明奖二等奖。</p>\n          <p>浙江大学数学科学学院严建华教授领衔的“危险废物回转式多段热解焚烧及污染物协同控制关键技术”获国家科学技术进步奖二等奖。</p>\n          <p>浙江大学数学科学学院蔡天新教授撰写的科普作品《数学传奇——那些难以企及的人物》获国家科学技术进步奖二等奖。</p>\n          <p class=\"note\">（详情请见本报前三版解读）</p>\n        </div>\n      </div>\n\n      <!-- MID SECTION -->\n      <div class=\"mid-section\">\n        <div class=\"mid-headline\">\n          <h2>中国新发传染病防治从跟随到领跑世界</h2>\n          <div class=\"sub\">——记国家科学技术进步奖特等奖项目“以防控人感染H7N9禽流感为代表的新发传染病防治体系重大创新和技术突破”</div>\n        </div>\n        <div class=\"mid-content\">\n          <div>\n            <p class=\"byline\">本报记者　柯溢能</p>\n            <p>这是一个没有硝烟的战场，浙江大学医学院附属第一医院李兰娟院士带领团队再一次发生战斗。他们要做的，是控制疫情大流行，把患者从死亡线上拉回来。</p>\n            <p>2013年春，长三角地区突发不明原因呼吸道传染病，来势凶猛，病死率高，一度造成社会恐慌。</p>\n            <p>5天内，项目组团队迅速发现并确认了此次突发疫情病原是一种全新的H7N9禽流感病毒，第一时间向全世界公布了该病毒全基因组序列。</p>\n            <p>病原发现后2天内，成功研发人感染H7N9禽流感病毒快速检测试剂。</p>\n            <p>一个月内揭示活禽市场是人感染H7N9禽流感病毒的源头……</p>\n            <p>这一年，恰是2003年SARS过去的第十个年头。</p>\n            <p>在SARS惨痛教训后，我国加大了对传染病防控体系的建设，将重大传染病防治专项作为“十一五”以来的16个重大专项之一，并列入《国家中长期科学和技术发展规划纲要》，浙江大学汇集力量建设传染病</p>\n          </div>\n          <div>\n            <div class=\"photo-placeholder\">\n              [Photo: 李兰娟等科研人员]\n              <div class=\"caption\">卢绍庆　摄</div>\n            </div>\n            <p style=\"text-indent:0;margin-top:6px;font-size:12px;\">诊治国家重点实验室。</p>\n            <p>2018年春天来临之际，由浙江大学传染病诊治国家重点实验室、感染性疾病诊治协同创新中心主任李兰娟院士领衔，联合中国疾病预防控制中心、汕头大学、香港大学、复旦大学等11家单位组成的团队，共同完成的“以防控人感染H7N9禽流感为代表的新发传染病防治体系重大创新和技术突破”项目获得2017年度国家科学技术进步奖特等奖。</p>\n            <p>这是该奖项设立以来，我国医</p>\n          </div>\n          <div>\n            <p>药卫生行业和高等教育领域“零的突破”，也是首次花落浙江。</p>\n            <p class=\"sub-heading\">明确病因，不重蹈<br>十年前SARS的“覆辙”</p>\n            <p>2013年春，长三角地区发现呼吸道危重病人，病死率高，病因不清。</p>\n            <p>该传染病的病原是什么，传染源是什么，通过什么途径传播，如何开展救治？</p>\n            <p>疫情刚出现，李兰娟团队就第</p>\n            <p>一时间凝练出关键科学问题，明确攻克方向。李兰娟知道，十年前SARS疫情爆发因为迟迟不能明确病原和传染源，导致中国在防控SARS疫情上处于被动状态。这一次突发疫情，仅用了五天时间，就确定这一新的传染病病原体为新型H7N9禽流感病毒。《自然》杂志发表社论：中国具有同美国一样的发现确认新发传染病的能力。</p>\n            <p>2003年SARS后，覆盖全国31个省市自治区的全球最大的新发突发传染病监测网络已经逐步建立，对随时可能出现的新发病原体进行实时监控，实现了在72小时内可以完成对300种病原的检测。在新型人感染H7N9禽流感爆发的第一时间，李兰娟院士团队立即组建了一支30多人的采样小组前往疫情相关各地采样寻找传染源。</p>\n            <p>项目组成员沿着候鸟迁徙的路线，深入各种人迹罕至的栖息地，当他们穿过一片白鹭林时，候鸟受惊飞起射下了“粪雨”，但他们却如获至宝，掉下来的都是可供继续研究的样本，这些鸟粪中可能正含有他们所要找的病毒。</p>\n            <p class=\"continue\">项目组还对病人进入（下转2版）</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- BOTTOM SECTION -->\n  <div class=\"bottom-section\">\n    <div class=\"bottom-left\">\n      <h2>安居暖心<br>聚力一流</h2>\n      <div class=\"sub-title\">浙江大学人才专项房紫金西苑开始交房</div>\n      <div class=\"service-badge\">服务发展<br>争创一流</div>\n      <div class=\"article-body\">\n        <p class=\"byline\">本报讯（记者 周亦颖）在浙江大学紫金港校区西区以西，一幢幢现代化的楼房拔地而起，正等待着新主人。1月4日上午，浙江大学人才专项房紫金西苑交付入住工作会在紫金西苑小区举行。</p>\n        <p>校党委书记邹晓东，杭州市副市长缪承潮出席工作会并讲话。校长吴朝晖，发展委员会主席金德水，常务副校长任少波，党委副书记胡旭阳、西溪区委书记章根明等出席工作会，并为业主代表送上入户钥匙。</p>\n        <p>据了解，紫金西苑为浙江大学西湖区块人才房，是“1250安居工程”的组成部分之一，与紫金港校区西区隔路相望，紧邻学军中学紫金港校区。该项目总建筑面积44万平方米，地上面积约31万平方米，共建成住宅2320套。</p>\n        <p>邹晓东表示，人才房是教职工安居乐业的重要保障，是学校改革发展的重要支撑。通过实施“1250安居工程”，浙江大学对海</p>\n        <p>内外英才的吸引力进一步提升，“心齐、气顺、劲足、实干”的良好氛围进一步巩固。接下来，学校将继续深入贯彻落实党的十九大和学校第十四次党代会精神，坚持以人民为中心的思想和师生为本的办校理念，深入推进教师公寓建设和管理服务提升，确保每一位教职工住有所居。</p>\n        <p>缪承潮说，在人才房的建设过程中，杭州市和西湖区各级有关部门给予了重点支持。希望浙江大学积极发挥人才优势，继续将“求是创新”的血液融入杭州城市发展，为市校合作谱写新篇章，为建设智慧杭州、决胜全面建成小康社会作出新的更大贡献。</p>\n        <p>“今天办好入住手续后，我们都有了自己的房子，我们要好好珍惜这份‘新年礼物’，潜心科研和教学工作，为浙江大学建设成为中国特色世界一流大学作出自己的贡献。”教师业主代表、航空航天学院教授王杰说。</p>\n        <p>交付入住工作会后，业主代表们参观了紫金西苑小区。省建设投资集团有限公司、省直房改办、学校相关职能部门负责人和专项房承建单位负责人出席交付入住工作会。</p>\n      </div>\n    </div>\n\n    <div class=\"bottom-right\">\n      <div class=\"news-ten\">\n        <h2>2017年度校园十大新闻出炉</h2>\n        <div class=\"article-body\">\n          <p class=\"byline\">本报讯　2017年12月29日，本报遴选出浙江大学2017年度校园十大新闻候选条目29条。经过读者投票和专家评选，评出浙江大学</p>\n          <p>2017年度校园十大新闻。十大新闻按时间先后顺序依次为：</p>\n          <p>1、9项成果获国家科学技术奖；2、中央第四巡视组专项巡</p>\n          <p>视浙江大学党委工作；3、获知名企业大额捐赠；4、建校120周年纪念大会举行，校庆前夕，刘延东来校调研并看望慰问师生；5、中</p>\n          <p>共中央决定邹晓东任浙江大学党委书记；6、入选一流大学建设高校；7、兴起学习贯彻党的十九大精神热潮；8、姚玉峰入选第六届全国道德模范；9、吴朝晖蝉联仁朱利叶茨奖当选两院院士；10、第十四次党代会召开，选举产生新一届党委和纪委。</p>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ZHENG QIANG SECTION -->\n  <div class=\"zheng-section\">\n    <h2>郑强获授“贵州省高等教育发展特别贡献奖”</h2>\n    <div class=\"sub-title\">在贵州大学设立学生奖助学基金，已募资金1000万</div>\n    <div class=\"zheng-body\">\n      <div>\n        <p class=\"byline\">本报讯（记者 柯溢能）1月5日上午，贵州省授予郑强教授“贵州省高等教育发展特别贡献奖”暨学生奖助学基金捐赠设立仪式在贵州大学举行。</p>\n        <p>仪式上，浙江大学党委副书记、贵州大学原校长郑强将“贵州省高等教育发展特别贡献奖”50万元奖励捐赠给贵州大学，设立学生奖助学基金，并以个人名义在全国范围发起募筹，该基金目前募资资金已达1000万元。</p>\n        <p>贵州省委书记孙志刚祝基金启动仪式取得圆满成功，对郑强同志将省委、省政府奖励的“贵州省高等教育发展特别贡献奖”奖金全部捐赠给贵州大学并设立学生奖助学基金，予以肯定和表扬。他指出，郑强同志在贵州工作的5年时</p>\n      </div>\n      <div>\n        <p>间，积极为贵州教育乃至西部教育鼓与呼，为贵州大学“双一流”建设作出了重要贡献。希望一如既往发扬浙大西迁精神，继续关心支持贵州和贵州大学发展，更好发挥桥梁纽带作用，推动浙江大学对口支援贵州大学取得更加丰硕的成果，为贵州谱写新时代新篇章作出新的更大的贡献。</p>\n        <p>贵州省副省长陈鸣明、何力，省人大常委会原党组书记、原主任龙超云，贵州大学党委书记、校长陈坚参加仪式。浙江大学副校长罗建红，浙江大学发展委员会副主任何凡学应邀出席仪式，捐赠企业、个人代表、师生代表共300余人参加仪式。</p>\n        <p>2012年至2017年，郑强担任贵州大学校长期间，深受该校广大师生爱戴，为贵州大学的发展做出</p>\n      </div>\n      <div>\n        <p>了大量富有成效的工作，积极为贵州以及中西部高等教育事业奔走呼吁，传递贵州、贵州大学的发展好声音。为奖励郑强教授做出的贡献，2017年11月，贵州省决定授予郑强教授“贵州省高等教育发展特别贡献奖”荣誉并给予50万元人民币奖励。</p>\n        <p>仪式上，陈鸣明向郑强颁发荣誉证书。陈鸣明表示，郑强把东部发达地区浙江大学先进的办学理念、办学模式有机融入贵州大学，高质量地完成了各项工作，为西部教育的发展作出了重要贡献。学生奖助学基金的设立，体现了郑强心系教育、情系贵州的情怀，希望贵州大学管好用好该基金，为开启百姓富生态美的多彩贵州新未来做出更大贡献；希望同学们怀家国、感恩社</p>\n        <p>会、奋发有为，成长为担当民族复兴大任的时代新人。</p>\n        <p>“得知获奖的消息后，便决定将贵州省奖励的50万元悉数捐赠，希望能抛砖引玉，吸引更多爱心人士关爱浙大学子。”郑强表示，自己沿着浙大西迁的历史路径经贵州，内心充满的是感恩，5年贵州大学工作成为一生难忘的经历。50万元不算多，但对贫困学生来说就是继续学习的加速器和加油站，他同时向为该基金注入爱心的相关企业和爱心人士表示感谢。他说，从50到1000万，自己是一粒小小的种子，愿继续为贵州广大青年、贵大广大学生的成长、浙江大学与贵州大学的友情作出应有的贡献。</p>\n        <p>中国一汽动力合作处处相关负责人参加了上述活动。</p>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"page-footer\">\n    责任编辑　陆华兴\n  </div>\n\n</div>\n</body>\n</html>",
