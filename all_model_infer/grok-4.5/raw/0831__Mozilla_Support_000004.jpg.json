: #5b5b66; }\n  .article-meta .updated strong { font-weight: 700; color: #0c0c0d; }\n  \n  /* Sidebar */\n  .sidebar h3 { font-size: 16px; font-weight: 700; margin-bottom: 16px; color: #1a1a2e; }\n  .topics-list { list-style: none; margin-bottom: 32px; }\n  .topics-list li { padding: 8px 12px; font-size: 14px; color: #0c0c0d; border-radius: 4px; margin-bottom: 2px; }\n  .topics-list li.active { background: #e8e8e8; font-weight: 600; }\n  .topics-list li a { color: #0c0c0d; }\n  \n  .ask-card { background: #1a1a2e; color: #fff; border-radius: 12px; padding: 28px 24px; text-align: center; }\n  .ask-card .ask-icon { font-size: 20px; margin-bottom: 8px; }\n  .ask-card h4 { font-size: 16px; font-weight: 700; margin-bottom: 10px; }\n  .ask-card p { font-size: 13px; color: #c0c0c8; margin-bottom: 18px; line-height: 1.4; }\n  .ask-card .continue-btn { background: #0060df; color: #fff; border: none; padding: 10px 28px; border-radius: 4px; font-size: 14px; font-weight: 600; cursor: pointer; }\n</style>\n</head>\n<body>\n\n<!-- Top Navigation -->\n<nav class=\"top-nav\">\n  <div class=\"logo-area\">\n    <div class=\"moz-logo\">M</div>\n    Mozilla<br>Support\n  </div>\n  <ul class=\"nav-links\">\n    <li><a href=\"#\">Explore Help Articles</a></li>\n    <li><a href=\"#\">Community Forums</a></li>\n    <li><a href=\"#\">Ask a Question</a></li>\n    <li><a href=\"#\">Contribute</a></li>\n  </ul>\n  <button class=\"sign-in-btn\">Sign In/Up</button>\n</nav>\n\n<!-- Breadcrumb + Search -->\n<div class=\"sub-header\">\n  <div class=\"breadcrumb\">Home / Firefox / Privacy and security</div>\n  <div class=\"search-box\">\n    <input type=\"text\" placeholder=\"Search questions, arti\" />\n    <span class=\"search-icon\">🔍</span>\n  </div>\n</div>\n\n<!-- Main Content -->\n<div class=\"main-wrapper\">\n  <div class=\"content-area\">\n    <!-- Firefox branding row -->\n    <div class=\"fx-header\">\n      <div>\n        <div class=\"fx-logo-placeholder\"></div>\n      </div>\n      <div class=\"download-section\">\n        <button class=\"download-btn\">Download Firefox</button>\n        <div class=\"download-links\">\n          <a href=\"#\">Systems and Languages</a>\n          <a href=\"#\">What's New</a>\n          <a href=\"#\">Privacy</a>\n        </div>\n      </div>\n    </div>\n\n    <h1>Privacy and security</h1>\n    <p class=\"page-desc\">Learn how to protect your privacy and secure your data.</p>\n\n    <!-- Tabs -->\n    <div class=\"tabs\">\n      <div class=\"tab active\">All articles and threads</div>\n      <div class=\"tab\">Tracking protection</div>\n      <div class=\"tab\">Encryption</div>\n      <div class=\"tab\">Security</div>\n    </div>\n\n    <!-- Articles -->\n    <div class=\"article\">\n      <div class=\"article-title-row\">\n        <span class=\"doc-icon\">📄</span>\n        <h2>Use built-in VPN in Firefox</h2>\n      </div>\n      <p class=\"desc\">Learn how to activate and use the built-in VPN feature in Firefox to protect your browsing.</p>\n      <div class=\"article-meta\">\n        <span class=\"tag\">Firefox</span>\n        <span class=\"pencil\">✏️</span>\n        <span class=\"updated\"><strong>Last updated:</strong> 1 day ago</span>\n      </div>\n    </div>\n\n    <div class=\"article\">\n      <div class=\"article-title-row\">\n        <span class=\"doc-icon\">📄</span>\n        <h2>Common Myths about Private Browsing</h2>\n      </div>\n      <p class=\"desc\">Learn more about common misconceptions about Private Browsing in Firefox.</p>\n      <div class=\"article-meta\">\n        <span class=\"tag\">Firefox</span>\n        <span class=\"pencil\">✏️</span>\n        <span class=\"updated\"><strong>Last updated:</strong> 11/3/25</span>\n      </div>\n    </div>\n\n    <div class=\"article\">\n      <div class=\"article-title-row\">\n        <span class=\"doc-icon\">📄</span>\n        <h2>Avoid and report Mozilla tech support scams</h2>\n      </div>\n      <p class=\"desc\">Mozilla does not provide telephone support and does not charge for software downloads, upgrades or technical help. Learn more.</p>\n      <div class=\"article-meta\">\n        <span class=\"tag\">Firefox, Firefox for Android, Firefox for iOS,...</span>\n        <span class=\"pencil\">✏️</span>\n        <span class=\"updated\"><strong>Last updated:</strong> 2/3/25</span>\n      </div>\n    </div>\n\n    <div class=\"article\">\n      <div class=\"article-title-row\">\n        <span class=\"doc-icon\">📄</span>\n        <h2>Insecure connection password warning in Firefox</h2>\n      </div>\n      <p class=\"desc\">Firefox will show you a \"connection is not secure\" warning message when a website login page is insecure and information could be stolen.</p>\n      <div class=\"article-meta\">\n        <span class=\"tag\">Firefox</span>\n        <span class=\"pencil\">✏️</span>\n        <span class=\"updated\"><strong>Last updated:</strong> 3/19/26</span>\n      </div>\n    </div>\n\n    <div class=\"article\">\n      <div class=\"article-title-row\">\n        <span class=\"doc-icon\">📄</span>\n        <h2>Third-party trackers</h2>\n      </div>\n      <p class=\"desc\">Learn about cross-site (third-party) cookies that collect information to track your browsing, which are used on many websites.</p>\n      <div class=\"article-meta\">\n        <span class=\"tag\">Firefox</span>\n        <span class=\"pencil\">✏️</span>\n        <span class=\"updated\"><strong>Last updated:</strong> 10/26/24</span>\n      </div>\n    </div>\n\n    <div class=\"article\">\n      <div class=\"article-title-row\">\n        <span class=\"doc-icon\">📄</span>\n        <h2>Does Firefox share my location with websites?</h2>\n      </div>\n      <p class=\"desc\">Learn what information Firefox sends to websites about your location and how to use and manage location-aware features of your browser.</p>\n      <div class=\"article-meta\">\n        <span class=\"tag\">Firefox</span>\n        <span class=\"pencil\">✏️</span>\n        <span class=\"updated\"><strong>Last updated:</strong> 3/22/26</span>\n      </div>\n    </div>\n\n    <div class=\"article\">\n      <div class=\"article-title-row\">\n        <span class=\"doc-icon\">📄</span>\n        <h2>Configure DNS over HTTPS protection levels in Firefox</h2>\n      </div>\n      <p class=\"desc\">DNS over HTTPS (DoH) is a recommended feature that enhances privacy. Learn more about the DoH protection levels you can configure in Firefox settings.</p>\n      <div class=\"article-meta\">\n        <span class=\"tag\">Firefox</span>\n        <span class=\"pencil\">✏️</span>\n        <span class=\"updated\"><strong>Last updated:</strong> 3/27/25</span>\n      </div>\n    </div>\n\n    <div class=\"article\">\n      <div class=\"article-title-row\">\n        <span class=\"doc-icon\">📄</span>\n        <h2>Enhanced Tracking Protection in Firefox for desktop</h2>\n      </div>\n    </div>\n\n  </div>\n\n  <!-- Sidebar -->\n  <aside class=\"sidebar\">\n    <h3>Popular Firefox Topics</h3>\n    <ul class=\"topics-list\">\n      <li><a href=\"#\">Backup, recovery, and sync</a></li>\n      <li><a href=\"#\">Browse</a></li>\n      <li><a href=\"#\">Performance and connectivity</a></li>\n      <li><a href=\"#\">Accessibility</a></li>\n      <li><a href=\"#\">Download and save</a></li>\n      <li><a href=\"#\">Search, tag, and share</a></li>\n      <li><a href=\"#\">Installation and updates</a></li>\n      <li><a href=\"#\">Settings</a></li>\n      <li class=\"active\">Privacy and security</li>\n      <li><a href=\"#\">Passwords and sign in</a></li>\n    </ul>\n\n    <div class=\"ask-card\">\n      <div class=\"ask-icon\">✏️</div>\n      <h4>Ask a Question</h4>\n      <p>Still need help? Sign in to ask your question on our forums.</p>\n      <button class=\"continue-btn\">Continue</button>\n    </div>\n  </aside>\n</div>\n\n</body>\n</html>",
