%; }\n  .ring-label {\n    margin-top: 10px;\n    text-align: center;\n  }\n  .ring-label .main-title {\n    font-size: 32px;\n    font-weight: 900;\n    color: #1a1a1a;\n    letter-spacing: 2px;\n  }\n  .ring-label .sub-title {\n    display: inline-block;\n    background: #1a1a1a;\n    color: #c8f000;\n    font-size: 14px;\n    font-weight: 700;\n    padding: 2px 10px;\n    border-radius: 2px;\n    margin-top: 2px;\n  }\n  .left-bottom {\n    background: #d4ff00;\n    padding: 10px 12px 16px;\n  }\n  .info-box {\n    background: #fff;\n    border: 2px solid #1a1a1a;\n    border-radius: 4px;\n    padding: 8px 10px;\n    font-size: 12px;\n    line-height: 1.6;\n    color: #1a1a1a;\n  }\n  .info-box .info-title {\n    font-weight: 900;\n    font-size: 14px;\n    margin-bottom: 4px;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n  }\n  .info-box .icons { font-size: 14px; }\n  .but-section {\n    margin-top: 12px;\n    text-align: left;\n  }\n  .but-section .but {\n    font-size: 22px;\n    font-weight: 900;\n    color: #1a1a1a;\n  }\n  .but-section .winner {\n    font-size: 16px;\n    font-weight: 800;\n    color: #1a1a1a;\n    margin: 4px 0;\n  }\n  .but-section .reward {\n    font-size: 15px;\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n  .but-section .excl {\n    font-size: 18px;\n    font-weight: 900;\n    letter-spacing: 2px;\n  }\n  .but-section .how {\n    font-size: 20px;\n    font-weight: 900;\n    color: #1a1a1a;\n    margin-top: 6px;\n    border-bottom: 3px solid #1a1a1a;\n    display: inline-block;\n  }\n  .black-bar {\n    height: 14px;\n    background: #1a1a1a;\n    margin-top: 10px;\n    border-radius: 2px;\n    width: 70%;\n  }\n  /* RIGHT COLUMN */\n  .right-col {\n    display: flex;\n    flex-direction: column;\n  }\n  .right-top {\n    background: #7c3aed;\n    padding: 20px 10px;\n    min-height: 200px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    position: relative;\n    overflow: hidden;\n  }