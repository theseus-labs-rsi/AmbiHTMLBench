>\n\n      <!-- 财务管理 -->\n      <div class=\"group-row\">\n        <div class=\"group-label blue\">财务管理</div>\n        <div class=\"group-body blue-border\">\n          <div class=\"detail-row\">\n            <span class=\"detail-label blue\">含义：</span>\n            <span class=\"detail-text\">指学校资金运转中的计划组织和控制。</span>\n          </div>\n          <div class=\"detail-row\">\n            <span class=\"detail-label blue\">内容</span>\n            <span class=\"detail-text\" style=\"border-left: 2px solid #1a3a8a; padding-left: 10px; margin-left: 4px;\">\n              <div class=\"detail-row\">\n                <span class=\"detail-label blue\">预算管理：</span>\n                <span class=\"detail-text\">按一定程序和方法核定的年度收支预计；</span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"detail-label blue\">收入管理：</span>\n                <span class=\"detail-text\">对学校收入的计划组织和控制，包括财政收入、经营收入、学杂费等收入；</span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"detail-label blue\">支出管理：</span>\n                <span class=\"detail-text\">经费支出的计划组织和控制；</span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"detail-label blue\">资金管理：</span>\n                <span class=\"detail-text\">现金、银行存款、往来管理；</span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"detail-label blue\">财务报表：</span>\n                <span class=\"detail-text\">收支、因素、结果分析；</span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"detail-label blue\">财务制度和财务监督：</span>\n                <span class=\"detail-text\">财务人员要求：持证上岗、坚持原则、对作风正派、履行职责；<span class=\"underline-text\">财务监督通过财务审计执行</span>。</span>\n              </div>\n            </span>\n          </div>\n        </div>\n      </div>\n\n    </div>\n  </div>\n\n  <!-- Chapter 10 -->\n  <div class=\"chapter-block\">\n    <div class=\"vertical-title green\">第十章 学校德育管理</div>\n    <div class=\"chapter-body\">\n\n      <!-- 地位与特点 -->\n      <div class=\"group-row\">\n        <div class=\"group-label green\">地位与特点</div>\n        <div class=\"group-body green-border\">\n          <div class=\"detail-row\">\n            <span class=\"detail-label green\">含义：</span>\n            <span class=\"detail-text\"><span class=\"underline-text\">德育</span>即思想品德教育（<span class=\"underline-text\">育德</span>），包括政治教育、思想教育、品德教育、<span class=\"underline-text\">法治教育</span>、心理教育。<span class=\"underline-text\">德育管理</span>：即德育管理者运用方法手段，…资源，……目标。</span>\n          </div>\n          <div class=\"detail-row\">\n            <span class=\"detail-label green\">地位</span>\n            <span class=\"detail-text\">（<span class=\"underline-text\">学校管理与德育的关系</span>）：学校管理包含德育管理；相互影响；相互渗透；相互促进。</span>\n          </div>\n          <div class=\"detail-row\">\n            <span class=\"detail-label green\">特点：</span>\n            <span class=\"detail-text\">方向性；教育性；伦理性；全负性。</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- 要素与层次 -->\n      <div class=\"group-row\">\n        <div class=\"group-label green\">要素与层次</div>\n        <div class=\"group-body green-border\">\n          <div class=\"detail-row\">\n            <span class=\"detail-label green\">要素</span>\n            <span class=\"detail-text\" style=\"border-left: 2px solid #1a6a3a; padding-left: 10px; margin-left: 4px;\">\n              <div class=\"detail-row\">\n                <span class=\"detail-text\">德育管理<span class=\"underline-text\">目标</span>：具有定向、调节、评价作用；</span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"detail-text\">德育管理<span class=\"underline-text\">主体</span>：组织管理；管理者；自我管理；</span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"detail-text\">德育管理<span class=\"underline-text\">客体</span>：人、财、物、课程、时空等资源；</span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"detail-text\">德育管理<span class=\"underline-text\">制度</span>：中央到地方文件，学校与班级的规章；</span>\n              </div>\n            </span>\n          </div>\n          <div class=\"detail-row\">\n            <span class=\"detail-label green\">层次</span>\n            <span class=\"detail-text\"><span class=\"underline-text\">学校上层</span>是核心定方向；<span class=\"underline-text\">学校中层</span>是枢纽抓落实；<span class=\"underline-text\">学校基层</span>及班级是基本单位执行者。</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- 机制与实施 -->\n      <div class=\"group-row\">\n        <div class=\"group-label green\">机制与实施</div>\n        <div class=\"group-body green-border\">\n          <div class=\"detail-row\">\n            <span class=\"detail-label green\">机制：</span>\n            <span class=\"detail-text\">德育要素进行相互作用、耦合、联系的运作方式。</span>\n          </div>\n          <div class=\"detail-row\">\n            <span class=\"detail-label green\">实施</span>\n            <span class=\"detail-text\" style=\"border-left: 2px solid #1a6a3a; padding-left: 10px; margin-left: 4px;\">\n              <div class=\"detail-row\">\n                <span class=\"detail-label green\">导向机制：</span>\n                <span class=\"detail-text\">目标、舆论、行为、评价等导向；</span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"detail-label green\">动力机制：</span>\n                <span class=\"detail-text\">奖惩、竞争、意义或价值等激励；</span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"detail-label green\">协调机制：</span>\n                <span class=\"detail-text\">制度、文化协调；</span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"detail-label green\">约束机制：</span>\n                <span class=\"detail-text\">法规、道德约束。</span>\n              </div>\n            </span>\n          </div>\n        </div>\n      </div>\n\n    </div>\n  </div>\n\n  <!-- Bottom note -->\n  <div class=\"bottom-t