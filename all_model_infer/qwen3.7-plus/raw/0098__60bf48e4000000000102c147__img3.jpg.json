100px;\n    text-align: center;\n    line-height: 100px;\n    font-size: 36px;\n    font-weight: bold;\n    color: #CC0000;\n    margin-left: 20px;\n    vertical-align: middle;\n    transform: rotate(-5deg);\n  }\n  .bottom-row {\n    display: flex;\n    align-items: center;\n  }\n  .bottom-row .avoid-content {\n    flex: 1;\n  }\n  .bottom-row .not-recommend-box {\n    flex-shrink: 0;\n    margin-left: 10px;\n  }\n  .not-recommend-circle {\n    border: 3px solid #CC0000;\n    border-radius: 50%;\n    width: 140px;\n    height: 110px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 38px;\n    font-weight: bold;\n    color: #CC0000;\n    transform: rotate(-8deg);\n  }\n</style>\n</head>\n<body>\n\n<div class=\"title-bar\">\n  去张家界<span class=\"red\">6</span>次整理<span class=\"red\">8</span>千字干货\n</div>\n<div class=\"subtitle-bar\">\n  景点篇（含门票信息+景点介绍）\n</div>\n\n<table class=\"main-table\">\n  <tr>\n    <td class=\"category-cell\">\n      五星<br>推荐<br>景点\n    </td>\n    <td class=\"content-cell\">\n      <div class=\"item\"><span class=\"name\">1.张家界国家森林公园</span> <span class=\"price\">（门票：225）</span> <span class=\"desc\">必去景点，门票可玩4天</span></div>\n      <div class=\"item\"><span class=\"name\">2.哈利路亚山</span> <span class=\"price\">（门票：免费）</span> <span class=\"desc\">阿凡达取景地，一定要去打卡</span></div>\n      <div class=\"item\"><span class=\"name\">3.鬼谷栈道</span> <span class=\"price\">（门票：免费）</span> <span class=\"desc\">在天门山景区内，立在万丈悬崖边上</span></div>\n      <div class=\"item\"><span class=\"name\">4.玻璃栈道</span> <span class=\"price\">（门票：免费）</span> <span class=\"desc\">天门山内，悬于峭壁之上，勇敢者的游戏</span></div>\n      <div class=\"item\"><span class=\"name\">5.十里画廊</span> <span class=\"price\">（门票：免费）</span> <span class=\"desc\">两侧风景很美，到了张家界一定要去</span></div>\n      <div class=\"item\"><span class=\"name\">6.金鞭溪</span> <span class=\"price\">（门票：免费）</span> <span class=\"desc\">有很多野生猴子，看好自己的吃食哦</span></div>\n      <div class=\"item\"><span class=\"name\">7.黄龙洞</span> <span class=\"price\">（门票：100）</span> <span class=\"desc\">有世界溶洞全能冠军称号，可以去看看</span></div>\n      <div class=\"item\"><span class=\"name\">8.天门山国家森林公园</span> <span class=\"price\">（门票：275）</span> <span class=\"desc\">天门洞、空中寺庙、盘山公路</span></div>\n      <div class=\"item\"><span class=\"name\">9.大峡谷玻璃桥</span> <span class=\"price\">（门票：138）</span> <span class=\"desc\">全国玻璃桥的鼻祖，很长很刺激</span></div>\n      <div class=\"item\"><span class=\"name\">10.张家界大峡谷</span> <span class=\"price\">（门票：118）</span> <span class=\"desc\">一线天天梯栈道、三叠游道、瀑布等</span></div>\n      <div class=\"item\"><span class=\"name\">11.猛洞河漂流</span> <span class=\"price\">（门票：180）</span> <span class=\"desc\">夏天去漂流最是刺激好玩</span></div>\n      <div class=\"item\"><span class=\"name\">12.凤凰古城</span> <span class=\"price\">（门票：免费）</span> <span class=\"desc\">沈从文笔下的小镇，很幽静很美</span></div>\n      <div class=\"item\"><span class=\"name\">13.芙蓉镇</span> <span class=\"price\">（门票：108）</span> <span class=\"desc\">称\"挂在瀑布上的千年古镇\"</span></div>\n    </td>\n  </tr>\n  <tr>\n    <td class=\"category-cell\">\n      三星<br>推荐\n    </td>\n    <td class=\"content-cell\">\n      <div class=\"item\"><span class=\"name\">1.宝峰湖景区</span> <span class=\"price\">（门票：96）</span> <span class=\"desc\">世界自然遗产，被称为\"世界湖泊经典\"</span></div>\n      <div class=\"item\"><span class=\"name\">2.溪布街</span> <span class=\"price\">（门票：免费）</span> <span class=\"desc\">复合型旅游商业步行街，民族文化殿堂</span></div>\n      <div class=\"item\"><span class=\"name\">3.魅力湘西表演</span> <span class=\"price\">（门票：228）</span> <span class=\"desc\">第一次看还是很震撼的</span></div>\n      <div class=\"item\"><span class=\"name\">4.土家风情园</span> <span class=\"price\">（门票：80）</span> <span class=\"desc\">人文景观与自然景观相融合的地方</span></div>\n      <div class=\"item\"><span class=\"name\">5.张家界五雷山</span> <span class=\"price\">（门票：63）</span> <span class=\"desc\">湖南省首批确定的重点宗教场所</span></div>\n      <div class=\"item\"><span class=\"name\">6.奇梁洞</span> <span class=\"price\">（门票：60）</span> <span class=\"desc\"