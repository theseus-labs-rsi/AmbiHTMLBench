        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>人民日报 2025年7月7日 第3版 要闻</title>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  body {\n    font-family: \"SimSun\", \"Songti SC\", \"STSong\", serif;\n    font-size: 14px;\n    line-height: 1.6;\n    color: #111;\n    background: #fff;\n    max-width: 1100px;\n    margin: 0 auto;\n    padding: 10px 20px;\n  }\n  .header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    border-bottom: 3px double #000;\n    padding-bottom: 6px;\n    margin-bottom: 8px;\n  }\n  .header .logo {\n    font-family: \"KaiTi\", \"STKaiti\", serif;\n    font-size: 28px;\n    font-weight: bold;\n    color: #c00;\n  }\n  .header .date {\n    font-size: 14px;\n  }\n  .header .page-num {\n    font-size: 36px;\n    font-weight: bold;\n  }\n  .header .section-name {\n    font-size: 22px;\n    font-weight: bold;\n  }\n  .main-title {\n    text-align: center;\n    margin: 10px 0 5px;\n  }\n  .main-title h1 {\n    font-size: 32px;\n    font-weight: bold;\n    letter-spacing: 2px;\n    line-height: 1.4;\n  }\n  .main-title .subtitle {\n    font-size: 20px;\n    font-weight: bold;\n    margin-top: 4px;\n  }\n  .main-title .author {\n    font-size: 13px;\n    text-align: right;\n    margin-top: 4px;\n    color: #555;\n  }\n  .content-wrapper {\n    display: flex;\n    gap: 15px;\n    margin-top: 10px;\n  }\n  .main-content {\n    flex: 1;\n    display: flex;\n    gap: 12px;\n  }\n  .col {\n    flex: 1;\n    text-align: justify;\n    font-size: 13px;\n    line-height: 1.75;\n  }\n  .col h3 {\n    font-size: 16px;\n    font-weight: bold;\n    margin-bottom: 6px;\n    text-align: left;\n  }\n  .sidebar {\n    width: 220px;\n    border-left: 2px solid #000;\n    padding-left: 12px;\n    flex-shrink: 0;\n  }\n  .sidebar h3 {\n    font-size: 14px;\n    font-weight: bold;\n    ma