ation-svg\" viewBox=\"0 0 200 160\">\n          <!-- Hand receiving product from pump bottle -->\n          <g stroke=\"#333\" stroke-width=\"1.5\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <!-- Pump bottle -->\n            <rect x=\"110\" y=\"50\" width=\"50\" height=\"70\" rx=\"3\" />\n            <rect x=\"125\" y=\"30\" width=\"20\" height=\"22\" rx=\"2\" />\n            <line x1=\"135\" y1=\"30\" x2=\"135\" y2=\"18\" />\n            <line x1=\"125\" y1=\"18\" x2=\"145\" y2=\"18\" />\n            <line x1=\"125\" y1=\"18\" x2=\"115\" y2=\"25\" />\n            <!-- Hand holding bottle -->\n            <path d=\"M155,60 C165,55 175,60 180,70 C185,80 180,95 170,100 C160,105 150,100 145,90\" />\n            <path d=\"M160,65 C168,62 172,68 170,75\" />\n            <path d=\"M162,72 C170,70 174,76 172,82\" />\n            <path d=\"M163,80 C170,78 174,84 172,90\" />\n            <!-- Receiving hand (cupped) -->\n            <path d=\"M30,90 C25,80 30,65 40,60 C50,55 60,58 65,65\" />\n            <path d=\"M35,85 C32,75 38,65 45,62\" />\n            <path d=\"M42,82 C40,72 45,63 52,60\" />\n            <path d=\"M50,80 C48,70 53,62 60,60\" />\n            <path d=\"M58,82 C57,73 62,65 68,64\" />\n            <path d=\"M30,90 C35,100 50,105 65,100 C75,96 80,88 78,80\" />\n            <!-- Liquid drops -->\n            <circle cx=\"95\" cy=\"40\" r=\"2\" fill=\"#333\" />\n            <circle cx=\"90\" cy=\"48\" r=\"1.5\" fill=\"#333\" />\n            <circle cx=\"85\" cy=\"55\" r=\"1\" fill=\"#333\" />\n            <line x1=\"115\" y1=\"25\" x2=\"80\" y2=\"50\" stroke-dasharray=\"3,3\" />\n          </g>\n        </svg>\n      </div>\n    </div>\n    <div class=\"step\">\n      <div class=\"step-header\">\n        <div class=\"step-number\">1b</div>\n      </div>\n      <div class=\"step-illustration\">\n        <svg class=\"illustration-svg\" viewBox=\"0 0 200 160\">\n          <g stroke=\"#333\" stroke-width=\"1.5\" fill=\"none\" s