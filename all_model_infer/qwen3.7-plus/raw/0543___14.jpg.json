t-size: 13px; font-weight: 900; }\n  .logo-box.micron-logo { color: #003da5; font-size: 13px; font-style: italic; }\n  .logo-box.mps-logo { color: #003da5; font-size: 14px; font-weight: 900; }\n  .logo-box.marvell-logo { color: #333; font-size: 12px; font-weight: 900; }\n  .logo-box.supermicro-logo { color: #006b3f; font-size: 10px; font-weight: 900; border: 1px solid #006b3f; border-radius: 12px; padding: 2px 8px; }\n  .logo-box.aws-logo { color: #ff9900; font-size: 16px; font-weight: 900; }\n\n  .target-icon {\n    font-size: 36px;\n    color: #1a3a6b;\n  }\n\n  @media (max-width: 768px) {\n    .header h1 { font-size: 28px; }\n    table { font-size: 12px; }\n    .company-cell { min-width: 200px; }\n    .footer-section { flex-direction: column; }\n  }\n</style>\n</head>\n<body>\n<div class=\"container\">\n  <div class=\"header\">\n    <h1>半导体 / AI 价值链全景图</h1>\n    <div class=\"subtitle\">从设计到智能：端到端生态体系</div>\n  </div>\n\n  <table>\n    <thead>\n      <tr>\n        <th style=\"width:22%;\">层级</th>\n        <th style=\"width:20%;\">主要作用</th>\n        <th style=\"width:33%;\">代表企业（示例）</th>\n        <th style=\"width:25%;\">在AI生态中的角色</th>\n      </tr>\n    </thead>\n    <tbody>\n      <!-- Row 1 -->\n      <tr>\n        <td>\n          <div class=\"level-cell\">\n            <div class=\"level-badge bg-purple\">1</div>\n            <div>\n              <div class=\"level-text\">架构设计 / IP层</div>\n              <div class=\"icon-placeholder\">🔲</div>\n            </div>\n          </div>\n        </td>\n        <td class=\"func-cell\">创建基础IP<br>和芯片架构</td>\n        <td>\n          <div class=\"company-cell\">\n            <span class=\"company-name arm\">arm</span>\n            <span class=\"company-name cadence\">cadence</span>\n            <span class=\"company-name siemens\">SIEMENS</span>\n            <span class=\"company-name allegro\">Allegro<sup style=\"font-size:8px;\">MicroSystems</sup></span>\n          </div>\n        </td>\n        <td class=\"role-cell\">定义芯片如何设计，<br>是关键的第一步</td>\n      </tr>\n      <!-- Row 2 -->\n      <tr class=\"row-alt\">\n        <td>\n          <div class=\"level-cell\">\n            <div class=\"level-badge bg-blue\">2</div>\n            <div>\n              <div class=\"level-text\">芯片设计<br><span class=\"sub\">（无晶圆厂）</span></div>\n              <div class=\"icon-placeholder\">🖥️</div>\n            </div>\n          </div>\n        </td>\n        <td class=\"func-cell\">使用IP设计芯片，<br>但不生产</td>\n        <td>\n          <div class=\"company-cell\">\n            <span class=\"company-name nvidia\">🟢 NVIDIA</span>\n            <span class=\"company-name amd\">AMD</span>\n            <span class=\"company-name broadcom\">🔴 BROADCOM</span>\n            <span class=\"company-name qualcomm\">Qualcomm</span>\n            <span class=\"company-name marvell\">MARVELL</span>\n            <span class=\"company-name macom\">MACOM</span>\n            <span class=\"company-name nxp\">NXP</span>\n          </div>\n        </td>\n        <td class=\"role-cell\">打造高性能芯片<br>（GPU、CPU、ASIC、<br>SoC、网络芯片等）</td>\n      </tr>\n      <!-- Row 3 -->\n      <tr>\n        <td>\n          <div class=\"level-cell\">\n            <div class=\"level-badge bg-teal\">3</div>\n            <div>\n              <div class=\"level-text\">晶圆制造<br><span class=\"sub\">（代工）</span></div>\n              <div class=\"icon-placeholder\">🏭</div>\n            </div>\n          </div>\n        </td>\n        <td class=\"func-cell\">在晶圆上制造芯片，<br>使用先进制程</td>\n        <td>\n          <div class=\"company-cell\">\n            <span class=\"company-name tsmc\">tsmc</span>\n            <span class=\"company-name umc\">UMC</span>\n            <span class=\"company-name globalfoundries\">GlobalFoundries</span>\n            <span class=\"company-name intel\">intel.</span>\n          </div>\n        </td>\n        <td class=\"role-cell\">最资本密集的环节，<br>将设计变为现实</td>\n      </tr>\n      <!-- Row 4 -->\n      <tr class=\"row-alt\">\n        <td>\n          <div class=\"level-cell\">\n            <div class=\"level-badge bg-green\">4</div>\n            <div>\n              <div class=\"level-text\">设备<br><span class=\"sub\">（生产设备）</span></div>\n              <div class=\"icon-placeholder\">⚙️</div>\n            </div>\n          </div>\n        </td>\n        <td class=\"func-cell\">提供制造芯片所需<br>的机器和工具</td>\n        <td>\n          <div class=\"company-cell\">\n            <span class=\"company-name asml\">ASML</span>\n            <span class=\"company-name applied\">APPLIED MATERIALS.</span>\n            <span class=\"company-name lam\">Lam RESEARCH</span>\n            <span class=\"company-name kla\">KLA+</span>\n            <span class=\"company-name onto\">Onto Innovation</span>\n          </div>\n        </td>\n        <td class=\"role-cell\">支撑芯片制造的<br>每一步，是进入<br>的高门槛环节</td>\n      </tr>\n      <!-- Row 5 -->\n      <tr>\n        <td>\n          <div class=\"level-cell\">\n            <div class=\"level-badge bg-gold\">5</div>\n            <div>\n              <div class=\"level-text\">封装与测试<br><span class=\"sub\">（OSAT）</span></div>\n              <div class=\"icon-placeholder\">📦</div>\n            </div>\n          </div>\n        </td>\n        <td class=\"func-cell\">封装、打包并测试<br>芯片以确保可用</td>\n        <td>\n          <div class=\"company-cell\">\n            <span class=\"company-name amkor\">Amkor<sup style=\"font-size:8px;\">Technology</sup></span>\n            <span class=\"company-name ase\">ASE</span>\n            <span class=\"company-name formfactor\">FormFactor</span>\n          </div>\n        </td>\n        <td class=\"role-cell\">先进封装是AI芯片<br>（HBM、2.5D/3D等）<br>的关键瓶颈</td>\n      </tr>\n      <!-- Row 6 -->\n      <tr class=\"row-alt\">\n        <td>\n          <div class=\"level-cell\">\n            <div class=\"level-badge bg-purple\">6</div>\n            <div>\n              <div class=\"level-text\">内存</div>\n              <div class=\"icon-placeholder\">🗄️</div>\n            </div>\n          </div>\n        </td>\n        <td class=\"func-cell\">提供内存芯片<br>（DRAM、HBM、<br>NAND），为AI<br>提供存储与带宽</td>\n        <td>\n          <div class=\"company-cell\">\n            <span class=\"company-name micron\">Micron</span>\n            <span class=\"company-name wd\">WD Western Digital.</span>\n            <span class=\"company-name sandisk\">SanDisk</span>\n            <span class=\"company-name seagate\">SEAGATE</span>\n            <span class=\"logo-box\" style=\"background:#1a3a6b;color:#fff;font-size:11px;\">DRAM</span>\n          </div>\n        </td>\n        <td class=\"role-cell\">内存带宽是AI<br>工作负载的关键<br>瓶颈之一</td>\n      </tr>\n      <!-- Row 7 -->\n      <tr>\n        <td>\n          <div class=\"level-cell\">\n            <div class=\"level-badge bg-orange\">7</div>\n            <div>\n              <div class=\"level-text\">电源芯片与<br>电力管理</div>\n              <div class=\"icon-placeholder\">⚡</div>\n            </div>\n          </div>\n        </td>\n        <td class=\"func-cell\">高效交付与管理<br>芯片和系统所需<br>的电力</td>\n        <td>\n          <div class=\"company-cell\">\n            <span class=\"company-name mps\">MPS <span style=\"font-size:9px;font-weight:400;\">MONOLITHIC<br>POWER SYSTEMS</span></span>\n            <span class=\"company-name ti\">TEXAS INSTRUMENTS</span>\n            <span class=\"company-name st\">ST</span>\n            <span class=\"company-name nxp2\">NXP</span>\n            <span class=\"company-name onsemi\">ON Semiconductor®</span>\n          </div>\n        </td>\n        <td class=\"role-cell\">对AI服务器、GPU、<br>电动车等电力效率<br>至关重要</td>\n      </tr>\n      <!-- Row 8 -->\n      <tr class=\"row-alt\">\n        <td>\n          <div class=\"level-cell\">\n            <div class=\"level-badge bg-blue\">8</div>\n            <div>\n              <div class=\"level-text\">连接与网络</div>\n              <div class=\"icon-placeholder\">🔗</div>\n            </div>\n          </div>\n        </td>\n        <td class=\"func-cell\">在芯片、系统和<br>数据中心之间<br>高速传输数据</t