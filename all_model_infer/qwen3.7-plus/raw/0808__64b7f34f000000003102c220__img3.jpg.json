        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>乡土中国 - 思维导图笔记</title>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  body {\n    font-family: \"Microsoft YaHei\", \"SimHei\", sans-serif;\n    background: #f5f5f0;\n    padding: 20px;\n    font-size: 14px;\n    line-height: 1.6;\n    color: #222;\n  }\n  .container {\n    max-width: 1400px;\n    margin: 0 auto;\n    position: relative;\n  }\n  .main-title {\n    text-align: center;\n    font-size: 36px;\n    font-weight: bold;\n    color: #c0392b;\n    margin: 20px 0 30px;\n    text-decoration: underline;\n    text-decoration-color: #c0392b;\n  }\n  .subtitle {\n    text-align: center;\n    font-size: 18px;\n    color: #2980b9;\n    margin-bottom: 30px;\n  }\n  .grid-layout {\n    display: grid;\n    grid-template-columns: 1fr 1fr 1fr;\n    gap: 20px;\n  }\n  .section {\n    background: #fff;\n    border: 1px solid #ddd;\n    border-radius: 8px;\n    padding: 15px;\n    margin-bottom: 15px;\n  }\n  .section-title {\n    font-size: 18px;\n    font-weight: bold;\n    margin-bottom: 10px;\n    padding-bottom: 5px;\n    border-bottom: 2px solid;\n  }\n  .section-title.red { color: #c0392b; border-color: #c0392b; }\n  .section-title.blue { color: #2980b9; border-color: #2980b9; }\n  .section-title.green { color: #27ae60; border-color: #27ae60; }\n  .section-title.orange { color: #e67e22; border-color: #e67e22; }\n  .section-title.purple { color: #8e44ad; border-color: #8e44ad; }\n  .section-title.black { color: #222; border-color: #222; }\n\n  .subsection {\n    margin: 8px 0;\n    padding-left: 10px;\n    border-left: 3px solid #ccc;\n  }\n  .subsection-title {\n    font-weight: bold;\n    font-size: 15px;\n    margin-bottom: 5px;\n  }\n  .subsection-title.red { color: #c0392b; }\n  .subsection-title.blue { color: #2980b9; }\n  .subsection-title.green { color: #27ae60; }\n  .subsection-title.orange { color: #e67e22; }\n\n  .note {\n    font-size: 13px;\n    color: #555;\n    margin: 3px 0;\n    padding-left: 15px;\n  }\n  .note.red { color: #c0392b; }\n  .note.blue { color: #2980b9; }\n  .note.green { color: #27ae60; }\n  .note.orange { color: #e67e22; }\n  .note.purple { color: #8e44ad; }\n\n  .highlight {\n    background: #fff3cd;\n    padding: 2px 4px;\n    border-radius: 3px;\n  }\n  .highlight-red {\n    background: #fde8e8;\n    padding: 2px 4px;\n    border-radius: 3px;\n  }\n  .highlight-blue {\n    background: #e8f0fe;\n    padding: 2px 4px;\n    border-radius: 3px;\n  }\n\n  .key-point {\n    font-weight: bold;\n    color: #c0392b;\n  }\n  .key-point-blue {\n    font-weight: bold;\n    color: #2980b9;\n  }\n\n  .arrow { color: #c0392b; font-weight: bold; }\n  .arrow-blue { color: #2980b9; font-weight: bold; }\n\n  .two-col {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 15px;\n  }\n  .three-col {\n    display: grid;\n    grid-template-columns: 1fr 1fr 1fr;\n    gap: 15px;\n  }\n\n  .center-box {\n    text-align: center;\n    border: 3px solid #c0392b;\n    border-radius: 12px;\n    padding: 20px;\n    margin: 20px auto;\n    max-width: 400px;\n    background: #fff;\n  }\n  .center-box h1 {\n    font-size: 32px;\n    color: #c0392b;\n    margin-bottom: 5px;\n  }\n  .center-box p {\n    font-size: 14px;\n    color: #666;\n  }\n\n  .tag {\n    display: inline-block;\n    padding: 2px 8px;\n    border-radius: 12px;\n    font-size: 12px;\n    margin: 2px;\n  }\n  .tag-red { background: #fde8e8; color: #c0392b; border: 1px solid #c0392b; }\n  .tag-blue { background: #e8f0fe; color: #2980b9; border: 1px solid #2980b9; }\n  .tag-green { background: #e8f8f0; color: #27ae60; border: 1px solid #27ae60; }\n\n  .comparison-table {\n    width: 100%;\n    border-collapse: collapse;\n    margin: 10px 0;\n    font-size: 13px;\n  }\n  .comparison-table th, .comparison-table td {\n    border: 1px solid #ccc;\n    padding: 6