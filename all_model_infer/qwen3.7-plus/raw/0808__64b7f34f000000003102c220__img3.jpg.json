;\n    margin: 5px;\n    background: #e8f0fe;\n    font-weight: bold;\n    color: #2980b9;\n  }\n\n  .relationship-diagram {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    margin: 10px 0;\n    flex-wrap: wrap;\n  }\n  .rel-box {\n    border: 2px solid #27ae60;\n    border-radius: 8px;\n    padding: 8px 12px;\n    background: #f0fff0;\n    text-align: center;\n    font-size: 13px;\n  }\n  .rel-arrow {\n    font-size: 20px;\n    color: #27ae60;\n  }\n\n  .full-width {\n    grid-column: 1 / -1;\n  }\n\n  .chapter-num {\n    display: inline-block;\n    background: #c0392b;\n    color: white;\n    width: 24px;\n    height: 24px;\n    border-radius: 50%;\n    text-align: center;\n    line-height: 24px;\n    font-size: 12px;\n    margin-right: 5px;\n  }\n  .chapter-num.blue { background: #2980b9; }\n  .chapter-num.green { background: #27ae60; }\n  .chapter-num.orange { background: #e67e22; }\n\n  .emphasis-box {\n    border-left: 4px solid #c0392b;\n    padding: 8px 12px;\n    margin: 8px 0;\n    background: #fff5f5;\n    font-size: 13px;\n  }\n\n  .emphasis-box-blue {\n    border-left: 4px solid #2980b9;\n    padding: 8px 12px;\n    margin: 8px 0;\n    background: #f0f7ff;\n    font-size: 13px;\n  }\n\n  .emphasis-box-green {\n    border-left: 4px solid #27ae60;\n    padding: 8px 12px;\n    margin: 8px 0;\n    background: #f0fff0;\n    font-size: 13px;\n  }\n\n  .diagram-placeholder {\n    border: 2px dashed #aaa;\n    border-radius: 8px;\n    padding: 20px;\n    text-align: center;\n    color: #999;\n    margin: 10px 0;\n    background: #fafafa;\n  }\n\n  .mind-map-center {\n    position: relative;\n    text-align: center;\n    padding: 30px;\n  }\n  .mind-map-center .core {\n    display: inline-block;\n    border: 4px solid #c0392b;\n    border-radius: 50%;\n    width: 120px;\n    height: 120px;\n    line-height: 120px;\n    font-size: 24px;\n    font-weight: bold;\n    color: #c0392b;\n    background: #fff;\n    z-index: 2;\n    position: relative;\n  }\n\n  .section-header {\n    font-size: 22px;\n    font-weight: bold;\n    text-align: center;\n    margin: 20px 0 15px;\n    padding: 10px;\n    border-radius: 8px;\n  }\n  .section-header.red-bg { background: #fde8e8; color: #c0392b; }\n  .section-header.blue-bg { background: #e8f0fe; color: #2980b9; }\n  .section-header.green-bg { background: #e8f8f0; color: #27ae60; }\n\n  .list-item {\n    margin: 5px 0;\n    padding-left: 20px;\n    position: relative;\n  }\n  .list-item::before {\n    content: \"•\";\n    position: absolute;\n    left: 5px;\n    color: #c0392b;\n    font-weight: bold;\n  }\n\n  .connector {\n    text-align: center;\n    font-size: 24px;\n    color: #c0392b;\n    margin: 5px 0;\n  }\n\n  .note-box {\n    background: #fffde7;\n    border: 1px solid #f0e68c;\n    border-radius: 6px;\n    padding: 10px;\n    margin: 8px 0;\n    font-size: 13px;\n  }\n\n  .red-text { color: #c0392b; }\n  .blue-text { color: #2980b9; }\n  .green-text { color: #27ae60; }\n  .orange-text { color: #e67e22; }\n  .purple-text { color: #8e44ad; }\n  .bold { font-weight: bold; }\n\n  .table-container {\n    overflow-x: auto;\n    margin: 10px 0;\n  }\n\n  .flex-row {\n    display: flex;\n    gap: 15px;\n    flex-wrap: wrap;\n  }\n  .flex-col {\n    flex: 1;\n    min-width: 250px;\n  }\n\n  .circle-num {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 22px;\n    height: 22px;\n    border-radius: 50%;\n    background: #c0392b;\n    color: white;\n    font-size: 12px;\n    font-weight: bold;\n    margin-right: 5px;\n  }\n  .circle-num.blue { background: #2980b9; }\n  .circle-num.green { background: #27ae60; }\n\n  .bracket-note {\n    border: 1px solid #ccc;\n    border-radius: 6px;\n    padding: 8px 12px;\n    margin: 5px 0;\n    font-size: 13px;\n    background: #fafafa;\n  }\n\n  .author-info {\n    text-align: center;\n    font-size: 14px;\n    color: #666;\n    margin-bottom: 20px;\n  }\n  .author-info span {\n    color: #c0392b;\n    font-weight: bold;\n  }\n\n  .chapter-list {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));\n    gap: 8px;\n    margin: 15px 0;\n  }\n  .chapter-item {\n    padding: 8px 12px;\n    border-radius: 6px;\n    font-size: 13px;\n    border: 1px solid #ddd;\n    background: #fff;\n  }\n  .chapter-item.active {\n    border-color: #c0392b;\n    background: #fde8e8;\n    font-weight: bold;\n  }\n\n  .summary-box {\n    border: 3px solid #c0392b;\n    border-radius: 10px;\n    padding: 15px;\n    margin: 15px 0;\n    background: linear-gradient(135deg, #fff5f5, #fff);\n  }\n\n  .keyword-cloud {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px;\n    justify-content: center;\n    margin: 15px 0;\n  }\n  .keyword {\n    padding: 5px 12px;\n    border-radius: 15px;\n    font-size: 13px;\n    font-weight: bold;\n  }\n\n  .vertical-text {\n    writing-mode: vertical-rl;\n    text-orientation: mixed;\n  }\n\n  .page-footer {\n    text-align: center;\n    margin-top: 30px;\n    padding-top: 15px;\n    border-top: 2px solid #ddd;\n    color: #999;\n    font-size: 12px;\n  }\n</style>\n</head>\n<body>\n<div class=\"container\">\n\n  <!-- Top Title Bar -->\n  <div class=\"top-bar\">乡土中国的基本社会结构特征</div>\n\n  <!-- Author Info -->\n  <div class=\"author-info\">\n    作者：<span>费孝通</span> | 社会学经典著作 | 社会结构类型分析\n  </div>\n\n  <!-- Center Title -->\n  <div class=\"center-box\">\n    <h1>乡土中国</h1>\n    <p>社会结构类型著作</p>\n    <p style=\"font-size:12px; color:#999; margin-top:5px;\">时代：20世纪40年代 | 范围：乡土社会</p>\n  </div>\n\n  <!-- Chapter Overview -->\n  <div class=\"section-header red-bg\"> 全书章节概览</div>\n  <div class=\"chapter-list\">\n    <div class=\"chapter-item active\"><span class=\"chapter-num\">1</span>乡土本色</div>\n    <div class=\"chapter-item active\"><span class=\"chapter-num\">2</span>文字下乡</div>\n    <div class=\"chapter-item active\"><span class=\"chapter-num\">3</span>再论文字下乡</div>\n    <div class=\"chapter-item active\"><span class=\"chapter-num\">4</span>差序格局</div>\n    <div class=\"chapter-item active\"><span class=\"chapter-num\">5</span>系维着私人道德</div>\n    <div class=\"chapter-item active\"><span class=\"chapter-num\">6</span>家族</div>\n    <div class=\"chapter-item active\"><span class=\"chapter-num\">7</span>男女有别</div>\n    <div class=\"chapter-item active\"><span class=\"chapter-num\">8</span>礼治秩序</div>\n    <div class=\"chapter-item active\"><span class=\"chapter-num\">9</span>无讼</div>\n    <div class=\"chapter-item active\"><span class=\"chapter-num\">10</span>无为政治</div>\n    <div class=\"chapter-item active\"><span class=\"chapter-num\">11</span>长老统治</div>\n    <div class=\"chapter-item active\"><span class=\"chapter-num\">12</span>血缘和地缘</div>\n    <div class=\"chapter-item active\"><span class=\"chapter-num\">13</span>名实的分离</div>\n    <div class=\"chapter-item active\"><span class=\"chapter-num\">14</span>从欲望到需要</div>\n  </div>\n\n  <!-- Keyword Cloud -->\n  <div class=\"keyword-cloud\">\n    <span class=\"keyword\" style=\"background:#fde8e8; color:#c0392b;\">差序格局</span>\n    <span class=\"keyword\" style=\"background:#e8f0fe; color:#2980b9;\">礼治秩序</span>\n    <span class=\"keyword\" style=\"background:#e8f8f0; color:#27ae60;\">乡土社会</span>\n    <span class=\"keyword\" style=\"background:#fff3cd; color:#e67e22;\">长老统治</span>\n    <span class=\"keyword\" style=\"background:#f0e8fe; color:#8e44ad;\">血缘地缘</span>\n    <span class=\"keyword\" style=\"background:#fde8e8; color:#c0392b;\">无为政治</span>\n    <span class=\"keyword\" style=\"background:#e8f0fe; color:#2980b9;\">无讼</span>\n    <span class=\"keyword\" style=\"background:#e8f8f0; color:#27ae60;\">家族</span>\n  </div>\n\n  <!-- Main Content Grid -->\n  <div class=\"grid-layout\">\n\n    <!-- LEFT COLUMN -->\n    <div class=\"branch\">\n\n      <!-- 乡土社会的基本性质 -->\n      <div class=\"section\">\n        <div class=\"section-title red\">乡土社会的基本性质</div>\n\n        <div class=\"subsection\">\n          <div class=\"subsection-title red\"> 乡土本色</div>\n          <div class=\"note\">\n            <span class=\"key-point\">核心概念：</span>乡土性\n          </div>\n          <div class=\"note\">\n            <span class=\"bold\">特征：</span>不流动、聚村而居、熟悉社会\n          </div>\n          <div class=\"note\">\n            以农业为生，人与土地紧密相连\n          </div>\n          <div class=\"note\">\n            地方性：区域间孤立、隔膜\n          </div>\n          <div class=\"note\">\n            熟悉社会：面对面社群，无需文字\n          </div>\n          <div class=\"note red\">\n            <span class=\"bold\">重点：</span>乡土社会是\"熟悉\"的社会，不是\"陌生\"的社会\n          </div>\n        </div>\n\n        <div class=\"subsection\">\n          <div class=\"subsection-title blue\">② 文字下乡</div>\n          <div class=\"note\">\n            <span class=\"key-point-blue\">核心问题：</span>乡土社会是否需要文字？\n          </div>\n          <div class=\"note\">\n            文字是传情达意的工具\n          </div>\n          <div class=\"note\">\n            乡土社会是面对面社群，语言足够\n          </div>\n          <div class=\"note\">\n            文字的发生是在空间和时间的阻隔中\n          </div>\n          <div class=\"note blue\">\n            <span class=\"bold\">结论：</span>乡土社会不需要文字，因为空间上面对面，时间上世代相传\n          </div>\n        </div>\n\n        <div class=\"subsection\">\n          <div class=\"subsection-title green\">③ 再论文字下乡</div>\n          <div class=\"note\">\n            从时间角度论述\n          </div>\n          <div class=\"note\">\n            记忆：个人记忆 vs 社会记忆\n          </div>\n          <div class=\"note\">\n            乡土社会生活方式重复，无需文字记录\n          </div>\n          <div class=\"note green\">\n            <span class=\"bold\">结论：</span>文字下乡的前提是乡土社会结构发生变化\n          </div>\n        </div>\n      </div>\n\n      <!-- 礼治秩序 -->\n      <div class=\"section\">\n        <div class=\"section-title blue\">⑧ 礼治秩序</div>\n        <div class=\"note\">\n          <span class=\"key-point-blue\">论述重点：</span>秩序——维持社会秩序所应用的力量\n        </div>\n        <div class=\"note\">\n          礼治：传统、习惯、风俗\n        </div>\n        <div class=\"note\">\n          法治：国家权力、法律\n        </div>\n        <div class=\"note\">\n          人治：个人意志、权力\n        </div>\n        <div class=\"emphasis-box-blue\">\n          <span class=\"bold\">礼治社会：</span>人们主动服膺于传统，礼是公认的行为规范\n        </div>\n        <div class=\"note blue\">\n          礼不是文明，也不是野蛮，而是一种社会规范\n        </div>\n        <div class=\"note\">\n          礼治秩序的前提：传统可以有效应付生活问题\n        </div>\n      </div>\n\n      <!-- 无讼 -->\n      <div class=\"section\">\n        <div class=\"section-title green\">⑨ 无讼</div>\n        <div class=\"note\">\n          <span class=\"key-point\">论述重点：</span>礼治——维持社会秩序的力量\n        </div>\n        <div class=\"note\">\n          在乡土社会中，诉讼是不道德的\n        </div>\n        <div class=\"note\">\n          调解：由长老、乡绅主持\n        </div>\n        <div class=\"note\">\n          现代司法制度在乡土社会难以推行\n        </div>\n        <div class=\"emphasis-box-green\">\n          <span class=\"bold\">核心观点：</span>乡土社会追求无讼，通过教化维持秩序\n        </div>\n        <div class=\"note green\">\n          现代司法制度破坏了乡土社会的礼治秩序\n        </div>\n        <div class=\"note\">\n          教化：使人主动遵守规范\n        </div>\n        <div class=\"note\">\n          现代社会：权利意识增强，诉讼增多\n        </div>\n      </div>\n\n      <!-- 无为政治 -->\n      <div class=\"section\">\n        <div class=\"section-title orange\"> 无为政治</div>\n        <div class=\"note\">\n          <span class=\"bold\" style=\"color:#e67e22;\">论述重点：</span>治理——两种权力模式\n        </div>\n        <div class=\"note\">\n          <span class=\"bold\">横暴权力：</span>自上而下，强制性的\n        </div>\n        <div class=\"note\">\n          <span class=\"bold\">同意权力：</span>社会契约，合作性的\n        </div>\n        <div class=\"note orange\">\n          乡土社会：皇权无为，因为农业经济剩余少，无法支撑强大政权\n        </div>\n        <div class=\"emphasis-box\" style=\"border-left-color:#e67e22; background:#fffaf0;\">\n          <span class=\"bold\">核心：</span>乡土社会的权力结构是\"无为\"的，皇权不下县\n        </div>\n        <div class=\"note\">\n          两种权力模式在乡土社会的表现\n        </div>\n        <div class=\"note\">\n          横暴权力：有限，因为经济基础薄弱\n        </div>\n        <div class=\"note\">\n          同意权力：在乡土社会中也不发达\n        </div>\n      </div>\n\n    </div>\n\n    <!-- MIDDLE COLUMN -->\n    <div class=\"branch\">\n\n      <!-- 差序格局 -->\n      <div class=\"section\">\n        <div class=\"section-title red\">④ 差序格局</div>\n        <div class=\"note\">\n          <span class=\"key-point\">核心概念：</span>差序格局 vs 团体格局\n        </div>\n        <div class=\"note\">\n          西方社会：团体格局（捆柴式）\n        </div>\n        <div class=\"note\">\n          中国社会：差序格局（水波纹式）\n        </div>\n\n        <div class=\"diagram-placeholder\">\n          [图示：差序格局——以己为中心，像水波纹一样推及开去]\n        </div>\n\n        <div class=\"note red\">\n          <span class=\"bold\">特征：</span>\n        </div>\n        <div class=\"note\"> 以\"己\"为中心</div>\n        <div class=\"note\">② 关系有亲疏远近之分</div>\n        <div class=\"note\">③ 公私界限模糊</div>\n        <div class=\"note\">④ 伦理本位</div>\n\n        <div class=\"emphasis-box\">\n          <span class=\"bold\">差序格局：</span>每个人以自己为中心，按亲疏远近形成社会关系网络，像石子投入水中形成的波纹\n        </div>\n\n        <div class=\"note\">\n          <span class=\"bold\">与团体格局的对比：</span>\n        </div>\n        <div class=\"table-container\">\n          <table class=\"comparison-table\">\n            <tr>\n              <th>差序格局</th>\n              <th>团体格局</th>\n            </tr>\n            <tr>\n              <td>以己为中心</td>\n              <td>以团体为中心</td>\n            </tr>\n            <tr>\n              <td>关系有亲疏</td>\n              <td>成员平等</td>\n            </tr>\n            <tr>\n              <td>公私模糊</td>\n              <td>公私分明</td>\n            </tr>\n            <tr>\n              <td>伦理本位</td>\n              <td>权利本位</td>\n            </tr>\n            <tr>\n              <td>水波纹式</td>\n              <td>捆柴式</td>\n            </tr>\n          </table>\n        </div>\n      </div>\n\n      <!-- 系维着私人道德 -->\n      <div class=\"section\">\n        <div class=\"section-title purple\">⑤ 系维着私人道德</div>\n        <div class=\"note\">\n          <span class=\"bold\" style=\"color:#8e44ad;\">核心：</span>道德观念与社会结构的关系\n        </div>\n        <div class=\"note\">\n          团体格局：平等、宪法观念、权利意识\n        </div>\n        <div class=\"note\">\n          差序格局：克己复礼、孝悌忠信\n        </div>\n        <div class=\"note purple\">\n          中国：从己到家，由家到国，由国到天下\n        </div>\n        <div class=\"note\">\n          道德标准因关系远近而不同\n        </div>\n        <div class=\"emphasis-box\" style=\"border-left-color:#8e44ad; background:#faf0ff;\">\n          <span class=\"bold\">核心观点：</span>在差序格局中，道德标准是相对的，取决于对象与自己的关系远近\n        </div>\n        <div class=\"note\">\n          缺乏普遍的道德标准\n        </div>\n        <div class=\"note\">\n          公德心薄弱，私德发达\n        </div>\n      </div>\n\n      <!-- 家族 -->\n      <div class=\"section\">\n        <div class=\"section-title green\">⑥ 家族</div>\n        <div class=\"note\">\n          <span class=\"key-point\">核心：</span>中国家庭 vs 西方家庭\n        </div>\n        <div class=\"note\">\n          西方：小家庭（核心家庭）\n        </div>\n        <div class=\"note\">\n          中国：大家庭（家族）\n        </div>\n        <div class=\"note green\">\n          家族：绵续性的事业社群\n        </div>\n        <div class=\"note\">\n          功能：政治、经济、宗教\n        </div>\n        <div class=\"note\">\n          主轴：父子、婆媳（纵向）\n        </div>\n        <div class=\"note\">\n          配轴：夫妻（横向）——被排斥\n        </div>\n        <div class=\"emphasis-box-green\">\n          <span class=\"bold\">核心：</span>中国家族是事业组织，以效率为原则，排斥感情\n        </div>\n      </div>\n\n      <!-- 男女有别 -->\n      <div class=\"section\">\n        <div class=\"section-title orange\">⑦ 男女有别</div>\n        <div class=\"note\">\n          <span class=\"bold\" style=\"color:#e67e22;\">核心：</span>感情定向\n        </div>\n        <div class=\"note\">\n          乡土社会：男女有别，避免感情激动\n        </div>\n        <div class=\"note\">\n          阿波罗式：维持现有秩序\n        </div>\n        <div class=\"note\">\n          浮士德式：追求创造、突破\n        </div>\n        <div class=\"note orange\">\n          乡土社会是阿波罗式的，追求稳定\n        </div>\n        <div class=\"emphasis-box\" style=\"border-left-color:#e67e22; background:#fffaf0;\">\n          <span class=\"bold\">核心：</span>男女有别是为了维持社会秩序的稳定，避免感情破坏既定关系\n        </div>\n      </div>\n\n      <!-- 长老统治 -->\n      <div class=\"section\">\n        <div class=\"section-title orange\">⑪ 长老统治</div>\n        <div class=\"note\">\n          <span class=\"bold\" style=\"color:#e67e22;\">论述重点：</span>治理——两种权力模式\n        </div>\n        <div class=\"note\">\n          第三种权力：<span class=\"bold\">教化权力</span>（长老权力）\n        </div>\n        <div class=\"note orange\">\n          发生于社会变迁缓慢的社会\n        </div>\n        <div class=\"note\">\n          长辈对晚辈的教化\n        </div>\n        <div class=\"note\">\n          文化传承的方式\n        </div>\n        <div class=\"emphasis-box\" style=\"border-left-color:#e67e22; background:#fffaf0;\">\n          <span class=\"bold\">核心：</span>长老统治是教化权力，基于文化传统，长辈对晚辈进行教化\n        </div>\n        <div class=\"note\">\n          与横暴权力、同意权力的区别\n        </div>\n        <div class=\"note\">\n          社会变迁快时，长老权力衰落\n        </div>\n      </div>\n\n    </div>\n\n    <!-- RIGHT COLUMN -->\n    <div class=\"branch\">\n\n      <!-- 社会结构 -->\n      <div class=\"section\">\n        <div class=\"section-title red\">社会结构</div>\n        <div class=\"note\">\n          <span class=\"key-point\">核心概念：</span>社会结构类型\n        </div>\n\n        <div class=\"box-red\">\n          <div class=\"bold red-text\">社会结构类型著作</div>\n          <div class=\"note\">时代：20世纪40年代</div>\n          <div class=\"note\">范围：乡土社会</div>\n          <div class=\"note\">作者：费孝通</div>\n        </div>\n\n        <div class=\"note red\">\n          <span class=\"bold\">社会结构的基本特征：</span>\n        </div>\n        <div class=\"note\"> 乡土性</div>\n        <div class=\"note\">② 差序格局</div>\n        <div class=\"note\">③ 礼治秩序</div>\n        <div class=\"note\">④ 长老统治</div>\n      </div>\n\n      <!-- 血缘和地缘 -->\n      <div class=\"section\">\n        <div class=\"section-title purple\">⑫ 血缘和地缘</div>\n        <div class=\"note\">\n          <span class=\"bold\" style=\"color:#8e44ad;\">核心：</span>社会结合的基础\n        </div>\n        <div class=\"note\">\n          血缘：身份社会的基础\n        </div>\n        <div class=\"note\">\n          地缘：契约社会的基础\n        </div>\n        <div class=\"note purple\">\n          从血缘到地缘的转变\n        </div>\n        <div class=\"note\">\n          血缘社会：用生育维持社会结构\n        </div>\n        <div class=\"note\">\n          地缘社会：商业、契约\n        </div>\n        <div class=\"emphasis-box\" style=\"border-left-color:#8e44ad; background:#faf0ff;\">\n          <span class=\"bold\">核心：</span>血缘是身份社会的基础，地缘是契约社会的基础。从血缘结合到地缘结合是社会性质的转变\n        </div>\n        <div class=\"note\">\n          乡土社会：血缘为主\n        </div>\n        <div class=\"note\">\n          现代社会：地缘为主\n        </div>\n      </div>\n\n      <!-- 名实的分离 -->\n      <div class=\"section\">\n        <div class=\"section-title blue\">⑬ 名实的分离</div>\n        <div class=\"note\">\n          <span class=\"key-point-blue\">论述重点：</span>社会变迁中的权力变化\n        </div>\n        <div class=\"note\">\n          第四种权力：<span class=\"bold\">时势权力</span>\n        </div>\n        <div class=\"note blue\">\n          发生于社会快速变迁时期\n        </div>\n        <div class=\"note\">\n          名：表面的规范\n        </div>\n        <div class=\"note\">\n          实：实际的内容\n        </div>\n        <div class=\"note\">\n          注释：表面承认传统，实际改变内容\n        </div>\n        <div class=\"emphasis-box-blue\">\n          <span class=\"bold\">核心：</span>社会快速变迁时，出现名实分离，时势权力产生\n        </div>\n        <div class=\"note\">\n          四种权力类型总结：\n        </div>\n        <div class=\"note\">① 横暴权力</div>\n        <div class=\"note\">② 同意权力</div>\n        <div class=\"note\">③ 教化权力（长老权力）</div>\n        <div class=\"note\">④ 时势权力</div>\n      </div>\n\n      <!-- 从欲望到需要 -->\n      <div class=\"section\">\n        <div class=\"section-title green\">⑭ 从欲望到需要</div>\n        <div class=\"note\">\n          <span class=\"key-point\">论述重点：</span>社会变迁中行为动机的变化\n        </div>\n        <div class=\"note\">\n          欲望：自觉的动机\n        </div>\n        <div class=\"note\">\n          需要：理性的计划\n        </div>\n        <div class=\"note green\">\n          乡土社会：欲望引导行为，与文化传统一致\n        </div>\n        <div class=\"note\">\n          现代社会：需要引导行为，理性计划\n        </div>\n        <div class=\"emphasis-box-green\">\n          <span class=\"bold\">核心：</span>乡土社会中，人的欲望与文化传统一致，无需理性计划；现代社会中，需要理性计划来指导行为\n        </div>\n        <div class=\"note\">\n          从欲望到需要：社会变迁的体现\n        </div>\n        <div class=\"note\">\n          计划：现代社会的特征\n        </div>\n      </div>\n\n      <!-- 总结 -->\n      <div class=\"summary-box\">\n        <div class=\"section-title red\" style=\"text-align:center; border-bottom:none;\">📌 核心总结</div>\n        <div class=\"note red\">\n          <span class=\"bold\">乡土社会的特征：</span>\n        </div>\n        <div class=\"note\">• 乡土本色：不流动、熟悉社会</div>\n        <div class=\"note\">• 差序格局：以己为中心的关系网络</div>\n        <div class=\"note\">• 礼治秩序：传统规范维持秩序</div>\n        <div class=\"note\">• 长老统治：教化权力</div>\n        <div class=\"note\">• 无讼：追求和谐，避免诉讼</div>\n        <div class=\"note\">• 男女有别：维持社会稳定</div>\n        <div class=\"note\">• 血缘为主：身份社会</div>\n        <div class=\"note red\" style=\"margin-top:10px;\">\n          <span class=\"bold\">现代转型：</span>从乡土社会到现代社会的转变\n        </div>\n        <div class=\"note\">• 文字下乡：社会变迁的需要</div>\n        <div class=\"note\">• 名实分离：快速变迁的产物</div>\n        <div class=\"note\">• 从欲望到需要：理性化过程</div>\n        <div class=\"note\">• 血缘到地缘：社会性质转变</div>\n      </div>\n\n    </div>\n\n  </div>\n\n  <!-- Bottom Summary Section -->\n  <div class=\"section-header blue-bg\"> 四种权力类型总结</div>\n  <div class=\"table-container\">\n    <table class=\"comparison-table\">\n      <tr>\n        <th>权力类型</th>\n        <th>产生条件</th>\n        <th>特征</th>\n        <th>对应章节</th>\n      </tr>\n      <tr>\n        <td><span class=\"bold red-text\">横暴权力</span></td>\n        <td>社会冲突</td>\n        <td>自上而下，强制性</td>\n        <td>无为政治</td>\n      </tr>\n      <tr>\n        <td><span class=\"bold blue-text\">同意权力</span></td>\n        <td>社会合作</td>\n        <td>社会契约，平等</td>\n        <td>无为政治</td>\n      </tr>\n      <tr>\n        <td><span class=\"bold\" style=\"color:#e67e22;\">教化权力（长老权力）</span></td>\n        <td>社会传承</td>\n        <td>文化教化，长辈对晚辈</td>\n        <td>长老统治</td>\n      </tr>\n      <tr>\n        <td><span class=\"bold\" style=\"color:#8e44ad;\">时势权力</span></td>\n        <td>社会快速变迁</td>\n        <td>英雄人物引领变革</td>\n        <td>名实的分离</td>\n      </tr>\n    </table>\n  </div>\n\n  <!-- Relationship Diagram -->\n  <div class=\"section-header green-bg\">🔗 核心概念关系图</div>\n  <div class=\"relationship-diagram\">\n    <div class=\"rel-box\">乡土本色<br><small>不流动、熟悉</small></div>\n    <div class=\"rel-arrow\">→</div>\n    <div class=\"rel-box\">差序格局<br><small>以己为中心</small></div>\n    <div class=\"rel-arrow\">→</div>\n    <div class=\"rel-box\">礼治秩序<br><small>传统规范</small></div>\n    <div class=\"rel-arrow\">→</div>\n    <div class=\"rel-box\">长老统治<br><small>教化权力</small></div>\n  </div>\n  <div class=\"relationship-diagram\">\n    <div class=\"rel-box\">血缘社会<br><small>身份、欲望</small></div>\n    <div class=\"rel-arrow\">→</div>\n    <div class=\"rel-box\">地缘社会<br><small>契约、需要</small></div>\n    <div class=\"rel-arrow\">→</div>\n    <div class=\"rel-box\">现代社会<br><small>法治、理性</small></div>\n  </div>\n\n  <!-- Key Quotes -->\n  <div class=\"section-header red-bg\"> 核心观点摘录</div>\n  <div class=\"flex-row\">\n    <div class=\"flex-col\">\n      <div class=\"box-red\">\n        <div class=\"bold red-text\">关于差序格局</div>\n        <div class=\"note\">\"我们的格局不是一捆一捆扎清楚的柴，而是好像把一块石头丢在水面上所发生的一圈圈推出去的波纹。\"</div>\n      </div>\n    </div>\n    <div class=\"flex-col\">\n      <div class=\"box-blue\">\n        <div class=\"bold blue-text\">关于礼治</div>\n        <div class=\"note\">\"礼并不是靠一个外在的权力来推行的，而是从教化中养成了个人的敬畏之感，使人服膺。\"</div