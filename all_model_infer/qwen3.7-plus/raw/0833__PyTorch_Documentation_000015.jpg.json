none\">None</span> | <span class=\"type-int\">tuple</span>[<span class=\"type-int\">int</span> | <span class=\"type-none\">None</span>, <span class=\"type-int\">int</span> | <span class=\"type-none\">None</span>, <span class=\"type-int\">int</span> | <span class=\"type-none\">None</span>]) – the target output size of the form D x H x W. Can be a tuple (D, H, W) or a single number D for a cube D x D x D. D, H and W can be either a <code>int</code>, or <code>None</code> which means the size will be the same as that of the input.</p>\n    </div>\n\n    <div class=\"shape-section\">\n      <strong>Shape:</strong>\n      <ul>\n        <li>Input: $(N, C, D_{in}, H_{in}, W_{in})$ or $(C, D_{in}, H_{in}, W_{in})$.</li>\n        <li>Output: $(N, C, S_0, S_1, S_2)$ or $(C, S_0, S_1, S_2)$, where $S = \\text{output\\_size}$.</li>\n      </ul>\n    </div>\n\n    <div class=\"examples-header\">Examples</div>\n    <div class=\"code-block\">\n<span class=\"comment\">&gt;&gt;&gt; # target output size of 5x7x9</span>\n&gt;&gt;&gt; m = nn.AdaptiveAvgPool3d((<span class=\"number\">5</span>, <span class=\"number\">7</span>, <span class=\"number\">9</span>))\n&gt;&gt;&gt; <span class=\"builtin\">input</span> = torch.randn(<span class=\"number\">1</span>, <span class=\"number\">64</span>, <span class=\"number\">8</span>, <span class=\"number\">9</span>, <span class=\"number\">10</span>)\n&gt;&gt;&gt; output = m(<span class=\"builtin\">input</span>)\n<span class=\"comment\">&gt;&gt;&gt; # target output size of 7x7x7 (cube)</span>\n&gt;&gt;&gt; m = nn.AdaptiveAvgPool3d(<span class=\"number\">7</span>)\n&gt;&gt;&gt; <span class=\"builtin\">input</span> = torch.randn(<span class=\"number\">1</span>, <span class=\"number\">64</span>, <span class=\"number\">10</span>, <span class=\"number\">9</span>, <span class=\"number\">8</span>)\n&gt;&gt;&gt; output = m(<span class=\"builtin\">input</span>)\n<span class=\"comment\">&gt;&gt;&gt; # target output size of 7x9x8</span>\n&gt;&gt;&gt; m = nn.AdaptiveAvgPool3d((<span class=\"number\">7</span>, <span class=\"none-val\">None</span>, <span class=\"none-val\">None</span>))\n&gt;&gt;&gt; <span class=\"builtin\">input</span> = torch.randn(<span class=\"number\">1</span>, <span class=\"number\">64</span>, <span class=\"number\">10</span>, <span class=\"number\">9</span>, <span class=\"number\">8</span>)\n&gt;&gt;&gt; output = m(<span class=\"builtin\">input</span>)\n    </div>\n\n    <div class=\"method-sig\">\n      <code><span class=\"method-name\">forward</span>(<em>input</em>)</code>\n      <a href=\"#\" class=\"source-link\">[source]</a>\n    </div>\n    <p class=\"method-desc\">Runs the forward pass.</p>\n\n    <div class=\"return-type-header\">Return type:</div>\n    <div class=\"return-type\"><a href=\"#\">Tensor</a></div>\n\n    <!-- Bottom bar -->\n    <div class=\"bottom-bar\">\n      <div class=\"rate\">Rate this Page <span class=\"stars\">☆☆☆☆☆</span></div>\n      <button class=\"feedback-btn\">Send Feedback &gt;</button>\n      <div class=\"nav-prev-next\">\n        <div class=\"prev\">\n          <span>&lt; Previous</span>\n          <a href=\"#\">AdaptiveAvgPool2d</a>\n        </div>\n        <div class=\"next\" style=\"text-align:right;\">\n          <span>Next &gt;</span>\n          <a href=\"#\">ReflectionPad1d</a>\n        </div>\n      </div>\n    </div>\n  </main>\n\n  <!-- Right Sidebar -->\n  <aside class=\"right-sidebar\">\n    <h4>☰ On this page</h4>\n    <ul class=\"toc-list\">\n      <li><a href=\"#\">AdaptiveAvgPool3d</a></li>\n      <li class=\"sub\"><a href=\"#\">AdaptiveAvgPool3d</a></li>\n    </ul>\n    <div class=\"show-source\">\n      <a href=\"#\">📄 Show Source</a>\n    </div>\n    <h4 class=\"libs\">PyTorch Libraries</h4>\n    <ul class=\"lib-list\">\n      <li><a href=\"#\">ExecuTorch ↗</a></li>\n      <li><a href=\"#\">Helion ↗</a></li>\n      <li><a href=\"#\">torchaudio ↗</a></li>\n      <li><a href=\"#\">torchtitan ↗</a></li>\n      <li><a href=\"#\">TorchRL ↗</a></li>\n  