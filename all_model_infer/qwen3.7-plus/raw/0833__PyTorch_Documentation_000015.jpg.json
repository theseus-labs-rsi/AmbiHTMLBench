av-prev-next .prev a, .nav-prev-next .next a { color: #ee4c2c; font-weight: 600; }\n  .nav-prev-next .prev span, .nav-prev-next .next span { color: #666; display: block; }\n\n  .ask-ai { position: fixed; bottom: 24px; right: 24px; background: #fff; border: 2px solid #6c63ff; border-radius: 24px; padding: 10px 20px; font-size: 14px; cursor: pointer; display: flex; align-items: center; gap: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); z-index: 200; }\n  .ask-ai .icon { color: #6c63ff; font-size: 18px; }\n</style>\n</head>\n<body>\n\n<!-- Top Navigation -->\n<nav class=\"top-nav\">\n  <div class=\"logo\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#ee4c2c\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 2a10 10 0 0 1 0 20\"/></svg>\n    PyTorch\n  </div>\n  <select class=\"version-select\"><option>v2.12...</option></select>\n  <div class=\"nav-links\">\n    <a href=\"#\">Install PyTorch</a>\n    <a href=\"#\">User Guide</a>\n    <a href=\"#\">Reference API</a>\n    <a href=\"#\">Developer Notes</a>\n    <a href=\"#\">Community</a>\n    <a href=\"#\">Tutorials ↗</a>\n  </div>\n  <div class=\"nav-right\">\n    <div class=\"go-to\">Go to<br><a href=\"#\">pytorch.org ↗</a></div>\n    <div class=\"search-box\">\n      <span>🔍</span>\n      <input type=\"text\" placeholder=\"Search the docs ...\">\n      <div class=\"toggle\"></div>\n    </div>\n    <div class=\"dark-toggle\"></div>\n  </div>\n  <div class=\"social-icons\">\n    <a href=\"#\">𝕏</a>\n    <a href=\"#\">⊙</a>\n    <a href=\"#\">◉</a>\n    <a href=\"#\">⊞</a>\n  </div>\n</nav>\n\n<div class=\"page-layout\">\n  <!-- Left Sidebar -->\n  <aside class=\"left-sidebar\">\n    <div class=\"section-title\">torch</div>\n    <ul class=\"nav-tree\">\n      <li class=\"parent active\">Aliases in torch.nn</li>\n      <li>Sequential</li>\n      <li>ModuleList</li>\n      <li>ModuleDict</li>\n      <li>ParameterList</li>\n      <li>ParameterDict</li>\n      <li>Conv1d</li>\n      <li>Conv2d</