6px;\n    height: 36px;\n    margin: 0 auto 4px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border-radius: 50%;\n    font-size: 16px;\n  }\n  .shield-orange {\n    border: 2px solid #d4956a;\n    color: #d4956a;\n    background: #fdf3ec;\n  }\n  .shield-green {\n    border: 2px solid #4db8a8;\n    color: #4db8a8;\n    background: #e6f5f1;\n  }\n  .yuan-green {\n    border: 2px solid #4db8a8;\n    color: #4db8a8;\n    background: #e6f5f1;\n    font-weight: bold;\n    font-size: 16px;\n  }\n  .yuan-red {\n    border: 2px solid #d46a5a;\n    color: #d46a5a;\n    background: #fdf0ed;\n    font-weight: bold;\n    font-size: 16px;\n  }\n  .page-footer {\n    position: absolute;\n    bottom: 15px;\n    font-size: 11px;\n    color: #aaa;\n  }\n  .page-footer.left { left: 40px; }\n  .page-footer.right { right: 40px; }\n  .top-illustration {\n    display: flex;\n    align-items: flex-end;\n    gap: 4px;\n    margin-bottom: 8px;\n    height: 50px;\n  }\n  .mountain-shape {\n    width: 0;\n    height: 0;\n    border-left: 30px solid transparent;\n    border-right: 30px solid transparent;\n    border-bottom: 50px solid #b8e6dc;\n    position: relative;\n  }\n  .mountain-shape::after {\n    content: '';\n    position: absolute;\n    top: 10px;\n    left: -15px;\n    width: 0;\n    height: 0;\n    border-left: 15px solid transparent;\n    border-right: 15px solid transparent;\n    border-bottom: 25px solid #7dd4c8;\n  }\n  .svg-illustration {\n    width: 180px;\n    height: 70px;\n  }\n</style>\n</head>\n<body>\n\n<div style=\"display:flex; justify-content:center; gap:0; background:#f5f5f5; padding:20px 0;\">\n\n<!-- Page 23 -->\n<div class=\"page-block\" style=\"width:1200px; min-height:1600px;\">\n  <div class=\"header-bar\">\n    <span style=\"color:#999; font-size:12px;\">2024 · 美的集团ESG报告</span>\n    <div class=\"nav-items\">\n      <span>关于本报告</span>\n      <span>走进美的</span>\n      <span>可持续发展治理</span>\n      <span class=\"active\">守护蓝色星球</span>\n      <span>构建和谐社区</span>\n      <span>践行科技尽善</span>\n      <span>共创繁荣生态</span>\n      <span>附录</span>\n    </div>\n  </div>\n\n  <!-- Mountain illustration -->\n  <div style=\"margin-bottom:10px;\">\n    <svg width=\"180\" height=\"70\" viewBox=\"0 0 180 70\">\n      <polygon points=\"20,70 50,10 80,70\" fill=\"#b8e6dc\"/>\n      <polygon points=\"40,70 65,20 90,70\" fill=\"#7dd4c8\"/>\n      <polygon points=\"60,70 85,15 110,70\" fill=\"#a0ddd4\"/>\n      <polygon points=\"80,70 100,25 120,70\" fill=\"#c8ede7\"/>\n      <polygon points=\"100,70 115,30 130,70\" fill=\"#90d8ce\"/>\n      <polygon points=\"110,70 125,35 140,70\" fill=\"#b5e5dd\"/>\n      <circle cx=\"55\" cy=\"55\" r=\"8\" fill=\"#00b4a0\" opacity=\"0.3\"/>\n      <circle cx=\"90\" cy=\"50\" r=\"6\" fill=\"#00b4a0\" opacity=\"0.2\"/>\n    </svg>\n  </div>\n\n  <table class=\"full-width-table\">\n    <thead>\n      <tr>\n        <th style=\"width:10%; border-radius:20px 0 0 0;\">风险类型</th>\n        <th style=\"width:14%;\">风险描述</th>\n        <th style=\"width:26%; border-radius:0 20px 0 0;\">风险影响</th>\n      </tr>\n    </thead>\n    <tbody>\n      <!-- 物理风险 -->\n      <tr>\n        <td rowspan=\"3\" class=\"merged-cell\" style=\"font-size:14px;\">物理风险</td>\n        <td class=\"desc-cell\">洪灾程度增加</td>\n        <td>\n          <ul class=\"bullet-list\">\n            <li>严重洪灾可能对排水能力较差的仓储区造成成品及生产设备损毁，进而导致运营成本增加与设备加速折旧</li>\n            <li>交通中断或拥堵，无法保证员工的通勤时间，可能导致雇员生产力下降</li>\n          </ul>\n        </td>\n      </tr>\n      <tr>\n        <td class=\"desc-cell\">极端高温</td>\n        <td>\n          <ul class=\"bullet-list\">\n            <li>极端高温将降低户外工作者的工作效率，增加员工健康安全风险</li>\n            <li>为办公、生产等区域员工提供舒适的工作环节所需的制冷能源消耗将增加，进一步加大了制冷相关的碳排放，并有可能增加运营成本</li>\n          </ul>\n        </td>\n      </tr>\n      <tr>\n        <td class=\"desc-cell\">台风等频次增加</td>\n        <td>\n          <ul class=\"bullet-list\">\n            <li>对部分海运物料供应、成品运输的时效性可能造成影响，进一步增加运营成本</li>\n          </ul>\n        </td>\n      </tr>\n\n      <!-- 转型风险 -->\n      <tr>\n        <td rowspan=\"3\" class=\"merged-cell\" style=\"font-size:14px;\">转型风险</td>\n        <td class=\"desc-cell\">对产品能效、冷媒、材料等强制性监管要求的提升</td>\n        <td>\n          <ul class=\"bullet-list\">\n            <li>更高级能效市场准入及消费者偏好将影响研发和市场投入方向</li>\n            <li>《蒙特利尔议定书》对破坏臭氧层物质管制的要求及欧盟、美洲等地区对不同环保型冷媒产品及二氧化碳压缩机等产品的引入将在中长期影响研发和市场的投入方向</li>\n            <li>在循环经济体系背景下环保型材料尤其是再生材料应用占比的提出可能增加产品材料来源的不确定性进一步提升材料的潜在成本</li>\n          </ul>\n        </td>\n      </tr>\n      <tr>\n        <td class=\"desc-cell\">对新能源、储能、新能源汽车核心零部件等产业的投入和转型</td>\n        <td>\n          <ul class=\"bullet-list\">\n            <li>在应对和适应气候背景下，以合康新能、科陆电子、汽车部件等代表的新业务板块有巨大的市场潜力和竞争压力</li>\n          </ul>\n        </td>\n      </tr>\n      <tr>\n        <td class=\"desc-cell\">绿色能源成本的不确定性</td>\n        <td>\n          <ul class=\"bullet-list\">\n            <li>当前可售的绿色电力资源紧缺，市场需求上涨，长期以往可能导致绿色电力在市场化机制下绿电环境溢价进一步提升，增加制造工厂能源成本</li>\n          </ul>\n        </td>\n      </tr>\n    </tbody>\n  </table>\n\n  <!-- 机遇部分 -->\n  <div style=\"margin-top:20px;\">\n    <table class=\"full-width-table\">\n      <thead>\n        <tr>\n          <th style=\"width:10%; border-radius:20px 0 0 0;\">机遇类型</th>\n          <th style=\"width:14%;\">机遇描述</th>\n          <th style=\"width:26%; border-radius:0 20px 0 0;\">机遇影响</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td class=\"merged-cell\" style=\"font-size:14px;\">市场机遇</td>\n          <td class=\"desc-cell\">绿色产品和服务带来的业务机会</td>\n          <td>\n            <ul class=\"bullet-list\">\n              <li>持续开发和/或扩展低排放产品和服务，获得更多市场份额及消费者青睐，同时在资本市场获得更多投资机会，带来更多收入增长</li>\n            </ul>\n          </td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n\n  <span class=\"page-footer left\">23</span>\n</div>\n\n<!-- Page 24 -->\n<div class=\"page-block\" style=\"width:1200px; min-height:1600px;\">\n  <div class=\"header-bar\">\n    <span style=\"color:#999; font-size:12px; visibility:hidde