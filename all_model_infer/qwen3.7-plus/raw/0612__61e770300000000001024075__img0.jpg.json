in-top: 30px;\n    font-size: 13px;\n    color: #555;\n  }\n  .math-inline {\n    display: inline;\n  }\n</style>\n</head>\n<body>\n\n<div class=\"title\">模型 63 多个函数的综合问题（1）</div>\n\n<div class=\"section-title\">【模型分析】</div>\n\n<table>\n  <tr>\n    <td class=\"label-cell\">反比例函数</td>\n    <td colspan=\"2\" style=\"text-align:center; font-size:16px;\">\\( y = \\dfrac{k}{x} \\)（\\( k \\neq 0 \\)）</td>\n  </tr>\n  <tr>\n    <td class=\"label-cell\"><i>k</i> 的符号</td>\n    <td style=\"text-align:center;\"><i>k</i> &gt; 0</td>\n    <td style=\"text-align:center;\"><i>k</i> &lt; 0</td>\n  </tr>\n  <tr>\n    <td class=\"label-cell\">图像</td>\n    <td class=\"graph-cell\">\n      <div class=\"graph-placeholder\">\n        <svg viewBox=\"0 0 160 120\" xmlns=\"http://www.w3.org/2000/svg\">\n          <!-- axes -->\n          <line x1=\"10\" y1=\"60\" x2=\"150\" y2=\"60\" stroke=\"black\" stroke-width=\"1.5\"/>\n          <line x1=\"80\" y1=\"10\" x2=\"80\" y2=\"110\" stroke=\"black\" stroke-width=\"1.5\"/>\n          <!-- arrow heads -->\n          <polygon points=\"150,60 143,56 143,64\" fill=\"black\"/>\n          <polygon points=\"80,10 76,17 84,17\" fill=\"black\"/>\n          <!-- labels -->\n          <text x=\"148\" y=\"75\" font-size=\"12\" font-style=\"italic\">x</text>\n          <text x=\"85\" y=\"18\" font-size=\"12\" font-style=\"italic\">y</text>\n          <text x=\"85\" y=\"75\" font-size=\"12\" font-style=\"italic\">O</text>\n          <!-- hyperbola branches k>0: first and third quadrant -->\n          <path d=\"M 90 20 Q 95 30 100 40 Q 110 50 130 55\" fill=\"none\" stroke=\"black\" stroke-width=\"1.5\"/>\n          <path d=\"M 70 100 Q 65 90 60 80 Q 50 70 30 65\" fill=\"none\" stroke=\"black\" stroke-width=\"1.5\"/>\n        </svg>\n      </div>\n    </td>\n    <td class=\"graph-cell\">\n      <div class=\"graph-placeholder\">\n        <svg viewBox=\"0 0 160 120\" xmlns=\"http://www.w3.org/2000/svg\">\n          <!-- axes -->\n          <line x1=\"10\" y1=\"60\" x2=\"150\" y2=\"60\" stroke=\"black\" stroke-width=\"1.5\"/>\n          <line x1=\"80\" y1=\"10\" x2=\"80\" y2=\"110\" stroke=\"black\" stroke-width=\"1.5\"/>\n          <!-- arrow heads -->\n          <polygon points=\"150,60 143,56 143,64\" fill=\"black\"/>\n          <polygon points=\"80,10 76,17 84,17\" fill=\"black\"/>\n          <!-- labels -->\n          <text x=\"148\" y=\"75\" font-size=\"12\" font-style=\"italic\">x</text>\n          <text x=\"85\" y=\"18\" font-size=\"12\" font-style=\"italic\">y</text>\n          <text x=\"85\" y=\"75\" font-size=\"12\" font-style=\"italic\">O</text>\n          <!-- hyperbola branches k<0: second and fourth quadrant -->\n          <path d=\"M 70 20 Q 65 30 60 40 Q 50 50 30 55\" fill=\"none\" stroke=\"black\" stroke-width=\"1.5\"/>\n          <path d=\"M 90 100 Q 95 90 100 80 Q 110 70 130 65\" fill=\"none\" stroke=\"black\" stroke-width=\"1.5\"/>\n        </svg>\n      </div>\n    </td>\n  </tr>\n  <tr>\n    <td class=\"label-cell\">性质</td>\n    <td class=\"property-cell\">\n      ①<i>x</i> 的取值范围是 <i>x</i> ≠ 0，<i>y</i> 的取值范围是 <i>y</i> ≠ 0<br>\n      ②当 <i>k</i> &gt; 0 时，函数图像两个分支分别在一、三象限，在每个象限内，<i>y</i> 随着 <i>x</i> 增大而减小\n    </td>\n    <td class=\"property-cell\">\n      ①<i>x</i> 的取值范围是 <i>x</i> ≠ 0，<i>y</i> 的取值范围是 <i>y</i> ≠ 0<br>\n      ②当 <i>k</i> &lt; 0 时，函数图像两个分支分别在二、四象限，在每个象限内，<i>y</i> 随着 <i>x</i> 增大而增大\n    </td>\n  </tr>\n</table>\n\n<div class=\"section-title\">【经典例题】</div>\n\n<div class=\"example-text\">\n  例 1.（2020·浙江九年级一模）有下列四个函数：① \\( y = 2x \\)；② \\( y = -\\dfrac{2}{3}x + 4 \\)；③ \\( y = \\dfrac{4}{x} \\)；④ \\( y = -\\left(x - \\dfrac{8}{3}\\right)^2 + \\dfrac{31}{9} \\)，其中图象经过如图所示阴影部分（包括边界）的函数有（&emsp;&emsp;）\n</div>\n\n<div class=\"graph-area\">\n  <svg viewBox=\"0 0 260 220\" xmlns=\"http://www.w3.org/2000/svg\" width=\"260\" height=\"220\">\n    <!-- grid -->\n    <g stroke=\"#ccc\" stroke-width=\"0.5\">\n      <line x1=\"40\" y1=\"20\" x2=\"40\" y2=\"180\"/>\n      <line x1=\"80\" y1=\"20\" x2=\"80