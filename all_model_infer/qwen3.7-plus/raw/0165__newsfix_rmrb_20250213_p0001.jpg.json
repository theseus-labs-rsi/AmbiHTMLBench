        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>人民日报 2025年2月13日</title>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  body {\n    font-family: \"SimSun\", \"Songti SC\", \"STSong\", serif;\n    background: #f5f5f0;\n    color: #1a1a1a;\n    font-size: 14px;\n    line-height: 1.6;\n  }\n  .newspaper {\n    max-width: 1200px;\n    margin: 0 auto;\n    background: #fff;\n    padding: 10px 15px;\n    box-shadow: 0 0 10px rgba(0,0,0,0.1);\n  }\n  .masthead {\n    display: flex;\n    align-items: flex-start;\n    border-bottom: 3px solid #c00;\n    padding-bottom: 8px;\n    margin-bottom: 5px;\n  }\n  .masthead-left {\n    flex: 0 0 auto;\n    padding-right: 20px;\n  }\n  .masthead-title {\n    font-family: \"KaiTi\", \"STKaiti\", serif;\n    font-size: 72px;\n    color: #c00;\n    font-weight: bold;\n    line-height: 1.1;\n    letter-spacing: 4px;\n  }\n  .masthead-sub {\n    font-size: 13px;\n    color: #c00;\n    letter-spacing: 2px;\n    margin-top: 2px;\n  }\n  .masthead-url {\n    font-size: 11px;\n    color: #666;\n    margin-top: 2px;\n  }\n  .masthead-center {\n    flex: 1;\n    text-align: center;\n    padding-top: 10px;\n  }\n  .masthead-date {\n    font-size: 14px;\n    font-weight: bold;\n  }\n  .masthead-date .day {\n    font-size: 36px;\n    font-weight: bold;\n    display: block;\n    line-height: 1.2;\n  }\n  .masthead-info {\n    font-size: 11px;\n    color: #555;\n    margin-top: 4px;\n    line-height: 1.8;\n  }\n  .masthead-right {\n    flex: 0 0 auto;\n    text-align: right;\n    padding-top: 5px;\n  }\n  .top-headline {\n    font-size: 22px;\n    font-weight: bold;\n    color: #1a1a1a;\n    line-height: 1.4;\n  }\n  .top-headline-sub {\n    font-size: 12px;\n    color: #555;\n    margin-top: 4px;\n    line-height: 1.6;\n  }\n  .main-content {\n    display: grid;\n    grid-template-columns: 1fr 280px;\n