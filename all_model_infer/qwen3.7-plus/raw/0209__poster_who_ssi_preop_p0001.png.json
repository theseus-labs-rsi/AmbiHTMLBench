ntent-area {\n    flex: 1;\n    border: 2px solid #e87722;\n    border-left: none;\n    border-radius: 0 8px 8px 0;\n    padding: 25px 30px;\n    background: linear-gradient(180deg, #f8f8f8 0%, #e8e8e8 100%);\n  }\n\n  .section-header {\n    margin-bottom: 20px;\n  }\n\n  .section-header h2 {\n    font-size: 28px;\n    font-weight: 900;\n    color: #1a2a6c;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n  }\n\n  .section-header p {\n    font-size: 12px;\n    font-weight: 700;\n    color: #1a2a6c;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    margin-top: 2px;\n  }\n\n  .column-headers {\n    display: flex;\n    justify-content: flex-end;\n    gap: 60px;\n    margin-bottom: 15px;\n    padding-right: 20px;\n  }\n\n  .column-headers span {\n    font-size: 13px;\n    font-weight: 700;\n    color: #1a2a6c;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n  }\n\n  .recommendation-row {\n    display: flex;\n    align-items: center;\n    background: #fff;\n    border-radius: 12px;\n    padding: 15px 20px;\n    margin-bottom: 12px;\n    box-shadow: 0 2px 6px rgba(0,0,0,0.06);\n    gap: 15px;\n  }\n\n  .icon-circle {\n    width: 90px;\n    height: 90px;\n    min-width: 90px;\n    border-radius: 50%;\n    border: 3px solid #1a2a6c;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: #f0f4ff;\n    overflow: hidden;\n  }\n\n  .icon-circle .placeholder-icon {\n    font-size: 40px;\n    text-align: center;\n    line-height: 1;\n  }\n\n  .description {\n    flex: 1;\n    font-size: 14px;\n    font-weight: 600;\n    color: #222;\n    line-height: 1.4;\n    padding-right: 10px;\n  }\n\n  .description em {\n    font-style: italic;\n    font-weight: 400;\n    color: #555;\n  }\n\n  .arrow {\n    font-size: 28px;\n    color: #ccc;\n    font-weight: 300;\n    min-width: 30px;\n    text-align: center;\n  }\n\n  .action-col {\n    min-width: 120px;\n    text-align: center;\n  }\n\n  .action-icon {\n    width: 60