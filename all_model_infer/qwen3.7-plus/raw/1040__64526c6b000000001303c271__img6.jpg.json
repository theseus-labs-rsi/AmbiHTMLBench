x;\n    justify-content: center;\n    align-items: center;\n    height: 32px;\n  }\n  .fc-arrow-down .down-arrow {\n    font-size: 22px;\n    color: #999;\n  }\n  .fc-spacer-row {\n    grid-column: 1 / -1;\n    display: flex;\n    justify-content: center;\n    height: 32px;\n    align-items: center;\n  }\n  .fc-spacer-row .down-arrows-group {\n    display: flex;\n    justify-content: center;\n    gap: 0;\n  }\n  .fc-spacer-row .down-arrow-unit {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    width: 130px;\n  }\n  .fc-spacer-row .down-arrow-unit .d-line {\n    width: 2px;\n    height: 16px;\n    background: #999;\n  }\n  .fc-spacer-row .down-arrow-unit .d-tri {\n    width: 0;\n    height: 0;\n    border-left: 7px solid transparent;\n    border-right: 7px solid transparent;\n    border-top: 10px solid #999;\n  }\n  .fc-spacer-row .down-arrow-unit.wide {\n    width: 520px;\n  }\n  .fc-spacer-row .down-arrow-unit.wide .d-line {\n    height: 16px;\n  }\n  .fc-spacer-row .down-arrow-unit.wide .d-tri {\n    border-left-width: 10px;\n    border-right-width: 10px;\n    border-top-width: 14px;\n  }\n</style>\n</head>\n<body>\n\n<h1>第二章：综述的Introduction怎么写？</h1>\n\n<p class=\"intro-text\">\n综述论文的研究目标很清晰，就是对已有文献的概括总结进而提炼、升华。但这并不意味着综述论文就不需要在Introduction部分多下笔墨。其实和普通学术论文一样，综述论文也需要在Introduction里面清晰的交代这篇综述的motivation，novelty和contribution，具体来说：\n</p>\n\n<div class=\"flowchart-container\">\n  <!-- Row 1: Motivation -->\n  <div style=\"display:flex; align-items:center; width:100%; max-width:780px;\">\n    <div style=\"width:140px; flex-shrink:0; display:flex; justify-content:center;\">\n      <div class=\"fc-label\">论文出发点<span class=\"en\">Motivation</span></div>\n    </div>\n    <div style=\"flex:1; display:flex; align-items:center; justify-content:center;\">\n      <div class=\"fc-box blue\">现有研究<br>杂乱分散</div>\n      <span class=\"fc-arrow\"></span>\n      <div class=\"fc-box blue\">现有研究<br>重点失衡</div>\n      <span class=\"fc-arrow\"></span>\n      <div class=\"fc-box blue\">现有研究<br>盲目乐观</div>\n      <span class=\"fc-arrow\">➜</span>\n      <div class=\"fc-box blue\">现有研究<br>成熟/固化</div>\n    </div>\n  </div>\n\n  <!-- Down arrows row 1→2 -->\n  <div style=\"display:flex; justify-content:center; height:34px; width:100%; max-width:780px; align-items:center;\">\n    <div style=\"width:140px; flex-shrink:0;\"></div>\n    <div style=\"flex:1; display:flex; justify-content:center;\">\n      <div style=\"display:flex; flex-direction:column; align-items:center; width:130px;\">\n        <div style=\"width:2px; height:16px; background:#999;\"></div>\n        <div style=\"width:0; height:0; border-left:7px solid transparent; border-right:7px solid transparent; border-top:10px solid #999;\"></div>\n      </div>\n      <div style=\"display:flex; flex-direction:column; align-items:center; width:130px;\">\n        <div style=\"width:2px; height:16px; background:#999;\"></div>\n        <div style=\"width:0; height:0; border-left:7px solid transparent; border-right:7px solid transparent; border-top:10px solid #999;\"></div>\n      </div>\n      <div style=\"display:flex; flex-direction:column; align-items:center; width:130px;\">\n        <div style=\"width:2px; height:16px; background:#999;\"></div>\n        <div style=\"width:0; height:0; border-left:7px solid transparent; border-right:7px solid transparent; border-top:10px solid #999;\"></div>\n      </div>\n      <div style=\"display:flex; flex-direction:column; align-items:center; width:130px;\">\n        <div style=\"width:2px; height:16px; background:#999;\"></div>\n        <div style=\"width:0; height:0; border-left:7px solid transparent; border-right:7px solid transparent; border-top:10px solid #999;\"></div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Row 2: Novelty -->\n  <div style=\"display:flex; align-items:center; width:100%; max-width:780px;\">\n    <div style=\"width:140px; flex-shrink:0; display:flex; justify-content:center;\">\n      <div class=\"fc-label\">论文创新点<span class=\"en\">Novelty</span></div>\n    </div>\n    <div style=\"flex:1; display:flex; align-items:center; justify-content:center;\">\n      <div class=\"fc-box green\">杂乱中<br>找秩序</div>\n      <span class=\"fc-arrow\">➜</span>\n      <div class=\"fc-box green\">偏移中<br>找平衡</div>\n      <span class=\"fc-arrow\">➜</span>\n      <div class=\"fc-box green\">乐观中<br>找谨慎</div>\n      <span class=\"fc-arrow\">➜</span>\n      <div class=\"fc-box green\">成熟中<br>找新意</div>\n    </div>\n  </div>\n\n  <!-- Down arrows row 2→3 -->\n  <div style=\"display:flex; justify-content:center; height:34px; width:100%; max-width:780px; align-items:center;\">\n    <div style=\"width:140px; flex-shrink:0;\"></div>\n    <div style=\"flex:1; display:flex; justify-content:center;\">\n      <div style=\"display:flex; flex-direction:column; align-items:center; width:520px;\">\n        <div style=\"width:2px; height:16px; background:#999;\"></div>\n        <div style=\"width:0; height:0; border-left:10px solid transparent; border-right:10px solid transparent; border-top:14px solid #999;\"></div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Row 3: Contribution -->\n  <div style=\"display:flex; align-items:center; width:100%; max-width:780px;\">\n    <div style=\"width:140px; flex-shrink:0; display:flex; justify-content:center;\">\n      <div class=\"fc-label\">论文贡献点<span class=\"en\">Contribution</span></div>\n    </div>\n    <div style=\"flex:1; display:flex; align-items:center; justify-content:center;\">\n      <div class=\"fc-box large-green\">新框架/新分类/新理论/新视角/…</div>\n    </div>\n  </div>\n</div>\n\n<p class=\"red-text\">科研大喵叫喵大|Paper_the_cat|PDF资料仅在知识星球内部传播</p>\n\n<p class=\"section-text\">\n<strong>Motivation：</strong>即告诉读者你写这篇综述的初衷。这个其实很多套路。\n</p>\n<p class=\"section-text\">\n<strong>套路一：杂乱中找秩序，</strong>因为现有研究方向杂乱分散，所以需要通过综述提出一个清晰的脉络结构以供后来学者参考研究。这是综述论文最常见的motivation；[paper_the_cat|科研大喵叫喵大|PDF资料仅在知识星球内部传播]\n</p>\n<p class=\"section-text\">\n<strong>套路二：偏移中找平衡，</strong>因为现有研究重心偏移，只一味侧重某一方面而忽略了二三四五方面，所以需要做一个着眼全局的更为平衡的综述；[paper_the_cat|科研大喵叫喵大|PDF资料仅在知识星球内部传播]\n</p>\n<p class=\"section-text\">\n<strong>套路三：乐观中找谨慎，</strong>因为现有的研究过于盲目乐观，而忽略了一二三四五等潜在的风险，所以需要针对缺乏研究的那一面做一个综述，以达到矫正现有研究偏差的目的；\n</p>\n<p class=\"section-text\">\n<strong>套路四：成熟中找新意，</strong>因为某一新兴现象快速崛起，相关研究纷繁复杂但缺乏理论基础，所以需要通过概述其他相关也相对成熟的研究领域的发展经验，为这一新兴领域的发展提供参考。\n</p>\n<p class=\"section-text\">\n等等，如此种种，简单来说，就是要告诉读者（reviewer）这篇综述不是为了写而写，而是有其背后的考虑和意义。\n</p>\n\n<p class=\"section-text\">\n<strong>Novelty：</strong>这里就是和motivation息息相关的。针对以上四种套路，相应的novelty就是提出了杂乱中的秩序，引导了偏离中的平衡，强调了乐观中的谨慎，和翻出了成熟中的新意。\n</p>\n\n<p class=\"section-text\">\n<strong>Contribution：</strong>指这篇综述论文的最终成果，比如以下几种，或者是他们的结合：\n</p>\n<ul class=\"bullet-list\">\n  <li>一个新的框架：这个框架可以整体呈现已有文献中多个支流的相对关系，发展过程，内在影响</li>\n  <li>一个新的分类：这个分类方法将现有研究分门别类，在求同存异的基础上达到删繁就简</li>\n  <li>一个新的理论：这个理论是对现有多个理论的整合升级，有更好的解释力</li>\n  <li>一个新的视角：这个视角可以填补已有研究中的空白，即被现有研究忽略</li>\n</ul>\n\n<p class=\"section-text\">\n具体的例子还有很多，<span class=\"highlight\">这里就是要强调，这篇综述绝不仅仅是转述他人已有研究，而是贡献了你，作为该领域的一份子，对于这一领域的新思考新感受。</span>\n</p>\n\n</body>\n</html>",
