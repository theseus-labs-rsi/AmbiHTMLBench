ex-direction: column;\n    align-items: center;\n    gap: 2px;\n  }\n  .caution-icon .placeholder-icon {\n    width: 40px;\n    height: 35px;\n  }\n  .label-no { color: #e84040; font-size: 12px; font-weight: bold; }\n  .label-yes { color: #5cb85c; font-size: 12px; font-weight: bold; }\n  .placeholder {\n    background: #f0f0f0;\n    border: 1px dashed #ccc;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 10px;\n    color: #999;\n    border-radius: 4px;\n  }\n  .icon-row {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    margin-top: 4px;\n  }\n  .icon-row .placeholder {\n    width: 45px;\n    height: 35px;\n  }\n  .section-2 .benefit-item {\n    display: flex;\n    gap: 8px;\n    align-items: flex-start;\n  }\n  .section-2 .benefit-content {\n    flex: 1;\n  }\n  .section-2 .benefit-visual {\n    width: 60px;\n    flex-shrink: 0;\n  }\n  .section-2 .benefit-visual .placeholder {\n    width: 60px;\n    height: 45px;\n  }\n  .caution-full {\n    display: grid;\n    grid-template-columns: 1fr 1fr 1fr;\n    gap: 8px;\n    margin-top: 8px;\n  }\n  .caution-full .caution-item {\n    text-align: center;\n  }\n  .caution-full .caution-text {\n    font-size: 11px;\n  }\n  .caution-full .icon-row {\n    justify-content: center;\n  }\n  .caution-full .placeholder {\n    width: 40px;\n    height: 32px;\n  }\n  .tip-icon {\n    float: right;\n    width: 40px;\n    height: 35px;\n    margin-left: 8px;\n  }\n  .tip-item::after {\n    content: \"\";\n    display: table;\n    clear: both;\n  }\n</style>\n</head>\n<body>\n\n<div class=\"main-title\">宝宝米粉添加指南</div>\n\n<div class=\"grid\">\n\n  <!-- Section 1 -->\n  <div class=\"section\">\n    <div class=\"section-header\">\n      <div class=\"section-number num-1\">1</div>\n      <div class=\"section-title\">不同阶段宝宝米粉选择</div>\n    </div>\n    <p class=\"intro-text\">每个阶段宝宝对辅食的营养需求会存在差异，根据宝宝生长发育选择分阶段米粉，为宝宝提供更精准更科学的营养。</p>\n\n    <div class=\"stage-block stage-1\">\n      <div class=\"stage-title\">第一阶段：宝宝能坐了</div>\n      <div class=\"stage-age\">6个月</div>\n      <div class=\"stage-text\">\n        宝宝可以辅助靠坐些——这时添加1阶米粉。<br>\n        1段米粉含铁高，粉质细腻好吸收。<br>\n        适应后开始添加蔬菜和水果泥。\n      </div>\n    </div>\n\n    <div class=\"stage-block stage-2\">\n      <div class=\"stage-title\">第二阶段：宝宝能爬了</div>\n      <div class=\"stage-age\">8个月</div>\n      <div class=\"stage-text\">\n        宝宝每牙期——这时可添加2阶米粉。<br>\n        2段米粉在1段基础上会添加一些蔬果颗粒，用以启蒙咀嚼<br>\n        另外维生素D可促进钙吸收。\n      </div>\n    </div>\n\n    <div class=\"stage-block stage-3\">\n      <div class=\"stage-title\">第三阶段：宝宝能跑了</div>\n      <div class=\"stage-age\">10个月</div>\n      <div class=\"stage-text\">\n        宝宝会爬行——这时可添加3阶米粉。<br>\n        3段米粉相比2段米粉添加了多种更大的果蔬颗粒，以此<br>\n        强化锻炼宝宝咀嚼力；并且多种食材搭配，口感丰富，<br>\n        更能激发宝宝的味蕾，让宝宝爱上吃\n      </div>\n    </div>\n  </div>\n\n  <!-- Section 2 -->\n  <div class=\"section section-2\">\n    <div class=\"section-header\">\n      <div class=\"section-number num-2\">2</div>\n      <div class=\"section-title\">宝宝吃米粉的好处</div>\n    </div>\n\n    <div class=\"benefit-item\">\n      <div class=\"benefit-content\">\n        <div class=\"benefit-title\">1、补充乳类中不足的营养</div>\n        <div class=\"benefit-text\">添加米粉等辅食，可以及时补充乳类中铁和维生素D的不足。</div>\n      </div>\n      <div class=\"benefit-visual\">\n        <div class=\"placeholder\">[Icon: bowl + Vc]</div>\n      </div>\n    </div>\n\n    <div class=\"benefit-item\">\n      <div class=\"benefit-content\">\n        <div class=\"benefit-title\">2、训练宝宝的吞咽能力</div>\n        <div class=\"benefit-text\">宝宝可以从吃糊状、细软的食品开始，逐步适应，接受成人的吃的固体食物。</div>\n      </div>\n      <div class=\"benefit-visual\">\n        <div class=\"placeholder\">[Icon: baby eating]</div>\n      </div>\n    </div>\n\n    <div class=\"benefit-item\">\n      <div class=\"benefit-content\">\n        <div class=\"benefit-title\">3、为断奶做准备</div>\n        <div class=\"benefit-text\">辅食逐渐取代乳类，让宝宝逐渐由吸食乳类变为用成人的方式咀嚼食物。</div>\n      </div>\n      <div class=\"benefit-visual\">\n        <div class=\"placeholder\">[Icon: baby]</div>\n      </div>\n    </div>\n\n    <div class=\"benefit-item\">\n      <div class=\"benefit-content\">\n        <div class=\"benefit-title\">4、开启宝宝智力</div>\n        <div class=\"benefit-text\">添加辅食可以给予宝宝多种刺激，进而达到启迪智力的目的。</div>\n      </div>\n      <div class=\"benefit-visual\">\n        <div class=\"placeholder\">[Icon: brain]</div>\n      </div>\n    </div>\n\n    <div class=\"benefit-item\">\n      <div class=\"benefit-content\">\n        <div class=\"benefit-title\">5、训练咀嚼能力</div>\n        <div class=\"benefit-text\">及时添加辅食有利于训练宝宝的咀嚼功能，有利于颌骨的发育和牙齿的萌出。</div>\n      </div>\n      <div class=\"benefit-visual\">\n        <div class=\"placeholder\">[Icon: teeth]</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Section 3 -->\n  <div class=\"section\">\n    <div class=\"section-header\">\n      <div class=\"section-number num-3\">3</div>\n      <div class=\"section-title\">如何挑选宝宝米粉</div>\n    </div>\n\n    <div class=\"tip-item\">\n      <div class=\"tip-title\">1、选择品牌产品</div>\n      <div class=\"tip-text\">建议选择大品牌、口碑好的产品，其质量相对而更有保障。</div>\n      <div class=\"placeholder tip-icon\">[Icon: box]</div>\n    </div>\n\n    <div class=\"tip-item\">\n      <div class=\"tip-title\">2、查看产品标识</div>\n      <div class=\"tip-text\">看一看正常商品应该有的标识是否齐全，宝宝产品特有的标志以及说明是否印在包装上。</div>\n      <div class=\"placeholder tip-icon\">[Icon: label S]</div>\n    </div>\n\n    <div class=\"tip-item\">\n      <div class=\"tip-title\">3、查看营养成分表</div>\n      <div class=\"tip-text\">查看所含的具体营养成分及其含量是否在合理范围内。</div>\n      <div class=\"placeholder tip-icon\">[Icon: chart]</div>\n    </div>\n\n    <div class=\"tip-item\">\n      <div class=\"tip-title\">4、查看包装说明</div>\n      <div class=\"tip-text\">查看外包装上是否有提示性说明，比如断奶期补充食品。</div>\n      <div class=\"placeholder tip-icon\">[Icon: package]</div>\n    </div>\n\n    <div class=\"tip-item\">\n      <div class=\"tip-title\">5、看颜色与气味</div>\n      <div class=\"tip-text\">正常米粉呈白色，大小均匀，香味纯正，散发米粉特有的香味，且无其他异味。</div>\n      <div class=\"placeholder tip-icon\">[Icon: bowl]</div>\n    </div>\n\n    <div class=\"tip-item\">\n      <div class=\"tip-title\">6、看组织形态和冲调性</div>\n      <div class=\"tip-text\">其性状应松散无结块，冲调后为泥糊状。</div>\n      <div class=\"placeholder tip-icon\">[Icon: spoon]</div>\n    </div>\n  </div>\n\n  <!-- Section 4 -->\n  <div class=\"section\">\n    <div class=\"section-header\">\n      <div class=\"section-number num-4\">4</div>\n      <div class=\"section-title\">宝宝吃米粉的注意事项</div>\n    </div>\n\n    <div class=\"caution-grid\">\n      <div class=\"caution-item\">\n        <div class=\"caution-text\">1、冲调米粉水温不宜过高，用烧开的水晾到40-50度左右冲调米粉为宜</div>\n        <div class=\"caution-icons\">\n          <div class=\"caution-icon\">\n            <div class=\"placeholder\" style=\"width:36px;height:30px;\">[Icon: thermometer high]</div>\n            <span class=\"label-no\">No</span>\n          </div>\n          <div class=\"caution-icon\">\n            <div class=\"placeholder\" style=\"width:36px;height:30px;\">[Icon: thermometer ok]</div>\n            <span class=\"label-yes\">Yes</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"caution-item\">\n        <div class=\"caution-text\">2、调米粉时不要用勺子喂，不建议用奶瓶</div>\n        <div class=\"caution-icons\">\n          <div class=\"caution-icon\">\n            <div class=\"placeholder\" style=\"width:36px;height:30px;\">[Icon: bottle]</div>\n            <span class=\"label-no\">No</span>\n          </div>\n          <div class=\"caution-icon\">\n            <div class=\"placeholder\" style=\"width:36px;height:30px;\">[Icon: spoon feed]</div>\n            <span class=\"label-yes\">Yes</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"caution-item\">\n        <div class=\"caution-text\">3、选择营养含量多的配方米粉，不添加糖和食盐</div>\n        <div class=\"caution-icons\">\n          <div class=\"caution-icon\">\n            <div class=\"placeholder\" style=\"width:36px;height:30px;\">[Icon: sugar/salt]</div>\n            <span class=\"label-no\">No</span>\n          </div>\n          <div class=\"caution-icon\">\n            <div class=\"placeholder\" style=\"width:36px;height:30px;\">[Icon: nutrition box]</div>\n            <span class=\"label-yes\">Yes</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"caution-item\">\n        <div class=\"caution-text\">4、不宜把米粉当成正餐，以免无法满足婴儿生长发育需要</div>\n        <div class=\"caution-icons\">\n          <div class=\"caution-icon\">\n            <div class=\"placeholder\" style=\"width:36px;height:30px;\">[Icon: bowl only]</div>\n            <span class=\"label-no\">No</span>\n          </div>\n          <div class=\"caution-icon\">\n            <div class=\"placeholder\" style=\"width:36px;height:30px;\">[Icon: balanced meal]</div>\n            <span class=\"label-yes\">Yes</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"caution-item\">\n        <div class=\"caution-text\">5、调制米粉应先稀后逐渐增加稠度</div>\n        <div class=\"caution-icons\">\n          <div class=\"caution-icon\">\n            <div class=\"placeholder\" style=\"width:36px;height:30px;\">[Icon: thick]</div>\n            <span class=\"label-no\">No</span>\n          </div>\n          <div class=\"caution-icon\">\n            <div class=\"placeholder\" style=\"width:36px;height:30px;\">[Icon: thin to thick]</div>\n            <span class=\"label-yes\">Yes</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"caution-item\">\n        <div class=\"caution-text\">6、首次喂1-2勺，宝宝适应后增加到3-4勺，每天喂1-2次</div>\n        <div class=\"caution-icons\">\n          <div class=\"caution-icon\">\n            <div class=\"placeholder\" style=\"width:36px;height:30px;\">[Icon: many spoons]</div>\n            <span class=\"label-no\">No</span>\n          </div>\n          <div class=\"caution-icon\">\n            <div class=\"placeholder\" style=\"width:36px;height:30px;\">[Icon: few spoons]</div>\n            <span class=\"label-yes\">Yes</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n</div>\n\n</body>\n</html>",
