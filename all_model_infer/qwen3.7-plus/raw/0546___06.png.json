dsymbol{q}_n = [0.85, 1.50, 1.57, -1.65, -1.50, 1.57, 2.50]\\)\n      </td>\n      <td>\n        \\(T_0 = 1\\text{e}{-2}\\)<br>\n        \\(z_0 = \\sqrt{2T_0}\\)<br>\n        \\(\\bar{T} = 1\\text{e}{-2}\\)<br>\n        \\(T_\\epsilon = 5\\text{e}{-4}\\)<br>\n        \\(\\boldsymbol{\\Lambda} = \\text{diag}\\{50, 50, 0, 0, 0, 0\\}\\)\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n<div class=\"figures-row\">\n  <div class=\"figure-block\">\n    <!-- Fig 9a: Tank energy T -->\n    <div class=\"plot-container\">\n      <svg viewBox=\"0 0 400 180\" xmlns=\"http://www.w3.org/2000/svg\">\n        <rect x=\"50\" y=\"10\" width=\"330\" height=\"140\" fill=\"white\" stroke=\"#ccc\" stroke-width=\"0.5\"/>\n        <!-- Shaded region -->\n        <rect x=\"155\" y=\"10\" width=\"30\" height=\"140\" class=\"shaded-region\"/>\n        <!-- Grid lines -->\n        <line x1=\"50\" y1=\"80\" x2=\"380\" y2=\"80\" stroke=\"#eee\" stroke-width=\"0.5\"/>\n        <line x1=\"215\" y1=\"10\" x2=\"215\" y2=\"150\" stroke=\"#eee\" stroke-width=\"0.5\"/>\n        <line x1=\"300\" y1=\"10\" x2=\"300\" y2=\"150\" stroke=\"#eee\" stroke-width=\"0.5\"/>\n        <!-- Y axis labels -->\n        <text x=\"45\" y=\"18\" font-size=\"8\" text-anchor=\"end\">10</text>\n        <text x=\"45\" y=\"83\" font-size=\"8\" text-anchor=\"end\">5</text>\n        <text x=\"10\" y=\"85\" font-size=\"9\" text-anchor=\"middle\" transform=\"rotate(-90,10,85)\">\\(T\\)</text>\n        <text x=\"75\" y=\"8\" font-size=\"7\">×10⁻³</text>\n        <!-- X axis labels -->\n        <text x=\"50\" y=\"162\" font-size=\"8\" text-anchor=\"middle\">0</text>\n        <text x=\"215\" y=\"162\" font-size=\"8\" text-anchor=\"middle\">5</text>\n        <text x=\"300\" y=\"162\" font-size=\"8\" text-anchor=\"middle\">10</text>\n        <text x=\"380\" y=\"162\" font-size=\"8\" text-anchor=\"middle\">15</text>\n        <text x=\"215\" y=\"175\" font-size=\"9\" text-anchor=\"middle\">\\(t\\) [s]</text>\n        <!-- Plot line -->\