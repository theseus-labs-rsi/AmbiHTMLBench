        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>人民日报 2025年1月9日 第5版 评论</title>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  body {\n    font-family: \"SimSun\", \"Songti SC\", \"STSong\", serif;\n    background: #f5f5f0;\n    color: #1a1a1a;\n    max-width: 1100px;\n    margin: 0 auto;\n    padding: 10px;\n    font-size: 14px;\n    line-height: 1.7;\n  }\n  .page {\n    background: #fff;\n    padding: 20px 25px;\n    border: 1px solid #ccc;\n  }\n  .header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    border-bottom: 3px double #c00;\n    padding-bottom: 8px;\n    margin-bottom: 10px;\n  }\n  .header-left {\n    display: flex;\n    align-items: center;\n    gap: 15px;\n  }\n  .newspaper-name {\n    font-family: \"STKaiti\", \"KaiTi\", serif;\n    font-size: 36px;\n    font-weight: bold;\n    color: #c00;\n    letter-spacing: 4px;\n  }\n  .header-right {\n    text-align: right;\n    font-size: 14px;\n  }\n  .header-right .date { font-size: 14px; }\n  .header-right .page-num {\n    font-size: 28px;\n    font-weight: bold;\n    color: #c00;\n  }\n  .header-right .section-name {\n    font-size: 22px;\n    font-weight: bold;\n    color: #c00;\n  }\n  .main-layout {\n    display: grid;\n    grid-template-columns: 1fr 280px;\n    gap: 20px;\n  }\n  .left-content {\n    border-right: 1px solid #ddd;\n    padding-right: 20px;\n  }\n  .right-content {\n    padding-left: 5px;\n  }\n  .section-label {\n    display: inline-block;\n    background: #c00;\n    color: #fff;\n    padding: 2px 10px;\n    font-size: 13px;\n    font-weight: bold;\n    margin-bottom: 8px;\n    border-radius: 2px;\n  }\n  .section-label-warm {\n    display: inline-block;\n    background: #c00;\n    color: #fff;\n    padding: 2px 10px;\n    font-size: 13px;\n    font-weight: bold;\n    margin-bottom: 8px;\n    borde