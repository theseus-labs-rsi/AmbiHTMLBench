x;\n  }\n\n  .content-with-image {\n    display: flex;\n    gap: 20px;\n    margin-bottom: 20px;\n  }\n  .content-with-image .text-col {\n    flex: 1;\n  }\n  .content-with-image .img-col {\n    width: 200px;\n    flex-shrink: 0;\n  }\n\n  .placeholder-img {\n    width: 100%;\n    height: 160px;\n    background: #f5f5f5;\n    border: 1px solid #ddd;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 12px;\n    color: #999;\n    border-radius: 4px;\n    margin-bottom: 8px;\n  }\n  .placeholder-img.cert {\n    height: 180px;\n  }\n  .placeholder-img.stove {\n    height: 120px;\n    background: #222;\n  }\n  .placeholder-img.water {\n    height: 180px;\n  }\n\n  .img-caption {\n    font-size: 13px;\n    color: #666;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n  }\n  .img-caption::before {\n    content: \"●\";\n    color: #6b4c9a;\n    font-size: 10px;\n  }\n\n  .body-text {\n    font-size: 14px;\n    line-height: 2;\n    color: #444;\n    text-align: justify;\n  }\n\n  .body-text sup {\n    font-size: 10px;\n    color: #6b4c9a;\n  }\n\n  /* Page heading */\n  .page-heading {\n    font-size: 22px;\n    font-weight: 700;\n    color: #333;\n    margin-bottom: 20px;\n  }\n\n  /* Chart section */\n  .chart-title {\n    text-align: center;\n    font-size: 16px;\n    color: #6b4c9a;\n    margin: 30px 0 24px;\n    font-weight: 600;\n  }\n  .chart-title sup {\n    font-size: 11px;\n  }\n\n  .data-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 16px;\n    margin-bottom: 30px;\n  }\n  .data-grid .full-width {\n    grid-column: 1 / -1;\n  }\n\n  .data-card {\n    background: #f8f6fb;\n    border-radius: 8px;\n    padding: 20px 24px;\n    position: relative;\n    overflow: hidden;\n  }\n  .data-card::after {\n    content: \"\";\n    position: absolute;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    height: 30px;\n    background: repeating-linear-gradient(\n      90deg,\n      transparent,\n      transparent 8px,\n      #e8e0f0 8px,\n      #e8e0f0 10px\n    );\n    opacity: 0.5;\n  }\n  .data-card .label {\n    font-size: 14px;\n    color: #666;\n    margin-bottom: 6px;\n  }\n  .data-card .label sup {\n    font-size: 10px;\n    color: #6b4c9a;\n  }\n  .data-card .value {\n    font-size: 32px;\n    font-weight: 700;\n    color: #6b4c9a;\n  }\n\n  /* Footnotes */\n  .footnotes {\n    margin-top: 30px;\n    padding-top: 16px;\n    border-top: 1px solid #e0e0e0;\n    font-size: 12px;\n    color: #888;\n    line-height: 1.8;\n  }\n  .footnotes p {\n    margin-bottom: 4px;\n  }\n  .footnotes sup {\n    color: #6b4c9a;\n  }\n\n  .page-number {\n    position: absolute;\n    bottom: 30px;\n    font-size: 13px;\n    color: #333;\n  }\n  .page-left .page-number { left: 50px; }\n  .page-right .page-number { right: 50px; }\n\n  .separator-line {\n    width: 80px;\n    height: 2px;\n    background: #6b4c9a;\n    margin: 20px 0;\n  }\n\n  .intro-text {\n    font-size: 14px;\n    line-height: 2;\n    color: #444;\n    margin-bottom: 24px;\n  }\n\n  .three-col-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr 1fr;\n    gap: 16px;\n  }\n</style>\n</head>\n<body>\n<div class=\"spread\">\n  <!-- Page 93 -->\n  <div class=\"page page-left\">\n    <div class=\"header-left\">2024 · 美的集团ESG报告</div>\n\n    <div class=\"section-title-bar\">\n      <div class=\"section-icon\">☰</div>\n      <h2>低碳属性</h2>\n    </div>\n\n    <div class=\"content-block\">\n      <div class=\"subsection-title\">低碳材料：R290环保制冷剂空调产品</div>\n      <div class=\"content-with-image\">\n        <div class=\"text-col\">\n          <p class=\"body-text\">\n            截至2024年底，美的空调累计销售的分体式空调、移动空调、除湿机等R290环保制冷剂<sup>7</sup>产品能够实现温室气体减排约439万吨二氧化碳当量<sup>8</sup>，相当于521万公顷亚马逊热带雨林一年的二氧化碳吸收量<sup>9</sup>。世界权威调研机构欧睿国际2023、2024年连续两年为我们颁发全球第一 R290 空调制造商认证。\n          </p>\n        </div>\n        <div class=\"img-col\">\n          <div class=\"placeholder-img cert\">\n            <div style=\"text-align:center;\">\n              <div style=\"font-size:11px;color:#666;\">Midea</div>\n              <div style=\"font-size:10px;color:#666;margin-top:4px;\">Midea Is The<br>World's No.1 R290 Air<br>Conditioner Company</div>\n              <div style=\"font-size:9px;color:#999;margin-top:8px;\">[Certificate Image]</div>\n            </div>\n          </div>\n          <div class=\"img-caption\">全球第一 R290 空调制造商认证</div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"content-block\">\n      <div class=\"subsection-title\">低碳技术：美的 Q69-F燃气灶</div>\n      <div class=\"content-with-image\">\n        <div class=\"text-col\">\n          <p class=\"body-text\">\n            该产品采用三段式台阶型面和空气环回热结构，在无送风机条件下能够实现80%热效率。本年度已出售的该产品相比同类型其他产品，预计可节约天然气约11,169万立方米，减少二氧化碳排放约24.2万吨。\n          </p>\n        </div>\n        <div class=\"img-col\">\n          <div class=\"placeholder-img stove\">\n            <div style=\"text-align:center;color:#aaa;font-size:12px;\">[Gas Stove Image]</div>\n          </div>\n          <div class=\"img-caption\">美的 Q69-F燃气灶</div>\n        </div>\n      </div>\n    </div>\n\n    <p class=\"intro-text\">\n      同时，为更准确地了解产品生命周期所产生的影响，我们从资源使用、生态后果、人体健康影响等维度对产品逐步开展评估，旨在根据评估结果有针对性地改进产品。\n    </p>\n\n    <h2 class=\"page-heading\">产品水足迹评估</h2>\n\n    <div class=\"content-with-image\">\n      <div class=\"text-col\">\n        <p class=\"body-text\">\n          本年度，我们参考ISO 14046《环境管理-水足迹-原则、要求和指南》的原则、要求和方法论，对外销滚筒洗衣机产品的原材料获取、制造、分销、使用、回收与处置等各阶段造成的水资源稀缺足迹及水劣化足迹<sup>10</sup>进行系统化评估。评估结果有效识别外销滚筒洗衣机产品全生命周期不同阶段减少水消耗与水污染影响的机会，并帮助研发人员在产品设计层面挖掘节水、节能、减少洗涤剂等技术突破方向，以促进产品全面提升水资源效益。\n        </p>\n      </div>\n      <div class=\"img-col\">\n        <div class=\"placeholder-img water\">\n          <div style=\"text-align:center;color:#999;font-size:11px;\">[Water Footprint<br>Certificate Images]</div>\n        </div>\n        <div class=\"img-caption\">产品水足迹核查声明</div>\n      </div>\n    </div>\n\n    <div class=\"separator-line\"></div>\n\n    <div class=\"footnotes\">\n      <p><sup>7</sup> R290环保制冷剂为一种无氟、无氯、低碳环保的天然制冷剂。</p>\n      <p><sup>8</sup> 数据根据 2018 年 1 月至 2024 年 12 月期间销售的每款 R290 产品销量和每台套产品制冷剂的碳减排量计算得出。每台套产品制冷剂的碳减排量 =（R290 替换前制冷剂 GWP x 替换前产品制冷剂充注量 - R290 制冷剂 GWP x R290 充注量）。</p>\n      <p><sup>9</sup> 固碳量按照每公顷0.8433吨/年计算。 参考文献 Hubau, W. et al. Asynchronous carbon sink saturation in African and Amazonian tropical forests. Nature 579, 80-87 (2020)。</p>\n      <p><sup>10</sup> 水劣化足迹包括：水酸化足迹、淡水富营养化足迹、海水富营养化足迹、淡水生态毒性足迹等。</p>\n    </div>\n\n    <div class=\"page-number\">93</div>\n  </div>\n\n  <!-- Page 94 -->\n  <div class=\"page page-right\">\n    <div class=\"header-right\">\n      <a href=\"#\">关于本报告</a>\n      <a href=\"#\">走进美的</a>\n      <a href=\"#\">可持续发展治理</a>\n      <a href=\"#\">守护蓝色星球</a>\n      <a href=\"#\">构建和谐社区</a>\n      <a href=\"#\" class=\"active\">践行科技尽善</a>\n      <a href=\"#\">共创繁荣生态</a>\n      <a href=\"#\">附录</a>\n    </div>\n\n    <h2 class=\"page-heading\">产品碳足迹评估</h2>\n\n    <p class=\"body-text\" style=\"margin-bottom: 20px;\">\n      本年度，为规范产品使用阶段温室气体排放核算口径及方法，我们制定通用标准《美的集团组织层面（范围三）温室气体排放核算指南-已售出产品的使用》，并依据该标准的方法论，对7类典型产品使用阶段温室气体排放量进行核算，以更准确地了解已售出产品使用阶段的温室气体排放量。未来，我们将持续推进主要品类产品使用阶段温室气体排放全量核算，并基于核算结果，有针对性地规划温室气体减排实施路径。\n    </p>\n\n    <div class=\"chart-title\">使用阶段温室气体排放（万吨二氧化碳当量）<sup>11</sup></div>\n\n    <div class=\"data-grid\">\n      <div class=\"data-card\">\n        <div class=\"label\">家用空调产品<sup>12</sup></div>\n        <div class=\"value\">14,271.09</div>\n      </div>\n      <div class=\"data-card\">\n        <div class=\"label\">洗衣机产品<sup>13</sup></div>\n        <div class=\"value\">1,043.56</div>\n      </div>\n    </div>\n\n    <div class=\"three-col-grid\" style=\"margin-bottom:16px;\">\n      <div class=\"data-card\">\n        <div class=\"label\">冰箱产品<sup>14</sup></div>\n        <div class=\"value\">743.14</div>\n      </div>\n      <div class=\"data-card\">\n        <div class=\"label\">商用多联机产品<sup>15</sup></div>\n        <div class=\"value\">103.73</div>\n      </div>\n      <div class=\"data-card\">\n        <div class=\"label\">热水器产品<sup>16</sup></div>\n        <div class=\"value\">1,429.05</div>\n      </div>\n    </div>\n\n    <div class=\"data-grid\">\n      <div class=\"data-card\">\n        <div class=\"label\">电饭煲产品<sup>17</sup></div>\n        <div class=\"value\">682.25</div>\n      </div>\n      <div class=\"data-card\">\n        <div class=\"label\">微波炉产品<sup>18</sup></div>\n        <div class=\"value\">368.37</div>\n      </div>\n    </div>\n\n    <div class=\"footnotes\">\n      <p><sup>11</sup> 产品使用阶段温室气体排放核算公式=[产品销售量×参考使用寿命×(年综合耗电量×电力碳足迹因子+年综合耗水量×水碳足迹因子)]。其中，参考使用寿命参照《家用电器安全使用年限 第3部分：房间空气调节器》《家用和类似用途电动洗衣机》等标准文件；综合耗电量及耗水量依据国标标准工况下的测试结果；电力碳足迹因子采用生态环境部、国家统计局、国家能源局联合发布《关于发布2023年电力碳足迹因子数据的公告》中的全国电力平均碳足迹因子；水碳足迹因子来自于GaBi数据库。</p>\n      <p><sup>12</sup> 家用空调产品核算范围：2024年度，国内销售的全量房间空气调节器（GB/T 7725-2022）产品。</p>\n      <p><sup>13</sup> 洗衣机产品核算范围：2024年度，国内销售的3个品类（滚筒、双桶、全自动）全量洗衣机产品。</p>\n      <p><sup>14</sup> 冰箱产品核算范围：2024年度，国内销售的全量冰箱产品，不包括冷柜等其他产品。</p>\n      <p><sup>15</sup> 商用多联机产品核算范围：2024年度，国内销售的MDV系列多联机产品。</p>\n      <p><sup>16</sup> 热水器产品核算范围：2024年度，国内外销售的全量电热水器及燃气热水器产品。</p>\n      <p><sup>17</sup> 电饭煲产品核算范围：2024年度，国内销售的全量电饭煲产品。</p>\n      <p><sup>18</sup> 微波炉产品核算范围：2024年度，国内销售的全量微波炉产品。</p>\n    </div>\n\n    <div class=\"page-number\">94</div>\n  </div>\n</div>\n</body>\n</html>",
