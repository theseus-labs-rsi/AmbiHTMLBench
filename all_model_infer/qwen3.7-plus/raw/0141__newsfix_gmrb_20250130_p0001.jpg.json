Two column layout for articles */\n  .two-col {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 15px;\n    margin-bottom: 15px;\n  }\n  .col-article {\n    padding: 10px;\n  }\n  .col-article h3 {\n    font-size: 24px;\n    font-weight: bold;\n    text-align: center;\n    margin-bottom: 5px;\n    writing-mode: vertical-rl;\n    float: left;\n    height: 200px;\n    margin-right: 10px;\n    letter-spacing: 5px;\n  }\n  .col-article .content {\n    overflow: hidden;\n  }\n  .col-article p {\n    text-indent: 2em;\n    font-size: 13px;\n    line-height: 1.8;\n    margin-bottom: 6px;\n    text-align: justify;\n  }\n  /* Wish box */\n  .wish-box {\n    background: #fdf2f2;\n    border: 2px solid #e74c3c;\n    border-radius: 8px;\n    padding: 15px;\n    margin: 15px 0;\n    display: flex;\n    gap: 15px;\n    align-items: center;\n  }\n  .wish-box .wish-icon {\n    width: 80px;\n    height: 80px;\n    background: #e74c3c;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #fff;\n    font-size: 14px;\n    text-align: center;\n    flex-shrink: 0;\n    writing-mode: vertical-rl;\n  }\n  .wish-box .wish-content {\n    flex: 1;\n  }\n  .wish-box .wish-content h4 {\n    color: #c0392b;\n    font-size: 16px;\n    margin-bottom: 5px;\n  }\n  .wish-box .wish-content p {\n    font-size: 13px;\n    line-height: 1.7;\n    color: #555;\n  }\n  /* Article with large title */\n  .feature-article {\n    margin: 15px 0;\n    padding: 15px;\n    border-top: 2px solid #333;\n    border-bottom: 1px solid #ddd;\n  }\n  .feature-article .source {\n    font-size: 12px;\n    color: #666;\n    margin-bottom: 5px;\n  }\n  .feature-article h3 {\n    font-size: 26px;\n    font-weight: bold;\n    text-align: center;\n    margin-bottom: 10px;\n  }\n  .feature-article p {\n    text-indent: 2em;\n    font-size: 13px;\n    line-height: 1.8;\n    margin-bottom: 6px;\n    text-align: justify;\n  }\n  .feature-article .editor 