e-height: 1.65;\n    font-size: 15px;\n  }\n  .star-icon {\n    color: #e8a020;\n    font-size: 16px;\n    margin-right: 6px;\n    flex-shrink: 0;\n    margin-top: 2px;\n  }\n  .star-text {\n    flex: 1;\n  }\n  .highlight {\n    font-weight: bold;\n  }\n</style>\n</head>\n<body>\n\n<div class=\"title\">\n  <span class=\"red\">关于北京</span><span class=\"black\">打卡攻略</span>\n</div>\n<hr class=\"divider\">\n\n<div class=\"section\">\n  <div class=\"section-header\">\n    <span class=\"check-icon\">✓</span>\n    <span class=\"section-title\">怎么到北京</span>\n  </div>\n  <div class=\"item\">\n    <span class=\"num-badge\">1</span>\n    <span class=\"item-text\">北京机场：首都国际机场/大兴国际机场，其中首都国际机场离市区比较近，机场都有公交/地铁/大巴到市区</span>\n  </div>\n  <div class=\"item\">\n    <span class=\"num-badge\">2</span>\n    <span class=\"item-text\">首都国际机场：距离市区约20km，地铁机场线可直达</span>\n  </div>\n  <div class=\"item\">\n    <span class=\"num-badge\">3</span>\n    <span class=\"item-text\">大兴国际机场：离市区约47km，地铁机场线可以直达</span>\n  </div>\n  <div class=\"item\">\n    <span class=\"num-badge\">4</span>\n    <span class=\"item-text\">火车站：有5个火车站，其中北京南站、北京站、北京西站是高铁站，建议选高铁</span>\n  </div>\n</div>\n\n<div class=\"section\">\n  <div class=\"section-header\">\n    <span class=\"check-icon\">✓</span>\n    <span class=\"section-title\">北京市内交通</span>\n  </div>\n  <div class=\"item\">\n    <span class=\"num-badge\">1</span>\n    <span class=\"item-text\">北京乘车码：可下载或者ZFB搜索【北京一卡通】和【亿通行】乘坐公交地铁，均可扫码支付，乘车有优惠。</span>\n  </div>\n  <div class=\"item\">\n    <span class=\"num-badge\">2</span>\n    <span class=\"item-text\">公交：部分公交线路，以分段式收费，上下车都要扫码；公交卡1元，ZFB可能有有优惠；投币2元</span>\n  </div>\n  <div class=\"item\">\n    <span class=\"num-badge\">3</span>\n    <span class=\"item-text\">地铁：3元起步价按里程收费，最高7元，5点-23点有车</span>\n  </div>\n  <div class=\"item\">\n    <span class=\"num-badge\">4</span>\n    <span class=\"item-text\">打车：出租车3公里内起步价14元，超出2.3元/公里，夜间加20% 网约车建议到商圈/车站500米外再定位叫车</span>\n  </div>\n  <div class=\"item\">\n    <span class=\"num-badge\">5</span>\n    <span class=\"item-text\">汽车：北京的汽车站超级多，离北京近的可以坐汽车，远的就不推荐了，另外晕车的小伙伴记得备好晕车药</span>\n  </div>\n  <div class=\"item\">\n    <span class=\"num-badge\">6</span>\n    <span class=\"item-text\">共享电动车：10公里内建议，车多人多注意安全，但是天安门广场附近的区域是不让进的</span>\n  </div>\n</div>\n\n<div class=\"section\">\n  <div class=\"section-header\">\n    <span class=\"check-icon\">✓</span>\n    <span class=\"section-title\">北京6-8月天气</span>\n  </div>\n  <div class=\"star-item\">\n    <span class=\"star-icon\">★</span>\n    <span class=\"star-text\">6月平均温度是21℃～32℃</span>\n  </div>\n  <div class=\"star-item\">\n    <span class=\"star-icon\">★</span>\n    <span class=\"star-text\">7月平均温度是23℃～32℃</span>\n  </div>\n  <div class=\"star-item\">\n    <span class=\"star-icon\">★</span>\n    <span class=\"star-text\">8月平均温度是21℃～32℃</span>\n  </div>\n  <div class=\"star-item\">\n    <span class=\"star-icon\">★</span>\n    <span class=\"star-text\">建议穿搭：穿棉麻面料的衬衫、薄长裙、薄T恤，早晚有温差，带上套装、夹衣、风衣、休闲装、夹克衫、西装、薄毛衣等衣服</span>\n  </div>\n</div>\n\n</body>\n</html>",
