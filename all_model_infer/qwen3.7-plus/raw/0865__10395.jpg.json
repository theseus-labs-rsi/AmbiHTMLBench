t-size: 12px; }\n</style>\n</head>\n<body>\n\n<!-- Header -->\n<div class=\"header\">\n  <div class=\"page-num\">4</div>\n  <div class=\"section-title\">求是苑·剪影</div>\n  <div class=\"header-info\">\n    <div class=\"date\">2018年9月14日 星期五</div>\n    <div>责任编辑：张岚 联系电话：0571-88981339</div>\n  </div>\n  <div class=\"newspaper-name\">\n    <div class=\"cn\">浙江大学报</div>\n    <div class=\"en\">ZHE JIANG DA XUE BAO</div>\n  </div>\n</div>\n\n<!-- Top photos row -->\n<div class=\"top-photos\">\n  <div class=\"top-photo-item\">\n    <div class=\"caption\">汗水流过坚毅的脸庞</div>\n    <div class=\"photographer\">陈佳轩 摄</div>\n    <div class=\"top-photo-placeholder img-placeholder\">[Photo: 汗水流过坚毅的脸庞]</div>\n  </div>\n  <div class=\"top-photo-item\">\n    <div class=\"caption\">挥旗</div>\n    <div class=\"photographer\">施良辰 摄</div>\n    <div class=\"top-photo-placeholder img-placeholder\">[Photo: 挥旗]</div>\n  </div>\n  <div class=\"top-photo-item\">\n    <div class=\"caption\">别担心，我不累</div>\n    <div class=\"photographer\">梁汉卿 摄</div>\n    <div class=\"top-photo-placeholder img-placeholder\">[Photo: 别担心，我不累]</div>\n  </div>\n  <div class=\"top-photo-item\">\n    <div class=\"caption\">关怀</div>\n    <div class=\"photographer\">何念泽 摄</div>\n    <div class=\"top-photo-placeholder img-placeholder\">[Photo: 关怀]</div>\n  </div>\n</div>\n\n<!-- Main Title -->\n<div class=\"main-title\">\n  <h1>在军训中磨砺青春</h1>\n  <div class=\"subtitle\">——浙江大学2018年学生军训掠影</div>\n</div>\n\n<!-- Content Area -->\n<div class=\"content-area\">\n  <div class=\"left-col\">\n    <div class=\"large-photo img-placeholder\">[Photo: 在校园的每个角落练习着军姿 - 陈佳轩 摄]</div>\n    <div class=\"photo-caption\">\n      在校园的每个角落练习着<br>军姿 &nbsp;&nbsp;&nbsp;&nbsp; 陈佳轩 摄\n    </div>\n  </div>\n  <div class=\"right-col\">\n    <div class=\"right-photo-block\">\n      <div class=\"img-placeholder\" style=\"height:220px;\">[Photo: 在定向越野中奋力奔跑]</div>\n      <div class=\"caption-text\">在定向越野中奋力奔跑<br><span class=\"photographer\">陈佳轩 摄</span></div>\n    </div>\n    <div class=\"right-photo-block\">\n      <div class=\"img-placeholder\" style=\"height:280px;\">[Photo: 一排男生站成一列，用自己的影子给姑娘挡住烈日]</div>\n      <div class=\"caption-text\">一排男生站成一列，用<br>自己的影子给姑娘挡住烈日</div>\n    </div>\n  </div>\n</div>\n\n<!-- Lower Section -->\n<div class=\"lower-section\">\n  <div class=\"lower-left\">\n    <div class=\"photo-block\">\n      <div class=\"img-placeholder\" style=\"height:200px;\">[Photo: 用一场合唱比赛铭记这些闪亮的日子]</div>\n      <div class=\"caption-text\">用一场合唱<br>比赛铭记这些闪<br>亮的日子<br><span class=\"photographer\">胡琪宣 摄</span></div>\n    </div>\n    <div class=\"photo-block\">\n      <div class=\"img-placeholder\" style=\"height:200px;\">[Photo: 用一份入党申请书见证理想与信念]</div>\n      <div class=\"caption-text\">用一份入党<br>申请书见证理想<br>与信念<br><span class=\"photographer\">胡琪宣 摄</span></div>\n    </div>\n    <div class=\"photo-block\">\n      <div class=\"img-placeholder\" style=\"height:180px;\">[Photo: 用一场拔河比赛演绎青春的力量]</div>\n      <div class=\"caption-text\">用一场拔河<br>比赛演绎青春的<br>力量<br><span class=\"photographer\">陈佳轩 摄</span></div>\n    </div>\n  </div>\n  \n  <div class=\"lower-center\">\n    <div class=\"article-text\">\n      <p>紫金港，你五点钟的晨曦真美。</p>\n      <p>见过早晨五点钟的校园吗？柔亮的光里忽地划出几声嘹亮的口号，然后映出大团的绿，不同于大自然肆意的绿色，那是一种属于军人的——规矩的绿！军装整齐、步伐一致、口号嘹亮，浙大的新人们迎来了他们军训的一天。</p>\n      <p>谁言书生只善文，军训场上显神威！既怀得鲲鹏之志，岂能无钢铁之躯？壮志凌云，跃跃欲试；意气风发，摩拳擦掌。能文善武，成大国之器；握笔挥刀，铸全能之材！</p>\n      <p>紫金港，你日光下汗浸衣襟的战士们真帅。</p>\n      <p>\"向左转！向右转！\"\"齐步走！\"一遍两遍，百遍千遍。不娇不惧，不悔不怕。浙大人不怕苦，浙大人要磨炼钢铁意志！心中有理想，脚下有力量。目光坚定，我们向往成为钢铁一般的战士，故我们忍耐，我们奋发，至刚至坚，长空亮剑，气贯云天！</p>\n      <p>烈日炎炎，熔不了心中激情；汗水涔涔，带不走崇高信念。青春年华，用汗水诠释；前路漫漫，用血泪征服！</p>\n      <p>宣父犹能畏后生，丈夫未可轻年少！不屈——不屈——！</p>\n      <p>紫金港，你夕阳里的藕舫路真好看。</p>\n      <p>屈原道：\"路漫漫其修远兮，吾将上下而求索。\"竺老校长之问犹然在耳，唯有向前，全力以赴，才可不负重托。前人栽树，竺老同众多浙大的学长学姐一起，为我们守护着这方生机盎然的土地。战火中的西迁故事，林俊德院士的事迹……既传达了力量，更是我们的榜样！传承的重任在肩，要传承的是一代代浙大人艰苦创业的精神，要传承的是一代代浙大人求是创新的灵魂！</p>\n      <p>紫金港，你路灯下的湖水轻轻泛起涟漪，你黑暗中的荷枝柔柔地扭动腰肢，你月牙楼边传来的歌声微微回响。</p>\n      <p>这一天末了，战士们都进入梦乡。</p>\n      <p>紫金港，你今天真好看。我想，明天的你一定更加美丽！</p>\n    </div>\n    <div class=\"article-author\">本版文字 &nbsp; 包蓉 &nbsp; 杨萝萝</div>\n    \n    <div class=\"qr-section\">\n      <div class=\"qr-placeholder img-placeholder\">[QR Code]</div>\n      <div class=\"qr-text\">用手机QQ<br>扫二维码<br>加入浙江大学<br>QQ智慧校园</div>\n    </div>\n  </div>\n  \n  <div class=\"lower-right\">\n    <div class=\"right-photo-block\">\n      <div class=\"img-placeholder\" style=\"height:350px;\">[Photo: 迷彩的颜色是今夏紫金港最靓丽的风景线]</div>\n      <div class=\"caption-text\">迷彩的颜色是今夏紫金<br>港最靓丽的风景线<br><span class=\"photographer\">陈佳轩 摄</span></div>\n    </div>\n  </div>\n</div>\n\n<!-- Footer -->\n<div class=\"footer\">\n  本报通讯地址：浙江大学紫金港校区东三105 《浙江大学报》编辑部 &nbsp; 邮编：310058 &nbsp; 电子信箱：zdxb@zju.edu.cn &nbsp; 电话：0571-88981339 &nbsp; 88273707 &nbsp; 总编：应飚 &nbsp; 副总编：章曼 &nbsp; 电子编辑：李岑 &nbsp; 承印：新华通讯社浙江分社印刷厂\n</div>\n\n</body>\n</html>",
