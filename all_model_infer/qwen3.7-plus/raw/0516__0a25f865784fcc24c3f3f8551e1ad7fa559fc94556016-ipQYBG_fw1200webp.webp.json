    width: 500px;\n    height: 500px;\n  }\n\n  /* Content layers */\n  .content {\n    position: relative;\n    z-index: 10;\n    width: 100%;\n    height: 100%;\n    padding: 40px 50px;\n  }\n\n  /* Top-left section */\n  .top-left {\n    position: absolute;\n    top: 50px;\n    left: 40px;\n    z-index: 10;\n  }\n\n  .year {\n    font-size: 18px;\n    letter-spacing: 12px;\n    color: #1a1a1a;\n    font-family: 'Noto Sans SC', sans-serif;\n    margin-bottom: 4px;\n  }\n\n  .title-row {\n    display: flex;\n    align-items: flex-start;\n    gap: 8px;\n  }\n\n  .title-cn {\n    font-size: 28px;\n    font-weight: 900;\n    color: #1a1a1a;\n    writing-mode: vertical-rl;\n    letter-spacing: 6px;\n    font-family: 'Noto Serif SC', serif;\n  }\n\n  .title-limit {\n    font-size: 28px;\n    font-weight: 900;\n    color: #1a2a6c;\n    writing-mode: vertical-rl;\n    letter-spacing: 4px;\n    font-family: 'Noto Serif SC', serif;\n  }\n\n  .title-limit .infinity {\n    font-size: 20px;\n    color: #1a2a6c;\n  }\n\n  /* Artist names */\n  .artists {\n    position: absolute;\n    top: 240px;\n    left: 40px;\n    z-index: 10;\n    display: flex;\n    gap: 30px;\n  }\n\n  .artist-block {\n    writing-mode: vertical-rl;\n    text-orientation: mixed;\n  }\n\n  .artist-name-en {\n    font-size: 26px;\n    font-weight: 700;\n    color: #1a2a6c;\n    font-family: 'Georgia', serif;\n    letter-spacing: 2px;\n  }\n\n  .artist-desc {\n    font-size: 14px;\n    color: #1a1a1a;\n    letter-spacing: 3px;\n    margin-top: 8px;\n    font-family: 'Noto Sans SC', sans-serif;\n  }\n\n  .artist-block-2 .artist-name-en {\n    font-size: 26px;\n  }\n\n  .artist-block-2 .artist-desc {\n    font-size: 13px;\n    letter-spacing: 2px;\n  }\n\n  /* Center title */\n  .center-title {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    z-index: 10;\n    text-align: center;\n  }\n\n  .center-title .char {\n    font-size: 120px;\n    font-weight: 900;\n  