        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Uncontrolled type 1 diabetes among Egyptian adolescents</title>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  body { font-family: 'Segoe UI', Arial, sans-serif; background: #fff; color: #333; line-height: 1.5; }\n  .poster { max-width: 1200px; margin: 0 auto; padding: 20px; }\n\n  /* Header */\n  .header {\n    background: #1a3a6b;\n    color: #fff;\n    padding: 40px 50px;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    border-radius: 4px;\n    position: relative;\n    overflow: hidden;\n  }\n  .header-text { flex: 1; max-width: 70%; }\n  .header h1 {\n    font-size: 28px;\n    font-weight: 700;\n    color: #7ec8e3;\n    margin-bottom: 15px;\n    line-height: 1.3;\n  }\n  .header .authors {\n    font-size: 13px;\n    color: #c0d8f0;\n    margin-bottom: 10px;\n    line-height: 1.6;\n  }\n  .header .affiliation {\n    font-size: 12px;\n    color: #a0c0e0;\n  }\n  .header-image {\n    width: 220px;\n    height: 200px;\n    flex-shrink: 0;\n  }\n  .header-image .placeholder {\n    width: 220px;\n    height: 200px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .divider {\n    height: 4px;\n    background: #5ba3d9;\n    margin: 15px 0 25px 0;\n    border-radius: 2px;\n  }\n\n  /* Main content - 3 columns */\n  .content {\n    display: grid;\n    grid-template-columns: 1fr 1.2fr 1fr;\n    gap: 30px;\n    padding: 0 10px;\n  }\n\n  .section-title {\n    font-size: 20px;\n    font-weight: 700;\n    color: #1a3a6b;\n    margin-bottom: 8px;\n  }\n  .section-divider {\n    height: 3px;\n    background: #5ba3d9;\n    margin-bottom: 15px;\n    border-radius: 2px;\n  }\n\n  .col-left p, .col-middle p, .col-right p {\n    font-size: 13px;\n    line-height: 1.6;\n    margin-bottom: 12px;\n  }\n\n  /* Methodology numbered items */\n  .method-item {\n    display: flex;\n    align-items: flex-start;\n    margin-bottom: 15px;\n  }\n  .method-num {\n    width: 28px;\n    height: 28px;\n    background: #7ec8e3;\n    color: #fff;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 13px;\n    font-weight: 700;\n    flex-shrink: 0;\n    margin-right: 12px;\n    margin-top: 2px;\n  }\n  .method-text {\n    font-size: 13px;\n    line-height: 1.6;\n  }\n\n  /* Table */\n  .results-table {\n    width: 100%;\n    border-collapse: collapse;\n    margin: 15px 0;\n    font-size: 11px;\n  }\n  .results-table thead th {\n    background: #1a3a6b;\n    color: #fff;\n    padding: 8px 6px;\n    text-align: center;\n    font-size: 10px;\n    font-weight: 600;\n    border: 1px solid #1a3a6b;\n  }\n  .results-table thead th:first-child {\n    text-align: left;\n  }\n  .results-table tbody td {\n    padding: 6px;\n    text-align: center;\n    border-bottom: 1px solid #e0e0e0;\n    font-size: 11px;\n  }\n  .results-table tbody td:first-child {\n    text-align: left;\n  }\n\n  /* Charts */\n  .chart-container {\n    text-align: center;\n    margin-bottom: 20px;\n  }\n  .chart-title {\n    font-size: 14px;\n    font-weight: 700;\n    color: #1a3a6b;\n    margin-bottom: 10px;\n  }\n  .donut-chart {\n    width: 160px;\n    height: 160px;\n    margin: 0 auto 10px auto;\n    position: relative;\n  }\n  .donut-chart svg {\n    width: 160px;\n    height: 160px;\n  }\n  .chart-legend {\n    font-size: 11px;\n    text-align: left;\n    margin-top: 8px;\n  }\n  .legend-item {\n    display: flex;\n    align-items: center;\n    margin-bottom: 4px;\n    font-size: 11px;\n  }\n  .legend-color {\n    width: 14px;\n    height: 14px;\n    margin-right: 8px;\n    border-radius: 2px;\n    flex-shrink: 0;\n  }\n  .legend-label { flex: 1; }\n  .legend-value { font-weight: 600; }\n\n  /* Doctor image placeholder */\n  .doctor-image {\n    width: 100%;\n    height: 280px;\n    margin-top: 15px;\n    background: #f0f0f0;\n    border-radius: 4px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n  }\n\n  /* Syringe image */\n  .syringe-image {\n    width: 100%;\n    height: 200px;\n    margin-top: 10px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  /* Footer */\n  .footer {\n    margin-top: 20px;\n    padding-top: 15px;\n    border-top: 4px solid #5ba3d9;\n    text-align: center;\n    font-size: 12px;\n    color: #333;\n    line-height: 1.6;\n  }\n\n  .aim-section { margin-bottom: 20px; }\n  .intro-section { margin-bottom: 20px; }\n  .method-section { margin-bottom: 10px; }\n\n  .results-text {\n    font-size: 13px;\n    line-height: 1.6;\n    margin-bottom: 15px;\n  }\n\n  .conclusion-text {\n    font-size: 13px;\n    line-height: 1.6;\n  }\n</style>\n</head>\n<body>\n<div class=\"poster\">\n\n  <!-- Header -->\n  <div class=\"header\">\n    <div class=\"header-text\">\n      <h1>Uncontrolled type 1 diabetes among Egyptian adolescents; risk determinants and clinical outcomes</h1>\n      <div class=\"authors\">\n        Safinaz Adel Elhabashya, Eman M Mounir Sherifa, Nouran Yousef Salaha,<br>\n        Mostafa Ahmed Elsayed Abd Elkaderb, Dina Ahmed Hosney Youssefa\n      </div>\n      <div class=\"affiliation\">Pediatrics Department, Faculty of Medicine, Ain Shams University, Cairo, Egypt</div>\n    </div>\n    <div class=\"header-image\">\n      <div class=\"placeholder\">\n        <svg width=\"200\" height=\"190\" viewBox=\"0 0 200 190\">\n          <!-- Stethoscope illustration -->\n          <path d=\"M60 100 C60 40, 140 40, 140 100\" fill=\"none\" stroke=\"#c0c0c0\" stroke-width=\"4\"/>\n          <path d=\"M60 100 C60 50, 100 30, 100 30\" fill=\"none\" stroke=\"#c0c0c0\" stroke-width=\"3\"/>\n          <path d=\"M140 100 C140 50, 100 30, 100 30\" fill=\"none\" stroke=\"#c0c0c0\" stroke-width=\"3\"/>\n          <circle cx=\"60\" cy=\"100\" r=\"8\" fill=\"#333\"/>\n          <circle cx=\"140\" cy=\"100\" r=\"8\" fill=\"#333\"/>\n          <circle cx=\"100\" cy=\"155\" r=\"12\" fill=\"#c0c0c0\" stroke=\"#999\" stroke-width=\"2\"/>\n          <line x1=\"100\" y1=\"100\" x2=\"100\" y2=\"143\" stroke=\"#c0c0c0\" stroke-width=\"3\"/>\n          <!-- Hands -->\n          <ellipse cx=\"55\" cy=\"130\" rx=\"18\" ry=\"25\" fill=\"#f0c8a0\" transform=\"rotate(-10 55 130)\"/>\n          <ellipse cx=\"145\" cy=\"130\" rx=\"18\" ry=\"25\" fill=\"#f0c8a0\" transform=\"rotate(10 145 130)\"/>\n          <rect x=\"40\" y=\"155\" width=\"30\" height=\"30\" rx=\"5\" fill=\"#2a6090\"/>\n          <rect x=\"130\" y=\"155\" width=\"30\" height=\"30\" rx=\"5\" fill=\"#2a6090\"/>\n        </svg>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"divider\"></div>\n\n  <!-- Main Content -->\n  <div class=\"content\">\n\n    <!-- Left Column -->\n    <div class=\"col-left\">\n\n      <div class=\"intro-section\">\n        <div class=\"section-title\">Introduction</div>\n        <div class=\"section-divider\"></div>\n        <p>Adolescents are exposed to multiple developmental, cognitive and emotional challenges, including independence and autonomy acquisition, identity and self esteem development, and social bond creation.</p>\n      </div>\n\n      <div class=\"aim-section\">\n        <div class=\"section-title\">Aim</div>\n        <div class=\"section-divider\"></div>\n        <p>To assess the risk determinants and clinical outcomes of uncontrolled diabetes among Egyptian adolescents with T1D.</p>\n      </div>\n\n      <div class=\"method-section\">\n        <div class=\"section-title\">Methodology</div>\n        <div class=\"section-divider\"></div>\n\n        <div class=\"method-item\">\n          <div class=\"method-num\">1</div>\n          <div class=\"method-text\">Six hundred adolescents with T1D were recruited from the Pediatric and Adolescents Diabetology Clinic, Ain-Shams University.</div>\n        </div>\n\n        <div class=\"method-item\">\n          <div class=\"method-num\">2</div>\n          <div class=\"method-text\">From the studied cohort, 200 with good glycemic control (≤7%) and 200 with poor control (&gt;7%) were assessed for diabetes-duration, insulin regimen, frequency of diabetic-ketoacidosis, clinically significant hypoglycemia and the Mini-International Neuropsychiatric-Interview for Children and Adolescents.</div>\n        </div>\n\n        <div class=\"method-item\">\n          <div class=\"method-num\">3</div>\n          <div class=\"method-text\">Auxological assessment, fundus and clinical screening for complications were done.</div>\n        </div>\n\n        <div class=\"method-item\">\n          <div class=\"method-num\">4</div>\n          <div class=\"method-text\">Neuropathy was confirmed by nerve conduction velocity.</div>\n        </div>\n\n        <div class=\"method-item\">\n          <div class=\"method-num\">5</div>\n          <div class=\"method-text\">Thyroid profile, anti-tissue transglutaminase-IgG, fasting lipids and urinary albumin/excretion ratio (UAE) were measured.</div>\n        </div>\n      </div>\n\n    </div>\n\n    <!-- Middle Column -->\n    <div class=\"col-middle\">\n\n      <div class=\"section-title\">Results</div>\n      <div class=\"section-divider\"></div>\n\n      <p class=\"results-text\">Adolescents having uncontrolled diabetes have significantly higher diabetes onset age (p = 0.037), diabetes-duration (p = 0.038), eating disorders (p = 0.027), sadness (p = 0.038), depression (p = 0.003), suicidal manifestations (p = 0.001) and anxiety (p&lt;0.001) than the well-controlled group.</p>\n\n      <table class=\"results-table\">\n        <thead>\n          <tr>\n            <th rowspan=\"2\">Variables</th>\n            <th>Adolescents with T1D (n = 400)</th>\n            <th>Well controlled Adolescents with T1D (n = 200)</th>\n            <th>Well controlled Adolescents with T1D (n = 200)</th>\n          </tr>\n          <tr>\n            <th>r</th>\n            <th>p-value</th>\n            <th>r</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td>Empty Cell</td>\n            <td>r</td>\n            <td>p-value</td>\n            <td>r</td>\n          </tr>\n          <tr>\n            <td>Age (years)</td>\n            <td>−0.054</td>\n            <td>0.282</td>\n            <td>0.000</td>\n          </tr>\n          <tr>\n            <td>Age at diabetes onset (y)</td>\n            <td>0.122*</td>\n            <td>0.014</td>\n            <td>−0.011</td>\n          </tr>\n          <tr>\n            <td>Diabetes duration (y)</td>\n            <td>0.103*</td>\n            <td>0.039</td>\n            <td>0.098</td>\n          </tr>\n          <tr>\n            <td>Insulin dosage (U/kg/day)</td>\n            <td>−0.051</td>\n            <td>0.312</td>\n            <td>0.082</td>\n          </tr>\n          <tr>\n            <td>Parent social standard</td>\n            <td>−0.021</td>\n            <td>0.671</td>\n            <td>−0.121</td>\n          </tr>\n          <tr>\n            <td>Weight z-score</td>\n            <td>−0.043</td>\n            <td>0.391</td>\n            <td>−0.025</td>\n          </tr>\n          <tr>\n            <td>Height z-score</td>\n            <td>−0.081</td>\n            <td>0.106</td>\n            <td>0.065</td>\n          </tr>\n          <tr>\n            <td>BMI z-score</td>\n            <td>0.040</td>\n            <td>0.425</td>\n            <td>−0.067</td>\n          </tr>\n        </tbody>\n      </table>\n\n      <div class=\"doctor-image\">\n        <div class=\"placeholder\" style=\"width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#e8f0f8;\">\n          <svg width=\"280\" height=\"270\" viewBox=\"0 0 280 270\">\n            <!-- Doctor with stethoscope -->\n            <rect x=\"60\" y=\"80\" width=\"160\" height=\"190\" rx=\"10\" fill=\"#f5f5f5\"/>\n            <!-- Face -->\n            <ellipse cx=\"140\" cy=\"60\" rx=\"40\" ry=\"45\" fill=\"#f0c8a0\"/>\n            <!-- Hair -->\n            <path d=\"M100 50 C100 20, 180 20, 180 50 C180 35, 160 25, 140 25 C120 25, 100 35, 100 50\" fill=\"#5a3a2a\"/>\n            <!-- Eyes -->\n            <ellipse cx=\"125\" cy=\"55\" rx=\"5\" ry=\"4\" fill=\"#333\"/>\n            <ellipse cx=\"155\" cy=\"55\" rx=\"5\" ry=\"4\" fill=\"#333\"/>\n            <!-- Mouth -->\n            <path d=\"M130 72 Q140 78 150 72\" fill=\"none\" stroke=\"#c07060\" stroke-width=\"2\"/>\n            <!-- White coat -->\n            <path d=\"M80 110 L80 270 L200 270 L200 110 C180 100, 160 95, 140 95 C120 95, 100 100, 80 110\" fill=\"#fff\" stroke=\"#ddd\" stroke-width=\"1\"/>\n            <!-- Stethoscope -->\n            <path d=\"M120 110 C120 140, 100 160, 100 180\" fill=\"none\" stroke=\"#333\" stroke-width=\"3\"/>\n            <path d=\"M160 110 C160 140, 180 160, 180 180\" fill=\"none\" stroke=\"#333\" stroke-width=\"3\"/>\n            <circle cx=\"100\" cy=\"190\" r=\"15\" fill=\"#c0c0c0\" stroke=\"#999\" stroke-width=\"2\"/>\n            <circle cx=\"100\" cy=\"190\" r=\"8\" fill=\"#e0e0e0\"/>\n            <!-- Hand holding stethoscope -->\n            <ellipse cx=\"100\" cy=\"210\" rx=\"15\" ry=\"20\" fill=\"#f0c8a0\"/>\n          </svg>\n        </div>\n      </div>\n\n    </div>\n\n    <!-- Right Column -->\n    <div class=\"col-right\">\n\n      <!-- Generalized Anxiety Chart -->\n      <div class=\"chart-container\">\n        <div class=\"chart-title\">Generalized anxiety</div>\n        <div class=\"donut-chart\">\n          <svg viewBox=\"0 0 160 160\">\n            <circle cx=\"80\" cy=\"80\" r=\"60\" fill=\"none\" stroke=\"#e8e8f0\" stroke-width=\"30\"/>\n            <!-- Poorly controlled 60% = 216 degrees -->\n            <circle cx=\"80\" cy=\"80\" r=\"60\" fill=\"none\" stroke=\"#c8d8f0\" stroke-width=\"30\"\n              stroke-dasharray=\"226.2 376.99\" stroke-dashoffset=\"0\" transform=\"rotate(-90 80 80)\"/>\n            <!-- Well controlled 20% = 72 degrees -->\n            <circle cx=\"80\" cy=\"80\" r=\"60\" fill=\"none\" stroke=\"#a0d0f0\" stroke-width=\"30\"\n              stroke-dasharray=\"75.4 376.99\" stroke-dashoffset=\"-226.2\" transform=\"rotate(-90 80 80)\"/>\n            <!-- Adolescents with T1D 20% = 72 degrees -->\n            <circle cx=\"80\" cy=\"80\" r=\"60\" fill=\"none\" stroke=\"#5090d0\" stroke-width=\"30\"\n              stroke-dasharray=\"75.4 376.99\" stroke-dashoffset=\"-301.6\" transform=\"rotate(-90 80 80)\"/>\n            <circle cx=\"80\" cy=\"80\" r=\"42\" fill=\"#fff\"/>\n          </svg>\n        </div>\n        <div class=\"chart-legend\">\n          <div class=\"legend-item\">\n            <div class=\"legend-color\" style=\"background:#5090d0;\"></div>\n            <span class=\"legend-label\">Adolescents with T1D</span>\n            <span class=\"legend-value\">20%</span>\n          </div>\n          <div class=\"legend-item\">\n            <div class=\"legend-color\" style=\"background:#a0d0f0;\"></div>\n            <span class=\"legend-label\">Well controlled Adolescents</span>\n            <span class=\"legend-value\">20%</span>\n          </div>\n          <div class=\"legend-item\">\n            <div class=\"legend-color\" style=\"background:#c8d8f0;\"></div>\n            <span class=\"legend-label\">Poorly controlled Adolescents</span>\n            <span class=\"legend-value\">60%</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Frequency of DKA Chart -->\n      <div class=\"chart-container\">\n        <div class=\"chart-title\">Frequency of DKA /yeared anxiety</div>\n        <div class=\"donut-chart\">\n          <svg viewBox=\"0 0 160 160\">\n            <circle cx=\"80\" cy=\"80\" r=\"60\" fill=\"none\" stroke=\"#e8e8f0\" stroke-width=\"30\"/>\n            <circle cx=\"80\" cy=\"80\" r=\"60\" fill=\"none\" stroke=\"#c8d8f0\" stroke-width=\"30\"\n              stroke-dasharray=\"226.2 376.99\" stroke-dashoffset=\"0\" transform=\"rotate(-90 80 80)\"/>\n            <circle cx=\"80\" cy=\"80\" r=\"60\" fill=\"none\" stroke=\"#a0d0f0\" stroke-width=\"30\"\n              stroke-dasharray=\"75.4 376.99\" stroke-dashoffset=\"-226.2\" transform=\"rotate(-90 80 80)\"/>\n            <circle cx=\"80\" cy=\"80\" r=\"60\" fill=\"none\" stroke=\"#5090d0\" stroke-width=\"30\"\n              stroke-dasharray=\"75.4 376.99\" stroke-dashoffset=\"-301.6\" transform=\"rotate(-90 80 80)\"/>\n            <circle cx=\"80\" cy=\"80\" r=\"42\" fill=\"#fff\"/>\n          </svg>\n        </div>\n        <div class=\"chart-legend\">\n          <div class=\"legend-item\">\n            <div class=\"legend-color\" style=\"background:#5090d0;\"></div>\n            <span class=\"legend-label\">Adolescents with T1D</span>\n            <span class=\"legend-value\">20%</span>\n          </div>\n          <div class=\"legend-item\">\n            <div class=\"legend-color\" style=\"background:#a0d0f0;\"></div>\n            <span class=\"legend-label\">Well controlled Adolescents</span>\n            <span class=\"legend-value\">20%</span>\n          </div>\n          <div class=\"legend-item\">\n            <div class=\"legend-color\" style=\"background:#c8d8f0;\"></div>\n            <span class=\"legend-label\">Poorly controlled Adolescents</span>\n            <span class=\"legend-value\">60%</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Conclusion -->\n      <div class=\"section-title\" style=\"margin-top:10px;\">Conclusion</div>\n      <div class=\"section-divider\"></div>\n      <p class=\"conclusion-text\">Uncontrolled T1D among adolescents is associated with older age and psychiatric comorbidities. Furthermore, it is linked to school absenteeism, hyperlipidemia, diabetic nephropathy and neuropathy.</p>\n\n      <!-- Syringe image -->\n      <div class=\"syringe-image\">\n        <div class=\"placeholder\" style=\"width:100%;height:100%;display:flex;align-items:center;justify-content:center;\">\n          <svg width=\"180\" height=\"200\" viewBox=\"0 0 180 200\">\n            <!-- Hand -->\n            <ellipse cx=\"90\" cy=\"160\" rx=\"50\" ry=\"35\" fill=\"#f0c8a0\"/>\n            <!-- Fingers -->\n            <ellipse cx=\"60\" cy=\"140\" rx=\"12\" ry=\"20\" fill=\"#f0c8a0\" transform=\"rotate(-20 60 140)\"/>\n            <ellipse cx=\"80\" cy=\"130\" rx=\"10\" ry=\"22\" fill=\"#f0c8a0\"/>\n            <ellipse cx=\"100\" cy=\"128\" rx=\"10\" ry=\"22\" fill=\"#f0c8a0\"/>\n            <ellipse cx=\"120\" cy=\"135\" rx=\"10\" ry=\"20\" fill=\"#f0c8a0\" transform=\"rotate(15 120 135)\"/>\n            <!-- Syringe body -->\n            <rect x=\"82\" y=\"40\" width=\"16\" height=\"80\" rx=\"3\" fill=\"#f0f0f0\" stroke=\"#ccc\" stroke-width=\"1\"/>\n            <!-- Syringe plunger -->\n            <rect x=\"86\" y=\"10\" width=\"8\" height=\"35\" rx=\"2\" fill=\"#ddd\" stroke=\"#bbb\" stroke-width=\"1\"/>\n            <rect x=\"80\" y=\"5\" width=\"20\" height=\"8\" rx=\"2\" fill=\"#ccc\"/>\n            <!-- Yellow liquid -->\n            <rect x=\"84\" y=\"70\" width=\"12\" height=\"45\" rx=\"2\" fill=\"#f0d040\"/>\n            <!-- Needle -->\n            <line x1=\"90\" y1=\"120\" x2=\"90\" y2=\"155\" stroke=\"#999\" stroke-width=\"2\"/>\n            <!-- Measurement marks -->\n            <line x1=\"82\" y1=\"60\" x2=\"88\" y2=\"60\" stroke=\"#999\" stroke-width=\"1\"/>\n            <line x1=\"82\" y1=\"70\" x2=\"88\" y2=\"70\" stroke=\"#999\" stroke-width=\"1\"/>\n            <line x1=\"82\" y1=\"80\" x2=\"88\" y2=\"80\" stroke=\"#999\" stroke-width=\"1\"/>\n            <line x1=\"82\" y1=\"90\" x2=\"88\" y2=\"90\" stroke=\"#999\" stroke-width=\"1\"/>\n            <line x1=\"82\" y1=\"100\" x2=\"88\" y2=\"100\" stroke=\"#999\" stroke-width=\"1\"/>\n          </svg>\n        </div>\n      </div>\n\n    </div>\n\n  </div>\n\n  <!-- Footer -->\n  <div class=\"footer\">\n    Elhabashy, S.A., Sherif,