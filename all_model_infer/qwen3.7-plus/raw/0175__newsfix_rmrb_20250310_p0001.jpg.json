t; }\n  .top-banner-right .big-title { font-size: 26px; font-weight: bold; color: #111; font-family: \"SimHei\", \"黑体\", sans-serif; }\n  .top-banner-right .sub-titles { font-size: 18px; color: #333; font-family: \"SimHei\", \"黑体\", sans-serif; letter-spacing: 4px; }\n  .newspaper-header { text-align: center; border-bottom: 3px solid #c00; padding-bottom: 6px; margin-bottom: 6px; }\n  .newspaper-header .cn-name { font-size: 52px; font-weight: bold; color: #c00; font-family: \"SimHei\", \"黑体\", sans-serif; letter-spacing: 12px; }\n  .newspaper-header .en-name { font-size: 16px; color: #c00; letter-spacing: 6px; font-family: Arial, sans-serif; }\n  .newspaper-header .meta { font-size: 11px; color: #555; margin-top: 2px; }\n  .content-layout { display: grid; grid-template-columns: 180px 1fr 1fr 260px; gap: 10px; }\n  .left-sidebar { border-right: 2px solid #c00; padding-right: 8px; }\n  .left-sidebar .vertical-title { writing-mode: vertical-rl; font-size: 24px; font-weight: bold; color: #c00; font-family: \"SimHei\", \"黑体\", sans-serif; letter-spacing: 8px; margin-bottom: 10px; }\n  .center-content { }\n  .right-sidebar { border-left: 1px solid #ddd; padding-left: 8px; }\n  .full-width { grid-column: 1 / -1; }\n  .section-divider { border-top: 2px solid #c00; margin: 10px 0; padding-top: 6px; }\n  .article-meta { font-size: 11px; color: #888; }\n  .lead-text { font-size: 13px; font-weight: bold; color: #333; }\n  .body-text { font-size: 12px; line-height: 1.9; }\n  .body-text p { text-indent: 2em; margin-bottom: 2px; }\n  .section-header { display: flex; align-items: center; gap: 6px; margin: 8px 0 4px 0; }\n  .section-header .label { background: #c00; color: #fff; padding: 2px 8px; font-size: 12px; font-family: \"SimHei\", \"黑体\", sans-serif; }\n  .section-header .label-blue { background: #1a5276; }\n  .section-header .label-green { background: #1e8449; }\n  .section-header .label-orange { background: #d35400; }\n  .section-header h3 { font-size: 14px; font-weight: bold; color: #111; }\n  .big-quote { font-size: 24px; font-weight: bold; text-align: center; margin: 12px 0; font-family: \"SimHei\", \"黑体\", sans-serif; }\n  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }\n  .three-col { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; }\n  .text-justify { text-align: justify; }\n  .ml-8 { margin-left: 8px; }\n  .mt-4 { margin-top: 4px; }\n  .mt-8 { margin-top: 8px; }\n  .mb-4 { margin-bottom: 4px; }\n  .mb-8 { margin-bottom: 8px; }\n  .pt-4 { padding-top: 4px; }\n  .pb-4 { padding-bottom: 4px; }\n  .border-top-red { border-top: 2px solid #c00; }\n  .border-top-gray { border-top: 1px solid #ccc; }\n  .font-hei { font-family: \"SimHei\", \"黑体\", sans-serif; }\n  .font-song { font-family: \"SimSun\", \"宋体\", serif; }\n  .text-center { text-align: center; }\n  .text-right { text-align: right; }\n  .w-full { width: 100%; }\n  .flex { display: flex; }\n  .flex-col { flex-direction: column; }\n  .items-center { align-items: center; }\n  .justify-between { justify-content: space-between; }\n  .gap-2 { gap: 2px; }\n  .gap-4 { gap: 4px; }\n  .gap-8 { gap: 8px; }\n  .p-4 { padding: 4px; }\n  .p-8 { padding: 8px; }\n</style>\n</head>\n<body>\n\n<!-- Newspaper Header -->\n<div class=\"newspaper-header\">\n  <div class=\"date-line\">2025年3月10日 星期一 乙巳年二月十一</div>\n  <div class=\"cn-name\">人民日报</div>\n  <div class=\"en-name\">RENMIN RIBAO</div>\n  <div class=\"meta\">\n    人民日报社出版 &nbsp;|&nbsp; 国内统一连续出版物号 CN 11-0065 &nbsp;|&nbsp; 代号 1-1 &nbsp;|&nbsp; 第29302期 &nbsp;|&nbsp; 今日20版\n  </div>\n  <div class=\"meta\">人民网网址：http://www.people.com.cn</div>\n</div>\n\n<!-- Top Banner -->\n<div class=\"top-banner\">\n  <div class=\"top-banner-left\">\n    <div style=\"font-size:11px; color:#666;\">本报记者 吴储岐 刘宇</div>\n  </div>\n  <div class=\"top-banner-right\">\n    <div class=\"big-title\">2025年全国两会</div>\n    <div class=\"sub-titles\">会风简约 &nbsp; 纪律严明 &nbsp; 务实高效</div>\n  </div>\n</div>\n\n<div class=\"red-line\"></div>\n\n<!-- Main Content Layout -->\n<div class=\"content-layout\">\n\n  <!-- Left Sidebar -->\n  <div class=\"left-sidebar\">\n    <div class=\"vertical-title\">代表委员议国是</div>\n\n    <div class=\"article-block mt-8\">\n      <div class=\"tag-row\">\n        <span class=\"section-label\">关键词</span>\n        <span class=\"section-label\" style=\"background:#e67e22;\">教育</span>\n      </div>\n      <div class=\"article-title-small\">一段跨越千里的教育情缘</div>\n      <div class=\"author-line\">本报记者 刘涓溪</div>\n      <div class=\"body-text\">\n        <p>不到14岁，黄志就上的延安中学学生，怀揣着近2200元，踏入憧憬的中学。</p>\n        <p>我来自四川大竹，万州区中学和重庆会以及代表第一次到陕西延安，作为广东省韶关市韶关中学的百二二广东来华中学的延安中学延安中学一个学校的一个……</p>\n        <p>中毕业，从那里，连续地，广东省中学教育在延安，成县，几所学校，都是延安的……</p>\n        <p>\"我的学校是延安的。\"他说，\"……\"</p>\n        <p>次跨越的千里的教育情缘，从万州中学到……</p>\n        <p>过的大概是什么样子，都来自万州……</p>\n        <p>2022年暑假，万州中学的重庆中学的同学……</p>\n        <p>去了大竹，了解了当地教育……</p>\n        <p>一位当地的教育工作者，从大竹，万州……</p>\n        <p>……</p>\n      </div>\n    </div>\n\n    <div class=\"article-block mt-8\">\n      <div class=\"tag-row\">\n        <span class=\"section-label-blue\">关键词</span>\n        <span class=\"section-label-blue\" style=\"background:#2980b9;\">科技</span>\n      </div>\n      <div class=\"article-title-small\">一次校企合作的科技攻关</div>\n      <div class=\"author-line\">本报记者 刘涓溪</div>\n      <div class=\"body-text\">\n        <p>\"当前要聚焦突破制约我国科技……\"全国政协委员、中国工程院院士……</p>\n        <p>完成的工作。\"……\"……</p>\n        <p>……</p>\n      </div>\n    </div>\n  </div>\n\n  <!-- Center Content - Main Article -->\n  <div class=\"center-content col-span-2\">\n    <div class=\"article-title-large center-title\">坚持教育科技人才一起抓</div>\n    <div class=\"author-line text-center\">本报记者 刘涓溪</div>\n\n    <div class=\"red-line\"></div>\n\n    <div class=\"article-block\">\n      <div class=\"section-header\">\n        <span class=\"label\">关键词</span>\n        <span style=\"background:#e67e22; color:#fff; padding:2px 8px; font-size:12px; font-family:'SimHei',sans-serif;\">教育</span>\n        <h3>一段跨越千里的教育情缘</h3>\n      </div>\n      <div class=\"body-text\">\n        <p>不到14岁，黄志就上的延安中学学生，怀揣着近2200元，踏入憧憬的中学。</p>\n        <p>我来自四川大竹，万州区中学和重庆会以及代表第一次到陕西延安，作为广东省韶关市韶关中学的百二二广东来华中学的延安中学延安中学一个学校的一个……</p>\n        <p>中毕业，从那里，连续地，广东省中学教育在延安，成县，几所学校，都是延安的……</p>\n        <p>\"我的学校是延安的。\"他说，\"……\"</p>\n        <p>次跨越的千里的教育情缘，从万州中学到……</p>\n        <p>过的大概是什么样子，都来自万州……</p>\n        <p>2022年暑假，万州中学的重庆中学的同学……</p>\n        <p>去了大竹，了解了当地教育……</p>\n        <p>一位当地的教育工作者，从大竹，万州……</p>\n        <p>……</p>\n      </div>\n    </div>\n\n    <div class=\"article-block\">\n      <div class=\"section-header\">\n        <span class=\"label-blue\">关键词</span>\n        <span style=\"background:#2980b9; color:#fff; padding:2px 8px; font-size:12px; font-family:'SimHei',sans-serif;\">人才</span>\n        <h3>一支薪火相传的人才接力</h3>\n      </div>\n      <div class=\"body-text\">\n        <p>刚毕业的大学生，被选为驻村发展……</p>\n        <p>20年前，我们到了那里……</p>\n        <p>……</p>\n      </div>\n    </div>\n\n    <div class=\"article-block\">\n      <div class=\"section-header\">\n        <span class=\"label-green\">关键词</span>\n        <span style=\"background:#1e8449; color:#fff; padding:2px 8px; font-size:12px; font-family:'SimHei',sans-serif;\">科技</span>\n        <h3>一次校企合作的科技攻关</h3>\n      </div>\n      <div class=\"body-text\">\n        <p>\"当前要聚焦突破制约我国科技……\"全国政协委员、中国工程院院士……</p>\n        <p>完成的工作。\"……\"……</p>\n        <p>……</p>\n      </div>\n    </div>\n  </div>\n\n  <!-- Right Sidebar -->\n  <div class=\"right-sidebar\">\n    <div class=\"article-block\">\n      <div class=\"article-title-medium\">纪律严明，筑牢作风\"高压线\"</div>\n      <div class=\"author-line\">本报记者 吴储岐 刘宇</div>\n      <div class=\"body-text\">\n        <p>会议期间会风会纪严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严严