size: 13.5px;\n    color: #555;\n    line-height: 2;\n    margin-bottom: 16px;\n  }\n\n  /* Image placeholders */\n  .img-placeholder {\n    background: #f0f0f0;\n    border-radius: 4px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #999;\n    font-size: 12px;\n    overflow: hidden;\n  }\n  .img-main {\n    width: 100%;\n    height: 280px;\n    margin-bottom: 10px;\n  }\n  .img-washer {\n    width: 100%;\n    height: 220px;\n    margin-bottom: 10px;\n  }\n  .img-stove {\n    width: 200px;\n    height: 260px;\n    float: right;\n    margin-left: 20px;\n    margin-bottom: 10px;\n  }\n\n  .caption {\n    font-size: 13px;\n    color: #555;\n    margin-bottom: 20px;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n  }\n  .caption::before {\n    content: \"\";\n    display: inline-block;\n    width: 8px;\n    height: 8px;\n    background: #6b5ce7;\n    border-radius: 50%;\n  }\n\n  /* Two column layout */\n  .two-col {\n    display: flex;\n    gap: 30px;\n    margin-top: 20px;\n  }\n  .two-col .col {\n    flex: 1;\n  }\n\n  .img-row {\n    display: flex;\n    gap: 10px;\n    margin-bottom: 10px;\n    flex-wrap: wrap;\n  }\n  .img-small {\n    width: 120px;\n    height: 100px;\n  }\n  .img-oven {\n    width: 140px;\n    height: 120px;\n  }\n  .img-cert {\n    width: 120px;\n    height: 120px;\n  }\n\n  .caption-row {\n    display: flex;\n    gap: 20px;\n    flex-wrap: wrap;\n    margin-bottom: 16px;\n  }\n  .caption-item {\n    font-size: 12.5px;\n    color: #555;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    flex: 1;\n    min-width: 140px;\n  }\n  .caption-item::before {\n    content: \"\";\n    display: inline-block;\n    width: 7px;\n    height: 7px;\n    background: #6b5ce7;\n    border-radius: 50%;\n    flex-shrink: 0;\n  }\n\n  /* Footnote */\n  .footnote {\n    font-size: 11px;\n    color: #999;\n    line-height: 1.8;\n    margin-top: 30px;\n    padding-top: 15px;\n    border-top: 1px solid #e0e0e0;\n  }\n\n  /* Page number */\n  .page-number {\n    position: absolute;\n    bottom: 30px;\n    font-size: 13px;\n    color: #333;\n  }\n  .page-left .page-number { left: 50px; }\n  .page-right .page-number { right: 50px; }\n\n  /* Superscript */\n  sup { font-size: 10px; }\n\n  .clearfix::after {\n    content: \"\";\n    display: table;\n    clear: both;\n  }\n\n  .img-stove-wrap {\n    float: right;\n    margin-left: 20px;\n    margin-bottom: 10px;\n  }\n  .img-stove-wrap .img-placeholder {\n    width: 200px;\n    height: 260px;\n  }\n</style>\n</head>\n<body>\n\n<div class=\"spread\">\n  <!-- Page 91 -->\n  <div class=\"page page-left\">\n    <div class=\"header\">\n      <span>2024·美的集团ESG报告</span>\n      <div class=\"nav\">\n        <span>关于本报告</span>\n        <span>走进美的</span>\n        <span>可持续发展治理</span>\n        <span>守护蓝色星球</span>\n        <span>构建和谐社区</span>\n        <span class=\"active\">践行科技尽善</span>\n        <span>共创繁荣生态</span>\n        <span>附录</span>\n      </div>\n    </div>\n\n    <div class=\"section-header\">\n      <div class=\"section-icon\">☰</div>\n      <div class=\"section-title\">品质属性</div>\n    </div>\n\n    <div class=\"subsection-tag\">耐用性提升：美的COLMO电热水器</div>\n    <p class=\"body-text\">\n      该产品创新性将高分子材料应用于热水器的内胆中，并搭载Ti钛金抗腐层，其内胆脉冲寿命为传统搪瓷内胆的40倍，耐腐蚀性能比上一代产品提高一倍以上。\n    </p>\n\n    <div class=\"img-placeholder img-main\" style=\"background: linear-gradient(135deg, #c8d8e8 0%, #a0b8d0 50%, #8899aa 100%);\">\n      <div style=\"text-align:center; color:#fff; font-size:14px;\">\n        <div style=\"font-size:16px; letter-spacing:3px; margin-bottom:4px;\">COLMO EVOLUTION</div>\n        <div style=\"font-size:13px;\">云璧电热水器BJ5</div>\n        <div style=\"margin-top:20px; display:flex; gap:20px; justify-content:center; align-items:flex-end;\">\n          <div style=\"text-align:center;\">\n            <div style=\"background:#8B7355; width:50px; height:30px; border-radius:4px;\"></div>\n            <div style=\"font-size:10px; margin-top:4px;\">1.0时代<br>搪瓷内胆</div>\n            <div style=\"font-size:9px; color:#ddd;\">镁棒防腐产生镁渣<br>清洗维护费时费心</div>\n            <div style=\"font-size:9px; color:#ddd;\">久用水质差<br>健康隐患无法避免</div>\n            <div style=\"font-size:9px; color:#ddd;\">搪瓷隔热性能不佳<br>热量流失快耗多</div>\n          </div>\n          <div style=\"text-align:center;\">\n            <div style=\"background:#4488cc; width:60px; height:35px; border-radius:4px;\"></div>\n            <div style=\"font-size:10px; margin-top:4px;\">2.0时代<br>玻璃纤维内胆</div>\n            <div style=\"font-size:9px; color:#ddd;\">无镁棒终身防腐</div>\n            <div style=\"font-size:9px; color:#ddd;\">排污维护麻烦<br>无法立排污垢，上下层水垢<br>和杂质排不彻底</div>\n            <div style=\"font-size:9px; color:#ddd;\">保温性能较好<br>节能但耗，加热次数更少</div>\n          </div>\n          <div style=\"text-align:center;\">\n            <div style=\"background:#cc6633; width:70px; height:40px; border-radius:4px;\"></div>\n            <div style=\"font-size:10px; margin-top:4px;\">3.0时代<br>铝钻锌水舱</div>\n            <div style=\"font-size:9px; color:#ddd;\">无镁棒终身防腐</div>\n            <div style=\"font-size:9px; color:#ddd;\">长效阻垢便捷维护<br>内胆一体成型无焊缝<br>独立排污口<br>便于日常清洁维护</div>\n            <div style=\"font-size:9px; color:#ddd;\">48小时长效保温<br>保温再提升，性能提升20.6%</div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"caption\">美的COLMO电热水器</div>\n\n    <div class=\"two-col\">\n      <div class=\"col\">\n        <div class=\"subsection-tag\">耐候性提升：石墨烯涂层空调</div>\n        <p class=\"body-text\">\n          该产品使用长效防腐耐候石墨烯涂层，使铝箔耐中性盐雾时长延长至300%，热扩散系数提升31%，耐候性提升4倍，获得Intertek长效防腐最高等级认定和国际顶刊《Nature》专题报道。\n        </p>\n        <div class=\"img-row\">\n          <div class=\"img-placeholder img-small\" style=\"background:#f5f0e0;\">\n            <div style=\"font-size:9px; text-align:center; padding:4px;\">\n              <div style=\"font-weight:bold; font-size:10px;\">Test Verification of Conformity</div>\n              <div style=\"font-size:8px;\">Intertek</div>\n            </div>\n          </div>\n          <div class=\"img-placeholder img-small\" style=\"background: linear-gradient(135deg, #ff6600, #ff3366, #3366ff);\">\n            <div style=\"font-size:8px; color:#fff; text-align:center; padding:4px;\">\n              MAKING LEAPS TOWARDS<br>SUSTAINABLE AIR CONDITIONING\n            </div>\n          </div>\n          <div class=\"img-placeholder img-small\" style=\"background:#e8f0e8;\">\n            <div style=\"font-size:8px; text-align:center; padding:4px;\">[Nature article image]</div>\n          </div>\n        </div>\n        <div class=\"caption-row\">\n          <div class=\"caption-item\">Intertek长效防腐最高等级认定</div>\n          <div class=\"caption-item\">《Nature》专题报道</div>\n        </div>\n      </div>\n\n      <div class=\"col\">\n        <div class=\"subsection-tag\">智能设计：美的COLMO射频嵌入式蒸汽烤箱</div>\n        <p class=\"body-text\">\n          该产品应用前沿的固态射频微波技术并结合先进的模式识别叠加算法，实现微波精准定向输出，使加热均匀性提升50%。\n        </p>\n        <div class=\"img-row\">\n          <div class=\"img-placeholder img-oven\" style=\"background:#2a2a2a;\">\n            <div style=\"font-size:10px; color:#ccc; text-align:center;\">[COLMO嵌入式蒸汽烤箱]</div>\n          </div>\n          <div class=\"img-placeholder img-cert\" style=\"background:#f8f8f8;\">\n            <div style=\"font-size:9px; text-align:center; padding:4px; color:#555;\">\n              科学技术成果鉴定证书\n            </div>\n          </div>\n        </div>\n        <div class=\"caption-row\">\n          <div class=\"caption-item\">美的COLMO射频嵌入式蒸汽烤箱</div>\n          <div class=\"caption-item\">科学技术成果鉴定证书</div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"page-number\">91</div>\n  </div>\n\n  <!-- Page 92 -->\n  <div class=\"page page-right\">\n    <div class=\"header\" style=\"visibility:hidden;\">\n      <span></span>\n    </div>\n\n    <div class=\"section-header\">\n      <div class=\"section-icon\">☰</div>\n      <div class=\"section-title\">环境属性</div>\n    </div>\n\n    <div class=\"subsection-tag\">降低污染物排放：美的滚筒系列洗衣机</div>\n    <p class=\"body-text\">\n      该系列产品应用全球首创的超微净泡及蓝氧技术，实现洗涤剂用量减少50%，能够有效降低洗涤剂造成的水足迹<sup>6</sup>。该系列产品已获得中国轻工业联合会科技进步奖、年度艾普兰优秀产品奖、革新产品金选奖、健康洗护之星等众多荣誉。\n    </p>\n\n    <div class=\"img-placeholder img-washer\" style=\"background: linear-gradient(180deg, #d0d0d0 0%, #a0a0a0 100%);\">\n      <div style=\"display:flex; gap:8px; align-items:flex-end; justify-content:center; padding:20px;\">\n        <div style=\"width:60px; height:80px; background:#c0c0c0; border-radius:4px; display:flex; align-items:center; justify-content:center;\">\n          <div style=\"width:36px; height:36px; border-radius:50%; border:3px solid #888; background:#666;\"></div>\n        </div>\n        <div style=\"width:70px; height:90px; background:#b0b0b0; border-radius:4px; display:flex; align-items:center; justify-content:center;\">\n          <div style=\"width:42px; height:42px; border-radius:50%; border:3px solid #777; background:#555;\"></div>\n        </div>\n        <div style=\"width:80px; height:100px; background:#a0a0a0; border-radius:4px; display:flex; align-items:center; justify-content:center;\">\n          <div style=\"width:48px; height:48px; border-radius:50%; border:3px solid #666; background:#444;\"></div>\n        </div>\n        <div style=\"width:90px; height:110px; background:#909090; border-radius:4px; display:flex; align-items:center; justify-content:center;\">\n          <div style=\"width:54px; height:54px; border-radius:50%; border:3px solid #555; background:#333;\"></div>\n        </div>\n        <div style=\"width:80px; height:100px; background:#a0a0a0; border-radius:4px; display:flex; align-items:center; justify-content:center;\">\n          <div style=\"width:48px; height:48px; border-radius:50%; border:3px solid #666; background:#444;\"></div>\n        </div>\n        <div style=\"width:70px; height:90px; background:#b0b0b0; border-radius:4px; display:flex; align-items:center; justify-content:center;\">\n