        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>光明日报 2025年1月5日 第12版</title>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  body { font-family: \"SimSun\", \"Songti SC\", serif; background: #f5f5f0; color: #222; font-size: 14px; line-height: 1.6; }\n  .page { max-width: 1100px; margin: 0 auto; background: #fff; padding: 10px 20px 20px; }\n\n  /* Header */\n  .header { text-align: center; padding: 10px 0 5px; }\n  .newspaper-name { font-family: \"KaiTi\", \"STKaiti\", serif; font-size: 72px; color: #c0392b; letter-spacing: 12px; font-weight: bold; line-height: 1.1; }\n  .newspaper-name-en { font-size: 16px; letter-spacing: 8px; color: #333; margin-top: 2px; }\n  .date-bar { background: #1a5276; color: #fff; padding: 6px 15px; font-size: 13px; display: flex; justify-content: space-between; align-items: center; margin-top: 5px; }\n  .date-bar span { margin: 0 8px; }\n  .pub-info { font-size: 11px; color: #555; padding: 4px 0; border-bottom: 2px solid #c0392b; margin-bottom: 10px; }\n\n  /* Top headline area */\n  .top-headline { text-align: center; padding: 10px 0; border-bottom: 1px solid #ddd; margin-bottom: 10px; }\n  .top-headline h1 { font-size: 32px; color: #222; letter-spacing: 4px; }\n  .top-headline h2 { font-size: 18px; color: #333; margin-top: 5px; }\n  .top-headline h3 { font-size: 16px; color: #444; margin-top: 3px; }\n\n  /* Main content grid */\n  .main-content { display: grid; grid-template-columns: 280px 1fr 280px; gap: 15px; margin-top: 10px; }\n\n  /* Left sidebar */\n  .left-sidebar { }\n  .red-banner { background: #c0392b; color: #fff; padding: 12px 15px; margin-bottom: 10px; }\n  .red-banner .slogan { font-size: 14px; line-height: 1.8; }\n  .red-banner .main-text { font-size: 22px; font-weight: bold; margin-top: 5px; }\n  .red-banner .main-text .highlight { color: #f1c40f; font-size: 28px; }\n\n  .art