        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>2024 · 美的集团ESG报告</title>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  body { font-family: \"Microsoft YaHei\", \"PingFang SC\", \"Helvetica Neue\", Arial, sans-serif; color: #333; background: #fff; font-size: 14px; line-height: 1.8; }\n  \n  .header { display: flex; justify-content: space-between; align-items: center; padding: 20px 50px; border-bottom: 1px solid #eee; }\n  .header-left { font-size: 14px; color: #666; }\n  .header-nav { display: flex; gap: 20px; align-items: center; font-size: 13px; color: #666; }\n  .header-nav a { text-decoration: none; color: #666; }\n  .header-nav .highlight { border: 1px solid #f0a500; border-radius: 20px; padding: 2px 12px; color: #f0a500; }\n\n  .main-content { display: flex; padding: 40px 50px; gap: 60px; }\n  .left-col { flex: 1; min-width: 0; }\n  .right-col { flex: 1; min-width: 0; }\n\n  h2 { font-size: 22px; font-weight: bold; color: #222; margin-bottom: 16px; margin-top: 10px; }\n  h2:first-child { margin-top: 0; }\n\n  .text-block { font-size: 14px; color: #555; line-height: 2; margin-bottom: 16px; text-align: justify; }\n\n  .reporting-section { display: flex; align-items: flex-start; gap: 20px; margin: 30px 0; }\n  .reporting-icon { flex-shrink: 0; width: 120px; display: flex; flex-direction: column; align-items: center; gap: 10px; }\n  .reporting-btn { background: #f0a500; color: #fff; padding: 8px 24px; border-radius: 20px; font-size: 14px; font-weight: bold; white-space: nowrap; }\n  .reporting-illustration { width: 100px; height: 80px; }\n  .reporting-illustration svg { width: 100%; height: 100%; }\n\n  .info-boxes { flex: 1; display: flex; flex-direction: column; gap: 16px; }\n  .info-box { background: #fdf8ec; border-radius: 8px; padding: 16px 20px; font-size: 13px; color: #555; line-height: 2; }\n  .info-box .label { font-weight: bold; color: #333; }\n\n  .stats-section { display: flex; margin: 30px 0; border-radius: 8px; overflow: hidden; }\n  .stats-label { background: #f0a500; color: #fff; padding: 20px 24px; display: flex; align-items: center; font-size: 14px; white-space: nowrap; }\n  .stats-content { flex: 1; display: flex; flex-direction: column; }\n  .stats-row { display: flex; align-items: center; padding: 16px 24px; background: #fdf8ec; }\n  .stats-row:first-child { border-bottom: 1px solid #f0e6c8; }\n  .stats-row .stats-text { flex: 1; font-size: 14px; color: #555; }\n  .stats-row .stats-number { font-size: 42px; font-weight: bold; color: #f0a500; }\n  .stats-row .stats-number .unit { font-size: 18px; font-weight: normal; }\n\n  .training-header { display: flex; align-items: center; gap: 12px; margin: 30px 0 16px; }\n  .training-icon { background: #f0a500; color: #fff; width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; }\n  .training-title { font-size: 16px; color: #f0a500; font-weight: bold; }\n\n  .training-content { display: flex; gap: 20px; margin-top: 16px; }\n  .training-text { flex: 1; font-size: 14px; color: #555; line-height: 2; text-align: justify; }\n  .training-image { flex-shrink: 0; width: 260px; }\n  .training-image .img-placeholder { width: 260px; height: 180px; background: #1a3a6b; border-radius: 4px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 12px; position: relative; overflow: hidden; }\n  .training-image .img-placeholder .midea-logo { position: absolute; top: 8px; right: 10px; font-size: 14px; font-weight: bold; color: #fff; }\n  .training-image .img-placeholder .img-text { text-align: center; font-size: 11px; line-height: 1.6; padding: 10px; }\n  .training-caption { font-size: 13px; color: #555; margin-top: 8px; display: flex; align-items: center; gap: 6px; }\n  .training-caption .dot { width: 8px; height: 8px; background: #f0a500; border-radius: 50%; display: inline-block; }\n\n  .footer-illustration { width: 100%; height: 200px; position: relative; margin-top: 20px; }\n  .footer-illustration .placeholder { width: 100%; height: 100%; background: linear-gradient(to bottom, #f5f0e0, #fff); border-radius: 8px; display: flex; align-items: flex-end; justify-content: center; font-size: 12px; color: #999; }\n\n  .page-numbers { display: flex; justify-content: space-between; padding: 10px 50px 20px; font-size: 13px; color: #999; }\n\n  .section-divider { margin: 30px 0; }\n\n  @media (max-width: 900px) {\n    .main-content { flex-direction: column; padding: 20px; gap: 30px; }\n    .header { flex-direction: column; gap: 10px; padding: 15px 20px; }\n    .header-nav { flex-wrap: wrap; }\n    .training-content { flex-direction: column; }\n    .training-image { width: 100%; }\n    .training-image .img-placeholder { width: 100%; }\n  }\n</style>\n</head>\n<body>\n\n<div class=\"header\">\n  <div class=\"header-left\">2024 · 美的集团ESG报告</div>\n  <div class=\"header-nav\">\n    <a href=\"#\">关于本报告</a>\n    <a href=\"#\">走进美的</a>\n    <a href=\"#\">可持续发展治理</a>\n    <a href=\"#\">守护蓝色星球</a>\n    <a href=\"#\">构建和谐社区</a>\n    <a href=\"#\">践行科技尽善</a>\n    <a href=\"#\" class=\"highlight\">共创繁荣生态</a>\n    <a href=\"#\">附录</a>\n  </div>\n</div>\n\n<div class=\"main-content\">\n  <!-- Left Column -->\n  <div class=\"left-col\">\n    <h2>举报机制</h2>\n    <p class=\"text-block\">我们制定《廉正举报管理办法》，完善举报分级调查机制，确保调查工作的公平公正、独立与客观，以打造透明、诚实的商业环境。此外，我们设置了投诉电话、电子邮箱、邮寄信件、线上投诉平台等多种举报渠道，鼓励员工及社会公众举报可疑的违规行为，并严格保密举报人相关信息，防止举报人受到任何形式的威胁和报复，保护举报人合法权益。</p>\n\n    <div class=\"reporting-section\">\n      <div class=\"reporting-icon\">\n        <div class=\"reporting-btn\">举报渠道</div>\n        <div class=\"reporting-illustration\">\n          <svg viewBox=\"0 0 100 80\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <rect x=\"10\" y=\"30\" width=\"30\" height=\"25\" rx=\"3\" stroke=\"#f0a500\" stroke-width=\"2\" fill=\"none\"/>\n            <rect x=\"15\" y=\"35\" width=\"20\" height=\"15\" rx=\"2\" stroke=\"#f0a500\" stroke-width=\"1.5\" fill=\"none\"/>\n            <circle cx=\"25\" cy=\"20\" r=\"8\" stroke=\"#f0a500\" stroke-width=\"2\" fill=\"none\"/>\n            <path d=\"M15 40 L5 55 L15 55\" stroke=\"#f0a500\" stroke-width=\"2\" fill=\"none\"/>\n            <rect x=\"50\" y=\"35\" width=\"35\" height=\"20\" rx=\"2\" stroke=\"#f0a500\" stroke-width=\"2\" fill=\"none\"/>\n            <rect x=\"55\" y=\"40\" width=\"25\" height=\"10\" rx=\"1\" stroke=\"#f0a500\" stroke-width=\"1.5\" fill=\"none\"/>\n            <line x1=\"67\" y1=\"55\" x2=\"67\" y2=\"65\" stroke=\"#f0a500\" stroke-width=\"2\"/>\n            <line x1=\"57\" y1=\"65\" x2=\"77\" y2=\"65\" stroke=\"#f0a500\" stroke-width=\"2\"/>\n            <circle cx=\"70\" cy=\"18\" r=\"7\" stroke=\"#f0a500\" stroke-width=\"2\" fill=\"none\"/>\n            <path d=\"M63 28 L77 28\" stroke=\"#f0a500\" stroke-width=\"2\"/>\n          </svg>\n        </div>\n      </div>\n      <div class=\"info-boxes\">\n        <div class=\"info-box\">\n          <span class=\"label\">· 客户服务与投诉热线：</span><br>\n          电话：4008899315<br>\n          邮箱：mideasmart_service@midea.com\n        </div>\n        <div class=\"info-box\">\n          <span class=\"label\">· 美的集团廉正与合规举报及咨询渠道：</span><br>\n          邮寄地址：中国广东省佛山市顺德区美的大道6号美的总部大楼廉正办公室<br>\n          邮编：528311<br>\n          电话：0757-2660 5599<br>\n          邮箱：tousu@midea.com；compliance@midea.com\n        </div>\n      </div>\n    </div>\n\n    <h2>商业道德审计</h2>\n    <p class=\"text-block\">为衡量美的集团商业道德工作的有效性和成熟度，我们持续开展监控和审查商业道德的专项工作。2024年，我们依据内部出台的《审计章程》等相关制度文件，在审计监察委员会和高级管理层的指导下制定2024年度审计计划，并在商业道德潜在风险及相关事件发生时对商业道德制度的有效性与所有业务运营行为进行审计，以实现持续监督、及时识别和解决合规风险的目标。</p>\n    <p class=\"text-block\">此外，我们制定了供应商反腐败政策，严格要求美的集团所有供应商制定其自身反腐败政策，并定义验证其政策执行的有效性。此外，我们要求所有供应商签署《廉洁合作协议》，旨在与供应商共同努力，携手促进商业生态的健康发展。</p>\n  </div>\n\n  <!-- Right Column -->\n  <div class=\"right-col\">\n    <h2>廉洁文化建设</h2>\n    <p class=\"text-block\">为向美的集团全体员工传递清廉的价值观，我们每年面向董事、管理层人员、全体员工（包括兼职和派遣员工）开展一系列商业道德标准培训工作，内容涵盖商业道德合规解读、企业典型案例研究、集团监督体系及举报程序等关键领域，确保每位全体员工理解并恪守商业道德准则，提升其道德与合规意识。</p>\n    <p class=\"text-block\">2024年，我们面向全体员工提供《廉正小课堂》、敏感岗位培训等课程，并针对关键岗位员工提出考核要求。截至报告期末，本集团所有10名董事均参与了反贪腐相关培训。</p>\n\n    <div class=\"stats-section\">\n      <div class=\"stats-label\">报告期内</div>\n      <div class=\"stats-content\">\n        <div class=\"stats-row\">\n          <span class=\"stats-text\">我们共计完成反贪腐相关培训</span>\n          <span class=\"stats-number\">371<span class=\"unit\">场</span></span>\n        </div>\n        <div class=\"stats-row\">\n          <span class=\"stats-text\">累计参与反腐败课程</span>\n          <span class=\"stats-number\">101,736<span class=\"unit\">人</span></span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"training-header\">\n      <div class=\"training-icon\">\n        <svg width=\"22\" height=\"22\" viewBox=\"0 0 22 22\" fill=\"none\">\n          <line x1=\"4\" y1=\"6\" x2=\"18\" y2=\"6\" stroke=\"#fff\" stroke-width=\"2\"/>\n          <line x1=\"4\" y1=\"11\" x2=\"18\" y2=\"11\" stroke=\"#fff\" stroke-width=\"2\"/>\n          <line x1=\"4\" y1=\"16\" x2=\"18\" y2=\"16\" stroke=\"#fff\" stroke-width=\"2\"/>\n          <circle cx=\"4\" cy=\"6\" r=\"1.5\" fill=\"#fff\"/>\n          <circle cx=\"4\" cy=\"11\" r=\"1.5\" fill=\"#fff\"/>\n          <circle cx=\"4\" cy=\"16\" r=\"1.5\" fill=\"#fff\"/>\n        </svg>\n      </div>\n      <span class=\"training-title\">廉正专题培训</span>\n    </div>\n\n    <div class=\"training-content\">\n      <div class=\"training-text\">\n        2024年12月，我们面向美的集团全体管理层开展廉正专题培训活动。在此次培训会上，审计部门为各位高管讲解《美的集团半年度廉正治理通报》，并通过分析企业典型腐败案例、分享廉洁相关投诉新闻的内容，向高管层传递企业商业道德合规经营风险，呼吁管理层持续推动企业廉洁文化建设，携手员工于合作伙伴共筑廉洁、透明的商业环境。\n      </div>\n      <div class=\"training-image\">\n        <div class=\"img-placeholder\">\n          <span class=\"midea-logo\">Midea</span>\n          <div class=\"img-text\">\n            反腐没有\"休止符\"，离职不是\"护身符\"<br>\n            There's no end to the combat against corruption.<br>\n            Leaving the position is no shield against accountability.<br><br>\n            因为在美的任职期间的一<br>\n            department in [illegible]en y\n          </div>\n        </div>\n        <div class=\"training-caption\">\n          <span class=\"dot\"></span> 廉正培训会现场\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<div class=\"footer-illustration\">\n  <div class=\"placeholder\">\n    <svg width=\"100%\" height=\"100%\" viewBox=\"0 0 1200 200\" preserveAspectRatio=\"xMidYMax meet\">\n      <!-- Decorative illustration: buildings, solar panels, wind turbines, light bulbs, trees, cars -->\n      <!-- Left side buildings -->\n      <rect x=\"20\" y=\"120\" width=\"40\" height=\"60\" fill=\"#e8e0d0\" rx=\"2\"/>\n      <rect x=\"25\" y=\"125\" width=\"8\" height=\"8\" fill=\"#f0d060\" rx=\"1\"/>\n      <rect x=\"37\" y=\"125\" width=\"8\" height=\"8\" fill=\"#f0d060\" rx=\"1\"/>\n      <rect x=\"25\" y=\"137\" width=\"8\" height=\"8\" fill=\"#f0d060\" rx=\"1\"/>\n      <rect x=\"37\" y=\"137\" width=\"8\" height=\"8\" fill=\"#f0d060\" rx=\"1\"/>\n      <rect x=\"25\" y=\"149\" width=\"8\" height=\"8\" fill=\"#f0d060\" rx=\"1\"/>\n      <rect x=\"37\" y=\"149\" width=\"8\" height=\"8\" fill=\"#f0d060\" rx=\"1\"/>\n      \n      <rect x=\"70\" y=\"100\" width=\"50\" height=\"80\" fill=\"#f0ebe0\" rx=\"2\"/>\n      <rect x=\"75\" y=\"105\" width=\"10\" height=\"10\" fill=\"#f0d060\" rx=\"1\"/>\n      <rect x=\"90\" y=\"105\" width=\"10\" height=\"10\" fill=\"#f0d060\" rx=\"1\"/>\n      <rect x=\"105\" y=\"105\" width=\"10\" height=\"10\" fill=\"#f0d060\" rx=\"1\"/>\n      <rect x=\"75\" y=\"120\" width=\"10\" height=\"10\" fill=\"#f0d060\" rx=\"1\"/>\n      <rect x=\"90\" y=\"120\" width=\"10\" height=\"10\" fill=\"#f0d060\" rx=\"1\"/>\n      <rect x=\"105\" y=\"120\" width=\"10\" height=\"10\" fill=\"#f0d060\" rx=\"1\"/>\n      <rect x=\"75\" y=\"135\" width=\"10\" height=\"10\" fill=\"#f0d060\" rx=\"1\"/>\n      <re