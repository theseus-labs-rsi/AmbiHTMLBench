: 1.5px solid #00a99d;\n    border-radius: 12px;\n    padding: 20px 25px;\n    margin-top: 20px;\n    display: flex;\n    align-items: center;\n    gap: 20px;\n    position: relative;\n    max-width: 420px;\n  }\n  .info-box-label {\n    position: absolute;\n    top: -14px;\n    left: 50%;\n    transform: translateX(-50%);\n    background: #00a99d;\n    color: #fff;\n    padding: 3px 24px;\n    border-radius: 14px;\n    font-size: 14px;\n    font-weight: bold;\n  }\n  .info-box-icon {\n    width: 100px;\n    height: 100px;\n    flex-shrink: 0;\n  }\n  .info-box-content {\n    flex: 1;\n  }\n  .info-box-content .label {\n    font-size: 14px;\n    color: #00a99d;\n    margin-bottom: 4px;\n  }\n  .info-box-content .number {\n    font-size: 48px;\n    font-weight: bold;\n    color: #00a99d;\n    line-height: 1.2;\n  }\n  .info-box-content .number span {\n    font-size: 20px;\n    font-weight: normal;\n  }\n  .illustration-area {\n    margin-top: 30px;\n    height: 280px;\n    position: relative;\n    overflow: hidden;\n  }\n  .illustration-placeholder {\n    width: 100%;\n    height: 100%;\n    background: linear-gradient(135deg, #e8f5f3 0%, #f0f9f7 50%, #e0f0ee 100%);\n    border-radius: 8px;\n    display: flex;\n    align-items: flex-end;\n    justify-content: center;\n    position: relative;\n  }\n  .illustration-placeholder::before {\n    content: '[Illustration: isometric mountains, buildings, solar panels, trees]';\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    color: #aaa;\n    font-size: 13px;\n  }\n  .page-number {\n    position: absolute;\n    bottom: 10px;\n    font-size: 13px;\n    color: #999;\n  }\n  .page-number.left { left: 0; }\n  .page-number.right { right: 0; }\n\n  /* Right page styles */\n  .ehs-container {\n    background: #eef7f6;\n    border-radius: 12px;\n    padding: 20px;\n    margin-top: 10px;\n  }\n  .ehs-item {\n    display: flex;\n    background: #fff;\n    border: 1px solid #c8e6e3;\n    border-radius: 8px;\n    margin-bottom: 14px;\n    overflow: hidden;\n  }\n  .ehs-item:last-child {\n    margin-bottom: 0;\n  }\n  .ehs-icon-box {\n    width: 110px;\n    min-height: 100px;\n    background: #00a99d;\n    color: #fff;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 12px 8px;\n    flex-shrink: 0;\n    text-align: center;\n  }\n  .ehs-icon-box .icon {\n    font-size: 28px;\n    margin-bottom: 4px;\n  }\n  .ehs-icon-box .icon-label {\n    font-size: 12px;\n    line-height: 1.4;\n  }\n  .ehs-content {\n    padding: 14px 18px;\n    flex: 1;\n  }\n  .ehs-content ul {\n    list-style: disc;\n    padding-left: 18px;\n    font-size: 13px;\n    color: #555;\n    line-height: 1.9;\n  }\n  .ehs-content ul li {\n    margin-bottom: 4px;\n  }\n\n  .stats-row {\n    display: flex;\n    gap: 16px;\n    margin-top: 20px;\n  }\n  .stat-card {\n    flex: 1;\n    display: flex;\n    align-items: center;\n    border-radius: 8px;\n    overflow: hidden;\n    min-height: 80px;\n  }\n  .stat-card-label {\n    background: #00a99d;\n    color: #fff;\n    padding: 16px 14px;\n    font-size: 13px;\n    text-align: center;\n    line-height: 1.5;\n    white-space: nowrap;\n  }\n  .stat-card-value {\n    background: #f0f9f7;\n    padding: 16px 20px;\n    flex: 1;\n    display: flex;\n    align-items: center;\n    gap: 12px;\n  }\n  .stat-card-value .stat-text {\n    font-size: 13px;\n    color: #00a99d;\n    line-height: 1.5;\n  }\n  .stat-card-value .stat-number {\n    font-size: 42px;\n    font-weight: bold;\n    color: #00a99d;\n    white-space: nowrap;\n  }\n  .stat-card-value .stat-number span {\n    font-size: 18px;\n    font-weight: normal;\n  }\n\n  .icon-svg {\n    width: 36px;\n    height: 36px;\n    margin-bottom: 4px;\n  }\n  .icon-svg svg {\n    width: 100%;\n    height: 100%;\n  }\n\n  @media (max-width: 900px) {\n    .spread {\n      flex-direction: column;\n      padding: 10px 15px;\n    }\n    .main-title { font-size: 28px; }\n    .section-title { font-size: 22px; }\n    .ehs-icon-box { width: 90px; }\n    .stats-row { flex-direction: column; }\n  }\n</style>\n</head>\n<body>\n\n<div class=\"spread\">\n  <!-- Page 31 -->\n  <div class=\"page\">\n    <div class=\"page-header\">\n      <span>2024 · 美的集团ESG报告</span>\n    </div>\n\n    <h1 class=\"main-title\">绿色使命 推进环境友好</h1>\n\n    <p class=\"body-text\">\n      美的集团积极承担绿色低碳发展的企业使命，不断优化和完善环境管理体系，并持续推动节能降耗和资源的高效利用。同时，我们始终关注生物多样性保护，并通过绿色融资助力低碳发展，为实现可持续发展目标贡献力量。\n    </p>\n\n    <h2 class=\"section-title\">绿色制造践行者</h2>\n\n    <p class=\"body-text\">\n      美的集团把绿色环保的理念纳入生产运营全流程，严格遵守运营所在国家和地区的法律法规，并根据自身各运营场所的适用情况，制定并持续完善各项环境管理制度，确保环境管理体系持续有效运行。报告期内，美的集团未发生重大环境事故，未因环境事件受到重大的行政处罚。\n    </p>\n\n    <h3 class=\"section-title-dark\">环境管理体系</h3>\n\n    <p class=\"body-text\">\n      我们在\"遵守法规，实现污染预防、营造绿色环境，共建美的家园\"方针的指引下，从 EHS 治理架构、管理体系建设、信息化平台搭建、体系评审及认证等方面有效保障环境管理的稳健运作。2024年度，我们发布了《美的集团环境与职业健康安全管理政策》，明确EHS管理方针、管理目标等内容。\n    </p>\n\n    <div class=\"info-box\">\n      <div class=\"info-box-label\">报告期末</div>\n      <div class=\"info-box-icon\">\n        <svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\">\n          <rect x=\"20\" y=\"30\" width=\"60\" height=\"50\" rx=\"3\" fill=\"#e0f0ee\" stroke=\"#00a99d\" stroke-width=\"1.5\"/>\n          <rect x=\"30\" y=\"40\" width=\"12\" height=\"12\" rx=\"1\" fill=\"#00a99d\" opacity=\"0.3\"/>\n          <rect x=\"48\" y=\"40\" width=\"12\" height=\"12\" rx=\"1\" fill=\"#00a99d\" opacity=\"0.3\"/>\n          <rect x=\"30\" y=\"58\" width=\"12\" height=\"12\" rx=\"1\" fill=\"#00a99d\" opacity=\"0.3\"/>\n          <rect x=\"48\" y=\"58\" width=\"12\" height=\"12\" rx=\"1\" fill=\"#00a99d\" opacity=\"0.3\"/>\n          <rect x=\"38\" y=\"68\" width=\"14\" height=\"12\" rx=\"1\" fill=\"#00a99d\" opacity=\"0.5\"/>\n          <circle cx=\"72\" cy=\"25\" r=\"8\" fill=\"#e0f0ee\" stroke=\"#00a99d\" stroke-width=\"1\"/>\n          <line x1=\"72\" y1=\"33\" x2=\"72\" y2=\"45\" stroke=\"#00a99d\" stroke-width=\"1.5\"/>\n          <circle cx=\"15\" cy=\"70\" r=\"6\" fill=\"#e0f0ee\" stroke=\"#00a99d\" stroke-width=\"1\"/>\n          <line x1=\"15\" y1=\"76\" x2=\"15\" y2=\"85\" stroke=\"#00a99d\" stroke-width=\"1.5\"/>\n          <circle cx=\"85\" cy=\"72\" r=\"5\" fill=\"#e0f0ee\" stroke=\"#00a99d\" stroke-width=\"1\"/>\n          <line x1=\"85\" y1=\"77\" x2=\"85\" y2=\"85\" stroke=\"#00a99d\" stroke-width=\"1.5\"/>\n        </svg>\n      </div>\n      <div class=\"info-box-content\">\n        <div class=\"label\">已成功建立国家级绿色工厂</div>\n        <div class=\"number\">37<span>家</span></div>\n      </div>\n    </div>\n\n    <div class=\"illustration-area\">\n      <div class=\"illustration-placeholder\"></div>\n    </div>\n\n    <div class=\"page-number left\">31</div>\n  </div>\n\n  <!-- Page 32 -->\n  <div class=\"page\">\n    <div class=\"page-header\">\n      <div class=\"nav-links\">\n        <span>关于本报告</span>\n        <span>走进美的</span>\n        <span>可持续发展治理</span>\n        <span class=\"active\">守护蓝色星球</span>\n        <span>构建和谐社区</span>\n        <span>践行科技尽善</span>\n        <span>共创繁荣生态</span>\n        <span>附录</span>\n      </div>\n    </div>\n\n    <div class=\"ehs-container\">\n      <!-- EHS 治理架构 -->\n      <div class=\"ehs-item\">\n        <div class=\"ehs-icon-box\">\n          <div class=\"icon-svg\">\n            <svg viewBox=\"0 0 36 36\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n              <rect x=\"4\" y=\"4\" width=\"10\" height=\"10\" rx=\"2\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <rect x=\"13\" y=\"4\" width=\"10\" height=\"10\" rx=\"2\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <rect x=\"22\" y=\"4\" width=\"10\" height=\"10\" rx=\"2\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <line x1=\"9\" y1=\"14\" x2=\"9\" y2=\"20\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <line x1=\"18\" y1=\"14\" x2=\"18\" y2=\"20\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <line x1=\"27\" y1=\"14\" x2=\"27\" y2=\"20\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <rect x=\"10\" y=\"20\" width=\"16\" height=\"12\" rx=\"2\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n            </svg>\n          </div>\n          <div class=\"icon-label\">EHS<br>治理架构</div>\n        </div>\n        <div class=\"ehs-content\">\n          <ul>\n            <li>安全管理委员会作为集团EHS最高决策机构，统筹决策环境保护、安全生产及职业卫生管理，负责EHS执行情况的监督与考核；</li>\n            <li>下设办公室作为执行机构，负责日常管理及定期汇报。各事业群/事业部建立属地化治理架构，落实EHS政策、目标及管理要求。</li>\n          </ul>\n        </div>\n      </div>\n\n      <!-- EHS 管理体系 -->\n      <div class=\"ehs-item\">\n        <div class=\"ehs-icon-box\">\n          <div class=\"icon-svg\">\n            <svg viewBox=\"0 0 36 36\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n              <circle cx=\"18\" cy=\"10\" r=\"6\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <line x1=\"18\" y1=\"16\" x2=\"18\" y2=\"22\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <line x1=\"12\" y1=\"22\" x2=\"24\" y2=\"22\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <line x1=\"12\" y1=\"22\" x2=\"12\" y2=\"28\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <line x1=\"18\" y1=\"22\" x2=\"18\" y2=\"28\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <line x1=\"24\" y1=\"22\" x2=\"24\" y2=\"28\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <rect x=\"8\" y=\"28\" width=\"20\" height=\"4\" rx=\"1\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n            </svg>\n          </div>\n          <div class=\"icon-label\">EHS<br>管理体系</div>\n        </div>\n        <div class=\"ehs-content\">\n          <ul>\n            <li>依据法规、行业最佳实践及业务特性，落实既定EHS政策、体系标准，确保目标达成；</li>\n            <li>制定《EHS管理控制框架手册》，统一管理边界、流程管控及数据记录标准；</li>\n            <li>贯彻\"一个美的，一个体系，一个标准\"原则，构建覆盖关键领域的EHS技术标准与审核体系，强化全集团规范化管理。</li>\n          </ul>\n        </div>\n      </div>\n\n      <!-- EHS 数智化平台 -->\n      <div class=\"ehs-item\">\n        <div class=\"ehs-icon-box\">\n          <div class=\"icon-svg\">\n            <svg viewBox=\"0 0 36 36\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n              <rect x=\"6\" y=\"6\" width=\"24\" height=\"24\" rx=\"3\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <path d=\"M12 18 L16 22 L24 14\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              <circle cx=\"18\" cy=\"18\" r=\"10\" stroke=\"#fff\" stroke-width=\"1\" opacity=\"0.5\"/>\n            </svg>\n          </div>\n          <div class=\"icon-label\">EHS<br>数智化平台</div>\n        </div>\n        <div class=\"ehs-content\">\n          <ul>\n            <li>建立基于\"智能采集、智能预警、智能管控、智能预测、智能决策、智能分析\"的EHS数智化平台，包括智慧环保、环保在线监测，环保设施维护、危废管理等模块；</li>\n            <li>对各基地主要排污口在线监测数据进行收集分析，实现对污染物的全面检测及精准超标预警管理，达到全时段全场景的环境排污数据精准监控，确保排放合规。</li>\n          </ul>\n        </div>\n      </div>\n\n      <!-- EHS 风险管理 -->\n      <div class=\"ehs-item\">\n        <div class=\"ehs-icon-box\">\n          <div class=\"icon-svg\">\n            <svg viewBox=\"0 0 36 36\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n              <circle cx=\"18\" cy=\"18\" r=\"12\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <circle cx=\"18\" cy=\"18\" r=\"7\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <circle cx=\"18\" cy=\"18\" r=\"2.5\" fill=\"#fff\"/>\n              <line x1=\"18\" y1=\"6\" x2=\"18\" y2=\"2\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <line x1=\"18\" y1=\"30\" x2=\"18\" y2=\"34\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <line x1=\"6\" y1=\"18\" x2=\"2\" y2=\"18\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <line x1=\"30\" y1=\"18\" x2=\"34\" y2=\"18\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n            </svg>\n          </div>\n          <div class=\"icon-label\">EHS<br>风险管理</div>\n        </div>\n        <div class=\"ehs-content\">\n          <ul>\n            <li>建立危险有害因素及环境因素辨识流程，主动识别、评估和监测自身运营过程中的环境等EHS风险源并对各风险进行等级划分，针对性落实风险管控措施；</li>\n            <li>建立并健全针对突发环境事件等的EHS应急机制，对EHS风险事件进行分级管理，并制定相应的预防和应急举措，确保建立快速有效的应急处理流程。</li>\n          </ul>\n        </div>\n      </div>\n\n      <!-- 体系评审与认证 -->\n      <div class=\"ehs-item\">\n        <div class=\"ehs-icon-box\">\n          <div class=\"icon-svg\">\n            <svg viewBox=\"0 0 36 36\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n              <circle cx=\"12\" cy=\"12\" r=\"5\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <circle cx=\"24\" cy=\"12\" r=\"5\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <circle cx=\"18\" cy=\"24\" r=\"5\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <line x1=\"15\" y1=\"15\" x2=\"15\" y2=\"20\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <line x1=\"21\" y1=\"15\" x2=\"21\" y2=\"20\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n              <path d=\"M10 28 L14 24 L18 28 L22 24 L26 28\" stroke=\"#fff\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            </svg>\n          </div>\n          <div class=\"icon-label\">体系评审<br>与认证</div>\n        </div>\n        <div class=\"ehs-content\">\n          <ul>\n            <li>各事业群 / 事业部实施年度 EHS 评审，覆盖程序文件执行、合规性及目标达成等维度；</li>\n            <li>开展年度集团层面评审，重点评估 EHS 管理制度及重点工作执行情况；</li>\n            <li>工厂年度进行EHS管理评审，评审结果由安委会汇总整理后向管理层汇报，包括工厂合规管控、体系执行情况、不符合项关闭进度等。</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"stats-row\">\n      <div class=\"stat-card\">\n        <div class=\"stat-card-label\">截至<br>报告期末</div>\n        <div class=\"stat-card-value\">\n          <div class=\"stat-text\">ISO 14001 认证工厂</div>\n          <div class=\"stat-number\">37<span>家</span></div>\n        </div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-card-value\" style=\"background:#f0f9f7;\">\n          <div class=\"stat-text\">全球制造基地<br>环境管理体系<br>认证覆盖率</div>\n          <div class=\"stat-number\">100<span>%</span></div>\n        </div>\n   