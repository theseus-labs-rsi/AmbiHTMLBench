er;\n    margin-bottom: 20px;\n    gap: 15px;\n    flex-wrap: wrap;\n  }\n\n  .unit-label {\n    background: linear-gradient(135deg, #4CAF50, #2E7D32);\n    color: #fff;\n    padding: 10px 20px;\n    font-size: 22px;\n    font-weight: bold;\n    clip-path: polygon(0 0, 85% 0, 100% 50%, 85% 100%, 0 100%);\n    padding-right: 35px;\n    white-space: nowrap;\n  }\n\n  .main-title {\n    background: linear-gradient(135deg, #e91e63, #c2185b);\n    color: #fff;\n    padding: 12px 30px;\n    font-size: 28px;\n    font-weight: bold;\n    border-radius: 8px;\n    letter-spacing: 4px;\n  }\n\n  .subtitle {\n    text-align: center;\n    font-size: 14px;\n    color: #666;\n    margin-top: -10px;\n    margin-bottom: 15px;\n    letter-spacing: 2px;\n  }\n\n  /* Two column layout */\n  .content-columns {\n    display: flex;\n    gap: 20px;\n  }\n\n  .column {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    gap: 15px;\n  }\n\n  /* Section boxes */\n  .section-box {\n    border-radius: 10px;\n    overflow: hidden;\n    border: 1px solid #ddd;\n  }\n\n  .section-header {\n    padding: 8px 15px;\n    color: #fff;\n    font-size: 16px;\n    font-weight: bold;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n  }\n\n  .section-header .num {\n    font-size: 18px;\n  }\n\n  .section-body {\n    padding: 12px 15px;\n    font-size: 14px;\n    line-height: 1.8;\n    background: #f9f9f9;\n  }\n\n  /* Color themes */\n  .theme-blue .section-header { background: linear-gradient(90deg, #5dade2, #3498db); }\n  .theme-blue .section-body { background: #eaf4fb; }\n\n  .theme-green .section-header { background: linear-gradient(90deg, #58d68d, #27ae60); }\n  .theme-green .section-body { background: #eafaf1; }\n\n  .theme-purple .section-header { background: linear-gradient(90deg, #a569bd, #8e44ad); }\n  .theme-purple .section-body { background: #f4ecf7; }\n\n  .theme-yellow .section-header { background: linear-gradient(90deg, #f0b27a, #e67e22); }\n  .theme-yellow .section-body { background: #fef9e7; }\n\n  .theme-red .section-header { background: linear-gradient(90deg, #ec7063, #e74c3c); }\n  .theme-red .section-body { background: #fdedec; }\n\n  .theme-darkgreen .section-header { background: linear-gradient(90deg, #27ae60, #1e8449); }\n  .theme-darkgreen .section-body { background: #eafaf1; }\n\n  .theme-darkpurple .section-header { background: linear-gradient(90deg, #7d66a8, #6c3483); }\n  .theme-darkpurple .section-body { background: #f4ecf7; }\n\n  /* Connector lines between sections */\n  .connector {\n    width: 2px;\n    height: 12px;\n    background: #ccc;\n    margin: 0 auto;\n  }\n\n  /* Special styling for 交流平台 */\n  .exchange-box .section-body {\n    background: #eaf4fb;\n  }\n\n  /* 单元习作 special */\n  .writing-box .section-body {\n    background: #f4ecf7;\n  }\n\n  .writing-box .section-body .sub-title {\n    text-align: center;\n    font-weight: bold;\n    margin-bottom: 8px;\n    font-size: 15px;\n  }\n\n  .writing-box .section-body .sub-title::before {\n    content: \"——\";\n  }\n  .writing-box .section-body .sub-title::after {\n    content: \"——\";\n  }\n\n  /* Watermark */\n  .watermark {\n    position: absolute;\n    top: 50%;\n    right: 20px;\n    transform: translateY(-50%);\n    color: rgba(200, 200, 200, 0.3);\n    font-size: 14px;\n    pointer-events: none;\n  }\n\n  /* Responsive */\n  @media (max-width: 700px) {\n    .content-columns {\n      flex-direction: column;\n    }\n    .main-title {\n      font-size: 22px;\n    }\n  }\n\n  .section-body p {\n    margin-bottom: 8px;\n  }\n\n  .section-body p:last-child {\n    margin-bottom: 0;\n  }\n\n  .highlight {\n    font-weight: bold;\n  }\n\n  .quote {\n    color: #2c3e50;\n  }\n</style>\n</head>\n<body>\n\n<div class=\"page-container\">\n  <!-- Decorative banner -->\n  <div class=\"banner\">\n    <div class=\"banner-line\"></div>\n    <div class=\"banner-triangle\"></div>\n    <div class=\"banner-triangle\"></div>\n    <div class=\"banner-triangle\"></div>