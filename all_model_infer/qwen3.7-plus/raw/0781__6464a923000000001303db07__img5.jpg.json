\"><span class=\"label\">原因</span><span class=\"content\">病原微生物引起在夏季高发</span></div>\n      <div class=\"row\"><span class=\"label\">症状</span><span class=\"content\">腹痛恶心，发热，没食欲</span></div>\n      <div class=\"row\"><span class=\"label\">大便</span><span class=\"content\">大便稀且有黏液，严重时便血</span></div>\n      <div class=\"row\"><span class=\"label\">护理</span><span class=\"content\">补液避免脱水，<br>注意饮食卫生</span></div>\n    </div>\n\n    <!-- 乳糖不耐受腹泻 -->\n    <div class=\"card\">\n      <div class=\"card-title-wrap\"><span class=\"card-title\">乳糖不耐受腹泻</span></div>\n      <div class=\"row\"><span class=\"label\">原因</span><span class=\"content\">由于肠道中缺乏乳糖酶引起</span></div>\n      <div class=\"row\"><span class=\"label\">症状</span><span class=\"content\">肠胀气、肠绞痛，吃奶就拉</span></div>\n      <div class=\"row\"><span class=\"label\">大便</span><span class=\"content\">次数多，大便有奶瓣泡沫状</span></div>\n      <div class=\"row\"><span class=\"label\">护理</span><span class=\"content\">母乳妈妈忌口高糖和奶制品</span></div>\n    </div>\n\n    <!-- 受凉引起腹泻 -->\n    <div class=\"card\">\n      <div class=\"card-title-wrap\"><span class=\"card-title\">受凉引起腹泻</span></div>\n      <div class=\"row\"><span class=\"label\">原因</span><span class=\"content\">由腹部或身体受凉引起</span></div>\n      <div class=\"row\"><span class=\"label\">症状</span><span class=\"content\">胃胀，恶心，呕吐，屁多</span></div>\n      <div class=\"row\"><span class=\"label\">大便</span><span class=\"content\">大便水样，有泡沫</span></div>\n      <div class=\"row\"><span class=\"label\">护理</span><span class=\"content\">注意身体和肚子保暖，<br>不吃生冷辛辣</span></div>\n    </div>\n  </div>\n</div>\n</body>\n</html>",
