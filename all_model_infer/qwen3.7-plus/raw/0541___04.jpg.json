        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>电工工具大全</title>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  body {\n    font-family: \"Microsoft YaHei\", \"PingFang SC\", \"Helvetica Neue\", Arial, sans-serif;\n    background: #f0f0f0;\n    display: flex;\n    justify-content: center;\n    padding: 10px;\n  }\n  .container {\n    max-width: 1200px;\n    width: 100%;\n    background: #fff;\n    border-radius: 12px;\n    overflow: hidden;\n    box-shadow: 0 2px 20px rgba(0,0,0,0.1);\n  }\n  .header {\n    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);\n    padding: 30px 40px;\n    display: flex;\n    align-items: center;\n    gap: 20px;\n    position: relative;\n  }\n  .header-toolbox {\n    width: 120px;\n    height: 100px;\n    flex-shrink: 0;\n  }\n  .header-toolbox .placeholder {\n    width: 120px;\n    height: 100px;\n    background: #2a2a4a;\n    border-radius: 8px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #aaa;\n    font-size: 12px;\n  }\n  .header-text {\n    flex: 1;\n  }\n  .header-text h1 {\n    font-size: 52px;\n    color: #fff;\n    font-weight: 900;\n    letter-spacing: 4px;\n  }\n  .header-text h1 .highlight {\n    color: #f5c518;\n  }\n  .header-text p {\n    font-size: 22px;\n    color: #e0e0e0;\n    margin-top: 8px;\n    letter-spacing: 2px;\n  }\n  .header-icons {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 5px;\n  }\n  .lightning {\n    font-size: 60px;\n    color: #f5c518;\n  }\n  .screwdriver-icon {\n    width: 60px;\n    height: 60px;\n  }\n  .screwdriver-icon .placeholder {\n    width: 60px;\n    height: 60px;\n    background: #2a2a4a;\n    border-radius: 8px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #aaa;\n    font-size: 10px;\n  }\n  .section-title {\n    background: #1a5276;\n    color: #fff;\n    text-align: center;\n    padding: 12px 20px;\n    font-size: 22px;\n    font-weight: bold;\n    letter-spacing: 4px;\n    border-radius: 25px;\n    margin: 20px auto;\n    max-width: 500px;\n  }\n  .tools-grid {\n    display: grid;\n    grid-template-columns: repeat(6, 1fr);\n    gap: 0;\n    border: 2px solid #ddd;\n    border-radius: 8px;\n    overflow: hidden;\n    margin: 0 15px;\n  }\n  .tool-card {\n    border: 1px solid #e0e0e0;\n    padding: 12px 10px;\n    text-align: center;\n    background: #fff;\n    min-height: 220px;\n    display: flex;\n    flex-direction: column;\n  }\n  .tool-card-header {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    margin-bottom: 8px;\n  }\n  .tool-number {\n    background: #1a5276;\n    color: #fff;\n    width: 24px;\n    height: 24px;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 13px;\n    font-weight: bold;\n    flex-shrink: 0;\n  }\n  .tool-name {\n    font-size: 15px;\n    font-weight: bold;\n    color: #1a1a2e;\n  }\n  .tool-image {\n    width: 100%;\n    height: 80px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin: 5px 0;\n  }\n  .tool-image .placeholder {\n    width: 80px;\n    height: 70px;\n    background: #f8f9fa;\n    border-radius: 6px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #999;\n    font-size: 10px;\n    border: 1px dashed #ddd;\n  }\n  .tool-desc {\n    text-align: left;\n    font-size: 11px;\n    color: #333;\n    line-height: 1.6;\n    margin-top: auto;\n  }\n  .tool-desc .label {\n    color: #1a5276;\n    font-weight: bold;\n  }\n  .tutorial-section {\n    margin: 25px 15px;\n  }\n  .tutorial-title {\n    background: #27ae60;\n    color: #fff;\n    text-align: center;\n    padding: 12px 20px;\n    font-size: 22px;\n    font-weight: bold;\n    letter-spacing: 4px;\n    border-radius: 25px;\n    margin: 0 auto 20px;\n    max-width: 500px;\n  }\n  .tutorial-grid {\n    display: grid;\n    grid-template-columns: repeat(6, 1fr);\n    gap: 12px;\n  }\n  .tutorial-card {\n    border: 1px solid #e0e0e0;\n    border-radius: 8px;\n    overflow: hidden;\n    background: #fff;\n  }\n  .tutorial-card-header {\n    background: #e8f5e9;\n    padding: 8px 10px;\n    font-size: 14px;\n    font-weight: bold;\n    color: #1a5276;\n    text-align: center;\n  }\n  .tutorial-image {\n    width: 100%;\n    height: 100px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: #f8f9fa;\n  }\n  .tutorial-image .placeholder {\n    width: 90%;\n    height: 85px;\n    background: #eee;\n    border-radius: 6px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #999;\n    font-size: 10px;\n    border: 1px dashed #ccc;\n  }\n  .tutorial-desc {\n    padding: 10px;\n    font-size: 11px;\n    color: #333;\n    line-height: 1.6;\n    text-align: left;\n  }\n  .safety-section {\n    margin: 20px 15px 25px;\n    display: flex;\n    gap: 15px;\n    align-items: flex-start;\n  }\n  .safety-warning {\n    background: #e74c3c;\n    color: #fff;\n    padding: 15px 20px;\n    border-radius: 10px;\n    text-align: center;\n    flex-shrink: 0;\n    min-width: 140px;\n  }\n  .safety-warning .icon {\n    font-size: 40px;\n    margin-bottom: 5px;\n  }\n  .safety-warning .text {\n    font-size: 16px;\n    font-weight: bold;\n  }\n  .safety-tips {\n    flex: 1;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 8px 20px;\n  }\n  .safety-tip {\n    display: flex;\n    align-items: flex-start;\n    gap: 8px;\n    font-size: 13px;\n    color: #333;\n    line-height: 1.5;\n  }\n  .safety-tip .tip-icon {\n    width: 22px;\n    height: 22px;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 11px;\n    font-weight: bold;\n    color: #fff;\n    flex-shrink: 0;\n    margin-top: 1px;\n  }\n  .tip-icon.blue { background: #1a5276; }\n  .tip-icon.green { background: #27ae60; }\n  .tip-icon.orange { background: #e67e22; }\n  .tip-icon.red { background: #e74c3c; }\n  .tip-icon.yellow { background: #f39c12; }\n  .safety-badge {\n    flex-shrink: 0;\n    text-align: center;\n    min-width: 100px;\n  }\n  .safety-badge .helmet {\n    width: 70px;\n    height: 70px;\n    margin: 0 auto 5px;\n  }\n  .safety-badge .helmet .placeholder {\n    width: 70px;\n    height: 70px;\n    background: #f0c040;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #fff;\n    font-size: 10px;\n  }\n  .safety-badge .badge-text {\n    font-size: 12px;\n    color: #333;\n    font-weight: bold;\n  }\n  .footer-logo {\n    text-align: right;\n    padding: 10px 20px;\n    font-size: 14px;\n    color: #1a5276;\n    font-weight: bold;\n  }\n  .footer-logo .placeholder {\n    display: inline-block;\n    width: 30px;\n    height: 30px;\n    background: #1a5276;\n    border-radius: 50%;\n    vertical-align: middle;\n    margin-right: 5px;\n  }\n</style>\n</head>\n<body>\n<div class=\"container\">\n  <!-- Header -->\n  <div class=\"header\">\n    <div class=\"header-toolbox\">\n      <div class=\"placeholder\">[Toolbox image]</div>\n    </div>\n    <div class=\"header-text\">\n      <h1>电工工具<span class=\"highlight\">大全</span> ⚡</h1>\n      <p>让您分分钟认清电工工具和用法</p>\n    </div>\n    <div class=\"header-icons\">\n      <div class=\"lightning\">⚡</div>\n      <div class=\"screwdriver-icon\">\n        <div class=\"placeholder\">[Screwdriver]</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Section Title -->\n  <div style=\"text-align:center; margin-top: 20px;\">\n    <div class=\"section-title\">常用电工工具盘点与用法</div>\n  </div>\n\n  <!-- Tools Grid Row 1 -->\n  <div class=\"tools-grid\">\n    <!-- Tool 1 -->\n    <div class=\"tool-card\">\n      <div class=\"tool-card-header\">\n        <div class=\"tool-number\">1</div>\n        <div class=\"tool-name\">一字螺丝刀</div>\n      </div>\n      <div class=\"tool-image\"><div class=\"placeholder\">[一字螺丝刀]</div></div>\n      <div class=\"tool-desc\">\n        <span class=\"label\">用途：</span>拧一字槽螺丝<br>\n        <span class=\"label\">用法：</span>刀头对准螺丝槽，垂直用力旋转。\n      </div>\n    </div>\n    <!-- Tool 2 -->\n    <div class=\"tool-card\">\n      <div class=\"tool-card-header\">\n        <div class=\"tool-number\">2</div>\n        <div class=\"tool-name\">十字螺丝刀</div>\n      </div>\n      <div class=\"tool-image\"><div class=\"placeholder\">[十字螺丝刀]</div></div>\n      <div class=\"tool-desc\">\n        <span class=\"label\">用途：</span>拧十字槽螺丝<br>\n        <span class=\"label\">用法：</span>刀头对准螺丝槽，垂直用力旋转。\n      </div>\n    </div>\n    <!-- Tool 3 -->\n    <div class=\"tool-card\">\n      <div class=\"tool-card-header\">\n        <div class=\"tool-number\">3</div>\n        <div class=\"tool-name\">测电笔</div>\n      </div>\n      <div class=\"tool-image\"><div class=\"placeholder\">[测电笔]</div></div>\n      <div class=\"tool-desc\">\n        <span class=\"label\">用途：</span>检测火线<br>\n        <span class=\"label\">用法：</span>手指接触笔尾金属，笔尖接触导线，氖管亮表示为火线。\n      </div>\n    </div>\n    <!-- Tool 4 -->\n    <div class=\"tool-card\">\n      <div class=\"tool-card-header\">\n        <div class=\"tool-number\">4</div>\n        <div class=\"tool-name\">万用表</div>\n      </div>\n      <div class=\"tool-image\"><div class=\"placeholder\">[万用表 2200]</div></div>\n      <div class=\"tool-desc\">\n        <span class=\"label\">用途：</span>测电压、电流、电阻等<br>\n        <span class=\"label\">用法：</span>根据测量需求选择档位，表笔正确接线后进行测量。\n      </div>\n    </div>\n    <!-- Tool 5 -->\n    <div class=\"tool-card\">\n      <div class=\"tool-card-header\">\n        <div class=\"tool-number\">5</div>\n        <div class=\"tool-name\">钢丝钳</div>\n      </div>\n      <div class=\"tool-image\"><div class=\"placeholder\">[钢丝钳]</div></div>\n      <div class=\"tool-desc\">\n        <span class=\"label\">用途：</span>夹持、弯曲、剪切导线<br>\n        <span class=\"label\">用法：</span>用钳口夹持物体，需要剪切时用靠近铰链处的刀口。\n      </div>\n    </div>\n    <!-- Tool 6 -->\n    <div class=\"tool-card\">\n      <div class=\"tool-card-header\">\n        <div class=\"tool-number\">6</div>\n        <div class=\"tool-name\">尖嘴钳</div>\n      </div>\n      <div class=\"tool-image\"><div class=\"placeholder\">[尖嘴钳]</div></div>\n      <div class=\"tool-desc\">\n        <span class=\"label\">用途：</span>夹持小件、弯折导线<br>\n        <span class=\"label\">用法：</span>用钳尖夹持小件，适合在狭小空间操作。\n      </div>\n    </div>\n\n    <!-- Tool 7 -->\n    <div class=\"tool-card\">\n      <div class=\"tool-card-header\">\n        <div class=\"tool-number\">7</div>\n        <div class=\"tool-name\">斜口钳</div>\n      </div>\n      <div class=\"tool-image\"><div class=\"placeholder\">[斜口钳]</div></div>\n      <div class=\"tool-desc\">\n        <span class=\"label\">用途：</span>剪切导线、铜丝等<br>\n        <span class=\"label\">用法：</span>将导线放入钳口，用力握紧即可剪断。\n      </div>\n    </div>\n    <!-- Tool 8 -->\n    <div class=\"tool-card\">\n      <div class=\"tool-card-header\">\n        <div class=\"tool-number\">8</div>\n        <div class=\"tool-name\">剥线钳</div>\n      </div>\n      <div class=\"tool-image\"><div class=\"placeholder\">[剥线钳]</div></div>\n      <div class=\"tool-desc\">\n        <span class=\"label\">用途：</span>剥离导线绝缘层<br>\n        <span class=\"label\">用法：</span>根据导线规格选择剥线口，夹紧后旋转或轻压剥离。\n      </div>\n    </div>\n    <!-- Tool 9 -->\n    <div class=\"tool-card\">\n      <div class=\"tool-card-header\">\n        <div class=\"tool-number\">9</div>\n        <div class=\"tool-name\">电工刀</div>\n      </div>\n      <div class=\"tool-image\"><div class=\"placeholder\">[电工刀]</div></div>\n      <div class=\"tool-desc\">\n        <span class=\"label\">用途：</span>剥线、削绝缘层<br>\n        <span class=\"label\">用法：</span>刀口朝外，轻划绝缘层，切勿用力过猛以免伤到导线。\n      </div>\n    </div>\n    <!-- Tool 10 -->\n    <div class=\"tool-card\">\n      <div class=\"tool-card-header\">\n        <div class=\"tool-number\">10</div>\n        <div class=\"tool-name\">卷尺</div>\n      </div>\n      <div class=\"tool-image\"><div class=\"placeholder\">[卷尺 5m]</div></div>\n      <div class=\"tool-desc\">\n        <span class=\"label\">用途：</span>测量长度<br>\n        <span class=\"label\">用法：</span>拉出尺带，勾住测量起点，读取刻度。\n      </div>\n    </div>\n    <!-- Tool 11 -->\n    <div class=\"tool-card\">\n      <div class=\"tool-card-header\">\n        <div class=\"tool-number\">11</div>\n        <div class=\"tool-name\">绝缘胶带</div>\n      </div>\n      <div class=\"tool-image\"><div class=\"placeholder\">[绝缘胶带]</div></div>\n      <div class=\"tool-desc\">\n        <span class=\"label\">用途：</span>绝缘包扎、标识<br>\n        <span class=\"label\">用法：</span>缠绕在导线接头处，起到绝缘和保护作用。\n      </div>\n    </div>\n    <!-- Tool 12 -->\n    <div class=\"tool-card\">\n      <div class=\"tool-card-header\">\n        <div class=\"tool-number\">12</div>\n        <div class=\"tool-name\">热缩管</div>\n      </div>\n      <div class=\"tool-image\"><div class=\"placeholder\">[热缩管]</div></div>\n      <div class=\"tool-desc\">\n        <span class=\"label\">用途：</span>绝缘保护<br>\n        <span class=\"label\">用法：</span>套在导线接头处，用热风枪加热收缩即可。\n      </div>\n    </div>\n\n    <!-- Tool 13 -->\n    <div class=\"tool-card\">\n      <div class=\"tool-card-header\">\n        <div class=\"tool-number\">13</div>\n        <div class=\"tool-name\">电烙铁</div>\n      </div>\n      <div class=\"tool-image\"><div class=\"placeholder\">[电烙铁]</div></div>\n      <div class=\"tool-desc\">\n        <span class=\"label\">用途：</span>焊接导线、元器件<br>\n        <span class=\"label\">用法：</span>通电加热后，配合焊锡进行焊接，使用后注意及时清理焊头。\n      </div>\n    </div>\n    <!-- Tool 14 -->\n    <div class=\"tool-card\">\n      <div class=\"tool-card-header\">\n        <div class=\"tool-number\">14</div>\n        <div class=\"tool-name\">焊锡丝</div>\n      </div>\n      <div class=\"tool-image\"><div class=\"placeholder\">[焊锡丝]<