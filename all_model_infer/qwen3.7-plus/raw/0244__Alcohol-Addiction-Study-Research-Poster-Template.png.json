t-align: center;\n  }\n\n  .results-table th {\n    background: #bbb;\n    font-weight: bold;\n  }\n\n  .results-table td:first-child {\n    text-align: left;\n  }\n\n  .head-illustrations {\n    display: flex;\n    justify-content: center;\n    gap: 10px;\n    margin: 15px 0;\n  }\n\n  .head-placeholder {\n    width: 100px;\n    height: 120px;\n    border: 2px solid #333;\n    border-radius: 50% 50% 40% 40%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 0.7em;\n    text-align: center;\n    position: relative;\n    background: #fff;\n  }\n\n  .head-placeholder::before {\n    content: '';\n    position: absolute;\n    top: 15px;\n    left: 20px;\n    right: 20px;\n    height: 40px;\n    border: 2px solid #333;\n    border-radius: 50%;\n  }\n\n  .head-placeholder .brain-lines {\n    position: absolute;\n    top: 18px;\n    left: 25px;\n    right: 25px;\n    height: 35px;\n  }\n\n  .conclusion-text {\n    font-size: 0.85em;\n    line-height: 1.6;\n  }\n\n  .conclusion-text p {\n    margin-bottom: 12px;\n  }\n\n  .conclusion-text strong {\n    font-weight: bold;\n  }\n\n  .footer {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-end;\n    margin-top: 20px;\n    padding-top: 15px;\n  }\n\n  .footer-left {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n\n  .grad-cap {\n    font-size: 2.5em;\n  }\n\n  .footer-left .uni-name {\n    font-size: 1.1em;\n    font-weight: bold;\n    line-height: 1.3;\n  }\n\n  .footer-right {\n    text-align: right;\n    font-size: 0.7em;\n    line-height: 1.5;\n    max-width: 600px;\n  }\n\n  .footer-right .study-line {\n    font-weight: bold;\n    margin-bottom: 5px;\n  }\n\n  .footer-right .resources-line {\n    font-size: 0.9em;\n  }\n\n  .alcohol-food-section .section-body {\n    padding: 15px;\n  }\n\n  .alcohol-food-section .section-body ul {\n    font-size: 0.82em;\n  }\n\n  .svg-icon {\n    display: inline-block;\n  }\n\n  .gender-icon {\n    font-size: 1.8em;\n    display: inline-block;\n  }\n\n  .burger-icon {\n    font-size: 2em;\n  }\n\n  @media (max-width: 900px) {\n    .columns {\n      flex-direction: column;\n    }\n    .main-title {\n      font-size: 1.8em;\n    }\n  }\n</style>\n</head>\n<body>\n<div class=\"poster\">\n  <h1 class=\"main-title\">A Shared Propensity Towards Food &amp; Alcohol</h1>\n\n  <div class=\"columns\">\n    <!-- Column 1: Background + Alcohol is Like Food -->\n    <div class=\"col\">\n      <div>\n        <div class=\"section-header\">Background</div>\n        <div class=\"section-body\">\n          <p>Overeating and binge drinking are two of the most common health problems among college students:</p>\n\n          <div class=\"stat-row\">\n            <span class=\"stat-number\">48%</span>\n            <span class=\"stat-icon\"></span>\n            <span class=\"stat-label\">report binge<br>eating problems</span>\n          </div>\n\n          <div class=\"stat-row\">\n            <span class=\"stat-number\">63%</span>\n            <span class=\"stat-icon gender-icon\">♀</span>\n            <span class=\"stat-label\">of females report binge<br>drinking episodes</span>\n          </div>\n\n          <div class=\"stat-row\">\n            <span class=\"stat-number\">85%</span>\n            <span class=\"stat-icon gender-icon\">♂</span>\n            <span class=\"stat-label\">of males report binge<br>drinking episodes</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"alcohol-food-section\">\n        <div class=\"section-header\">Alcohol is Like Food</div>\n        <div class=\"section-body\">\n          <div class=\"icon-row\">\n            <div class=\"icon-circle\">\n              <svg width=\"30\" height=\"30\" viewBox=\"0 0 30 30\">\n                <path d=\"M10 5 L20 5 L18 15 L12 15 Z\" fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"/>\n                <line x1=\"15\" y1=\"15\" x2=\"15\" y2=\"25\" stroke=\"#333\" stroke-width=\"1.5\"/>\n                <line x1=\"10\" y1=\"25\" x2=\"20\" y2=\"25\" stroke=\"#333\" stroke-width=\"1.5\"/>\n              </svg>\n            </div>\n            <div class=\"icon-circle\">\n              <svg width=\"30\" height=\"30\" viewBox=\"0 0 30 30\">\n                <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"25\" stroke=\"#333\" stroke-width=\"1.5\"/>\n                <line x1=\"18\" y1=\"5\" x2=\"18\" y2=\"25\" stroke=\"#333\" stroke-width=\"1.5\"/>\n                <path d=\"M10 8 Q12 5 14 8\" fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"/>\n                <path d=\"M16 8 Q18 5 20 8\" fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"/>\n              </svg>\n            </div>\n            <div class=\"icon-rect\">\n              <svg width=\"25\" height=\"35\" viewBox=\"0 0 25 35\">\n                <rect x=\"5\" y=\"5\" width=\"15\" height=\"25\" rx=\"3\" fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"/>\n                <line x1=\"8\" y1=\"12\" x2=\"17\" y2=\"12\" stroke=\"#333\" stroke-width=\"1\"/>\n                <line x1=\"8\" y1=\"18\" x2=\"17\" y2=\"18\" stroke=\"#333\" stroke-width=\"1\"/>\n              </svg>\n            </div>\n          </div>\n          <ul>\n            <li>Alcohol is derived from sugar - similar chemical bases as food.</li>\n            <li>Both eating and drinking alcohol activate dopaminergic pathways in the human brain.</li>\n            <li>Addiction models have been applied to both food and alcohol use, as well as correlations between food and alcohol intake conducted in animal studies.</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n\n    <!-- Column 2: Method & Measures -->\n    <div class=\"col\">\n      <div>\n        <div class=\"section-header\">Method &amp; Measures</div>\n        <div class=\"section-body\">\n          <p>200 UCLA Undergraduates (76% females, Mean Age - 22.1) filled out an online survey in one-sitting as part of a longer experimental study with the following exclusionary criteria:</p>\n          <ul>\n            <li>Less than 21 years old</li>\n            <li>Self-reported history of eating disorders or substance abuse</li>\n            <li>Abstinence from drinking beer</li>\n            <li>A strict diet and food allergies to experimental stimuli</li>\n          </ul>\n\n          <div class=\"bar-chart\">\n            <div class=\"bar-chart-title\"># of times alcohol was consumed with a meal / month:</div>\n\n            <div class=\"bar-row\">\n              <span class=\"bar-label\">Under 5</span>\n              <div class=\"bar-track\">\n                <div class=\"bar-fill light\" style=\"width: 13%;\"></div>\n              </div>\n              <span class=\"bar-value\">13%</span>\n            </div>\n\n            <div class=\"bar-row\">\n              <span class=\"bar-label\">5-10</span>\n              <div class=\"bar-track\">\n                <div class=\"bar-fill medium\" style=\"width: 25%;\"></div>\n              </div>\n              <span class=\"bar-value\">25%</span>\n            </div>\n\n            <div class=\"bar-row\">\n              <span class=\"bar-label\">11-20</span>\n              <div class=\"bar-track\">\n                <div class=\"bar-fill dark\" style=\"width: 42%;\"></div>\n              </div>\n              <span class=\"bar-value\">42%</span>\n            </div>\n\n            <div class=\"bar-row\">\n              <span class=\"bar-label\">Over 20</span>\n              <div class=\"bar-track\">\n                <div class=\"bar-fill black\" style=\"width: 20%;\"></div>\n              </div>\n              <span class=\"bar-value\">20%</span>\n            </div>\n          </div>\n\n          <div class=\"questionnaire-section\">\n            <h4>Alcohol Expectancy Questionnaire (AEQ)</h4>\n            <p>A questionnaire measuring one's anticipatory effects of drinking and consuming alcohol.</p>\n          </div>\n\n          <div class=\"questionnaire-section\">\n            <h4>Dutch Eating Behavior Questionnaire (DEBQ)</h4>\n            <p>A questionnaire assessing one's eating behaviors (since expectancies predict consumption, food expectancies are implicitly implied).</p>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Column 3: Results + Conclusion -->\n    <div class=\"col\">\n      <div>\n        <div class=\"section-header\">Results</div>\n        <div class=\"section-body\">\n          <table class=\"results-table\">\n            <thead>\n              <tr>\n                <th>AEQ / DEBQ</th>\n                <th>External</th>\n                <th>Emotional</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr>\n                <td>Relaxation &amp; Tension Reduction</td>\n                <td>320</td>\n                <td>240</td>\n              </tr>\n              <tr>\n                <td>Arousal &amp; Aggression</td>\n                <td>240</td>\n                <td>220</td>\n              </tr>\n              <tr>\n                <td>Increased Social Assertiveness</td>\n                <td>250</td>\n                <td>169</td>\n              </tr>\n              <tr>\n                <td>Physical &amp; Social Pleasure</td>\n                <td>210</td>\n                <td>114</td>\n              </tr>\n            </tbody>\n          </table>\n\n          <div class=\"head-illustrations\">\n            <div class=\"head-placeholder\">\n              <svg width=\"80\" height=\"100\" viewBox=\"0 0 80 100\">\n                <!-- Head outline -->\n                <path d=\"M25 90 Q25 50 40 30 Q55 10 60 30 Q70 50 65 90\" fill=\"none\" stroke=\"#333\" stroke-width=\"2\"/>\n                <!-- Brain squiggles -->\n                <path d=\"M30 35 Q35 25 40 30 Q45 20 50 28 Q55 22 58 32\" fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"/>\n                <path d=\"M32 42 Q38 35 43 40 Q48 33 53 38 Q57 34 60 40\" fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"/>\n                <path d=\"M33 48 Q37 43 42 47 Q47 41 52 45 Q56 42 59 47\" fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"/>\n                <!-- Face features -->\n                <circle cx=\"38\" cy=\"55\" r=\"2\" fill=\"#333\"/>\n                <path d=\"M35 65 Q40 68 45 65\" fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"/>\n                <!-- Nose -->\n                <path d=\"M42 58 L45 62 L42 63\" fill=\"none\" stroke=\"#333\" stroke-width=\"1\"/>\n              </svg>\n            </div>\n            <div class=\"head-placeholder\">\n              <svg width=\"80\" height=\"100\" viewBox=\"0 0 80 100\">\n                <!-- Head outline -->\n                <path d=\"M55 90 Q55 50 40 30 Q25 10 20 30 Q10 50 15 90\" fill=\"none\" stroke=\"#333\" stroke-width=\"2\"/>\n                <!-- Storm cloud in brain -->\n                <path d=\"M28 30 Q30 22 36 24 Q38 18 44 20 Q48 16 52 22 Q56 20 56 28 Q58 32 54 34 L30 34 Q26 32 28 30Z\" fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"/>\n                <!-- Rain drops -->\n                <line x1=\"35\" y1=\"36\" x2=\"33\" y2=\"42\" stroke=\"#333\" stroke-width=\"1\"/>\n                <line x1=\"42\" y1=\"36\" x2=\"40\" y2=\"43\" stroke=\"#333\" stroke-width=\"1\"/>\n                <line x1=\"49\" y1=\"36\" x2=\"47\" y2=\"41\" stroke=\"#333\" stroke-width=\"1\"/>\n                <!-- Face features -->\n                <circle cx=\"42\" cy=\"55\" r=\"2\" fill=\"#333\"/>\n                <path d=\"M35 65 Q40 62 45 65\" fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"/>\n                <!-- Nose -->\n                <path d=\"M38 58 L35 62 L38 63\" fill=\"none\" stroke=\"#333\" stroke-width=\"1\"/>\n              </svg>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div>\n        <div class=\"section-header\">Conclusion</div>\n        <div class=\"section-body\">\n          <div class=\"conclusion-text\">\n            <p>The results support our hypothesis that: Food expectancy is positively correlated to alcohol expectancy.</p>\n            <p>DEBQ External eating scale correlated to all AEQ scales, while DEBQ Emotional Eating scale only correlated to some AEQ scales.</p>\n            <p><strong>External eating</strong> had a more consistent relationship with alcohol expectancies, where <strong>Emotional eating</strong> had a less consistent relationship.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"footer\">\n    <div class=\"footer-left\">\n      <span class=\"grad-cap\">🎓</span>\n      <div class=\"uni-name\">University of New York,<br>New York</div>\n    </div>\n    <div class=\"footer-right\">\n      <div class=\"study-line\">STUDY CONDUCTED BY: Carla Ramirez, Francis R. Griffon and Elena Takayama, UNIVERSITY OF NEW YORK</div>\n      <div class=\"resources-line\">RESOURCES: Walsh, Kathy. Chan, Anthony. \"The psychology of consumption and stress.\" The Pearson Journal, 2017. // Saluda, Mariana. Temitope, Janet. \"Neuroscience of addiction and pleasure.\" The Science Review, 2018. // Jurgen, Hans. Lee, Penelope. \"Consumption, Pleasure and Empowerment.\" The Arch Journal, 2020.</div>\n    </div>\n  </div>\n</div>\n</body>\n</html>",
