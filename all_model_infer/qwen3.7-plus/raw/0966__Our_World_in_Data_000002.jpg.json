ewsletter-col { background: #e8f0fe; padding: 20px; }\n  .newsletter-header { display: flex; align-items: center; gap: 12px; margin-bottom: 15px; }\n  .newsletter-icon { width: 45px; height: 45px; background: #d0dce8; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; }\n  .newsletter-header h3 { font-size: 18px; color: #1a1a2e; }\n  .newsletter-col > p { font-size: 14px; font-family: Arial, sans-serif; margin-bottom: 15px; }\n  .newsletter-option { display: flex; gap: 10px; margin-bottom: 15px; align-items: flex-start; }\n  .newsletter-option input[type=\"checkbox\"] { margin-top: 3px; }\n  .newsletter-option .opt-title { font-size: 14px; font-weight: bold; font-family: Arial, sans-serif; }\n  .newsletter-option .opt-desc { font-size: 13px; color: #555; font-family: Arial, sans-serif; line-height: 1.4; }\n  .email-input { width: 100%; padding: 10px 14px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px; font-family: Arial, sans-serif; margin-bottom: 10px; }\n  .subscribe-btn { width: 100%; background: #c0392b; color: #fff; border: none; padding: 12px; font-size: 15px; font-family: Arial, sans-serif; cursor: pointer; margin-bottom: 15px; }\n  .subscribe-btn:hover { background: #a93226; }\n  .privacy-text { font-size: 12px; color: #555; font-family: Arial, sans-serif; line-height: 1.4; margin-bottom: 20px; }\n  .privacy-text a { color: #2980b9; }\n  .follow-us h4 { font-size: 16px; margin-bottom: 10px; }\n  .social-icons { display: flex; gap: 12px; margin-bottom: 20px; }\n  .social-icons a { font-size: 18px; color: #555; text-decoration: none; }\n  .donate-box { background: #fff; padding: 15px; border-radius: 4px; display: flex; align-items: center; gap: 12px; }\n  .donate-heart { width: 40px; height: 40px; background: #f0e0e0; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; }\n  .donate-box p { font-size: 13px; font-family: Arial, sans-serif; line-height: 1.4; }\n  .donate-box a { color: #c0392b; font-weight: bold; font-size: 13px; font-family: Arial, sans-serif; }\n\n  /* Data Insights Section */\n  .data-insights { background: #eef2f7; padding: 40px; }\n  .data-insights-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 25px; max-width: 1400px; margin-left: auto; margin-right: auto; }\n  .data-insights-header h2 { font-size: 28px; color: #1a1a2e; margin-bottom: 5px; }\n  .data-insights-header p { font-size: 14px; color: #555; font-family: Arial, sans-serif; }\n  .see-all-insights { border: 1px solid #c0392b; color: #c0392b; padding: 10px 20px; font-size: 14px; font-family: Arial, sans-serif; text-decoration: none; white-space: nowrap; }\n  .see-all-insights:hover { background: #c0392b; color: #fff; }\n\n  .insights-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; max-width: 1400px; margin: 0 auto; }\n  .insight-card { background: #fff; padding: 20px; border: 1px solid #e0e0e0; }\n  .insight-card.featured { grid-column: 1 / 3; display: grid; grid-template-columns: 1fr 1.5fr; gap: 20px; }\n  .insight-chart { width: 100%; height: 200px; background: #f8f8f8; position: relative; }\n  .insight-chart svg { width: 100%; height: 100%; }\n  .insight-date { font-size: 11px; font-weight: bold; font-family: Arial, sans-serif; text-transform: uppercase; letter-spacing: 1px; color: #888; margin-bottom: 8px; }\n  .insight-card h3 { font-size: 20px; line-height: 1.3; margin-bottom: 12px; color: #1a1a2e; }\n  .insight-card p { font-size: 14px; line-height: 1.6; color: #444; font-family: Arial, sans-serif; margin-bottom: 10px; }\n\n  /* Floating buttons */\n  .floating-btns { position: fixed; bottom: 20px; right: 20px; display: flex; gap: 10px; z-index: 100; }\n  .float-btn { background: #1a1a2e; color: #fff; border: none; padding: 10px 18px; font-size: 13px; font-family: Arial, sans-serif; cursor: pointer; display: flex; align-items: center; gap: 6px; border-radius: 4px; }\n  .float-btn:hover { background: #2c3e50; }\n\n  /* Chart placeholders */\n  .chart-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #aaa; font-size: 12px; font-family: Arial, sans-serif; }\n</style>\n</head>\n<body>\n\n<!-- Header -->\n<header class=\"header\">\n  <div class=\"header-left\">\n    <div class=\"logo\">Our World<br><span>in Data</span></div>\n    <nav class=\"nav-links\">\n      <a href=\"#\">☰ Browse by topic</a>\n      <a href=\"#\">Data</a>\n      <a href=\"#\">Insights</a>\n      <a href=\"#\">Resources ▾</a>\n      <a href=\"#\">About ▾</a>\n    </nav>\n  </div>\n  <div class=\"header-right\">\n    <button class=\"btn-subscribe\">Subscribe</button>\n    <button class=\"btn-donate\">Donate</button>\n  </div>\n</header>\n\n<!-- Popular Pages -->\n<div class=\"popular-bar\">\n  <span class=\"popular-label\">Popular Pages</span>\n  <span class=\"popular-tag\">Poverty</span>\n  <span class=\"popular-tag\">Child Mortality</span>\n  <span class=\"popular-tag\">Global Education</span>\n  <span class=\"popular-tag\">CO₂ Emissions</span>\n  <span class=\"popular-tag\">Migration</span>\n  <span class=\"popular-tag\">War &amp; Peace</span>\n  <span class=\"popular-tag\">Life Expectancy</span>\n  <span class=\"popular-tag\">Population Growth</span>\n  <span class=\"popular-tag\">Artificial Intelligence</span>\n</div>\n\n<!-- Hero -->\n<section class=\"hero\">\n  <h1>Research and data to make progress against the world's largest problems.</h1>\n  <p class=\"hero-mission\"><a href=\"#\">Read about our mission →</a></p>\n  <div class=\"search-bar\">\n    <input type=\"text\" placeholder='Try \"Life expectancy\", \"Poverty Nigeria Vietnam\", \"CO2 France\"...'>\n    <span class=\"search-icon\">🔍</span>\n  </div>\n  <div class=\"hero-stats\">\n    <span class=\"stat-badge\">📈 13,989 charts</span>\n    <span class=\"stat-badge\">📋 126 topic pages</span>\n    <span class=\"stat-badge\">🔍 32 data explorers</span>\n  </div>\n  <p class=\"hero-license\">All free: open access and openly licensed</p>\n</section>\n\n<!-- Main Grid -->\n<div class=\"main-grid\">\n  <!-- Column 1 -->\n  <div>\n    <div class=\"card\">\n      <div class=\"card-chart\">\n        <svg viewBox=\"0 0 300 160\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path d=\"M20,130 Q60,120 100,80 Q140,40 180,30 Q220,25 260,50 Q280,60 290,70\" fill=\"none\" stroke=\"#c0392b\" stroke-width=\"2\"/>\n          <path d=\"M20,130 Q60,120 100,80 Q140,40 180,30 Q220,25 260,50 Q280,60 290,70 L290,160 L20,160 Z\" fill=\"rgba(192,57,43,0.08)\"/>\n        </svg>\n      </div>\n      <div style=\"display:flex;gap:8px;align-items:center;margin-bottom:5px;\">\n        <span class=\"card-label new\" style=\"background:#c0392b;color:#fff;padding:2px 8px;border-radius:3px;font-size:10px;\">NEW</span>\n        <span class=\"card-meta\">ARTICLE · 11 MIN READ</span>\n      </div>\n      <h2>South Korea's population is set to shrink: what would it take to stop the decline?</h2>\n      <p>How much would fertility rates, life expectancy, or migration rates need to change to stop the population from shrinking?</p>\n      <p class=\"authors\">Hannah Ritchie, Sophia Mersmann, and Daniel Bachler</p>\n    </div>\n\n    <div class=\"card\" style=\"margin-top:20px;\">\n      <div class=\"card-chart\">\n        <svg viewBox=\"0 0 300 160\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path d=\"M20,100 Q40,90 60,95 Q80,100 100,85 Q120,70 140,80 Q160,90 180,75 Q200,60 220,70 Q240,80 260,50 Q270,40 280,30\" fill=\"none\" stroke=\"#2c3e50\" stroke-width=\"1.5\"/>\n          <path d=\"M20,110 Q50,105 80,115 Q110,125 140,120 Q170,115 200,130 Q230,145 260,140 Q275,138 285,135\" fill=\"none\" stroke=\"#c0392b\" stroke-width=\"1.5\"/>\n          <path d=\"M200,30 Q220,25 240,20 Q260,15 275,10 Q285,8 290,5\" fill=\"none\" stroke=\"#27ae60\" stroke-width=\"1.5\"/>\n        </svg>\n      </div>\n      <div class=\"card-label classics\">FROM OUR CLASSICS</div>\n      <h2>Breaking out of the Malthusian trap: How pandemics allow us to understand why our ancestors were stuck in poverty</h2>\n      <p class=\"authors\">Max Roser</p>\n    </div>\n  </div>\n\n  <!-- Column 2 -->\n  <div>\n    <div class=\"card\">\n      <div class=\"card-chart\" style=\"background:#dce6f0;\">\n        <svg viewBox=\"0 0 300 160\" xmlns=\"http://www.w3.org/2000/svg\">\n          <rect x=\"10\" y=\"10\" width=\"80\" height=\"60\" rx=\"3\" fill=\"#b0c4de\" stroke=\"#8fa8c8\" stroke-width=\"1\"/>\n          <rect x=\"15\" y=\"15\" width=\"70\" height=\"10\" rx=\"2\" fill=\"#8fa8c8\"/>\n          <rect x=\"15\" y=\"30\" width=\"50\" height=\"8\" rx=\"2\" fill=\"#c8d8e8\"/>\n          <rect x=\"15\" y=\"42\" width=\"60\" height=\"8\" rx=\"2\" fill=\"#c8d8e8\"/>\n          <rect x=\"15\" y=\"54\" width=\"40\" height=\"8\" rx=\"2\" fill=\"#c8d8e8\"/>\n          <rect x=\"100\" y=\"10\" width=\"90\" height=\"100\" rx=\"3\" fill=\"#b0c4de\" stroke=\"#8fa8c8\" stroke-width=\"1\"/>\n          <path d=\"M110,80 Q130,70 150,60 Q170,50 180,55\" fill=\"none\" stroke=\"#5a7a9a\" stroke-width=\"1.5\"/>\n          <circle cx=\"150\" cy=\"60\" r=\"3\" fill=\"#5a7a9a\"/>\n          <rect x=\"200\" y=\"10\" width=\"90\" height=\"100\" rx=\"3\" fill=\"#b0c4de\" stroke=\"#8fa8c8\" stroke-width=\"1\"/>\n          <rect x=\"210\" y=\"20\" width=\"15\" height=\"80\" rx=\"2\" fill=\"#8fa8c8\"/>\n          <rect x=\"230\" y=\"30\" width=\"15\" height=\"70\" rx=\"2\" fill=\"#8fa8c8\"/>\n          <rect x=\"250\" y=\"40\" width=\"15\" height=\"60\" rx=\"2\" fill=\"#8fa8c8\"/>\n          <rect x=\"270\" y=\"50\" width=\"15\" height=\"50\" rx=\"2\" fill=\"#8fa8c8\"/>\n        </svg>\n      </div>\n      <div style=\"display:flex;gap:8px;align-items:center;margin-bottom:5px;\">\n        <span class=\"card-label new\" style=\"background:#c0392b;color:#fff;padding:2px 8px;border-radius:3px;font-size:10px;\">NEW</span>\n        <span class=\"card-label interactive\">INTERACTIVE TOOL</span>\n      </div>\n      <h2>Population tool: how will populations across the world change in the 21st century?</h2>\n      <p>We created an interactive tool that lets you test how changes in fertility rates, life expectancy, and migration rates will change future populations.</p>\n      <p class=\"authors\">Sophia Mersmann, Daniel Bachler, and Hannah Ritchie</p>\n    </div>\n\n    <div class=\"card\" style=\"margin-top:20px;\">\n      <div class=\"card-chart\" style=\"background:#1a2a4a; display:flex; align-items:center; justify-content:center; position:relative;\">\n        <div style=\"position:absolute;left:15px;top:15px;color:#fff;font-size:14px;font-family:Arial,sans-serif;line-height:1.4;\">We're hiring a Writer<br>to join our team</div>\n        <div style=\"position:absolute;right:10px;top:10px;bottom:10px;width:120px;background:#2a3a5a;border-radius:4px;overflow:hidden;\">\n          <div style=\"display:flex;flex-wrap:wrap;padding:5px;gap:3px;\">\n            <div style=\"width:25px;height:30px;background:#3a4a6a;border-radius:2px;\"></div>\n            <div style=\"width:25px;height:30px;background:#4a5a7a;border-radius:2px;\"></div>\n            <div style=\"width:25px;height:30px;background:#3a4a6a;border-radius:2px;\"></div>\n            <div style=\"width:25px;height:30px;background:#4a5a7a;border-radius:2px;\"></div>\n            <div style=\"width:25px;height:30px;background:#3a4a6a;border-radius:2px;\"></div>\n            <div style=\"width:25px;height:30px;background:#4a5a7a;border-radius:2px;\"></div>\n          </div>\n        </div>\n        <div style=\"position:absolute;bottom:10px;left:15px;color:#fff;font-size:10px;font-family:Arial,sans-serif;\">Our World<br>in Data</div>\n      </div>\n      <div class=\"card-label announcement\">ANNOUNCEMENT</div>\n      <h2>We're looking for a writer</h2>\n      <p class=\"authors\">Hannah Ritchie</p>\n    </div>\n  </div>\n\n  <!-- Column 3: Updates -->\n  <div class=\"update