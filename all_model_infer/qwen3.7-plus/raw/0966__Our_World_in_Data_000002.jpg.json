        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Our World in Data</title>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  body { font-family: 'Georgia', 'Times New Roman', serif; color: #1a1a2e; background: #fff; }\n  \n  /* Header */\n  .header { background: #0d1b3e; color: #fff; padding: 12px 40px; display: flex; align-items: center; justify-content: space-between; }\n  .header-left { display: flex; align-items: center; gap: 30px; }\n  .logo { font-size: 20px; font-weight: bold; line-height: 1.2; }\n  .logo span { display: block; font-size: 14px; font-weight: normal; }\n  .nav-links { display: flex; gap: 20px; font-size: 14px; font-family: Arial, sans-serif; }\n  .nav-links a { color: #fff; text-decoration: none; }\n  .nav-links a:hover { text-decoration: underline; }\n  .header-right { display: flex; gap: 10px; }\n  .btn-subscribe { background: transparent; border: 1px solid #fff; color: #fff; padding: 8px 20px; font-size: 14px; cursor: pointer; font-family: Arial, sans-serif; }\n  .btn-donate { background: #c0392b; border: none; color: #fff; padding: 8px 20px; font-size: 14px; cursor: pointer; font-family: Arial, sans-serif; }\n\n  /* Popular Pages */\n  .popular-bar { background: #e8edf3; padding: 10px 40px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; border-bottom: 1px solid #ccc; }\n  .popular-label { font-size: 11px; font-weight: bold; color: #555; font-family: Arial, sans-serif; text-transform: uppercase; letter-spacing: 1px; }\n  .popular-tag { background: #fff; border: 1px solid #ccc; padding: 5px 14px; border-radius: 20px; font-size: 13px; font-family: Arial, sans-serif; cursor: pointer; }\n  .popular-tag:hover { background: #f0f0f0; }\n\n  /* Hero */\n  .hero { background: #0d1b3e; color: #fff; text-align: center; padding: 50px 40px 40px; position: relative; overflow: hidden; }\n  .hero::be