t-size: 16px;\n    flex-shrink: 0;\n  }\n\n  .section-header .icon-right {\n    margin-left: auto;\n  }\n\n  .section p {\n    font-size: 14px;\n    line-height: 1.8;\n    color: #444;\n  }\n\n  .from-crowd-icon {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n  }\n\n  .from-crowd-box {\n    background-color: #c8c4be;\n    width: 80px;\n    height: 80px;\n    border-radius: 8px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 28px;\n    font-weight: bold;\n    color: #555;\n    flex-shrink: 0;\n    position: relative;\n  }\n\n  .from-crowd-box::before {\n    content: '';\n    position: absolute;\n    top: -8px;\n    left: 10px;\n    width: 30px;\n    height: 12px;\n    background-color: #b0aca6;\n    border-radius: 3px;\n    transform: rotate(-15deg);\n  }\n\n  .from-crowd-text {\n    flex: 1;\n  }\n\n  .from-crowd-text h3 {\n    font-size: 18px;\n    font-weight: bold;\n    margin-bottom: 8px;\n    color: #222;\n  }\n\n  .from-crowd-text p {\n    font-size: 14px;\n    line-height: 1.8;\n    color: #444;\n  }\n\n  .two-columns {\n    display: flex;\n    gap: 0;\n  }\n\n  .two-columns .col {\n    flex: 1;\n    padding: 16px 20px;\n  }\n\n  .two-columns .col:first-child {\n    border-right: 2px solid #555;\n  }\n\n  .col-header {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    margin-bottom: 10px;\n  }\n\n  .col-header h4 {\n    font-size: 17px;\n    font-weight: bold;\n    color: #222;\n  }\n\n  .col-header .emoji {\n    font-size: 22px;\n  }\n\n  .col p {\n    font-size: 14px;\n    line-height: 1.8;\n    color: #444;\n  }\n\n  .highlight-bar {\n    background-color: #3a3a3a;\n    color: #fff;\n    padding: 10px 20px;\n    border-radius: 20px;\n    display: inline-block;\n    font-size: 17px;\n    font-weight: bold;\n    margin-bottom: 12px;\n  }\n\n  .highlight-section {\n    padding: 16px 20px;\n  }\n\n  .highlight-section p {\n    font-size: 14px;\n    line-height: 1.8;\n    color: #444;\n  }\n\n  .factors-section {\n    padding: 16px 20px;\n  }\n\n  .factors-section h3 {\n    font-size: 18px;\n    font-weight: bold;\n    margin-bottom: 12px;\n    color: #222;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n\n  .factors-section h3 .icon-target {\n    width: 32px;\n    height: 32px;\n    border-radius: 50%;\n    border: 2px solid #555;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 16px;\n    margin-left: auto;\n  }\n\n  .factors-section ol {\n    padding-left: 20px;\n  }\n\n  .factors-section ol li {\n    font-size: 14px;\n    line-height: 1.8;\n    color: #444;\n    margin-bottom: 10px;\n  }\n\n  .factors-section ol li strong {\n    color: #222;\n  }\n\n  .section-divider {\n    border-bottom: 2px solid #555;\n  }\n</style>\n</head>\n<body>\n<div class=\"card\">\n  <div class=\"header\">\n    <span class=\"header-text\">Knowledge Cards</span>\n    <span class=\"header-badge\">TONG 知识分享</span>\n  </div>\n\n  <h1 class=\"main-title\">人间清醒从懂人性开始</h1>\n\n  <div class=\"subtitle-bar\">每天一遍停止内耗，停止emo</div>\n\n  <div class=\"content-box\">\n    <!-- Section 1: 随大溜会让人变得平庸吗 -->\n    <div class=\"section\">\n      <div class=\"from-crowd-icon\">\n        <div class=\"from-crowd-box\">从众</div>\n        <div class=\"from-crowd-text\">\n          <h3>随大溜会让人变得平庸吗 <span style=\"float:right; font-size:22px;\">💡</span></h3>\n          <p>社会心理学关于从众的定义是，由于群体的压力而改变个体自己的行为或信念。正向，在安静的地方，会不自觉压低讲话的声音；相反，新店开业请一些托儿来排队，制造门庭若市的假象，产生好奇跟着去抢。</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Section 2: Two columns -->\n    <div class=\"two-columns\">\n      <div class=\"col\">\n        <div class=\"col-header\">\n          <h4>积极的从众心态</h4>\n          <span class=\"emoji\">😊</span>\n        </div>\n        <p>有助于学习他人的智慧和经验，修正自己盲目自信的缺点，完善思考方式，扩大视野。</p>\n      </div>\n      <div class=\"col\">\n        <div class=\"col-header\">\n          <h4>消极的从众心态</h4>\n          <span class=\"emoji\">😐</span>\n        </div>\n        <p>会扼杀个人的独立意识和判断力，束缚思想，使人墨守成规，没有主键，甚至陷入骗局。</p>\n      </div>\n    </div>\n\n    <!-- Section 3: 从众≠丧失独立思考能力 -->\n    <div class=\"section-divider\"></div>\n    <div class=\"highlight-section\">\n      <div class=\"highlight-bar\">从众≠丧失独立思考能力 <span style=\"float:right; font-size:20px;\">📋</span></div>\n      <p>人被外界的信息影响几乎是件不可避免的事情，对多数人来说，从众是一种自我保护和低成本、高效率的决策方式。问题不在于从众，而在于看清自己的真实需求。</p>\n    </div>\n\n    <!-- Section 4: 影响个体从众的因素 -->\n    <div class=\"section-divider\"></div>\n    <div class=\"factors-section\">\n      <h3>影响个体从众的因素 <span class=\"icon-target\">🎯</span></h3>\n      <ol>\n        <li><strong>规范影响</strong>来自人们希望获得别人的接纳；我们希望得到别人的喜欢。公开反应的人从众度较高，这反映了规范影响的力量。其实不光是人类，动物界，甚至整个生物界也有明显的从众特质。和大多数一样更安全，这几乎成为刻在基因里的认知。</li>\n        <li><strong>信息影响</strong>来自他人提供的事实证据。遇到困难的决策任务的从众度也较高，这反映了信息影响的力量，我们希望能正确行事。</li>\n      </ol>\n    </div>\n  </div>\n</div>\n</body>\n</html>",
