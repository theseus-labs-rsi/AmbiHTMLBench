iv>\n        <div class=\"ein-cell\"></div>\n        <div class=\"ein-cell\"></div>\n        <div class=\"ein-cell\"></div>\n        <div class=\"ein-cell\"></div>\n      </div>\n    </div>\n    <div class=\"name-row\">\n      <span class=\"name-label\">Name <span class=\"italic\">(not your trade name)</span></span>\n      <div class=\"name-input\"></div>\n    </div>\n    <div class=\"trade-row\">\n      <span class=\"trade-label\">Trade name <span class=\"italic\">(if any)</span></span>\n      <div class=\"trade-input\"></div>\n    </div>\n    <div class=\"address-block\">\n      <div class=\"field-row\" style=\"align-items: center;\">\n        <span class=\"addr-main-label\">Address</span>\n        <div class=\"addr-main-input\"></div>\n      </div>\n      <div class=\"address-sub-row\">\n        <div style=\"flex:1;\">\n          <div class=\"sub-label\">Number</div>\n          <div class=\"input-box\" style=\"width:100%;\"></div>\n        </div>\n        <div style=\"flex:2;\">\n          <div class=\"sub-label\">Street</div>\n          <div class=\"input-box\" style=\"width:100%;\"></div>\n        </div>\n        <div style=\"flex:1;\">\n          <div class=\"sub-label\">Suite or room number</div>\n          <div class=\"input-box\" style=\"width:100%;\"></div>\n        </div>\n      </div>\n      <div class=\"address-sub-row\">\n        <div style=\"flex:2;\">\n          <div class=\"sub-label\">City</div>\n          <div class=\"input-box\" style=\"width:100%;\"></div>\n        </div>\n        <div style=\"flex:0.6;\">\n          <div class=\"sub-label\">State</div>\n          <div class=\"input-box\" style=\"width:100%;\"></div>\n        </div>\n        <div style=\"flex:0.8;\">\n          <div class=\"sub-label\">ZIP code</div>\n          <div class=\"input-box\" style=\"width:100%;\"></div>\n        </div>\n      </div>\n      <div class=\"foreign-sub-row\">\n        <div style=\"flex:2;\">\n          <div class=\"sub-label\">Foreign country name</div>\n 