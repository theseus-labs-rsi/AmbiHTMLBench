r;\n  }\n\n  .top-left {\n    grid-column: 1;\n    grid-row: 1;\n  }\n\n  .top-right {\n    grid-column: 3;\n    grid-row: 1;\n  }\n\n  .bottom-left {\n    grid-column: 1;\n    grid-row: 2;\n  }\n\n  .bottom-right {\n    grid-column: 3;\n    grid-row: 2;\n  }\n\n  .url-section {\n    grid-column: 1 / 4;\n    grid-row: 3;\n    text-align: center;\n    padding: 20px 0;\n  }\n\n  .url-section a {\n    color: #4ecdc4;\n    font-size: 28px;\n    text-decoration: none;\n    font-style: italic;\n  }\n\n  .url-section a:hover {\n    text-decoration: underline;\n  }\n\n  .top-left .instrument-image,\n  .bottom-left .instrument-image {\n    float: right;\n    margin-left: 10px;\n  }\n\n  .top-right .instrument-image,\n  .bottom-right .instrument-image {\n    float: left;\n    margin-right: 10px;\n  }\n\n  .top-left .content-wrap,\n  .bottom-left .content-wrap {\n    display: flex;\n    flex-direction: row;\n    align-items: flex-start;\n  }\n\n  .top-right .content-wrap,\n  .bottom-right .content-wrap {\n    display: flex;\n    flex-direction: row-reverse;\n    align-items: flex-start;\n  }\n\n  .content-text {\n    flex: 1;\n  }\n\n  .content-image {\n    flex-shrink: 0;\n  }\n\n  .content-image img,\n  .content-image .placeholder {\n    width: 200px;\n    height: 220px;\n    background-color: #1a1a1a;\n    border-radius: 5px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .content-image .placeholder {\n    color: #555;\n    font-size: 11px;\n    text-align: center;\n    padding: 10px;\n  }\n\n  .person-block {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    margin-top: 10px;\n  }\n\n  .person-block .person-photo {\n    width: 90px;\n    height: 90px;\n  }\n\n  .bottom-right .content-wrap {\n    flex-direction: row-reverse;\n  }\n\n  .bottom-right .content-text {\n    text-align: right;\n  }\n\n  .top-right .content-text {\n    text-align: left;\n  }\n\n  .top-left .content-text {\n    text-align: left;\n