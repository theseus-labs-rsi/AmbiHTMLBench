color: #555;\n    font-style: italic;\n    writing-mode: vertical-rl;\n    text-orientation: mixed;\n  }\n\n  .fusion-arrow {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 16px;\n    color: #666;\n  }\n\n  .output-label {\n    font-size: 9px;\n    color: #555;\n    text-align: center;\n  }\n\n  .diagram-row {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n  }\n\n  .small-block {\n    width: 12px;\n    height: 30px;\n    background: #4a90d9;\n    border-radius: 2px;\n    display: inline-block;\n  }\n\n  .small-block-tall {\n    width: 10px;\n    height: 50px;\n    background: #4a90d9;\n    border-radius: 2px;\n    display: inline-block;\n  }\n\n  .feature-vector {\n    width: 8px;\n    height: 20px;\n    background: #e8a030;\n    border-radius: 2px;\n    display: inline-block;\n  }\n\n  .add-circle {\n    width: 18px;\n    height: 18px;\n    border: 2px solid #333;\n    border-radius: 50%;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 12px;\n    font-weight: bold;\n  }\n\n  .img-icon {\n    width: 30px;\n    height: 24px;\n    border: 1px solid #999;\n    border-radius: 3px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 16px;\n    background: #f5f5f5;\n  }\n\n  .event-icon {\n    width: 30px;\n    height: 30px;\n    border: 1px solid #999;\n    border-radius: 3px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 10px;\n    background: #f5f5f5;\n  }\n\n  .network-diagram {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n    flex-wrap: wrap;\n  }\n\n  .neural-net-icon {\n    width: 36px;\n    height: 36px;\n    border: 1px solid #999;\n    border-radius: 50%;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 8px;\n    background: #f0f0f0;\n  }\n\n  .pooling-label {\n    font-size: 9px;\n    color: #666;\n  }\n\n  .state-label {\n    font-size: 9px;\n    color: #555;\n    font-style: italic;\n  }\n\n  .f-label {\n    font-size: 10px;\n    font-weight: bold;\n  }\n\n  .axis-chart {\n    width: 80px;\n    height: 40px;\n    position: relative;\n    margin: 0 auto;\n  }\n\n  .axis-chart svg {\n    width: 100%;\n    height: 100%;\n  }\n\n  .bracket-label {\n    font-size: 9px;\n    color: #555;\n  }\n\n  .output-f {\n    font-size: 10px;\n    font-weight: bold;\n  }\n\n  .sub-label {\n    font-size: 8px;\n    color: #666;\n  }\n</style>\n</head>\n<body>\n\n<!-- Figure 2 -->\n<div class=\"figure-container\" style=\"border:none; background:transparent; padding:0;\">\n  <!-- Biological Inspiration (Left) -->\n  <div class=\"bio-section\">\n    <h4>Rapidly Adapting Receptors</h4>\n    <div class=\"receptor-box\">\n      <div class=\"placeholder-img\">\n        <svg width=\"120\" height=\"70\" viewBox=\"0 0 120 70\">\n          <rect x=\"0\" y=\"0\" width=\"60\" height=\"70\" fill=\"#f5e6d3\" stroke=\"#ccc\"/>\n          <rect x=\"60\" y=\"0\" width=\"60\" height=\"70\" fill=\"#f5e6d3\" stroke=\"#ccc\"/>\n          <text x=\"10\" y=\"10\" font-size=\"6\" fill=\"#888\">Meissner's corpuscle</text>\n          <text x=\"70\" y=\"10\" font-size=\"6\" fill=\"#888\">Pacinian corpuscle</text>\n          <path d=\"M30,20 Q30,40 20,55\" stroke=\"#c4956a\" fill=\"none\" stroke-width=\"2\"/>\n          <path d=\"M30,20 Q30,40 40,55\" stroke=\"#c4956a\" fill=\"none\" stroke-width=\"2\"/>\n          <path d=\"M90,20 Q90,35 85,50\" stroke=\"#c4956a\" fill=\"none\" stroke-width=\"2\"/>\n          <path d=\"M90,20 Q90,35 95,50\" stroke=\"#c4956a\" fill=\"none\" stroke-width=\"2\"/>\n          <rect x=\"0\" y=\"55\" width=\"120\" height=\"15\" fill=\"#d4b896\"/>\n          <path d=\"M25,58 L35,58\" stroke=\"#e8a030\" stroke-width=\"1.5\" marker-end=\"url(#arrow)\"/>\n          <path d=\"M85,58 L95,58\" stroke=\"#e8a030\" stroke-width=\"1.5\"/>\n          <defs><marker id=\"arrow\" viewBox=\"0 0 10 10\" refX=\"10\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#e8a030\"/></marker></defs>\n        </svg>\n      </div>\n    </div>\n    <h4>Slowly Adapting Receptors</h4>\n    <div class=\"receptor-box\">\n      <div class=\"placeholder-img\">\n        <svg width=\"120\" height=\"70\" viewBox=\"0 0 120 70\">\n          <rect x=\"0\" y=\"0\" width=\"60\" height=\"70\" fill=\"#f5e6d3\" stroke=\"#ccc\"/>\n          <rect x=\"60\" y=\"0\" width=\"60\" height=\"70\" fill=\"#f5e6d3\" stroke=\"#ccc\"/>\n          <text x=\"10\" y=\"10\" font-size=\"6\" fill=\"#888\">Merkel's disks</text>\n          <text x=\"70\" y=\"10\" font-size=\"6\" fill=\"#888\">Ruffini endings</text>\n          <circle cx=\"30\" cy=\"35\" r=\"8\" fill=\"#c4956a\" stroke=\"#a07040\"/>\n          <line x1=\"30\" y1=\"27\" x2=\"30\" y2=\"15\" stroke=\"#c4956a\" stroke-width=\"2\"/>\n          <circle cx=\"90\" cy=\"40\" rx=\"12\" ry=\"6\" fill=\"#e8a030\" stroke=\"#c4956a\"/>\n          <rect x=\"0\" y=\"55\" width=\"120\" height=\"15\" fill=\"#d4b896\"/>\n        </svg>\n      </div>\n    </div>\n  </div>\n\n  <!-- Common Perceptual Mechanism -->\n  <div class=\"perceptual-mechanism\">\n    <h4>Common perceptual mechanism</h4>\n    <div>Perceiving<br>dynamic<br>force</div>\n    <div>Perceiving<br>static<br>force</div>\n  </div>\n\n  <!-- Network Center -->\n  <div class=\"network-center\">\n    <!-- Event Stream Recurrent Network -->\n    <div class=\"event-stream-network\">\n      <h4>Event Stream Recurrent Network</h4>\n      <div class=\"network-diagram\" style=\"margin-bottom:6px;\">\n        <div class=\"event-icon\">⚡</div>\n        <span class=\"pipeline-arrow\">→</span>\n        <div class=\"small-block\"></div>\n        <span class=\"pipeline-arrow\">→</span>\n        <div class=\"neural-net-icon\"></div>\n        <span class=\"pipeline-arrow\">→</span>\n        <div class=\"small-block-tall\"></div>\n        <span class=\"pooling-label\">Pooling</span>\n        <span class=\"pipeline-arrow\">→</span>\n        <div class=\"small-block-tall\"></div>\n        <span class=\"pipeline-arrow\">→</span>\n        <div class=\"lstm-box\">LSTM</div>\n        <span class=\"pipeline-arrow\">→</span>\n        <div class=\"neural-net-icon\">⊛</div>\n        <span class=\"pipeline-arrow\">→</span>\n        <div class=\"feature-vector\"></div>\n        <span class=\"pipeline-arrow\">→</span>\n        <div class=\"add-circle\">+</div>\n        <span class=\"pipeline-arrow\">→</span>\n        <div class=\"small-block\"></div>\n      </div>\n      <div style=\"font-size:9px; color:#555; margin-top:2px;\">\n        <span class=\"state-label\">(h<sub>t-1</sub>, c<sub>t-1</sub>)</span> → \n        <span class=\"state-label\">(h<sub>t</sub>, c<sub>t</sub>)</span>\n        &nbsp;&nbsp;\n        <span class=\"mlp-box\" style=\"display:inline-block;\">MLP</span>\n        &nbsp;&nbsp;\n        <span class=\"sub-label\">Δf</span>\n      </div>\n      <div class=\"time-label\">At time step t+1</div>\n    </div>\n\n    <!-- Time Series Label -->\n    <div style=\"text-align:center; font-size:11px; font-style:italic; color:#555; transform:rotate(-15deg); margin: 4px 0;\">\n      Time Series\n    </div>\n\n    <!-- Frame-Guided Network -->\n    <div class=\"frame-guided-network\">\n      <h4>Frame-Guided Network</h4>\n      <div class=\"network-diagram\" style=\"margin-bottom:6px;\">\n        <div class=\"img-icon\">🖼</div>\n        <span class=\"pipeline-arrow\">→</span>\n        <div class=\"cnn-box\">CNN</div>\n        <span class=\"pipeline-arrow\">→</span>\n        <div class=\"small-block-tall\"></div>\n        <span class=\"pipeline-arrow\">→</span>\n        <div class=\"small-block-tall\" style=\"height:60px;\"></div>\n        <span class=\"pipeline-arrow\">→</span>\n        <div class=\"neural-net-icon\">⊛</div>\n        <span class=\"pipeline-arrow\">→</span>\n        <div class=\"feature-vector\"></div>\n        <span class=\"pipeline-arrow\">→</span>\n        <div class=\"add-circle\">+</div>\n      </div>\n      <div style=\"font-size:9px; color:#555; margin-top:2px;\">\n        <span class=\"mlp-box\" style=\"display:inline-block;\">MLP</span>\n        &nbsp;&nbsp;\n        <span class=\"sub-label\">Δf</span>\n      </div>\n      <div class=\"time-label\">At time step t+1</div>\n    </div>\n  </div>\n\n  <!-- Perceiving (Right) -->\n  <div class=\"perceiving-section\">\n    <h4>Perceiving</h4>\n    <div style=\"display:flex; align-items:center; gap:4px;\">\n      <div style=\"font-size:10px; writing-mode:vertical-rl; color:#555;\">F<sub>output</sub></div>\n      <div class=\"small-block\" style=\"height:20px;\"></div>\n    </div>\n    <div class=\"dynamic-box\">\n      <h5>Dynamic</h5>\n      <div class=\"f-label\">F</div>\n      <svg width=\"80\" height=\"40\" viewBox=\"0 0 80 40\">\n        <line x1=\"5\" y1=\"35\" x2=\"75\" y2=\"35\" stroke=\"#333\" stroke-width=\"1.5\" marker-end=\"url(#arr2)\"/>\n        <line x1=\"5\" y1=\"35\" x2=\"5\" y2=\"5\" stroke=\"#333\" stroke-width=\"1.5\" marker-end=\"url(#arr2)\"/>\n        <path d=\"M10,30 Q15,10 20,25 Q25,5 30,20 Q35,15 40,22 Q45,18 50,25 Q55,22 60,28 Q65,26 70,30\" stroke=\"#333\" fill=\"none\" stroke-width=\"1.5\"/>\n        <defs><marker id=\"arr2\" viewBox=\"0 0 10 10\" refX=\"10\" refY=\"5\" markerWidth=\"5\" markerHeight=\"5\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#333\"/></marker></defs>\n      </svg>\n    </div>\n    <div class=\"static-box\">\n      <h5>Static</h5>\n      <div class=\"f-label\">F</div>\n      <svg width=\"80\" height=\"40\" viewBox=\"0 0 80 40\">\n        <line x1=\"5\" y1=\"35\" x2=\"75\" y2=\"35\" stroke=\"#333\" stroke-width=\"1.5\" marker-end=\"url(#arr3)\"/>\n        <line x1=\"5\" y1=\"35\" x2=\"5\" y2=\"5\" stroke=\"#333\" stroke-width=\"1.5\" marker-end=\"url(#arr3)\"/>\n        <path d=\"M10,30 Q20,15 30,25 Q40,20 50,28 Q60,26 70,30\" stroke=\"#333\" fill=\"none\" stroke-width=\"1.5\"/>\n        <defs><marker id=\"arr3\" viewBox=\"0 0 10 10\" refX=\"10\" refY=\"5\" markerWidth=\"5\" markerHeight=\"5\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#333\"/></marker></defs>\n      </svg>\n    </div>\n  </div>\n</div>\n\n<!-- Figure Caption -->\n<div class=\"figure-caption\">\n  <strong>Fig. 2.</strong> The architecture of the proposed FGER-Net is presented, alongside its conceptual underpinnings. The left portion illustrates the biological inspiration for the network: the synergistic function of fast and slow adapting mechanoreceptors in perceiving dynamic and static forces, respectively. These biological principles are emulated by the FGER-Net. In the network itself (center), event streams and image frames are synergistically fused for robust force estimation. In this architecture, frames are used to periodically correct for drift during training and to continuously stabilize the high frequency force predictions derived from the event stream during inference. The resulting force estimation is thereby made accurate and robust against drift, successfully capturing both dynamic and static tactile information, mirroring the perceptual capabilities shown on the right side of the diagram.\n</div>\n\n<!-- Two Column Layout -->\n<div class=\"two-column\">\n  <!-- Left Text Column -->\n  <div class=\"text-column\">\n    <p>dual rate architecture mirrors biological perception: a high frequency recurrent pathway integrates transient force increments from the event stream, while a low frequency pathway extracts absolute spatial references from single image frames for periodic training corrections.</p>\n    <p>During inference, we maximize estimation stability via a continuous correction strategy. By persistently fusing the most recent frame feature with incoming events, this absolute spatial anchor effectively eliminates integration drift.</p>\n    <p>The architecture utilizes dual parallel pathways optimized for each modality's distinct characteristics. To circumvent the extreme sparsity typical of standard convolutions on event data, individual events are normalized and processed by a pointwise MLP, followed by max-pooling to generate an aggregated feature vector for each packet. Conversely, dense spatial information from image frames is extracted into a compact feature vector using a residual CNN backbone coupled with average pooling.</p>\n    <p><span class=\"italic\">a) Data Stream Segmentation:</span> The algorithm's processing cycle is driven by the arrival of new frames. A cycle is</p>\n  </div>\n\n  <!-- Right Algorithm Column -->\n  <div class=\"algorithm-box\">\n    <h3>Algorithm 1 FGER-Net</h3>\n    <div class=\"input-line\"><strong>Input:</strong> $I_{\\text{guide}}$, $\\{P_m\\}_{m=1}^{M}$, $f_{\\text{prev\\_cycle}}$, $(h_{\\text{prev\\_cycle}}, C_{\\text{prev\\_cycle}})$</div>\n    <div class=\"output-line\"><strong>Output:</strong> $\\hat{f}_{\\text{final}}$, $(h_M, C_M)$</div>\n    <div class=\"section-title\">Guiding Frame Feature Extraction</div>\n    <div class=\"code-line\">$\\mathbf{f}_{\\text{frame}} \\leftarrow \\Phi_f(I_{\\text{guide}})$</div>\n    <div class=\"section-title\">Recurrent Processing Loop</div>\n    <div class=\"code-line\">$\\hat{f}_0 \\leftarrow f_{\\text{prev\\_cycle}}$; $(h_0, C_0) \\leftarrow (h_{\\text{prev\\_cycle}}, C_{\\text{prev\\_cycle}})$</div>\n    <div class=\"code-line\"><strong>for</strong> $m \\leftarrow 1$ to $M$ <strong>do</strong></div>\n    <div class=\"code-line indent2\">$\\mathbf{f}_{e,m} \\leftarrow \\Phi_e(P_m)$</div>\n    <div class=\"code-line indent2\">$\\mathbf{x}_m \\leftarrow \\text{concatenate}(\\mathbf{f}_{e,m}, \\hat{f}_{m-1})$</div>\n    <div class=\"code-line indent2\">$(h_m, C_m) \\leftarrow \\text{LSTM}(\\mathbf{x}_m, (h_{m-1}, C_{m-1}))$</div>\n    <div class=\"code-line indent2\">$\\Delta\\hat{f}_m \\leftarrow \\text{MLP}_{\\Delta f}(h_m)$</div>\n    <div class=\"code-line indent2\">$\\hat{f}_m \\leftarrow \\hat{f}_{m-1} + \\Delta\\hat{f}_m$</div>\n    <div class=\"code-line\"><strong>end for</strong></div>\n    <div class=\"section-title\">Fusion and Correction</div>\n    <div class=\"code-line\">$\\mathbf{f}_{\\text{fusion}} \\leftarrow \\text{concatenate}(\\hat{f}_M, \\mathbf{f}_{\\text{frame}})$</div>\n    <div class=\"code-line\">$\\Delta f_{\\text{corr}} \\leftarrow \\text{MLP}_{\\text{corr}}(\\mathbf{f}_{\\text{fusion}})$</div>\n    <div class=\"code-line\">$\\hat{f}_{\\text{final}} \\leftarrow \\hat{f}_M + \\Delta f_{\\text{corr}}$</div>\n    <div class=\"code-line return-line\"><strong>return</strong> $\\hat{f}_{\\text{final}}, (h_M, C_M)$</div>\n  </div>\n</div>\n\n</body>\n</html>",
