font-size=\"7\">400</text>\n          <text x=\"490\" y=\"282\" font-size=\"7\">500</text>\n          <text x=\"265\" y=\"292\" font-size=\"7\" text-anchor=\"middle\">Core Radius [km]</text>\n          <!-- Legend -->\n          <line x1=\"370\" y1=\"165\" x2=\"390\" y2=\"165\" stroke=\"#000\" stroke-width=\"1.5\" stroke-dasharray=\"4,3\"/>\n          <text x=\"395\" y=\"168\" font-size=\"7\">1σ level credible interval</text>\n        </svg>\n      </div>\n      <div class=\"figure-caption\"><strong>Figure 1:</strong> metallic core radius resulting from the inversion of Europa's gravity field measurements from the earlier analysis (Anderson et al., 1998; <strong>Panel A</strong>) and the more recent analysis (Gomez-Casajus et al., 2021; <strong>Panel B</strong>).</div>\n    </div>\n\n    <div class=\"figure-container\">\n      <div class=\"figure-placeholder\" style=\"height: 330px;\">\n        <svg viewBox=\"0 0 500 320\" width=\"100%\" height=\"100%\">\n          <!-- Panel A -->\n          <rect x=\"10\" y=\"5\" width=\"420\" height=\"95\" fill=\"#111\"/>\n          <text x=\"18\" y=\"18\" font-size=\"9\" font-weight=\"bold\" fill=\"white\">A</text>\n          <!-- Heatmap gradient - diagonal band from top-left to bottom-right -->\n          <defs>\n            <linearGradient id=\"heatA\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n              <stop offset=\"0%\" stop-color=\"#ff6600\"/>\n              <stop offset=\"30%\" stop-color=\"#ff3300\"/>\n              <stop offset=\"50%\" stop-color=\"#cc0066\"/>\n              <stop offset=\"70%\" stop-color=\"#6600cc\"/>\n              <stop offset=\"100%\" stop-color=\"#110033\"/>\n            </linearGradient>\n          </defs>\n          <!-- Diagonal band -->\n          <polygon points=\"20,15 100,15 420,85 420,95 340,95 20,30\" fill=\"url(#heatA)\" opacity=\"0.9\"/>\n          <polygon points=\"20,20 80,20 400,80 400,90 320,90 20,35\" fill=\"#ff4400\" opacity=\"0.6\"/>\n          <!-- Y axis -->\n          <text x=\"5\" y=\"20\" font-size=\"7\" fill=\"white\" text-anchor=\"end\">150</text>\n          <text x=\"5\" y=\"45\" font-size=\"7\" fill=\"white\" text-anchor=\"end\">100</text>\n          <text x=\"5\" y=\"70\" font-size=\"7\" fill=\"white\" text-anchor=\"end\">50</text>\n          <text x=\"5\" y=\"95\" font-size=\"7\" fill=\"white\" text-anchor=\"end\">0</text>\n          <text x=\"2\" y=\"55\" font-size=\"6\" fill=\"white\" transform=\"rotate(-90, 2, 55)\" text-anchor=\"middle\">Ocean Depth [km]</text>\n          <!-- Color bar -->\n          <rect x=\"440\" y=\"10\" width=\"12\" height=\"85\" fill=\"url(#heatA)\"/>\n          <text x=\"458\" y=\"20\" font-size=\"6\" fill=\"white\">600</text>\n          <text x=\"458\" y=\"45\" font-size=\"6\" fill=\"white\">400</text>\n          <text x=\"458\" y=\"70\" font-size=\"6\" fill=\"white\">200</text>\n          <text x=\"458\" y=\"95\" font-size=\"6\" fill=\"white\">0</text>\n          <text x=\"470\" y=\"55\" font-size=\"6\" fill=\"white\" transform=\"rotate(90, 470, 55)\" text-anchor=\"middle\">Samples</text>\n\n          <!-- Panel B -->\n          <rect x=\"10\" y=\"108\" width=\"420\" height=\"95\" fill=\"#111\"/>\n          <text x=\"18\" y=\"121\" font-size=\"9\" font-weight=\"bold\" fill=\"white\">B</text>\n          <!-- Vertical band on left side -->\n          <rect x=\"20\" y=\"113\" width=\"60\" height=\"85\" fill=\"#ff6600\" opacity=\"0.8\"/>\n          <rect x=\"20\" y=\"113\" width=\"30\" height=\"85\" fill=\"#ff3300\" opacity=\"0.6\"/>\n          <rect x=\"80\" y=\"113\" width=\"40\" height=\"85\" fill=\"#cc0066\" opacity=\"0.4\"/>\n          <rect x=\"120\" y=\"113\" width=\"30\" height=\"85\" fill=\"#6600cc\" opacity=\"0.2\"/>\n          <!-- Y axis -->\n          <text x=\"5\" y=\"123\" font-size=\"7\" fill=\"white\" text-anchor=\"end\">150</text>\n          <text x=\"5\" y=\"148\" font-size=\"7\" fill=\"white\" text-anchor=\"end\">100</text>\n          <text x=\"5\" y=\"173\" font-size=\"7\" fill=\"w