 2px solid #000; }\n  .col:last-child { border-right: none; }\n\n  .field-block {\n    border-bottom: 2px solid #000;\n    padding: 6px 10px;\n    min-height: 30px;\n  }\n  .field-block .num { font-weight: bold; }\n  .italic { font-style: italic; }\n  .small-italic { font-style: italic; font-size: 13px; }\n\n  .subrow-flex {\n    display: flex;\n    margin-top: 10px;\n  }\n  .subrow-flex .sub {\n    border-right: 2px solid #000;\n    padding: 0 10px;\n    flex: 1;\n  }\n  .subrow-flex .sub:last-child { border-right: none; }\n\n  .name-office-row { display: flex; }\n  .name-office-row .noleft { flex: 1; padding-right: 10px; border-right: 2px solid #000;}\n  .name-office-row .noright { width: 160px; padding-left: 10px; }\n  .metro { margin-top: 20px; border-top: 1px solid #000; padding-top: 4px; }\n\n  .mailing-row, .freight-row {\n    display: flex;\n    justify-content: space-between;\n    align-items: baseline;\n  }\n  .mailing-row .opts, .freight-row .opts { display: flex; gap: 15px; white-space: nowrap; }\n  .mailing-row .opts span, .freight-row .opts span { display: flex; align-items: center; }\n\n  .tel-sub {\n    display: flex;\n    border-bottom: 2px solid #000;\n  }\n  .tel-sub .t1 { flex: 1; border-right: 2px solid #000; padding: 6px 10px; }\n  .tel-sub .t2 { flex: 1; border-right: 2px solid #000; padding: 6px 10px; }\n  .tel-sub .t3 { width: 110px; padding: 6px 10px; }\n  .tel-sub .t3 div { display: flex; align-items: center; margin-bottom: 4px; }\n\n  .grid2 {\n    display: flex;\n    border-bottom: 2px solid #000;\n  }\n  .grid2 .g1 { flex: 1; border-right: 2px solid #000; padding: 6px 10px; }\n  .grid2 .g2 { flex: 1.3; padding: 6px 10px; }\n\n  .grid5 { display: flex; border-bottom: 2px solid #000; }\n  .grid5 .gcell { flex: 1; border-right: 2px solid #000; padding: 6px 8px; text-align:center; }\n  .grid5 .gcell:last-child { border-right: none; }\n\n  .attach-remarks { display: flex; }\n  .attach-remarks .arcell { flex: 1; border-right: 2px solid #000; 