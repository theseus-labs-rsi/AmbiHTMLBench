        "content": "<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>三角函数练习题</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] }\n};\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  body {\n    font-family: \"SimSun\", \"Songti SC\", serif;\n    font-size: 15px;\n    color: #1a1a1a;\n    background: #fff;\n    max-width: 700px;\n    margin: 20px auto;\n    padding: 10px 20px;\n    line-height: 1.7;\n  }\n  .question {\n    position: relative;\n    margin-top: 14px;\n    padding-right: 30px;\n  }\n  .qnum {\n    display: inline-block;\n    width: 1.6em;\n    vertical-align: top;\n  }\n  .qtext {\n    display: inline;\n  }\n  .answer-mark {\n    position: absolute;\n    right: 0;\n    top: 0;\n  }\n  .options {\n    margin-top: 6px;\n    margin-left: 1.6em;\n    display: flex;\n    flex-wrap: wrap;\n  }\n  .options span {\n    display: inline-block;\n    width: 25%;\n    box-sizing: border-box;\n  }\n  .section-title {\n    font-weight: bold;\n    font-size: 17px;\n    margin-top: 22px;\n    margin-bottom: 6px;\n  }\n  .frac {\n    display: inline-block;\n    vertical-align: middle;\n    text-align: center;\n  }\n</style>\n</head>\n<body>\n\n<div class=\"question\">\n  <span class=\"qnum\">14.</span>\n  <span class=\"qtext\">已知角θ的始边为x轴非负半轴，终边经过点P(1,2)，则 $\\dfrac{\\sin\\theta+\\cos\\theta}{\\sin\\theta}$</span>\n  <span class=\"answer-mark\">（&nbsp;&nbsp;）</span>\n  <br>\n  <span style=\"margin-left:1.6em;\">的值为</span>\n  <div class=\"options\">\n    <span>A. $-\\dfrac{1}{3}$</span>\n    <span>B. $\\dfrac{1}{3}$</span>\n    <span>C. $-\\dfrac{2}{3}$</span>\n    <span>D. $\\dfrac{2}{3}$</span>\n  </div>\n</div>\n\n<div class=\"question\">\n  <span class=\"qnum\">15.</span>\n  <span class=\"qtext\">设$\\tan\\alpha=3$，则 $\\dfrac{\\sin(\\alpha-\\pi)+\\cos(\\pi-\\alpha)}{\\sin\\left(\\dfrac{\\pi}{2}-\\alpha\\right)+\\cos\\left(\\dfrac{\\pi}{2}+\\alpha\\right)}=$</span>\n  <span class=\"answer-mark\">（&nbsp;&nbsp;）</span>\n  <div class=\"options\">\n    <span>A. $\\dfrac{10}{3}$</span>\n    <span>B. $\\dfrac{5}{3}$</span>\n    <span>C. 3</span>\n    <span>D. 2</span>\n  </div>\n</div>\n\n<div class=\"section-title\">拔高题组</div>\n\n<div class=\"question\">\n  <span class=\"qnum\">1.</span>\n  <span class=\"qtext\">$\\tan 105^\\circ=$</span>\n  <span class=\"answer-mark\">（&nbsp;&nbsp;）</span>\n  <div class=\"options\">\n    <span>A. $2-\\sqrt{3}$</span>\n    <span>B. $-2-\\sqrt{3}$</span>\n    <span>C. $\\sqrt{3}-2$</span>\n    <span>D. $-\\sqrt{3}$</span>\n  </div>\n</div>\n\n<div class=\"question\">\n  <span class=\"qnum\">2.</span>\n  <span class=\"qtext\">$\\cos 15^\\circ \\cos 75^\\circ=$</span>\n  <span class=\"answer-mark\">（&nbsp;&nbsp;）</span>\n  <div class=\"options\">\n    <span>A. $\\dfrac{\\sqrt{3}}{2}$</span>\n    <span>B. $\\dfrac{1}{2}$</span>\n    <span>C. $\\dfrac{\\sqrt{3}}{4}$</span>\n    <span>D. $\\dfrac{1}{4}$</span>\n  </div>\n</div>\n\n<div class=\"question\">\n  <span class=\"qnum\">3.</span>\n  <span class=\"qtext\">已知$\\sin\\alpha+\\cos\\alpha=\\dfrac{1}{5}$，则$\\sin 2\\alpha$的值是</span>\n  <span class=\"answer-mark\">（&nbsp;&nbsp;）</span>\n  <div class=\"options\">\n    <span>A. $-\\dfrac{24}{25}$</span>\n    <span>B. $-\\dfrac{7}{25}$</span>\n    <span>C. $\\dfrac{7}{25}$</span>\n    <span>D. $\\dfrac{24}{25}$</span>\n  </div>\n</div>\n\n<div class=\"question\">\n  <span class=\"qnum\">4.</span>\n  <span class=\"qtext\">已知$\\sin\\alpha-\\cos\\alpha=\\dfrac{4}{3}$，则$\\sin 2\\alpha=$</span>\n  <span class=\"answer-mark\">（&nbsp;&nbsp;）</span>\n  <div class=\"options\">\n    <span>A. $-\\dfrac{7}{16}$</span>\n    <span>B. $-\\dfrac{7}{9}$</span>\n    <span>C. $\\dfrac{7}{16}$</span>\n    <span>D. $\\dfrac{7}{9}$</span>\n  </div>\n</div>\n\n<div class=\"question\">\n  <span class=\"qnum\">5.</span>\n  <span class=\"qtext\">已知角α的顶点与原点重合，始边与x轴的非负半轴重合，点P(-1,3)在角α的终边上，则 $\\dfrac{\\sin\\alpha-\\cos\\alpha}{2\\sin\\alpha-3\\cos\\alpha}=$</span>\n  <span class=\"answer-mark\">（&nbsp;&nbsp;）</span>\n  <div class=\"options\">\n    <span>A. $-\\dfrac{3}{4}$</span>\n    <span>B. $\\dfrac{3}{4}$</span>\n    <span>C. $-\\dfrac{4}{9}$</span>\n    <span>D. $\\dfrac{4}{9}$</span>\n  </div>\n</div>\n\n<div class=\"question\">\n  <span class=\"qnum\">6.</span>\n  <span class=\"qtext\">已知角α的终边过点P(1,2)，则 $\\dfrac{2\\sin\\alpha+\\cos\\alpha}{2\\sin\\alpha-\\cos\\alpha}=$</span>\n  <span class=\"answer-mark\">（&nbsp;&nbsp;）</span>\n  <div class=\"options\">\n    <span>A. 2</span>\n    <span>B. 1</span>\n    <span>C. -1</span>\n    <span>D. -2</span>\n  </div>\n</div>\n\n<div class=\"question\">\n  <span class=\"qnum\">7.</span>\n  <span class=\"qtext\">已知$\\sin\\alpha-3\\cos\\alpha=0$，则 $\\dfrac{3\\cos\\alpha-4\\sin\\alpha}{\\sin\\alpha+\\cos\\alpha}=$</span>\n  <span class=\"answer-mark\">（&nbsp;&nbsp;）</span>\n  <div class=\"options\">\n    <span>A. $-\\dfrac{9}{4}$</span>\n    <span>B. $\\dfrac{4}{9}$</span>\n    <span>C. $\\dfrac{3}{4}$</span>\n    <span>D. -3</span>\n  </div>\n</div>\n\n</body>\n</html>"
