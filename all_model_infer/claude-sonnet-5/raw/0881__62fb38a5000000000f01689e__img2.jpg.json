5deg, #111 0%, #2a2a2a 40%, #6fbf3a 100%);\n    border-radius: 14px;\n    padding: 14px 16px;\n    text-align: center;\n  }\n  .title-box .t1 {\n    color: #ffffff;\n    font-size: 22px;\n    font-weight: bold;\n    letter-spacing: 2px;\n  }\n  .title-box .t2 {\n    color: #d8f27a;\n    font-size: 19px;\n    font-weight: bold;\n    margin-top: 4px;\n    letter-spacing: 1px;\n  }\n  .content {\n    font-size: 14.5px;\n    color: #222;\n    line-height: 1.6;\n  }\n  .intro {\n    font-weight: bold;\n    margin-bottom: 4px;\n  }\n  .section {\n    margin-top: 14px;\n  }\n  .num-circle {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 20px;\n    height: 20px;\n    background: #7bc142;\n    color: #fff;\n    border-radius: 50%;\n    font-size: 13px;\n    font-weight: bold;\n    margin-right: 4px;\n  }\n  .sec-title {\n    font-weight: bold;\n    margin-bottom: 4px;\n  }\n  .sec-body {\n    margin: 2px 0 0 2px;\n  }\n  .cross {\n    color: #e0342a;\n    font-weight: bold;\n  }\n  .circle-mark {\n    color: #e0342a;\n  }\n  .emoji {\n    font-size: 14px;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <div class=\"reg-mark\">®</div>\n\n  <div class=\"header\">\n    <div class=\"placeholder icon\">\n      <div class=\"icon-img\"><div class=\"legs\"><div></div><div></div></div></div>\n    </div>\n    <div class=\"title-box\">\n      <div class=\"t1\">疑惑点三</div>\n      <div class=\"t2\">赛场上如何发挥</div>\n    </div>\n  </div>\n\n  <div class=\"content\">\n    <div class=\"intro\">最快上手辩论方式：打一场堂堂正正的辩论赛</div>\n    <div class=\"intro\">注意点：</div>\n\n    <div class=\"section\">\n      <div class=\"sec-title\"><span class=\"num-circle\">1</span>咬字清晰，表达流畲，保持头脑清醒<span class=\"emoji\">🤔</span></div>\n      <div class=\"sec-body\">输出观点注意‼️重音/停顿/起伏/气势</div>\n    </div>\n\n    <div class=\"section\">\n      <div class=\"sec-title\"><span class=\"num-circle\">2</span>笔不能停，记关键词<span class=\"emoji\">📝</span></div>\n      <div class=\"sec-body\">用不同颜色的笔画框标注<span class=\"circle-mark\">〇</span></div>\n    </div>\n\n    <div class=\"section\">\n      <div class=\"sec-title\"><span class=\"num-circle\">3</span>反驳思维（挖掘机）</div>\n      <div class=\"sec-body\">接前提，拆前提；拆逻辑关系；拆数据、削弱效力；</div>\n    </div>\n\n    <div class=\"section\">\n      <div class=\"sec-title\"><span class=\"num-circle\">4</span>推论思维（推土机）</div>\n      <div class=\"sec-body\">重申+延伸论点；举出不同论据；铺陈结辩价值；</div>\n    </div>\n\n    <div class=\"section\">\n      <div class=\"sec-title\"><span class=\"num-circle\">5</span>战场意识</div>\n      <div class=\"sec-body\">\n        <span class=\"emoji\">🤺</span>不恋战（不要为了反驳而反驳但是已经离题）<br>\n        <span class=\"emoji\">🈲</span>不作死（进攻有利战场和充分准备的战场）<br>\n        <span class=\"emoji\">🈲</span>不侵幸（不要刻意回避不利战场，也要充分准备）\n      </div>\n      <div class=\"sec-body\" style=\"margin-top:6px;\">\n        漫无目的的反驳<span class=\"cross\">✕</span>毫无结局的追究<span class=\"cross\">✕</span>突如其来的攻击<span class=\"cross\">✕</span>\n      </div>\n    </div>\n\n    <div class=\"section\">\n      <div class=\"sec-title\"><span class=\"num-circle\">6</span>小结意识<span class=\"emoji\">🔒</span></div>\n      <div class=\"sec-body\">说给评委听，结束已经女下的战场</div>\n    </div>\n  </div>\n</div>\n</body>\n</html>"
