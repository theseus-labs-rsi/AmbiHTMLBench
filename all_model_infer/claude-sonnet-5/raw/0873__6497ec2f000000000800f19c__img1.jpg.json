        "content": "<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>精酿、原浆、鲜啤、生啤、扎啤、干啤、冰啤的区别</title>\n<script>\nwindow.MathJax = { tex: { inlineMath: [['$','$']], displayMath: [['$$','$$']] } };\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\" async></script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    font-family: \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n    background: linear-gradient(160deg, #d9e3f7 0%, #e9e6f5 50%, #f3e8ee 100%);\n    display: flex;\n    justify-content: center;\n    padding: 20px 0;\n  }\n  .page {\n    width: 540px;\n    min-height: 720px;\n    padding: 20px 18px 30px 18px;\n    position: relative;\n  }\n  .title {\n    font-size: 26px;\n    font-weight: 900;\n    color: #1a1a1a;\n    line-height: 1.35;\n    margin: 10px 0 25px 0;\n  }\n  .card {\n    background: #ffffff;\n    border-radius: 18px;\n    padding: 25px 15px 25px 10px;\n    box-shadow: 0 8px 20px rgba(0,0,0,0.06);\n  }\n  .section {\n    display: flex;\n    align-items: center;\n    margin-bottom: 28px;\n  }\n  .section:last-child { margin-bottom: 0; }\n  .label-main {\n    flex: 0 0 90px;\n    color: #fff;\n    font-weight: bold;\n    font-size: 14px;\n    text-align: center;\n    border-radius: 10px;\n    padding: 10px 4px;\n    margin-right: 8px;\n    z-index: 2;\n  }\n  .branches {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n  }\n  .branch {\n    display: flex;\n    align-items: center;\n    position: relative;\n  }\n  .line {\n    flex: 0 0 14px;\n    height: 2px;\n  }\n  .pill {\n    flex: 0 0 auto;\n    color: #fff;\n    font-size: 11.5px;\n    font-weight: 600;\n    text-align: center;\n    padding: 6px 8px;\n    border-radius: 8px;\n    line-height: 1.3;\n  }\n  .pill.mid {\n    flex: 1 1 auto;\n    margin: 0 4px;\n  }\n  .pill.right {\n    flex: 0 0 auto;\n    min-width: 70px;\n  }\n  .pill.long {\n    flex: 1 1 auto;\n    text-align: left;\n    font-size: 11px;\n    padding: 10px 10px;\n    line-height: 1.5;\n  }\n\n  /* color scheme */\n  .navy   { background:#2c3e6b; }\n  .purple { background:#4b3b78; }\n  .darkbox{ background:#2c2c3a; }\n\n  .red    { background:#e05a4e; }\n  .orange { background:#f0a03c; }\n  .yellow { background:#e6c94a; }\n  .green  { background:#3fae7a; }\n  .blue   { background:#4586c9; }\n\n  .line.red-l    { background:#e05a4e; }\n  .line.orange-l { background:#f0a03c; }\n  .line.yellow-l { background:#e6c94a; }\n  .line.green-l  { background:#3fae7a; }\n  .line.blue-l   { background:#4586c9; }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <div class=\"title\">精酿、原浆、鲜啤、生啤、<br>扎啤、干啤、冰啤的区别</div>\n\n  <div class=\"card\">\n\n    <!-- Section 1: 啤酒原浆 -->\n    <div class=\"section\">\n      <div class=\"label-main navy\">啤酒原浆</div>\n      <div class=\"branches\">\n\n        <div class=\"branch\">\n          <div class=\"line red-l\"></div>\n          <div class=\"pill mid red\">不杀菌+不滤清</div>\n          <div class=\"line red-l\"></div>\n          <div class=\"pill right red\">原浆啤酒</div>\n        </div>\n\n        <div class=\"branch\">\n          <div class=\"line orange-l\"></div>\n          <div class=\"pill mid orange\">不杀菌+滤清</div>\n          <div class=\"line orange-l\"></div>\n          <div class=\"pill right orange\">鲜啤</div>\n        </div>\n\n        <div class=\"branch\">\n          <div class=\"line yellow-l\"></div>\n          <div class=\"pill mid yellow\">不杀菌+滤清+膜过滤除菌(非高温)</div>\n          <div class=\"line yellow-l\"></div>\n          <div class=\"pill right yellow\">生啤</div>\n        </div>\n\n        <div class=\"branch\">\n          <div class=\"line green-l\"></div>\n          <div class=\"pill mid green\">桶装鲜啤+二氧化碳+冰镇</div>\n          <div class=\"line green-l\"></div>\n          <div class=\"pill right green\">扎啤</div>\n        </div>\n\n        <div class=\"branch\">\n          <div class=\"line blue-l\"></div>\n          <div class=\"pill mid blue\">滤清+巴氏杀菌或瞬时高温杀菌</div>\n          <div class=\"line blue-l\"></div>\n          <div class=\"pill right blue\">熟啤</div>\n        </div>\n\n      </div>\n    </div>\n\n    <!-- Section 2: 啤酒 -->\n    <div class=\"section\">\n      <div class=\"label-main purple\">啤酒</div>\n      <div class=\"branches\">\n\n        <div class=\"branch\">\n          <div class=\"line red-l\"></div>\n          <div class=\"pill mid red\">精酿啤酒</div>\n          <div class=\"line red-l\"></div>\n          <div class=\"pill right red\">追求独特的口味</div>\n        </div>\n\n        <div class=\"branch\">\n          <div class=\"line orange-l\"></div>\n          <div class=\"pill mid orange\">工业啤酒</div>\n          <div class=\"line orange-l\"></div>\n          <div class=\"pill right orange\">追求工业标准化</div>\n        </div>\n\n      </div>\n    </div>\n\n    <!-- Section 3: 按工艺区分 -->\n    <div class=\"section\">\n      <div class=\"label-main darkbox\">按工艺区分</div>\n      <div class=\"branches\">\n\n        <div class=\"branch\">\n          <div class=\"line orange-l\"></div>\n          <div class=\"pill mid orange\" style=\"flex:0 0 60px;\">冰啤</div>\n          <div class=\"line orange-l\"></div>\n          <div class=\"pill long orange\">\n            先把啤酒的温度降到冰点，使啤酒因低温而产生冰冷凝结，然后再进行过滤使啤酒变清，和普通啤酒最大的不同之处在于降温这道工序不清，使酒色更亮丽，口感更清爽醇厚，酒精度数也有一定提高。\n          </div>\n        </div>\n\n        <div class=\"branch\">\n          <div class=\"line red-l\"></div>\n          <div class=\"pill mid red\" style=\"flex:0 0 60px;\">干啤</div>\n          <div class=\"line red-l\"></div>\n          <div class=\"pill long red\">\n            干啤采用了特殊的酵母进行发酵酿制，使啤酒中所含的糖分完全转化为酒精，比普通啤酒要低，让干啤喝起来的口感干爽而不甜，清爽而无余味。\n          </div>\n        </div>\n\n      </div>\n    </div>\n\n  </div>\n</div>\n</body>\n</html>"
