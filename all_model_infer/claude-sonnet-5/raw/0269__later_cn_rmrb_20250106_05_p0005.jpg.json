        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>人民日报 - 评论版</title>\n<script>\nwindow.MathJax = { tex: { inlineMath: [['$','$']], displayMath: [['$$','$$']] } };\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\" async></script>\n<style>\n  body {\n    font-family: \"SimSun\", \"Songti SC\", serif;\n    margin: 0;\n    padding: 0;\n    background: #fff;\n    color: #000;\n    font-size: 12px;\n  }\n  .page {\n    max-width: 900px;\n    margin: 0 auto;\n    padding: 10px 20px;\n  }\n  .masthead {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-end;\n    border-bottom: 3px solid #000;\n    padding-bottom: 4px;\n    margin-bottom: 6px;\n  }\n  .masthead .logo {\n    font-size: 26px;\n    font-weight: bold;\n    letter-spacing: 2px;\n  }\n  .masthead .meta {\n    text-align: right;\n    font-size: 13px;\n  }\n  .masthead .meta .pagenum {\n    font-size: 16px;\n    font-weight: bold;\n  }\n  .columns {\n    display: grid;\n    grid-template-columns: 1fr 1fr 1fr;\n    gap: 14px;\n  }\n  .col {\n    border-right: 1px solid #ccc;\n    padding-right: 8px;\n  }\n  .col:last-child {\n    border-right: none;\n  }\n  .section-label {\n    font-weight: bold;\n    font-size: 12px;\n    margin: 8px 0 4px 0;\n    display: flex;\n    align-items: center;\n  }\n  .section-label .marker {\n    color: #b30000;\n    margin-right: 4px;\n    font-weight: bold;\n  }\n  h1.headline {\n    font-size: 19px;\n    font-weight: bold;\n    text-align: center;\n    margin: 6px 0 4px 0;\n    line-height: 1.3;\n  }\n  h1.headline.big {\n    font-size: 22px;\n    margin: 10px 0;\n  }\n  .byline {\n    text-align: right;\n    font-size: 11px;\n    margin-bottom: 6px;\n    padding-right: 4px;\n  }\n  .byline.center {\n    text-align: center;\n  }\n  .text-block {\n    text-align: justify;\n    line-height: 1.6