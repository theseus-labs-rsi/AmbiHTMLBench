=\"black\">第一周</span>\n  </div>\n  <table>\n    <colgroup>\n      <col class=\"day-col\">\n      <col>\n      <col>\n      <col>\n    </colgroup>\n    <thead>\n      <tr>\n        <th class=\"empty-corner\"></th>\n        <th>早餐</th>\n        <th>午餐</th>\n        <th>晚餐</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr class=\"odd\">\n        <td class=\"day\">周一</td>\n        <td class=\"meal\">豆浆<br>杂粮馒头<br>苹果</td>\n        <td class=\"meal\">杂粮饭<br>花菜炒肉<br>白灼虾</td>\n        <td class=\"meal\">荞麦面<br>清炒白菜<br>凉拌西红柿</td>\n      </tr>\n      <tr class=\"even\">\n        <td class=\"day\">周二</td>\n        <td class=\"meal\">杂粮馒头<br>素炒扁豆<br>煮鸡蛋</td>\n        <td class=\"meal\">杂粮饭<br>蒜苗炒肉<br>炒油麦菜</td>\n        <td class=\"meal\">牛奶<br>白灼虾<br>素炒菠菜</td>\n      </tr>\n      <tr class=\"odd\">\n        <td class=\"day\">周三</td>\n        <td class=\"meal\">牛奶<br>素包子<br>凉拌木耳</td>\n        <td class=\"meal\">杂粮饭<br>素炒茴蒿<br>清蒸鲈鱼</td>\n        <td class=\"meal\">鸡丝荞麦面<br>蔬菜沙拉</td>\n      </tr>\n      <tr class=\"even\">\n        <td class=\"day\">周四</td>\n        <td class=\"meal\">牛奶<br>杂粮馒头<br>素炒丝瓜</td>\n        <td class=\"meal\">杂粮饭<br>炒牛肉<br>素炒绿豆芽</td>\n        <td class=\"meal\">素水饺<br>凉拌黄瓜</td>\n      </tr>\n      <tr class=\"odd\">\n        <td class=\"day\">周五</td>\n        <td class=\"meal\">豆浆<br>紫菜饼<br>煮鸡蛋</td>\n        <td class=\"meal\">杂粮饭<br>芹菜炒肉<br>西红柿炒鸡蛋</td>\n        <td class=\"meal\">花卷<br>冬瓜虾皮汤<br>排骨</td>\n      </tr>\n      <tr class=\"even\">\n        <td class=\"day\">周六</td>\n        <td class=\"meal\">牛奶<br>全麦面包<br>素炒青菜</td>\n        <td class=\"meal\">杂粮饭<br>炒羊肉<br>素炒西葫芦</td>\n        <td class=\"meal\">荞麦面<br>炒鸡丁<br>炒油麦菜</td>\n      </tr>\n      <tr class=\"odd\">\n        <td class=\"day\">周日</td>\n        <td class=\"meal\">牛奶<br>杂粮馒头<br>凉拌海带丝</td>\n        <td class=\"meal\">杂粮饭<br>白灼虾<br>素炒茄子</td>\n        <td class=\"meal\">鸡汤馄饨<br>炒油麦菜<br>凉拌黄瓜</td>\n      </tr>\n    </tbody>\n  </table>\n</div>\n</body>\n</html>"
