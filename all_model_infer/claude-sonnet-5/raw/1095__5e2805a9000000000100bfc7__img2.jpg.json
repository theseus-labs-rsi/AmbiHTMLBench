n-items: flex-start;\n    margin-bottom: 7px;\n    font-size: 11.5px;\n    color: #222;\n    line-height: 1.3;\n  }\n  .checkbox {\n    width: 11px;\n    height: 11px;\n    border: 1.5px solid #333;\n    border-radius: 50%;\n    margin-right: 6px;\n    margin-top: 1px;\n    flex-shrink: 0;\n  }\n  .note {\n    font-size: 10px;\n    color: #555;\n    margin-left: 2px;\n  }\n  .footer {\n    margin-top: 10px;\n    border-top: 1px dashed #ccc;\n    padding-top: 12px;\n  }\n  .footer p {\n    font-size: 14px;\n    font-weight: bold;\n    color: #1a1a1a;\n    margin: 6px 0;\n  }\n  .divider-row {\n    grid-column: 1 / -1;\n    height: 10px;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"header\">\n    <div class=\"receipt-icon\">\n      <div class=\"r-title\">RECEIPT</div>\n      <div class=\"r-line\"></div>\n      <div class=\"r-line\"></div>\n      <div class=\"r-line\"></div>\n      <div class=\"r-line\"></div>\n      <div class=\"r-line\"></div>\n      <div class=\"r-line\"></div>\n    </div>\n    <div class=\"title\">全屋清洁检查清单</div>\n  </div>\n\n  <div class=\"grid\">\n\n    <div class=\"section\">\n      <h2>阳台清洁</h2>\n      <div class=\"item\"><span class=\"checkbox\"></span>剪掉植物枯枝叶</div>\n      <div class=\"item\"><span class=\"checkbox\"></span>阳台灰尘及泥土清扫</div>\n      <div class=\"item\"><span class=\"checkbox\"></span>阳台置物架清洁</div>\n      <div class=\"item\"><span class=\"checkbox\"></span>洗衣机深度清洁内部</div>\n      <div class=\"item\"><span class=\"checkbox\"></span>阳台晾衣杆擦一遍</div>\n      <div class=\"item\"><span class=\"checkbox\"></span>地面冲洗清洁</div>\n    </div>\n\n    <div class=\"section\">\n      <h2>全屋除灰大作战</h2>\n      <div class=\"item\"><span class=\"checkbox\"></span>全屋天花板除尘</div>\n      <div class=\"item\"><span class=\"checkbox\"></span>窗帘杆及窗帘除尘</div>\n      <div class=\"item\"><span class=\"checkbox\"></span>户外栏杆擦拭</div>\n      <div class=\"item\"><span class=\"checkbox\"></span>湿布擦拭所有纱窗</div>\n      <div class=\"item\"><span clas