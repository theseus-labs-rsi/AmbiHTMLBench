px;\n  }\n  .pin-label {\n    position: absolute;\n    font-size: 14px;\n    font-weight: bold;\n    color: #333;\n    display: flex;\n    align-items: center;\n  }\n  .pin-label .pin {\n    color: #e0402a;\n    font-size: 16px;\n    margin-right: 3px;\n  }\n  .arrow-label {\n    position: absolute;\n    color: #e0722a;\n    font-size: 13px;\n    font-weight: bold;\n    text-align: center;\n    line-height: 1.3;\n  }\n  .arrow-symbol {\n    color: #f08a3c;\n    font-size: 24px;\n    font-weight: bold;\n  }\n  .bottom-block {\n    position: absolute;\n    font-size: 13px;\n    font-weight: bold;\n    color: #444;\n    line-height: 1.6;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <!-- Header -->\n  <div class=\"badge-day3\">\n    <span class=\"squiggle\">〜</span>DAY3\n  </div>\n  <div class=\"title-box\"><span>3.特色路线</span></div>\n\n  <!-- Text: 艺术感满满 -->\n  <div class=\"caption-text\" style=\"top:100px; left:195px; width:150px;\">\n    艺术感满满，适合出片\n  </div>\n\n  <!-- Image: 那香海落日 -->\n  <div class=\"placeholder\" style=\"top:120px; left:345px; width:200px; height:140px;\">\n    [Photo: sunset over sea with boat silhouette]\n  </div>\n  <div class=\"pin-label\" style=\"top:265px; left:345px;\">\n    <span class=\"pin\">📍</span>那香海落日\n  </div>\n\n  <!-- Arrow: 打车33分钟 (curving from right up to sunset image) -->\n  <div class=\"arrow-label\" style=\"top:290px; left:460px; width:80px;\">\n    打车33分钟<br><span class=\"arrow-symbol\">↖</span>\n  </div>\n\n  <!-- Image: 那香海 -->\n  <div class=\"placeholder\" style=\"top:180px; left:20px; width:210px; height:150px;\">\n    [Photo: beach with two thatched-roof umbrellas]\n  </div>\n  <div class=\"pin-label\" style=\"top:337px; left:60px;\">\n    <span class=\"pin\">📍</span>那香海\n  </div>\n\n  <!-- Arrow: 打车11分钟 -->\n  <div class=\"arrow-label\" style=\"top:300px; left:250px; width:90px;\">\n    <span class=\"arrow-symbol\">↘</span><br>打车11分钟\n  </div>\n\n  <!-- Text block: 悬崖书吧... -->\n  <div class=\"caption-text\" 