ht;\n    margin: 0 20px 8px 0;\n  }\n\n  .flag-ph {\n    width: 60px;\n    height: 60px;\n    background: #e64a3a;\n    border: none;\n    color: #fff;\n    font-size: 13px;\n    font-weight: bold;\n    border-radius: 4px;\n    position: absolute;\n    right: 30px;\n    top: 470px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    line-height: 1.3;\n    transform: rotate(4deg);\n  }\n\n  .bottom-process-row {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    margin: 10px 0 8px 20px;\n  }\n  .bottom-ph {\n    width: 60px;\n    height: 50px;\n    border-radius: 50%;\n  }\n\n  .final-bagel-photo {\n    width: 200px;\n    height: 160px;\n    margin: 4px 20px 0 auto;\n    border-radius: 50%;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <div class=\"inner\">\n\n    <div class=\"badge\">元气<br>满满</div>\n\n    <div class=\"main-title\">核桃奶酪贝果 <span class=\"emoji-small\">🥯</span></div>\n\n    <div class=\"section-label\">1.准备材料</div>\n    <div class=\"ingredients-row\">\n      <div class=\"ingredient\">\n        <div class=\"placeholder\">[Photo: 奶酪盒装]</div>\n        <div class=\"ingredient-name\">奶酪</div>\n      </div>\n      <div class=\"ingredient\">\n        <div class=\"placeholder\">[Photo: 贝果]</div>\n        <div class=\"ingredient-name\">贝果</div>\n      </div>\n      <div class=\"ingredient\">\n        <div class=\"placeholder\">[Photo: 核桃仁]</div>\n        <div class=\"ingredient-name\">核桃仁</div>\n      </div>\n    </div>\n\n    <div style=\"display:flex; align-items:flex-start;\">\n      <div class=\"placeholder bagel-photo\">[Photo: 核桃奶酪贝果切开]</div>\n    </div>\n\n    <div class=\"body-text\">\n      2.核桃仁烤2分钟左右，搓掉皮，<br>\n      捣碎后和奶酪混合到一起，涂抹<br>\n      在贝果上\n    </div>\n\n    <div class=\"process-row\">\n      <div class=\"placeholder oven-ph\">[Photo: 烤箱]</div>\n      <span class=\"arrow\">→</span>\n      <div class=\"placeholder bowl-ph\">[Photo: 核桃碎拌奶酪]</div>\n      <span class=\"