        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>香水浓度分类表</title>\n<script type=\"text/javascript\" id=\"MathJax-script\" async\n  src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\">\n</script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    padding: 40px 0;\n    min-height: 100vh;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    background: repeating-linear-gradient(\n        90deg,\n        #a9814f 0px, #a9814f 6px,\n        #9c7645 6px, #9c7645 12px,\n        #b28a56 12px, #b28a56 18px\n      ),\n      linear-gradient(180deg, #8a6a3f, #7a5c37);\n    font-family: \"Songti SC\", \"SimSun\", \"STSong\", serif;\n  }\n\n  .card {\n    position: relative;\n    width: 480px;\n    background: #fbf9f5;\n    border-radius: 14px;\n    box-shadow: 0 6px 24px rgba(0,0,0,0.35);\n    padding: 26px 30px 24px 44px;\n  }\n\n  h1 {\n    text-align: center;\n    font-size: 40px;\n    letter-spacing: 6px;\n    color: #6b5330;\n    font-weight: 900;\n    margin: 6px 0 22px 0;\n  }\n\n  .bottles {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-end;\n    padding: 0 4px 18px 4px;\n    margin-bottom: 6px;\n  }\n\n  .bottle-wrap {\n    width: 78px;\n    height: 100px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: flex-end;\n    position: relative;\n  }\n\n  .spray-lines {\n    position: absolute;\n    top: -6px;\n    left: 50%;\n    width: 44px;\n    height: 14px;\n    transform: translateX(-50%);\n  }\n  .spray-lines::before, .spray-lines::after {\n    content: \"\";\n    position: absolute;\n    top: 6px;\n    width: 20px;\n    height: 1px;\n    border-top: 1px dashed #888;\n  }\n  .spray-lines::before { left: -6px; transform: rotate(-8deg); }\n  .spray-lines::after { right: -6px; transform: rotate(8deg); }\n\n  .ball {\n    width: 14px;\n    height: 14px;\n    border-radius: 50%;\n    background: radial-gradient(circle at 35% 30%, #ff8b7a, #d92f1f);\n    margin-bottom: 2px;\n    z-index: 2;\n  }\n  .neck {\n    width: 6px;\n    height: 8px;\n    background: #444;\n  }\n  .cup {\n    width: 46px;\n    height: 60px;\n    border: 1.5px solid #888;\n    border-top: none;\n    border-radius: 0 0 6px 6px;\n    background: #ffffff;\n    position: relative;\n    overflow: hidden;\n    clip-path: polygon(8% 0, 92% 0, 100% 100%, 0% 100%);\n  }\n  .fill {\n    position: absolute;\n    bottom: 0;\n    left: 0;\n    width: 100%;\n    background: #d9d9d9;\n  }\n  .label-name {\n    font-size: 12px;\n    color: #333;\n    margin-top: 4px;\n  }\n\n  table {\n    width: 100%;\n    border-collapse: collapse;\n    table-layout: fixed;\n  }\n  td, th {\n    text-align: center;\n    padding: 14px 2px;\n    font-size: 15px;\n    color: #333;\n    vertical-align: middle;\n    white-space: pre-line;\n  }\n  tr {\n    border-bottom: 1px solid #e6e2da;\n  }\n  tr:last-child { border-bottom: none; }\n\n  .rowlabel {\n    position: relative;\n    left: -44px;\n    width: 34px;\n    background: #f3ede0;\n    color: #6b5330;\n    font-weight: bold;\n    font-size: 14px;\n    border-radius: 6px 0 0 6px;\n    padding: 10px 4px;\n    box-shadow: -2px 2px 4px rgba(0,0,0,0.08);\n  }\n\n  .header-cell {\n    font-weight: bold;\n    font-size: 16px;\n    color: #4a3a20;\n  }\n\n  .tips {\n    margin-top: 18px;\n    padding-left: 4px;\n    font-size: 13px;\n    color: #444;\n    line-height: 1.7;\n  }\n  .tips .tips-title {\n    font-weight: bold;\n    color: #4a3a20;\n    margin-bottom: 4px;\n  }\n</style>\n</head>\n<body>\n  <div class=\"card\">\n    <h1>香水浓度</h1>\n\n    <div class=\"bottles\">\n      <div class=\"bottle-wrap\">\n        <div class=\"spray-lines\"></div>\n        <div class=\"ball\"></div>\n        <div class=\"neck\"></div>\n        <div class=\"cup\"><div class=\"fill\" style=\"height