        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>11月龄宝宝的辅食攻略</title>\n<script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  body {\n    background: #d9d9d9;\n    font-family: \"Microsoft YaHei\", \"SimSun\", sans-serif;\n    margin: 0;\n    padding: 20px;\n    display: flex;\n    justify-content: center;\n  }\n  .book-spread {\n    display: flex;\n    background: #fff;\n    box-shadow: 0 2px 8px rgba(0,0,0,0.3);\n    max-width: 1100px;\n  }\n  .page {\n    width: 50%;\n    padding: 18px 22px;\n    box-sizing: border-box;\n    position: relative;\n    font-size: 12px;\n    color: #333;\n  }\n  .page.left {\n    border-right: 1px dashed #ccc;\n  }\n  .header-bar {\n    background: #8db83f;\n    color: #fff;\n    padding: 10px 14px;\n    display: flex;\n    align-items: baseline;\n    gap: 6px;\n    margin-bottom: 14px;\n  }\n  .header-bar .big-num {\n    font-size: 26px;\n    font-weight: bold;\n  }\n  .header-bar .title-text {\n    font-size: 15px;\n    font-weight: bold;\n  }\n  .tab-label {\n    position: absolute;\n    top: 4px;\n    right: 6px;\n    font-size: 9px;\n    color: #999;\n  }\n  .section-title {\n    color: #6b9a2f;\n    font-weight: bold;\n    font-size: 13px;\n    margin: 10px 0 6px 0;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n  }\n  .section-title::before {\n    content: \"\";\n    width: 8px;\n    height: 8px;\n    background: #6b9a2f;\n    border-radius: 50%;\n    display: inline-block;\n  }\n  ul.bullet-list {\n    margin: 0 0 10px 0;\n    padding-left: 16px;\n    line-height: 1.6;\n  }\n  ul.bullet-list li {\n    margin-bottom: 3px;\n  }\n  .food-shapes {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: space-around;\n    gap: 10px;\n    margin: 8px 0 14px 0;\n  }\n  .food-item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    width: 70px;\n  }\n  .placeholder {\n    width: 55px;\n    height: 40px;\n    border: 1px solid #b5b5b5;\n    border-radius: 50% / 30%;\n    background: #f2ede2;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 8px;\n    color: #999;\n    text-align: center;\n    margin-bottom: 4px;\n  }\n  .food-label {\n    font-size: 11px;\n    color: #333;\n  }\n  .advice-block {\n    line-height: 1.7;\n    margin-bottom: 4px;\n  }\n  .advice-block .label {\n    font-weight: bold;\n    color: #444;\n  }\n  .recipe-block {\n    margin-bottom: 14px;\n    padding-bottom: 6px;\n    border-bottom: 1px solid #eee;\n  }\n  .recipe-title {\n    background: #eef3e2;\n    color: #6b9a2f;\n    font-weight: bold;\n    font-size: 12px;\n    padding: 4px 8px;\n    margin-bottom: 6px;\n  }\n  .recipe-sub {\n    font-weight: bold;\n    color: #6b9a2f;\n    margin: 4px 0 2px 0;\n    font-size: 11px;\n  }\n  .recipe-text {\n    line-height: 1.6;\n    margin: 0 0 4px 0;\n  }\n  ol.steps {\n    margin: 0 0 8px 0;\n    padding-left: 18px;\n    line-height: 1.6;\n  }\n  ol.steps li {\n    margin-bottom: 2px;\n  }\n  .illegible {\n    color: #999;\n    font-style: italic;\n  }\n</style>\n</head>\n<body>\n<div class=\"book-spread\">\n\n  <!-- LEFT PAGE -->\n  <div class=\"page left\">\n    <div class=\"tab-label\">[illegible]</div>\n    <div class=\"header-bar\">\n      <span class=\"big-num\">11</span>\n      <span class=\"title-text\">月龄宝宝的辅食攻略</span>\n    </div>\n\n    <div class=\"section-title\">喂养重点</div>\n    <ul class=\"bullet-list\">\n      <li>每餐让孩子适量的、荤素搭配，保证足量食物摄入</li>\n      <li>注意宝宝零食的餐后添加摄入，避免影响正常饮食</li>\n      <li>让宝宝养成良好的用餐习惯，掌握合理的进食时间让他慢慢进食</li>\n      <li>如果宝宝需要额外补充，可用胚芽粉等营养的食物添加剂</li>\n      <li>继续定期给宝宝称体重、测身高，及时了解发育状况</li>\n    </ul>\n\n    <div class=\"section-title\">辅食性状</div>\n    <div class=\"illegible\" style=\"margin-bottom:6px;\">（以米饭、蔬菜、猪肉、南瓜等为例）[illegible]</div>\n    <div class=\"food-shapes\">\n      <div class=\"food-item\">\n        <div class=\"placeholder\">[Food: rice, bowl]</div>\n        <span class=\"food-label\">米饭</span>\n      </div>\n      <div class=\"food-item\">\n        <div class=\"placeholder\">[Food: mixed veg]</div>\n        <span class=\"food-label\">蔬菜</span>\n      </div>\n      <div class=\"food-item\">\n        <div class=\"placeholder\">[Food: pork]</div>\n        <span class=\"food-label\">猪肉</span>\n      </div>\n      <div class=\"food-item\">\n        <div class=\"placeholder\">[Food: greens]</div>\n        <span class=\"food-label\">蔬菜</span>\n      </div>\n      <div class=\"food-item\">\n        <div class=\"placeholder\">[Food: pumpkin]</div>\n        <span class=\"food-label\">南瓜</span>\n      </div>\n    </div>\n\n    <div class=\"section-title\">喂养建议</div>\n    <div class=\"advice-block\"><span class=\"label\">谷薯类：</span>每日2-4次，总量600-700ml</div>\n    <div class=\"advice-block\"><span class=\"label\">蔬菜类：</span>每日2-3次，每次3/4碗</div>\n    <div class=\"advice-block\"><span class=\"label\">谷类选择：</span>面粉、粳米、燕麦、面包 1/2-3/4碗</div>\n    <div class=\"advice-block\"><span class=\"label\">蔬菜类：</span>菠菜叶1/2碗</div>\n    <div class=\"advice-block\"><span class=\"label\">水果类：</span>水果1小块1/2碗</div>\n    <div class=\"advice-block\"><span class=\"label\">肉、蛋、鱼、豆类：</span>每日5g，不加盐</div>\n  </div>\n\n  <!-- RIGHT PAGE -->\n  <div class=\"page right\">\n    <div class=\"tab-label\">[illegible]</div>\n    <div class=\"header-bar\">\n      <span class=\"title-text\">经典食谱</span>\n    </div>\n\n    <div class=\"recipe-block\">\n      <div class=\"recipe-title\">食谱一：背薯肉松疙瘩汤</div>\n      <div class=\"recipe-sub\">用料：</div>\n      <div class=\"recipe-text\">青菜、肉松、面粉、食用油、水</div>\n      <div class=\"recipe-sub\">做法：</div>\n      <ol class=\"steps\">\n        <li>青菜洗净汆水切碎备用</li>\n        <li>面粉加水搅成小疙瘩，锅内烧开水后下入面疙瘩煮熟</li>\n        <li>向锅中加入肉松，水开后加入青菜碎再煮片刻即可</li>\n      </ol>\n    </div>\n\n    <div class=\"recipe-block\">\n      <div class=\"recipe-title\">食谱二：香菇肉丸汤</div>\n      <div class=\"recipe-sub\">用料：</div>\n      <div class=\"recipe-text\">香菇、猪肉</div>\n      <div class=\"recipe-sub\">做法：</div>\n      <ol class=\"steps\">\n        <li>猪肉洗净剁碎与香菇末混合搅拌成肉泥，加入适量水制成小丸子</li>\n        <li>[illegible]</li>\n      </ol>\n    </div>\n\n    <div class=\"recipe-block\">\n      <div class=\"recipe-title\">食谱三：排骨烧萝卜</div>\n      <div class=\"recipe-sub\">用料：</div>\n      <div class=\"recipe-text\">排骨、萝卜、姜、食用油</div>\n      <div class=\"recipe-sub\">做法：</div>\n      <ol class=\"steps\">\n        <li>萝卜洗净切成小块，姜切片，排骨洗净焯水去血水</li>\n        <li>热锅倒油将排骨姜片炒香，加入水煮沸后转小火炖煮</li>\n        <li>加入萝卜块炖煮至软烂，加入少许调味即可（幼儿不加盐）</li>\n      </ol>\n    </div>\n\n    <div class=\"recipe-block\">\n      <div class=\"recipe-title\">食谱四：紫薯羹</div>\n      <div class=\"recipe-sub\">用料：</div>\n      <div class=\"recipe-text\">紫薯、婴儿营养米粉</div>\n      <div class=\"recipe-sub\">做法：</div>\n      <ol class=\"steps\">\n        <li>紫薯洗净去皮切小块，蒸熟后压成泥</li>\n        <li>将紫薯泥和米粉按适量比例混合均匀，加入适量温水搅拌成糊状即可</li>\n      </ol>\n    </div>\n  </div>\n\n</div>\n</body>\n</html>"
