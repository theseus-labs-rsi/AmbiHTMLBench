gin-top: 30px;\n  }\n  /* RIGHT COLUMN */\n  .right-col {\n    display: flex;\n    flex-direction: column;\n  }\n  .apa-itu-row {\n    display: flex;\n    align-items: flex-start;\n    gap: 20px;\n  }\n  .man-placeholder {\n    width: 250px;\n    height: 300px;\n    flex-shrink: 0;\n    font-size: 16px;\n  }\n  .apa-itu-text {\n    display: flex;\n    flex-direction: column;\n    gap: 15px;\n  }\n  .apa-itu-title {\n    color: #f5d13a;\n    font-size: 30px;\n    font-weight: bold;\n    line-height: 1.2;\n  }\n  .apa-itu-desc {\n    font-size: 18px;\n    line-height: 1.4;\n    color: #fff;\n  }\n  .apa-itu-desc p { margin: 10px 0; }\n\n  .section-heading {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    margin-top: 25px;\n    margin-bottom: 15px;\n  }\n  .bullet-dot {\n    width: 22px;\n    height: 22px;\n    border-radius: 50%;\n    background: #fff;\n    flex-shrink: 0;\n  }\n  .section-heading span {\n    font-size: 26px;\n    font-weight: bold;\n  }\n  .icon-row {\n    display: flex;\n    justify-content: space-between;\n    gap: 15px;\n  }\n  .icon-item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    width: 24%;\n  }\n  .icon-placeholder {\n    width: 100%;\n    height: 160px;\n    font-size: 14px;\n    border-color: #f5d13a;\n  }\n  .icon-label {\n    margin-top: 10px;\n    font-size: 20px;\n    font-weight: bold;\n    text-align: center;\n  }\n\n  /* TIMELINE SECTION */\n  .timeline-header {\n    display: flex;\n    justify-content: flex-end;\n    padding: 20px 40px 0;\n  }\n  .timeline-pill {\n    border: 2px solid #fff;\n    border-radius: 30px;\n    padding: 10px 30px;\n    font-size: 28px;\n    font-weight: bold;\n  }\n  .timeline-section {\n    display: flex;\n    align-items: flex-start;\n    padding: 0 40px;\n    margin-top: 10px;\n    gap: 20px;\n  }\n  .people-placeholder {\n    width: 480px;\n    height: 260px;\n    flex-shrink: 0;\n    margin-top: 40px;\n    font-size: 16px;\n  }\n  .timeline-track {\n    flex: 1;\n    position: relative;\n    border-top: 2px dashed #f5d13a;\n    padding-top: 15px;\n    margin-top: 10px;\n  }\n  .timeline-dates-top, .timeline-dates-bottom {\n    display: flex;\n    justify-content: space-between;\n  }\n  .timeline-dates-top div, .timeline-dates-bottom div {\n    font-size: 13px;\n    text-align: center;\n    width: 5%;\n    line-height: 1.3;\n  }\n  .timeline-numbers {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin: 10px 0;\n  }\n  .tnum {\n    width: 26px;\n    height: 26px;\n    border-radius: 50%;\n    border: 2px solid #f5d13a;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 13px;\n    background: #0d1a8c;\n  }\n  .tnum.last {\n    background: #f5d13a;\n    color: #0d1a8c;\n    border-color: #f5d13a;\n  }\n  .timeline-line {\n    height: 2px;\n    background: #f5d13a;\n    position: relative;\n    top: -13px;\n    z-index: -1;\n  }\n\n  .footer-bar {\n    background: #f5d13a;\n    color: #0d1a8c;\n    font-weight: bold;\n    font-size: 16px;\n    text-align: center;\n    padding: 12px 0;\n    margin-top: 30px;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <h1 class=\"title\">Hubungan perdagangan <b>Uni Eropa - Indonesia</b></h1>\n\n  <div class=\"main-grid\">\n\n    <!-- LEFT COLUMN -->\n    <div class=\"left-col\">\n      <div class=\"placeholder handshake-placeholder\">\n        [Illustration: Handshake between hand with Indonesian flag sleeve and hand with EU stars background]\n      </div>\n\n      <div class=\"left-text\">\n        <p><b>Indonesia</b> dan <b>Uni Eropa</b> pada Selasa (23/9) meneken perjanjian kemitraan ekonomi komprehensif yang meliputi perdagangan barang serta jasa, investasi, perlindungan lingkungan, dan keberlanjutan.</p>\n        <p>Diinisiasi sejak 2016, kesepakatan ini baru mencapai kesepakatan sembilan tahun kemudian, setelah melalui setidaknya 17 pertemuan.</p>\n      </div>\n\n      <div class=\"quote-box\">\n        Menteri Koordinator Bidang Perekonomian Airlangga Hartarto menyebut perjanjian itu berpotensi meningkatkan ekonomi Indonesia hingga USD 2,8 Miliar\n      </div>\n    </div>\n\n    <!-- RIGHT COLUMN -->\n    <div class=\"right-col\">\n      <div class=\"apa-itu-row\">\n        <div class=\"placeholder man-placeholder\">\n          [Illustration: Man in yellow blazer pointing]\n        </div>\n        <div class=\"apa-itu-text\">\n          <div class=\"apa-itu-title\">Apa itu<br>IEU-CEPA?</div>\n          <div class=\"apa-itu-desc\">\n            <p>IEU-CEPA merupakan perjanjian kemitraan ekonomi komprehensif antara Indonesia dan Uni Eropa yang mencakup perdagangan barang dan jasa, investasi, hingga ekonomi berkelanjutan.</p>\n            <p>Lewat kerja sama ini, produk-produk ekspor Indonesia akan menikmati tarif nol persen di 90,4% pasar Uni Eropa, termasuk komoditas unggulan seperti sawit, teksil, alas kaki, produk perikanan, dan bahan baku energi terbarukan.</p>\n            <p>Perjanjian ini juga membuka akses bagi investor asal Uni Eropa untuk menanamkan modal di Indonesia sehingga berpotensi menciptakan lapangan kerja baru.</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"section-heading\">\n        <div class=\"bullet-dot\"></div>\n        <span>Ekspor utama Indonesia ke Uni Eropa</span>\n      </div>\n      <div class=\"icon-row\">\n        <div class=\"icon-item\">\n          <div class=\"placeholder icon-placeholder\">[Icon: Perkebunan / cocoa beans]</div>\n          <div class=\"icon-label\">Perkebunan</div>\n        </div>\n        <div class=\"icon-item\">\n          <div class=\"placeholder icon-placeholder\">[Icon: Tekstil / folded fabric]</div>\n          <div class=\"icon-label\">Tekstil</div>\n        </div>\n        <div class=\"icon-item\">\n          <div class=\"placeholder icon-placeholder\">[Icon: Mineral / rock]</div>\n          <div class=\"icon-label\">Mineral</div>\n        </div>\n        <div class=\"icon-item\">\n          <div class=\"placeholder icon-placeholder\">[Icon: Minyak Sawit / palm oil bottle and fruit]</div>\n          <div class=\"icon-label\">Minyak Sawit</div>\n        </div>\n      </div>\n\n      <div class=\"section-heading\">\n        <div class=\"bullet-dot\"></div>\n        <span>Ekspor utama Uni Eropa ke Indonesia</span>\n      </div>\n      <div class=\"icon-row\">\n        <div class=\"icon-item\">\n          <div class=\"placeholder icon-placeholder\">[Icon: Alat Transportasi / airplane]</div>\n          <div class=\"icon-label\">Alat Transportasi</div>\n        </div>\n        <div class=\"icon-item\">\n          <div class=\"placeholder icon-placeholder\">[Icon: Produk Farmasi / pills]</div>\n          <div class=\"icon-label\">Produk Farmasi</div>\n        </div>\n        <div class=\"icon-item\">\n          <div class=\"placeholder icon-placeholder\">[Icon: Bahan Kimia / flasks]</div>\n          <div class=\"icon-label\">Bahan Kimia</div>\n        </div>\n        <div class=\"icon-item\">\n          <div class=\"placeholder icon-placeholder\">[Icon: Mesin Industri / excavator]</div>\n          <div class=\"icon-label\">Mesin Industri</div>\n        </div>\n      </div>\n    </div>\n\n  </div>\n\n  <!-- TIMELINE HEADER -->\n  <div class=\"timeline-header\">\n    <div class=\"timeline-pill\">Linimasa IEU-CEPA</div>\n  </div>\n\n  <!-- TIMELINE SECTION -->\n  <div class=\"timeline-section\">\n    <div class=\"placeholder people-placeholder\">\n      [Illustration: Three people sitting at table with documents]\n    </div>\n\n    <div class=\"timeline-track\">\n      <div class=\"timeline-dates-top\">\n        <div>20-21 Sep 2016, Brussels</div>\n        <div>11-15 Sep 2017, Brussels</div>\n        <div>9-13 Jul 2018, Brussels</div>\n        <div>11-15 Mar 2019, Brussels</div>\n        <div>2-6 Des 2019, Brussels</div>\n        <div>8-12 Nov 2021, Virtual</div>\n        <div>6-13 Feb 2023, Bali</div>\n        <div>10-