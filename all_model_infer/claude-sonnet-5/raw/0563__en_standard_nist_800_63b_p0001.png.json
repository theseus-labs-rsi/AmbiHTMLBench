        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Withdrawn NIST Technical Series Publication</title>\n<script type=\"text/javascript\" id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n    body {\n        font-family: 'Segoe UI', Arial, sans-serif;\n        margin: 0;\n        padding: 40px 60px;\n        color: #000;\n        font-size: 15px;\n    }\n\n    .title-box {\n        border: 2px solid #000;\n        padding: 15px;\n        text-align: center;\n        margin-bottom: 30px;\n    }\n\n    .title-box h1 {\n        font-size: 32px;\n        margin: 10px 0;\n        font-weight: bold;\n    }\n\n    .content-box {\n        border: 2px solid #000;\n    }\n\n    .warning-header {\n        text-align: center;\n        font-weight: bold;\n        padding: 15px 15px 0 15px;\n    }\n\n    .warning-text {\n        padding: 5px 15px 20px 15px;\n        line-height: 1.5;\n    }\n\n    table {\n        width: 100%;\n        border-collapse: collapse;\n    }\n\n    .section-header td {\n        background-color: #d9d9d9;\n        font-weight: bold;\n        padding: 8px 15px;\n        border-top: 1px solid #000;\n        border-bottom: 1px solid #000;\n    }\n\n    .sub-note {\n        padding: 10px 15px;\n        border-bottom: 1px solid #000;\n    }\n\n    td.label {\n        width: 25%;\n        font-weight: bold;\n        vertical-align: top;\n        padding: 8px 15px;\n        border-bottom: 1px solid #000;\n        border-right: 1px solid #000;\n    }\n\n    td.value {\n        width: 75%;\n        vertical-align: top;\n        padding: 8px 15px;\n        border-bottom: 1px solid #000;\n    }\n\n    tr:last-child td {\n        border-bottom: none;\n    }\n\n    a {\n        color: #0563C1;\n        text-decoration: underline;\n    }\n\n    .footer {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        margin-top: 60px;\n    }\n\n    .footer-date {\n        font-size: 15px;\n        margin-top: 60px;\n    }\n\n    .nist-logo {\n        display: flex;\n        align-items: center;\n        gap: 10px;\n        margin-top: 40px;\n    }\n\n    .nist-logo-text {\n        font-size: 44px;\n        font-weight: 900;\n        letter-spacing: -2px;\n    }\n\n    .nist-logo-caption {\n        font-size: 11px;\n        line-height: 1.3;\n        color: #333;\n    }\n\n    .nist-logo-caption .main {\n        font-weight: bold;\n        color: #1a1a1a;\n        font-size: 12px;\n    }\n</style>\n</head>\n<body>\n\n    <div class=\"title-box\">\n        <h1>Withdrawn NIST Technical Series Publication</h1>\n    </div>\n\n    <div class=\"content-box\">\n        <div class=\"warning-header\">Warning Notice</div>\n        <div class=\"warning-text\">\n            The attached publication has been withdrawn (archived), and is provided solely for historical purposes.\n            It may have been superseded by another publication (indicated below).\n        </div>\n\n        <table>\n            <tr class=\"section-header\">\n                <td colspan=\"2\">Withdrawn Publication</td>\n            </tr>\n            <tr>\n                <td class=\"label\">Series/Number</td>\n                <td class=\"value\">NIST Special Publication 800-63B</td>\n            </tr>\n            <tr>\n                <td class=\"label\">Title</td>\n                <td class=\"value\">Digital Identity Guidelines: Authentication and Lifecycle Management</td>\n            </tr>\n            <tr>\n                <td class=\"label\">Publication Date(s)</td>\n                <td class=\"value\">June 2017 (includes updates as of 03-02-2020)</td>\n            </tr>\n            <tr>\n                <td class=\"label\">Withdrawal Date</td>\n                <td class=\"value\">August 1, 2025</td>\n            </tr>\n            <tr>\n                <td class=\"label\">Withdrawal Note</td>\n                <td class=\"value\">NIST SP 800-63B is withdrawn and superseded in its entirety by NIST SP 800-63B-4.</td>\n            </tr>\n\n            <tr class=\"section-header\">\n                <td colspan=\"2\">Superseding Publication(s) <i>(if applicable)</i></td>\n            </tr>\n            <tr>\n                <td colspan=\"2\" class=\"sub-note\">The attached publication has been <strong>superseded by</strong> the following publication(s):</td>\n            </tr>\n            <tr>\n                <td class=\"label\">Series/Number</td>\n                <td class=\"value\">NIST SP 800-63B-4</td>\n            </tr>\n            <tr>\n                <td class=\"label\">Title</td>\n                <td class=\"value\">Digital Identity Guidelines: Authentication and Authenticator Management</td>\n            </tr>\n            <tr>\n                <td class=\"label\">Author(s)</td>\n                <td class=\"value\">David Temoshok, et al.</td>\n            </tr>\n            <tr>\n                <td class=\"label\">Publication Date(s)</td>\n                <td class=\"value\">July 2025</td>\n            </tr>\n            <tr>\n                <td class=\"label\">URL/DOI</td>\n                <td class=\"value\"><a href=\"https://doi.org/10.6028/NIST.SP.800-63B-4\">https://doi.org/10.6028/NIST.SP.800-63B-4</a></td>\n            </tr>\n\n            <tr class=\"section-header\">\n                <td colspan=\"2\">Additional Information <i>(if applicable)</i></td>\n            </tr>\n            <tr>\n                <td class=\"label\">Contact</td>\n                <td class=\"value\">Applied Cybersecurity Division (Information Technology Laboratory)</td>\n            </tr>\n            <tr>\n                <td class=\"label\">Latest revision of the attached publication</td>\n                <td class=\"value\">&nbsp;</td>\n            </tr>\n            <tr>\n                <td class=