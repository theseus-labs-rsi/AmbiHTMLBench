idth: 500px;\n    height: 470px;\n    background: #fbfbf8;\n    transform: rotate(6deg);\n    transform-origin: top left;\n    box-shadow: 0 4px 10px rgba(0,0,0,0.25);\n    padding: 18px 20px;\n    box-sizing: border-box;\n  }\n  .printed-block {\n    display: flex;\n    align-items: flex-start;\n    gap: 10px;\n    margin-bottom: 14px;\n  }\n  .question-number {\n    font-size: 26px;\n    font-weight: bold;\n    color: #222;\n    line-height: 1.3;\n    min-width: 30px;\n  }\n  .printed-text {\n    font-size: 14px;\n    color: #222;\n    line-height: 1.9;\n  }\n  .handwritten-block {\n    font-family: \"STXingkai\", \"Comic Sans MS\", cursive, sans-serif;\n    font-size: 26px;\n    color: #1a1a2e;\n    line-height: 1.55;\n    margin-top: 6px;\n    white-space: pre-wrap;\n    word-break: break-all;\n  }\n  /* faint printed column visible on far right edge of the underlying page */\n  .right-edge-hint {\n    position: absolute;\n    top: 250px;\n    right: 4px;\n    font-size: 9px;\n    color: rgba(60,60,30,0.4);\n    line-height: 2;\n    writing-mode: vertical-rl;\n  }\n  .placeholder {\n    border: 1px dashed rgba(0,0,0,0.2);\n    color: rgba(0,0,0,0.4);\n    font-size: 10px;\n    text-align: center;\n  }\n</style>\n</head>\n<body>\n\n<div class=\"photo-frame\">\n  <div class=\"wood-texture\"></div>\n  <div class=\"light-shadow\"></div>\n\n  <!-- yellow paper glimpsed underneath, mostly obscured -->\n  <div class=\"yellow-strip\">\n    <div class=\"faint-text\">[illegible]</div>\n  </div>\n\n  <!-- faint vertical hint of text from the page beneath, barely visible at right edge -->\n  <div class=\"right-edge-hint\">[illegible]</div>\n\n  <!-- main handwritten note -->\n  <div class=\"note-paper\">\n    <div class=\"printed-block\">\n      <div class=\"question-number\">26</div>\n      <div class=\"printed-text\">\n        你的女儿在国家展览馆上看到了某样让她十分不舒服的东西。<br>\n        她看到了什么呢？\n      </div>\n    </div>\n\n    <div class=\"handwritten-block\">我蹲下来，\"这根肋骨让你感<br>到不舒服吗？\"<br>展