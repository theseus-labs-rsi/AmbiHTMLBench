size: 17px;\n    font-weight: bold;\n    letter-spacing: 3px;\n    color: #7a2e35;\n  }\n  .col.fields {\n    font-size: 13.5px;\n  }\n  .col.fields .label {\n    font-weight: bold;\n  }\n  .highlight {\n    background: rgba(107,63,160,0.15);\n    text-decoration: underline;\n    text-decoration-color: #6b3fa0;\n  }\n  .top-icon {\n    position: absolute;\n    top: 6px;\n    right: 12px;\n    width: 20px;\n    height: 20px;\n    border: 2px solid #7a2e35;\n    border-radius: 3px;\n  }\n</style>\n</head>\n<body>\n\n<div class=\"page\">\n  <div class=\"gutter-shadow\"></div>\n  <div class=\"top-icon\" title=\"[icon]\"></div>\n\n  <div class=\"content-row\">\n\n    <!-- LEFT SIDEBAR -->\n    <div class=\"sidebar\">\n      <div class=\"icon-circle\">⊚</div>\n      <div class=\"sidebar-title\">人物扫描</div>\n      <div class=\"sidebar-text\">\n        乔达摩·悉达多，古印度迦毗罗卫国王子，后被尊称为\"释迦牟尼\"，是佛教的创始人。[illegible][illegible][illegible][illegible]\n      </div>\n      <div class=\"placeholder photo\">[Photo: 蓝灰色调佛塔/佛像图片，位于左下角]</div>\n    </div>\n\n    <!-- MIDDLE PURPLE ANNOTATIONS -->\n    <div class=\"middle-annotations\">\n      <div class=\"anno-india\">印度</div>\n      <div class=\"anno-mark\">③</div>\n      <div class=\"anno-note\">[illegible][illegible][illegible][illegible][illegible]</div>\n    </div>\n\n    <!-- QUESTION BLOCK -->\n    <div class=\"question-block\">\n      <div class=\"icon-circle\" style=\"margin-left:8px;\">?</div>\n      <div class=\"question-text\">\n        问题思考<br><br>\n        古代印度的佛教艺术为什么会对[illegible]产生如此深远的影响？[illegible][illegible][illegible][illegible]\n      </div>\n    </div>\n\n    <!-- MAIN TEXT AREA (columns read right to left) -->\n    <div class=\"main-text-area\">\n\n      <div class=\"col heading\">\n        释迦牟尼<br>创立佛教\n      </div>\n\n      <div class=\"col fields\">\n        <span class=\"label\">创始人：</span>乔达摩·悉达多<br><br>\n        <span class=\"label\">时间：</span>公元前6世纪\n      </div>\n\n      <div class=\"col paragraph\">\n        佛教创立于公元前6世纪。创始人为乔达摩·悉达多，后来被称为<span class=\"highlight\">\"释迦牟尼\"</span>。佛教反对婆罗门第一等级的特权，提出<span class=\"highlight\">\"众生平等\"</span>，不拒绝低种姓的人入教；同时，佛教主张忍耐顺从，得到国王和一些富人的支持，信奉佛教的民众日益增多。\n      </div>\n\n      <div class=\"col paragraph\">\n        公元前3世纪后，佛教开始向外传播。公元1世纪前后，佛教经中亚传入我国新疆地区，之后不久又传到中原地区。此后，佛教又传到朝鲜、日本和东南亚国家，逐渐发展成为世界性宗教。\n      </div>\n\n    </div>\n\n  </div>\n</div>\n\n</body>\n</html>"
