: 1.15;\n    padding: 0.5em;\n  }\n  .badge b { font-size: 2.1em; display: block; }\n\n  /* Heart section */\n  .heart-wrap {\n    left: 10%; top: 25.5%;\n    width: 80%;\n    height: 42%;\n  }\n  .heart-svg { position: absolute; left: 12%; top: 0; width: 76%; height: 100%; }\n\n  .center-text {\n    left: 27%; top: 34%;\n    width: 46%;\n    text-align: center;\n    color: #7a2f8a;\n    font-size: 2.6vw;\n    font-weight: 600;\n    line-height: 1.15;\n    z-index: 5;\n  }\n  .logo {\n    left: 38%; top: 45%;\n    width: 24%;\n    z-index: 5;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .logo svg { width: 100%; }\n\n  .label {\n    font-family: Arial, sans-serif;\n    font-size: 0.95vw;\n    line-height: 1.2;\n    z-index: 5;\n  }\n  .label.strong { font-weight: 700; color: #fff; }\n  .label.light { font-weight: 400; color: #b9b6c2; }\n  .label.right { text-align: right; }\n\n  .dot {\n    width: 14px;\n    height: 14px;\n    border-radius: 50%;\n    background: #211f2e;\n    border: 2px solid #ddd;\n    z-index: 6;\n  }\n\n  /* Photos */\n  .photos {\n    left: 7.9%; top: 68%;\n    width: 84.2%;\n    height: 13.7%;\n    display: flex;\n    justify-content: space-between;\n  }\n  .placeholder {\n    width: 30.5%;\n    height: 100%;\n    background: #3a3846;\n    border: 3px solid #8f9aa3;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    font-family: Arial, sans-serif;\n    font-size: 0.8vw;\n    color: #cfcfd6;\n    padding: 4px;\n  }\n\n  /* Footer */\n  .find-more {\n    left: 0; top: 83.5%;\n    width: 100%;\n    text-align: center;\n    font-size: 1.8vw;\n    color: #fff;\n  }\n  .url {\n    left: 0; top: 87.3%;\n    width: 100%;\n    text-align: center;\n    font-size: 3.2vw;\n    font-weight: 700;\n    color: #6cae2d;\n  }\n  .iq-locations {\n    left: 0; top: 92.5%;\n    width: 100%;\n    text-align: center;\n    font-size: 1.5vw;\n    font-weight: 700;\n    color: