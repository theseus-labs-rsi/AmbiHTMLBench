</div>\n    <div class=\"entry\"><span class=\"phrase\">go wrong</span> <span class=\"meaning\">有故障;误入歧途</span></div>\n\n    <div class=\"section-header\">have 短语</div>\n    <div class=\"entry\"><span class=\"phrase\">have a gift for</span> <span class=\"meaning\">有...的天赋</span></div>\n    <div class=\"entry\"><span class=\"phrase\">have a go/try</span> <span class=\"meaning\">试一试</span></div>\n    <div class=\"entry\"><span class=\"phrase\">have a good/great time</span><br><span class=\"meaning\">过得愉快</span></div>\n    <div class=\"entry\"><span class=\"phrase\">have a population of...</span><br><span class=\"meaning\">有...人口</span></div>\n    <div class=\"entry\"><span class=\"phrase\">have affection for</span> <span class=\"meaning\">喜爱,钟爱</span></div>\n    <div class=\"entry\"><span class=\"phrase\">have an effect on/upon</span><br><span class=\"meaning\">对...有影响</span></div>\n    <div class=\"entry\"><span class=\"phrase\">have difficulty (in) doing sth</span><br><span class=\"meaning\">做某事有困难</span></div>\n    <div class=\"entry\"><span class=\"phrase\">have fun with/doing sth</span> <span class=\"meaning\">乐于做某事</span></div>\n    <div class=\"entry\"><span class=\"phrase\">have...in common</span><br><span class=\"meaning\">有相同的特点</span></div>\n    <div class=\"entry\"><span class=\"phrase\">have/gain access to</span><br><span class=\"meaning\">近...的机会</span></div>\n    <div class=\"entry\"><span class=\"phrase\">have nothing to do with</span><br><span class=\"meaning\">与...无关</span></div>\n    <div class=\"entry\"><span class=\"phrase\">have a preference for</span> <span class=\"meaning\">偏爱</span></div>\n\n    <div class=\"section-header gray\">leave 短语</div>\n    <div class=\"entry\"><span class=\"phrase\">leave aside</span> <span class=\"meaning\">暂不考虑，搁置一边</span></div>\n    <div class=\"entry\"><span class=\"phrase\">leave behind</span> <span class=\"meaning\">留下;忘带</span></div>\n    <div class=\"entry\"><span class=\"phrase\">leave for</span> <span class=\"meaning\">出发去某地</span></div>\n  </div>\n\n  <!-- Column 2 -->\n  <div class=\"column\">\n    <div class=\"entry\"><span class=\"phrase\">leave off</span> <span class=\"meaning\">停止，中断</span></div>\n    <div class=\"entry\"><span class=\"phrase\">leave office</span> <span class=\"meaning\">离职</span></div>\n    <div class=\"entry\"><span class=\"phrase\">leave out</span> <span class=\"meaning\">遗漏；不考虑，忽略</span></div>\n    <div class=\"entry\"><span class=\"phrase\">leave school</span> <span class=\"meaning\">退学，离校</span></div>\n    <div class=\"entry\"><span class=\"phrase\">leave alone</span> <span class=\"meaning\">不理，不涉</span></div>\n\n    <div class=\"section-header\">look 短语</div>\n    <div class=\"entry\"><span class=\"phrase\">look about</span> <span class=\"meaning\">四下环顾；查看</span></div>\n    <div class=\"entry\"><span class=\"phrase\">look after</span> <span class=\"meaning\">照顾，看管</span></div>\n    <div class=\"entry\"><span class=\"phrase\">look ahead</span> <span class=\"meaning\">为将来打算</span></div>\n    <div class=\"entry\"><span class=\"phrase\">look around for</span> <span class=\"meaning\">四处寻找</span></div>\n    <div class=\"entry\"><span class=\"phrase\">look away from</span> <span class=\"meaning\">把目光移开</span></div>\n    <div class=\"entry\"><span class=\"phrase\">look back</span> <span class=\"meaning\">回顾，回头看</span></div>\n    <div class=\"entry\"><span class=\"phrase\">look back on/upon</span> <span class=\"meaning\">回顾</span></div>\n    <div class=\"entry\"><span class=\"phrase\">look down on/upon</span> <span class=\"meaning\">蔑视</span></div>\n    <div class=\"entry\"><span class=\"phrase\">look for</span> <span class=\"meaning\">寻找</span></div>\n    <div class=\"entry\"><span class=\"phrase\">look forward to</span> <span class=\"meaning\">盼望；期待</span></div>\n    <div class=\"entry\"><span class=\"phrase\">look into</span> <span class=\"meaning\">向...里面看；调查</span></div>\n    <div class=\"entry\"><span class=\"phrase\">look on/upon...as</span