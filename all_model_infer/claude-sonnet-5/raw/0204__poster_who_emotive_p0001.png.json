        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Detect and Treat Postpartum Haemorrhage Early</title>\n<script>\nwindow.MathJax = { tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] } };\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\" async></script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    font-family: 'Segoe UI', Arial, sans-serif;\n    background: #e2f0f1;\n    color: #1b2a63;\n  }\n  .page {\n    max-width: 1400px;\n    margin: 0 auto;\n    padding: 30px 50px 40px 50px;\n    position: relative;\n    overflow: hidden;\n  }\n  .clouds {\n    position: absolute;\n    top: 10px;\n    right: 20px;\n    font-size: 40px;\n    color: #cde7ea;\n    z-index: 0;\n  }\n  .header {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    margin-bottom: 40px;\n    position: relative;\n    z-index: 1;\n  }\n  .badge {\n    border: 2px solid #1b2a63;\n    border-radius: 30px;\n    padding: 10px 28px;\n    font-size: 34px;\n    font-weight: 800;\n    color: #5b2e91;\n    background: #fff;\n    letter-spacing: 1px;\n  }\n  .and-text {\n    font-size: 18px;\n    letter-spacing: 3px;\n    color: #1b2a63;\n    font-weight: 600;\n  }\n  .title-text {\n    font-size: 32px;\n    letter-spacing: 4px;\n    color: #1b2a63;\n    font-weight: 400;\n  }\n\n  .letters-row {\n    display: grid;\n    grid-template-columns: 1fr 1fr 1fr 1fr 1fr 1fr;\n    align-items: end;\n    position: relative;\n    margin-bottom: 10px;\n  }\n  .letter {\n    text-align: center;\n    font-size: 50px;\n    font-weight: 800;\n    color: #5b2e91;\n    position: relative;\n    z-index: 2;\n  }\n  .letter.shift-up { margin-bottom: 40px; }\n  .letter.shift-down { margin-bottom: 0; }\n\n  .wave-band {\n    position: relative;\n    height: 90px;\n    margin: 0 -10px 20px -10px;\n  }\n  .wave-svg {\n    width: 100%;\n    height: 90px;\n    display: block;\n  }\n  .icons-row {\n    display: grid;\n    grid-template-columns: 1fr 1fr 1fr 1fr 1fr 1fr;\n    position: absolute;\n    top: -55px;\n    left: 0;\n    width: 100%;\n  }\n  .icon-col {\n    display: flex;\n    justify-content: center;\n  }\n  .icon-circle {\n    width: 90px;\n    height: 90px;\n    border-radius: 50%;\n    background: #6fc9ca;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 34px;\n    color: #fff;\n    border: 4px solid #e2f0f1;\n  }\n\n  .content-row {\n    display: grid;\n    grid-template-columns: 1fr 1fr 1fr 1fr 1fr 1fr;\n    gap: 14px;\n    align-items: start;\n    margin-top: 10px;\n  }\n  .col {\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n  }\n  .label-box {\n    border: 2px solid #1b2a63;\n    border-radius: 20px;\n    padding: 8px 16px;\n    font-weight: 700;\n    font-size: 15px;\n    background: #fff;\n    display: inline-block;\n    width: fit-content;\n  }\n  .label-box .cap {\n    color: #5b2e91;\n  }\n  .col ul {\n    margin: 4px 0 0 0;\n    padding-left: 16px;\n    font-size: 13.5px;\n    line-height: 1.5;\n  }\n  .col ul li {\n    margin-bottom: 8px;\n  }\n  .hl {\n    background: #cfe7e8;\n    font-weight: 700;\n  }\n  .divider {\n    border-left: 1px solid #1b2a63;\n    height: 100%;\n    margin: 0 auto;\n  }\n\n  .lower-section {\n    display: grid;\n    grid-template-columns: 340px 1fr;\n    gap: 20px;\n    margin-top: 30px;\n  }\n\n  .left-panel {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n  }\n  .trigger-title {\n    border: 2px solid #1b2a63;\n    border-radius: 20px;\n    padding: 6px 18px;\n    font-weight: 700;\n    font-size: 15px;\n    background: #fff;\n    width: fit-content;\n  }\n  .trigger-list {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n    font-size: 14px;\n    line-height: 1.5;\n  }\n  .trigger-list li {\n    margin-bottom: 8px;\n    padding-left: 22px;\n    position: relative;\n  }\n  .trigger-list .num {\n    position: absolute;\n    left: 0;\n    font-weight: 700;\n    color: #5b2e91;\n  }\n  .who-logo {\n    margin-top: 20px;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 11px;\n    color: #1b2a63;\n  }\n  .who-logo img {\n    display: none;\n  }\n  .who-block {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n  .who-circle {\n    width: 40px;\n    height: 40px;\n    border: 2px solid #1b2a63;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 9px;\n    font-weight: 700;\n    text-align: center;\n  }\n  .who-text {\n    font-weight: 700;\n    font-size: 13px;\n    line-height: 1.1;\n  }\n  .hrp-text {\n    font-size: 10px;\n    line-height: 1.2;\n  }\n\n  .impl-box {\n    border: 2px solid #1b2a63;\n    border-radius: 16px;\n    padding: 20px 30px;\n    background: #f4fafa;\n  }\n  .impl-title {\n    font-size: 20px;\n    font-weight: 700;\n    color: #5b2e91;\n    margin-bottom: 16px;\n  }\n  .impl-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 20px 40px;\n  }\n  .impl-item {\n    display: flex;\n    gap: 16px;\n    align-items: flex-start;\n    font-size: 13.5px;\n    line-height: 1.5;\n  }\n  .impl-icon {\n    width: 55px;\n    height: 55px;\n    flex-shrink: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 30px;\n  }\n  .impl-text b {\n    color: #1b2a63;\n  }\n\n  .placeholder {\n    background: #f0f0f0;\n    border: 1px dashed #999;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #777;\n    font-size: 11px;\n    text-align: center;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <div class=\"clouds\">☁ ☁</div>\n\n  <div class=\"header\">\n    <div class=\"badge\">DETECT</div>\n    <div class=\"and-text\">AND</div>\n    <div class=\"badge\">TREAT</div>\n    <div class=\"title-text\">POSTPARTUM HAEMORRHAGE EARLY</div>\n  </div>\n\n  <!-- Letters row -->\n  <div class=\"letters-row\">\n    <div class=\"letter shift-up\">E</div>\n    <div class=\"letter shift-down\">M</div>\n    <div class=\"letter shift-down\" style=\"margin-bottom:60px;\">O</div>\n    <div class=\"letter shift-down\" style=\"margin-bottom:60px;\">T</div>\n    <div class=\"letter shift-down\">IV</div>\n    <div class=\"letter shift-up\">E</div>\n  </div>\n\n  <!-- Wave band with icons -->\n  <div class=\"wave-band\">\n    <svg class=\"wave-svg\" viewBox=\"0 0 1200 90\" preserveAspectRatio=\"none\">\n      <path d=\"M0,10 C100,10 100,70 200,70 C300,70 300,10 400,10 C500,10 500,70 600,70 C700,70 700,10 800,10 C900,10 900,70 1000,70 C1100,70 1100,10 1200,10 L1200,40 C1100,40 1100,100 1000,100 C900,100 900,40 800,40 C700,40 700,100 600,100 C500,100 500,40 400,40 C300,40 300,100 200,100 C100,100 100,40 0,40 Z\" fill=\"#ffffff\"/>\n    </svg>\n    <div class=\"icons-row\">\n      <div class=\"icon-col\"><div class=\"icon-circle\">🩸</div></div>\n      <div class=\"icon-col\"><div class=\"icon-circle\">🖐</div></div>\n      <div class=\"icon-col\"><div class=\"icon-circle\">💉</div></div>\n      <div class=\"icon-col\"><div class=\"icon-circle\">💉</div></div>\n      <div class=\"icon-col\"><div class=\"icon-circle\">🩹</div></div>\n      <div class=\"icon-col\"><div class=\"icon-circle\">🔍</div></div>\n    </div>\n  </div>\n\n  <!-- Content row -->\n  <div class=\"content-row\">\n    <div class=\"col\">\n      <div class=\"label-box\"><span class=\"cap\">E</span>arly detection<br>and trigger criteria</div>\n      <ul>\n        <li>Calibrated drape for blood loss collection with trigger lines at <span class=\"hl\">300ml and 500ml</span> for the first hour after birth</li>\n        <li>Observations (blood loss, blood flow, uterine tone) every <span class=\"hl\">15 minutes</span> documented on the blood loss monitoring chart</li>\n        <li>Blood pressure and pulse carried out once in the <span class=\"hl\">1st hour</span> postpartum and documented on the blood loss monitoring chart</li>\n      </ul>\n    </div>\n\n    <div class=\"col\">\n      <div class=\"label-box\"><span class=\"cap\">M</span>assage of uterus</div>\n      <ul>\n        <li>Massage until uterus has contracted or for <span class=\"hl\">one minute</span></li>\n      </ul>\n    </div>\n\n    <div class=\"col\">\n      <div class=\"label-box\"><span class=\"cap\">O</span>xytocic drugs</div>\n      <ul>\n        <li><b>10 IU IV oxytocin injection</b> or diluted in <b>200-500ml crystalloid</b> over <b>10 minutes</b> plus a maintenance dose for <b>20 IU IV oxytcin</b> diluted in <b>1000ml saline</b> over <b>4 hours</b> (+- misoprostol 800mcg PR/SL if used)</li>\n      </ul>\n    </div>\n\n    <div class=\"col\">\n      <div class=\"label-box\"><span class=\"cap\">T</span>ranexamic acid</div>\n      <ul>\n        <li><b>1g IV injection of tranexamic acid</b> or diluted in <b>200ml crystalloid</b> over <b>10 minutes</b></li>\n      </ul>\n    </div>\n\n    <div class=\"col\">\n      <div class=\"label-box\"><span class=\"cap\">IV</span> fluids</div>\n      <ul>\n        <li>IV fluids in addition to the infusion should be given if clinically indicated for resuscitation and will require a <b>2nd IV access</b></li>\n      </ul>\n    </div>\n\n    <div class=\"col\">\n      <div class=\"label-box\"><span class=\"cap\">E</span>xamination<br>and escalation</div>\n      <ul>\n        <li>Ensure bladder is empty, evacuate clots, check for tears with an internal examination and placenta for completeness</li>\n        <li>Escalate if bleeding does not stop after first response or you are unable to identify or manage cause of bleeding</li>\n      </ul>\n    </div>\n  </div>\n\n  <!-- Lower section -->\n  <div class=\"lower-section\">\n    <div class=\"left-panel\">\n      <div class=\"trigger-title\">Trigger criteria</div>\n      <ul class=\"trigger-list\">\n        <li><span class=\"num\">1</span>Clinical judgement</li>\n        <li><span class=\"num\">2</span>Blood loss 500ml or more</li>\n        <li><span class=\"num\">3</span>Blood loss 300ml or more plus one abnormal observation</li>\n      </ul>\n\n      <div class=\"who-block\">\n        <div class=\"who-circle\">WHO</div>\n        <div>\n          <div class=\"who-text\">World Health<br>Organization</div>\n        </div>\n        <div class=\"hrp-text\">human<br>reproduction<br>programme<br><b>hrp</b><br>research for <b>impact</b></div>\n      </div>\n    </div>\n\n    <div class=\"impl-box\">\n      <div class=\"impl-title\">Implementation strategies</div>\n      <div class=\"impl-grid\">\n        <div class=\"impl-item\">\n          <div class=\"impl-icon\">📋</div>\n          <div class=\"impl-text\"><b>Audit newsletters:</b> sharing with all staff monthly detection and bundle use rates along with PPH, severe PPH, blood transfusion, laparotomy and death from PPH rates and given feedback at monthly departmental meetings</div>\n        </div>\n        <div class=\"impl-item\">\n          <div class=\"impl-icon\">🧰</div>\n          <div class=\"impl-text\"><b>Trolley and/or carry case:</b> including all medicines and devices required for the treatment of PPH restocked after every use and complete a stocking checklist at the start of every shift</div>\n        </div>\n        <div class=\"impl-item\">\n          <div class=\"impl-icon\">🏆</div>\n          <div class=\"impl-text\"><b>Champions:</b> midwife and doctor to oversee change, troubleshoot, give feedback on audit newsletters, connect with other champions through chats, meeting and websites for sharing knowledge and lessons learnt</div>\n        </div>\n        <div class=\"impl-item\">\n          <div class=\"impl-icon\">📈</div>\n          <div class=\"impl-text\"><b>Training:</b> on-site, simulation-based, and peer-assisted training of 90 minutes to a whole day facilitated by the use of provider guides, flipcharts and job aids displayed in labour wards</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n</div>\n</body>\n</html>"
