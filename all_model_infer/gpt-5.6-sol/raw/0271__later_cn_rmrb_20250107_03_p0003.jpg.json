        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>人民日报 2025年1月7日 第3版 要闻</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] }\n};\n</script>\n<script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  html, body { margin: 0; padding: 0; background: #e7e7e7; }\n  body {\n    color: #111;\n    font-family: \"Noto Serif SC\", \"Songti SC\", \"SimSun\", serif;\n  }\n  .page {\n    width: 800px;\n    min-height: 907px;\n    margin: 0 auto;\n    padding: 8px 9px 7px;\n    background: #fff;\n    overflow: hidden;\n  }\n  .masthead {\n    height: 31px;\n    display: grid;\n    grid-template-columns: 1fr auto auto auto;\n    align-items: end;\n    gap: 10px;\n    border-bottom: 1px solid #111;\n    padding: 0 2px 3px;\n  }\n  .logo {\n    font-family: \"STKaiti\", \"KaiTi\", serif;\n    font-size: 22px;\n    font-weight: 700;\n    font-style: italic;\n    line-height: 1;\n  }\n  .date, .weekday {\n    font-size: 7px;\n    white-space: nowrap;\n    padding-bottom: 2px;\n  }\n  .page-number {\n    font-family: Arial, sans-serif;\n    font-size: 25px;\n    line-height: .9;\n  }\n  .section-name {\n    font-family: \"SimHei\", sans-serif;\n    font-size: 21px;\n    font-weight: 700;\n    line-height: 1;\n    border: 1px solid #111;\n    border-top: 0;\n    padding: 1px 5px 3px;\n    margin: -5px -2px -4px 0;\n  }\n  .top {\n    display: grid;\n    grid-template-columns: 578px 1fr;\n    gap: 10px;\n    margin-top: 20px;\n  }\n  .lead {\n    padding: 0 13px 0 15px;\n    border-right: 1px solid #222;\n  }\n  .lead h1 {\n    margin: 0;\n    text-align: center;\n    font-family: \"SimHei\", sans-serif;\n    font-size: 37px;\n    line-height: 1.08;\n    letter-spacing: 3px;\n    white-space: nowrap;\n  }\n  .lead h2 {\n    margin: 8px