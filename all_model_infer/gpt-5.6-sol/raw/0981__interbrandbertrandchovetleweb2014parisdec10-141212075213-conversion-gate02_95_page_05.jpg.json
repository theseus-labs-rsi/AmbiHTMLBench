%, #365d18);\n  }\n\n  .photo-responsive {\n    background:\n      radial-gradient(ellipse at 51% 46%, #a7192a 0 9%, transparent 10%),\n      linear-gradient(150deg, #e9f4f8 0 35%, #92b7cb 36% 54%, #edf3f5 55%);\n  }\n\n  .photo-authenticity {\n    background:\n      radial-gradient(circle at 50% 52%, #a60016 0 20%, #d11a32 21% 26%, transparent 27%),\n      radial-gradient(circle at 55% 45%, #d2d4d3 0 42%, transparent 43%),\n      linear-gradient(135deg, #fafafa, #b8b8b8);\n  }\n\n  .photo-relevance {\n    background:\n      radial-gradient(circle at 30% 36%, #f1d5c4 0 15%, transparent 16%),\n      radial-gradient(circle at 70% 38%, #e5b6aa 0 15%, transparent 16%),\n      linear-gradient(110deg, #d7c5ad 0 30%, #f2eeee 31% 62%, #a76865 63%);\n  }\n\n  .photo-differentiation {\n    background:\n      linear-gradient(25deg, transparent 0 31%, #d6a728 32% 47%, transparent 48%),\n      linear-gradient(150deg, #20272d 0 22%, #b8b5a8 23% 43%, #a54235 44% 63%, #30363a 64%);\n  }\n\n  .photo-consistency {\n    background:\n      repeating-linear-gradient(90deg, transparent 0 7px, rgba(245,234,210,.48) 8px 10px),\n      repeating-linear-gradient(25deg, #285d2a 0 6px, #8a2130 7px 12px, #d7c6a6 13px 17px);\n  }\n\n  .photo-presence {\n    background:\n      linear-gradient(90deg, rgba(26,27,38,.65) 0 28%, transparent 29%),\n      linear-gradient(0deg, #33273a 0 31%, transparent 32%),\n      linear-gradient(135deg, #c84f37 0 25%, #1987a7 26% 50%, #d32d3e 51% 72%, #64507c 73%);\n  }\n\n  .photo-understanding {\n    background:\n      radial-gradient(circle at 39% 33%, #e3c3ae 0 11%, transparent 12%),\n      radial-gradient(circle at 68% 41%, #b97967 0 10%, transparent 11%),\n      linear-gradient(145deg, #f0eee7 0 42%, #9e7869 43% 66%, #423d3e 67%);\n  }\n\n  .brandmark {\n    position: absolute;\n    right: 49px;\n    bottom: 25px;\n    color: #e7e7e7;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 20px;\n    line-height: 20px;\n    letter-spacing: -1.1px;\n  }\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <div class=\"canvas\">\n    <p class=\"eyebrow\">BRAND STRENGTH</p>\n    <h1 class=\"headline\">WE MEASURE THE LEVERS FOR SUSTAINABLE DEMAND</h1>\n\n    <section class=\"audience employees\" aria-label=\"Employees, current and prospective\">\n      <div class=\"person\" aria-hidden=\"true\">\n        <div class=\"head\"></div>\n        <div class=\"torso\"></div>\n        <div class=\"arm left\"></div>\n        <div class=\"arm right\"></div>\n        <div class=\"leg left\"></div>\n        <div class=\"leg right\"></div>\n      </div>\n      <div class=\"audience-title\">Employees</div>\n      <div class=\"audience-subtitle\">(Current &amp; Prospective)</div>\n    </section>\n\n    <section class=\"audience customers\" aria-label=\"Customers, current and prospective\">\n      <div class=\"person\" aria-hidden=\"true\">\n        <div class=\"head\"></div>\n        <div class=\"torso\"></div>\n        <div class=\"arm left\"></div>\n        <div class=\"arm right\"></div>\n        <div class=\"leg left\"></div>\n        <div class=\"leg right\"></div>\n      </div>\n      <div class=\"audience-title\">Customers</div>\n      <div class=\"audience-subtitle\">(Current &amp; Prospective)</div>\n    </section>\n\n    <div class=\"factor-label internal\">INTERNAL<br>FACTORS</div>\n    <div class=\"factor-label external\">EXTERNAL<br>FACTORS</div>\n\n    <section class=\"item left-item clarity\">\n      <div class=\"placeholder photo-clarity\"><span>[Photo: clarity]</span></div>\n      <div class=\"copy\">\n        <h2>Clarity</h2>\n        <p>Clarity internally about what the brand stands for and its values,<br>\n        positioning and proposition. Clarity too about target audiences,<br>\n        customer insights and drivers. Because so much hinges on this, it is<br>\n        vital that these are articulated and shared across the organization.</p>\n      </div>\n    </section>\n\n    <section class=\"item left-item commitment\">\n      <div class=\"placeholder photo-commitment\"><span>[Photo: commitment]</span></div>\n      <div class=\"copy\">\n        <h2>Commitment</h2>\n        <p>Internal commitment to brand, and a belief internally<br>\n        in the importance of brand. The extent to which the<br>\n        brand receives support in terms of time, influence, and<br>\n        investment.</p>\n      </div>\n    </section>\n\n    <section class=\"item left-item protection\">\n      <div class=\"placeholder photo-protection\"><span>[Photo: protection]</span></div>\n      <div class=\"copy\">\n        <h2>Protection</h2>\n        <p>How secure the brand is across a number of<br>\n        dimensions: legal protection, proprietary ingredients<br>\n        or design, scale or geographical spread.</p>\n      </div>\n    </section>\n\n    <section class=\"item left-item responsiveness\">\n      <div class=\"placeholder photo-responsive\"><span>[Photo: responsiveness]</span></div>\n      <div class=\"copy\">\n        <h2>Responsiveness</h2>\n        <p>The ability to respond to market changes, challenges and<br>\n        opportunities. The brand should have a sense of leadership<br>\n        internally and a desire and ability to constantly evolve and<br>\n        renew itself.</p>\n      </div>\n    </section>\n\n    <section class=\"item right-item authenticity\">\n      <div class=\"placeholder photo-authenticity\"><span>[Photo: authenticity]</span></div>\n      <div class=\"copy\">\n        <h2>Authenticity</h2>\n        <p>The brand is soundly based on an internal<br>\n        truth and capability. It has a defined heritage and a well grounded<br>\n        value set. It can deliver against the (high) expectations that customers<br>\n        have of it.</p>\n      </div>\n    </section>\n\n    <section class=\"item right-item relevance\">\n      <div class=\"placeholder photo-relevance\"><span>[Photo: relevance]</span></div>\n      <div class=\"copy\">\n        <h2>Relevance</h2>\n        <p>The fit with customer/consumer needs, desires, and<br>\n        decision criteria across all relevant demographics and<br>\n        geographies.</p>\n      </div>\n    </section>\n\n    <section class=\"item right-item differentiation\">\n      <div class=\"placeholder photo-differentiation\"><span>[Photo: differentiation]</span></div>\n      <div class=\"copy\">\n        <h2>Differentiation</h2>\n        <p>The degree to which customers/<br>\n        consumers perceive the brand to have a<br>\n        differentiated positioning distinctive from the<br>\n        competition.</p>\n      </div>\n    </section>\n\n    <section class=\"item right-item consistency\">\n      <div class=\"placeholder photo-consistency\"><span>[Photo: consistency]</span></div>\n      <div class=\"copy\">\n        <h2>Consistency</h2>\n        <p>The degree to which a brand is experienced<br>\n        without fail across all touchpoints or formats.</p>\n      </div>\n    </section>\n\n    <section class=\"item right-item presence\">\n      <div class=\"placeholder photo-presence\"><span>[Photo: presence]</span></div>\n      <div class=\"copy\">\n        <h2>Presence</h2>\n        <p>The degree to which a brand feels omnipresent and is<br>\n        talked about positively by consumers, customers and<br>\n        opinion formers in both traditional and social media.</p>\n      </div>\n    </section>\n\n    <section class=\"item right-item understanding\">\n      <div class=\"placeholder photo-understanding\"><span>[Photo: understanding]</span></div>\n      <div class=\"copy\">\n        <h2>Understanding</h2>\n        <p>The brand is not only recognised by customers,<br>\n        but there is also an in-depth knowledge and under-standing of its<br>\n        distinctive qualities and characteristics (Where relevant, this is<br>\n        consumer understanding of the company that owns the brand).</p>\n      </div>\n    </section>\n\n    <div class=\"brandmark\">Interbrand</div>\n  </div>\n</main>\n</body>\n</html>"
