35fr 1fr;\n      gap: 12px;\n      margin: 8px 3px 10px;\n    }\n\n    .plots-row.equal {\n      grid-template-columns: 1fr 1fr;\n    }\n\n    .placeholder {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      border: 0;\n      background:\n        linear-gradient(#fff, #fff) padding-box,\n        repeating-linear-gradient(\n          0deg,\n          transparent 0,\n          transparent 24px,\n          rgba(0, 0, 0, 0.08) 25px\n        ),\n        repeating-linear-gradient(\n          90deg,\n          transparent 0,\n          transparent 36px,\n          rgba(0, 0, 0, 0.08) 37px\n        );\n      color: #222;\n      text-align: center;\n      font-size: 13px;\n      font-style: italic;\n    }\n\n    .plot {\n      height: 188px;\n    }\n\n    .plot.tall {\n      height: 234px;\n    }\n\n    .plot-caption {\n      margin-top: 2px;\n      text-align: center;\n      font-size: 17px;\n      line-height: 1.2;\n    }\n\n    .equations {\n      display: grid;\n      grid-template-columns: 1.35fr 1fr;\n      gap: 20px;\n      margin: 7px 4px 11px;\n      align-items: center;\n    }\n\n    .equation {\n      min-height: 52px;\n      padding: 6px 8px;\n      border: 2px solid red;\n      background: transparent;\n      font-family: \"Times New Roman\", Times, serif;\n      font-size: 19px;\n      text-align: center;\n    }\n\n    .equation mjx-container {\n      margin: 0 !important;\n    }\n\n    .bottom-area {\n      display: grid;\n      grid-template-columns: 31% 69%;\n      gap: 0;\n      padding-top: 13px;\n    }\n\n    .institution {\n      padding: 0 29px;\n      font-size: 17px;\n      line-height: 1.4;\n    }\n\n    .institution .strong {\n      margin-bottom: 25px;\n      font-size: 20px;\n      line-height: 1.2;\n      font-weight: 700;\n    }\n\n    .institution .jpl {\n      font-size: 19px;\n      font-weight: 700;\n    }\n\n    .institution .web {\n      margin: 25px 0;\n      font-size: 20px;\n      font-weight: 700;\n    }\n\n    .institution p {\n      margin: 0 0 11px;\n    }\n\n    .publications {\n      margin-right: 23px;\n      min-height: 230px;\n    }\n\n    .publications h3 {\n      font-size: 25px;\n    }\n\n    .references {\n      font-size: 18px;\n      line-height: 1.43;\n    }\n\n    .contact-title {\n      margin: 7px 0 2px;\n      font-size: 25px;\n      font-weight: 700;\n    }\n\n    .email {\n      display: inline-block;\n      color: #0869c7;\n      border-bottom: 2px solid #0869c7;\n      font-size: 24px;\n      font-style: italic;\n      font-weight: 700;\n      line-height: 1.1;\n    }\n\n    .phone {\n      color: #7b7777;\n      font-size: 24px;\n      font-style: italic;\n      font-weight: 700;\n    }\n\n    @media (max-width: 1600px) {\n      body {\n        justify-content: flex-start;\n      }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"poster\">\n    <header class=\"agency-bar\">\n      <div class=\"agency-name\">National Aeronautics and Space Administration</div>\n      <div class=\"nasa-logo\" aria-label=\"NASA logo\">NASA</div>\n    </header>\n\n    <section class=\"hero\">\n      <div class=\"series\">Postdoc Research</div>\n      <h1>Microwave Resonator Spectroscopy of Wafer-Scale</h1>\n      <h2>Magnesium Diboride</h2>\n      <div class=\"authors\">\n        <div class=\"author-line\">Author: Albert Wandui, JPL Postdoctoral Fellow (365H)</div>\n        Jason Almaras (365H), Jon Greenfield (365H), Matt Kenyon (365H), Cliff Frez (365K), Sahil Patel<br>\n        (365H), Daniel Shanks (365F), Matt Shaw (365H), Emma Wollman (365H), Daniel Cunnane (365H)\n      </div>\n    </section>\n\n    <section class=\"main-grid\">\n      <div class=\"column\">\n        <section class=\"panel blue background\">\n          <h3>Background and Scientific Goals</h3>\n          <p>Our objective is to develop and mature wafer-scale thin-film Magnesium Diboride (MgB<sub>2</sub>) enabling:</p>\n          <ul>\n            <li>High performance superconducting nanowire single-photon detectors (SNSPDs) operating above 4K.</li>\n            <li>Superconducting filters and detectors for astrophysics and remote sensing in the sub-mm to far-IR regime.</li>\n          </ul>\n          <p>This requires an accurate model of the both the equilibrium and non-equilibrium superconductivity and quasiparticle dynamics in a two-gap superconductor with various degrees of disorder and interband interaction strength.</p>\n        </section>\n\n        <section class=\"panel yellow approach-one\">\n          <h3>Approach and Results I: Resonator Measurements</h3>\n          <ul>\n            <li>Extract the complex conductivity of films from measurements of the temperature (100mK - 30K), and frequency (100 MHz - 5 GHz) dependence of the resonance frequency and internal quality factor of MgB<sub>2</sub></li>\n          </ul>\n\n          <div class=\"plots-row\">\n            <figure class=\"placeholder plot\" aria-label=\"Temperature and frequency resonator data plot\">\n              [Chart: measured resonator response versus frequency and temperature]\n            </figure>\n            <figure class=\"placeholder plot\" aria-label=\"Penetration depth versus temperature plot\">\n              [Chart: Penetration Depth vs. Temperature]\n            </figure>\n          </div>\n\n          <ul>\n            <li>Noise measurements shed light on the quasiparticle dynamics in the superconducting film.</li>\n          </ul>\n\n          <div class=\"plots-row equal\">\n            <figure class=\"placeholder plot tall\" aria-label=\"Power spectral density plot\">\n              [Chart: resonant response, dissipative response, and quasiparticle rolloff]\n            </figure>\n            <figure class=\"placeholder plot tall\" aria-label=\"Noise spectra plot\">\n              [Chart: noise spectra with increasing temperature]\n            </figure>\n          </div>\n        </section>\n\n        <section class=\"panel yellow outlook\">\n          <h3>Outlook</h3>\n          <ul>\n            <li>Have developed a robust model of the 2-gap interaction in MgB<sub>2</sub> applicable to films over a wide thickness, sheet resistance and T<sub>c</sub> range.</li>\n            <li>Currently incorporating data from critical field measurements to constrain the total DOS.</li>\n            <li>Film-to-film comparisons can now inform fabrication and further work on modeling detector response.</li>\n          </ul>\n        </section>\n      </div>\n\n      <div class=\"column\">\n        <section class=\"panel blue why\">\n          <h3>Why MgB<sub>2</sub>?</h3>\n          <p>Superconductivity in MgB<sub>2</sub> is mediated by the electron-phonon interaction. Uniquely among BCS superconductors, it exhibits:</p>\n          <ul>\n            <li>2 interacting superconducting band gaps: a strongly coupled 2D $\\pi$ band and a weakly coupled 3d $\\sigma$ band.</li>\n            <li>The resulting high superconducting transition temperature T<sub>c</sub> offers a compelling pathway for superconducting devices that operate at elevated temperatures or at higher frequencies.</li>\n          </ul>\n          <p>JPL has developed a process for wafer-scale MgB<sub>2</sub> with low roughness and high uniformity with T<sub>c</sub> of up to 31 K for bulk films and high kinetic inductance [1,2].</p>\n        </section>\n\n        <section class=\"panel green approach-two\">\n          <h3>Approach and Results II: Modeling 2 gap physics</h3>\n          <ul>\n            <li>Obtain the temperature dependent gap energies $\\Delta_\\pi(T)$ and $\\Delta_\\sigma(T)$ and the band interaction parameters $V^{\\pi\\pi}$, $V^{\\pi\\sigma}$, $V^{\\sigma\\sigma}$.</li>\n            <li>To do so, we developed a self-consistent approach to fitting the measured penetration depth using Eliashberg Theory.</li>\n          </ul>\n\n          <div class=\"equations\">\n            <div class=\"equation\">\n              $$\\sum_\\beta\\left(V_{\\alpha\\beta}^{-1}-N_\\alpha\\cdot\\Pi_\\alpha\\cdot\\delta_{\\alpha\\beta}\\right)\\cdot\\Delta_\\beta=0$$\n            </div>\n            <div class=\"equation\">\n              $$\\Pi_\\alpha=\\int_0^{\\omega_c}d\\xi\\,\n              \\frac{\\tanh\\!\\left[\\beta\\sqrt{\\xi^2+|\\Delta_\\alpha|^2}/2\\right]}\n              {\\sqrt{\\xi^2+|\\Delta_\\alpha|^2}}$$\n            </div>\n          </div>\n\n          <ul>\n            <li>Using 3 fit parameters: ratio of the DOS, ratio of the gap energies at T=0, and fraction of conductivity from the $\\pi$ band, we accurately reproduce both the penetration depth and the dissipation as a function of temperature [3].</li>\n          </ul>\n\n          <div class=\"plots-row equal\">\n            <div>\n              <figure class=\"placeholder plot\" aria-label=\"Complex conductivity versus temperature chart\">\n                [Chart: complex conductivity versus temperature]\n              </figure>\n              <div class=\"plot-caption\">Complex conductivity vs. temperature</div>\n            </div>\n            <div>\n              <figure class=\"placeholder plot\" aria-label=\"Predicted conductivity versus frequency chart\">\n                [Chart: predicted complex conductivity versus frequency]\n              </figure>\n              <div class=\"plot-caption\">Predicted complex conductivity as<br>a function of frequency at 4.2K</div>\n            </div>\n          </div>\n\n          <div class=\"plots-row equal\">\n            <figure class=\"placeholder plot tall\" aria-label=\"Conductivity components versus temperature chart\">\n              [Chart: $\\sigma_\\pi$, $\\sigma_\\sigma$, and total conductivity versus temperature]\n            </figure>\n            <figure class=\"placeholder plot tall\" aria-label=\"Conductivity versus frequency chart\">\n              [Chart: $\\sigma_1(T)/\\sigma_n$ and $\\sigma_2(T)/\\sigma_n$ versus frequency]\n            </figure>\n          </div>\n        </section>\n      </div>\n    </section>\n\n    <footer class=\"bottom-area\">\n      <section class=\"institution\">\n        <div class=\"strong\">National Aeronautics and Space Administration</div>\n        <p class=\"jpl\">Jet Propulsion Laboratory</p>\n        <p>California Institute of Technology<br>Pasadena, California</p>\n        <p class=\"web\">www.nasa.gov</p>\n        <p>Clearance Number: CL#00-0000</p>\n        <p>Poster Number: Postdoc-T-007</p>\n        <p>Copyright 2024. All rights reserved.</p>\n      </section>\n\n      <section class=\"panel gray publications\">\n        <h3>Publications and Acknowledgements:</h3>\n        <div class=\"references\">\n          [1] Changsub Kim et al. ACS Nano 2024 18 (40) DOI: 10.1021/acsnano.4c11001<br>\n          [2] J. Greenfield et al. Appl. Phys. Lett.126 (2): 022602.<br>\n          [3] A. Wandui et al. (in prep)\n        </div>\n        <div class=\"contact-title\">Author Contact Information:</div>\n        <div class=\"email\">albert.k.wandui@jpl.nasa.gov</div><br>\n        <div class=\"phone\">(650)739-9235</div>\n      </section>\n    </footer>\n  </main>\n</body>\n</html>"
