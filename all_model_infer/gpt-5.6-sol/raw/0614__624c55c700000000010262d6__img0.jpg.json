        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>教学原则与教学方法手写笔记</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] }\n};\n</script>\n<script defer src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n\n  html, body {\n    margin: 0;\n    min-height: 100%;\n  }\n\n  body {\n    background:\n      radial-gradient(circle at 50% 0%, rgba(255,255,255,.28), transparent 34%),\n      linear-gradient(135deg, #77786f, #9a9b91 45%, #72746d);\n    padding: 34px 18px 42px;\n    color: #292927;\n    font-family: \"STKaiti\", \"KaiTi\", \"Kaiti SC\", \"FangSong\", serif;\n  }\n\n  .notebook {\n    position: relative;\n    width: 760px;\n    min-height: 1000px;\n    margin: 0 auto;\n    padding: 24px 27px 34px;\n    overflow: hidden;\n    transform: rotate(.25deg);\n    border-radius: 7px 11px 4px 6px;\n    box-shadow:\n      0 8px 22px rgba(0,0,0,.42),\n      inset 0 0 26px rgba(76,77,68,.15);\n    background-color: #e6e8df;\n    background-image:\n      repeating-linear-gradient(\n        to bottom,\n        transparent 0,\n        transparent 26px,\n        rgba(107,132,139,.13) 27px,\n        transparent 28px\n      ),\n      linear-gradient(\n        to right,\n        rgba(255,255,255,.18),\n        rgba(199,202,193,.16) 48.8%,\n        rgba(102,105,99,.12) 49.7%,\n        rgba(255,255,255,.26) 50.2%,\n        rgba(189,192,183,.10) 51%,\n        rgba(255,255,255,.12)\n      );\n  }\n\n  .notebook::before {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    bottom: 0;\n    left: 50%;\n    width: 2px;\n    background: linear-gradient(\n      to bottom,\n      rgba(98,107,105,.08),\n      rgba(77,84,83,.24) 12%,\n      rgba(80,87,86,.16) 88%,\n      rgba(255,255,255,.22)\n    );\n    box-shadow:\n      -5px 0 9px rgba(94,96,91,.08),\n      5px 0 9px rgba(255,255,255,.16);\n  }\n\n  .columns {\n    position: relative;\n    z-index: 1;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    column-gap: 31px;\n  }\n\n  .column {\n    min-width: 0;\n    font-size: 15.2px;\n    line-height: 1.46;\n    letter-spacing: .15px;\n  }\n\n  .left {\n    padding-right: 2px;\n  }\n\n  .right {\n    padding-left: 2px;\n  }\n\n  .section {\n    margin: 0 0 10px;\n  }\n\n  .heading {\n    margin: 0 0 2px;\n    color: #bb4351;\n    font-size: 16.7px;\n    line-height: 1.25;\n    font-weight: 600;\n  }\n\n  .line {\n    margin: 0;\n    text-indent: -1.2em;\n    padding-left: 1.2em;\n  }\n\n  .continued {\n    margin: 0;\n    padding-left: 1.2em;\n  }\n\n  .teaching-box {\n    width: 54px;\n    height: 38px;\n    margin: -1px 8px 5px auto;\n    border: 3px solid #b53443;\n    outline: 1px solid rgba(66,83,91,.35);\n    color: #243f78;\n    background: rgba(236,239,228,.24);\n    font-size: 22px;\n    font-weight: 700;\n    line-height: 31px;\n    text-align: center;\n    transform: rotate(-1.5deg);\n  }\n\n  .small-gap {\n    margin-top: 4px;\n  }\n\n  .bottom-note {\n    position: relative;\n    margin-top: 4px;\n    min-height: 75px;\n    font-size: 15.6px;\n  }\n\n  .bottom-note .label {\n    display: inline-block;\n    margin-right: 5px;\n    font-size: 17px;\n  }\n\n  .note-row {\n    margin: 0 0 1px 36px;\n  }\n\n  .faint {\n    color: #3a3a37;\n  }\n\n  @media (max-width: 800px) {\n    body {\n      padding: 10px;\n    }\n\n    .notebook {\n      width: 760px;\n      transform-origin: top left;\n    }\n  }\n</style>\n</head>\n<body>\n<main class=\"notebook\">\n  <div class=\"columns\">\n    <section class=\"column left\">\n      <div class=\"section\">\n        <h2 class=\"heading\">直观性原则（学生获得直观知识）</h2>\n        <p class=\"line\">（1）实物直观是指教师直接展示实物或进行实验等，</p>\n        <p class=\"continued\">引导学生获得感性认识。</p>\n        <p class=\"line\">（2）模象直观是指教师通过图片或模型等向学生提供感性材料。</p>\n        <p class=\"line\">（3）语言直观是指在形象化的语言作用下，[illegible]。</p>\n        <p class=\"line\">（4）防止直观的不当与滥用。</p>\n      </div>\n\n      <div class=\"teaching-box\">教学</div>\n\n      <div class=\"section\">\n        <h2 class=\"heading\">启发性原则（学生会问）</h2>\n        <p class=\"line\">（1）加强学习目的的任务教育，调动学生学习的主动性。</p>\n        <p class=\"line\">（2）启发学生独立思考，发展学生逻辑思维能力。</p>\n        <p class=\"line\">（3）让学生动手，培养学生独立解决问题的能力。</p>\n        <p class=\"line\">（4）发扬教学民主，包括建立民主平等的师生关系。</p>\n      </div>\n\n      <div class=\"section\">\n        <h2 class=\"heading\">循序渐进原则（教师[illegible]）</h2>\n        <p class=\"line\">（1）教师的教学要有系统性。</p>\n        <p class=\"line\">（2）注意主要矛盾，解决好重点与难点的教学。</p>\n        <p class=\"line\">（3）按照学生的认识顺序，由浅入深，由易到难，由简到繁。</p>\n        <p class=\"line\">（4）将系统性与灵活多样性结合起来。</p>\n      </div>\n\n      <div class=\"section\">\n        <h2 class=\"heading\">巩固性原则（[illegible]）</h2>\n        <p class=\"line\">（1）重在发展的过程中加强知识的巩固。</p>\n        <p class=\"line\">（2）组织有效的学生的复习工作，教给学生复习方法。</p>\n        <p class=\"line\">（3）在扩充、改组和运用知识中积极巩固。</p>\n      </div>\n\n      <div class=\"section\">\n        <h2 class=\"heading\">量力性原则</h2>\n        <p class=\"line\">（1）了解学生的实际水平，从实际出发进行教学。</p>\n        <p class=\"line\">（2）考虑学生认识发展的时代性。</p>\n      </div>\n\n      <div class=\"section\">\n        <h2 class=\"heading\">因材施教原则</h2>\n        <p class=\"line\">（1）针对学生的特点进行有区别的教学。</p>\n        <p class=\"line\">（2）采取有效措施，使有才能的学生得到充分发展。</p>\n      </div>\n\n      <div class=\"bottom-note faint\">\n        <span class=\"label\">勿忘：</span>①能力不同学生\n        <p class=\"note-row\">②尊重学生差异</p>\n        <p class=\"note-row\">③面向每一位学生。</p>\n      </div>\n    </section>\n\n    <section class=\"column right\">\n      <div class=\"section\">\n        <h2 class=\"heading\">思想性与科学性相统一原则</h2>\n        <p class=\"line\">（1）[illegible]科目的思想性。</p>\n        <p class=\"line\">（2）[illegible]学生[illegible]。</p>\n        <p class=\"line\">（3）教师只有[illegible]，坚持[illegible]。</p>\n        <p class=\"line\">（4）教师既要[illegible]结合自己的特点对学生[illegible]。</p>\n        <p class=\"line\">（5）结合[illegible]的特点适当加强思想教育。</p>\n      </div>\n\n      <div class=\"section\">\n        <h2 class=\"heading\">理论联系实际原则</h2>\n        <p class=\"line\">（1）书本知识教学要注重联系实际。</p>\n        <p class=\"line\">（2）重视培养学生运用知识的能力。</p>\n        <p class=\"line\">（3）正确处理知识教学与技能训练的关系。</p>\n        <p class=\"line\">（4）补充必要的乡土教材。</p>\n      </div>\n\n      <div class=\"section small-gap\">\n        <h2 class=\"heading\">讲授法：</h2>\n        <p class=\"line\">（1）讲授内容有系统。</p>\n        <p class=\"line\">（2）方法既要讲究，又要有启发性。</p>\n        <p class=\"line\">（3）讲授语言要艺术。</p>\n        <p class=\"line\">（4）要组织学生听讲。</p>\n      </div>\n\n      <div class=\"section\">\n        <h2 class=\"heading\">谈话法：</h2>\n        <p class=\"line\">（1）要准备好问题和谈话计划。</p>\n        <p class=\"line\">（2）要懂问。</p>\n        <p class=\"line\">（3）要善于反问学生。</p>\n        <p class=\"line\">（4）要做好归纳和小结。</p>\n      </div>\n\n      <div class=\"section\">\n        <h2 class=\"heading\">讨论法：</h2>\n        <p class=\"line\">（1）讨论的问题要有吸引力。</p>\n        <p class=\"line\">（2）要善于引导学生围绕中心，并有序。</p>\n        <p class=\"line\">（3）要做好讨论的小结。</p>\n      </div>\n\n      <div class=\"section\">\n        <h2 class=\"heading\">读书指导法：</h2>\n        <p class=\"line\">（1）明确目的，提高阅读兴趣。</p>\n        <p class=\"line\">（2）教给学生读书方法。</p>\n        <p class=\"line\">（3）善于督促学生在读书中发现问题和解决问题。</p>\n        <p class=\"line\">（4）适当组织学生交流读书心得。</p>\n      </div>\n    </section>\n  </div>\n</main>\n</body>\n</html>"
