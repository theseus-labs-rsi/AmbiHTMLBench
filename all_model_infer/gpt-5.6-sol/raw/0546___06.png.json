{diag}\\{50,50,0,0,0,0\\}$\n        </td>\n      </tr>\n    </tbody>\n  </table>\n\n  <div class=\"figures-grid\">\n    <figure class=\"left-figure\">\n      <div class=\"plot-stack\">\n        <div class=\"plot-block top-left\">\n          <div class=\"placeholder\" role=\"img\" aria-label=\"Tank energy time-history chart\">\n            <svg viewBox=\"0 0 570 197\" preserveAspectRatio=\"none\">\n              <rect x=\"80\" y=\"24\" width=\"458\" height=\"120\" fill=\"#fff\"/>\n              <rect class=\"shade\" x=\"197\" y=\"24\" width=\"38\" height=\"120\"/>\n              <line class=\"grid\" x1=\"80\" y1=\"24\" x2=\"538\" y2=\"24\"/>\n              <line class=\"grid\" x1=\"80\" y1=\"84\" x2=\"538\" y2=\"84\"/>\n              <line class=\"grid\" x1=\"197\" y1=\"24\" x2=\"197\" y2=\"144\"/>\n              <line class=\"grid\" x1=\"385\" y1=\"24\" x2=\"385\" y2=\"144\"/>\n              <rect class=\"axis\" x=\"80\" y=\"24\" width=\"458\" height=\"120\"/>\n              <line class=\"axis\" x1=\"80\" y1=\"24\" x2=\"75\" y2=\"24\"/>\n              <line class=\"axis\" x1=\"80\" y1=\"84\" x2=\"75\" y2=\"84\"/>\n              <line class=\"axis\" x1=\"538\" y1=\"84\" x2=\"543\" y2=\"84\"/>\n              <line class=\"axis\" x1=\"197\" y1=\"144\" x2=\"197\" y2=\"139\"/>\n              <line class=\"axis\" x1=\"385\" y1=\"144\" x2=\"385\" y2=\"139\"/>\n              <path class=\"curve\" d=\"M80,25\n                C96,24 108,24 115,29\n                C127,38 135,65 145,95\n                C150,106 161,108 177,109\n                L196,110 L199,144 L234,144\n                C236,136 238,61 245,44\n                C251,30 261,29 275,27\n                L281,25\n                C301,24 320,25 340,25\n                C355,25 365,23 374,25\n                C384,27 391,43 402,52\n                C413,61 424,64 434,61\n                L438,29\n                C441,20 444,30 447,39\n                C450,35 452,26 455,26\n                C463,27 472,25 480,25\n           