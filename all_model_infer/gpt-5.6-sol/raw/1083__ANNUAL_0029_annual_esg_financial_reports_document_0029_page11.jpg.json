isual::before {\n      content: \"\";\n      position: absolute;\n      inset: 48% 0 0;\n      opacity: .8;\n      background-image:\n        radial-gradient(circle, rgba(255,255,255,.82) 0 1px, transparent 1.5px),\n        radial-gradient(circle, rgba(250,95,181,.7) 0 1px, transparent 1.5px);\n      background-size: 17px 17px, 29px 29px;\n      background-position: 0 0, 8px 12px;\n      transform: rotate(-12deg) scale(1.18);\n    }\n\n    .visual::after {\n      content: \"\";\n      position: absolute;\n      width: 62%;\n      height: 65%;\n      right: -12%;\n      bottom: -8%;\n      border: 18px solid #d425db;\n      border-left-color: #ef7c65;\n      border-bottom-color: #7f1a9d;\n      border-radius: 50%;\n      transform: rotate(-28deg);\n      opacity: .92;\n      box-shadow: 0 0 22px rgba(245, 29, 232, .65);\n    }\n\n    .quote-mark {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 30px;\n      height: 31px;\n      background: #c02bd1;\n      z-index: 2;\n    }\n\n    .quote-mark::before {\n      content: \"\";\n      position: absolute;\n      left: 8px;\n      top: 8px;\n      width: 12px;\n      height: 9px;\n      border: 1px solid #fff;\n    }\n\n    .quote-mark::after {\n      content: \"\";\n      position: absolute;\n      left: 17px;\n      top: 16px;\n      width: 5px;\n      height: 5px;\n      border-left: 1px solid #fff;\n      border-bottom: 1px solid #fff;\n      transform: skewY(-35deg);\n    }\n\n    blockquote {\n      position: relative;\n      z-index: 2;\n      margin: 32px 28px 0;\n      color: #f6f4f4;\n      font-size: clamp(25px, 1.42vw, 37px);\n      line-height: 1.28;\n      font-weight: 300;\n    }\n\n    .highlight {\n      background: #e9c8e6;\n      box-shadow: 7px 0 0 #e9c8e6, -2px 0 0 #e9c8e6;\n    }\n\n    .signature {\n      margin-top: 21px;\n    }\n\n    .signature strong {\n      display: block;\n      font-weight: 700;\n    }\n\n    @media (max-width: 1100px) {\n      body {\n        padding: