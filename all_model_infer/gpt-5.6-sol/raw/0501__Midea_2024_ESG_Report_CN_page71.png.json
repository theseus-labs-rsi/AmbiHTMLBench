h2 class=\"section-title\">附录一 奖项与荣誉</h2>\n\n    <section class=\"columns\">\n      <section class=\"column column-one\" aria-label=\"品牌认可\">\n        <h3 class=\"pill\">品牌认可</h3>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">连续九年入围财富500强，2024年位居277位</p>\n          <p class=\"entry-source\">财富</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">荣获《财富》最受赞赏的中国公司</p>\n          <p class=\"entry-source\">财富</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">入选福布斯中国跨国经营30强</p>\n          <p class=\"entry-source\">福布斯中国</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">全球最佳雇主</p>\n          <p class=\"entry-source\">福布斯</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">全球最适合女性工作的企业</p>\n          <p class=\"entry-source\">福布斯</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">全球科技品牌（Technology 100）价值100强，美的排名40</p>\n          <p class=\"entry-source\">Brand Finance</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">以旧换新领军品牌</p>\n          <p class=\"entry-source\">人民日报社</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">中国企业科创力排行 家用电器 — 行业第一</p>\n          <p class=\"entry-source\">南方周末</p>\n        </article>\n      </section>\n\n      <section class=\"column column-two\" aria-label=\"ESG奖项\">\n        <h3 class=\"pill\">ESG奖项</h3>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">入围财富中国ESG影响力榜</p>\n          <p class=\"entry-source\">财富中国</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">福布斯中国2024可持续发展企业50强</p>\n          <p class=\"entry-source\">福布斯中国</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">中国新增长ESG创新实践榜</p>\n          <p class=\"entry-source\">哈佛商业评论</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">ESG新标杆企业奖</p>\n          <p class=\"entry-source\">证券之星</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">年度低碳先锋</p>\n          <p class=\"entry-source\">南方周末</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">ESG综合治理标杆企业</p>\n          <p class=\"entry-source\">经济观察报</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">中国制造业上市公司社会责任五星金奖</p>\n          <p class=\"entry-source\">时代责任四十人论坛</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">可持续品牌典范奖</p>\n          <p class=\"entry-source\">虎嗅ESG</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">可持续发展优创奖</p>\n          <p class=\"entry-source\">《电器》杂志社</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">2024中国最佳ESG雇主</p>\n          <p class=\"entry-source\">怡安AON</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">杰出全球ESG影响力大奖</p>\n          <p class=\"entry-source\">2024粤港澳大湾区可持续发展论坛暨香港ESG报告大奖（HERA）</p>\n        </article>\n      </section>\n\n      <section class=\"column column-three\" aria-label=\"技术认可\">\n        <h3 class=\"pill\">技术认可</h3>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">2024亚洲最佳移动技术突破奖</p>\n          <p class=\"entry-source\">GSMA亚洲移动大奖（AMO）</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">国家科技进步奖二等奖（《空气源热泵多品位热能高效供应关键技术与应用》）</p>\n          <p class=\"entry-source\">国务院</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">中国创新方法大赛一等奖（《基于TRIZ的干衣机低碳关键技术研究》项目）</p>\n          <p class=\"entry-source\">中国科学技术协会、重庆市政府</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">2024年第三届高能团队奖</p>\n          <p class=\"entry-source\">哈佛商业评论，北京国际人力资本集团股份有限公司</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">2024胡润中国元宇宙潜力企业榜</p>\n          <p class=\"entry-source\">胡润研究院</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">美的集团联合项目《智能工厂全连接物流及精细化管理关键技术研究与应用》荣获了2024年度“机械工业科学技术奖”科技进步奖一等奖</p>\n          <p class=\"entry-source\">中国机械工业联合会，中国机械工程学会</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">2024年度脉脉MAX雇主榜单</p>\n          <p class=\"entry-source\">脉脉</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">2024绿点中国·可持续消费实践案例评选（美的集团-废旧家电绿色闭路循环创新项目）</p>\n          <p class=\"entry-source\">第一财经</p>\n        </article>\n      </section>\n\n      <section class=\"column column-four\" aria-label=\"其他认可\">\n        <article class=\"entry\">\n          <p class=\"entry-title\">美的洗衣机合肥工厂被评为“可持续灯塔工厂”</p>\n          <p class=\"entry-source\">世界经济论坛</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">美的医疗“中国脊梁守护计划”公益活动成功入选「2024健康中国创新实践典型案例」</p>\n          <p class=\"entry-source\">人民网</p>\n        </article>\n\n        <article class=\"entry\">\n          <p class=\"entry-title\">美的医疗荣获2024年度中国新质发展优秀案例</p>\n          <p class=\"entry-source\">国家广告研究院、《中国名牌》杂志社</p>\n        </article>\n      </section>\n    </section>\n\n    <figure class=\"placeholder\" aria-label=\"奖杯与月桂枝装饰图，右下\">\n      <figcaption>[Illustration: trophy with laurel branches, bottom-right]</figcaption>\n      <div class=\"wreath\" aria-hidden=\"true\">\n        <div class=\"branch left\"></div>\n        <div class=\"branch right\"></div>\n\n        <i class=\"leaf l1\"></i><i class=\"leaf light l2\"></i>\n        <i class=\"leaf l3\"></i><i class=\"leaf light l4\"></i>\n        <i