        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>小学毕业升学必刷试卷（九）</title>\n<script>\nwindow.MathJax = {\n  tex: {\n    inlineMath: [['$', '$']],\n    displayMath: [['$$', '$$']]\n  }\n};\n</script>\n<script defer src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * {\n    box-sizing: border-box;\n  }\n\n  html, body {\n    margin: 0;\n    padding: 0;\n    background: #e8e7e1;\n  }\n\n  body {\n    color: #262626;\n    font-family: \"SimSun\", \"Songti SC\", \"Noto Serif CJK SC\", serif;\n  }\n\n  .page {\n    position: relative;\n    width: 540px;\n    height: 720px;\n    margin: 0 auto;\n    padding: 5px 21px 14px;\n    overflow: hidden;\n    background: #f5f4ee;\n    font-size: 12.5px;\n    line-height: 1.62;\n  }\n\n  h1 {\n    margin: 0 0 13px;\n    text-align: center;\n    font-family: \"SimHei\", \"Microsoft YaHei\", sans-serif;\n    font-size: 20px;\n    line-height: 1.35;\n    font-weight: 700;\n    letter-spacing: 1px;\n  }\n\n  .test-info {\n    position: relative;\n    margin-bottom: 5px;\n  }\n\n  .time {\n    margin: 0 0 1px 2px;\n    font-size: 10.5px;\n  }\n\n  .score-note {\n    position: absolute;\n    top: 14px;\n    right: 2px;\n    z-index: 2;\n    font-size: 9.5px;\n    white-space: nowrap;\n  }\n\n  .score-table {\n    width: 472px;\n    height: 44px;\n    border-collapse: collapse;\n    table-layout: fixed;\n    font-size: 11px;\n  }\n\n  .score-table th,\n  .score-table td {\n    height: 21px;\n    padding: 0;\n    border: 1px solid #555;\n    text-align: center;\n    font-weight: normal;\n  }\n\n  .score-table th:first-child,\n  .score-table td:first-child {\n    width: 61px;\n  }\n\n  .score-table th:last-child,\n  .score-table td:last-child {\n    width: 72px;\n  }\n\n  .section-title {\n    margin: 2px 0 1px 1px;\n    font-weight: 700;\n    letter-spacing: .2px;\n  }\n\n  .ques