        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>要闻</title>\n<script>\n  window.MathJax = {\n    tex: { inlineMath: [['$', '$'], ['\\\\(', '\\\\)']], displayMath: [['$$', '$$'], ['\\\\[', '\\\\]']] }\n  };\n</script>\n<script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  html, body { margin: 0; padding: 0; background: #fff; color: #111; }\n  body {\n    width: 800px;\n    margin: 0 auto;\n    font-family: \"Noto Serif CJK SC\", \"Songti SC\", SimSun, serif;\n    font-size: 10px;\n    line-height: 1.48;\n  }\n  .page { padding: 10px 10px 18px; }\n  .masthead {\n    height: 38px;\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    border-bottom: 2px solid #111;\n    margin-bottom: 10px;\n  }\n  .brand {\n    font-size: 28px;\n    line-height: 30px;\n    letter-spacing: 2px;\n    font-weight: 700;\n  }\n  .date {\n    font-size: 8px;\n    letter-spacing: 1px;\n    margin-left: 10px;\n    vertical-align: middle;\n    font-weight: 400;\n  }\n  .paper-name {\n    font-size: 22px;\n    font-weight: 700;\n    font-style: italic;\n    letter-spacing: 1px;\n  }\n  .top-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr 1fr;\n    gap: 12px;\n    padding-bottom: 8px;\n    border-bottom: 1px solid #555;\n  }\n  .top-grid article {\n    min-width: 0;\n    padding-right: 8px;\n    border-right: 1px solid #777;\n  }\n  .top-grid article:last-child { border-right: 0; padding-right: 0; }\n  h1, h2, h3, p { margin: 0; }\n  .top-title {\n    font-size: 20px;\n    line-height: 1.18;\n    text-align: center;\n    font-weight: 700;\n    letter-spacing: 2px;\n    margin-bottom: 5px;\n  }\n  .top-text {\n    text-align: justify;\n    text-indent: 2em;\n  }\n  .main-grid {\n    display: grid;\n    grid-template-columns: 1.04fr 1.56fr