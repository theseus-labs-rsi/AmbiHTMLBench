        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>《春风沉醉的晚上》写作技巧</title>\n  <script>\n    window.MathJax = {\n      tex: {\n        inlineMath: [['$', '$']],\n        displayMath: [['$$', '$$']]\n      }\n    };\n  </script>\n  <script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * {\n      box-sizing: border-box;\n    }\n\n    html,\n    body {\n      margin: 0;\n      min-height: 100%;\n      background: #f3f5f1;\n    }\n\n    body {\n      padding: 30px 16px 22px;\n      color: #303030;\n      font-family: \"KaiTi\", \"STKaiti\", \"Microsoft YaHei\", serif;\n    }\n\n    .page {\n      position: relative;\n      width: 760px;\n      min-height: 940px;\n      margin: 0 auto;\n      padding: 28px 76px 26px 76px;\n      background-color: #fbfcf8;\n      background-image:\n        repeating-linear-gradient(\n          to bottom,\n          transparent 0,\n          transparent 25px,\n          rgba(117, 173, 185, 0.18) 25px,\n          rgba(117, 173, 185, 0.18) 26px\n        );\n      box-shadow: 0 0 14px rgba(60, 70, 70, 0.06);\n    }\n\n    .page::before {\n      content: \"\";\n      position: absolute;\n      top: 0;\n      bottom: 0;\n      left: 58px;\n      width: 1px;\n      background: rgba(202, 92, 105, 0.58);\n    }\n\n    .header {\n      position: relative;\n      min-height: 115px;\n      padding-top: 4px;\n    }\n\n    .title {\n      display: inline-block;\n      margin: 0;\n      padding-bottom: 2px;\n      border-bottom: 1px solid #333;\n      font-size: 20px;\n      line-height: 28px;\n      font-weight: 500;\n    }\n\n    .cover {\n      position: absolute;\n      top: -28px;\n      right: 0;\n      width: 103px;\n      height: 118px;\n      overflow: hidden;\n      border: 1px solid #607a84;\n      background:\n        linear-gradient(to bottom, #2184a5 0%, #74bd