#601b17);\n    box-shadow: 0 1px 3px rgba(0,0,0,.7);\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 24px;\n    font-weight: bold;\n  }\n\n  .photo-m {\n    height: 497px;\n    background:\n      radial-gradient(ellipse at 52% 52%, #eee0c7 0 21%, transparent 22%),\n      linear-gradient(90deg, rgba(12,118,131,.78) 0 9%, rgba(89,90,83,.63) 9% 82%, rgba(21,128,137,.8) 82% 100%),\n      #78817b;\n  }\n\n  .photo-n {\n    height: 497px;\n    margin-top: 35px;\n    background:\n      linear-gradient(53deg, transparent 0 39%, rgba(221,216,195,.9) 40% 50%, transparent 51%),\n      linear-gradient(135deg, #9caeaa, #566660);\n  }\n\n  .photo-o {\n    height: 498px;\n    margin-top: 25px;\n    background:\n      linear-gradient(160deg, rgba(25,65,81,.85) 0 22%, rgba(197,198,173,.86) 23% 52%, rgba(86,86,72,.9) 53% 100%),\n      #61716d;\n  }\n\n  .photo-p {\n    height: 451px;\n    background:\n      radial-gradient(ellipse at 43% 39%, #eeeae1 0 17%, transparent 18%),\n      linear-gradient(90deg, rgba(12,142,153,.8) 0 14%, rgba(102,110,104,.68) 14% 79%, rgba(13,143,154,.8) 79% 100%),\n      #76827d;\n  }\n\n  .step {\n    display: grid;\n    grid-template-columns: 49px 1fr;\n    margin-left: 27px;\n    font-size: 28px;\n    line-height: 1.28;\n  }\n\n  .step-number {\n    text-align: left;\n  }\n\n  .step-11 {\n    margin-top: 17px;\n  }\n\n  .step-12 {\n    margin-top: 35px;\n  }\n\n  .step-13 {\n    margin-top: 45px;\n  }\n\n  em {\n    font-style: italic;\n  }\n\n  .page-number {\n    margin-top: 75px;\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 27px;\n  }\n\n  .right-column {\n    font-size: 27px;\n    line-height: 1.27;\n  }\n\n  .section-heading {\n    margin: 17px 0 13px;\n    font-size: 29px;\n    font-style: italic;\n    font-weight: bold;\n    line-height: 1.1;\n  }\n\n  .inspection-list,\n  .details-list {\n    margin: 0;\n    padding-left: 75px;\n  }\n\n  .inspection-list li,\n  .details-list li {\n    padding-left: 1px;\n  }\n\n  .inspection-list li {\n    margin: 0 0 12px;\n  }\n\n  .details-list li {\n    margin: 0 0 13px;\n  }\n\n  .article-title {\n    margin: 34px 0 18px;\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 28px;\n    line-height: 1.12;\n    font-weight: 700;\n  }\n\n  .subheading {\n    margin: 37px 0 8px;\n    font-size: 29px;\n    line-height: 1.1;\n    font-style: italic;\n    font-weight: bold;\n  }\n\n  .procedure-text {\n    margin: 0;\n    font-size: 27px;\n    line-height: 1.28;\n    text-align: left;\n  }\n\n  .disassembly {\n    margin-top: 38px;\n    margin-bottom: 21px;\n    font-size: 28px;\n    font-style: italic;\n    font-weight: normal;\n  }\n\n  .numbered-procedure {\n    display: grid;\n    grid-template-columns: 50px 1fr;\n    margin-left: 25px;\n    font-size: 27px;\n    line-height: 1.28;\n  }\n\n  .numbered-procedure .number {\n    padding-top: 1px;\n  }\n\n  @media (max-width: 1650px) {\n    .page {\n      transform-origin: top left;\n    }\n  }\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <div class=\"columns\">\n    <section class=\"left-column\">\n      <figure class=\"placeholder photo-m\" aria-label=\"Photograph M\">\n        <span class=\"figure-label\">M</span>\n        <figcaption class=\"image-description\">[Photo: canopy fabric repair area]</figcaption>\n      </figure>\n\n      <div class=\"step step-11\">\n        <div class=\"step-number\">11.</div>\n        <div>Trim the top and bottom edges as marked. <em>[Figure N]</em></div>\n      </div>\n\n      <figure class=\"placeholder photo-n\" aria-label=\"Photograph N\">\n        <span class=\"figure-label\">N</span>\n        <figcaption class=\"image-description\">[Photo: ruler and marking tool on canopy fabric]</figcaption>\n      </figure>\n\n      <div class=\"step step-12\">\n        <div class=\"step-number\">12.</div>\n        <div>\n          Pin the top seam back onto the top panel. Sew in place<br>\n          with either the single needle or if available, with the<br>\n          double needle machine and puller. <em>[Figure O]</em> Repeat<br>\n          with the bottom seam.\n        </div>\n      </div>\n\n      <figure class=\"placeholder photo-o\" aria-label=\"Photograph O\">\n        <span class=\"figure-label\">O</span>\n        <figcaption class=\"image-description\">[Photo: canopy fabric being stitched by machine]</figcaption>\n      </figure>\n\n      <div class=\"step step-13\">\n        <div class=\"step-number\">13.</div>\n        <div>Inspect finished work. <em>[Figure P]</em></div>\n      </div>\n\n      <div class=\"page-number\">7-28</div>\n    </section>\n\n    <section class=\"right-column\">\n      <figure class=\"placeholder photo-p\" aria-label=\"Photograph P\">\n        <span class=\"figure-label\">P</span>\n        <figcaption class=\"image-description\">[Photo: finished canopy repair]</figcaption>\n      </figure>\n\n      <h2 class=\"section-heading\">Inspection</h2>\n      <ul class=\"inspection-list\">\n        <li>Seam alignment should be straight.</li>\n        <li>Check the tension of the replaced rib material.</li>\n        <li>Make sure the seams are restitched correctly.</li>\n        <li>Verify that the crossport is cut correctly.</li>\n        <li>The line attachment tape must be replaced correctly<br>with no twists in the suspension line.</li>\n      </ul>\n\n      <h1 class=\"article-title\">Square Canopy—Pilot Chute Attachment Point<br>Repair</h1>\n\n      <ul class=\"details-list\">\n        <li>Applicable Products: Square main canopies</li>\n        <li>Description: Repair of the main canopy pilot chute<br>attachment point.</li>\n        <li>Authorized Repairmen: FAA Master Parachute Rigger</li>\n        <li>Materials: E thread; fabric—type and color to match,<br>reinforcing tape—type and color to match, reinforcing<br>fabric—type and color to match</li>\n        <li>Machines: 301 straight stitch—medium duty 7–11<br>SPI, 308 zigzag—medium duty 7–11 SPI, 1 inch ×<br>42 stitch bar tack</li>\n        <li>Equipment: Scissors, seam ripper, marking pencil,<br>and 12–inch ruler</li>\n      </ul>\n\n      <h2 class=\"subheading\">Procedure</h2>\n      <p class=\"procedure-text\">\n        This repair is quite common. If the canopy is inspected<br>\n        regularly, the beginnings of the damage will be noticed and<br>\n        a simple re-stitching will solve the problem. However, many<br>\n        times it is not and the resultant damage is quite extensive<br>\n        requiring repair of the rib, as well as the top panel.\n      </p>\n\n      <h3 class=\"disassembly\">Disassembly</h3>\n      <div class=\"numbered-procedure\">\n        <div class=\"number\">1.</div>\n        <div>\n          Inspect the area to determine the extent of the damage.<br>\n          <em>[Figure A]</em> If the stitching that holds the attachment<br>\n          point to the canopy is simply coming loose, re-stitch<br>\n          as per the original.\n        </div>\n      </div>\n    </section>\n  </div>\n</main>\n</body>\n</html>"
