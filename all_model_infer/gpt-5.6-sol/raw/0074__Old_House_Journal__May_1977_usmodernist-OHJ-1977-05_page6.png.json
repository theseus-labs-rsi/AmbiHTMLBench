x, transparent 2px 19px),\n      linear-gradient(112deg, #242424 0 18%, #6d6d6d 19% 43%, #292929 44% 76%, #8d8d8d 77% 100%);\n    filter: grayscale(1);\n  }\n\n  .former-photo::before {\n    content: \"\";\n    position: absolute;\n    left: 180px;\n    bottom: 65px;\n    width: 67px;\n    height: 167px;\n    border: 7px solid #181818;\n    transform: rotate(-1deg);\n    background:\n      radial-gradient(circle at 30% 20%, #aaa 0 8px, transparent 9px),\n      radial-gradient(circle at 65% 30%, #bdbdbd 0 12px, transparent 13px),\n      radial-gradient(circle at 42% 59%, #ccc 0 15px, transparent 16px),\n      #4b4b4b;\n    opacity: .85;\n  }\n\n  .former-photo::after {\n    content: \"\";\n    position: absolute;\n    left: 126px;\n    bottom: 0;\n    width: 116px;\n    height: 54px;\n    background: #464646;\n    box-shadow: 39px -20px 0 #545454;\n    transform: skewX(-18deg);\n    opacity: .85;\n  }\n\n  .restored-photo {\n    background:\n      linear-gradient(90deg, transparent 0 45%, rgba(235,235,235,.23) 45% 47%, transparent 47%),\n      repeating-linear-gradient(0deg, transparent 0 14px, rgba(35,35,35,.22) 14px 16px),\n      repeating-linear-gradient(90deg, transparent 0 33px, rgba(25,25,25,.2) 33px 35px),\n      linear-gradient(123deg, #171717 0 18%, #aaa 19% 43%, #777 44% 100%);\n    filter: grayscale(1);\n  }\n\n  .restored-photo::before {\n    content: \"\";\n    position: absolute;\n    right: 40px;\n    top: 182px;\n    width: 174px;\n    height: 164px;\n    border: 18px solid #8b8b8b;\n    border-top-width: 28px;\n    background:\n      linear-gradient(90deg, transparent 0 22%, #303030 23% 30%, transparent 31% 68%, #303030 69% 76%, transparent 77%),\n      linear-gradient(0deg, #222 0 52%, #8e8e8e 53%);\n    box-shadow: 0 -95px 0 34px rgba(148,148,148,.8);\n  }\n\n  .restored-photo::after {\n    content: \"\";\n    position: absolute;\n    left: 31px;\n    bottom: -21px;\n    width: 223px;\n    height: 93px;\n    border: 17px solid #777;\n    transform: