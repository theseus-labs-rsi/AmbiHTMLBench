00;\n  }\n\n  .report-stat-unit {\n    margin-left: .18em;\n    font-size: clamp(18px, 1.2vw, 40px);\n  }\n\n  .landscape {\n    position: absolute;\n    z-index: 1;\n    left: 3%;\n    bottom: -2%;\n    width: 96%;\n    height: 25%;\n    border: 0;\n    opacity: .38;\n    overflow: hidden;\n    color: transparent;\n  }\n\n  .mountain {\n    position: absolute;\n    bottom: 0;\n    width: 0;\n    height: 0;\n    border-left: 6vw solid transparent;\n    border-right: 6vw solid transparent;\n    border-bottom: 18vw solid #39c5bd;\n    filter: drop-shadow(0 5px 0 rgba(215,220,220,.65));\n  }\n\n  .mountain.one {\n    left: 1%;\n  }\n\n  .mountain.two {\n    left: 9%;\n    border-left-width: 5vw;\n    border-right-width: 5vw;\n    border-bottom-width: 14vw;\n    border-bottom-color: #74d8d2;\n  }\n\n  .building-shape {\n    position: absolute;\n    bottom: 2%;\n    width: 18%;\n    height: 45%;\n    border: 8px solid rgba(225,229,229,.85);\n    background:\n      linear-gradient(90deg, transparent 13%, #44c5bd 14% 17%, transparent 18% 35%, #44c5bd 36% 39%, transparent 40%),\n      rgba(255,255,255,.92);\n    box-shadow: 12px 10px 0 rgba(225,229,229,.45);\n    transform: skewY(-4deg);\n  }\n\n  .building-shape.a {\n    left: 35%;\n  }\n\n  .building-shape.b {\n    left: 61%;\n    width: 30%;\n    height: 53%;\n    background:\n      repeating-linear-gradient(0deg, transparent 0 12%, rgba(0,175,167,.45) 13% 17%),\n      repeating-linear-gradient(90deg, transparent 0 15%, rgba(0,175,167,.38) 16% 20%),\n      rgba(255,255,255,.95);\n  }\n\n  .tree-shape {\n    position: absolute;\n    bottom: 3%;\n    width: 0;\n    height: 0;\n    border-left: 2vw solid transparent;\n    border-right: 2vw solid transparent;\n    border-bottom: 6vw solid #00afa7;\n  }\n\n  .tree-shape.a {\n    left: 26%;\n  }\n\n  .tree-shape.b {\n    left: 57%;\n  }\n\n  .tree-shape.c {\n    left: 69%;\n  }\n\n  .page-number {\n    position: absolute;\n    z-index: 3;\n    bottom: 3.2%;\n    color: #111;\n    font-size: clamp(11px, .72vw, 24px);\n    font-weight: 400;\n  }\n\n  .page-left .page-number {\n    left: 4.8%;\n  }\n\n  .page-right .page-number {\n    right: 4.8%;\n  }\n\n  .right-content {\n    position: relative;\n    z-index: 2;\n    margin-top: 12.4%;\n  }\n\n  .framework-panel {\n    padding: 2.55% 1.8% 2.7%;\n    border-radius: 8px;\n    background: #e5f6f5;\n  }\n\n  .framework-item {\n    display: grid;\n    grid-template-columns: 13.5% 1fr;\n    min-height: 10.6vw;\n    margin-bottom: 2.55vw;\n    border: 1.5px solid #00afa7;\n    border-radius: 6px;\n    overflow: hidden;\n    background: #fff;\n  }\n\n  .framework-item:last-child {\n    margin-bottom: 0;\n  }\n\n  .framework-label {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: .8vw .3vw;\n    color: #fff;\n    text-align: center;\n    background: #08afa7;\n  }\n\n  .framework-icon {\n    position: relative;\n    width: 3.4vw;\n    height: 3.4vw;\n    min-width: 35px;\n    min-height: 35px;\n    margin-bottom: .45vw;\n    color: #fff;\n    font-size: clamp(24px, 2vw, 64px);\n    line-height: 1;\n  }\n\n  .framework-icon::before {\n    position: absolute;\n    inset: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .icon-governance::before { content: \"▱\"; }\n  .icon-system::before { content: \"⚙\"; }\n  .icon-platform::before { content: \"⊞\"; }\n  .icon-risk::before { content: \"◎\"; }\n  .icon-audit::before { content: \"♙\"; }\n\n  .framework-name {\n    font-size: clamp(13px, .82vw, 27px);\n    line-height: 1.7;\n    font-weight: 400;\n  }\n\n  .framework-body {\n    display: flex;\n    align-items: center;\n    padding: 1.05vw 1.65vw;\n    font-size: clamp(11px, .69vw, 23px);\n    line-height: 1.72;\n    font-weight: 300;\n  }\n\n  .framework-body ul {\n    width: 100%;\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n\n  .framework-body li {\n    position: relative;\n    margin: 0 0 .65em;\n    padding-left: 1.6em;\n  }\n\n  .framework-body li:last-child {\n    margin-bottom: 0;\n  }\n\n  .framework-body li::before {\n    content: \"•\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    color: #555;\n  }\n\n  .summary-band {\n    display: grid;\n    grid-template-columns: 14% 43% 43%;\n    height: 9.5vw;\n    margin-top: 1.4vw;\n    color: #00afa7;\n    background: #f0f9f8;\n  }\n\n  .summary-heading {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #fff;\n    text-align: center;\n    background: #08afa7;\n    font-size: clamp(13px, .76vw, 25px);\n    line-height: 1.45;\n  }\n\n  .summary-stat {\n    display: flex;\n    align-items: center;\n    justify-content: space-around;\n    gap: 1vw;\n    padding: 1vw 2vw;\n    border-right: 10px solid #fff;\n  }\n\n  .summary-stat:last-child {\n    border-right: 0;\n  }\n\n  .summary-label {\n    font-size: clamp(12px, .68vw, 22px);\n    line-height: 1.55;\n    font-weight: 300;\n  }\n\n  .summary-number {\n    white-space: nowrap;\n    font-size: clamp(42px, 2.75vw, 91px);\n    line-height: 1;\n    font-weight: 400;\n  }\n\n  .summary-number small {\n    margin-left: .12em;\n    font-size: 42%;\n  }\n\n  @media (max-width: 1450px) {\n    .framework-item {\n      min-height: 11vw;\n      margin-bottom: 2vw;\n    }\n\n    .framework-body {\n      line-height: 1.58;\n    }\n\n    .management-row {\n      grid-template-columns: 49% 43%;\n      gap: 3%;\n    }\n  }\n</style>\n</head>\n<body>\n<main class=\"spread\">\n  <div class=\"spread-inner\">\n    <section class=\"page page-left\" aria-label=\"第31页\">\n      <p class=\"report-name\">2024·美的集团ESG报告</p>\n\n      <div class=\"left-content\">\n        <h1 class=\"main-title\">绿色使命 推进环境友好</h1>\n\n        <p class=\"intro\">\n          美的集团积极承担绿色低碳发展的企业使命，不断优化和完善环境管理体系，并持续推动节能降耗和资源的高<br>\n          效利用。同时，我们始终关注生物多样性保护，并通过绿色融资助力低碳发展，为实现可持续发展目标贡献<br>\n          力量。\n        </p>\n\n        <h2 class=\"section-title\">绿色制造践行者</h2>\n        <p class=\"section-copy\">\n          美的集团把绿色环保的理念纳入生产运营全流程，严格遵守运营所在国家和地区的法律法规，并根据自身各运<br>\n          营场所的适用情况，制定并持续完善各项环境管理制度，确保环境管理体系持续有效运行。报告期内，美的集<br>\n          团未发生重大环境事故，未因环境事件受到重大的行政处罚。\n        </p>\n\n        <section class=\"management\">\n          <h2 class=\"management-title\">环境管理体系</h2>\n          <div class=\"management-row\">\n            <p class=\"management-copy\">\n              我们在“遵守法规，实现污染预防、营造绿色环境，共<br>\n              建美的家园”方针的指引下，从 EHS 治理架构、管理体<br>\n              系建设、信息化平台搭建、体系评审及认证等方面有效<br>\n              保障环境管理的稳健运作。2024年度，我们发布了<br>\n              《美的集团环境与职业健康安全管理政策》，明确EHS<br>\n              管理方针、管理目标等内容。\n            </p>\n\n            <aside class=\"report-card\">\n              <div class=\"report-card-title\">报告期末</div>\n              <div class=\"report-card-body\">\n                <div class=\"factory-icon\" aria-label=\"绿色工厂建筑图标\">\n                  <div class=\"factory-art\">\n                    <span class=\"factory-building\"></span>\n                    <span class=\"factory-tree\"></span>\n                    <span class=\"factory-ground\"></span>\n                  </div>\n                </div>\n                <div class=\"report-stat\">\n                  <span class=\"report-stat-label\">已成功建立国家级绿<br>色工厂</span>\n                  <span class=\"report-stat-number\">37</span><span class=\"report-stat-unit\">家</span>\n                </div>\n              </div>\n            </aside>\n          </div>\n        </section>\n      </div>\n\n      <figure class=\"placeholder landscape\" aria-label=\"底部绿色工厂与山林插画\">\n        <span class=\"mountain one\"></span>\n        <span class=\"mountain two\"></span>\n        <span class=\"building-shape a\"></span>\n        <span class=\"building-shape b\"></span>\n        <span class=\"tree-shape a\"></span>\n        <span class=\"tree-shape b\"></span>\n        <span class=\"tree-shape c\"></span>\n        [Illustration: bottom green factories, mountains, trees and solar panels]\n      </figure>\n\n      <span class=\"page-number\">31</span>\n    </section>\n\n    <section class=\"page page-right\" aria-label=\"第32页\">\n      <nav class=\"nav\" aria-label=\"报告章节导航\">\n        <span>关于本报告</span>\n        <span>走进美的</span>\n        <span>可持续发展治理</span>\n        <span class=\"active\">守护蓝色星球</span>\n        <span>构建和谐社区</span>\n        <span>践行科技尽善</span>\n        <span>共创繁荣生态</span>\n        <span>附录</span>\n      </nav>\n\n      <div class=\"right-content\">\n        <section class=\"framework-panel\">\n          <article class=\"framework-item\">\n            <div class=\"framework-label\">\n              <span class=\"framework-icon icon-governance\" aria-hidden=\"true\"></span>\n              <span class=\"framework-name\">EHS<br>治理架构</span>\n            </div>\n            <div class=\"framework-body\">\n              <ul>\n                <li>安全管理委员会作为集团EHS最高决策机构，统筹决策环境保护、安全生产及职业卫<br>生管理，负责EHS执行情况的监督与考核；</li>\n                <li>下设办公室作为执行机构，负责日常管理及定期汇报。各事业群/事业部建立属地化治<br>理架构，落实EHS政策、目标及管理要求。</li>\n              </ul>\n            </div>\n          </article>\n\n          <article class=\"framework-item\">\n            <div class=\"framework-label\">\n              <span class=\"framework-icon icon-system\" aria-hidden=\"true\"></span>\n              <span class=\"framework-name\">EHS<br>管理体系</span>\n            </div>\n            <div class=\"framework-body\">\n              <ul>\n                <li>依据法规、行业最佳实践及业务特性，落实既定EHS政策、体系标准，确保目标达成；</li>\n                <li>制定《EHS管理控制框架手册》，统一管理边界、流程管控及数据记录标准；</li>\n                <li>贯彻“一个美的，一个体系，一个标准”原则，构建覆盖关键领域的EHS技术标准与审<br>核体系，强化全集团规范化管理。</li>\n              </ul>\n            </div>\n          </article>\n\n          <article class=\"framework-item\">\n            <div class=\"framework-label\">\n              <span class=\"framework-icon icon-platform\" aria-hidden=\"true\"></span>\n              <span class=\"framework-name\">EHS<br>数智化平台</span>\n            </div>\n            <div class=\"framework-body\">\n              <ul>\n                <li>建立基于“智能采集、智能预警、智能管控、智能预测、智能决策、智能分析”的EHS数<br>智化平台，包括智慧环保、环保在线监测、环保设施维护、危废管理等模块；</li>\n                <li>对各基地主要排污口在线监测数据进行收集分析，实现对污染物的全面检测及精准超<br>标预警管理，达到全时段全场景的环境排污数据精准监控，确保排放合规。</li>\n              </ul>\n            </div>\n          </article>\n\n          <article class=\"framework-item\">\n            <div class=\"framework-label\">\n              <span class=\"framework-icon icon-risk\" aria-hidden=\"true\"></span>\n              <span class=\"framework-name\">EHS<br>风险管理</span>\n            </div>\n            <div class=\"framework-body\">\n              <ul>\n                <li>建立危险有害因素及环境因素辨识流程，主动识别、评估和监测自身运营过程中的环<br>境等EHS风险源并对各风险进行等级划分，针对性落实风险管控措施；</li>\n                <li>建立并健全针对突发环境事件等的EHS应急机制，对EHS风险事件进行分级管理，并<br>制定相应的预防和应急举措，确保建立快速有效的应急处理流程。</li>\n              </ul>\n            </div>\n          </article>\n\n          <article class=\"framework-item\">\n            <div class=\"framework-label\">\n              <span class=\"framework-icon icon-audit\" aria-hidden=\"true\"></span>\n              <span class=\"framework-name\">体系评审<br>与认证</span>\n            </div>\n            <div class=\"framework-body\">\n              <ul>\n                <li>各事业群 / 事业部实施年度 EHS 评审，覆盖程序文件执行、合规性及目标达成等维度；</li>\n                <li>开展年度集团层面评审，重点评估 EHS 管理制度及重点工作执行情况；</li>\n                <li>工厂年度进行EHS管理评审，评审结果由安委会汇总整理后向管理层汇报，包括工厂<br>合规管控、体系执行情况、不符合项关闭进度等。</li>\n              </ul>\n            </div>\n          </article>\n        </section>\n\n        <section class=\"summary-band\" aria-label=\"截至报告期末认证数据\">\n          <div class=\"summary-heading\">截至<br>报告期末</div>\n          <div class=\"summary-stat\">\n            <span class=\"summary-label\">ISO 14001 认证工厂</span>\n            <span class=\"summary-number\">37<small>家</small></span>\n          </div>\n          <div class=\"summary-stat\">\n            <span class=\"summary-label\">全球制造基地<br>环境管理体系<br>认证覆盖率</span>\n            <span class=\"summary-number\">100<small>%</small></span>\n          </div>\n        </section>\n      </div>\n\n      <span class=\"page-number\">32</span>\n    </section>\n  </div>\n</main>\n</body>\n</html>"
      },
      "finish_reason": "stop"
    }
