        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>2024·美的集团ESG报告 - 绿色使命 推进环境友好</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] }\n};\n</script>\n<script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * {\n    box-sizing: border-box;\n  }\n\n  html,\n  body {\n    margin: 0;\n    min-width: 1180px;\n    background: #fff;\n    color: #626262;\n    font-family: \"Microsoft YaHei\", \"PingFang SC\", \"Noto Sans CJK SC\", Arial, sans-serif;\n  }\n\n  body {\n    overflow-x: auto;\n  }\n\n  .spread {\n    position: relative;\n    width: 100vw;\n    min-width: 1180px;\n    aspect-ratio: 3307 / 2205;\n    overflow: hidden;\n    background: #fff;\n  }\n\n  .spread-inner {\n    position: absolute;\n    inset: 0;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n  }\n\n  .page {\n    position: relative;\n    min-width: 0;\n    height: 100%;\n    overflow: hidden;\n    background: #fff;\n  }\n\n  .page-left {\n    padding: 3.3% 4.8% 0;\n  }\n\n  .page-right {\n    padding: 3.3% 4.8% 0 5%;\n  }\n\n  .report-name {\n    position: absolute;\n    top: 4.9%;\n    left: 4.8%;\n    margin: 0;\n    color: #8b8b8b;\n    font-size: clamp(12px, .78vw, 27px);\n    font-weight: 300;\n    white-space: nowrap;\n  }\n\n  .nav {\n    position: absolute;\n    top: 4.85%;\n    left: 5%;\n    right: 4.8%;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: .6vw;\n    color: #888;\n    font-size: clamp(10px, .69vw, 23px);\n    font-weight: 300;\n    white-space: nowrap;\n  }\n\n  .nav .active {\n    padding: .08em .62em .15em;\n    border: 1.5px solid #00afa7;\n    border-radius: 1.1em;\n    color: #00afa7;\n    line-height: 1.15;\n  }\n\n  .left-content {\n    position: relative;\n    z-index: 2;\n    margin-top: 12.2%;\n  