        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>光明日报 2025年1月4日 星期六</title>\n  <script>\n    window.MathJax = {\n      tex: { inlineMath: [['$', '$'], ['\\\\(', '\\\\)']], displayMath: [['$$', '$$'], ['\\\\[', '\\\\]']] },\n      svg: { fontCache: 'global' }\n    };\n  </script>\n  <script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    html, body {\n      margin: 0;\n      padding: 0;\n      background: #fff;\n      color: #111;\n      font-family: \"Noto Serif CJK SC\", \"Songti SC\", SimSun, serif;\n    }\n    body {\n      width: 1240px;\n      margin: 0 auto;\n      padding: 26px 22px 34px;\n    }\n    .page {\n      width: 100%;\n      min-height: 1745px;\n    }\n    .masthead {\n      display: grid;\n      grid-template-columns: 48% 52%;\n      align-items: start;\n      min-height: 252px;\n      border-bottom: 1px solid #222;\n    }\n    .brand {\n      padding: 0 10px 0 20px;\n      text-align: center;\n    }\n    .brand-mark {\n      color: #bf0037;\n      font-family: \"KaiTi\", \"STKaiti\", cursive;\n      font-size: 92px;\n      line-height: .9;\n      font-weight: bold;\n      letter-spacing: 1px;\n      transform: skew(-9deg);\n      margin: 0 0 18px;\n      white-space: nowrap;\n    }\n    .brand-name {\n      font-family: Arial, sans-serif;\n      letter-spacing: 9px;\n      font-size: 20px;\n      margin-left: 11px;\n    }\n    .datebar {\n      background: #0875a6;\n      color: white;\n      margin-top: 12px;\n      height: 25px;\n      line-height: 25px;\n      font-size: 15px;\n      text-align: center;\n      letter-spacing: .4px;\n    }\n    .issue {\n      font-size: 13px;\n      padding: 9px 0 0;\n      white-space: nowrap;\n    }\n    .headline {\n      padding: 6px 0 0 30px;\n    }\n    .headline h1 {\n      margin: 0;\n      font-size: 43px;\n      line-height: 1.55;\n      font-weight: 900;\n      letter-spacing: 4px;\n    }\n    .headline .intro {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      column-gap: 15px;\n      margin-top: 7px;\n      font-size: 12px;\n      line-height: 1.5;\n      text-align: justify;\n    }\n    .rule {\n      border-top: 1px solid #111;\n      margin: 12px 0 8px;\n    }\n    .top-grid {\n      display: grid;\n      grid-template-columns: 49% 51%;\n      gap: 20px;\n      margin-top: 12px;\n    }\n    .left-column, .right-column { min-width: 0; }\n    .left-column {\n      border-right: 1px solid #222;\n      padding-right: 17px;\n    }\n    .right-column { padding-left: 3px; }\n    .article-grid {\n      display: grid;\n      grid-template-columns: 31% 35% 34%;\n      gap: 11px;\n      align-items: start;\n    }\n    .article {\n      font-size: 12px;\n      line-height: 1.55;\n      text-align: justify;\n    }\n    .article p {\n      margin: 0 0 8px;\n      text-indent: 2em;\n    }\n    .article h2 {\n      margin: 0 0 10px;\n      text-align: center;\n      font-size: 34px;\n      line-height: 1.25;\n      letter-spacing: 5px;\n      writing-mode: vertical-rl;\n      height: 370px;\n      margin-left: auto;\n      margin-right: auto;\n    }\n    .article h3 {\n      font-size: 22px;\n      line-height: 1.3;\n      margin: 0 0 7px;\n      text-align: center;\n      letter-spacing: 2px;\n    }\n    .vertical-title {\n      writing-mode: vertical-rl;\n      text-align: left;\n      height: 380px;\n      font-weight: bold;\n      font-size: 38px;\n      line-height: 1.5;\n      letter-spacing: 5px;\n      margin: 0 auto;\n    }\n    .byline {\n      text-align: center;\n      font-size: 11px;\n      margin: 4px 0 8px;\n    }\n    .ad {\n      border: 1px solid #b5a26a;\n      height: 92px;\n      margin: 8px 0 13px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      color: #537e52;\n      font-size: 2