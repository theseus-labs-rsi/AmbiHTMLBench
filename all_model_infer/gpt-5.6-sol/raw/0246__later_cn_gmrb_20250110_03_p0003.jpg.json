        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>光明日报 评论 03</title>\n  <script>\n    window.MathJax = {\n      tex: {inlineMath: [['$', '$'], ['\\\\(', '\\\\)']], displayMath: [['$$', '$$'], ['\\\\[', '\\\\]']]}\n    };\n  </script>\n  <script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    html, body {\n      margin: 0;\n      padding: 0;\n      background: #fff;\n      color: #111;\n    }\n    body {\n      font-family: \"Noto Serif CJK SC\", \"Songti SC\", \"SimSun\", serif;\n    }\n    .page {\n      width: 1280px;\n      min-height: 1810px;\n      margin: 0 auto;\n      padding: 21px 22px 30px;\n      overflow: hidden;\n      background: #fff;\n    }\n    .top-rule {\n      height: 9px;\n      background: #aaa;\n      margin-bottom: 10px;\n    }\n    .masthead {\n      height: 54px;\n      border-bottom: 1px solid #aaa;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n    }\n    .paper-name {\n      font-family: cursive;\n      font-size: 37px;\n      letter-spacing: 1px;\n      transform: skew(-8deg);\n      white-space: nowrap;\n    }\n    .date-line {\n      align-self: flex-end;\n      margin-bottom: 10px;\n      margin-left: auto;\n      margin-right: 15px;\n      font-family: Arial, sans-serif;\n      font-size: 9px;\n      font-weight: bold;\n      white-space: nowrap;\n    }\n    .page-label {\n      display: flex;\n      align-items: center;\n      gap: 14px;\n      white-space: nowrap;\n    }\n    .section-title {\n      color: #aaa;\n      font-size: 37px;\n      font-weight: 900;\n      line-height: 1;\n    }\n    .page-number {\n      font-family: Arial, sans-serif;\n      font-size: 40px;\n      font-weight: 300;\n    }\n    .content {\n      display: grid;\n      grid-template-columns: 700