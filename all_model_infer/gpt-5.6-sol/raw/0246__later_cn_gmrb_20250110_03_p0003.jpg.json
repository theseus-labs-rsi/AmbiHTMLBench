t: 1.55;\n      text-align: justify;\n      text-indent: 2em;\n      margin: 0 0 8px;\n    }\n    .article {\n      margin-top: 30px;\n    }\n    .article h2 {\n      font-size: 42px;\n      line-height: 1.2;\n      letter-spacing: -1px;\n      margin: 0 0 13px;\n      font-weight: 900;\n    }\n    .article h2 span {\n      display: block;\n    }\n    .article .columns {\n      min-height: 390px;\n    }\n    .bottom-article {\n      border-top: 1px solid #888;\n      margin-top: 23px;\n      padding-top: 36px;\n    }\n    .bottom-article h2 {\n      font-size: 38px;\n      line-height: 1.22;\n      margin-bottom: 12px;\n    }\n    .bottom-article .columns {\n      min-height: 330px;\n    }\n    .middle-heading {\n      color: #aaa;\n      font-size: 29px;\n      font-weight: 900;\n      line-height: 1;\n      margin: 0 0 18px;\n      border-bottom: 0;\n    }\n    .middle-heading small {\n      display: block;\n      color: #666;\n      font-size: 12px;\n      margin-top: 7px;\n      letter-spacing: 0;\n    }\n    .middle-columns {\n      column-count: 2;\n      column-gap: 18px;\n    }\n    .middle-columns p {\n      font-size: 12px;\n      line-height: 1.52;\n      text-align: justify;\n      text-indent: 2em;\n      margin: 0 0 9px;\n    }\n    .middle-columns p.no-indent {\n      text-indent: 0;\n    }\n    .author-note {\n      font-size: 11px;\n      font-weight: bold;\n      line-height: 1.4;\n      margin: 3px 0 12px;\n    }\n    .side-article {\n      border-top: 1px solid #888;\n      margin-top: 24px;\n      padding-top: 34px;\n    }\n    .side-article h2 {\n      font-size: 37px;\n      line-height: 1.2;\n      margin: 0 0 12px;\n      font-weight: 900;\n    }\n    .side-article h2 span {\n      display: block;\n    }\n    .side-article .middle-columns {\n      min-height: 360px;\n    }\n    .side-label {\n      color: #aaa;\n      font-size: 26px;\n      font-weight: bold;\n      margin: 20px 0 10px;\n    }\n    .vertical-title {\n      writing-mode: vertical-rl;\n      text-orientation: upright;\n      font-size: 39px;\n      line-height: 1.32;\n      font-weight: 900;\n      letter-spacing: 2px;\n      height: 760px;\n      margin: 0 auto;\n    }\n    .vertical-author {\n      writing-mode: vertical-rl;\n      text-orientation: upright;\n      font-size: 13px;\n      margin: 20px auto 0;\n      height: 95px;\n    }\n    .placeholder {\n      border: 1px solid #aaa;\n      color: #777;\n      min-height: 42px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 11px;\n      text-align: center;\n    }\n    @media (max-width: 900px) {\n      .page {\n        width: 100%;\n        min-height: auto;\n        padding: 12px;\n      }\n      .content {\n        display: block;\n      }\n      .middle-area, .vertical-area {\n        margin-top: 28px;\n      }\n      .vertical-area {\n        display: none;\n      }\n      .headline { font-size: 10vw; }\n      .article h2, .bottom-article h2 { font-size: 8vw; }\n      .columns, .small-columns { column-count: 2; }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <div class=\"top-rule\"></div>\n\n    <header class=\"masthead\">\n      <div class=\"paper-name\">光明日报</div>\n      <div class=\"date-line\">2025年1月10日　星期五　版编：吴晓杰、李霞　本版编辑：朱波、赵蒙明</div>\n      <div class=\"page-label\">\n        <div class=\"section-title\">评论</div>\n        <div class=\"page-number\">03</div>\n      </div>\n    </header>\n\n    <section class=\"content\">\n      <div class=\"left-area\">\n        <article>\n          <h1 class=\"headline\">\n            <span>高水平开放</span>\n            <span>为经济高质量发展赋能</span>\n          </h1>\n          <div class=\"byline\"><span class=\"checkbox\"></span>陆 影</div>\n\n          <div class=\"lead-layout\">\n            <aside class=\"forum\">\n              <h3>光明论坛</h3>\n              <div class=\"sub\">中国新闻奖名专栏</div>\n              <div class=\"mail\">评论版投稿邮箱<br>gmplun@163.com</div>\n              <p class=\"columns\" style=\"column-count:1;text-indent:2em;margin-top:15px;font-size:12px;line-height:1.55;text-align:justify;\">\n                近日发布的《高质量发展报告书》（中国经济高质量发展报告（2024）——践行开放发展理念）显示，2013年至2023年，中国经济不断发展，成为世界第二大经济体。文章指出，高水平开放为经济高质量发展赋能，全面适应我国高质量发展的新阶段。\n              </p>\n            </aside>\n\n            <div class=\"columns\">\n              <p>向着开放而行，为今年经济工作高质量开局，元旦新年基础数据持续传来，既有稳中有进的数字，也有攻坚克难的决心与鼓舞智慧。</p>\n              <p>报告显示，我国制造业开放指数增长了72.8%，这一数据背后是经济体制、法律法规、政策制度等全方位的改革与创新。制度型开放，既是国内经济转型升级的内在要求，也是中国深度融入全球经济、提升国际竞争力的战略选择。</p>\n              <p>在世界经济复苏乏力、地缘政治风险上升的背景下，扩大高水平开放，推动经济高质量发展，既是主动作为，也是应对挑战的必然选择。</p>\n              <p>开放带来进步，封闭必然落后。改革开放以来，我国经济社会发展取得举世瞩目的成就，靠的就是不断扩大开放、不断深化改革。</p>\n              <p>从商品和要素流动型开放，向规则、规制、管理、标准等制度型开放转变，是高水平开放的必然要求。要以更加主动的开放姿态，推动更深层次改革。</p>\n              <p>当前，国际环境复杂多变，国内改革发展稳定任务繁重，必须坚定不移推进高水平开放，充分利用国内国际两个市场、两种资源。</p>\n              <p>海纳百川，有容乃大。以开放促改革、促发展，是我国现代化建设不断取得新成就的重要法宝。</p>\n              <p>越是面对风险挑战，越要坚持扩大开放，主动对接国际高标准经贸规则，持续建设市场化、法治化、国际化一流营商环境。</p>\n              <p>推动高水平开放，要进一步优化开放布局，拓展国际合作空间，增强国内国际两个市场的联动效应。</p>\n              <p>（作者系中央党校经济学部研究员）</p>\n            </div>\n          </div>\n\n          <article class=\"article\">\n            <h2>跑出体育强国建设“加速度”</h2>\n            <div class=\"byline\"><span class=\"checkbox\"></span>何 玲</div>\n            <div class=\"small-columns\">\n              <p>近日，国家统计局、国家体育总局发布数据显示，2023年全国体育产业总规模达3万亿元，增加值超过1.4万亿元。体育产业已经成为国民经济的重要组成部分。</p>\n              <p>体育强国建设是中国式现代化的重要内容。推动体育事业和体育产业协调发展，必须坚持以人民为中心的发展思想。</p>\n              <p>从全民健身到竞技体育，从体育消费到体育产业，体育正在更好满足人民群众日益增长的美好生活需要。</p>\n              <p>加快体育强国建设，需要完善公共体育服务体系，促进群众体育、竞技体育和体育产业全面发展。</p>\n              <p>体育产业是朝阳产业，也是绿色产业、健康产业。要释放体育消费潜力，推动体育产业高质量发展。</p>\n              <p>让更多人享受运动、热爱运动、参与运动，体育强国建设就有了更加坚实的群众基础。</p>\n              <p>（作者系上海体育大学体育学院体育健康学院院长）</p>\n            </div>\n          </article>\n\n          <article class=\"bottom-article\">\n            <h2>\n              <span>沉浸式演出</span>\n              <span>助力体验经济蓬勃发展</span>\n            </h2>\n            <div class=\"byline\"><span class=\"checkbox\"></span>周 余</div>\n            <div class=\"small-columns\">\n              <p>在河北廊坊，“只有红楼梦·戏剧幻城”演出现场人头攒动，观众沉浸其中。2024年以来，沉浸式演出蓬勃发展，接待游客超百万人次。</p>\n              <p>沉浸式演出突破传统舞台的空间限制，通过技术手段、情境营造和互动体验，为观众带来更加丰富的文化消费体验。</p>\n              <p>年轻人的时尚潮流正在不断转化为新的消费需求。沉浸式演出将文化内容与文旅消费深度结合，形成新的消费增长点。</p>\n              <p>从空间形态到叙事方式，沉浸式演出不断拓展艺术表达边界，推动文艺创作与数字技术深度融合。</p>\n              <p>体验经济的发展，需要更丰富的消费场景、更优质的服务和更有吸引力的文化产品。</p>\n              <p>让文化消费成为生活方式，沉浸式演出还需要在内容品质、运营管理和公共服务方面持续提升。</p>\n            </div>\n          </article>\n        </article>\n      </div>\n\n      <div class=\"middle-area\">\n        <article>\n          <h2 class=\"middle-heading\">光明时评<small>中国新闻奖名专栏</small></h2>\n          <div class=\"middle-columns\">\n            <p>近日，国务院办公厅印发《关于严格规范涉企行政检查的意见》，着重解决行政检查事项多、频次高、随意性大，以及责任性检查问题。</p>\n            <p>此次意见的出台，体现了对企业关切的积极回应，也为进一步优化营商环境、激发市场活力提供了制度保障。</p>\n            <p>作为新时代全面深化改革开放的重要举措，相关政策将进一步推动政府职能转变，提升服务企业的能力和水平。</p>\n            <p>良好的营商环境，是企业发展的沃土。要持续完善公平竞争制度，依法保护各类经营主体合法权益。</p>\n            <p>一方面，积极改革，进一步厘清政府与市场的作用边界，促进市场竞争和有效市场更好结合。</p>\n            <p>另一方面，要加快创新，强化场景引领，进一步推动政府数字化、智能化升级。</p>\n            <p>让企业有感、市场有效、发展有力，需要政策落实落细，需要各部门协同配合，更需要以企业需求为导向。</p>\n            <p>改革只有进行时，没有完成时。持续优化发展环境，才能更好激发全社会创新创造活力。</p>\n            <p>（作者系国家发展和改革委员会经济研究所与管理研究院研究员）</p>\n          </div>\n        </article>\n\n        <article class=\"side-article\">\n          <h2>\n            <span>给“星星的孩子”</span>\n            <span>更优质教育</span>\n          </h2>\n          <div class=\"byline\"><span class=\"checkbox\"></span>李 健</div>\n          <div class=\"side-label\">新闻随笔</div>\n          <div class=\"middle-columns\">\n            <p>孤独症是一种神经发育障碍性疾病，患儿行为模式刻板，难以顺畅地理解他人情绪，也缺乏社交技巧。</p>\n            <p>对“星星的孩子”，教育要给予更多关注和支持，帮助他们更好地融入社会。</p>\n            <p>优质教育不仅要传授知识，更要尊重差异、发现潜能，帮助每一个孩子健康成长。</p>\n            <p>近年来，我国特殊教育事业取得积极进展，特殊教育保障体系不断完善。</p>\n            <p>让特殊儿童享有公平而有质量的教育，是教育现代化的重要内容。</p>\n            <p>学校、家庭和社会应当共同努力，为特殊儿童创造更加包容、友善、平等的成长环境。</p>\n            <p>教育的本质是点亮生命。让每个孩子都拥有实现梦想的机会，是全社会共同的责任。</p>\n            <p>（作者系北京航空航天大学公共管理学院教授）</p>\n          </div>\n        </article>\n      </div>\n\n      <aside class=\"vertical-area\">\n        <div class=\"vertical-title\">积极促进有为政府和有效市场更好结合</div>\n        <div class=\"vertical-author\">□　工商伟</div>\n      </aside>\n    </section>\n  </main>\n</body>\n</html>"
      },
