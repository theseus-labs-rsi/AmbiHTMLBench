        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>光明日报 2025年1月25日</title>\n  <script>\n    window.MathJax = {\n      tex: { inlineMath: [['$', '$'], ['\\\\(', '\\\\)']] },\n      svg: { fontCache: 'global' }\n    };\n  </script>\n  <script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js\"></script>\n  <style>\n    * {\n      box-sizing: border-box;\n    }\n\n    html,\n    body {\n      margin: 0;\n      padding: 0;\n      background: #fff;\n      color: #111;\n    }\n\n    body {\n      font-family: \"Noto Serif CJK SC\", \"Songti SC\", \"SimSun\", serif;\n    }\n\n    .page {\n      width: 1262px;\n      min-height: 1704px;\n      margin: 0 auto;\n      padding: 34px 22px 28px;\n      overflow: hidden;\n      background: #fff;\n    }\n\n    .masthead {\n      display: grid;\n      grid-template-columns: 49% 51%;\n      min-height: 290px;\n      border-bottom: 2px solid #777;\n      padding-bottom: 11px;\n    }\n\n    .brand {\n      padding: 0 10px;\n    }\n\n    .brand-name {\n      height: 174px;\n      color: #c90035;\n      font-family: \"STKaiti\", \"KaiTi\", cursive;\n      font-size: 105px;\n      font-weight: 700;\n      letter-spacing: 19px;\n      line-height: 1.4;\n      white-space: nowrap;\n      transform: scaleY(1.08);\n      transform-origin: left top;\n    }\n\n    .brand-en {\n      margin: 2px 0 15px 150px;\n      font-family: Arial, sans-serif;\n      font-size: 20px;\n      letter-spacing: 8px;\n    }\n\n    .date-bar {\n      height: 27px;\n      background: #0579aa;\n      color: white;\n      padding: 3px 55px;\n      font-family: Arial, \"SimSun\", sans-serif;\n      font-size: 16px;\n      white-space: nowrap;\n    }\n\n    .publication-line {\n      padding: 17px 18px 0;\n      font-size: 12px;\n      font-weight: 700;\n      white-space: nowrap;\n    }\n\n    .header-news {\n      padding