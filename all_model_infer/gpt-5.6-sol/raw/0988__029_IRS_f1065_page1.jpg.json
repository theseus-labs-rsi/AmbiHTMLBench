        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Form 1065 (2025) — U.S. Return of Partnership Income</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] }\n};\n</script>\n<script defer src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  html, body { margin: 0; padding: 0; background: #fff; color: #000; }\n  body { font-family: Arial, Helvetica, sans-serif; }\n  .page {\n    width: 1500px;\n    min-height: 1970px;\n    margin: 0 auto;\n    padding: 92px 88px 42px;\n    background: white;\n  }\n  .bold { font-weight: 700; }\n  .italic { font-style: italic; }\n  .small { font-size: 14px; }\n  .nowrap { white-space: nowrap; }\n  .checkbox {\n    display: inline-block;\n    width: 24px;\n    height: 24px;\n    border: 1.8px solid #000;\n    vertical-align: -5px;\n    margin: 0 7px 0 3px;\n  }\n  .checkbox.smallbox {\n    width: 21px;\n    height: 21px;\n    vertical-align: -4px;\n    margin-right: 5px;\n  }\n  .fill-line {\n    display: inline-block;\n    height: 20px;\n    border-bottom: 1px dashed #000;\n    vertical-align: bottom;\n  }\n\n  /* Header */\n  .header {\n    display: grid;\n    grid-template-columns: 240px 1fr 215px;\n    border-bottom: 3px solid #000;\n  }\n  .header-left {\n    min-height: 138px;\n    padding-right: 13px;\n    border-right: 2px solid #000;\n  }\n  .form-mark {\n    display: flex;\n    align-items: flex-end;\n    line-height: 1;\n    margin-bottom: 23px;\n  }\n  .form-word { font-size: 17px; margin-right: 8px; margin-bottom: 7px; }\n  .form-number { font-size: 63px; font-weight: 800; letter-spacing: -3px; }\n  .agency { font-size: 18px; line-height: 1.25; }\n  .header-center {\n    padding: 0 5px 10px;\n    text-align: center;\n  }\n  .header-title {\n    margin: -2px 0 15px;\n    font-size: 37px;\n    line-height: 1.05;\n    font-weight: 800;\n  }\n  .tax-year {\n    font-size: 18px;\n    font-weight: 700;\n    white-space: nowrap;\n    margin-bottom: 11px;\n  }\n  .header-instructions {\n    font-size: 21px;\n    font-weight: 700;\n  }\n  .header-right {\n    border-left: 2px solid #000;\n    text-align: center;\n  }\n  .omb {\n    text-align: left;\n    padding: 8px 0 7px 28px;\n    font-size: 17px;\n    border-bottom: 1px solid #000;\n  }\n  .year {\n    margin-top: 20px;\n    font-size: 54px;\n    line-height: 1;\n    letter-spacing: 3px;\n    font-weight: 700;\n  }\n  .year .outline {\n    color: white;\n    -webkit-text-stroke: 1.4px black;\n    font-weight: 500;\n  }\n\n  /* Identification fields */\n  .identity {\n    display: grid;\n    grid-template-columns: 240px 1fr 215px;\n    height: 216px;\n  }\n  .abc {\n    border-right: 2px solid #000;\n    display: grid;\n    grid-template-rows: 65px 65px 86px;\n  }\n  .abc-row {\n    padding: 3px 0;\n    border-bottom: 1px solid #000;\n    font-size: 18px;\n    white-space: nowrap;\n  }\n  .abc-row:last-child { border-bottom: 0; }\n  .letter {\n    display: inline-block;\n    width: 23px;\n    font-weight: 700;\n  }\n  .partner-fields {\n    border-right: 2px solid #000;\n    display: grid;\n    grid-template-rows: 65px 65px 86px;\n  }\n  .field {\n    position: relative;\n    padding: 3px 10px;\n    border-bottom: 1px solid #000;\n    font-size: 18px;\n  }\n  .field:last-child { border-bottom: 0; }\n  .street-row {\n    display: grid;\n    grid-template-columns: 1fr 180px;\n    border-bottom: 1px solid #000;\n  }\n  .street-row .field { border-bottom: 0; }\n  .street-row .field + .field { border-left: 1px solid #000; }\n  .city-row {\n    display: grid;\n    grid-template-columns: 28% 28% 28% 16%;\n  }\n  .city-row .field { border-bottom: 0; border-right: 1px solid #000; }\n  .city-row .field:last-child { border-right: 0; }\n  .right-fields {\n    display: grid;\n    grid-template-rows: 81px 65px 70px;\n  }\n  .right-field {\n    padding: 3px 10px;\n    border-bottom: 1px solid #000;\n    font-size: 17px;\n  }\n  .right-field:last-child { border-bottom: 0; }\n  .right-letter {\n    display: inline-block;\n    width: 25px;\n    font-weight: 700;\n  }\n  .asset-dollar { display: block; margin-top: 15px; font-size: 22px; }\n\n  /* Options */\n  .options {\n    border-top: 1px solid #000;\n    border-bottom: 2px solid #000;\n    font-size: 22px;\n    line-height: 1.3;\n  }\n  .option-row {\n    display: flex;\n    min-height: 33px;\n    align-items: center;\n    white-space: nowrap;\n  }\n  .option-letter {\n    width: 37px;\n    font-weight: 700;\n    font-size: 23px;\n  }\n  .option-content { flex: 1; }\n  .option-content .choice { margin-left: 19px; }\n  .entry-dash {\n    display: inline-block;\n    border-bottom: 1px dashed #000;\n    height: 22px;\n    vertical-align: top;\n  }\n  .caution {\n    border-top: 1px solid #000;\n    padding: 1px 0 2px;\n    font-size: 21px;\n    white-space: nowrap;\n  }\n\n  /* Financial form */\n  .financial {\n    border-bottom: 2px solid #000;\n  }\n  .section {\n    display: grid;\n    grid-template-columns: 40px 1fr;\n    border-bottom: 2px solid #000;\n  }\n  .section:last-child { border-bottom: 0; }\n  .vertical-title {\n    border-right: 1.8px solid #000;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    overflow: hidden;\n  }\n  .vertical-title span {\n    writing-mode: vertical-rl;\n    transform: rotate(180deg);\n    font-size: 24px;\n    line-height: 1;\n    font-weight: 700;\n    white-space: nowrap;\n  }\n  .vertical-title .subnote {\n    font-size: 14px;\n    font-weight: 400;\n    margin-bottom: 7px;\n  }\n  .rows { width: 100%; }\n  .item-row {\n    display: grid;\n    grid-template-columns: 67px minmax(0, 1fr) 60px 205px;\n    min-height: 32px;\n    font-size: 22px;\n    line-height: 1.15;\n  }\n  .item-row.major { min-height: 35px; }\n  .item-row > div { display: flex; align-items: center; }\n  .line-no {\n    justify-content: center;\n    font-weight: 700;\n    padding-right: 5px;\n  }\n  .description {\n    position: relative;\n    min-width: 0;\n    padding-right: 8px;\n    white-space: nowrap;\n    overflow: hidden;\n  }\n  .description .text {\n    position: relative;\n    z-index: 2;\n    background: white;\n    padding-right: 7px;\n  }\n  .description::after {\n    content: \"·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·\";\n    position: absolute;\n    z-index: 1;\n    right: 8px;\n    left: 5px;\n    bottom: 5px;\n    overflow: hidden;\n    white-space: nowrap;\n    letter-spacing: 5px;\n    font-size: 16px;\n  }\n  .description.no-dots::after { content: \"\"; }\n  .box-ref {\n    justify-content: center;\n    border-left: 1.7px solid #000;\n    border-bottom: 1px solid #000;\n    font-weight: 700;\n  }\n  .amount {\n    border-left: 1.7px solid #000;\n    border-bottom: 1px solid #000;\n  }\n  .shade { background: #bbb; }\n  .split-desc {\n    display: grid !important;\n    grid-template-columns: 1fr 60px 200px;\n    padding: 0 !important;\n  }\n  .split-desc > span:first-child {\n    display: flex;\n    align-items: center;\n    padding-left: 0;\n  }\n  .inner-ref {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    height: 100%;\n    border: 1.5px solid #000;\n    border-top: 0;\n    font-weight: 700;\n  }\n  .inner-entry {\n    border-bottom: 1px solid #000;\n    height: 100%;\n  }\n  .bank-row { min-height: 34px; }\n  .bank-boxes {\n    font-family: monospace;\n    font-size: 27px;\n    letter-spacing: 2px;\n  }\n\n  /* Signature and paid preparer */\n  .signature {\n    display: grid;\n    grid-template-columns: 140px 1fr;\n    min-height: 151px;\n    border-bottom: 2px solid #000;\n  }\n  .sign-label, .paid-label {\n    font-size: 30px;\n    line-height: 1.1;\n    font-weight: 700;\n    padding-top: 31px;\n    border-right: 2px solid #000;\n  }\n  .sign-body { padding: 6px 10px 0; }\n  .declaration {\n    font-size: 17px;\n    line-height: 1.1;\n    min-height: 63px;\n  }\n  .signature-lower {\n    display: grid;\n    grid-template-columns: 1fr 275px;\n    gap: 14px;\n  }\n  .signature-lines {\n    display: grid;\n    grid-template-columns: 1fr 270px;\n    gap: 18px;\n    padding-top: 30px;\n  }\n  .signature-line, .date-line {\n    border-top: 1px solid #000;\n    padding: 4px 6px;\n    font-size: 16px;\n  }\n  .discuss {\n    border: 6px solid #000;\n    font-size: 17px;\n    padding: 5px 8px;\n    line-height: 1.18;\n    min-height: 86px;\n  }\n\n  .paid {\n    display: grid;\n    grid-template-columns: 140px 1fr;\n    min-height: 164px;\n    border-bottom: 2px solid #000;\n  }\n  .paid-label { padding-top: 10px; }\n  .paid-body {\n    display: grid;\n    grid-template-columns: 1fr 325px;\n  }\n  .paid-left {\n    display: grid;\n    grid-template-rows: 68px 34px 34px;\n  }\n  .paid-top {\n    display: grid;\n    grid-template-columns: 410px 1fr 160px;\n    border-bottom: 1px solid #000;\n  }\n  .paid-cell {\n    padding: 4px 10px;\n    font-size: 17px;\n    border-right: 1px solid #000;\n  }\n  .firm-row {\n    border-bottom: 1px solid #000;\n    padding: 4px 10px;\n    font-size: 17px;\n  }\n  .paid-right {\n    display: grid;\n    grid-template-rows: 68px 34px 34px;\n  }\n  .right-paid-top {\n    display: grid;\n    grid-template-columns: 160px 1fr;\n    border-bottom: 1px solid #000;\n  }\n  .right-paid-top > div {\n    padding: 4px 9px;\n    font-size: 17px;\n    border-right: 1px solid #000;\n  }\n  .paid-right-row {\n    padding: 4px 9px;\n    border-bottom: 1px solid #000;\n    font-size: 17px;\n  }\n  .footer {\n    display: grid;\n    grid-template-columns: 1fr 260px 500px;\n    font-size: 17px;\n    align-items: center;\n    padding-top: 8px;\n  }\n  .footer .notice { font-weight: 700; font-size: 20px; }\n  .footer .catalog { text-align: center; }\n  .footer .form-footer { text-align: right; }\n  .footer strong { font-size: 22px; }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <header class=\"header\">\n    <div class=\"header-left\">\n      <div class=\"form-mark\">\n        <span class=\"form-word\">Form</span>\n        <span class=\"form-number\">1065</span>\n      </div>\n      <div class=\"agency\">Department of the Treasury<br>Internal Revenue Service</div>\n    </div>\n\n    <div class=\"header-center\">\n      <div class=\"header-title\">U.S. Return of Partnership Income</div>\n      <div class=\"tax-year\">\n        For calendar year 2025, or tax year beginning\n        <span class=\"fill-line\" style=\"width:180px\"></span>, 2025, ending\n        <span class=\"fill-line\" style=\"width:180px\"></span>, 20<span class=\"fill-line\" style=\"width:35px\"></span>.\n      </div>\n      <div class=\"header-instructions\">Go to <span class=\"italic\">www.irs.gov/Form1065</span> for instructions and the latest information.</div>\n    </div>\n\n    <div class=\"header-right\">\n      <div class=\"omb\">OMB No. 1545-0123</div>\n      <div class=\"year\"><span class=\"outline\">20</span>25</div>\n    </div>\n  </header>\n\n  <section class=\"identity\">\n    <div class=\"abc\">\n      <div class=\"abc-row\"><span class=\"letter\">A</span>Principal business activity</div>\n      <div class=\"abc-row\"><span class=\"letter\">B</span>Principal product or service</div>\n      <div class=\"abc-row\"><span class=\"letter\">C</span>Business code number</div>\n    </div>\n\n    <div class=\"partner-fields\">\n      <div class=\"field\">Name of partnership</div>\n      <div class=\"street-row\">\n        <div class=\"field\">Number and street</div>\n        <div class=\"field\">Room or suite no.</div>\n      </div>\n      <div class=\"city-row\">\n        <div class=\"field\">City or town</div>\n        <div class=\"field\">State or province</div>\n        <div class=\"field\">Country</div>\n        <div class=\"field\">ZIP or foreign<br>postal code</div>\n      </div>\n    </div>\n\n    <div class=\"right-fields\">\n      <div class=\"right-field\"><span class=\"right-letter\">D</span><strong>Employer<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;identification number</strong></div>\n      <div class=\"right-field\"><span class=\"right-letter\">E</span>Date business started</div>\n      <div class=\"right-field\"><span class=\"right-letter\">F</span>Total assets <span class=\"small\">(see instructions)</span><span class=\"asset-dollar\">$</span></div>\n    </div>\n  </section>\n\n  <section class=\"options\">\n    <div class=\"option-row\">\n      <div class=\"option-letter\">G</div>\n      <div class=\"option-content\">\n        Check applicable boxes:\n        <span class=\"choice\"><strong>(1)</strong><span class=\"checkbox\"></span>Initial return</span>\n        <span class=\"choice\"><strong>(2)</strong><span class=\"checkbox\"></span>Final return</span>\n        <span class=\"choice\"><strong>(3)</strong><span class=\"checkbox\"></span>Name change</span>\n        <span class=\"choice\"><strong>(4)</strong><span class=\"checkbox\"></span>Address change</span>\n        <span class=\"choice\"><strong>(5)</strong><span class=\"checkbox\"></span>Amended return</span>\n      </div>\n    </div>\n    <div class=\"option-row\">\n      <div class=\"option-letter\">H</div>\n      <div class=\"option-content\">\n        Check accounting method:\n        <span class=\"choice\"><strong>(1)</strong><span class=\"checkbox\"></span>Cash</span>\n        <span class=\"choice\"><strong>(2)</strong><span class=\"checkbox\"></span>Accrual</span>\n        <span class=\"choice\"><strong>(3)</strong><span class=\"checkbox\"></span>Other (specify):\n          <span class=\"entry-dash\" style=\"width:275px\"></span>\n        </span>\n      </div>\n    </div>\n    <div class=\"option-row\">\n      <div class=\"option-letter\">I</div>\n      <div class=\"option-content\">Number of Schedules K-1. Attach one for each person who was a partner at any time during the tax year:\n        <span class=\"entry-dash\" style=\"width:275px; float:right\"></span>\n      </div>\n    </div>\n    <div class=\"option-row\">\n      <div class=\"option-letter\">J</div>\n      <div class=\"option-content\">Check if Schedules C and M-3 are attached <span class=\"checkbox\" style=\"float:right\"></span></div>\n    </div>\n    <div class=\"option-row\">\n      <div class=\"option-letter\">K</div>\n      <div class=\"option-content\">\n        Check if partnership:\n        <span class=\"choice\"><strong>(1)</strong><span class=\"checkbox\"></span>Aggregated activities for section 465 at-risk purposes</span>\n        <span class=\"choice\"><strong>(2)</strong><span class=\"checkbox\"></span>Grouped activities for section 469 passive activity purposes</span>\n      </div>\n    </div>\n    <div class=\"caution\"><strong><em>Caution:</em></strong> Include <strong>only</strong> trade or business income and expenses on lines 1a through 23 below. See instructions for more information.</div>\n  </section>\n\n  <main class=\"financial\">\n    <section class=\"section\">\n      <div class=\"vertical-title\"><span>Income</span></div>\n      <div class=\"rows\">\n        <div class=\"item-row major\">\n          <div class=\"line-no\">1a</div>\n          <div class=\"description no-dots\">\n            <span class=\"text\">Gross receipts or sales <span class=\"fill-line\" style=\"width:235px\"></span>&nbsp;&nbsp;&nbsp;&nbsp; <strong>b</strong>&nbsp; Less returns and allowances <span class=\"fill-line\" style=\"width:200px\"></span>&nbsp;&nbsp;&nbsp;&nbsp; <strong>c</strong>&nbsp; Balance</span>\n          </div>\n          <div class=\"box-ref\">1c</div><div class=\"amount\"></div>\n        </div>\n        <div class=\"item-row\">\n          <div class=\"line-no\">2</div>\n          <div class=\"description\"><span class=\"text\">Cost of goods sold (attach Form 1125-A)</span></div>\n          <div class=\"box-ref\">2</div><div class=\"amount\"></div>\n        </div>\n        <div class=\"item-row\">\n          <div class=\"line-no\">3</div>\n          <div class=\"description\"><span class=\"text\">Gross profit. Subtract line 2 from line 1c</span></div>\n          <div class=\"box-ref\">3</div><div class=\"amount\"></div>\n        </div>\n        <div class=\"item-row\">\n          <div class=\"line-no\">4</div>\n          <div class=\"description\"><span class=\"text\">Ordinary income (loss) from other partnerships, estates, and trusts (attach statement)</span></div>\n          <div class=\"box-ref\">4</div><div class=\"amount\"></div>\n        </div>\n        <div class=\"item-row\">\n          <div class=\"line-no\">5</div>\n          <div class=\"description\"><span class=\"text\">Net farm profit (loss) (attach Schedule F (Form 1040))</span></div>\n          <div class=\"box-ref\">5</div><div class=\"amount\"></div>\n        </div>\n        <div class=\"item-row\">\n          <div class=\"line-no\">6</div>\n          <div class=\"description\"><span class=\"text\">Net gain (loss) from Form 4797, Part II, line 17 (attach Form 4797)</span></div>\n          <div class=\"box-ref\">6</div><div class=\"amount\"></div>\n        </div>\n        <div class=\"item-row\">\n          <div class=\"line-no\">7</div>\n          <div class=\"description\"><span class=\"text\">Other income (loss) (attach statement)</span></div>\n          <div class=\"box-ref\">7</div><div class=\"amount\"></div>\n        </div>\n        <div class=\"item-row major\">\n          <div class=\"line-no\">8</div>\n          <div class=\"description\"><span class=\"text\"><strong>Total income (loss).</strong> Combine lines 3 through 7</span></div>\n          <div class=\"box-ref\">8</div><div class=\"amount\"></div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section\">\n      <div class=\"vertical-title\">\n        <span> Deductions <span class=\"subnote\">(see instructions for limitations)</span></span>\n      </div>\n      <div class=\"rows\">\n        <div class=\"item-row\">\n          <div class=\"line-no\">9</div>\n          <div class=\"description\"><span class=\"text\">Salaries and wages (other than to partners) (less employment credits)</span></div>\n          <div class=\"box-ref\">9</div><div class=\"amount\"></div>\n        </div>\n        <div class=\"item-row\">\n          <div class=\"line-no\">10</div>\n          <div class=\"description\"><span class=\"text\">Guaranteed payments to partners</span></div>\n          <div class=\"box-ref\">10</div><div class=\"amount\"></div>\n        </div>\n        <div class=\"item-row\">\n          <div class=\"line-no\">11</div>\n          <div class=\"description\"><span class=\"text\">Repairs and maintenance</span></div>\n          <div class=\"box-ref\">11</div><div class=\"amount\"></div>\n        </div>\n        <div class=\"item-row\">\n          <div class=\"line-no\">12</div>\n          <div class=\"description\"><span class=\"text\">Bad debts</span></div>\n          <div class=\"box-ref\">12</div><div class=\"amount\"></div>\n        </div>\n        <div class=\"item-row\">\n          <div class=\"line-no\">13</div>\n          <div class=\"description\"><span class=\"text\">Rent</span></div>\n          <div class=\"box-ref\">13</div><div class=\"amount\"></div>\n        </div>\n        <div class=\"item-row\">\n          <div class=\"line-no\">14</div>\n          <div class=\"description\"><span class=\"text\">Taxes and licenses</span></div>\n          <div class=\"box-ref\">14</div><div class=\"amount\"></div>\n        </div>\n        <div class=\"item-row\">\n          <div class=\"line-no\">15</div>\n          <div class=\"description\"><span class=\"text\">Interest (see instructions)</span></div>\n          <div class=\"box-ref\">15</div><div class=\"amount\"></div>\n        </div>\n        <div class=\"item-row\">\n          <div class=\"line-no\">16a</div>\n          <div class=\"description split-desc no-dots\">\n            <span>Depreciation (if required, attach Form 4562)</span>\n            <span class=\"inner-ref\">16a</span><span class=\"inner-entry\"></span>\n          </div>\n          <div class=\"box-ref shade\"></div><div class=\"amount\"></div>\n        </div>\n        <div class=\"item-row\">\n          <div class=\"line-no\">&nbsp;&nbsp;b</div>\n          <div class=\"description split-desc no-dots\">\n            <span>Less depreciation reported on Form 1125-A and elsewhere on return</span>\n            <span class=\"inner-ref\">16b</span><span class=\"inner-entry\"></span>\n          </div>\n          <div class=\"box-ref\">16c</div><div class=\"amount\"></div>\n        </div>\n        <div class=\"item-row\">\n          <div class=\"line-no\">17</div>\n          <div class=\"description\"><span class=\"text\">Depletion (<strong>Do not deduct oil and gas depletion.</strong>)</span></div>\n          <div class=\"box-ref\">17</div><div class=\"amount\"></div>\n        </div>\n        <div class=\"item-row\">\n          <div class=\"line-no\">18</div>\n          <div class=\"description\"><span class=\"text\">Retirement plans, etc.</span></div>\n          <div class=\"box-ref\">18</div><div class=\"amount\"></div>\n        </div>\n        <div class=\"item-row\">\n          <div class=\"line-no\">19</div>\n          <div class=\"description\"><span class=\"text\">Employee benefit programs</span></div>\n          <div class=\"box-ref\">19</div><div class=\"amount\"></div>\n        </div>\n        <div class=\"item-row\">\n          <div class=\"line-no\">20</div>\n          <div class=\"description\"><span class=\"text\">Energy efficient commercial buildings deduction (attach Form 7205)</span></div>\n          <div class=\"box-ref\">20</div><div class=\"amount\"></div>\n        </div>\n        <div class=\"item-row\">\n          <div class=\"line-no\">21</div>\n          <div class=\"description\"><span class=\"text\">Other deductions (attach statement)</span></div>\n          <div c