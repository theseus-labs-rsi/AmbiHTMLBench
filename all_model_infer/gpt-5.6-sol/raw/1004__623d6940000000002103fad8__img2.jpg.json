        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>摄影常用工具学习列表</title>\n<script>\nwindow.MathJax = {\n  tex: {\n    inlineMath: [['$', '$']],\n    displayMath: [['$$', '$$']]\n  }\n};\n</script>\n<script defer src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * {\n    box-sizing: border-box;\n  }\n\n  html, body {\n    margin: 0;\n    padding: 0;\n    background: #eeeeee;\n  }\n\n  body {\n    font-family: \"Microsoft YaHei\", \"PingFang SC\", \"Noto Sans CJK SC\", Arial, sans-serif;\n    color: #171717;\n  }\n\n  .page {\n    width: 540px;\n    height: 720px;\n    margin: 0 auto;\n    overflow: hidden;\n    background: #f7f7f7;\n  }\n\n  .header {\n    height: 43px;\n    padding: 5px 12px 5px 23px;\n    display: flex;\n    align-items: center;\n    background: #35bdb8;\n    color: #fff;\n    font-size: 20px;\n    line-height: 1.15;\n    font-weight: 800;\n    letter-spacing: .2px;\n    white-space: nowrap;\n  }\n\n  .boxed-char {\n    display: inline-flex;\n    width: 20px;\n    height: 20px;\n    margin-right: 2px;\n    align-items: center;\n    justify-content: center;\n    border: 2px solid rgba(255,255,255,.72);\n    font-size: 16px;\n    line-height: 1;\n  }\n\n  .content {\n    padding-top: 5px;\n  }\n\n  .item {\n    display: flex;\n    width: 100%;\n    padding: 0 7px;\n  }\n\n  .item.standard {\n    min-height: 54px;\n  }\n\n  .item.tall {\n    min-height: 77px;\n  }\n\n  .number {\n    flex: 0 0 28px;\n    width: 28px;\n    height: 28px;\n    margin-top: 2px;\n    border: 1.5px solid #222;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 20px;\n    font-weight: 400;\n    line-height: 1;\n  }\n\n  .text {\n    min-width: 0;\n    flex: 1;\n    padding-left: 7px;\n  }\n\n  .main {\n    font-size: 16px;\n    line-height: 27px;\n    font-weight: 700;\n    white-space: nowrap;\n  }\n\n  .main.wrap {\n    white-space: normal;\n    line-height: 27px;\n  }\n\n  .note {\n    color: #169a91;\n    font-family: \"KaiTi\", \"STKaiti\", \"Noto Serif CJK SC\", serif;\n    font-size: 14px;\n    line-height: 22px;\n    font-weight: 600;\n    letter-spacing: 1px;\n    white-space: nowrap;\n  }\n\n  .shortcut {\n    color: #149f95;\n    margin-left: 3px;\n  }\n\n  .marked {\n    display: inline-block;\n    border-bottom: 2px solid #26aaa3;\n    line-height: 21px;\n  }\n\n  .tool {\n    display: inline-block;\n    margin-right: 5px;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <header class=\"header\">\n    <span class=\"boxed-char\">画</span><span>红线的是在我们摄影当中常用的工具可以着重学习</span>\n  </header>\n\n  <main class=\"content\">\n    <section class=\"item standard\">\n      <div class=\"number\">1</div>\n      <div class=\"text\">\n        <div class=\"main\">\n          <span class=\"tool marked\">移动工具</span>\n          <span class=\"tool marked\">画板工具</span><span class=\"shortcut\">（V）</span>\n        </div>\n        <div class=\"note\">移动选取或画面主题</div>\n      </div>\n    </section>\n\n    <section class=\"item standard\">\n      <div class=\"number\">2</div>\n      <div class=\"text\">\n        <div class=\"main\">\n          <span class=\"tool marked\">套索工具</span>\n          <span class=\"tool marked\">多边形套索工具</span>\n          <span class=\"tool\">磁性套索</span><span class=\"shortcut\">（L）</span>\n        </div>\n        <div class=\"note\">创建手绘选取</div>\n      </div>\n    </section>\n\n    <section class=\"item standard\">\n      <div class=\"number\">3</div>\n      <div class=\"text\">\n        <div class=\"main\">\n          <span class=\"tool marked\">裁剪工具</span>\n          <span class=\"tool marked\">透视裁剪工具</span>\n          <span class=\"tool\">切片工具</span><span class=\"shortcut\">（C）</span>\n        </div>\n        <div class=\"note\">裁切或扩展画面边缘</div>\n      </div>\n    </section>\n\n    <section class=\"item standard\">\n      <div class=\"number\">4</div>\n      <div class=\"text\">\n        <div class=\"main\">\n          <span class=\"tool marked\">修补工具</span>\n          <span class=\"tool marked\">污点修复画笔工具</span>\n          <span class=\"tool marked\">修补工具</span>\n          <span class=\"tool marked\">内容感知移动工具</span><span class=\"shortcut\">（J）</span>\n        </div>\n        <div class=\"note\">去除瑕疵的常用工具</div>\n      </div>\n    </section>\n\n    <section class=\"item standard\">\n      <div class=\"number\">5</div>\n      <div class=\"text\">\n        <div class=\"main\">\n          <span class=\"tool marked\">仿制图章工具</span>\n          <span class=\"tool\">图案图章工具</span><span class=\"shortcut\">（S）</span>\n        </div>\n        <div class=\"note\">磨皮去瑕疵的常用工具</div>\n      </div>\n    </section>\n\n    <section class=\"item standard\">\n      <div class=\"number\">6</div>\n      <div class=\"text\">\n        <div class=\"main\">\n          <span class=\"tool marked\">橡皮擦工具</span>\n          <span class=\"tool\">背景橡皮擦工具</span>\n          <span class=\"tool\">魔术橡皮擦工具</span><span class=\"shortcut\">（E）</span>\n        </div>\n        <div class=\"note\">擦除画面，经常结合蒙版使用</div>\n      </div>\n    </section>\n\n    <section class=\"item standard\">\n      <div class=\"number\">7</div>\n      <div class=\"text\">\n        <div class=\"main\">\n          <span class=\"tool marked\">锐化工具</span>\n          <span class=\"tool\">模糊工具</span>\n          <span class=\"tool\">涂抹工具</span>\n          <span class=\"tool\">锐化图像中的柔边</span>\n        </div>\n        <div class=\"note\">锐化图像柔边</div>\n      </div>\n    </section>\n\n    <section class=\"item tall\">\n      <div class=\"number\">8</div>\n      <div class=\"text\">\n        <div class=\"main wrap\">\n          <span class=\"tool marked\">钢笔工具</span>\n          <span class=\"tool\">自由钢笔工具</span>\n          <span class=\"tool\">弯度钢笔工具</span>\n          <span class=\"tool\">添加锚点工具</span>\n          <span class=\"tool\">删除锚点工具</span><br>\n          <span class=\"tool\">删除锚点工具</span>\n          <span class=\"tool\">转换点工具</span><span class=\"shortcut\">（P）</span>\n        </div>\n        <div class=\"note\">抠图常用工具</div>\n      </div>\n    </section>\n\n    <section class=\"item standard\">\n      <div class=\"number\">9</div>\n      <div class=\"text\">\n        <div class=\"main\">\n          <span class=\"tool marked\">路径选择工具</span>\n          <span class=\"tool\">直接选择工具</span><span class=\"shortcut\">（A）</span>\n        </div>\n        <div class=\"note\">选择或调整路径一般结合钢笔工具使用</div>\n      </div>\n    </section>\n\n    <section class=\"item standard\">\n      <div class=\"number\">10</div>\n      <div class=\"text\">\n        <div class=\"main\">\n          <span class=\"tool marked\">抓手工具(H)或(空格)</span>\n          <span class=\"tool\">旋转视图工具</span><span class=\"shortcut\">(R)</span>\n        </div>\n        <div class=\"note\">拖动画布图像的小工具</div>\n      </div>\n    </section>\n\n    <section class=\"item standard\">\n      <div class=\"number\">11</div>\n      <div class=\"text\">\n        <div class=\"main\">\n          <span class=\"tool marked\">矩形选框工具</span>\n          <span class=\"tool\">椭圆选框工具</span><span class=\"shortcut\">(M)</span>\n        </div>\n        <div class=\"note\">创建矩形或圆形选取</div>\n      </div>\n    </section>\n\n    <section class=\"item standard\">\n      <div class=\"number\">12</div>\n      <div class=\"text\">\n        <div class=\"main\">\n          <span class=\"tool marked\">快速选择工具</span>\n          <span class=\"tool\">魔棒工具</span><span class=\"shortcut\">(W)</span>\n        </div>\n        <div class=\"note\">选择色彩类似的图像区域</div>\n      </div>\n    </section>\n  </main>\n</div>\n</body>\n</html>"
