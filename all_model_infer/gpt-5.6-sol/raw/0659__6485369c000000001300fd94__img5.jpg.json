ing-left: 13px;\n  }\n  .choice-list strong {\n    color: #38462d;\n  }\n  .highlight-note {\n    margin-top: 5px;\n    height: 20px;\n    padding: 3px 7px;\n    background: rgba(177,194,64,.53);\n    color: #6d7144;\n    font-size: 8px;\n    line-height: 1.35;\n  }\n  .right-page {\n    padding: 66px 38px 22px 40px;\n  }\n  .right-heading {\n    margin: 0 0 10px;\n    color: #467620;\n    font-size: 13px;\n    font-weight: 800;\n  }\n  .recipe {\n    margin-bottom: 15px;\n    font-size: 8.5px;\n    line-height: 1.48;\n  }\n  .recipe-title {\n    display: inline-block;\n    min-width: 120px;\n    margin: 0 0 4px;\n    padding: 2px 9px 2px 8px;\n    border-radius: 9px;\n    background: #8ba62b;\n    color: #344917;\n    font-size: 9px;\n    font-weight: 800;\n    line-height: 1.2;\n    box-shadow: inset 0 -1px 1px rgba(60,80,10,.25);\n  }\n  .recipe p {\n    margin: 0 0 2px;\n  }\n  .method {\n    display: grid;\n    grid-template-columns: 31px 1fr;\n    margin-top: 1px;\n  }\n  .steps {\n    margin: 0;\n    padding-left: 15px;\n  }\n  .steps li {\n    margin: 0 0 2px;\n    padding-left: 1px;\n  }\n  .faint {\n    color: #777767;\n  }\n  @media (max-width: 1080px) {\n    body { padding: 20px 10px; }\n    .spread {\n      transform-origin: top left;\n      transform: scale(calc((100vw - 20px) / 1040)) rotate(.35deg);\n      margin: 0;\n    }\n  }\n</style>\n</head>\n<body>\n<main class=\"spread\">\n  <section class=\"page left-page\">\n    <header class=\"top-band\">\n      <h1 class=\"main-title\">12～18月龄宝宝的[illegible]</h1>\n    </header>\n\n    <section class=\"section intro\">\n      <h2 class=\"section-title\">喂养原则</h2>\n      <ul class=\"compact-list\">\n        <li>注重膳食多样化，鼓励宝宝和家人共同进餐并享受食物</li>\n        <li>开始尝试自己用勺子进食和用杯子饮水，鼓励独立进餐</li>\n        <li>每日保证足量奶类，同时开始尝试更多种类食物</li>\n        <li>如果宝宝对食物过敏，要警惕并回避相应食物</li>\n        <li>可以开始尝试坚果、豆制品、带壳海鲜，坚果要磨碎</li>\n      </ul>\n    </section>\n\n    <section class=\"section\">\n      <h2 class=\"section-title\">搭配建议</h2>\n      <p class=\"pairing-note\">米饭、大块的食物（以米饭、面条、肉类、蔬菜、水果为例）</p>\n\n      <div class=\"food-layout\">\n        <div class=\"food-row\">\n          <div class=\"food-item\">\n            <div class=\"food-photo placeholder\">[Photo: 米饭]</div>\n            <span>米饭</span>\n          </div>\n          <div class=\"food-item\">\n            <div class=\"food-photo placeholder\">[Photo: 面条]</div>\n            <span>面条</span>\n          </div>\n          <div class=\"food-item\">\n            <div class=\"food-photo placeholder\">[Photo: 肉肉]</div>\n            <span>肉肉</span>\n          </div>\n        </div>\n        <div class=\"food-row bottom\">\n          <div class=\"food-item small\">\n            <div class=\"food-photo placeholder\">[Photo: 蔬菜]</div>\n            <span>蔬菜</span>\n          </div>\n          <div class=\"food-item small\">\n            <div class=\"food-photo placeholder\">[Photo: 水果]</div>\n            <span>水果</span>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section choice-list\">\n      <h2 class=\"section-title\">选择建议</h2>\n      <ul>\n        <li><strong>乳类推荐：</strong>每日2次，总计400～600ml</li>\n        <li><strong>[illegible]：</strong>每日3次，每次1碗</li>\n        <li><strong>谷薯类：</strong>谷薯类、各种杂粮约3/4～1碗</li>\n        <li><strong>蔬菜类：</strong>各种蔬菜1/2～2/3碗</li>\n        <li><strong>水果类：</strong>各种水果1/2～2/3碗</li>\n        <li><strong>肉、蛋、鱼、禽、豆类：</strong>肉、鱼、蛋类6～8勺</li>\n        <li><strong>油盐：</strong>每日油10～15g，盐＜1.5g</li>\n      </ul>\n      <div class=\"highlight-note\">提示：[illegible]，根据宝宝的实际进食情况进行调整。</div>\n    </section>\n  </section>\n\n  <section class=\"page right-page\">\n    <header class=\"top-band\"></header>\n    <h2 class=\"right-heading\">经典食谱</h2>\n\n    <article class=\"recipe\">\n      <h3 class=\"recipe-title\">食谱一：木耳粥</h3>\n      <p><strong>用料：</strong>稻米、木耳、[illegible]、鸡蛋、盐、食用油、水</p>\n      <div class=\"method\">\n        <strong>做法：</strong>\n        <ol class=\"steps\">\n          <li>[illegible]切小片备用，木耳撕成小片，稻米洗净备用。</li>\n          <li>热锅放食用油，将[illegible]入锅中，煸炒出香。</li>\n          <li>锅中下稻米加水煮粥，再放入木耳、鸡蛋、[illegible]，出锅前放少量食用盐。</li>\n        </ol>\n      </div>\n    </article>\n\n    <article class=\"recipe\">\n      <h3 class=\"recipe-title\">食谱二：青椒炒鸡蛋</h3>\n      <p><strong>用料：</strong>青椒、鸡蛋、葱、姜、盐、食用油</p>\n      <div class=\"method\">\n        <strong>做法：</strong>\n        <ol class=\"steps\">\n          <li>从青椒内部去籽，切成小块；鸡蛋打入碗中，[illegible]。</li>\n          <li>热锅倒食用油，下葱末和姜末煸香，然后倒入蛋液[illegible]。</li>\n          <li>炒至入味即可，撒少量盐调味。</li>\n        </ol>\n      </div>\n    </article>\n\n    <article class=\"recipe\">\n      <h3 class=\"recipe-title\">食谱三：[illegible]</h3>\n      <p><strong>用料：</strong>土豆、胡萝卜、猪肉、水、食用油</p>\n      <div class=\"method\">\n        <strong>做法：</strong>\n        <ol class=\"steps\">\n          <li>将土豆、胡萝卜与猪肉[illegible]，肉剁成泥。</li>\n          <li>将蒸好的土豆和胡萝卜与肉混合，加入适量水[illegible]。</li>\n          <li>平底锅内放食用油，放入一勺[illegible]，小火煎至两面金黄即可。</li>\n        </ol>\n      </div>\n    </article>\n\n    <article class=\"recipe\">\n      <h3 class=\"recipe-title\">食谱四：[illegible]</h3>\n      <p><strong>用料：</strong>[illegible]、玉米、葱、食用油</p>\n      <div class=\"method\">\n        <strong>做法：</strong>\n        <ol class=\"steps\">\n          <li>[illegible]洗净，[illegible]；玉米洗净备用。</li>\n          <li>锅中倒入少许食用油，油热后放入[illegible]煸炒。</li>\n          <li>放入切好的玉米，[illegible]，翻炒片刻后加入适量的水，盖锅盖焖煮2～3分钟。</li>\n          <li>待汤汁变浓稠后，再次翻炒几下即可。</li>\n        </ol>\n      </div>\n    </article>\n  </section>\n</main>\n</body>\n</html>",
