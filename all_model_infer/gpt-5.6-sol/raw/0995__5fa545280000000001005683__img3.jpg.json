        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>微分与积分公式</title>\n<script>\nwindow.MathJax = {\n  tex: {\n    inlineMath: [['$', '$']],\n    displayMath: [['$$', '$$']]\n  },\n  chtml: {\n    scale: 0.88\n  }\n};\n</script>\n<script defer src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js\"></script>\n<style>\n  * {\n    box-sizing: border-box;\n  }\n\n  html,\n  body {\n    margin: 0;\n    min-height: 100%;\n    background: #fff;\n    color: #111;\n  }\n\n  body {\n    font-family: \"SimSun\", \"Songti SC\", \"Noto Serif CJK SC\", serif;\n  }\n\n  .page {\n    width: 540px;\n    min-height: 720px;\n    margin: 0 auto;\n    padding: 13px 27px 13px 36px;\n    background: #fff;\n    font-size: 11px;\n    line-height: 1.18;\n  }\n\n  .formula-grid {\n    display: grid;\n    align-items: center;\n  }\n\n  .top-formulas {\n    grid-template-columns: 1.18fr 1.2fr 1.22fr;\n    column-gap: 11px;\n    row-gap: 9px;\n  }\n\n  .top-formulas .item:nth-child(4) {\n    grid-column: 1 / 2;\n  }\n\n  .top-formulas .item:nth-child(5) {\n    grid-column: 2 / 3;\n  }\n\n  h2 {\n    margin: 9px 0 5px;\n    font-size: 12px;\n    line-height: 1.2;\n    font-weight: 700;\n  }\n\n  .rules {\n    grid-template-columns: 1fr 1fr;\n    column-gap: 62px;\n    row-gap: 10px;\n    padding: 1px 4px 0;\n  }\n\n  .basic {\n    grid-template-columns: 1.05fr 1.22fr 1.12fr;\n    column-gap: 15px;\n    row-gap: 9px;\n    padding: 1px 4px 0;\n  }\n\n  .basic .wide-left {\n    grid-column: 1 / 3;\n  }\n\n  .basic .right {\n    grid-column: 3 / 4;\n  }\n\n  .supplement {\n    grid-template-columns: 1fr 1fr;\n    column-gap: 50px;\n    row-gap: 9px;\n    padding: 0 10px;\n  }\n\n  .item {\n    min-width: 0;\n    white-space: nowrap;\n  }\n\n  mjx-container {\n    margin: 0 !important;\n  }\n\n  table {\n    width: 100%;\n    margin-top: 1px;\n    border-collapse: collapse;\n    table-layout: fixed;\n    font-size: 10.5px;\n  }\n\n  th,\n  td {\n    border: 1px solid #888;\n    padding: 2px 5px;\n    vertical-align: middle;\n    font-weight: 400;\n  }\n\n  th {\n    height: 17px;\n    text-align: left;\n  }\n\n  th:last-child,\n  td:last-child {\n    text-align: center;\n  }\n\n  td {\n    height: 31px;\n  }\n\n  .col-integral {\n    width: 55%;\n  }\n\n  .col-substitution {\n    width: 45%;\n  }\n\n  @media (max-width: 540px) {\n    .page {\n      width: 100vw;\n      min-width: 540px;\n    }\n  }\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <section class=\"formula-grid top-formulas\">\n    <div class=\"item\">② $d\\left(\\log_a x\\right)=\\dfrac{1}{x\\ln a}\\,dx$</div>\n    <div class=\"item\">③ $d\\left(\\arcsin x\\right)=\\dfrac{1}{\\sqrt{1-x^2}}\\,dx$</div>\n    <div class=\"item\">④ $d\\left(\\arccos x\\right)=-\\dfrac{1}{\\sqrt{1-x^2}}\\,dx$</div>\n    <div class=\"item\">⑤ $d\\left(\\arctan x\\right)=\\dfrac{1}{1+x^2}\\,dx$</div>\n    <div class=\"item\">⑥ $d\\left(\\operatorname{arccot}x\\right)=-\\dfrac{1}{1+x^2}\\,dx$</div>\n  </section>\n\n  <section>\n    <h2>六、微分运算法则</h2>\n    <div class=\"formula-grid rules\">\n      <div class=\"item\">（1）$d(u\\pm v)=du\\pm dv$</div>\n      <div class=\"item\">（2）$d(cu)=cdu$</div>\n      <div class=\"item\">（3）$d(uv)=vdu+udv$</div>\n      <div class=\"item\">（4）$d\\left(\\dfrac{u}{v}\\right)=\\dfrac{vdu-udv}{v^2}$</div>\n    </div>\n  </section>\n\n  <section>\n    <h2>七、基本积分公式</h2>\n    <div class=\"formula-grid basic\">\n      <div class=\"item\">（1）$\\int kdx=kx+c$</div>\n      <div class=\"item\">（2）$\\int x^\\mu dx=\\dfrac{x^{\\mu+1}}{\\mu+1}+c$</div>\n      <div class=\"item\">（3）$\\int\\dfrac{dx}{x}=\\ln|x|+c$</div>\n\n      <div class=\"item\">（4）$\\int a^x dx=\\dfrac{a^x}{\\ln a}+c$</div>\n      <div class=\"item\">（5）$\\int e^x dx=e^x+c$</div>\n      <div class=\"item\">（6）$\\int\\cos xdx=\\sin x+c$</div>\n\n      <div class=\"item wide-left\">（7）$\\int\\sin xdx=-\\cos x+c$</div>\n      <div class=\"item right\">（8）$\\int\\dfrac{1}{\\cos^2x}dx=\\int\\sec^2x\\,dx=\\tan x+c$</div>\n\n      <div class=\"item wide-left\">（9）$\\int\\dfrac{1}{\\sin^2x}dx=\\int\\csc^2x\\,dx=-\\cot x+c$</div>\n      <div class=\"item right\">⑩ $\\int\\dfrac{1}{1+x^2}dx=\\arctan x+c$</div>\n\n      <div class=\"item wide-left\">⑪ $\\int\\dfrac{1}{\\sqrt{1-x^2}}dx=\\arcsin x+c$</div>\n    </div>\n  </section>\n\n  <section>\n    <h2>八、补充积分公式</h2>\n    <div class=\"formula-grid supplement\">\n      <div class=\"item\">$\\int\\tan xdx=-\\ln|\\cos x|+c$</div>\n      <div class=\"item\">$\\int\\cot xdx=\\ln|\\sin x|+c$</div>\n\n      <div class=\"item\">$\\int\\sec xdx=\\ln|\\sec x+\\tan x|+c$</div>\n      <div class=\"item\">$\\int\\csc xdx=\\ln|\\csc x-\\cot x|+c$</div>\n\n      <div class=\"item\">$\\int\\dfrac{1}{a^2+x^2}dx=\\dfrac{1}{a}\\arctan\\dfrac{x}{a}+c$</div>\n      <div class=\"item\">$\\int\\dfrac{1}{x^2-a^2}dx=\\dfrac{1}{2a}\\ln\\left|\\dfrac{x-a}{x+a}\\right|+c$</div>\n\n      <div class=\"item\">$\\int\\dfrac{1}{\\sqrt{a^2-x^2}}dx=\\arcsin\\dfrac{x}{a}+c$</div>\n      <div class=\"item\">$\\int\\dfrac{1}{\\sqrt{x^2\\pm a^2}}dx=\\ln\\left|x+\\sqrt{x^2\\pm a^2}\\right|+c$</div>\n    </div>\n  </section>\n\n  <section>\n    <h2>九、下列常用凑微分公式</h2>\n    <table>\n      <colgroup>\n        <col class=\"col-integral\">\n        <col class=\"col-substitution\">\n      </colgroup>\n      <thead>\n        <tr>\n          <th>积分型</th>\n          <th>换元公式</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td>$\\displaystyle \\int f(ax+b)dx=\\frac{1}{a}\\int f(ax+b)d(ax+b)$</td>\n          <td>$u=ax+b$</td>\n        </tr>\n        <tr>\n          <td>$\\displaystyle \\int f(x^\\mu)x^{\\mu-1}dx=\\frac{1}{\\mu}\\int f(x^\\mu)d(x^\\mu)$</td>\n          <td>$u=x^\\mu$</td>\n        </tr>\n        <tr>\n          <td>$\\displaystyle \\int f(\\ln x)\\frac{1}{x}dx=\\int f(\\ln x)d(\\ln x)$</td>\n          <td>$u=\\ln x$</td>\n        </tr>\n      </tbody>\n    </table>\n  </section>\n</main>\n</body>\n</html>"
