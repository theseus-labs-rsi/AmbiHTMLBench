        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Digital I/O Registers</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] },\n  svg: { fontCache: 'global' }\n};\n</script>\n<script defer src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js\"></script>\n<style>\n  * {\n    box-sizing: border-box;\n  }\n\n  html,\n  body {\n    margin: 0;\n    padding: 0;\n    background: #fff;\n    color: #080808;\n    font-family: Arial, Helvetica, sans-serif;\n  }\n\n  body {\n    width: 1260px;\n    min-height: 1980px;\n    margin: 0 auto;\n    position: relative;\n    font-size: 20px;\n  }\n\n  .page {\n    position: relative;\n    width: 1260px;\n    min-height: 1980px;\n    padding-top: 31px;\n  }\n\n  .brand {\n    position: absolute;\n    top: 31px;\n    right: 1px;\n    display: flex;\n    align-items: flex-start;\n    color: #231f20;\n  }\n\n  .brand-mark {\n    position: relative;\n    width: 53px;\n    height: 54px;\n    margin-right: 8px;\n  }\n\n  .brand-mark .texas-shape {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 48px;\n    height: 51px;\n    background: #231f20;\n    clip-path: polygon(\n      28% 0%, 70% 0%, 70% 11%, 91% 11%, 91% 31%,\n      78% 31%, 78% 56%, 66% 56%, 66% 84%, 49% 100%,\n      31% 88%, 31% 68%, 18% 68%, 18% 53%, 7% 53%,\n      0 38%, 29% 38%\n    );\n  }\n\n  .brand-mark .ti {\n    position: absolute;\n    top: 4px;\n    left: 22px;\n    z-index: 2;\n    color: white;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-weight: bold;\n    font-style: italic;\n    font-size: 26px;\n    line-height: 1;\n  }\n\n  .brand-name {\n    margin-top: 5px;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-weight: bold;\n    font-size: 25px;\n    line-height: 23px;\n    text-transform: uppercase;\n  }\n\n  .top-header {\n    margin-top: 111px;\n    height: 33px;\n    border-bottom: 4px solid #111;\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n  }\n\n  .top-header .chapter-name {\n    font-style: italic;\n    font-size: 21px;\n    line-height: 25px;\n  }\n\n  .top-header .site {\n    font-size: 20px;\n    line-height: 25px;\n  }\n\n  .section-heading {\n    display: flex;\n    align-items: baseline;\n    margin-top: 13px;\n    font-weight: bold;\n    font-size: 28px;\n    line-height: 32px;\n  }\n\n  .section-number {\n    width: 76px;\n  }\n\n  .section-title {\n    margin-left: 1px;\n  }\n\n  .intro {\n    width: 1185px;\n    margin: 12px 0 0 75px;\n    font-size: 25px;\n    line-height: 28px;\n  }\n\n  a {\n    color: #0000ff;\n    text-decoration: none;\n  }\n\n  .note {\n    width: 934px;\n    margin: 26px 0 0 200px;\n    border-top: 2px solid #222;\n    border-bottom: 1px solid #222;\n    padding: 14px 0 11px;\n    display: grid;\n    grid-template-columns: 90px 1fr;\n    column-gap: 0;\n    font-size: 22px;\n    line-height: 27px;\n  }\n\n  .note-label {\n    font-weight: bold;\n  }\n\n  .note-body em {\n    font-style: italic;\n  }\n\n  .table-title {\n    width: 1185px;\n    margin: 32px 0 16px 75px;\n    text-align: center;\n    font-size: 25px;\n    line-height: 29px;\n    font-weight: bold;\n  }\n\n  .register-table {\n    width: 1185px;\n    margin-left: 75px;\n    border-collapse: collapse;\n    table-layout: fixed;\n    font-size: 20px;\n    line-height: 23px;\n  }\n\n  .register-table col.offset  { width: 8%; }\n  .register-table col.acronym { width: 16%; }\n  .register-table col.name    { width: 30%; }\n  .register-table col.type    { width: 11%; }\n  .register-table col.access  { width: 8%; }\n  .register-table col.reset   { width: 11%; }\n  .register-table col.section { width: 16%; }\n\n  .register-table thead th {\n    height: 34px;\n    padding: 4px 8px 3px;\n    background: #d3d3d3;\n    border-top: 1px solid #111;\n    border-bottom: 1px solid #111;\n    text-align: left;\n    vertical-align: middle;\n    font-weight: bold;\n    white-space: nowrap;\n  }\n\n  .register-table tbody td {\n    height: 56px;\n    padding: 5px 8px;\n    vertical-align: top;\n    font-weight: normal;\n  }\n\n  .register-table tbody tr.compact td {\n    height: 33px;\n    padding-top: 4px;\n    padding-bottom: 4px;\n  }\n\n  .register-table tbody tr.group-start td {\n    border-top: 1px solid #111;\n  }\n\n  .register-table tbody tr.last-row td {\n    border-bottom: 1px solid #111;\n  }\n\n  .nowrap {\n    white-space: nowrap;\n  }\n\n  .footer {\n    width: 1260px;\n    margin-top: 22px;\n    border-top: 4px solid #111;\n    position: relative;\n    padding-top: 4px;\n    min-height: 91px;\n    font-size: 19px;\n  }\n\n  .footer-top {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n  }\n\n  .footer-left {\n    white-space: nowrap;\n  }\n\n  .footer-left em {\n    margin-left: 6px;\n  }\n\n  .footer-right {\n    text-align: right;\n    line-height: 24px;\n  }\n\n  .feedback {\n    display: block;\n    color: #0000ff;\n    font-style: italic;\n  }\n\n  .copyright {\n    margin-top: 25px;\n    text-align: center;\n    font-size: 17px;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <div class=\"brand\" aria-label=\"Texas Instruments\">\n    <div class=\"brand-mark\">\n      <div class=\"texas-shape\"></div>\n      <div class=\"ti\">ti</div>\n    </div>\n    <div class=\"brand-name\">Texas<br>Instruments</div>\n  </div>\n\n  <header class=\"top-header\">\n    <div class=\"chapter-name\">Digital I/O Registers</div>\n    <div class=\"site\">www.ti.com</div>\n  </header>\n\n  <main>\n    <div class=\"section-heading\">\n      <div class=\"section-number\">12.4</div>\n      <div class=\"section-title\">Digital I/O Registers</div>\n    </div>\n\n    <div class=\"intro\">\n      The digital I/O registers are listed in <a href=\"#\">Table 12-2</a>. The base addresses can be found in the device-specific<br>\n      data sheet. Each port grouping begins at its base address. The address offsets are given in <a href=\"#\">Table 12-2</a>.\n    </div>\n\n    <div class=\"note\">\n      <div class=\"note-label\">NOTE:</div>\n      <div class=\"note-body\">\n        All registers have word or byte register access. For a generic register <em>ANYREG</em>, the suffix<br>\n        \"_L\" (<em>ANYREG_L</em>) refers to the lower byte of the register (bits 0 through 7). The suffix \"_H\"<br>\n        (<em>ANYREG_H</em>) refers to the upper byte of the register (bits 8 through 15).\n      </div>\n    </div>\n\n    <div class=\"table-title\">Table 12-2. Digital I/O Registers</div>\n\n    <table class=\"register-table\">\n      <colgroup>\n        <col class=\"offset\">\n        <col class=\"acronym\">\n        <col class=\"name\">\n        <col class=\"type\">\n        <col class=\"access\">\n        <col class=\"reset\">\n        <col class=\"section\">\n      </colgroup>\n      <thead>\n        <tr>\n          <th>Offset</th>\n          <th>Acronym</th>\n          <th>Register Name</th>\n          <th>Type</th>\n          <th>Access</th>\n          <th>Reset</th>\n          <th>Section</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr class=\"compact\">\n          <td>0Eh</td>\n          <td>P1IV</td>\n          <td>Port 1 Interrupt Vector</td>\n          <td>Read only</td>\n          <td>Word</td>\n          <td>0000h</td>\n          <td><a href=\"#\">Section 12.4.1</a></td>\n        </tr>\n        <tr class=\"compact\">\n          <td>0Eh</td>\n          <td>P1IV_L</td>\n          <td></td>\n          <td>Read only</td>\n          <td>Byte</td>\n          <td>00h</td>\n          <td></td>\n        </tr>\n        <tr class=\"compact\">\n          <td>0Fh</td>\n          <td>P1IV_H</td>\n          <td></td>\n          <td>Read only</td>\n          <td>Byte</td>\n          <td>00h</td>\n          <td></td>\n        </tr>\n\n        <tr class=\"compact group-start\">\n          <td>1Eh</td>\n          <td>P2IV</td>\n          <td>Port 2 Interrupt Vector</td>\n          <td>Read only</td>\n          <td>Word</td>\n          <td>0000h</td>\n          <td><a href=\"#\">Section 12.4.2</a></td>\n        </tr>\n        <tr class=\"compact\">\n          <td>1Eh</td>\n          <td>P2IV_L</td>\n          <td></td>\n          <td>Read only</td>\n          <td>Byte</td>\n          <td>00h</td>\n          <td></td>\n        </tr>\n        <tr class=\"compact\">\n          <td>1Fh</td>\n          <td>P2IV_H</td>\n          <td></td>\n          <td>Read only</td>\n          <td>Byte</td>\n          <td>00h</td>\n          <td></td>\n        </tr>\n\n        <tr class=\"group-start\">\n          <td>00h</td>\n          <td>P1IN or<br>PAIN_L</td>\n          <td>Port 1 Input</td>\n          <td>Read only</td>\n          <td>Byte</td>\n          <td></td>\n          <td><a href=\"#\">Section 12.4.9</a></td>\n        </tr>\n        <tr>\n          <td>02h</td>\n          <td>P1OUT or<br>PAOUT_L</td>\n          <td>Port 1 Output</td>\n          <td>Read/write</td>\n          <td>Byte</td>\n          <td>undefined</td>\n          <td><a href=\"#\">Section 12.4.10</a></td>\n        </tr>\n        <tr>\n          <td>04h</td>\n          <td>P1DIR or<br>PADIR_L</td>\n          <td>Port 1 Direction</td>\n          <td>Read/write</td>\n          <td>Byte</td>\n          <td>00h</td>\n          <td><a href=\"#\">Section 12.4.11</a></td>\n        </tr>\n        <tr>\n          <td>06h</td>\n          <td>P1REN or<br>PAREN_L</td>\n          <td>Port 1 Resistor Enable</td>\n          <td>Read/write</td>\n          <td>Byte</td>\n          <td>00h</td>\n          <td><a href=\"#\">Section 12.4.12</a></td>\n        </tr>\n        <tr>\n          <td>08h</td>\n          <td>P1DS or<br>PADS_L</td>\n          <td>Port 1 Drive Strength</td>\n          <td>Read/write</td>\n          <td>Byte</td>\n          <td>00h</td>\n          <td><a href=\"#\">Section 12.4.13</a></td>\n        </tr>\n        <tr>\n          <td>0Ah</td>\n          <td>P1SEL or<br>PASEL_L</td>\n          <td>Port 1 Port Select</td>\n          <td>Read/write</td>\n          <td>Byte</td>\n          <td>00h</td>\n          <td><a href=\"#\">Section 12.4.14</a></td>\n        </tr>\n        <tr>\n          <td>18h</td>\n          <td>P1IES or<br>PAIES_L</td>\n          <td>Port 1 Interrupt Edge Select</td>\n          <td>Read/write</td>\n          <td>Byte</td>\n          <td>undefined</td>\n          <td><a href=\"#\">Section 12.4.3</a></td>\n        </tr>\n        <tr>\n          <td>1Ah</td>\n          <td>P1IE or<br>PAIE_L</td>\n          <td>Port 1 Interrupt Enable</td>\n          <td>Read/write</td>\n          <td>Byte</td>\n          <td>00h</td>\n          <td><a href=\"#\">Section 12.4.4</a></td>\n        </tr>\n        <tr>\n          <td>1Ch</td>\n          <td>P1IFG or<br>PAIFG_L</td>\n          <td>Port 1 Interrupt Flag</td>\n          <td>Read/write</td>\n          <td>Byte</td>\n          <td>00h</td>\n          <td><a href=\"#\">Section 12.4.5</a></td>\n        </tr>\n\n        <tr class=\"group-start\">\n          <td>01h</td>\n          <td>P2IN or<br>PAIN_H</td>\n          <td>Port 2 Input</td>\n          <td>Read only</td>\n          <td>Byte</td>\n          <td></td>\n          <td><a href=\"#\">Section 12.4.9</a></td>\n        </tr>\n        <tr>\n          <td>03h</td>\n          <td>P2OUT or<br>PAOUT_H</td>\n          <td>Port 2 Output</td>\n          <td>Read/write</td>\n          <td>Byte</td>\n          <td>undefined</td>\n          <td><a href=\"#\">Section 12.4.10</a></td>\n        </tr>\n        <tr>\n          <td>05h</td>\n          <td>P2DIR or<br>PADIR_H</td>\n          <td>Port 2 Direction</td>\n          <td>Read/write</td>\n          <td>Byte</td>\n          <td>00h</td>\n          <td><a href=\"#\">Section 12.4.11</a></td>\n        </tr>\n        <tr>\n          <td>07h</td>\n          <td>P2REN or<br>PAREN_H</td>\n          <td>Port 2 Resistor Enable</td>\n          <td>Read/write</td>\n          <td>Byte</td>\n          <td>00h</td>\n          <td><a href=\"#\">Section 12.4.12</a></td>\n        </tr>\n        <tr>\n          <td>09h</td>\n          <td>P2DS or<br>PADS_H</td>\n          <td>Port 2 Drive Strength</td>\n          <td>Read/write</td>\n          <td>Byte</td>\n          <td>00h</td>\n          <td><a href=\"#\">Section 12.4.13</a></td>\n        </tr>\n        <tr>\n          <td>0Bh</td>\n          <td>P2SEL or<br>PASEL_H</td>\n          <td>Port 2 Port Select</td>\n          <td>Read/write</td>\n          <td>Byte</td>\n          <td>00h</td>\n          <td><a href=\"#\">Section 12.4.14</a></td>\n        </tr>\n        <tr>\n          <td>19h</td>\n          <td>P2IES or<br>PAIES_H</td>\n          <td>Port 2 Interrupt Edge Select</td>\n          <td>Read/write</td>\n          <td>Byte</td>\n          <td>undefined</td>\n          <td><a href=\"#\">Section 12.4.6</a></td>\n        </tr>\n        <tr>\n          <td>1Bh</td>\n          <td>P2IE or<br>PAIE_H</td>\n          <td>Port 2 Interrupt Enable</td>\n          <td>Read/write</td>\n          <td>Byte</td>\n          <td>00h</td>\n          <td><a href=\"#\">Section 12.4.7</a></td>\n        </tr>\n        <tr>\n          <td>1Dh</td>\n          <td>P2IFG or<br>PAIFG_H</td>\n          <td>Port 2 Interrupt Flag</td>\n          <td>Read/write</td>\n          <td>Byte</td>\n          <td>00h</td>\n          <td><a href=\"#\">Section 12.4.8</a></td>\n        </tr>\n\n        <tr class=\"group-start\">\n          <td>00h</td>\n          <td>P3IN or<br>PBIN_L</td>\n          <td>Port 3 Input</td>\n          <td>Read only</td>\n          <td>Byte</td>\n          <td></td>\n          <td><a href=\"#\">Section 12.4.9</a></td>\n        </tr>\n        <tr class=\"last-row\">\n          <td>02h</td>\n          <td>P3OUT or<br>PBOUT_L</td>\n          <td>Port 3 Output</td>\n          <td>Read/write</td>\n          <td>Byte</td>\n          <td>undefined</td>\n          <td><a href=\"#\">Section 12.4.10</a></td>\n        </tr>\n      </tbody>\n    </table>\n  </main>\n\n  <footer class=\"footer\">\n    <div class=\"footer-top\">\n      <div class=\"footer-left\">416 <em>Digital I/O Module</em></div>\n      <div class=\"footer-right\">\n        SLAU208Q–June 2008–Revised March 2018\n        <a class=\"feedback\" href=\"#\">Submit Documentation Feedback</a>\n      </div>\n    </div>\n    <div class=\"copyright\">Copyright © 2008–2018, Texas Instruments Incorporated</div>\n  </footer>\n</div>\n</body>\n</html>"
