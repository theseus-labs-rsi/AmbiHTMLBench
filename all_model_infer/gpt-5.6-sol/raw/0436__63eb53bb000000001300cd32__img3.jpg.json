s=\"signal-line s1\"></div>\n        <div class=\"signal-line s2\"></div>\n        <div class=\"signal-line s3\"></div>\n        <div class=\"signal-node n1\"></div>\n        <div class=\"signal-node n2\"></div>\n        <div class=\"signal-node n3\"></div>\n      </div>\n      <div class=\"nucleus\"></div>\n      <div class=\"receptor\"></div>\n      <div class=\"arrow a1\"></div>\n      <div class=\"arrow a2\"></div>\n      <div class=\"arrow a3\"></div>\n      <div class=\"info-box i1\">[illegible]</div>\n      <div class=\"info-box i2\">[illegible]</div>\n      <div class=\"info-box i3\">[illegible]</div>\n    </div>\n    <figcaption class=\"figure-credit\">Chris Siebel and Urban Lendahl, <i>Physiol Rev.</i> 2017</figcaption>\n    <div class=\"figure-note\">Notch和配体的双向调控</div>\n  </figure>\n\n  <div class=\"speaker\" aria-label=\"[Icon: speaker, bottom-right]\">\n    <div class=\"speaker-box\"></div>\n    <div class=\"speaker-cone\"></div>\n    <div class=\"wave w1\"></div>\n    <div class=\"wave w2\"></div>\n  </div>\n</main>\n</body>\n</html>",
