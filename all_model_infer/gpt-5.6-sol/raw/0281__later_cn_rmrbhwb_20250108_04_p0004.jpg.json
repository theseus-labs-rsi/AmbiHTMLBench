        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>人民日报海外版·要闻·台港澳</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] },\n  svg: { fontCache: 'global' }\n};\n</script>\n<script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js\"></script>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;padding:0;background:#e8e8e8}\nbody{font-family:\"SimSun\",\"Songti SC\",\"Noto Serif CJK SC\",serif;color:#111}\n.page{\n  position:relative;\n  width:800px;\n  height:1232px;\n  margin:0 auto;\n  padding:32px 14px 18px;\n  overflow:hidden;\n  background:#fff;\n}\n.header{\n  position:relative;\n  height:34px;\n  border-bottom:3px solid #175072;\n}\n.section-number{\n  position:absolute;\n  left:4px;\n  top:-2px;\n  font-family:Georgia,serif;\n  font-size:29px;\n  line-height:30px;\n  font-weight:bold;\n  font-style:italic;\n}\n.section-name{\n  position:absolute;\n  left:45px;\n  top:2px;\n  height:29px;\n  padding:2px 11px 0;\n  color:#fff;\n  background:#14517b;\n  font-family:\"Microsoft YaHei\",\"Noto Sans CJK SC\",sans-serif;\n  font-size:19px;\n  font-weight:bold;\n  letter-spacing:1px;\n}\n.masthead{\n  position:absolute;\n  left:341px;\n  top:-1px;\n  color:#bf0017;\n  font-family:\"STKaiti\",\"KaiTi\",serif;\n  font-size:26px;\n  font-weight:bold;\n  font-style:italic;\n  letter-spacing:2px;\n}\n.mast-seal{\n  display:inline-block;\n  width:11px;\n  height:24px;\n  margin-left:1px;\n  vertical-align:2px;\n  color:#fff;\n  background:#b60016;\n  font-family:serif;\n  font-size:6px;\n  line-height:8px;\n  text-align:center;\n  letter-spacing:0;\n  font-style:normal;\n}\n.issue{\n  position:absolute;\n  right:5px;\n  top:2px;\n  width:163px;\n  text-align:right;\n  font-size:6px;\n  line-height:11px;\n}\n.columns{\n  display:grid;\n  grid-template-columns:510px 248px;\n  gap:12px;\