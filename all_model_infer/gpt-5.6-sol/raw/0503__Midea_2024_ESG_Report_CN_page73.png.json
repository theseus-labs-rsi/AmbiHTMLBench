7,729</td>\n              <td>4,960,000</td>\n              <td>/</td>\n            </tr>\n            <tr>\n              <td>范围3 - 类别1 采购的产品与服务</td>\n              <td>8,494,973</td>\n              <td>/</td>\n              <td>/</td>\n            </tr>\n            <tr>\n              <td>范围3 - 类别4 上游运输</td>\n              <td>1,340,856</td>\n              <td>/</td>\n              <td>/</td>\n            </tr>\n            <tr>\n              <td>范围3 - 类别11 已售出产品使用</td>\n              <td>186,411,900</td>\n              <td>4,960,000</td>\n              <td>/</td>\n            </tr>\n            <tr class=\"row-total\">\n              <td>\n                温室气体排放总量（范围1+2+3）\n                <span class=\"subline\">（吨二氧化碳当量）</span>\n              </td>\n              <td>198,451,201</td>\n              <td>7,258,311</td>\n              <td>1,505,877</td>\n            </tr>\n          </tbody>\n        </table>\n\n        <div class=\"footnotes\">\n          <p><sup>25</sup> 范围1温室气体主要来自于固定生产设备、移动源及食堂等化石能源消耗和产品制造过程中冷媒逸散等。</p>\n          <p><sup>26</sup> 范围2温室气体包括外购电力、热力。以上排放源活动数据来源于费用发票、生产报表等。电力碳排放因子取自生态环境部《关于发布2022年电力二氧化<br>碳排放因子的公告》及国际能源署《IEA Emission Factors 2022》，外购热力排放系数参考国家发展改革委《企业温室气体排放核算方法与报告指南（试<br>行）》。采购物料的碳排放因子取自ecoinvent 3.8数据库。其他碳排放系数参考IPCC 2006 年《国家温室气体清单编制指南（试行）》等。</p>\n          <p><sup>27</sup> 2024年度较往年范围3温室气体排放源新增统计了采购的产品与服务、上游运输，且进一步完善了已售出产品品类。</p>\n        </div>\n      </section>\n\n      <section class=\"page page-right\" aria-labelledby=\"environment-heading\">\n        <div class=\"section-label\" id=\"environment-heading\">其他环境数据</div>\n\n        <table class=\"right-table\" aria-label=\"其他环境数据\">\n          <colgroup>\n            <col class=\"group-col\">\n            <col class=\"metric-col\">\n            <col class=\"unit-col\">\n            <col class=\"value-col\">\n          </colgroup>\n          <thead>\n            <tr>\n              <th colspan=\"2\">指标名称</th>\n              <th>单位</th>\n              <th>2024年</th>\n         