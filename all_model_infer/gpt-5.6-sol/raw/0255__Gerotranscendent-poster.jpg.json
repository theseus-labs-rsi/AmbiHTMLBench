2 34.5px 35px, transparent 35.5px),\n      radial-gradient(circle at 56% 30%, transparent 0 45px, #222 45.5px 46px, transparent 46.5px),\n      radial-gradient(circle at 70% 61%, transparent 0 23px, #222 23.5px 24px, transparent 24.5px),\n      radial-gradient(circle at 87% 46%, transparent 0 31px, #222 31.5px 32px, transparent 32.5px),\n      radial-gradient(circle at 76% 79%, transparent 0 16px, #222 16.5px 17px, transparent 17.5px),\n      radial-gradient(circle at 29% 78%, transparent 0 19px, #222 19.5px 20px, transparent 20.5px),\n      radial-gradient(circle at 47% 77%, transparent 0 25px, #222 25.5px 26px, transparent 26.5px);\n  }\n  .bubble-art::before,\n  .bubble-art::after {\n    content: \"\";\n    position: absolute;\n    inset: 22% 8%;\n    opacity: .9;\n    background:\n      radial-gradient(circle, #fff 0 2px, #111 2.2px 3px, transparent 3.2px) 0 0 / 10px 9px,\n      radial-gradient(circle, #fff 0 3px, #111 3.2px 4px, transparent 4.2px) 6px 4px / 17px 15px;\n    clip-path: polygon(0 58%, 18% 29%, 34% 55%, 53% 45%, 69% 65%, 86% 26%, 100% 54%, 100% 88%, 79% 72%, 63% 91%, 44% 68%, 26% 82%, 7% 71%);\n  }\n  .bubble-art::after {\n    transform: rotate(17deg) scale(.83);\n  }\n  .placeholder-label {\n    position: absolute;\n    left: 3px;\n    bottom: 2px;\n    z-index: 3;\n    padding: 1px 3px;\n    color: #777;\n    background: rgba(255,255,255,.78);\n    font-size: 5px;\n  }\n\n  .left-diagram {\n    position: absolute;\n    left: 78px;\n    top: 496px;\n    width: 282px;\n    height: 182px;\n  }\n  .right-diagram {\n    position: absolute;\n    right: 0;\n    top: 348px;\n    width: 217px;\n    height: 180px;\n  }\n  .center-diagram {\n    position: absolute;\n    left: 419px;\n    top: 543px;\n    width: 330px;\n    height: 210px;\n  }\n\n  .fielding-logo {\n    position: absolute;\n    left: 3px;\n    top: 681px;\n    width: 150px;\n    height: 76px;\n    color: #84182c;\n  }\n  .logo-mark {\n    position: absolute;\n    left: 38px;\n    top: 0;\n    width: 40px;\n    height: 38px;\n    transform: rotate(10deg);\n    border-radius: 6px 22px 5px 4px;\n    background: linear-gradient(145deg, #d7193f 0 54%, #7a001d 55% 100%);\n    clip-path: polygon(13% 100%, 37% 5%, 100% 76%);\n  }\n  .logo-mark::after {\n    content: \"\";\n    position: absolute;\n    left: 14px;\n    top: 10px;\n    width: 15px;\n    height: 15px;\n    background: white;\n    clip-path: polygon(20% 100%, 43% 0, 100% 75%);\n  }\n  .fielding-name {\n    position: absolute;\n    left: 0;\n    top: 39px;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 24px;\n    font-weight: 700;\n    letter-spacing: -1px;\n  }\n  .fielding-sub {\n    position: absolute;\n    left: 15px;\n    top: 63px;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 10px;\n    font-style: italic;\n  }\n\n  .survey-table {\n    position: absolute;\n    left: 0;\n    top: 634px;\n    width: 362px;\n    border-collapse: collapse;\n    table-layout: fixed;\n    font-size: 8px;\n    color: #555;\n  }\n  .survey-table th,\n  .survey-table td {\n    height: 18px;\n    padding: 2px 3px;\n    text-align: center;\n    font-weight: 400;\n    border: 1px solid #999;\n  }\n  .survey-table .table-title {\n    height: 20px;\n    text-align: left;\n    font-style: italic;\n  }\n\n  .references {\n    position: absolute;\n    left: 8px;\n    top: 526px;\n    width: 337px;\n  }\n  .references h3 {\n    margin: 0 0 9px;\n    text-transform: uppercase;\n    font-size: 15px;\n  }\n  .references p {\n    margin: 0 0 4px;\n    font-size: 5.7px;\n    line-height: 1.3;\n  }\n</style>\n</head>\n<body>\n<main class=\"poster\">\n  <header class=\"header\">\n    <h1>Gerotranscendent Generativity: How Older Adults Maintain a Focus on “Being” for Others</h1>\n    <div class=\"byline\">Theresa Southam, MA, PhD Student; Fielding Graduate University</div>\n  </header>\n\n  <section class=\"left-column\">\n    <div class=\"abstract\">\n      <h2>ABSTRACT</h2>\n      <p>Generativity in older adults has predominantly been defined as tangible assets delivered to others, including caring for others, civic action, and community volunteerism (Hodgkin, 2012; De St Aubin &amp; McAdams, 2004). Less light has been shone on non-physical contributions. In this research we learn how generative older adults focus on being rather than doing, while becoming what Edmondson (2015) calls socio-cultural message bearers, advisors on the human condition and creators of cultural and artistic products and practices.</p>\n    </div>\n\n    <div class=\"research\">\n      <h3>RESEARCH GOALS, PARTICIPANTS AND METHODS</h3>\n      <p>This ethnographic and phenomenologically informed research asked <span class=\"quote\">“What does it look like when older adults’ are contributing to the next generations from a gerotranscendent lens?”</span></p>\n      <p>Over two months, the researcher observed:</p>\n      <ul>\n        <li>14 participants in Intergenerational Leadership and Learning class co-facilitated by researcher.</li>\n        <li>Eight older adults recommended by a hospice society “Interlocutor who participated in two, 3-hour sessions: autobiographical life review (Wengraf, 2004) and life-cross roads (Kesari &amp; Palgi, 2017).</li>\n        <li>Three participants randomly selected from whole sample for phenomenological interviews.</li>\n      </ul>\n    </div>\n\n    <div class=\"placeholder bubble-art left-diagram\" aria-label=\"Bubble network diagram\">\n      <span class=\"placeholder-label\">[Diagram: branching circles]</span>\n    </div>\n\n    <div class=\"fielding-logo\" aria-label=\"Fielding Graduate University\">\n      <div class=\"logo-mark\"></div>\n      <div class=\"fielding-name\">FIELDING</div>\n      <div class=\"fielding-sub\">Graduate University</div>\n    </div>\n  </section>\n\n  <section class=\"middle-column\">\n    <div class=\"results-text\">\n      <h2>RESULTS</h2>\n      <p>Records of group discussions, artwork, life crossroads diagrams, a survey and observations were coded as typifications – groupings based on shared experiences. A theme, raised independently by the participants during the group discussions and vigorously agreed on by all, is highlighted.</p>\n\n      <div class=\"subhead\">Typifications</div>\n      <p><span class=\"bold\">Elders/Sages/Mentors:</span> focus on just being by talking to people that no one will talk to, acting in a way that teaches and shows, communing with nature, “adopting” children that need soul grandparents, peer counseling and bringing spirit into the body.</p>\n      <p><span class=\"bold\">Third Agers:</span> focus on doing by being remembered for actions such as reinvigorating a community organization, advocating for more environmentally sound transportation, volunteering, and tutoring.</p>\n\n      <div class=\"subhead overarching\">Overarching Theme</div>\n      <p>A focus on <span class=\"quote\">being</span> rather than <span class=\"quote\">doing</span></p>\n      <p class=\"quote\">“I feel sorry for people trying to save the world, I have a quieter more contemplative life at 70 then I had at 55.”</p>\n      <p class=\"quote\">“The older I get, people look to me, I have so much gratitude.”</p>\n    </div>\n\n    <div class=\"themes\">\n      <div class=\"theme-row\">\n        <div>\n          <div class=\"placeholder theme-image\" aria-label=\"Participant Life Crossroads Diagram\"></div>\n          <div class=\"image-caption\">Figure 1: Participant Life<br>Crossroads Diagram.</div>\n        </div>\n        <div class=\"theme-copy\"><span class=\"label\">Turning Points-</span> post-secondary education, abuse, birth, death, travel.</div>\n      </div>\n\n      <div class=\"theme-row\">\n        <div>\n          <div class=\"placeholder theme-image speckled\" aria-label=\"Drawing of dissolution of boundaries\"></div>\n          <div class=\"image-caption\">Figure 2: Drawing of Dissolution of<br>Boundaries between Self and Universe.</div>\n        </div>\n        <div class=\"theme-copy\"><span class=\"label\">Transcendence-</span> Connection to all living and non-living things.</div>\n      </div>\n\n      <div class=\"theme-row\">\n        <div>\n          <div class=\"placeholder theme-image drawing\" aria-label=\"Participant drawing\"></div>\n          <div class=\"image-caption\">Figure 3: Participant Drawing of<br>Cultivating Gratitude and Heart.</div>\n        </div>\n        <div class=\"theme-copy\"><span class=\"label\">Rituals &amp; Practices-</span> Contemplation, time in nature, meditation, yoga, and tai chi practices that cultivate gratitude, heart wisdom, grounding and forgiveness.</div>\n      </div>\n\n      <div class=\"theme-row\">\n        <div>\n          <div class=\"placeholder theme-image pale\" aria-label=\"Holding Someone in the Light\"></div>\n          <div class=\"image-caption\">Figure 4: Holding Someone<br>in the Light.</div>\n        </div>\n        <div class=\"theme-copy\"><span class=\"label\">Life Principles-</span> believing all are equal, in goodness, the law of impermanence, and a connecting spirit.</div>\n      </div>\n\n      <div class=\"theme-row\">\n        <div>\n          <div class=\"placeholder theme-image gray\" aria-label=\"Community Support\"></div>\n          <div class=\"image-caption\">Figure 5: Community Support</div>\n        </div>\n        <div class=\"theme-copy\"><span class=\"label\">Community Supports-</span> Nature, connection “being seen.”</div>\n      </div>\n    </div>\n\n    <div class=\"acknowledgements\">\n      <div class=\"ack-title\">Acknowledgements</div>\n      <div>This research was partly funded by a Social Transformation Grant from the Building Inclusive Collaborative of the Marie Fielder Center for Democracy, Leadership and Education at Fielding Graduate University</div>\n    </div>\n\n    <div class=\"crossroads\">\n      <h3>Autobiographical and Life’s Crossroads: Diagramming<br>Life’s Coherence and Meaning</h3>\n      <p>To the right, artwork and phrases that best represent the collective responses are provided. The survey is summarized in the chart.</p>\n    </div>\n\n    <table class=\"survey-table\">\n      <tr>\n        <th class=\"table-title\" colspan=\"7\">Demographic of Eight Autobiographical and Life Crossroads Exercise Participants</th>\n      </tr>\n      <tr>\n        <th>Female</th>\n        <th>Average<br>Age</th>\n        <th>Post<br>Secondary</th>\n        <th>Divorced</th>\n        <th>Living<br>Independently</th>\n        <th>Spiritual</th>\n        <th>Religious</th>\n      </tr>\n      <tr>\n        <td>6</td>\n        <td>69</td>\n        <td>4</td>\n        <td>3</td>\n        <td>All</td>\n        <td>All</td>\n        <td>None</td>\n      </tr>\n    </table>\n\n    <div class=\"placeholder bubble-art center-diagram\" aria-label=\"Branching circular diagram\">\n      <span class=\"placeholder-label\">[Diagram: branching circular network]</span>\n    </div>\n  </section>\n\n  <aside class=\"right-column\">\n    <h2>CONCLUSIONS AND NEXT STEPS</h2>\n    <p>Gerotranscendence described as where the boundaries between self and the universe dissolve.</p>\n    <p>Study participants agree on a shift in emphasis from age 55 where they were doing to 70 when they are being.</p>\n    <p class=\"quote red bold\">“People measure how much we give materialistically. They know there’s more and they feel compelled to share love.” <span class=\"tiny\">-Quote from research participant.</span></p>\n\n    <div class=\"next-steps\">\n      <h3>Next Steps</h3>\n      <p>Although older adults are largely defined in contemporary EuroAmerican culture as a burden, they are in fact abundantly generative. The ability of older adults to continue learning, leading spiritual, artistic and contemplative lives, is supported by neurological studies (Cohen, 2005). Further research on the impact on the collective consciousness of older adults’ messages, advice and creations is warranted.</p>\n    </div>\n\n    <div class=\"placeholder bubble-art right-diagram\" aria-label=\"Circular branching diagram\">\n      <span class=\"placeholder-label\">[Diagram: circular branching network]</span>\n    </div>\n\n    <div class=\"references\">\n      <h3>REFERENCES</h3>\n      <p>Batson, M.C. (2010). <span class=\"quote\">Composing a further life: The age of active wisdom.</span> New York, NY: Knopf.</p>\n      <p>Cohen, G. D. (2005). <span class=\"quote\">The mature mind: The positive power of the aging brain.</span> New York, NY: Basic Books.</p>\n      <p>Edmondson, R. (2015). <span class=\"quote\">Ageing, insight and wisdom: Meaning and practice across the lifecourse.</span> Bristol, UK: Policy Press.</p>\n      <p>Erikson, E.H. &amp; Erikson, J.M. (1998). <span class=\"quote\">The life cycle completed: Extended version.</span> New York, NY: W.W. Norton.</p>\n      <p>Hodgkin, S. (2012). “I’m older and more interested in my community”: Older people’s contributions to social capital. <span class=\"quote\">Australasian Journal on Ageing, 31</span>(1), 34-39. doi:10.1111/j.1741-6612.2011.00528.x</p>\n      <p>Kesari, S. &amp; Palgi, Y. (2017). Life-crossroads on stage: Integrating life review and drama therapy for older adults. <span class=\"quote\">Aging and Mental Health, Volume 21, Issue 10</span>, 1079-1089.</p>\n      <p>Perry, R. (2014). <span class=\"quote\">Conscious aging: embrace and savour your next chapter.</span> Simon &amp; Schuster Inc.: New York, New York.</p>\n      <p>McAdams D.B. &amp; de St Aubin E. (1992). A theory of generativity and its assessment through self-report, behavioral acts, and narrative themes in autobiography. <span class=\"quote\">Journal of Personality and Social Psychology, 62</span> (1004–1015).</p>\n      <p>Rowe, J. &amp; Kahn, R. (1998). <span class=\"quote\">Successful aging.</span> New York, NY: Dell.</p>\n      <p>Tornstam, L. (2005). <span class=\"quote\">Gerotranscendence: A developmental theory of positive aging.</span> New York, NY: Springer Publishing Company.</p>\n      <p>Wengraf, T. (2004). <span class=\"quote\">Qualitative research interviewing: Biographic narrative and semi-structured methods.</span> Thousand Oaks, California: SAGE Publications Ltd.</p>\n    </div>\n  </aside>\n</main>\n</body>\n</html>"
