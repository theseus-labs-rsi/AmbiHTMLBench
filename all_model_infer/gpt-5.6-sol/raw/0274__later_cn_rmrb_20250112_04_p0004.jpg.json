        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>人民日报·要闻 2025年1月12日</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] },\n  svg: { fontCache: 'global' }\n};\n</script>\n<script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js\"></script>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;background:#eee;color:#111}\nbody{\n  font-family:\"Noto Serif SC\",\"Songti SC\",\"SimSun\",\"STSong\",serif;\n}\n.page{\n  width:1180px;\n  min-height:1338px;\n  margin:0 auto;\n  padding:10px 12px 8px;\n  background:#fff;\n  overflow:hidden;\n}\n.masthead{\n  height:44px;\n  border-bottom:2px solid #222;\n  display:flex;\n  align-items:center;\n  position:relative;\n}\n.section-name{\n  font-size:34px;\n  line-height:1;\n  letter-spacing:2px;\n  margin-right:19px;\n}\n.page-number{\n  font-family:Arial,sans-serif;\n  font-size:30px;\n  line-height:1;\n  margin-right:21px;\n}\n.date{\n  font-size:11px;\n  letter-spacing:.5px;\n}\n.paper-name{\n  margin-left:auto;\n  font-family:\"STKaiti\",\"KaiTi\",serif;\n  font-size:28px;\n  font-weight:bold;\n  font-style:italic;\n  transform:skew(-8deg);\n  letter-spacing:-1px;\n}\n.main-grid{\n  display:grid;\n  grid-template-columns:850px 1fr;\n  column-gap:14px;\n  padding-top:14px;\n}\n.left-page{min-width:0}\n.right-page{\n  border-left:1px solid #222;\n  padding-left:14px;\n  min-width:0;\n}\n.lead-title{\n  display:grid;\n  grid-template-columns:1fr 1fr 1fr;\n  align-items:center;\n  height:61px;\n  padding:0 9px;\n}\n.lead-title span{\n  text-align:left;\n  white-space:nowrap;\n  font-family:\"Noto Sans CJK SC\",\"Microsoft YaHei\",\"SimHei\",sans-serif;\n  font-size:39px;\n  line-height:1;\n  font-weight:900;\n  letter-spacing:4px;\n}\n.byline{\n  height:16px;\n  text-align:center;\n  font-size:9px;\n  letter-spacing:2px;\n}\n.lead-colu