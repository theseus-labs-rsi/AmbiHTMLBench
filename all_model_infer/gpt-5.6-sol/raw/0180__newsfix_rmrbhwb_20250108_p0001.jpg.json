        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>人民日报海外版 2025年1月8日</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] }\n};\n</script>\n<script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  html, body { margin: 0; padding: 0; background: #ececec; }\n  body {\n    color: #111;\n    font-family: \"SimSun\", \"Songti SC\", \"Noto Serif CJK SC\", serif;\n  }\n  .page {\n    width: 800px;\n    min-height: 1200px;\n    margin: 0 auto;\n    padding: 20px 15px 12px;\n    background: #fff;\n    overflow: hidden;\n  }\n  .masthead {\n    position: relative;\n    height: 127px;\n    border-bottom: 3px solid #08749a;\n  }\n  .issue-info {\n    position: absolute;\n    left: 14px;\n    bottom: 8px;\n    width: 195px;\n    font-size: 7px;\n    line-height: 1.8;\n    color: #333;\n  }\n  .brand {\n    position: absolute;\n    top: -9px;\n    left: 205px;\n    width: 360px;\n    text-align: center;\n  }\n  .brand-name {\n    color: #c60022;\n    font-family: \"STKaiti\", \"KaiTi\", serif;\n    font-size: 73px;\n    line-height: 1;\n    font-weight: 700;\n    letter-spacing: 4px;\n    white-space: nowrap;\n  }\n  .edition-badge {\n    display: inline-block;\n    vertical-align: 22px;\n    margin-left: 4px;\n    padding: 3px 5px;\n    color: white;\n    background: #cf0929;\n    font-family: \"SimHei\", sans-serif;\n    font-size: 22px;\n    line-height: 1.05;\n    letter-spacing: 0;\n  }\n  .brand-en {\n    margin-top: -2px;\n    font-family: Georgia, serif;\n    font-size: 12px;\n    font-weight: bold;\n    font-style: italic;\n    letter-spacing: .2px;\n  }\n  .web-zone {\n    position: absolute;\n    right: 8px;\n    bottom: 8px;\n    display: flex;\n    align-items: flex-end;\n    gap: 6px;\n  }\n  .web-mark {\n    color: