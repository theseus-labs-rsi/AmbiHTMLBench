        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>现代教学观与教学原则复习资料</title>\n  <script>\n    window.MathJax = {\n      tex: {\n        inlineMath: [['$', '$']],\n        displayMath: [['$$', '$$']]\n      }\n    };\n  </script>\n  <script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * {\n      box-sizing: border-box;\n    }\n\n    html,\n    body {\n      margin: 0;\n      min-height: 100%;\n      background: #d9d9d6;\n    }\n\n    body {\n      display: flex;\n      justify-content: center;\n      padding: 0;\n      color: #252525;\n      font-family: \"SimSun\", \"Songti SC\", serif;\n    }\n\n    .page {\n      position: relative;\n      width: 540px;\n      min-height: 720px;\n      overflow: hidden;\n      padding: 17px 17px 12px 18px;\n      background:\n        radial-gradient(circle at 34% 44%, rgba(255,255,255,.28), transparent 31%),\n        linear-gradient(90deg, #efefec 0%, #e5e5e1 49%, #f0f0ed 100%);\n      box-shadow: 0 0 5px rgba(0, 0, 0, .35);\n    }\n\n    .columns {\n      display: grid;\n      grid-template-columns: 237px 1px 244px;\n      column-gap: 10px;\n      height: 100%;\n    }\n\n    .divider {\n      width: 1px;\n      height: 692px;\n      background: rgba(92, 92, 88, .33);\n    }\n\n    .column {\n      min-width: 0;\n    }\n\n    .left {\n      padding-left: 14px;\n    }\n\n    .right {\n      padding-right: 1px;\n    }\n\n    .section {\n      position: relative;\n      margin: 0 0 4px;\n    }\n\n    .heading {\n      margin: 0 0 2px;\n      font-size: 11.5px;\n      line-height: 18px;\n      font-weight: 700;\n      white-space: nowrap;\n    }\n\n    .number {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      width: 18px;\n      height: 18px;\n      margin-right: 3px;\n      border-radius: 50%;\n      color