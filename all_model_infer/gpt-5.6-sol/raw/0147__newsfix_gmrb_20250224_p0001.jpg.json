        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>光明日报 2025年2月24日</title>\n<script>\nwindow.MathJax = {\n  tex: {inlineMath: [['$', '$']], displayMath: [['$$', '$$']]}\n};\n</script>\n<script defer src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;background:#ececec;color:#111}\nbody{\n  font-family:\"SimSun\",\"Songti SC\",\"Noto Serif CJK SC\",serif;\n}\n.page{\n  width:1262px;\n  min-height:1536px;\n  margin:0 auto;\n  padding:26px 22px 18px;\n  background:#fff;\n  overflow:hidden;\n}\n.header{\n  height:270px;\n  position:relative;\n  border-bottom:1px solid #777;\n}\n.header-main{\n  height:205px;\n  display:grid;\n  grid-template-columns:585px 1fr;\n  gap:28px;\n}\n.masthead{\n  position:relative;\n  padding:0 10px;\n}\n.logo{\n  color:#d2002e;\n  height:168px;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  font-family:\"STKaiti\",\"KaiTi\",cursive;\n  font-size:122px;\n  font-weight:700;\n  letter-spacing:12px;\n  line-height:1;\n  transform:skew(-5deg);\n}\n.roman{\n  text-align:center;\n  font-family:Arial,sans-serif;\n  font-size:20px;\n  letter-spacing:8px;\n  margin-top:3px;\n}\n.editorial{\n  padding-top:12px;\n}\n.editorial h1{\n  margin:0;\n  text-align:center;\n  font-family:\"SimHei\",\"Heiti SC\",sans-serif;\n  font-size:37px;\n  line-height:1.65;\n  letter-spacing:4px;\n  font-weight:900;\n}\n.editorial .date{\n  text-align:center;\n  font-size:18px;\n  font-weight:bold;\n  margin:0 0 9px;\n}\n.editorial-columns{\n  column-count:3;\n  column-gap:15px;\n  font-size:11px;\n  line-height:1.45;\n  color:#444;\n  text-align:justify;\n}\n.date-strip{\n  position:absolute;\n  left:10px;\n  bottom:35px;\n  width:571px;\n  height:27px;\n  line-height:27px;\n  color:white;\n  background:#08689d;\n  text-align:center;\n  font-siz