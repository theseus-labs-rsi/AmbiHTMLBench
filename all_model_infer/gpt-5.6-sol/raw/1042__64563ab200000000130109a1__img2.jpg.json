0 5px;\n      background: #8faeb9;\n    }\n\n    .night-tag-1 { top: 522px; }\n    .night-tag-2 { top: 624px; }\n\n    .copy {\n      position: absolute;\n      left: 20px;\n      margin: 0;\n      font-size: 18px;\n      line-height: 21px;\n      font-weight: 400;\n      white-space: nowrap;\n    }\n\n    .copy-1 { top: 79px; }\n    .copy-2 { top: 200px; }\n    .copy-3 { top: 281px; }\n    .copy-4 { top: 403px; }\n\n    .address {\n      position: absolute;\n      left: 21px;\n      margin: 0;\n      height: 21px;\n      font-size: 18px;\n      line-height: 21px;\n      white-space: nowrap;\n    }\n\n    .address-1 { top: 545px; }\n    .address-2 { top: 647px; }\n\n    .night-copy-1 {\n      top: 568px;\n      left: 18px;\n    }\n\n    .night-copy-2 {\n      top: 670px;\n      left: 18px;\n    }\n\n    .pin {\n      position: relative;\n      display: inline-block;\n      width: 13px;\n      height: 18px;\n      margin-right: 2px;\n      vertical-align: -3px;\n    }\n\n    .pin::before {\n      content: \"\";\n      position: absolute;\n      top: 0;\n      left: 2px;\n      width: 10px;\n      height: 10px;\n      border-radius: 50%;\n      background: #f04438;\n    }\n\n    .pin::after {\n      content: \"\";\n      position: absolute;\n      top: 9px;\n      left: 6px;\n      width: 2px;\n      height: 8px;\n      background: #777777;\n      transform: rotate(5deg);\n      transform-origin: top center;\n    }\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <h1 class=\"main-title\">香港热门夜市</h1>\n\n    <div class=\"tag tag-1\">①旺角</div>\n    <p class=\"copy copy-1\">著名的通菜街女人街，顾名思义有很多女人喜欢的小物件，要<br>货比三家可以还价，仔细淘还是能淘到不少好东西的。还有波<br>鞋街，Nike, Adidas, New balance, converse的铺面不少，价<br>格折扣力度也挺大就是断码的太厉害，很多都是大尺码的。</p>\n\n    <div class=\"tag tag-2\">②庙街</div>\n    <p class=\"copy copy-2\">一到晚上就是大排档的天下！各式各样的大排档，煲仔饭、避<br>风塘炒蟹、粤式小菜、潮州打冷、茶餐厅全部都有。</p>\n\n    <div class=\"tag tag-3\">③铜锣湾</div>\n    <p class=\"copy copy-3\">主要集中在渣甸街、时代广场、波斯富街、利舞台广场和百德<br>新街，铜锣湾是有名的购物区。充满地道香港风味的大排档、<br>茶餐厅、凉茶铺、粥面店、烧味店、甜品店，也有西式菜馆、<br>台式小吃店、日本寿司店、精致的咖啡厅，丰俭由人。</p>\n\n    <div class=\"tag tag-4\">④登打士街</div>\n    <p class=\"copy copy-4\">是香港的一条著名美食街道，位于九龙油麻地及旺角交界。以<br>楼上咖啡店而著名于香港，为楼上咖啡店的集中地。满街都是<br>售卖小食的商铺，为小食店的集中地</p>\n\n    <h2 class=\"night-title\">香港夜景打卡</h2>\n\n    <div class=\"tag night-tag night-tag-1\">●维多利亚港</div>\n    <p class=\"address address-1\"><span class=\"pin\" aria-hidden=\"true\"></span>地址： 港岛北部-维多利亚港</p>\n    <p class=\"copy night-copy-1\">不要错过每天晚上8点整在江边表演的 “幻彩咏香江” 灯光秀，<br>这才是维港夜景的重头戏!</p>\n\n    <div class=\"tag night-tag night-tag-2\">●太平山顶</div>\n    <p class=\"address address-2\"><span class=\"pin\" aria-hidden=\"true\"></span>地址： 香港岛的西部-太平山</p>\n    <p class=\"copy night-copy-2\">山顶上除了比较出名的凌霄阁观景台之外，想要欣赏到港岛北<br>面的维港风情，则一定要去卢吉道观景台。</p>\n  </main>\n</body>\n</html>"
