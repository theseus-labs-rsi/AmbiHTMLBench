        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>A Shared Propensity Towards Food &amp; Alcohol</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] }\n};\n</script>\n<script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n* {\n  box-sizing: border-box;\n}\nhtml, body {\n  margin: 0;\n  min-width: 1056px;\n  min-height: 816px;\n}\nbody {\n  color: #111;\n  font-family: \"Arial Narrow\", Arial, Helvetica, sans-serif;\n  background-color: #c8c8c6;\n  background-image:\n    linear-gradient(135deg, transparent 45%, rgba(255,255,255,.30) 45%, rgba(255,255,255,.30) 52%, transparent 52%),\n    linear-gradient(225deg, transparent 45%, rgba(255,255,255,.30) 45%, rgba(255,255,255,.30) 52%, transparent 52%),\n    linear-gradient(315deg, transparent 45%, rgba(155,155,153,.28) 45%, rgba(155,155,153,.28) 52%, transparent 52%),\n    linear-gradient(45deg, transparent 45%, rgba(155,155,153,.28) 45%, rgba(155,155,153,.28) 52%, transparent 52%);\n  background-size: 15px 15px;\n}\n.page {\n  position: relative;\n  width: 1056px;\n  height: 816px;\n  margin: 0 auto;\n  overflow: hidden;\n}\n.main-title {\n  height: 108px;\n  margin: 0;\n  padding-top: 30px;\n  text-align: center;\n  color: #000;\n  font-family: Impact, Haettenschweiler, \"Arial Narrow Bold\", sans-serif;\n  font-size: 54px;\n  font-weight: 900;\n  line-height: 1;\n  letter-spacing: 1.2px;\n  white-space: nowrap;\n}\n.columns {\n  display: grid;\n  grid-template-columns: 310px 310px 310px;\n  column-gap: 20px;\n  margin-left: 44px;\n}\n.panel {\n  height: 607px;\n  background: #fff;\n  overflow: hidden;\n}\n.panel-title,\n.section-title {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  height: 39px;\n  margin: 0;\n  color: #fff;\n  background: #000;\n  font-family: Impact, Haette