        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>《红楼梦》摘抄笔记</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] },\n  svg: { fontCache: 'global' }\n};\n</script>\n<script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js\"></script>\n<style>\n* {\n  box-sizing: border-box;\n}\nhtml, body {\n  margin: 0;\n  min-height: 100%;\n}\nbody {\n  background: #ededed;\n  font-family: \"STKaiti\", \"KaiTi\", \"Kaiti SC\", \"FangSong\", serif;\n}\n.page {\n  position: relative;\n  width: 540px;\n  height: 720px;\n  margin: 0 auto;\n  overflow: hidden;\n  color: #171717;\n  background-color: #fff;\n  background-image:\n    linear-gradient(rgba(126, 149, 162, .14) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(126, 149, 162, .14) 1px, transparent 1px);\n  background-size: 16px 16px;\n}\n.placeholder {\n  display: flex;\n  align-items: flex-end;\n  justify-content: center;\n  overflow: hidden;\n  color: #9d8577;\n  background: rgba(255,255,255,.82);\n  text-align: center;\n}\n.mascot {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 49px;\n  height: 49px;\n  padding-bottom: 2px;\n  border-right: 1px solid rgba(180,180,180,.35);\n  border-bottom: 1px solid rgba(180,180,180,.35);\n  border-radius: 0 0 8px 0;\n  font: 7px/1.05 \"Microsoft YaHei\", sans-serif;\n}\n.mascot::before {\n  content: \"\";\n  position: absolute;\n  top: 5px;\n  left: 11px;\n  width: 12px;\n  height: 17px;\n  border-radius: 50% 50% 43% 43%;\n  background: #e6d0bd;\n  box-shadow:\n    -4px -2px 0 -1px #9a725f,\n    4px -2px 0 -1px #9a725f,\n    0 13px 0 2px #ead7ca;\n}\n.title-banner {\n  position: absolute;\n  top: 2px;\n  left: 50px;\n  width: 426px;\n  height: 52px;\n  border: 1px solid #dcad00;\n  background: #fff21c;\n  box-shadow: 0 1px 2px rgba(121,88,0,.2);\n}\n.title-banner h1 {\n  margin: 2px 0