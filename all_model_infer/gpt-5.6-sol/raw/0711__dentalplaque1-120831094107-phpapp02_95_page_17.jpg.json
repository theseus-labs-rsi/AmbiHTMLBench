        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Materia Alba, Dental Plaque, and Calculus</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] }\n};\n</script>\n<script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * {\n    box-sizing: border-box;\n  }\n\n  html, body {\n    margin: 0;\n    width: 100%;\n    min-height: 100%;\n    background: #666269;\n  }\n\n  body {\n    display: flex;\n    justify-content: center;\n    align-items: flex-start;\n  }\n\n  .slide {\n    position: relative;\n    width: 1024px;\n    height: 768px;\n    overflow: hidden;\n    color: #111;\n    background:\n      linear-gradient(40deg, transparent 0 34%, rgba(255,255,255,0.035) 34% 48%, transparent 48%),\n      linear-gradient(130deg, rgba(255,255,255,0.09) 0%, rgba(255,255,255,0.025) 38%, rgba(0,0,0,0.05) 72%),\n      #666269;\n  }\n\n  .comparison {\n    position: absolute;\n    top: 122px;\n    left: 3px;\n    width: 1010px;\n    height: 575px;\n    display: grid;\n    grid-template-columns: 40% 35% 25%;\n    border: 13px solid #050505;\n    background: #fff;\n    box-shadow: inset 0 0 8px rgba(0,0,0,0.12);\n  }\n\n  .column {\n    min-width: 0;\n    height: 549px;\n    background:\n      linear-gradient(to bottom, rgba(255,255,255,0.92), rgba(250,250,250,0.96)),\n      #fff;\n  }\n\n  .column + .column {\n    border-left: 2px solid #e0e0e0;\n  }\n\n  .column-title {\n    height: 62px;\n    padding: 6px 4px 0;\n    border-bottom: 2px solid #e3e3e3;\n    font-family: \"Arial Narrow\", \"Liberation Sans Narrow\", Arial, sans-serif;\n    font-stretch: condensed;\n    font-size: 40px;\n    font-weight: 400;\n    line-height: 52px;\n    white-space: nowrap;\n  }\n\n  .content {\n    font-family: \"Arial Narrow\", \"Liberation Sans Narrow\", Arial, sans-serif;\n    font-stretch: condensed;\n    font-size: 29px;\n    font-weight: 400;\n    line-height: 1.9;\n  }\n\n  .content ul {\n    margin: 0;\n    padding-left: 40px;\n    list-style-position: outside;\n  }\n\n  .content li {\n    padding-left: 3px;\n  }\n\n  .materia .content,\n  .plaque .content {\n    padding-top: 5px;\n  }\n\n  .calculus .content {\n    padding-top: 62px;\n    font-size: 29px;\n    line-height: 1.91;\n  }\n\n  .materia .content ul {\n    padding-left: 40px;\n  }\n\n  .plaque .content ul {\n    padding-left: 38px;\n  }\n\n  .calculus .content ul {\n    padding-left: 38px;\n    padding-right: 5px;\n  }\n\n  .footer-title {\n    position: absolute;\n    left: 69px;\n    top: 702px;\n    color: #f1f13b;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 33px;\n    line-height: 38px;\n    white-space: nowrap;\n  }\n\n  .footer-date {\n    position: absolute;\n    left: 60px;\n    top: 737px;\n    color: #c2bec3;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 17px;\n    line-height: 20px;\n  }\n\n  .footer-center {\n    position: absolute;\n    left: 0;\n    right: 0;\n    top: 738px;\n    color: #d1cdd1;\n    text-align: center;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 17px;\n    line-height: 20px;\n  }\n\n  .page-number {\n    position: absolute;\n    right: 51px;\n    top: 738px;\n    color: #d1cdd1;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 17px;\n    line-height: 20px;\n  }\n</style>\n</head>\n<body>\n  <main class=\"slide\">\n    <section class=\"comparison\">\n      <article class=\"column materia\">\n        <header class=\"column-title\">Materia Alba</header>\n        <div class=\"content\">\n          <ul>\n            <li>White cheeselike accumulation</li>\n            <li>A soft accumulation of salivary proteins,<br>some bacteria, many desquamated<br>epithelial cells, and occasional<br>disintegrating food debris</li>\n            <li>Lacks an organized structure and is<br>therefore not as complex as dental plaque</li>\n            <li>Easily displaced with a water spray</li>\n          </ul>\n        </div>\n      </article>\n\n      <article class=\"column plaque\">\n        <header class=\"column-title\">Dental Plaque</header>\n        <div class=\"content\">\n          <ul>\n            <li>Resilient clear to yellow-grayish<br>substance</li>\n            <li>Primarily composed of bacteria in a<br>matrix of salivary glycoproteins and<br>extracellular polysaccharides</li>\n            <li>Considered to be a biofilm</li>\n            <li>Impossible to remove by rinsing or<br>the use of sprays</li>\n          </ul>\n        </div>\n      </article>\n\n      <article class=\"column calculus\">\n        <header class=\"column-title\">Calculus</header>\n        <div class=\"content\">\n          <ul>\n            <li>Hard deposit that forms<br>by mineralization of<br>dental plaque</li>\n            <li>Generally covered by a<br>layer of unmineralized<br>dental plaque</li>\n          </ul>\n        </div>\n      </article>\n    </section>\n\n    <div class=\"footer-title\">Carranza 11<sup style=\"font-size:60%; vertical-align:super;\">th</sup> edition</div>\n    <div class=\"footer-date\">12/27/2011</div>\n    <div class=\"footer-center\">DENTAL PAQUE</div>\n    <div class=\"page-number\">17</div>\n  </main>\n</body>\n</html>"
