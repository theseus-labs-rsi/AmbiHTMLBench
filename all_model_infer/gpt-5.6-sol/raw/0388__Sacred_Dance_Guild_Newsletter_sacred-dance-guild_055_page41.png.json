        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Festival Information — Page 39</title>\n<script>\nwindow.MathJax = {\n  tex: {\n    inlineMath: [['$', '$']],\n    displayMath: [['$$', '$$']]\n  }\n};\n</script>\n<script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * {\n    box-sizing: border-box;\n  }\n\n  html,\n  body {\n    width: 100%;\n    min-height: 100%;\n    margin: 0;\n    background: #e8e5dd;\n  }\n\n  body {\n    display: flex;\n    justify-content: center;\n    align-items: flex-start;\n    padding: 10px;\n  }\n\n  .scan-frame {\n    position: relative;\n    width: 1708px;\n    height: 2187px;\n    overflow: hidden;\n    background: #f8f5e9;\n    box-shadow: 0 0 5px rgba(70, 60, 40, 0.16);\n  }\n\n  .page {\n    position: absolute;\n    left: 0;\n    top: 0;\n    width: 2187px;\n    height: 1708px;\n    overflow: hidden;\n    transform-origin: top left;\n    transform: translateX(1708px) rotate(90deg);\n    color: #171713;\n    background:\n      radial-gradient(circle at 14% 16%, rgba(132, 114, 75, 0.035), transparent 16%),\n      radial-gradient(circle at 76% 55%, rgba(133, 113, 75, 0.027), transparent 20%),\n      repeating-linear-gradient(\n        2deg,\n        rgba(94, 77, 49, 0.010) 0,\n        rgba(94, 77, 49, 0.010) 1px,\n        transparent 1px,\n        transparent 7px\n      ),\n      #faf8ee;\n    font-family: \"Segoe Print\", \"Bradley Hand\", \"Comic Sans MS\", cursive;\n    font-weight: 500;\n  }\n\n  .page-number {\n    position: absolute;\n    top: 20px;\n    right: 24px;\n    font-family: Georgia, serif;\n    font-size: 27px;\n    letter-spacing: 1px;\n  }\n\n  .section {\n    position: absolute;\n    left: 87px;\n    width: 2035px;\n  }\n\n  .section-title {\n    position: absolute;\n    left: 0;\n    top: 0;\n    width: 315px;\n    font-size: 30px;\n    line-height: 1.2;\n    white-space: nowrap;\n  }\n\n  .section-title span {\n    display: inline-block;\n    padding-bottom: 3px;\n    border-bottom: 3px solid #222;\n  }\n\n  .content {\n    position: absolute;\n    left: 350px;\n    top: 0;\n    width: 1680px;\n    font-size: 26px;\n    line-height: 1.56;\n    letter-spacing: 0.15px;\n  }\n\n  .line {\n    height: 41px;\n    white-space: nowrap;\n  }\n\n  .inline-label {\n    display: inline-block;\n    margin-right: 7px;\n    padding-bottom: 0;\n    line-height: 1.05;\n    border-bottom: 2px solid #222;\n  }\n\n  .security {\n    top: 86px;\n    height: 170px;\n  }\n\n  .register {\n    top: 274px;\n    height: 112px;\n  }\n\n  .extra {\n    top: 394px;\n    height: 108px;\n  }\n\n  .where {\n    top: 518px;\n    height: 104px;\n  }\n\n  .accessibility {\n    top: 625px;\n    height: 405px;\n  }\n\n  .bring {\n    top: 1044px;\n    height: 391px;\n  }\n\n  .sharing {\n    top: 1440px;\n    height: 145px;\n  }\n\n  .committee {\n    top: 1593px;\n    height: 115px;\n  }\n\n  .committee .content {\n    width: 1730px;\n  }\n\n  .committee-columns {\n    position: relative;\n    width: 1700px;\n    height: 100px;\n  }\n\n  .committee-left {\n    position: absolute;\n    left: 0;\n    top: 0;\n    width: 620px;\n  }\n\n  .committee-right {\n    position: absolute;\n    left: 585px;\n    top: 0;\n    width: 950px;\n    white-space: nowrap;\n  }\n\n  .faint-mark {\n    position: absolute;\n    color: rgba(25, 24, 20, 0.65);\n    font-family: Georgia, serif;\n    font-size: 18px;\n  }\n\n  .mark-one {\n    left: 55px;\n    top: 49px;\n  }\n\n  .mark-two {\n    left: 160px;\n    top: 45px;\n  }\n\n  .mark-three {\n    left: 1090px;\n    top: 55px;\n  }\n</style>\n</head>\n<body>\n<div class=\"scan-frame\">\n  <main class=\"page\">\n    <div class=\"faint-mark mark-one\">•</div>\n    <div class=\"faint-mark mark-two\">•</div>\n    <div class=\"faint-mark mark-three\">•</div>\n\n    <div class=\"page-number\">- 39 -</div>\n\n    <section class=\"section security\">\n      <div class=\"section-title\"><span>Security</span></div>\n      <div class=\"content\">\n        <div class=\"line\">Detex card for dormitory access and keys for rooms will be issued to all registrants to use during</div>\n        <div class=\"line\">the Festival; if lost there will be a $10. charge for the card and $1. for key.</div>\n        <div class=\"line\">In case of cancellation, Festival fee will be refunded less $25.</div>\n      </div>\n    </section>\n\n    <section class=\"section register\">\n      <div class=\"section-title\"><span>To Register</span></div>\n      <div class=\"content\">\n        <div class=\"line\">Complete the registration form with full payment to Sacred Dance Guild Festival and mail to</div>\n        <div class=\"line\">Joan Sparrow, Box 67, South Orleans, Ma. 02662</div>\n      </div>\n    </section>\n\n    <section class=\"section extra\">\n      <div class=\"section-title\"><span>Extra Information</span></div>\n      <div class=\"content\">\n        <div class=\"line\">For additional information contact Joan Sparrow, Registrar, Tel. 617-255-0243 or 617-369-2008 or</div>\n        <div class=\"line\">Gloria Castano, Program Director, Tel. 617-329-4448</div>\n      </div>\n    </section>\n\n    <section class=\"section where\">\n      <div class=\"section-title\"><span>Where</span></div>\n      <div class=\"content\">\n        <div class=\"line\">The Festival will provide meals and rooms at Endicott College, Beverly, Ma. (Class sessions will be</div>\n        <div class=\"line\">there and at nearby Notre Dame Chapel in Ipswich.</div>\n      </div>\n    </section>\n\n    <section class=\"section accessibility\">\n      <div class=\"section-title\"><span>Accessibility</span></div>\n      <div class=\"content\">\n        <div class=\"line\"><span class=\"inline-label\">By car</span> - Mass Turnpike to Route 128 (North) to Exit 17 (Grapevine Rd.) The sign at the exit reads</div>\n        <div class=\"line\">“Beverly Farms,” take a right on to Grapevine Rd. (which becomes Hart St.) and follow to the end.</div>\n        <div class=\"line\">Take a <span class=\"inline-label\">right</span> on Rt. 127 and continue on to Endicott. Pass the main entrance to the college.</div>\n        <div class=\"line\">Further along, registration is at Tupper Hall on the left.</div>\n        <div class=\"line\"><span class=\"inline-label\">By train</span> - Take Boston and Main Railroad from North Station in Boston to Beverly (Approx. 35 min.)</div>\n        <div class=\"line\">and taxi to Tupper Hall for registration.</div>\n        <div class=\"line\"><span class=\"inline-label\">By plane</span> - to Logan Airport in Boston, by subway or taxi to North Station, Boston and then by train.</div>\n      </div>\n    </section>\n\n    <section class=\"section bring\">\n      <div class=\"section-title\"><span>What to Bring</span></div>\n      <div class=\"content\">\n        <div class=\"line\"><span class=\"inline-label\">Required</span> - Membership card, a <span class=\"inline-label\">blanket</span> (sheets &amp; pillow case provided) leotard, tights and skirts</div>\n        <div class=\"line\">for dance, casual dress, dance clothes for church service.</div>\n        <div class=\"line\"><span class=\"inline-label\">Optional</span> - extra towel (only one provided) wash cloth (none provided) flashlights, tennis gear,</div>\n        <div class=\"line\">beach clothes, camera, tape recorder, musical instruments, notebooks, alarm clock and wonderful</div>\n        <div class=\"line\">costumes for worship.</div>\n        <div class=\"line\"><span class=\"inline-label\">Resource Table</span> - photographs, programs, dance books, records and costumes. Please label all items.</div>\n        <div class=\"line\">Not responsible for loss.</div>\n      </div>\n    </section>\n\n    <section class=\"section sharing\">\n      <div class=\"section-title\"><span>Sharing</span></div>\n      <div class=\"content\">\n        <div class=\"line\">If you wish to share a solo or group work during prayer times please write information to Program</div>\n        <div class=\"line\">Director giving title, description and equipment needed. Mail to: Gloria Castano, 90 High St.</div>\n        <div class=\"line\">Dedham Ma. 02026.</div>\n      </div>\n    </section>\n\n    <section class=\"section committee\">\n      <div class=\"section-title\"><span>Festival Committee</span></div>\n      <div class=\"content\">\n        <div class=\"committee-columns\">\n          <div class=\"committee-left\">\n            <div class=\"line\">Sacred Dance Guild Officers:</div>\n            <div class=\"line\">Joan Sparrow, Corresponding Secretary; Sybille Voltz, Helps &amp; Guidelines Director; Jany Yoon, Financial As</div>\n          </div>\n          <div class=\"committee-right\">\n            <div class=\"line\">Gloria Castano, National Program Director</div>\n          </div>\n        </div>\n      </div>\n    </section>\n  </main>\n</div>\n</body>\n</html>"
