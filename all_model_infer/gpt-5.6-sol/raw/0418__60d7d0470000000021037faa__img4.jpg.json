arent 1px);\n  background-size:16px 16px;\n}\n.paper:before{\n  content:\"\";\n  position:absolute;\n  left:20px;\n  top:0;\n  bottom:0;\n  width:1px;\n  background:rgba(228,115,112,.45);\n}\n.notes{\n  position:relative;\n  z-index:1;\n  font-family:SimSun,\"Songti SC\",\"Noto Serif CJK SC\",serif;\n  font-size:13.6px;\n  line-height:18.5px;\n}\n.line{\n  height:18.5px;\n  margin:0;\n  white-space:nowrap;\n}\n.section-title{\n  height:19px;\n  margin:0;\n  white-space:nowrap;\n  font-weight:500;\n}\n.label-red{color:#d63434;font-weight:700}\n.label-teal{color:#008b89;font-weight:700}\n.label-brown{color:#8d523d}\n.hand{\n  font-family:KaiTi,\"STKaiti\",\"Kaiti SC\",cursive;\n  font-weight:500;\n}\n.red-hand{color:#e03b4f}\n.blue-hand{color:#4c9bc0}\n.purple-hand{color:#ae65bc}\n.teal-hand{color:#178d94}\n.hl-blue,.hl-pink,.hl-purple{\n  padding:0 2px;\n  margin:0 -1px;\n  border-radius:8px 11px 7px 9px;\n}\n.hl-blue{background:rgba(51,194,204,.27)}\n.hl-pink{background:rgba(241,91,143,.20)}\n.hl-purple{background:rgba(183,88,204,.22)}\n.gap-scribble{\n  position:relative;\n  height:38px;\n}\n.scribble-one{\n  position:absolute;\n  top:-2px;\n  left:322px;\n  color:#4b98bc;\n  font-family:KaiTi,\"STKaiti\",cursive;\n  font-size:18px;\n  transform:rotate(-2deg);\n  white-space:nowrap;\n}\n.scribble-two{\n  position:absolute;\n  top:13px;\n  left:62px;\n  color:rgba(55,146,181,.67);\n  font-family:KaiTi,\"STKaiti\",cursive;\n  font-size:33px;\n  letter-spacing:5px;\n  transform:rotate(-7deg);\n  white-space:nowrap;\n}\n.scribble-two-small{\n  position:absolute;\n  top:3px;\n  left:171px;\n  color:rgba(55,146,181,.67);\n  font-family:KaiTi,\"STKaiti\",cursive;\n  font-size:29px;\n  transform:rotate(-4deg);\n  white-space:nowrap;\n}\n.inline-note{\n  font-size:18px;\n  letter-spacing:1px;\n}\n.compact{\n  letter-spacing:-.1px;\n}\n.bottom-section{\n  margin-top:3px;\n}\n.bottom-section .line{\n  line-height:18px;\n  height:18px;\n}\n</style>\n</head>\n<body>\n<div class=\"phone\">\n  <div class=\"statusbar\">\n    <div>上午9:10&nbsp;&nbsp; 6月27日周日</div>\n    <div class=\"status-right\">\n      <span>⌁</span><span>◉</span><span>91%</span>\n      <span class=\"battery\"><span class=\"battery-level\"></span></span>\n    </div>\n  </div>\n\n  <div class=\"mainbar\">\n    <div class=\"bar-left\">\n      <span class=\"icon\">‹</span>\n      <span class=\"icon\">▦</span>\n      <span class=\"icon\">⌕</span>\n      <span class=\"icon\">♧</span>\n      <span class=\"icon\">⇧</span>\n    </div>\n    <div class=\"doc-number\">333 <small>⌄</small></div>\n    <div class=\"bar-right\">\n      <span class=\"icon\">↶</span>\n      <span class=\"icon\">↷</span>\n      <span class=\"icon\">♧</span>\n      <span class=\"icon\">×</span>\n      <span class=\"icon\">•••</span>\n    </div>\n  </div>\n\n  <div class=\"toolbar\">\n    <span class=\"tool\">▧</span>\n    <span class=\"tool\"><span class=\"pen\"></span></span>\n    <span class=\"tool\"><span class=\"pen\"></span></span>\n    <span class=\"tool\"><span class=\"eraser\"></span></span>\n    <span class=\"tool\"><span class=\"lasso\"></span></span>\n    <span class=\"tool\"><span class=\"image-icon\"></span></span>\n    <span class=\"tool\"><span class=\"camera\"></span></span>\n    <span class=\"tool text-tool\">T</span>\n    <span class=\"tool\"><span class=\"pen\"></span></span>\n    <span class=\"tool\"><span class=\"color-dot dot-orange\"></span></span>\n    <span class=\"tool\"><span class=\"color-dot dot-blue\"></span></span>\n    <span class=\"tool\"><span class=\"color-dot dot-green\"></span></span>\n    <span class=\"tool more-box\">•</span>\n    <span class=\"tool\"><span class=\"color-dot dot-black\"></span></span>\n  </div>\n\n  <main class=\"paper\">\n    <div class=\"notes\">\n      <div class=\"section-title\">\n        葛雷制\n        <span class=\"hand red-hand inline-note\">（没考过）口诀：捡内衣（简介、内容、意义）</span>\n      </div>\n      <div class=\"line\"><span class=\"label-red\">简介：</span>葛雷制又称“双校制”、“二部制”。是美国教育家沃特在葛雷市所推行的一种</div>\n      <div class=\"line\">教学制度。</div>\n      <div class=\"line\"><span class=\"label-teal\">内容：</span>以杜威的教育思想为理论基础，把学校分为四个部分：<span class=\"hl-blue\">工厂</span>和商店、<span class=\"hl-blue\">教室</span>、<span class=\"hl-blue\">礼</span></div>\n      <div class=\"line\"><span class=\"hl-blue\">堂</span>、<span class=\"hl-blue\">体育</span>运动场；课程也分为四个方面:家政和工艺、团体活动、体育游戏、学术。</div>\n      <div class=\"line\">为了减少经费，将全校学生一分为二，一部分在教室上课，一部分在其他场所活动，</div>\n      <div class=\"line\">上下午对调。</div>\n      <div class=\"line\"><span class=\"label-red\">意义：</span>葛雷制是美国进步主义教育运动中最卓越的例子，既有利于保持儿童的兴趣，</div>\n      <div class=\"line\">也有着经济高效的管理方式</div>\n\n      <div class=\"gap-scribble\">\n        <div class=\"scribble-one\">（课程分为 加工团体学）</div>\n        <div class=\"scribble-two\">@ N[illegible]</div>\n        <div class=\"scribble-two-small\">起义 3[?]A[?]</div>\n      </div>\n\n      <div class=\"section-title\">\n        昆西教学法\n        <span class=\"hand label-brown\">（考过简答）</span>\n        <span class=\"hand red-hand inline-note\">口诀：合泪评价（含义,内容,评价）</span>\n      </div>\n      <div class=\"line\">一、<span class=\"label-red\">含义：</span>昆西教学法由美国进步主义教育家帕克创办的一种教学方法。</div>\n      <div class=\"line\">二、<span class=\"label-red\">内容：</span><span class=\"hand blue-hand inline-note\">（儿童中心、学校、实际联系、培养创造）</span></div>\n      <div class=\"line\">1、强调<span class=\"hl-blue\">儿童</span>应处于学校教育的<span class=\"hl-blue\">中心</span>；认为儿童具有内在的能力，能自发地学习。</div>\n      <div class=\"line\">2、<span class=\"hl-blue\">重视学校</span>的社会功能。强调学校应成为理想的家庭、完善的社会和民主政治的雏</div>\n      <div class=\"line\">形。</div>\n      <div class=\"line\">3、<span class=\"hl-blue\">学校课程与实际生活相联系</span>。这样不仅可以唤起儿童学习的意愿，而且能摒弃无</div>\n      <div class=\"line\">意义的形式训练。并把各门学科统一起来，获得整体知识。</div>\n      <div class=\"line\">4、强调培养儿童的自我探索和<span class=\"hl-blue\">创造精神</span>。帕克认为教师的作用是指导学生发现真</div>\n      <div class=\"line\">理，使学生养成习惯来使用真理。</div>\n      <div class=\"line\">三、<span class=\"label-red\">评价：</span><span class=\"hand purple-hand inline-note\">（调动儿童积极 忽视系统学习）</span></div>\n      <div class=\"line\">1、昆西教学法有利于<span class=\"hl-purple\">调动儿童</span>学习的积极性和主动性，满足学生的兴趣与需要，使</div>\n      <div class=\"line\">儿童成为学习的主人</div>\n      <div class=\"line\">2、昆西教学法过分强调儿童的个性，忽视教师的作用，<span class=\"hl-purple\">忽略了系统知识的学习</span>，导</div>\n      <div class=\"line\">致教学质量降低</div>\n\n      <div class=\"bottom-section\">\n        <div class=\"section-title\">\n          昆西教学法\n          <span class=\"hand label-brown\">（考过名词解释）</span>\n          <span class=\"hand red-hand inline-note\">口诀：合泪评价（含义,内容,评价）</span>\n        </div>\n        <div class=\"line compact\"><span class=\"label-red\">含义：</span>昆西教学法由美国进步主义教育家帕克创办的一种教学方法。</div>\n        <div class=\"line compact\"><span class=\"label-red\">内容：</span>强调<span class=\"hl-purple\">儿童</span>应处于学校教育的<span class=\"hl-blue\">中心</span>；<span class=\"hl-blue\">重视学校</span>的社会功能；强调学校应成为理想</div>\n        <div class=\"line compact\">的家庭、完善的社会和民主政治的雏形；<span class=\"hl-blue\">学校课程与实际生活相联系</span>；强调培养儿童</div>\n        <div class=\"line compact\">的自我探索和<span class=\"hl-blue\">创造精神</span><span class=\"hand blue-hand inline-note\">（儿童中心、重社会、实际联系、培养创造）</span></div>\n        <div class=\"line compact\"><span class=\"label-red\">评价：</span>昆西教学法有利于调动儿童学习的积极性和主动性，但过分强调儿童的个性，</div>\n        <div class=\"line compact\"><span class=\"hl-purple\">忽略了系统知识的学习</span>，导致教学质量降低<span class=\"hand purple-hand inline-note\">（调动儿童积极，忽视系统学习）</span></div>\n      </div>\n    </div>\n  </main>\n</div>\n</body>\n</html>"
