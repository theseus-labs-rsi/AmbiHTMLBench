iv class=\"scheme-code\">F3:</div>\n          <div class=\"scheme-text\">Raja Mongkut melaksanakan birokrasi Barat</div>\n        </div>\n        <div class=\"scheme-row\">\n          <div class=\"scheme-code\">H3a:</div>\n          <div class=\"scheme-text\">Penasihat Barat dibawa masuk untuk melatih pegawai<br>tempatan</div>\n        </div>\n        <div class=\"scheme-row\">\n          <div class=\"scheme-code\">C3a:</div>\n          <div class=\"scheme-text\">Dalam pentadbiran kewangan/ pelabuhan /kastam<br>ketenteraan/polis</div>\n        </div>\n      </div>\n\n      <div class=\"scheme-column\">\n        <div class=\"scheme-row\">\n          <div class=\"scheme-code\">H3b:</div>\n          <div class=\"scheme-text\">Guru dari Britain dibawa masuk untuk melaksanakan<br>sistem pendidikan Barat</div>\n        </div>\n        <div class=\"scheme-row\">\n          <div class=\"scheme-code\">H3c:</div>\n          <div class=\"scheme-text\">Ini membentuk imej Thailand sebagai negara yang<br>bersahabat dengan Barat</div>\n        </div>\n        <div class=\"scheme-row\">\n          <div class=\"scheme-code\">F4:</div>\n          <div class=\"scheme-text\">Usaha Raja Mongkut di teruskan oleh Raja<br>Chulalongkorn</div>\n        </div>\n        <div class=\"scheme-row\">\n          <div class=\"scheme-code\">H4a:</div>\n          <div class=\"scheme-text\">Menjadikan Thailand negara yang bebas daripada<br>penjajahan kuasa Barat</div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"writing-lines\" aria-label=\"Ruang jawapan\">\n      <div class=\"writing-line\"></div>\n      <div class=\"writing-line\"></div>\n      <div class=\"writing-line\"></div>\n      <div class=\"writing-line\"></div>\n      <div class=\"writing-line\"></div>\n      <div class=\"writing-line\"></div>\n      <div class=\"writing-line\"></div>\n    </section>\n  </main>\n\n  <section class=\"part-b\">\n    <div class=\"sub-label\">(b)</div>\n    <div class=\"part-b-text\">\n 