        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>人民日报 2025年1月2日 第3版 要闻</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] },\n  svg: { fontCache: 'global' }\n};\n</script>\n<script defer src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js\"></script>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;background:#e7e7e7;color:#111}\nbody{font-family:\"SimSun\",\"Songti SC\",\"Noto Serif CJK SC\",serif}\n.page{\n  width:800px;\n  height:1131px;\n  margin:0 auto;\n  padding:8px 9px 7px;\n  background:#fff;\n  overflow:hidden;\n}\n.topbar{\n  height:32px;\n  border-bottom:1.4px solid #111;\n  display:flex;\n  align-items:flex-end;\n  justify-content:space-between;\n  padding-bottom:3px;\n}\n.masthead{\n  font-family:\"STKaiti\",\"KaiTi\",serif;\n  font-size:25px;\n  font-weight:700;\n  line-height:1;\n  letter-spacing:-3px;\n  transform:skew(-7deg);\n}\n.issue{\n  display:flex;\n  align-items:flex-end;\n  gap:12px;\n  font-family:Arial,\"Microsoft YaHei\",sans-serif;\n}\n.date{font-size:7px;padding-bottom:3px}\n.page-number{font-size:26px;line-height:23px}\n.section-name{\n  font-size:23px;\n  line-height:24px;\n  font-weight:700;\n  letter-spacing:5px;\n}\n.newspaper{\n  display:grid;\n  grid-template-columns:580px 185px;\n  gap:10px;\n  padding-top:8px;\n}\n.primary{width:580px}\n.sidebar{\n  width:185px;\n  border-left:1px solid #777;\n  padding-left:9px;\n}\n.hero{\n  height:522px;\n  border-bottom:1px solid #444;\n  overflow:hidden;\n}\n.hero h1{\n  margin:17px 0 3px;\n  text-align:center;\n  font-family:\"Microsoft YaHei\",\"SimHei\",sans-serif;\n  font-size:30px;\n  line-height:1.16;\n  letter-spacing:1px;\n  white-space:nowrap;\n}\n.hero h2{\n  margin:3px 0 17px;\n  text-align:center;\n  font-family:\"STKaiti\",\"KaiTi\",serif;\n  font-size:20px;\n  font-weight:500;\n  lette