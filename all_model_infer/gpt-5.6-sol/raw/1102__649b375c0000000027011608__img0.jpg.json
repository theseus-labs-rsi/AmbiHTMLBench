        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>50个行为经济学概念</title>\n  <script>\n    window.MathJax = {\n      tex: { inlineMath: [['$', '$'], ['\\\\(', '\\\\)']], displayMath: [['$$', '$$'], ['\\\\[', '\\\\]']] },\n      svg: { fontCache: 'global' }\n    };\n  </script>\n  <script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js\"></script>\n  <style>\n    * {\n      box-sizing: border-box;\n    }\n\n    html,\n    body {\n      margin: 0;\n      padding: 0;\n      background: #ffffff;\n      color: #222222;\n      font-family: Arial, \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif;\n    }\n\n    .document {\n      width: 540px;\n      min-height: 690px;\n      margin: 0 auto;\n      background: #ffffff;\n    }\n\n    .title {\n      height: 86px;\n      display: flex;\n      align-items: center;\n      padding: 0 4px;\n      background: #090909;\n      color: #ffffff;\n      font-size: 48px;\n      line-height: 1;\n      font-weight: 400;\n      white-space: nowrap;\n    }\n\n    .concept-list {\n      padding: 4px 6px 5px;\n    }\n\n    .concept {\n      display: grid;\n      grid-template-columns: 188px 1fr;\n      min-height: 53px;\n      margin-bottom: 4px;\n      border-radius: 10px;\n      overflow: hidden;\n      font-size: 15px;\n      line-height: 1.22;\n    }\n\n    .concept:last-child {\n      margin-bottom: 0;\n    }\n\n    .label {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      padding: 3px 8px;\n      color: #ffffff;\n      text-align: center;\n      font-size: 16px;\n      line-height: 1.08;\n    }\n\n    .description {\n      display: flex;\n      align-items: center;\n      padding: 5px 10px 5px 8px;\n      color: #222222;\n    }\n\n    .description::before {\n      content: \"•\";\n      flex: 0 0 auto;\n      margin-right: 5px;\n      font-size: 17px;\n      line-height: 1;\n    }\n\n    .orange .label {\n      background: #ff6900;\n    }\n\n    .orange .description {\n      background: #f8d8d1;\n    }\n\n    .gray .label {\n      background: #a6a6a6;\n    }\n\n    .gray .description {\n      background: #e4e4e4;\n    }\n\n    .yellow .label {\n      background: #ffc000;\n    }\n\n    .yellow .description {\n      background: #fceacb;\n    }\n\n    .blue .label {\n      background: #3b9bd2;\n    }\n\n    .blue .description {\n      background: #d4e3f0;\n    }\n\n    .green .label {\n      background: #4caf31;\n    }\n\n    .green .description {\n      background: #d9e8d4;\n    }\n\n    .orange-red .label {\n      background: #ff6d00;\n    }\n\n    .orange-red .description {\n      background: #f8d7cd;\n    }\n\n    @media (max-width: 540px) {\n      .document {\n        width: 100%;\n      }\n\n      .title {\n        height: auto;\n        min-height: 78px;\n        padding: 9px 4px;\n        font-size: clamp(28px, 8.9vw, 48px);\n      }\n\n      .concept {\n        grid-template-columns: 35% 65%;\n      }\n\n      .label,\n      .description {\n        font-size: clamp(12px, 3.1vw, 16px);\n      }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"document\">\n    <header class=\"title\">50个行为经济学概念</header>\n\n    <section class=\"concept-list\">\n      <article class=\"concept orange\">\n        <div class=\"label\">内在动机（Intrinsic<br>Motivation）</div>\n        <div class=\"description\">基于内在兴趣和满足感进行行动的动机，而非外部奖励或惩罚。</div>\n      </article>\n\n      <article class=\"concept gray\">\n        <div class=\"label\">比较效用（Relative<br>Utility）</div>\n        <div class=\"description\">人们对于收益和满足感的评估通常是基于相对参照点的比较，而非绝对数值。</div>\n      </article>\n\n      <article class=\"concept yellow\">\n        <div class=\"label\">消费者无知<br>（Consumer<br>Ignorance）</div>\n        <div class=\"description\">消费者对于市场信息和产品特性的缺乏了解，导致决策受到影响。</div>\n      </article>\n\n      <article class=\"concept blue\">\n        <div class=\"label\">合作与竞争<br>（Cooperation vs.<br>Competition）</div>\n        <div class=\"description\">人们在决策和行为中受到与他人合作或竞争的影响，从而改变决策策略。</div>\n      </article>\n\n      <article class=\"concept green\">\n        <div class=\"label\">持续效应（Sunk Cost<br>Fallacy）</div>\n        <div class=\"description\">人们倾向于将过去已经发生的成本视为不可逆转，继续投入资源，即使当前决策并不理性。</div>\n      </article>\n\n      <article class=\"concept orange-red\">\n        <div class=\"label\">心理账户（Mental<br>Account）</div>\n        <div class=\"description\">人们对于不同资金来源的分配和使用会有不同的偏好和行为，形成不同的心理账户。</div>\n      </article>\n\n      <article class=\"concept gray\">\n        <div class=\"label\">失败回避（Loss<br>Avoidance）</div>\n        <div class=\"description\">人们更倾向于避免损失而非追求收益，因此在决策中可能会选择保守的选择。</div>\n      </article>\n\n      <article class=\"concept yellow\">\n        <div class=\"label\">群体迷思（Groupthink）</div>\n        <div class=\"description\">在群体中，人们为了与他人保持一致和获得认同而放弃独立思考，导致决策偏差。</div>\n      </article>\n\n      <article class=\"concept blue\">\n        <div class=\"label\">时间不一致（Time<br>Inconsistency）</div>\n        <div class=\"description\">人们在时间跨度较长的决策中容易受到即时满足的影响，而忽视长期利益。</div>\n      </article>\n\n      <article class=\"concept green\">\n        <div class=\"label\">心理障碍<br>（Psychological<br>Barrier）</div>\n        <div class=\"description\">人们在决策中受到情绪、态度和信念等心理因素的影响，产生决策偏差。</div>\n      </article>\n    </section>\n  </main>\n</body>\n</html>"
