        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>人民日报 2025年2月18日</title>\n  <script>\n    window.MathJax = {\n      tex: {\n        inlineMath: [['$', '$']],\n        displayMath: [['$$', '$$']]\n      }\n    };\n  </script>\n  <script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * {\n      box-sizing: border-box;\n    }\n\n    html,\n    body {\n      margin: 0;\n      padding: 0;\n      background: #d9d9d9;\n      color: #111;\n      font-family: \"SimSun\", \"Songti SC\", serif;\n    }\n\n    .page {\n      width: 800px;\n      min-height: 1130px;\n      margin: 0 auto;\n      padding: 7px 8px 8px;\n      overflow: hidden;\n      background: #fff;\n    }\n\n    .masthead {\n      display: grid;\n      grid-template-columns: 292px 91px 1fr;\n      height: 159px;\n      border-bottom: 2px solid #111;\n    }\n\n    .brand {\n      position: relative;\n      padding: 2px 4px 0;\n    }\n\n    .brand-cn {\n      height: 115px;\n      color: #c90023;\n      font-family: \"STKaiti\", \"KaiTi\", serif;\n      font-size: 78px;\n      font-weight: 700;\n      line-height: 1.25;\n      letter-spacing: 2px;\n      white-space: nowrap;\n      transform: skew(-5deg);\n      transform-origin: center;\n    }\n\n    .brand-en {\n      margin-top: -4px;\n      color: #9f0018;\n      font-family: Georgia, serif;\n      font-size: 15px;\n      font-weight: 700;\n      text-align: center;\n      letter-spacing: 4px;\n    }\n\n    .brand-info {\n      margin-top: 3px;\n      font-size: 8px;\n      text-align: center;\n      letter-spacing: 1px;\n    }\n\n    .date-box {\n      align-self: start;\n      height: 151px;\n      margin: 0 0 0 7px;\n      padding: 8px 4px 4px;\n      border: 2px solid #999;\n      text-align: center;\n    }\n\n    .date-year {\n      font-size: 8px;\n    }\n\n    .date-day