        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>光明日报 2025年3月24日</title>\n<script>\n  window.MathJax = { tex: { inlineMath: [['$','$'], ['\\\\(','\\\\)']] } };\n</script>\n<script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  *{box-sizing:border-box}\n  body{\n    margin:0;\n    background:#fff;\n    color:#111;\n    font-family:\"SimSun\",\"宋体\",serif;\n  }\n  .page{\n    width:1220px;\n    margin:22px auto;\n    padding:0 20px 20px;\n    overflow:hidden;\n  }\n  .masthead{\n    display:grid;\n    grid-template-columns: 49% 51%;\n    min-height:255px;\n    border-bottom:1px solid #555;\n    padding-bottom:8px;\n  }\n  .brand{\n    padding:0 12px 0 10px;\n  }\n  .calligraphy{\n    height:165px;\n    color:#c90035;\n    font-family:\"STKaiti\",\"KaiTi\",cursive;\n    font-size:95px;\n    letter-spacing:12px;\n    line-height:145px;\n    white-space:nowrap;\n    transform:skew(-5deg);\n  }\n  .pinyin{\n    text-align:center;\n    font-family:Arial,sans-serif;\n    letter-spacing:9px;\n    font-size:20px;\n    margin:0 0 8px;\n  }\n  .bluebar{\n    background:#0875a4;\n    color:white;\n    text-align:center;\n    font-size:16px;\n    padding:4px 0;\n    letter-spacing:1px;\n  }\n  .subbar{\n    text-align:center;\n    font-size:12px;\n    font-weight:bold;\n    padding-top:7px;\n    white-space:nowrap;\n  }\n  .intro{\n    padding:10px 4px 0 26px;\n  }\n  .intro h1{\n    margin:0 0 17px;\n    font-family:\"SimHei\",\"黑体\",sans-serif;\n    font-size:34px;\n    line-height:1.2;\n    font-weight:900;\n  }\n  .introcols{\n    display:grid;\n    grid-template-columns:repeat(3,1fr);\n    gap:17px;\n    font-size:12px;\n    line-height:1.5;\n    text-align:justify;\n  }\n  .headline{\n    background:#fff0df;\n    margin-top:14px;\n    padding:13px 18px 10px;\n  }\n  .bulletgrid{\n    display:grid;\n 