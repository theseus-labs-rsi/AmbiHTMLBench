t-align:center;padding:5px 12px;\n}\n.life-title{color:#d31f31;font-weight:900;font-size:19px;margin-bottom:5px}\n.life-flow{font-size:14px;font-weight:900;word-spacing:7px}\n.arrow{color:#d6252f;font-size:20px}\n.life-desc{font-size:13px;font-weight:800;line-height:1.55;margin-top:3px}\n.life-desc small{color:#315d8d;font-size:11px}\n.circles{height:75px;position:relative;margin-top:3px}\n.circle{\n  position:absolute;width:57px;height:57px;border-radius:50%;color:#fff;\n  display:flex;align-items:center;justify-content:center;text-align:center;\n  font-size:10px;font-weight:900;line-height:1.2;\n}\n.c1{left:13px;top:12px;background:#43a991}.c2{left:90px;top:2px;background:#3b7db8}\n.c3{left:192px;top:2px;background:#efa83d}.c4{left:143px;top:31px;background:#e4584a}\n.c5{right:10px;top:12px;background:#7150a2}\n.link{\n  position:absolute;height:0;border-top:7px solid #4d87b4;border-left:10px solid transparent;\n  border-right:10px solid transparent;transform:rotate(90deg)\n}\n.l1{left:72px;top:33px}.l2{left:163px;top:20px}.l3{right:67px;top:33px}\n\n.cheer{height:185px;position:relative;text-align:center}\n.cheer .stars{font-size:26px;color:#edb40e;letter-spacing:18px}\n.cheer-bubble{\n  margin:13px auto 0;width:124px;height:68px;border:1.5px solid #222;\n  border-radius:50%;background:#fff;padding-top:14px;font-size:14px;font-weight:900;\n  transform:rotate(-4deg);\n}\n.cheer-cat{font-size:72px;position:absolute;bottom:0;left:44px}\n.megaphone{font-size:42px;position:absolute;left:2px;bottom:21px;transform:rotate(-20deg)}\n\n.footer{\n  height:32px;border-radius:16px;background:linear-gradient(90deg,#315a9e,#426cb4);\n  color:#fff;text-align:center;font-size:13px;font-weight:800;\n  line-height:32px;letter-spacing:.15px;white-space:nowrap;\n}\n.footer .like{font-size:19px;margin-left:8px}\n\n.fourth .panel{height:240px}\n.third .yellow{min-height:306px}\n.third .red{min-height:306px}\n.third .indigo{min-height:263px}\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <header class=\"header\">\n    <span class=\"spark s1\">✦</span><span class=\"spark s2\">✦</span><span class=\"spark s3\">✦</span>\n    <div class=\"mascot-left\">\n      🐶\n      <span class=\"band\">必过！</span>\n      <span class=\"book\">📖</span>\n    </div>\n    <div class=\"header-center\">\n      <h1 class=\"title\"><span class=\"red\">软考高项</span> 各子过程可用工具与技术大全</h1>\n      <div class=\"subtitle\">依据：《信息系统项目管理师教程（第4版）》</div>\n    </div>\n    <div class=\"mascot-right\">\n      <div class=\"speech\">工具在手<br>管理不愁！</div>\n      <div class=\"cat\">🐱</div>\n    </div>\n  </header>\n\n  <section class=\"grid top\">\n    <article class=\"panel blue\">\n      <div class=\"panel-title\">1. 整体管理 <span class=\"icon\">📋</span></div>\n      <table class=\"process-table compact\">\n        <thead><tr><th>子过程</th><th>工具与技术</th></tr></thead>\n        <tbody>\n          <tr><td>1.1 制定项目章程</td><td>专家判断、引导技术、会议</td></tr>\n          <tr><td>1.2 制定项目管理计划</td><td>专家判断、引导技术、会议</td></tr>\n          <tr><td>1.3 指导与管理项目工作</td><td>项目管理信息系统、会议</td></tr>\n          <tr><td>1.4 管理项目知识</td><td>知识管理、信息管理</td></tr>\n          <tr><td>1.5 监控项目工作</td><td>数据分析、决策、会议</td></tr>\n          <tr><td>1.6 实施整体变更控制</td><td>变更控制工具、决策、数据分析</td></tr>\n          <tr><td>1.7 结束项目或阶段</td><td>专家判断、数据分析、会议</td></tr>\n        </tbody>\n      </table>\n    </article>\n\n    <article class=\"panel green\">\n      <div class=\"panel-title\">2. 范围管理 <span class=\"icon\">📏</span></div>\n      <table class=\"process-table small narrow\">\n        <thead><tr><th>子过程</th><th>工具与技术</th></tr></thead>\n        <tbody>\n          <tr><td>2.1 规划范围管理</td><td>专家判断、会议、数据分析</td></tr>\n          <tr><td>2.2 收集需求</td><td>访谈、焦点小组、引导式研讨会、群体创新/决策技术、问卷、原型法、标杆对照、系统交互图、文件分析</td></tr>\n          <tr><td>2.3 定义范围</td><td>产品分析、备选方案生成、引导式研讨会</td></tr>\n          <tr><td>2.4 创建WBS</td><td>分解、专家判断</td></tr>\n          <tr><td>2.5 确认范围</td><td>检查、群体决策技术</td></tr>\n          <tr><td>2.6 控制范围</td><td>偏差分析</td></tr>\n        </tbody>\n      </table>\n    </article>\n\n    <article class=\"panel orange\">\n      <div class=\"panel-title\">3. 进度管理 <span class=\"icon\">🕘</span></div>\n      <table class=\"process-table small narrow\">\n        <thead><tr><th>子过程</th><th>工具与技术</th></tr></thead>\n        <tbody>\n          <tr><td>3.1 规划进度管理</td><td>专家判断、数据分析、会议</td></tr>\n          <tr><td>3.2 定义活动</td><td>分解、滚动式规划、专家判断</td></tr>\n          <tr><td>3.3 排列活动顺序</td><td>紧前关系绘图法（PDM）、确定和整合依赖关系、提前量和滞后量</td></tr>\n          <tr><td>3.4 估算活动持续时间</td><td>类比估算、参数估算、三点估算、自下而上估算、储备分析</td></tr>\n          <tr><td>3.5 制定进度计划</td><td>关键路径法（CPM）、资源优化、进度压缩、建模与沿线规划</td></tr>\n          <tr><td>3.6 控制进度</td><td>数据分析（挣值分析、迭代燃尽图、绩效审查）、进度压缩、资源优化</td></tr>\n        </tbody>\n      </table>\n    </article>\n  </section>\n\n  <section class=\"grid middle\">\n    <article class=\"panel purple\">\n      <div class=\"panel-title\">4. 成本管理 <span class=\"icon\">💰</span></div>\n      <table class=\"process-table compact narrow\">\n        <thead><tr><th>子过程</th><th>工具与技术</th></tr></thead>\n        <tbody>\n          <tr><td>4.1 规划成本管理</td><td>专家判断、数据分析</td></tr>\n          <tr><td>4.2 估算成本</td><td>类比估算、参数估算、自下而上估算、三点估算、储备分析、质量成本</td></tr>\n          <tr><td>4.3 制定预算</td><td>成本汇总、储备分析、历史关系</td></tr>\n          <tr><td>4.4 控制成本</td><td>挣值分析（EV/PV/AC）、偏差分析、趋势分析、储备分析</td></tr>\n        </tbody>\n      </table>\n    </article>\n\n    <article class=\"panel pink\">\n      <div class=\"panel-title\">5. 质量管理 <span class=\"icon\">🏅</span></div>\n      <table class=\"process-table small narrow\">\n        <thead><tr><th>子过程</th><th>工具与技术</th></tr></thead>\n        <tbody>\n          <tr><td>5.1 规划质量管理</td><td>标杆对照、成本效益分析、质量成本</td></tr>\n          <tr><td>5.2 管理质量</td><td>老七种工具（因果图/鱼骨图、流程图、直方图、帕累托图、控制图、散点图、核查表）、质量审计、过程分析、根本原因分析</td></tr>\n          <tr><td>5.3 控制质量</td><td>老七种工具、统计抽样、检查、测试/产品评估</td></tr>\n        </tbody>\n      </table>\n    </article>\n\n    <article class=\"panel teal\">\n      <div class=\"panel-title\">6. 资源管理 <span class=\"icon\">👥</span></div>\n      <table class=\"process-table small narrow\">\n        <thead><tr><th>子过程</th><th>工具与技术</th></tr></thead>\n        <tbody>\n          <tr><td>6.1 规划资源管理</td><td>数据表现（责任分配矩阵RAM/组织分解结构OBS）组织理论</td></tr>\n          <tr><td>6.2 估算活动资源</td><td>自下而上估算、类比估算、参数估算、备选方案分析</td></tr>\n          <tr><td>6.3 获取资源</td><td>预分配、谈判、虚拟团队</td></tr>\n          <tr><td>6.4 建设团队</td><td>人际关系与团队技能（冲突管理、情商、影响力、领导力）、基本规则、培训、团队建设活动</td></tr>\n          <tr><td>6.5 管理团队</td><td>冲突管理、情商、影响、领导力、观察/交谈、绩效评估</td></tr>\n          <tr><td>6.6 控制资源</td><td>数据分析（绩效审查）</td></tr>\n        </tbody>\n      </table>\n    </article>\n  </section>\n\n  <section class=\"grid third\">\n    <div>\n      <article class=\"panel yellow\">\n        <div class=\"panel-title\">7. 沟通管理 <span class=\"icon\">📣</span></div>\n        <table class=\"process-table small narrow\">\n          <thead><tr><th>子过程</th><th>工具与技术</th></tr></thead>\n          <tbody>\n            <tr><td>7.1 规划沟通管理</td><td>沟通需求分析、沟通技术、沟通模型</td></tr>\n            <tr><td>7.2 管理沟通</td><td>沟通方法（推式/拉式/交互式沟通）、人际关系与团队技能、演示、项目报告</td></tr>\n            <tr><td>7.3 监督沟通</td><td>干系人参与度评估矩阵、数据分析</td></tr>\n          </tbody>\n        </table>\n      </article>\n      <div class=\"note-box\">\n        <div class=\"note-title\">沟通方法三大类：</div>\n        <div class=\"note-row\"><span class=\"note-symbol\">➤</span><span><b>推式沟通：</b>发送方主动推送信息</span></div>\n        <div class=\"note-row pull\"><span class=\"note-symbol\">🧲</span><span><b>拉式沟通：</b>接收方自行获取信息</span></div>\n        <div class=\"note-row interactive\"><span class=\"note-symbol\">💬</span><span><b>交互式沟通：</b>双方多向交流</span></div>\n      </div>\n    </div>\n\n    <div>\n      <article class=\"panel red\">\n        <div class=\"panel-title\">8. 风险管理 <span class=\"icon\">⚠️</span></div>\n        <table class=\"process-table small narrow\">\n          <thead><tr><th>子过程</th><th>工具与技术</th></tr></thead>\n          <tbody>\n            <tr><td>8.1 规划风险管理</td><td>专家判断、数据分析、会议</td></tr>\n            <tr><td>8.2 识别风险</td><td>头脑风暴、提示清单技术、根本原因分析、核对单、假设分析、SWOT分析、系统或过程流程图、因果图/鱼骨图、文件审查、专家判断</td></tr>\n            <tr><td>8.3 实施定性风险分析</td><td>风险概率与影响评估、概率与影响矩阵、风险分类、数据质量评估、风险紧迫性评估、专家判断</td></tr>\n            <tr><td>8.4 实施定量风险分析</td><td>模拟/蒙特卡洛分析、敏感性分析（龙卷风图）、决策树分析、影响图</td></tr>\n            <tr><td>8.5 规划风险应对</td><td>威胁应对策略（上报、规避、转移、减轻、接受）、机会应对策略（上报、开拓、分享、提高、接受）</td></tr>\n            <tr><td>8.6 实施风险应对</td><td>专家判断、人际关系与团队技能、项目管理信息系统</td></tr>\n            <tr><td>8.7 监督风险</td><td>风险审计、技术绩效分析、储备分析、会议</td></tr>\n          </tbody>\n        </table>\n      </article>\n      <div class=\"risk-list\">\n        <span class=\"star-icon\">★</span>\n        <strong>识别风险常用清单：7种分析工具 + 6种数据收集方法 + 团队技术</strong><br>\n        分析工具：专家判断、根本原因分析、假设分析、SWOT分析、流程图等<br>\n        数据收集：头脑风暴、德尔菲技术、核对单、文件审查、访谈、问卷等<br>\n        团队技术：因果图/鱼骨图、系统或过程流程图等\n      </div>\n    </div>\n\n    <div>\n      <article class=\"panel indigo\">\n        <div class=\"panel-title\">9. 采购管理 <span class=\"icon\">🛒</span></div>\n        <table class=\"process-table narrow\">\n          <thead><tr><th>子过程</th><th>工具与技术</th></tr></thead>\n          <tbody>\n            <tr><td>9.1 规划采购管理</td><td>自制或外购分析、专家判断、市场调查、会议</td></tr>\n            <tr><td>9.2 实施采购</td><td>专家判断、独立估算、广告/投标人会议、建议书评估技术</td></tr>\n            <tr><td>9.3 控制采购</td><td>合同变更控制、采购绩效审查、检查与审计、索赔管理</td></tr>\n          </tbody>\n        </table>\n      </article>\n      <div class=\"procure-note\">\n        <strong>采购三要素：</strong><br>\n        质量<span class=\"check\">✓</span>　成本<span class=\"check\">✓</span>　交付<span class=\"check\">✓</span>\n        <span class=\"procure-cat\">🐱</span>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"grid fourth\">\n    <article class=\"panel blue\">\n      <div class=\"panel-title\">10. 干系人管理 <span class=\"icon\">👨‍👩‍👧</span></div>\n      <table class=\"process-table small narrow\">\n        <thead><tr><th>子过程</th><th>工具与技术</th></tr></thead>\n        <tbody>\n          <tr><td>10.1 识别干系人</td><td>干系人分析、权力利益方格、干系人立方体、影响方向、优先级排序、凸显模型、数据收集（问卷/访谈）</td></tr>\n          <tr><td>10.2 规划干系人参与</td><td>干系人参与度评估矩阵、专家判断、会议</td></tr>\n          <tr><td>10.3 管理干系人参与</td><td>沟通方法、人际关系与团队技能（冲突管理、谈判）、基本规则</td></tr>\n          <tr><td>10.4 监督干系人参与</td><td>干系人参与度评估矩阵、数据分析、会议</td></tr>\n        </tbody>\n      </table>\n    </article>\n\n    <aside class=\"top10\">\n      <div class=\"mini-title\"><span class=\"gold\">★</span> 高频考点TOP10</div>\n      <ol>\n        <li>挣值分析（EVM）</li>\n        <li>WBS 分解</li>\n        <li>关键路径法（CPM）</li>\n        <li>风险应对策略</li>\n        <li>干系人分析方法</li>\n        <li>质量管理七大工具</li>\n        <li>风险识别工具清单</li>\n        <li>沟通方法三大类</li>\n        <li>合同变更控制</li>\n        <li>偏差分析</li>\n      </ol>\n    </aside>\n\n    <aside class=\"strategy\">\n      <div class=\"strategy-title\">风险应对策略（威胁＆机会各五种）</div>\n      <div class=\"strategy-cols\">\n        <div class=\"strategy-col\">\n          <div class=\"strategy-head threat\">威胁应对策略</div>\n          <div class=\"strategy-row\"><span class=\"shield\">🛡</span><b>上报</b><span>（提交给上级或相关方）</span></div>\n          <div class=\"strategy-row\"><span class=\"shield\">🛡</span><b>规避</b><span>（改变计划以消除威胁）</span></div>\n          <div class=\"strategy-row\"><span class=\"shield\">🛡</span><b>转移</b><span>（将风险转移给第三方）</span></div>\n          <div class=\"strategy-row\"><span class=\"shield\">🛡</span><b>减轻</b><span>（降低风险发生的概率或影响）</span></div>\n          <div class=\"strategy-row\"><span class=\"shield\">🛡</span><b>接受</b><span>（有意识地接受风险）</span></div>\n        </div>\n        <div class=\"strategy-col\">\n          <div class=\"strategy-head opportunity\">机会应对策略</div>\n          <div class=\"strategy-row\"><span class=\"goldstar\">★</span><b>上报</b><span>（提交给上级或相关方）</span></div>\n          <div class=\"strategy-row\"><span class=\"goldstar\">★</span><b>开拓</b><span>（确保机会被利用）</span></div>\n          <div class=\"strategy-row\"><span class=\"goldstar\">★</span><b>分享</b><span>（与第三方共享机会）</span></div>\n          <div class=\"strategy-row\"><span class=\"goldstar\">★</span><b>提高</b><span>（增加机会的发生概率或影响）</span></div>\n          <div class=\"strategy-row\"><span class=\"goldstar\">★</span><b>接受</b><span>（有意识地接受机会）</span></div>\n        </div>\n      </div>\n    </aside>\n  </section>\n\n  <section class=\"grid bottom\">\n    <article class=\"bottom-card\">\n      <div class=\"bottom-heading\">质量管理七大工具</div>\n      <div class=\"tools\">\n        <div class=\"tool\">\n          <div class=\"tool-label\">因果图<br>（鱼骨图）</div>\n          <div class=\"diagram fishbone\"><i></i><i></i><i></i><i></i></div>\n        </div>\n        <div class=\"tool\">\n          <div class=\"tool-label\">直方图</div>\n          <div class=\"diagram bar-chart\"><span></span><span></span><span></span></div>\n        </div>\n        <div class=\"tool\">\n          <div class=\"tool-label\">帕累托图</div>\n          <div class=\"diagram pareto\"><span></span><span></span><span></span><span></span></div>\n        </div>\n        <div class=\"tool\">\n          <div class=\"tool-label\">控制图</div>\n          <div class=\"diagram control-chart\">\n            <svg class=\"line-svg\" viewBox=\"0 0 60 70\" aria-hidden=\"true\">\n              <polyline points=\"3,47 13,29 23,42 34,19 46,38 58,14\" fill=\"none\" stroke=\"#222\" stroke-width=\"1.4\"/>\n              <line x1=\"2\" y1=\"21\" x2=\"58\" y2=\"21\" stroke=\"#d65b55\" stroke-dasharray=\"3 2\"/>\n              <line x1=\"2\" y1=\"49\" x2=\"58\" y2=\"49\" stroke=\"#d65b55\" stroke-dasharray=\"3 2\"/>\n              <g fill=\"#447fa5\"><circle cx=\"13\" cy=\"29\" r=\"2\"/><circle cx=\"23\" cy=\"42\" r=\"2\"/><circle cx=\"34\" cy=\"19\" r=\"2\"/><circle cx=\"46\" cy=\"38\" r=\"2\"/></g>\n            </svg>\n          </div>\n        </div>\n        <div class=\"tool\">\n          <div class=\"tool-label\">散点图</div>\n          <div class=\"diagram flow\"><span></span><span></span><span></span></div>\n        </div>\n        <div class=\"tool\">\n          <div class=\"tool-label\">核查表</div>\n          <div class=\"diagram scatter\">\n            <span style=\"left:13px;top:51px\"></span><span style=\"left:22px;top:39px\"></span>\n            <span style=\"left:31px;top:47px\"></span><span style=\"left:35px;top:29px\"></span>\n            <span style=\"left:44px;top:22px\"></span><span style=\"left:51px;top:10px\"></span>\n            <span style=\"left:18px;top:25px\"></span><span style=\"left:43px;top:42px\"></span>\n          </div>\n        </div>\n      </div>\n    </article>\n\n    <article class=\"lifecycle\">\n      <div class=\"life-title\">项目的生命周期</div>\n      <div class=\"life-flow\">启动 <span class=\"arrow\">→</span> 规划 <span class=\"arrow\">→</span> 执行 <span class=\"arrow\">→</span> 监控 <span class=\"arrow\">→</span> 收尾</div>\n      <div class=\"life-desc\">过程组之间相互作用，并行重复<br><small>（过程组交互图-PMBOK<sup>®</sup> 第六版）</small></div>\n      <div class=\"circles\">\n        <span class=\"circle c1\">启动<br>过程组</span>\n        <span class=\"circle c2\">规划<br>过程组</span>\n        <span class=\"circle c3\">执行<br>过程组</span>\n        <span class=\"circle c4\">监控<br>过程组</span>\n        <span class=\"circle c5\">收尾<br>过程组</span>\n        <i class=\"link l1\"></i><i class=\"link l2\"></i><i class=\"link l3\"></i>\n      </div>\n    </article>\n\n    <aside class=\"cheer\">\n      <div class=\"stars\">★ ✦</div>\n      <div class=\"cheer-bubble\">加油！<br>一定可以！</div>\n      <span class=\"megaphone\">📣</span>\n      <span class=\"cheer-cat\">🐱</span>\n    </aside>\n  </section>\n\n  <footer class=\"footer\">\n    提示：以上工具与技术均来自《信息系统项目管理师教程（第4版）》官方内容，软考高项必备！理解记忆，灵活运用，考试更轻松！ <span class=\"like\">👍</span>\n  </footer>\n</div>\n</body>\n</html>"
