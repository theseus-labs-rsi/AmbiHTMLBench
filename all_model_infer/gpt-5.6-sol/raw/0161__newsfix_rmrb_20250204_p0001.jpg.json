        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>人民日报 2025年2月4日</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] },\n  svg: { fontCache: 'global' }\n};\n</script>\n<script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  html, body {\n    margin: 0;\n    padding: 0;\n    background: #d8d8d8;\n  }\n  body {\n    color: #111;\n    font-family: \"SimSun\", \"Songti SC\", \"Noto Serif CJK SC\", serif;\n  }\n  .page {\n    width: 1200px;\n    min-height: 1378px;\n    margin: 0 auto;\n    padding: 10px 12px 8px;\n    background: #fff;\n    overflow: hidden;\n  }\n  .header {\n    display: grid;\n    grid-template-columns: 450px 132px 1fr;\n    gap: 14px;\n    min-height: 290px;\n    border-bottom: 3px solid #222;\n    padding-bottom: 11px;\n  }\n  .masthead {\n    position: relative;\n    padding-top: 5px;\n  }\n  .masthead-cn {\n    color: #c90022;\n    font-family: \"STKaiti\", \"KaiTi\", serif;\n    font-size: 91px;\n    font-weight: 700;\n    line-height: .96;\n    white-space: nowrap;\n    transform: skew(-7deg);\n    transform-origin: left center;\n  }\n  .masthead-en {\n    color: #ad1b24;\n    margin-top: 8px;\n    text-align: center;\n    font-family: Georgia, serif;\n    font-size: 26px;\n    font-weight: 700;\n    letter-spacing: 5px;\n  }\n  .website {\n    margin-top: 34px;\n    text-align: center;\n    font-size: 11px;\n    letter-spacing: 1px;\n  }\n  .date-box {\n    border: 3px solid #888;\n    min-height: 278px;\n    text-align: center;\n    padding: 13px 8px 8px;\n    font-family: \"SimSun\", serif;\n  }\n  .date-box .year {\n    font-size: 13px;\n  }\n  .date-box .day {\n    margin: 15px 0 8px;\n    font-size: 34px;\n    font-family: Arial, sans-serif;\n  }\n  .date-box .weekday,\n  .date-box .lunar,\n