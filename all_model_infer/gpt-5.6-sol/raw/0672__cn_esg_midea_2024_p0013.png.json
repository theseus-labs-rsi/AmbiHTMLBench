        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>2024・美的集团ESG报告｜守护蓝色星球</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] },\n  svg: { fontCache: 'global' }\n};\n</script>\n<script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js\"></script>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;background:#fff;color:#222;font-family:\"Microsoft YaHei\",\"PingFang SC\",\"Noto Sans CJK SC\",Arial,sans-serif}\nbody{min-width:2976px}\n.spread{position:relative;width:2976px;height:2021px;margin:0 auto;background:#fff;overflow:hidden}\n.top-title{position:absolute;left:141px;top:96px;color:#858585;font-size:24px;font-weight:300;letter-spacing:.2px}\n.nav{position:absolute;right:140px;top:95px;display:flex;align-items:center;gap:37px;color:#888;font-size:23px;white-space:nowrap}\n.nav .active{color:#00afa4;border:2px solid #00afa4;border-radius:22px;padding:2px 14px 3px;margin-left:-10px;margin-right:-16px}\n.mountain-art{position:absolute;left:111px;top:125px;width:300px;height:174px;overflow:hidden}\n.mountain-art .base{position:absolute;left:0;bottom:0;width:300px;height:34px;background:#e9f2f1;clip-path:polygon(0 42%,18% 0,42% 23%,61% 0,100% 35%,100% 100%,0 100%)}\n.mountain-art .m1{position:absolute;left:13px;bottom:0;width:114px;height:143px;background:#00b0a5;clip-path:polygon(50% 0,100% 100%,0 100%)}\n.mountain-art .m1:after{content:\"\";position:absolute;inset:0;background:#bcece8;clip-path:polygon(50% 0,100% 100%,52% 66%,52% 31%)}\n.mountain-art .m2{position:absolute;left:67px;bottom:0;width:139px;height:174px;background:#00b5aa;clip-path:polygon(50% 0,100% 100%,0 100%)}\n.mountain-art .m2:after{content:\"\";position:absolute;inset:0;background:#d8f4f1;clip-path:polygon(50% 0,65% 39%,56% 32%,53% 57%,47% 30%,42% 40%,38% 24%)}\n.mountain-art .m3{position:absolute;left:168