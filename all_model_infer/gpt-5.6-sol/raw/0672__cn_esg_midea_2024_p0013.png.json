-layout .desc-content,.opportunity-layout .impact-content,.opportunity-layout .strategy-content{\n  height:100%;display:flex;align-items:center;padding:39px 31px 18px;font-size:22px;line-height:1.5\n}\n.opportunity-layout .impact-content,.opportunity-layout .strategy-content{align-items:flex-start;padding-top:57px}\n.opportunity-layout ul{margin:0;padding-left:26px}\n.opportunity-layout li{padding-left:4px;margin-bottom:8px}\n.opportunity-layout .period-content,.opportunity-layout .financial-content{\n  height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:23px;padding-top:17px\n}\n\n.decor-tree{position:absolute;width:30px;height:95px}\n.decor-tree:before{content:\"\";position:absolute;left:13px;bottom:0;width:5px;height:40px;background:#8d8d8d}\n.decor-tree:after{content:\"\";position:absolute;top:0;left:0;width:30px;height:70px;background:linear-gradient(90deg,#a8ebe6 0 49%,#00afa6 50%);clip-path:polygon(50% 0,100% 85%,50% 100%,0 85%)}\n.tree1{left:1687px;top:204px}\n.tree2{left:1738px;top:241px;transform:scale(.63)}\n.tree3{left:1966px;top:205px}\n.tree4{left:2644px;top:241px;transform:scale(.58)}\n\n.page-number{position:absolute;bottom:67px;font-size:24px;color:#222}\n.page-number.left{left:141px}\n.page-number.right{right:141px}\n</style>\n</head>\n<body>\n<div class=\"spread\">\n  <div class=\"top-title\">2024・美的集团ESG报告</div>\n  <nav class=\"nav\">\n    <span>关于本报告</span>\n    <span>走进美的</span>\n    <span>可持续发展治理</span>\n    <span class=\"active\">守护蓝色星球</span>\n    <span>构建和谐社区</span>\n    <span>践行科技尽善</span>\n    <span>共创繁荣生态</span>\n    <span>附录</span>\n  </nav>\n\n  <div class=\"mountain-art\" aria-label=\"山峰、树木和太阳能板插图\">\n    <span class=\"base\"></span><span class=\"m1\"></span><span class=\"m2\"></span><span class=\"m3\"></span>\n    <span class=\"solar\"></span><span class=\"tree\"></span>\n  </div>\n  <span class=\"decor-tree tree1\"></span>\n  <span class=\"decor-tree tree2\"></span>\n  <span class=\"decor-tree tree3\"></span>\n  <span class=\"decor-tree tree4\"></span>\n\n  <main class=\"risk-layout\">\n    <section class=\"card type\">\n      <div class=\"title-pill\">风险类型</div>\n      <div class=\"type-zone\">物理风险</div>\n      <div class=\"type-zone\">转型风险</div>\n    </section>\n\n    <section class=\"card desc\">\n      <div class=\"title-pill\">风险描述</div>\n      <div class=\"cell-sections\">\n        <div class=\"section physical-1\">洪灾程度增加</div>\n        <div class=\"section physical-2\">极端高温</div>\n        <div class=\"section physical-3\">台风等频次增加</div>\n        <div class=\"section transition-1\">对产品能效、冷媒、材料等强制性监管要求的提升</div>\n        <div class=\"section transition-2\">对新能源、储能、新能源汽车核心零部件等产业的投入和转型</div>\n        <div class=\"section transition-3\">绿色能源成本的不确定性</div>\n      </div>\n    </section>\n\n    <section class=\"card impact\">\n      <div class=\"title-pill\">风险影响</div>\n      <div class=\"text-sections\">\n        <div class=\"text-section physical-1\">\n          <ul>\n            <li>严重洪灾可能对排水能力较差的仓储区造成成品及生产设备损毁，进而导致运营成本增加与设备加速折旧</li>\n            <li>交通中断或拥堵，无法保证员工的通勤时间，可能导致雇员生产力下降</li>\n          </ul>\n        </div>\n        <div class=\"text-section physical-2\">\n          <ul>\n            <li>极端高温将降低户外工作者的工作效率，增加员工健康安全风险</li>\n            <li>为办公、生产等区域员工提供舒适的工作环境所需的制冷能源消耗将增加，进一步加大了制冷相关的碳排放，并有可能增加运营成本</li>\n          </ul>\n        </div>\n        <div class=\"text-section physical-3\">\n          <ul>\n            <li>对部分海运物料供应、成品运输的时效性可能造成影响，进一步增加运营成本</li>\n          </ul>\n        </div>\n        <div class=\"text-section transition-1\">\n          <ul>\n            <li>更高级能效市场准入及消费者偏好将影响研发和市场投入方向</li>\n            <li>《蒙特利尔议定书》对破坏臭氧层物质管制的要求及欧盟、美洲等地区对不同环保型冷媒产品及二氧化碳压缩机等产品的引入将在中长期影响研发和市场的投入方向</li>\n            <li>在循环经济体系背景下环保型材料尤其是再生材料应用占比的提出可能增加产品材料来源的不确定性进一步提升材料的潜在成本</li>\n          </ul>\n        </div>\n        <div class=\"text-section transition-2\">\n          <ul>\n            <li>在应对和适应气候背景下，以合康新能源、科陆电子、汽车部件等代表的新业务板块有巨大的市场潜力和竞争压力</li>\n          </ul>\n        </div>\n        <div class=\"text-section transition-3\">\n          <ul>\n            <li>当前可售的绿色电力资源紧缺，市场需求上涨，长期以往可能导致绿色电力在市场化机制下绿色环境溢价进一步提升，增加制造工厂能源成本</li>\n          </ul>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"card strategy\">\n      <div class=\"title-pill\">应对策略</div>\n      <div class=\"text-sections\">\n        <div class=\"text-section physical-1\">\n          <ul>\n            <li>提升各基地应对50年一遇洪灾的应对能力，并购置相关保险</li>\n            <li>进一步完善员工宿舍建设，缩短员工通勤路程</li>\n          </ul>\n        </div>\n        <div class=\"text-section physical-2\">\n          <ul>\n            <li>完善户外作业管理要求，通过制冷设备升级和智能化控制手段，开展制冷相关节能降碳项目</li>\n            <li>通过绿色建筑建设，采用围护结构改造、自然通风等有效措施提升办公区域的舒适度</li>\n          </ul>\n        </div>\n        <div class=\"text-section physical-3\">\n          <ul>\n            <li>通过制造能力全球布局、制造基地安全库存、供方布局及唯一性排查、各基地柔性制造能力提升等措施提升供应链气候韧性</li>\n          </ul>\n        </div>\n        <div class=\"text-section transition-1\">\n          <ul>\n            <li>通过绿色设计标准牵引加快更高能效、水效等产品的技术领先性</li>\n            <li>加快环保型冷媒产品研发、制造、市场的投入，保持行业市场领先</li>\n            <li>联合包括大宗物料供方、废旧家电回收商、家电拆解工厂、再生资源生产商、塑料改性生产商等上下游价值链推动内外双循环制造模式，加快绿色低碳材料研究和应用，并在合适的区域建设自有拆解工厂，提升再生资源的生产能力</li>\n          </ul>\n        </div>\n        <div class=\"text-section transition-2\">\n          <ul>\n            <li>通过绿色工业等布局进一步提升相关业务综合服务能力</li>\n            <li>通过研发和技术创新抓住产品突破方向及市场机遇</li>\n          </ul>\n        </div>\n        <div class=\"text-section transition-3\">\n          <ul>\n            <li>加强智能制造和绿色工艺突破，能源脱碳和节能降碳同步推进</li>\n            <li>提升自制件相关供应商研发生产、供应交付能力，进一步降低价值链碳排放，降低集团工厂的自制件生产压力</li>\n          </ul>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"card period\">\n      <div class=\"title-pill\">影响周期</div>\n      <div class=\"icon-sections\">\n        <div class=\"icon-section p1\">\n          <div class=\"shield red placeholder\"><span class=\"placeholder-caption\">[盾牌叶片图标]</span></div>\n          <div>短中期</div>\n        </div>\n        <div class=\"icon-section p2\">\n          <div class=\"shield tree placeholder\"><span class=\"placeholder-caption\">[盾牌绿色图标]</span></div>\n          <div>长期</div>\n        </div>\n        <div class=\"icon-section p3\">\n          <div class=\"shield red placeholder\"><span class=\"placeholder-caption\">[盾牌叶片图标]</span></div>\n          <div>短中期</div>\n        </div>\n        <div class=\"icon-section t1\">\n          <div class=\"shield tree placeholder\"><span class=\"placeholder-caption\">[盾牌绿色图标]</span></div>\n          <div>中长期</div>\n        </div>\n        <div class=\"icon-section t2\">\n          <div class=\"shield tree placeholder\"><span class=\"placeholder-caption\">[盾牌绿色图标]</span></div>\n          <div>中长期</div>\n        </div>\n        <div class=\"icon-section t3\">\n          <div class=\"shield tree placeholder\"><span class=\"placeholder-caption\">[盾牌绿色图标]</span></div>\n          <div>中长期</div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"card financial\">\n      <div class=\"title-pill\">财务冲击</div>\n      <div class=\"icon-sections\">\n        <div class=\"icon-section p1\">\n          <div class=\"gear placeholder\"><span>¥</span><i class=\"placeholder-caption\">[财务冲击图标]</i></div>\n          <div>较小</div>\n        </div>\n        <div class=\"icon-section p2\">\n          <div class=\"gear placeholder\"><span>¥</span><i class=\"placeholder-caption\">[财务冲击图标]</i></div>\n          <div>较小</div>\n        </div>\n        <div class=\"icon-section p3\">\n          <div class=\"gear placeholder\"><span>¥</span><i class=\"placeholder-caption\">[财务冲击图标]</i></div>\n          <div>较小</div>\n        </div>\n        <div class=\"icon-section t1\">\n          <div class=\"gear teal placeholder\"><span>¥</span><i class=\"placeholder-caption\">[财务冲击图标]</i></div>\n          <div>一般</div>\n        </div>\n        <div class=\"icon-section t2\">\n          <div class=\"gear teal placeholder\"><span>¥</span><i class=\"placeholder-caption\">[财务冲击图标]</i></div>\n          <div>一般</div>\n        </div>\n        <div class=\"icon-section t3\">\n          <div class=\"gear placeholder\"><span>¥</span><i class=\"placeholder-caption\">[财务冲击图标]</i></div>\n          <div>较小</div>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <section class=\"opportunity-layout\">\n    <div class=\"card type\">\n      <div class=\"title-pill\">机遇类型</div>\n      <div class=\"type-zone\">市场机遇</div>\n    </div>\n\n    <div class=\"card desc\">\n      <div class=\"title-pill\">机遇描述</div>\n      <div class=\"desc-content\">绿色产品和服务带来的业务机会</div>\n    </div>\n\n    <div class=\"card impact\">\n      <div class=\"title-pill\">机遇影响</div>\n      <div class=\"impact-content\">\n        <ul>\n          <li>持续开发和/或扩展低排放产品和服务，获得更多市场份额及消费者青睐，同时在资本市场获得更多投资机会，带来更多收入增长</li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"card strategy\">\n      <div class=\"title-pill\">应对策略</div>\n      <div class=\"strategy-content\">\n        <ul>\n          <li>持续推动美的绿色服务，为本集团内部和客户提供绿色解决方案</li>\n          <li>坚持“绿色战略”引领，推进绿色设计，布局绿色低碳技术、研发绿色产品，满足市场与消费者对绿色产品的期待</li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"card period\">\n      <div class=\"title-pill\">影响周期</div>\n      <div class=\"period-content\">\n        <div class=\"shield red placeholder\"><span class=\"placeholder-caption\">[盾牌叶片图标]</span></div>\n        <div>短中期</div>\n      </div>\n    </div>\n\n    <div class=\"card financial\">\n      <div class=\"title-pill\">财务冲击</div>\n      <div class=\"financial-content\">\n        <div class=\"gear red placeholder\"><span>¥</span><i class=\"placeholder-caption\">[财务冲击图标]</i></div>\n        <div>较大</div>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"page-number left\">23</div>\n  <div class=\"page-number right\">24</div>\n</div>\n</body>\n</html>"
      },
      "finish_reason": "stop"
