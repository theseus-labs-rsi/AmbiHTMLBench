        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>人民日报要闻第2版 - 2025年1月4日</title>\n  <script>\n    window.MathJax = {\n      tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] }\n    };\n  </script>\n  <script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    html, body { margin: 0; padding: 0; background: #d8d8d8; }\n    body {\n      color: #111;\n      font-family: \"SimSun\", \"Songti SC\", \"Noto Serif CJK SC\", serif;\n    }\n    .page {\n      width: 794px;\n      min-height: 908px;\n      margin: 0 auto;\n      padding: 7px 7px 5px;\n      background: #fff;\n      overflow: hidden;\n    }\n    .masthead {\n      height: 33px;\n      border-bottom: 1.5px solid #111;\n      display: flex;\n      align-items: flex-start;\n      position: relative;\n    }\n    .section-name {\n      font-family: \"SimHei\", \"Microsoft YaHei\", sans-serif;\n      font-size: 24px;\n      line-height: 29px;\n      letter-spacing: 1px;\n    }\n    .page-number {\n      margin-left: 13px;\n      font-family: Arial, sans-serif;\n      font-size: 23px;\n      line-height: 28px;\n    }\n    .date {\n      margin: 13px 0 0 14px;\n      font-size: 7px;\n      white-space: nowrap;\n    }\n    .paper-name {\n      position: absolute;\n      right: 0;\n      top: 0;\n      font-family: \"STKaiti\", \"KaiTi\", serif;\n      font-size: 23px;\n      font-weight: bold;\n      transform: skew(-8deg);\n    }\n    .top-grid {\n      display: grid;\n      grid-template-columns: 393px 196px 181px;\n      gap: 7px;\n      margin-top: 10px;\n    }\n    .left-feature {\n      border-right: 1px solid #777;\n      padding-right: 7px;\n    }\n    .overline {\n      text-align: center;\n      font-size: 14px;\n      line-height: 18px;\n      margin: 10px 0 4px;\n    }\n    h1 {\n     