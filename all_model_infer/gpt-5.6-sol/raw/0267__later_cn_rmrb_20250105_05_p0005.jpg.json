        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>传承人话非遗</title>\n<script>\n  window.MathJax = {\n    tex: { inlineMath: [['$', '$'], ['\\\\(', '\\\\)']], displayMath: [['$$', '$$'], ['\\\\[', '\\\\]']] },\n    svg: { fontCache: 'global' }\n  };\n</script>\n<script defer src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  html, body { margin: 0; padding: 0; background: #fff; color: #222; }\n  body {\n    width: 800px;\n    margin: 0 auto;\n    font-family: \"SimSun\", \"Songti SC\", serif;\n    font-size: 10px;\n    line-height: 1.42;\n  }\n  .page {\n    width: 800px;\n    min-height: 1125px;\n    padding: 10px 9px 0;\n    overflow: hidden;\n    background: #fff;\n  }\n  .masthead {\n    height: 42px;\n    display: flex;\n    align-items: flex-end;\n    justify-content: space-between;\n    border-bottom: 2px solid #161616;\n    padding: 0 3px 4px;\n  }\n  .paper-name {\n    font-family: \"KaiTi\", \"STKaiti\", serif;\n    font-size: 22px;\n    font-weight: bold;\n    letter-spacing: 1px;\n  }\n  .issue {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    font-size: 8px;\n  }\n  .page-number {\n    font-family: Arial, sans-serif;\n    font-size: 27px;\n    line-height: 25px;\n  }\n  .section-name {\n    font-family: \"KaiTi\", \"STKaiti\", serif;\n    font-size: 22px;\n    font-weight: bold;\n  }\n  .content {\n    margin-top: 12px;\n    padding: 0 9px 10px;\n    background: linear-gradient(180deg, #fff0c9 0%, #fff9e9 37%, #fff7df 72%, #fff0cf 100%);\n  }\n  .kicker {\n    padding-top: 19px;\n    font-size: 16px;\n    font-weight: bold;\n    letter-spacing: .5px;\n    border-bottom: 0;\n  }\n  h1 {\n    margin: 7px 0 18px;\n    text-align: center;\n    font-family: \"SimHei\", \"Microsoft YaHei\", sans-serif;\n    font-size: 39px;\n    line-height: 1.05;\n    le