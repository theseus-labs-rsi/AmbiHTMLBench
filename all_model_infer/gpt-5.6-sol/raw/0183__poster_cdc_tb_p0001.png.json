ding: .75cqw 4.2cqw .75cqw 1.2cqw;\n    background: #fff;\n    color: #c82c25;\n    font-size: 2.15cqw;\n    line-height: 1;\n    font-weight: 500;\n    white-space: nowrap;\n  }\n\n  .latent-copy ul {\n    margin: 0;\n    padding-left: 1.25em;\n    font-size: 1.32cqw;\n    line-height: 1.16;\n  }\n\n  .latent-copy li {\n    margin-bottom: .72cqw;\n  }\n\n  /* Active disease section */\n  .active {\n    height: 24.75%;\n    background: #fff;\n    display: grid;\n    grid-template-columns: 49.7% 50.3%;\n    padding: 2.2cqw 0 1.2cqw 3.9cqw;\n  }\n\n  .active-copy {\n    padding-right: 3cqw;\n  }\n\n  .active-copy h2 {\n    margin: 0 0 1.25cqw;\n    font-size: 2.72cqw;\n    line-height: 1.08;\n    font-weight: 500;\n  }\n\n  .active-copy h2 strong {\n    font-weight: 800;\n  }\n\n  .active-copy ul {\n    margin: 0;\n    padding-left: 1.1em;\n    font-size: 1.44cqw;\n    line-height: 1.2;\n  }\n\n  .active-copy li {\n    margin-bottom: 1.25cqw;\n  }\n\n  .symptoms {\n    border: .35cqw solid #3761b3;\n    height: 100%;\n    margin-right: -.1cqw;\n    padding: 1.25cqw 2.1cqw 1cqw;\n  }\n\n  .symptoms h2 {\n    margin: 0 0 1.55cqw;\n    text-align: center;\n    color: #0b0b0b;\n    font-size: 2.15cqw;\n    line-height: 1;\n    font-weight: 800;\n  }\n\n  .symptom-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 1.2cqw 1.35cqw;\n  }\n\n  .symptom {\n    text-align: center;\n    min-width: 0;\n  }\n\n  .symptom-art {\n    width: 100%;\n    height: 6.4cqw;\n    margin-bottom: .42cqw;\n    position: relative;\n    border-radius: 1cqw 1cqw .25cqw .25cqw;\n    background: linear-gradient(to bottom, transparent 0 30%, #2e896f 31% 100%);\n  }\n\n  .symptom-art::before {\n    content: \"\";\n    position: absolute;\n    left: 36%;\n    top: 2%;\n    width: 28%;\n    height: 42%;\n    border-radius: 50%;\n    background: #d79c78;\n  }\n\n  .symptom-art::after {\n    content: \"\";\n    position: absolute;\n    left: 25%;\n    top: 0;\n    width: 50%;\n    height: 28%;\n    border-radius: 50% 50% 30% 30%;\n    background: #4a403b;\n  }\n\n  .symptom-label {\n    font-size: .93cqw;\n    line-height: 1.13;\n  }\n\n  .symptom-label em {\n    font-size: .84cqw;\n  }\n\n  /* Bottom call to action */\n  .cta {\n    height: 9.33%;\n    position: relative;\n    background: #88b0d5;\n    border-bottom: 1.65cqw solid #c62d25;\n  }\n\n  .cta-illustration {\n    position: absolute;\n    left: 2%;\n    bottom: 0;\n    width: 46%;\n    height: 175%;\n  }\n\n  .patient {\n    position: absolute;\n    left: 0;\n    bottom: 0;\n    width: 31%;\n    height: 88%;\n  }\n\n  .doctor {\n    position: absolute;\n    left: 22%;\n    bottom: 0;\n    width: 34%;\n    height: 98%;\n  }\n\n  .patient .head,\n  .doctor .head {\n    top: 7%;\n    left: 36%;\n    width: 28%;\n    height: 25%;\n    background: #e0914a;\n  }\n\n  .doctor .head {\n    background: #efaf92;\n  }\n\n  .patient .hair {\n    top: 0;\n    left: 25%;\n    width: 50%;\n    height: 35%;\n    background: #e9e8f0;\n    border-radius: 50% 50% 25% 25%;\n  }\n\n  .doctor .hair {\n    top: 0;\n    left: 31%;\n    width: 38%;\n    height: 25%;\n    background: #6c6e74;\n  }\n\n  .patient .torso,\n  .doctor .torso {\n    left: 14%;\n    width: 72%;\n    height: 69%;\n    background: #fb9c08;\n  }\n\n  .doctor .torso {\n    background: #f1f1f1;\n  }\n\n  .medicine {\n    position: absolute;\n    left: 40%;\n    bottom: 2%;\n    width: 17%;\n    height: 30%;\n  }\n\n  .bottle {\n    display: inline-block;\n    vertical-align: bottom;\n    width: 28%;\n    height: 80%;\n    margin-right: 4%;\n    border-radius: .4cqw .4cqw .2cqw .2cqw;\n    background: #355db3;\n  }\n\n  .bottle:nth-child(2) {\n    height: 60%;\n    background: #9437a7;\n  }\n\n  .bottle:nth-child(3) {\n    height: 72%;\n    background: #fb9907;\n  }\n\n  .cta-message {\n    position: absolute;\n    left: 50%;\n    top: 14%;\n    width: 46%;\n    font-size: 3.25cqw;\n    line-height: 1.07;\n    font-weight: 500;\n  }\n\n  .cta-message strong {\n    font-weight: 800;\n  }\n\n  /* Publication strip and CDC block */\n  .publication {\n    position: absolute;\n    left: 0;\n    bottom: 0;\n    width: 100%;\n    height: 1.65cqw;\n    background: #c62d25;\n    color: #fff;\n  }\n\n  .publication span {\n    position: absolute;\n    left: 4%;\n    top: .15cqw;\n    font-size: 1.4cqw;\n    line-height: 1;\n  }\n\n  .cdc {\n    position: absolute;\n    right: 1.55%;\n    bottom: 1.7cqw;\n    width: 18.1%;\n    height: 4.25cqw;\n    border-radius: 1cqw;\n    background: #fff;\n    display: grid;\n    grid-template-columns: 47% 53%;\n    padding: .55cqw;\n    color: #304ba5;\n  }\n\n  .cdc-logo {\n    margin-right: .6cqw;\n    border-radius: .65cqw;\n    background: #3e56ad;\n    color: #fff;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 1.25cqw;\n    font-style: italic;\n    font-weight: 800;\n  }\n\n  .cdc-text {\n    align-self: center;\n    font-size: .67cqw;\n    line-height: 1.2;\n  }\n\n  .cdc-text strong {\n    display: block;\n  }\n\n  @media (max-width: 700px) {\n    .placeholder-caption {\n      font-size: 1.15cqw;\n    }\n  }\n</style>\n</head>\n<body>\n<main class=\"page\" aria-label=\"STOP TB educational infographic\">\n\n  <header class=\"masthead\" aria-label=\"STOP TB\">\n    <div class=\"mast-letter\">S</div>\n    <div class=\"mast-letter\">T</div>\n    <div class=\"stop-o\" aria-label=\"O with lungs\">\n      <div class=\"stop-o-inner\">\n        <div class=\"stop-o-core\">\n          <div class=\"airway\"></div>\n        </div>\n      </div>\n    </div>\n    <div class=\"mast-letter\">P</div>\n    <div class=\"mast-letter\">T</div>\n    <div class=\"mast-letter\">B</div>\n  </header>\n\n  <section class=\"spread\">\n    <div class=\"spread-copy\">\n      <h1>\n        Tuberculosis (TB) <strong>spreads<br>\n        through the air</strong> from one<br>\n        person to another.\n      </h1>\n      <ul>\n        <li>TB germs spread when a person with infectious<br>\n          TB disease <strong>coughs, speaks, or sings.</strong></li>\n        <li>TB germs usually <strong>attack the lungs</strong> but can<br>\n          also move to any part of the body.</li>\n      </ul>\n    </div>\n\n    <div class=\"spread-visual\">\n      <div class=\"placeholder lung-panel\" aria-label=\"Illustration of infected lungs\"></div>\n\n      <div class=\"people-air placeholder\" aria-label=\"Illustration of one person coughing toward another\">\n        <div class=\"person person-left\">\n          <div class=\"head\"></div>\n          <div class=\"hair\"></div>\n          <div class=\"torso\"></div>\n        </div>\n        <div class=\"air-dots\"></div>\n        <div class=\"person person-right\">\n          <div class=\"head\"></div>\n          <div class=\"hair\"></div>\n          <div class=\"torso\"></div>\n        </div>\n        <span class=\"placeholder-caption\">[Illustration: TB germs spreading through the air from one person to another]</span>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"latent\">\n    <div class=\"latent-person\">\n      <div class=\"figure placeholder\" aria-label=\"Person with latent TB infection\">\n        <div class=\"head\"></div>\n        <div class=\"hair\"></div>\n        <div class=\"torso\"></div>\n      </div>\n      <div class=\"latent-lungs placeholder\" aria-label=\"Lungs showing latent TB germs\">\n        <span class=\"placeholder-caption\">[Illustration: lungs with inactive TB germs]</span>\n      </div>\n    </div>\n\n    <div class=\"latent-copy\">\n      <h2>TB germs can live in the body without<br>\n        <strong>making you sick.</strong></h2>\n\n      <div class=\"latent-band\">\n        This is called <strong>latent TB infection</strong> or inactive TB.\n      </div>\n\n      <ul>\n        <li>TB germs can live in your body for years without causing symptoms. Without<br>\n          treatment, <strong>inactive TB can develop into active TB disease and make you sick.</strong></li>\n        <li>If you have inactive TB, you can take TB medicine to <strong>prevent the development<br>\n          of active TB disease</strong> even if you do not feel sick.</li>\n      </ul>\n    </div>\n  </section>\n\n  <section class=\"active\">\n    <div class=\"active-copy\">\n      <h2>If your body cannot stop TB<br>\n        germs from growing, you<br>\n        develop <strong>active TB disease.</strong></h2>\n      <ul>\n        <li>You may <strong>feel sick</strong> and <strong>spread TB germs</strong> to<br>\n          your family, friends, and others around you.</li>\n        <li>You need to <strong>take and finish all your<br>\n          TB medicine</strong> to help you feel better and<br>\n          prevent other people from getting sick.</li>\n      </ul>\n    </div>\n\n    <div class=\"symptoms\">\n      <h2>Symptoms of active TB disease:</h2>\n      <div class=\"symptom-grid\">\n        <div class=\"symptom\">\n          <div class=\"symptom-art placeholder\" aria-label=\"Person coughing\"></div>\n          <div class=\"symptom-label\">Cough lasting<br>3+ weeks</div>\n        </div>\n        <div class=\"symptom\">\n          <div class=\"symptom-art placeholder\" aria-label=\"Person coughing up blood\"></div>\n          <div class=\"symptom-label\">Coughing up blood or<br>\n            sputum <em>(phlegm from<br>deep inside the lungs)</em></div>\n        </div>\n        <div class=\"symptom\">\n          <div class=\"symptom-art placeholder\" aria-label=\"Person with chest pain\"></div>\n          <div class=\"symptom-label\">Chest pain</div>\n        </div>\n        <div class=\"symptom\">\n          <div class=\"symptom-art placeholder\" aria-label=\"Person experiencing weakness\"></div>\n          <div class=\"symptom-label\">Weakness<br>or fatigue</div>\n        </div>\n\n        <div class=\"symptom\">\n          <div class=\"symptom-art placeholder\" aria-label=\"Person with no appetite\"></div>\n          <div class=\"symptom-label\">No appetite</div>\n        </div>\n        <div class=\"symptom\">\n          <div class=\"symptom-art placeholder\" aria-label=\"Scale representing weight loss\"></div>\n          <div class=\"symptom-label\">Weight loss</div>\n        </div>\n        <div class=\"symptom\">\n          <div class=\"symptom-art placeholder\" aria-label=\"Person with fever and chills\"></div>\n          <div class=\"symptom-label\">Fever and/or chills</div>\n        </div>\n        <div class=\"symptom\">\n          <div class=\"symptom-art placeholder\" aria-label=\"Person experiencing night sweats\"></div>\n          <div class=\"symptom-label\">Night sweats</div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"cta\">\n    <div class=\"cta-illustration placeholder\" aria-label=\"Patient receiving TB medicine from a health care professional\">\n      <div class=\"patient\">\n        <div class=\"head\"></div>\n        <div class=\"hair\"></div>\n        <div class=\"torso\"></div>\n      </div>\n      <div class=\"doctor\">\n        <div class=\"head\"></div>\n        <div class=\"hair\"></div>\n        <div class=\"torso\"></div>\n      </div>\n      <div class=\"medicine\" aria-label=\"Medicine bottles\">\n        <span class=\"bottle\"></span>\n        <span class=\"bottle\"></span>\n        <span class=\"bottle\"></span>\n      </div>\n    </div>\n\n    <div class=\"cta-message\">\n      Take and finish all of<br>\n      your TB medicine to <strong>kill<br>\n      TB germs</strong> and <strong>STOP TB!</strong>\n    </div>\n\n    <div class=\"cdc\">\n      <div class=\"cdc-logo\">CDC</div>\n      <div class=\"cdc-text\">\n        <strong>Centers for Disease<br>Control and Prevention</strong>\n        National Center for HIV,<br>\n        Viral Hepatitis, STD, and<br>\n        TB Prevention\n      </div>\n    </div>\n\n    <div class=\"publication\">\n      <span>Publication Number: 6474</span>\n    </div>\n  </section>\n\n</main>\n</body>\n</html>"
