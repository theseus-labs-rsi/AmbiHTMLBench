x;\n  background:#00669b;\n  transform:rotate(69deg);\n}\n.wordmark{\n  width:112px;\n  padding-top:12px;\n  font-family:Arial,sans-serif;\n  font-size:35px;\n  line-height:1;\n  font-weight:bold;\n  letter-spacing:-3px;\n  color:#00669b;\n}\n.main-title{\n  flex:1;\n  padding-top:6px;\n  font-size:39px;\n  line-height:1.12;\n  letter-spacing:1px;\n  font-weight:400;\n  color:#0575a8;\n}\n.strategy{\n  height:73px;\n  padding-right:25px;\n  text-align:right;\n}\n.strategy-label{\n  color:#0875a7;\n  font-size:21px;\n  line-height:1.2;\n  font-weight:bold;\n}\n.strategy-title{\n  margin-top:1px;\n  font-size:28px;\n  line-height:1.16;\n  font-weight:900;\n}\n.intro{\n  height:73px;\n  padding:4px 16px 0;\n  font-size:13px;\n  line-height:20px;\n  text-align:left;\n}\n.canvas{\n  width:530px;\n  height:482px;\n  border:1px solid #777;\n  background:#f4f4f4;\n}\n.top-grid{\n  height:346px;\n  display:grid;\n  grid-template-columns:106px 108px 106px 107px 101px;\n}\n.col{\n  min-width:0;\n  border-right:1px solid #777;\n}\n.col:last-child{border-right:0}\n.split{\n  display:flex;\n  height:100%;\n  flex-direction:column;\n}\n.section{\n  padding:2px 9px 3px;\n  overflow:hidden;\n}\n.section + .section{border-top:1px solid #777}\n.partner{height:100%}\n.activities{height:163px}\n.resources{height:183px}\n.value{height:100%}\n.relationships{height:161px}\n.channels{height:185px}\n.segments{height:100%}\n.cell-title{\n  margin:0 -2px 2px;\n  color:#08779e;\n  font-family:SimHei,\"Microsoft YaHei\",sans-serif;\n  font-size:14px;\n  line-height:16px;\n  font-weight:900;\n  letter-spacing:7px;\n  white-space:nowrap;\n}\n.cell-subtitle{\n  min-height:24px;\n  margin-bottom:4px;\n  color:#40899e;\n  font-size:7px;\n  line-height:10px;\n}\n.content{\n  font-family:SimSun,\"Songti SC\",serif;\n  font-size:10.5px;\n  line-height:16px;\n}\n.content p{margin:0 0 5px}\n.content .label{\n  color:#146f98;\n  font-weight:bold;\n}\n.bottom-grid{\n  height:135px;\n  display:grid;\n  grid-template-columns:264px 264px;\n  border-top:1px solid #777;\n}\n.bottom-cell{\n  padding:3px 12px 3px;\n  overflow:hidden;\n}\n.bottom-cell:first-child{border-right:1px solid #777}\n.bottom-title{\n  margin:0 0 2px;\n  color:#08779e;\n  font-family:SimHei,\"Microsoft YaHei\",sans-serif;\n  font-size:14px;\n  line-height:17px;\n  font-weight:900;\n  letter-spacing:8px;\n}\n.bottom-subtitle{\n  margin-bottom:10px;\n  color:#40899e;\n  font-size:7px;\n  line-height:10px;\n}\n.cost-layout{\n  display:grid;\n  grid-template-columns:21px 1fr 20px 1fr;\n  column-gap:7px;\n  font-family:SimSun,\"Songti SC\",serif;\n  font-size:10px;\n  line-height:16px;\n}\n.vertical-label{\n  padding-top:2px;\n  font-weight:bold;\n  line-height:17px;\n  text-align:center;\n}\n.revenue{\n  font-family:SimSun,\"Songti SC\",serif;\n  font-size:11px;\n  line-height:18px;\n}\n.placeholder{border:0}\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <header>\n    <div class=\"brand-row\">\n      <div class=\"cn-brand\">雀巢</div>\n      <div class=\"logo-graphic placeholder\" aria-label=\"雀巢标志图案\">\n        <span class=\"nest\"></span>\n        <span class=\"branch\"></span>\n      </div>\n      <div class=\"wordmark\">Nestlé</div>\n      <div class=\"main-title\">商业模式画布</div>\n    </div>\n\n    <div class=\"strategy\">\n      <div class=\"strategy-label\">战略模式--</div>\n      <div class=\"strategy-title\">全球TOP食品公司</div>\n    </div>\n\n    <div class=\"intro\">\n      【品牌简介】雀巢是全球知名的食品饮料公司。拥有从全球知名品牌，到各地受欢迎的本<br>\n      土产品，业务遍布全球一百多个国家和地区。从一个生产婴儿食品的乡村作坊发展成今天<br>\n      领先世界的食品公司，雀巢走过了130多年的发展历程。\n    </div>\n  </header>\n\n  <section class=\"canvas\">\n    <div class=\"top-grid\">\n      <div class=\"col\">\n        <section class=\"section partner\">\n          <h2 class=\"cell-title\">重要伙伴</h2>\n          <div class=\"cell-subtitle\">有效地拓展供应商成员和合作伙伴</div>\n          <div class=\"content\">\n            <p><span class=\"label\">对内</span><br>\n            全球80多个国家拥有500多家工厂，近25万名员工<br>\n            雀巢在全球拥有强大的食品和营养研究网络，数千名科学家及技术人员在研发领域工作<br>\n            并与风险投资、研究合作伙伴和大学保持着紧密的合作<br>\n            全球约30家产品技术中心和研发中心，为创新提供专业技术和知识，支持业务增长</p>\n            <p>电商与物流（国内菜鸟合作绿色供应链）</p>\n          </div>\n        </section>\n      </div>\n\n      <div class=\"col split\">\n        <section class=\"section activities\">\n          <h2 class=\"cell-title\">关键业务</h2>\n          <div class=\"cell-subtitle\">成功营造雀巢商业发展环境</div>\n          <div class=\"content\">\n            <p><span class=\"label\">聚研发-管理-并购三力，享全球食饮增长红利</span><br>\n            1、通过创新和改善来加强公司的老字号品牌和经营业务；<br>\n            2、寻求新的内外部创新模式，包括在雀巢旗下创立新的子公司；<br>\n            3、调整投资为雀巢建设新的增长路径；<br>\n            4、在技术支持和能力增长的同时进行策略性投资。</p>\n          </div>\n        </section>\n        <section class=\"section resources\">\n          <h2 class=\"cell-title\">核心资源</h2>\n          <div class=\"cell-subtitle\">通过选择经营的资源</div>\n          <div class=\"content\">\n            <p>在食品制造领域内一百四十多年的经验，<br>\n            对Z新营销和食品加工技术的不断追求，高质量原材料的使用、又高技术设备的应用、<br>\n            高素质的员工及研发方面的巨额投资</p>\n          </div>\n        </section>\n      </div>\n\n      <div class=\"col\">\n        <section class=\"section value\">\n          <h2 class=\"cell-title\">价值主张</h2>\n          <div class=\"cell-subtitle\">为客户创造价值的产品或服务</div>\n          <div class=\"content\">\n            <p><span class=\"label\">理念：</span><br>\n            充分发掘食品的力量，<br>\n            提升每个个体的生活品质，无论当下还是未来。</p>\n            <p><span class=\"label\">主张：</span><br>\n            坚持诚信、合法经营<br>\n            尊重员工和合作伙伴</p>\n            <p>雀巢研发网络将“质量源于设计”的理念应用到所有的产品研发之中。</p>\n            <p><span class=\"label\">产品：</span><br>\n            咖啡、奶品、谷物和零食等</p>\n          </div>\n        </section>\n      </div>\n\n      <div class=\"col split\">\n        <section class=\"section relationships\">\n          <h2 class=\"cell-title\">客户关系</h2>\n          <div class=\"cell-subtitle\">如何维系和建立稳固关系</div>\n          <div class=\"content\">\n            <p>会员俱乐部、积分制福利兑换、电商优惠组合等常规营销形式<br>\n            标签化标准、<br>\n            包装设计手册、<br>\n            品牌化战略。<br>\n            <span class=\"label\">全球消费者服务机构</span></p>\n          </div>\n        </section>\n        <section class=\"section channels\">\n          <h2 class=\"cell-title\">渠道通路</h2>\n          <div class=\"cell-subtitle\">企业娱乐渠道中的客户接触点</div>\n          <div class=\"content\">\n            <p>线上商城<br>\n            电商渠道<br>\n            产品销往全球100多个国家和地区</p>\n          </div>\n        </section>\n      </div>\n\n      <div class=\"col\">\n        <section class=\"section segments\">\n          <h2 class=\"cell-title\">客户细分</h2>\n          <div class=\"cell-subtitle\">所服务的客户群体分类</div>\n          <div class=\"content\">\n            <p>没有特别区分的大客户群体，根据子品牌的不同确立细分消费者。</p>\n            <p>到2030的目标：<br>\n            帮助5000万儿童拥有更健康的生活</p>\n            <p>在与雀巢公司的商业活动直接相关的社区中，帮助3000万人改善生活。</p>\n          </div>\n        </section>\n      </div>\n    </div>\n\n    <div class=\"bottom-grid\">\n      <section class=\"bottom-cell\">\n        <h2 class=\"bottom-title\">成本结构</h2>\n        <div class=\"bottom-subtitle\">商业模式运行所引发的成本</div>\n        <div class=\"cost-layout\">\n          <div class=\"vertical-label\">固<br>定<br>成<br>本</div>\n          <div>人力成本、技术研发运维成本、一般及行政开支、商品成本、门店运维成本</div>\n          <div class=\"vertical-label\">可<br>变<br>成<br>本</div>\n          <div>原料成本、广告营销活动成本、流量成本、包装成本、周边成本、其他成本</div>\n        </div>\n      </section>\n\n      <section class=\"bottom-cell\">\n        <h2 class=\"bottom-title\">收入来源</h2>\n        <div class=\"bottom-subtitle\">企业通过向客户提供价值主张而获得的收入</div>\n        <div class=\"revenue\">\n          各类产品销售收入（95%来自食品的销售）<br>\n          投资收入\n        </div>\n      </section>\n    </div>\n  </section>\n</main>\n</body>\n</html>"
