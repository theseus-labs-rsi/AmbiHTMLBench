n    white-space: nowrap;\n  }\n\n  .holger {\n    top: 311px;\n    left: 287px;\n    width: 168px;\n  }\n\n  .sami {\n    top: 362px;\n    left: 1465px;\n    width: 158px;\n  }\n\n  .tom {\n    top: 640px;\n    left: 300px;\n    width: 150px;\n  }\n\n  .tom .portrait,\n  .angi .portrait {\n    width: 85px;\n    height: 85px;\n  }\n\n  .angi {\n    top: 603px;\n    left: 1579px;\n    width: 170px;\n  }\n\n  .center-copy {\n    position: absolute;\n    z-index: 11;\n    top: 611px;\n    left: 633px;\n    width: 551px;\n    color: #fff;\n    text-align: center;\n    font-style: italic;\n    font-weight: 700;\n    font-size: 14px;\n    line-height: 1.28;\n  }\n\n  .url {\n    position: absolute;\n    z-index: 12;\n    left: 553px;\n    bottom: 25px;\n    width: 600px;\n    color: #3db9cf;\n    font-size: 34px;\n    line-height: 1;\n    font-style: italic;\n    font-weight: 700;\n    text-align: center;\n    white-space: nowrap;\n  }\n</style>\n</head>\n<body>\n<main class=\"poster\" aria-label=\"Dawn spacecraft scientific instruments poster\">\n  <div class=\"top-rule\"></div>\n\n  <header class=\"title-block cyan\">\n    <h1>Dawn</h1>\n    <div class=\"subtitle\">A journey to the beginning of the solar system</div>\n  </header>\n\n  <div class=\"orbit\" aria-hidden=\"true\"></div>\n\n  <div class=\"placeholder asteroid\">[Image: asteroid]</div>\n\n  <div class=\"placeholder center-spacecraft\" aria-label=\"Dawn spacecraft near asteroid\">\n    <div class=\"array left\"></div>\n    <div class=\"core\"></div>\n    <div class=\"array right\"></div>\n    <div class=\"caption\">[Image: Dawn spacecraft]</div>\n  </div>\n\n  <div class=\"placeholder left-spacecraft\">\n    <span>[Image: framing camera assembly]</span>\n  </div>\n\n  <div class=\"placeholder camera-hardware\">[Image: framing camera hardware]</div>\n\n  <div class=\"placeholder right-spacecraft\">\n    <div class=\"dish\"></div>\n    <div class=\"bus\"></div>\n    <div class=\"solar\"></div>\n    <div class=\"caption\">[Image: spacecraft]</div>\n  </div>\n\n  <div class=\"placeholder grand-hardware\">[Image: Gamma Ray Neutron Detector]</div>\n  <div class=\"placeholder vir-hardware\">[Image: Visible &amp; Infrared Spectrometer]</div>\n\n  <section class=\"instrument framing\">\n    <h2>Framing Cameras <span class=\"flag flag-de\" aria-label=\"German flag\"></span></h2>\n    <p>\n      By imaging the surfaces of Vesta<br>\n      and Ceres, the framing cameras<br>\n      will enable scientists to map the<br>\n      topography, albedo and color, and<br>\n      to determine their shapes, volumes,<br>\n      and spin rates.\n    </p>\n  </section>\n\n  <div class=\"person holger\">\n    <div class=\"portrait\"></div>\n    <div class=\"name\">Holger Sierks</div>\n    <div class=\"role\">Framing Camera Lead, MPS</div>\n  </div>\n\n  <section class=\"instrument gravity\">\n    <h2>Gravity Science <span class=\"flag flag-us\" aria-label=\"United States flag\"></span></h2>\n    <p>\n      Gravity science: the spacecraft<br>\n      transmits a radio signal to Earth<br>\n      through its high gain antenna<br>\n      that changes in frequency as the<br>\n      spacecraft’s speed changes when<br>\n      flying over areas of different<br>\n      densities. The collective set of<br>\n      information on the mass variations<br>\n      or concentrations is called<br>\n      the gravitational field<br>\n      of the body/planet.\n    </p>\n  </section>\n\n  <div class=\"person sami\">\n    <div class=\"portrait\"></div>\n    <div class=\"name\">Sami Asmar</div>\n    <div class=\"role\">Gravity Science Lead, JPL</div>\n  </div>\n\n  <section class=\"instrument grand\">\n    <h2>Gamma Ray Neutron Detector <span class=\"flag flag-us\" aria-label=\"United States flag\"></span></h2>\n    <p>\n      GRaND measures<br>\n      elemental abundances<br>\n      on the surfaces<br>\n      of Vesta and Ceres,<br>\n      offering insight into their<br>\n      respective formation<br>\n      and evolution\n    </p>\n  </section>\n\n  <div class=\"person tom\">\n    <div class=\"portrait\"></div>\n    <div class=\"name\">Tom Prettyman</div>\n    <div class=\"role\">GRaND Team Lead, PSI</div>\n  </div>\n\n  <section class=\"instrument vir\">\n    <h2>Visible &amp; Infrared Spectrometer <span class=\"flag flag-it\" aria-label=\"Italian flag\"></span></h2>\n    <p>\n      VIR measures reflected<br>\n      sunlight and emitted thermal<br>\n      radiation from the surfaces of<br>\n      the targets. Scientists extract<br>\n      and then map mineralogical<br>\n      signatures and thermal<br>\n      properties. These properties<br>\n      hold clues to the history<br>\n      and formation mechanisms<br>\n      of Vesta and Ceres.\n    </p>\n  </section>\n\n  <div class=\"person angi\">\n    <div class=\"portrait\"></div>\n    <div class=\"name\">Angioletta Coradini,</div>\n    <div class=\"role\">VIR Team Leader, INAF</div>\n  </div>\n\n  <div class=\"center-copy\">\n    In its journey to the main asteroid belt to orbit two diverse<br>\n    protoplanets, Vesta and Ceres, Dawn is carrying a suite of<br>\n    sophisticated scientific instruments to collect data that will<br>\n    inform us about the early formation of our solar system.\n  </div>\n\n  <div class=\"url\">http://dawn.jpl.nasa.gov</div>\n</main>\n</body>\n</html>"
