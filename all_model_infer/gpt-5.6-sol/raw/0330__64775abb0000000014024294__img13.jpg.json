e: 103% !important;\n  }\n\n  .options mjx-container {\n    font-size: 106% !important;\n  }\n</style>\n<script>\n  window.MathJax = {\n    tex: {\n      inlineMath: [['\\\\(', '\\\\)'], ['$', '$']],\n      displayMath: [['\\\\[', '\\\\]'], ['$$', '$$']]\n    },\n    svg: {\n      fontCache: 'global'\n    }\n  };\n</script>\n<script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js\"></script>\n</head>\n<body>\n<main class=\"page\">\n  <section class=\"question top-q14\">\n    <div class=\"stem two-line\">\n      14. 已知角 \\(\\theta\\) 的始边为 \\(x\\) 轴非负半轴，终边经过点 \\(P(1,2)\\), 则\n      \\(\\dfrac{\\sin\\theta+\\cos\\theta}{\\sin\\theta}\\)<br>\n      的值为\n    </div>\n    <span class=\"answer-mark\">（　）</span>\n    <div class=\"options\">\n      <div class=\"option\">A. \\(-\\dfrac{1}{3}\\)</div>\n      <div class=\"option\">B. \\(\\dfrac{1}{3}\\)</div>\n      <div class=\"option\">C. \\(-\\dfrac{2}{3}\\)</div>\n      <div class=\"option\">D. \\(\\dfrac{2}{3}\\)</div>\n    </div>\n  </section>\n\n  <section class=\"question top-q15\">\n    <div class=\"stem\">\n      15. 设 \\(\\tan\\alpha=3\\), 则\n      \\(\\dfrac{\\sin(\\alpha-\\pi)+\\cos(\\pi-\\alpha)}\n      {\\sin\\left(\\dfrac{\\pi}{2}-\\alpha\\right)+\\cos\\left(\\dfrac{\\pi}{2}+\\alpha\\right)}=\\)\n    </div>\n    <span class=\"answer-mark\">（　）</span>\n    <div class=\"options\">\n      <div class=\"option\">A. \\(\\dfrac{10}{3}\\)</div>\n      <div class=\"option\">B. \\(\\dfrac{5}{3}\\)</div>\n      <div class=\"option\">C. \\(3\\)</div>\n      <div class=\"option\">D. \\(2\\)</div>\n    </div>\n  </section>\n\n  <h2 class=\"section-title\">拔高题组</h2>\n\n  <section class=\"question main-question q1\">\n    <div class=\"stem\">1. \\(\\tan105^\\circ=\\)</div>\n    <span class=\"answer-mark\">（　）</span>\n    <div class=\"options\">\n      <div class=\"option\">A. \\(2-\\sqrt3\\)</div>\n      <div class=\"option\">B. \\(-2-\\sqrt3\\)</div>\n      <div class=\"option\">C. \\(\\sqrt3-2\\)</div>\n      <div class=\"option\">D. \\(-\\sqrt3\\)</div>\n    </div>\n  </section>\n\n  <section class=\"question main-question q2\">\n    <div class=\"stem\">2. \\(\\cos15^\\circ\\cos75^\\circ=\\)</div>\n    <span class=\"answer-mark\">（　）</span>\n    <div class=\"options\">\n      <div class=\"option\">A. \\(\\dfrac{\\sqrt3}{2}\\)</div>\n      <div class=\"option\">B. \\(\\dfrac{1}{2}\\)</div>\n      <div class=\"option\">C. \\(\\dfrac{\\sqrt3}{4}\\)</div>\n      <div class=\"option\">D. \\(\\dfrac{1}{4}\\)</div>\n    </div>\n  </section>\n\n  <section class=\"question main-question q3\">\n    <div class=\"stem\">3. 已知 \\(\\sin\\alpha+\\cos\\alpha=\\dfrac{1}{5}\\), 则 \\(\\sin2\\alpha\\) 的值是</div>\n    <span class=\"answer-mark\">（　）</span>\n    <div class=\"options tight-options\">\n      <div class=\"option\">A. \\(-\\dfrac{24}{25}\\)</div>\n      <div class=\"option\">B. \\(\\dfrac{7}{25}\\)</div>\n      <div class=\"option\">C. \\(-\\dfrac{7}{25}\\)</div>\n      <div class=\"option\">D. \\(\\dfrac{24}{25}\\)</div>\n    </div>\n  </section>\n\n  <section class=\"question main-question q4\">\n    <div class=\"stem\">4. 已知 \\(\\sin\\alpha-\\cos\\alpha=\\dfrac{4}{3}\\), 则 \\(\\sin2\\alpha=\\)</div>\n    <span class=\"answer-mark\">（　）</span>\n    <div class=\"options tight-options\">\n      <div class=\"option\">A. \\(-\\dfrac{7}{16}\\)</div>\n      <div class=\"option\">B. \\(-\\dfrac{7}{9}\\)</div>\n      <div class=\"option\">C. \\(\\dfrac{7}{16}\\)</div>\n      <div class=\"option\">D. \\(\\dfrac{7}{9}\\)</div>\n    </div>\n  </section>\n\n  <section class=\"question main-question q5\">\n    <div class=\"stem two-line\">\n      5. 已知角 \\(\\alpha\\) 的顶点与原点重合，始边与 \\(x\\) 轴的非负半轴重合，点<br>\n      \\(P(-1,3)\\) 在角 \\(\\alpha\\) 的终边上，则\n      \\(\\dfrac{\\sin\\alpha-\\cos\\alpha}{2\\sin\\alpha-3\\cos\\alpha}=\\)\n    </div>\n    <span class=\"answer-mark\">（　）</span>\n    <div class=\"options tight-options\">\n      <div class=\"option\">A. \\(-\\dfrac{3}{4}\\)</div>\n      <div class=\"option\">B. \\(\\dfrac{3}{4}\\)</div>\n      <div class=\"option\">C. \\(-\\dfrac{4}{9}\\)</div>\n      <div class=\"option\">D. \\(\\dfrac{4}{9}\\)</div>\n    </div>\n  </section>\n\n  <section class=\"question main-question q6\">\n    <div class=\"stem\">\n      6. 已知角 \\(\\alpha\\) 的终边过点 \\(P(1,2)\\), 则\n      \\(\\dfrac{2\\sin\\alpha+\\cos\\alpha}{2\\sin\\alpha-\\cos\\alpha}=\\)\n    </div>\n    <span class=\"answer-mark\">（　）</span>\n    <div class=\"options tight-options\">\n      <div class=\"option\">A. \\(2\\)</div>\n      <div class=\"option\">B. \\(1\\)</div>\n      <div class=\"option\">C. \\(-1\\)</div>\n      <div class=\"option\">D. \\(-2\\)</div>\n    </div>\n  </section>\n\n  <section class=\"question main-question q7\">\n    <div class=\"stem\">\n      7. 已知 \\(\\sin\\alpha-3\\cos\\alpha=0\\), 则\n      \\(\\dfrac{3\\cos\\alpha-4\\sin\\alpha}{\\sin\\alpha+\\cos\\alpha}=\\)\n    </div>\n    <span class=\"answer-mark\">（　）</span>\n    <div class=\"options tight-options\">\n      <div class=\"option\">A. \\(-\\dfrac{9}{4}\\)</div>\n      <div class=\"option\">B. \\(\\dfrac{4}{9}\\)</div>\n      <div class=\"option\">C. \\(\\dfrac{3}{4}\\)</div>\n      <div class=\"option\">D. \\(-3\\)</div>\n    </div>\n  </section>\n</main>\n</body>\n</html>"
