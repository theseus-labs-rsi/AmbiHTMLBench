iv>\n    <div class=\"lake\"></div>\n  </figure>\n\n  <div class=\"bottom-star\">*</div>\n\n  <section class=\"awards\">\n    <div class=\"award\">\n      <span class=\"laurel left\"></span>\n      <div class=\"award-content\">\n        年度最喜爱<br>\n        入围奖\n      </div>\n      <span class=\"laurel right\"></span>\n    </div>\n\n    <div class=\"award\">\n      <span class=\"laurel left\"></span>\n      <div class=\"award-content\">\n        年度喜爱作品榜\n        <span class=\"top100\">Top100</span>\n      </div>\n      <span class=\"laurel right\"></span>\n    </div>\n\n    <div class=\"award\">\n      <span class=\"laurel left\"></span>\n      <div class=\"award-content\">\n        可瓦电影节<br>\n        提名影片\n      </div>\n      <span class=\"laurel right\"></span>\n    </div>\n  </section>\n</main>\n</body>\n</html>"
