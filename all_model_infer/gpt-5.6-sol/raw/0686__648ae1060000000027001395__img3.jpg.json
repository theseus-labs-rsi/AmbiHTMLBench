一次函数　一次函数 $y\\in R$</td>\n            <td class=\"function-name\">反比例函数 $x\\ne0$</td>\n            <td>对数函数 $x&gt;0$</td>\n          </tr>\n          <tr>\n            <td rowspan=\"2\">值域</td>\n            <td>\n              <span class=\"function-name\">一次函数：</span>$y=kx+b(k\\ne0)$<br>\n              <b>$y\\in R$</b>\n            </td>\n            <td>\n              <span class=\"function-name\">反比例函数：</span>$y=\\dfrac{k}{x}(k\\ne0)$<br>\n              <b>$y\\in(-\\infty,0)\\cup(0,+\\infty)$</b>\n            </td>\n            <td rowspan=\"2\">\n              <span class=\"function-name\">二次函数：</span>$y=ax^2$<br>\n              $+bx+c(a,b,c为常数且a$<br>\n              $\\ne0)$<br>\n              <b>$y$看开口方向和对称性</b>\n            </td>\n          </tr>\n          <tr>\n            <td>\n              <span class=\"function-name\">指数函数：</span>$y=a^x\\ (a&gt;0且a\\ne1)$<br>\n              <b>$y\\in(0,+\\infty)$</b>\n            </td>\n            <td>\n              <span class=\"function-name\">对数函数</span>$\\log_a x\\ (a&gt;0且a\\ne1)$<br>\n              <b>$y\\in R$</b>\n            </td>\n          </tr>\n          <tr>\n            <td rowspan=\"2\">单调性</td>\n            <td colspan=\"3\">\n              $x_1&lt;x_2,\\quad f(x_1)&lt;f(x_2)\\Longleftrightarrow f(x)$ 是增函数\n              &nbsp;&nbsp; $\\dfrac{f(x_1)-f(x_2)}{x_1-x_2}&gt;0\\Longleftrightarrow f(x)$ 是增函数\n            </td>\n          </tr>\n          <tr>\n            <td colspan=\"3\">\n              $x_1&lt;x_2,\\quad f(x_1)&gt;f(x_2)\\Longleftrightarrow f(x)$ 是减函数\n              &nbsp;&nbsp; $\\dfrac{f(x_1)-f(x_2)}{x_1-x_2}&lt;0\\Longleftrightarrow f(x)$ 是减函数\n            </td>\n          </tr>\n          <tr>\n            <td rowspan=\"2\">奇偶性</td>\n            <td colspan=\"3\">复合函数$y=f(g(x))$　同增异减</td>\n          </tr>\n          <tr>\n            <td colspan=\"3\">\n              $f(-x)=f(x)\\Longleftrightarrow f(x)$ 是偶函数$\\Longleftrightarrow$图像关于$y$轴对称，对称轴$x=\\dfrac{a+b}{2}$\n            </td>\n          </tr>\n          <tr>\n            <td>零点</td>\n            <td colspan=\"3\">\n              $f(-x)=-f(x)\\Longleftrightarrow f(x)$ 是奇函数$\\Longleftrightarrow$图像关于原点对称，对称中心\n              $(\\dfrac{a+b}{2},0)$\n              <div class=\"zero-layout\">\n                <div class=\"zero-note placeholder\">函数$y=f(x)$的图象<br>与$x$轴交点的横坐标</div>\n                <div class=\"zero-note placeholder\">方程$f(x)=0$有实数根</div>\n              </div>\n            </td>\n          </tr>\n        </tbody>\n      </table>\n\n      <p class=\"chapter\">3.　幂函数</p>\n      <p class=\"subsection\">3.2　五个幂函数的图象</p>\n\n      <figure class=\"placeholder graph-placeholder\" aria-label=\"五个幂函数图象\">\n        <span class=\"axis-x\"></span>\n        <span class=\"axis-y\"></span>\n        <span class=\"axis-label x\">$x$</span>\n        <span class=\"axis-label y\">$y$</span>\n        <span class=\"axis-label o\">$O$</span>\n        <span class=\"curve c1\"></span>\n        <span class=\"curve c2\"></span>\n        <span class=\"curve c3\"></span>\n        <span class=\"curve c4\"></span>\n        <span class=\"curve c5\"></span>\n        <span class=\"curve c6\"></span>\n        <span class=\"curve-label l1\">$y=x^3$</span>\n        <span class=\"curve-label l2\">$y=x^2$</span>\n        <span class=\"curve-label l3\">$y=x$</span>\n        <span class=\"curve-label l4\">$y=x^{\\frac12}$</span>\n      </figure>\n\n      <p class=\"subsection\">3.3　五个幂函数的性质</p>\n\n      <table class=\"summary-table\">\n        <tbody>\n          <tr class=\"head\">\n            <th class=\"vertical\">函数</th>\n            <th>$y=x$</th>\n            <th>$y=x^2$</th>\n            <th>$y=x^3$</th>\n            <th>$y=x^{\\frac12}$</th>\n            <th>$y=x^{-1}$</th>\n          </tr>\n          <tr>\n            <td class=\"vertical\">定义域</td>\n            <td>$R$</td>\n            <td>$R$</td>\n            <td>$R$</td>\n            <td>$[0,+\\infty)$</td>\n            <td>$(-\\infty,0)\\cup$<br>$(0,+\\infty)