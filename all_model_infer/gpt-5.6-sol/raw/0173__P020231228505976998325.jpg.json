 background: #233a9f;\n  box-shadow: 0 0 0 2px rgba(255,255,255,.25);\n}\nfigcaption {\n  margin-top: 7px;\n  color: #777;\n  font-size: 13px;\n  line-height: 1.25;\n  text-align: center;\n  white-space: nowrap;\n}\n.perception-row {\n  position: relative;\n  margin-top: 11px;\n  min-height: 244px;\n}\n.perception-text {\n  width: 100%;\n}\n.figure-three {\n  float: right;\n  width: 320px;\n  margin: 60px 7px 0 9px;\n}\n.detection-screen {\n  width: 320px;\n  height: 155px;\n  background:\n    radial-gradient(ellipse at 35% 52%, rgba(242,0,219,.83), transparent 16%),\n    repeating-radial-gradient(ellipse at 35% 52%, transparent 0 12px, rgba(0,137,212,.48) 13px 14px, transparent 15px 22px),\n    linear-gradient(180deg, #ddd 0 14%, #1f2530 15% 100%);\n}\n.detection-screen::after {\n  content: \"\";\n  position: absolute;\n  right: 0;\n  top: 0;\n  width: 108px;\n  height: 155px;\n  border-left: 2px solid #bbb;\n  background:\n    linear-gradient(180deg, rgba(209,0,236,.38), transparent 35%),\n    repeating-linear-gradient(0deg, #555 0 37px, #ddd 38px 40px),\n    linear-gradient(135deg, #746854, #9b958a);\n}\n.planning {\n  clear: both;\n  margin-top: 3px;\n}\n.algorithm-row {\n  position: relative;\n  margin-top: 8px;\n  min-height: 241px;\n}\n.algorithm-text {\n  width: 319px;\n  text-indent: 0;\n}\n.algorithm-text .indent {\n  text-indent: 2em;\n}\n.figure-four {\n  position: absolute;\n  right: -6px;\n  top: 30px;\n  width: 352px;\n}\n.grid-map {\n  width: 352px;\n  height: 175px;\n  color: rgba(0,0,0,.66);\n  background:\n    radial-gradient(circle at 72% 62%, #7e1c54 0 2px, transparent 3px),\n    radial-gradient(circle at 30% 38%, #21609d 0 1px, transparent 2px),\n    repeating-radial-gradient(circle at 38% 62%, transparent 0 4px, rgba(53,45,93,.62) 5px 6px, transparent 7px 9px),\n    linear-gradient(150deg, transparent 0 26%, #b8b6bb 27% 54%, transparent 55%),\n    #c3e1e8;\n}\n.grid-map::before {\n  content: \"\";\n  position: absolute;\n  left: 0;\n  top: 0;\n  width: 68px;\n  height: 175px;\n  border-right: 1px solid #aaa;\n  background:\n    linear-gradient(180deg, #eee 0 72%, #707070 73%),\n    #ddd;\n}\n.grid-map::after {\n  content: \"\";\n  position: absolute;\n  left: 8px;\n  bottom: 7px;\n  width: 54px;\n  height: 52px;\n  background: linear-gradient(150deg, #888, #ddd 60%, #466042);\n  border: 1px solid #bbb;\n}\n.real-world {\n  margin-top: 3px;\n}\n.model-row {\n  display: grid;\n  grid-template-columns: 238px 1fr;\n  column-gap: 22px;\n  margin-top: 7px;\n  align-items: start;\n}\n.figure-five {\n  width: 238px;\n  margin-left: 17px;\n}\n.car-model {\n  width: 218px;\n  height: 110px;\n  border: none;\n  box-shadow: none;\n  background:\n    radial-gradient(ellipse at 43% 75%, #121212 0 13px, #777 14px 18px, transparent 19px),\n    radial-gradient(ellipse at 75% 74%, #121212 0 12px, #777 13px 17px, transparent 18px),\n    radial-gradient(ellipse at 52% 51%, #28313a 0 37%, transparent 38%),\n    linear-gradient(180deg, #f4f5f5, #fff);\n}\n.car-model::after {\n  content: \"\";\n  position: absolute;\n  left: 51px;\n  top: 15px;\n  width: 104px;\n  height: 65px;\n  border: 1px solid #555;\n  border-radius: 55% 47% 31% 42%;\n  background:\n    linear-gradient(115deg, rgba(255,255,255,.62), transparent 27%),\n    linear-gradient(70deg, #111b24, #7e858a 49%, #31373c 50%, #101820);\n  transform: skew(-12deg);\n}\n.model-text {\n  padding-top: 4px;\n}\n.footer {\n  position: absolute;\n  left: 0;\n  bottom: 0;\n  width: 100%;\n  height: 142px;\n  overflow: hidden;\n  background:\n    radial-gradient(circle at 88% 72%, rgba(255,255,255,.98) 0 5px, rgba(255,116,194,.72) 11px, transparent 47px),\n    radial-gradient(circle at 87% 74%, rgba(255,245,138,.7), transparent 73px),\n    linear-gradient(175deg, #fff 0 21%, #ffb03a 22% 25%, #ff6d00 26% 100%);\n}\n.footer::before {\n  content: \"\";\n  position: absolute;\n  right: -28px;\n  bottom: -54px;\n  width: 168px;\n  height: 168px;\n  border-radius: 50%;\n  border: 15px dashed rgba(255,255,255,.85);\n  box-shadow: 0 0 0 2px rgba(255,255,255,.55);\n}\n.footer::after {\n  content: \"‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹\";\n  position: absolute;\n  left: 211px;\n  top: 63px;\n  color: rgba(255,232,63,.8);\n  font-family: Arial, sans-serif;\n  font-size: 13px;\n  letter-spacing: -2px;\n  transform: rotate(-1deg);\n}\n.footer-lines {\n  position: absolute;\n  left: -8px;\n  top: 67px;\n  width: 640px;\n  height: 45px;\n  border-top: 1px solid rgba(255,215,64,.75);\n  border-bottom: 1px solid rgba(255,215,64,.5);\n  transform: rotate(-1deg);\n}\n.footer-dots {\n  position: absolute;\n  left: 0;\n  top: 70px;\n  width: 390px;\n  height: 65px;\n  background:\n    radial-gradient(circle, #fff 0 1px, transparent 2px) 0 0 / 29px 22px,\n    radial-gradient(circle, #ffe900 0 2px, transparent 3px) 10px 7px / 71px 49px;\n  opacity: .8;\n}\n@media (max-width: 768px) {\n  body {\n    justify-content: flex-start;\n  }\n  .poster {\n    transform-origin: top left;\n  }\n}\n</style>\n</head>\n<body>\n<main class=\"poster\">\n  <header class=\"top-banner\">\n    <div class=\"logo\">ISCAS</div>\n    <div class=\"conference\">\n      中国科学院软件研究所学术年会 · <span class=\"year\">2023</span><br>\n      暨计算机科学国家重点实验室开放周\n    </div>\n    <div class=\"star-mark\">☆</div>\n    <div class=\"project\">重大示范<br>工程/项目</div>\n  </header>\n\n  <section class=\"title-zone\">\n    <h1>开放环境下的可信智能算法</h1>\n    <div class=\"authors\">\n      张立军, 陈恒威<sup>*</sup>, 李彻珏, 罗云翔, 程铭, 何奇松, 朱美森, 甘涛,<br>\n      秦天航, 徐星成, 韩绍航, 金高杰, 李权忠\n    </div>\n    <div class=\"contact\">*Tel: 18739558169, E-mail: chenhengwei@buaa.edu.cn</div>\n  </section>\n\n  <section class=\"main-content\">\n    <p class=\"intro\">\n      自动驾驶物理实车和仿真平台（Iscas Self-driving System, ISS），由开放环境下的可信智能算法团队研发，旨在建立自动驾驶数字孪生系统，依托该系统可以评价自动驾驶功能设计的合理性，挖掘预期不足和行驶隐患，最终建立整车行驶安全性与子模块可靠性评价体系。自动驾驶系统按照功能层次分为感知模块（Perception Module）和规控模块（Planning &amp; Control Module）。\n    </p>\n\n    <div class=\"figure-pair\">\n      <figure>\n        <div class=\"placeholder map-one\">\n          <span class=\"placeholder-label\">[图像：园区环境3D建图]</span>\n        </div>\n        <figcaption>图1 软件园区环境下的3D建图效果（LOAM）</figcaption>\n      </figure>\n      <figure>\n        <div class=\"placeholder map-two\">\n          <span class=\"placeholder-label\">[图像：仿真城市3D建图]</span>\n        </div>\n        <figcaption>图2 仿真城市环境下的3D建图效果（LIO-SAM）</figcaption>\n      </figure>\n    </div>\n\n    <div class=\"perception-row\">\n      <figure class=\"figure-three\">\n        <div class=\"placeholder detection-screen\">\n          <span class=\"placeholder-label\">[图像：Carla目标检测界面]</span>\n        </div>\n        <figcaption>图3 基于Carla的目标检测算法部署</figcaption>\n      </figure>\n      <p class=\"perception-text\">\n        感知模块（Perception Module）通过传感器输入的数据表示周围环境并建立可用于规划模块的地图。当车辆处于未知环境时，实现精准定位和识别周围环境的任务是相辅相成的，ISS采用不同类型的SLAM方案如图1和图2，在园区环境以及仿真城市环境下进行了算法验证，结果表明，所采用的SLAM方案在不同驾驶场景下（如楼宇环境和交通道路环境）表现稳定，能够勾勒出较为准确的环境样貌。\n      </p>\n    </div>\n\n    <p class=\"planning\">\n      规控模块（Planning &amp; Control Module）可以分为三个部分：决策模块、运动规划模块和控制模块，主要是基于感知模块所建立的地图进行路径规划，以及控制模块按照规划的路径进行状态跟踪。在设定目标后，车辆可以在仿真环境中做出最佳的驾驶决策，并且根据决策做出与人类驾驶员相似的驾驶行为。\n    </p>\n\n    <div class=\"algorithm-row\">\n      <p class=\"algorithm-text\">\n        <span class=\"indent\">基于Carla仿真器部署的目标检测算法如图3所示，包括基于Lidar点云的PointPillar算法和基于相机图像的YOLO-V2算法。</span><br>\n        PointPillar是一种3D目标检测算法，该算法首先将点云数据投影到二维伪图像上，然后通过多层感知机（MLP）提取特征。最终，使用滑动窗口进行目标检测，并预测每个窗口中是否存在目标以及目标的位置、尺寸等信息。\n      </p>\n      <figure class=\"figure-four\">\n        <div class=\"placeholder grid-map\">\n          <span class=\"placeholder-label\">[图像：栅格地图导航与主动避障]</span>\n        </div>\n        <figcaption>图4 园区环境下基于栅格地图的导航、主动避障</figcaption>\n      </figure>\n    </div>\n\n    <p class=\"real-world\">\n      实际环境下的规控算法验证如图4所示，车辆在行驶过程中根据周围实际环境与交通情况做出最优的决策和规划路径，从而实现安全、高效、舒适的自动驾驶。\n    </p>\n\n    <div class=\"model-row\">\n      <figure class=\"figure-five\">\n        <div class=\"placeholder car-model\">\n          <span class=\"placeholder-label\">[图像：车辆三维模型]</span>\n        </div>\n        <figcaption>图5 自主设计的车辆三维模型</figcaption>\n      </figure>\n      <p class=\"model-text\">\n        此外，为了将车辆投入到实际使用并满足不同场景下的应用需求，自主设计了模拟汽车的三维模型，如图5所示，从而为数字孪生系统的搭建打下基础。\n      </p>\n    </div>\n  </section>\n\n  <footer class=\"footer\">\n    <div class=\"footer-lines\"></div>\n    <div class=\"footer-dots\"></div>\n  </footer>\n</main>\n</body>\n</html>",
