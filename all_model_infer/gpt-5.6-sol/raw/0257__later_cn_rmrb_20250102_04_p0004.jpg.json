        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>人民日报要闻第4版</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] },\n  svg: { fontCache: 'global' }\n};\n</script>\n<script defer src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js\"></script>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;padding:0;background:#d8d8d8}\nbody{\n  color:#171717;\n  font-family:\"SimSun\",\"Songti SC\",\"Noto Serif CJK SC\",serif;\n}\n.page{\n  position:relative;\n  width:800px;\n  min-height:907px;\n  margin:0 auto;\n  padding:7px 7px 8px;\n  overflow:hidden;\n  background:#fff;\n}\n.header{\n  height:35px;\n  display:flex;\n  align-items:flex-start;\n  border-bottom:1.5px solid #222;\n  position:relative;\n}\n.section-name{\n  font-size:24px;\n  line-height:29px;\n  letter-spacing:1px;\n  margin-left:5px;\n}\n.page-no{\n  font-family:Arial,sans-serif;\n  font-size:25px;\n  line-height:29px;\n  margin-left:14px;\n}\n.date{\n  margin:16px 0 0 16px;\n  font-family:\"SimSun\",serif;\n  font-size:7px;\n  font-weight:bold;\n  white-space:nowrap;\n}\n.masthead{\n  position:absolute;\n  right:2px;\n  top:6px;\n  font-family:\"STKaiti\",\"KaiTi\",serif;\n  font-size:21px;\n  font-weight:bold;\n  letter-spacing:1px;\n  transform:skew(-7deg);\n}\n.top-grid{\n  display:grid;\n  grid-template-columns:202px 386px 190px;\n  height:590px;\n  border-bottom:1.5px solid #333;\n}\n.left-story{\n  position:relative;\n  padding:17px 7px 5px 68px;\n  border-right:1px solid #aaa;\n  overflow:hidden;\n}\n.left-main-title{\n  position:absolute;\n  top:24px;\n  left:38px;\n  height:365px;\n  writing-mode:vertical-rl;\n  text-orientation:upright;\n  font-family:\"SimHei\",\"Noto Sans CJK SC\",sans-serif;\n  font-size:19px;\n  line-height:25px;\n  font-weight:900;\n  letter-spacing:2px;\n}\n.left-side-title{\n  position:absolute;\n  top:23px;\n  left:6px;\n  height:285px;\n  writing-mode:vertical-rl;\n  text-orientation:upright;\n  border-left:1px solid #444;\n  font-size:16px;\n  line-height:21px;\n  letter-spacing:2px;\n}\n.left-copy{\n  font-size:6.2px;\n  line-height:1.48;\n  text-align:justify;\n}\n.left-copy p{margin:0 0 5px;text-indent:2em}\n.left-copy .byline{text-align:right;text-indent:0}\n.info-box{\n  position:absolute;\n  left:5px;\n  right:9px;\n  bottom:9px;\n  min-height:58px;\n  padding:8px 8px 5px 42px;\n  background:linear-gradient(90deg,#fffaf0,#fff);\n  border-top:1px solid #eee4cc;\n  font-size:5.5px;\n  line-height:1.55;\n}\n.center-story{\n  padding:14px 9px 5px;\n  overflow:hidden;\n}\n.kicker{\n  text-align:center;\n  font-size:11px;\n  font-weight:bold;\n  letter-spacing:.2px;\n  margin:3px 0 6px;\n}\n.center-headline{\n  margin:0 0 13px;\n  text-align:center;\n  font-family:\"SimHei\",\"Noto Sans CJK SC\",sans-serif;\n  font-size:24px;\n  line-height:1.15;\n  letter-spacing:2px;\n  font-weight:900;\n}\n.center-columns{\n  display:grid;\n  grid-template-columns:repeat(3,1fr);\n  gap:9px;\n  height:156px;\n  overflow:hidden;\n  font-size:6.5px;\n  line-height:1.43;\n  text-align:justify;\n}\n.center-columns p{margin:0 0 4px;text-indent:2em}\n.photo{\n  position:relative;\n  width:100%;\n  height:301px;\n  margin-top:7px;\n  border:1px solid #222;\n  overflow:hidden;\n  background:\n    linear-gradient(150deg,transparent 0 39%,rgba(220,220,214,.96) 40% 48%,transparent 49%),\n    linear-gradient(27deg,transparent 0 48%,rgba(235,233,224,.98) 49% 58%,transparent 59%),\n    radial-gradient(ellipse at 20% 19%,#d6a55a 0 4%,transparent 5%),\n    radial-gradient(ellipse at 77% 21%,#9b5b35 0 6%,transparent 7%),\n    radial-gradient(ellipse at 29% 78%,#467b43 0 11%,transparent 12%),\n    linear-gradient(125deg,#b8c86a 0 21%,#ad693a 22% 34%,#42634f 35% 46%,#345766 47% 66%,#202f32 67% 100%);\n}\n.photo:before,.photo:after{\n  content:\"\";\n  position:absolute;\n  left:-30p