        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Greenhouse gas emissions</title>\n  <script>\n    window.MathJax = {\n      tex: {\n        inlineMath: [['$', '$']],\n        displayMath: [['$$', '$$']]\n      }\n    };\n  </script>\n  <script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * {\n      box-sizing: border-box;\n    }\n\n    html,\n    body {\n      margin: 0;\n      min-width: 1180px;\n      background: #fff;\n      color: #3a3a3a;\n      font-family: Arial, Helvetica, sans-serif;\n    }\n\n    body {\n      padding: 0 3.15vw 9vw;\n    }\n\n    .page {\n      width: 100%;\n      min-height: 100vh;\n    }\n\n    .topbar {\n      display: flex;\n      align-items: flex-start;\n      justify-content: space-between;\n      height: 10.7vw;\n      min-height: 126px;\n      padding-top: 2vw;\n      color: #737373;\n      font-size: clamp(12px, 0.69vw, 21px);\n      line-height: 1.2;\n      white-space: nowrap;\n    }\n\n    .navigation {\n      display: flex;\n      gap: 2.25vw;\n      align-items: flex-start;\n    }\n\n    .navigation span {\n      display: inline-block;\n      padding-bottom: 3px;\n    }\n\n    .navigation .active {\n      color: #363636;\n      font-weight: 700;\n      border-bottom: 1px solid #20b35c;\n    }\n\n    .report-meta {\n      display: flex;\n      gap: 0.85vw;\n      align-items: baseline;\n    }\n\n    .title-block {\n      margin-top: 0.4vw;\n    }\n\n    .section-label {\n      margin: 0 0 0.55vw;\n      font-size: clamp(18px, 1.2vw, 36px);\n      font-weight: 700;\n      line-height: 1.2;\n    }\n\n    h1 {\n      margin: 0;\n      color: #353535;\n      font-size: clamp(54px, 3.35vw, 100px);\n      font-weight: 700;\n      line-height: 1.03;\n      letter-spacing: 0;\n    }\n\n    .body-grid {\n      display: grid;\n      grid-template-colum