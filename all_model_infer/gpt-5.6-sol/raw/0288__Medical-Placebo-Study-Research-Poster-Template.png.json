tent: \"\";\n    position: absolute;\n    left: 9px;\n    top: 4px;\n    width: 35px;\n    height: 5px;\n    border-radius: 5px;\n    background: rgba(255,255,255,.65);\n  }\n\n  .coins {\n    position: absolute;\n    left: 99px;\n    top: 6px;\n    width: 80px;\n    height: 140px;\n  }\n\n  .coin {\n    position: absolute;\n    left: 0;\n    width: 75px;\n    height: 22px;\n    border-radius: 50%;\n    background: #ffb600;\n    border-bottom: 7px solid #f18c00;\n  }\n\n  .coin::after {\n    content: \"\";\n    position: absolute;\n    left: 10px;\n    top: 4px;\n    width: 55px;\n    height: 12px;\n    background: repeating-linear-gradient(\n      90deg,\n      #ffc800 0,\n      #ffc800 5px,\n      #ee9700 5px,\n      #ee9700 7px\n    );\n    border-radius: 50%;\n  }\n\n  .coin.c1 { top: 0; }\n  .coin.c2 { top: 29px; }\n  .coin.c3 { top: 58px; }\n  .coin.c4 { top: 87px; }\n  .coin.c5 { top: 116px; }\n\n  .money {\n    position: absolute;\n    left: 182px;\n    top: 30px;\n    width: 56px;\n    height: 93px;\n    background: #118f00;\n    border: 9px solid #078100;\n  }\n\n  .money::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: #17a700;\n    clip-path: polygon(0 0, 100% 0, 84% 12%, 84% 88%, 100% 100%, 0 100%, 16% 88%, 16% 12%);\n  }\n\n  .money::after {\n    content: \"\";\n    position: absolute;\n    left: 9px;\n    top: 25px;\n    width: 27px;\n    height: 27px;\n    border-radius: 50%;\n    background: #f1f2ef;\n  }\n\n  /* Bottom medical illustrations */\n  .bottom-illustration {\n    left: 511px;\n    top: 823px;\n    width: 220px;\n    height: 128px;\n  }\n\n  .medical-bag {\n    position: absolute;\n    left: 6px;\n    top: 47px;\n    width: 110px;\n    height: 78px;\n    border-radius: 9px;\n    background: #ee3e39;\n    overflow: hidden;\n  }\n\n  .medical-bag::before {\n    content: \"\";\n    position: absolute;\n    left: 36px;\n    top: -20px;\n    width: 40px;\n    height: 22px;\n    border: 7px solid #007e61;\n    border-bottom: 0;\n    border-radius: 4px 4px 0 0;\n  }\n\n  .medical-bag::after {\n    content: \"\";\n    position: absolute;\n    right: -12px;\n    top: 32px;\n    width: 85px;\n    height: 65px;\n    background: #c82f32;\n    transform: rotate(43deg);\n  }\n\n  .medical-bag .cross {\n    position: absolute;\n    z-index: 2;\n    left: 29px;\n    top: 25px;\n    width: 51px;\n    height: 27px;\n    background: #fff;\n  }\n\n  .medical-bag .cross::after {\n    content: \"\";\n    position: absolute;\n    left: 13px;\n    top: -13px;\n    width: 27px;\n    height: 53px;\n    background: #fff;\n  }\n\n  .medical-bag .stitch {\n    position: absolute;\n    z-index: 3;\n    left: 9px;\n    bottom: 11px;\n    width: 17px;\n    height: 2px;\n    background: #fff;\n    box-shadow: 0 4px 0 #fff;\n  }\n\n  .medical-bag .clasp {\n    position: absolute;\n    z-index: 3;\n    right: 8px;\n    top: 11px;\n    width: 8px;\n    height: 8px;\n    background: #b62a2e;\n  }\n\n  .clipboard {\n    position: absolute;\n    left: 128px;\n    top: 6px;\n    width: 82px;\n    height: 119px;\n    border-radius: 7px;\n    background: #17a771;\n    padding: 12px 10px 10px;\n  }\n\n  .clipboard::before {\n    content: \"\";\n    position: absolute;\n    top: -4px;\n    left: 23px;\n    width: 36px;\n    height: 9px;\n    border-radius: 2px 2px 0 0;\n    background: #494477;\n  }\n\n  .clipboard .paper {\n    position: absolute;\n    left: 11px;\n    top: 13px;\n    width: 60px;\n    height: 94px;\n    background: #f0f1ed;\n    clip-path: polygon(0 0, 100% 0, 100% 100%, 18% 100%, 0 82%);\n  }\n\n  .clipboard .paper::before {\n    content: \"\";\n    position: absolute;\n    top: 11px;\n    left: 19px;\n    width: 24px;\n    height: 8px;\n    background: #f47c00;\n    box-shadow:\n      -12px 18px 0 -2px #d0d1cf,\n      12px 18px 0 -2px #d0d1cf,\n      -12px 31px 0 -2px #d0d1cf,\n      12px 31px 0 -2px #d0d1cf,\n      -12px 44px 0 -2px #d0d1cf,\n      12px 44px 0 -2px #d0d1cf;\n  }\n\n  .clipboard .paper::after {\n    content: \"+\";\n    position: absolute;\n    right: 7px;\n    bottom: 4px;\n    color: #ff4c47;\n    font: 700 29px/1 Arial, sans-serif;\n  }\n\n  .footer {\n    position: absolute;\n    left: 0;\n    top: 985px;\n    width: 816px;\n    height: 71px;\n    background: #fff;\n    color: #6661a8;\n  }\n\n  .brand {\n    position: absolute;\n    left: 36px;\n    top: 13px;\n    font-family: Impact, Haettenschweiler, \"Arial Narrow\", sans-serif;\n    font-size: 39px;\n    line-height: 1;\n    letter-spacing: 1px;\n    white-space: nowrap;\n  }\n\n  .credits {\n    position: absolute;\n    left: 188px;\n    top: 14px;\n    width: 588px;\n    color: #4e9ab2;\n    font-family: \"Arial Narrow\", Arial, sans-serif;\n    font-size: 8px;\n    line-height: 12px;\n    white-space: normal;\n  }\n\n  .credits strong {\n    color: #6661a8;\n    font-weight: 700;\n  }\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <header class=\"header\">\n    <h1>The Placebo Effect: Are Expensive Placebos<br>More Effective Than Cheap Placebos?</h1>\n  </header>\n\n  <section class=\"top-zone\" aria-label=\"Purpose section\"></section>\n\n  <div class=\"placeholder top-illustration\" aria-label=\"Illustration of price tag and medicine bottles\">\n    <div class=\"price-tag\"><span class=\"dollar\">$</span></div>\n    <div class=\"large-bottle\">\n      <div class=\"cap\"></div>\n      <div class=\"neck\"></div>\n      <div class=\"label\"></div>\n    </div>\n    <div class=\"small-bottle\">\n      <div class=\"cap\"></div>\n      <div class=\"dark-band\"></div>\n      <div class=\"green-label\"></div>\n    </div>\n  </div>\n\n  <section class=\"purpose\">\n    <h2 class=\"section-title\">Purpose</h2>\n    <p class=\"copy\">In what ways can fictitious costs impact the effectiveness<br>\n      of a placebo? To better understand how the ‘placebo<br>\n      effect’ takes place, we will provide placebos of different<br>\n      reported costs and measure their impact on the patients.</p>\n  </section>\n\n  <div class=\"shelf shelf-one\" aria-hidden=\"true\">\n    <div class=\"sloped\"></div>\n    <div class=\"front\"></div>\n  </div>\n\n  <section class=\"middle-zone\" aria-label=\"Hypothesis section\"></section>\n\n  <div class=\"placeholder middle-illustration\" aria-label=\"Illustration of capsule, coins, and money\">\n    <div class=\"capsule\"></div>\n    <div class=\"coins\">\n      <div class=\"coin c1\"></div>\n      <div class=\"coin c2\"></div>\n      <div class=\"coin c3\"></div>\n      <div class=\"coin c4\"></div>\n      <div class=\"coin c5\"></div>\n    </div>\n    <div class=\"money\"></div>\n  </div>\n\n  <section class=\"hypothesis\">\n    <h2 class=\"section-title\">Hypothesis</h2>\n    <p class=\"copy\">Providing placebos that are ‘expensive’ will amplify the<br>\n      placebo effect of actual placebos with participants.</p>\n  </section>\n\n  <div class=\"shelf shelf-two\" aria-hidden=\"true\">\n    <div class=\"sloped\"></div>\n    <div class=\"front\"></div>\n  </div>\n\n  <section class=\"bottom-zone\" aria-label=\"Method and results sections\"></section>\n\n  <section class=\"method\">\n    <h2 class=\"section-title\">Method</h2>\n    <div class=\"copy\">\n      <p>Participants suffering from Parkinson’s Disease serve as<br>\n        placebo effect test subjects.</p>\n\n      <p>Each participant receives an effective drug valued at $100<br>\n        per dose and then motor function changes are measured.<br>\n        After each participant receives an effective drug said to be<br>\n        valued at $1500 per dose, then their motor functions are<br>\n        measured again.</p>\n\n      <p>A comparison between motor function improvements<br>\n        following the administration of each placebo will help<br>\n        determine whether fictitious costs can influence the<br>\n        effectiveness of a placebo.</p>\n    </div>\n  </section>\n\n  <section class=\"results\">\n    <h2 class=\"section-title\">Results</h2>\n    <div class=\"copy\">\n      <p>The study found motor functions improve significantly<br>\n        more for participants following the administration of a<br>\n        reportedly $1500 placebo, compared to a reportedly<br>\n        $100 placebo.</p>\n\n      <p>While the degree of improvement in motor function for<br>\n        participants varied due to the administration of a $1500<br>\n        placebo drug, all participants experienced improved<br>\n        motor functions. A higher cost for a placebo will improve<br>\n        patients’ conditions even more.</p>\n    </div>\n  </section>\n\n  <div class=\"placeholder bottom-illustration\" aria-label=\"Illustration of a medical bag and clipboard\">\n    <div class=\"medical-bag\">\n      <div class=\"cross\"></div>\n      <div class=\"stitch\"></div>\n      <div class=\"clasp\"></div>\n    </div>\n    <div class=\"clipboard\">\n      <div class=\"paper\"></div>\n    </div>\n  </div>\n\n  <div class=\"shelf shelf-three\" aria-hidden=\"true\">\n    <div class=\"sloped\"></div>\n    <div class=\"front\"></div>\n  </div>\n\n  <footer class=\"footer\">\n    <div class=\"brand\">M.I.S.H.B</div>\n    <div class=\"credits\">\n      <strong>Study by Janelle Mauricio, Vanessa Garby, Shivinder Singh - The Massy Institute for Studies of Human Behavior</strong><br>\n      <strong>References:</strong> Kemputo, Odelle., “The psychology of self-deception” The Anaptic Journal, 2017 // Satuda, Evan., Temitope, Andrew., “Neuroscience of<br>\n      Decision-Making” The Science Review, 2018 // Brahms, Hansen., Leigh, Anderson., “The Need and Neurology for Happiness”, The Arch Journal, 2020\n    </div>\n  </footer>\n</main>\n</body>\n</html>"
