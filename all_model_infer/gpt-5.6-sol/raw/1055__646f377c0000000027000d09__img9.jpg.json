nt-size: 14px;\n    line-height: 1.18;\n  }\n\n  .mechanism-label {\n    left: 75px;\n    top: 575px;\n    width: 38px;\n  }\n\n  .mechanism-brace {\n    left: 101px;\n    top: 567px;\n    font-size: 77px;\n    transform: scaleX(.29) scaleY(1);\n  }\n\n  .mechanism-word {\n    left: 119px;\n    top: 568px;\n    width: 36px;\n  }\n\n  .mechanism-content {\n    left: 153px;\n    top: 568px;\n    width: 365px;\n    font-size: 14px;\n    line-height: 1.18;\n  }\n\n  .implementation-word {\n    left: 119px;\n    top: 596px;\n    width: 36px;\n  }\n\n  .implementation-brace {\n    left: 139px;\n    top: 596px;\n    font-size: 65px;\n    transform: scaleX(.25) scaleY(1.06);\n  }\n\n  .implementation-content {\n    left: 160px;\n    top: 594px;\n    width: 356px;\n    font-size: 14px;\n    line-height: 1.16;\n  }\n\n  .bottom-note {\n    left: 75px;\n    top: 649px;\n    width: 442px;\n    font-size: 14px;\n    line-height: 1.2;\n  }\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <div class=\"chapter-title chapter-nine\">第九章　学校财产与财务管理</div>\n\n  <div class=\"branch-label property-label\">财产<br>管理</div>\n  <div class=\"brace property-brace\" aria-hidden=\"true\"></div>\n\n  <section class=\"content top-summary\">\n    <div><span class=\"blue\">含义：</span>对学校物质财富的计划组织、使用保管活动。</div>\n    <div class=\"indent\">包括<span class=\"blue\">固定资产和流动资产</span>。</div>\n    <div><span class=\"blue\">内容：</span>目标；制度；账务；添置；维修。</div>\n    <div><span class=\"blue\">原则：</span>物尽其用；建章立制；帐物相符；管理育人。</div>\n  </section>\n\n  <div class=\"branch-label finance-label\">财务<br>管理</div>\n  <div class=\"brace finance-brace\" aria-hidden=\"true\"></div>\n\n  <div class=\"content finance-meaning\">\n    <span class=\"blue\">含义：</span>指学校资金运转中的计划组织和控制。\n  </div>\n\n  <div class=\"branch-label finance-content-label\">内容</div>\n  <div class=\"brace finance-content-brace\" aria-hidden=\"true\"></div>\n\n  <section class=\"content finance-details\">\n    <div><span class=\"blue\">预算管理：</span>按一定程序和方法核定的年度收</div>\n    <div>支预计；</div>\n    <div><span class=\"blue\">收入管理：</span>对学校收入的计划组织和控制，</div>\n    <div>包括财政收入、经营收入、学杂费等收入；</div>\n    <div><span class=\"blue\">支出管理：</span>经费支出的计划组织和控制；</div>\n    <div><span class=\"blue\">资金管理：</span>现金、银行存款、往来管理；</div>\n    <div><span class=\"blue\">财务报表：</span>收支、因素、结果分析；</div>\n    <div><span class=\"blue\">财务制度和财务监督：</span>财务人员要求：持证</div>\n    <div>上岗、坚持原则、作风正派、履行职责；财</div>\n    <div>务监督通过财务审计执行。</div>\n  </section>\n\n  <div class=\"chapter-title chapter-ten\">第十章　学校德育管理</div>\n\n  <div class=\"branch-label position-label\">地位<br>与<br>特点</div>\n  <div class=\"brace position-brace\" aria-hidden=\"true\"></div>\n\n  <section class=\"content position-content\">\n    <div><span class=\"blue\">含义：</span>德育即思想品德教育（育德），包括政治教育、思想教</div>\n    <div>育、品德教育、法纪教育、心理教育。<span class=\"blue\">德育管理：</span>即</div>\n    <div>德育管理者运用方法手段，管理德育。</div>\n    <div><span class=\"blue\">地位（学校管理与德育的关系）：</span>学校管理包含德育管理；相</div>\n    <div>互影响；相互渗透；相互促进。</div>\n    <div><span class=\"blue\">特点：</span>方向性；教育性；伦理性；全员性。</div>\n  </section>\n\n  <div class=\"branch-label elements-label\">要素<br>与<br>层次</div>\n  <div class=\"brace elements-brace\" aria-hidden=\"true\"></div>\n\n  <div class=\"branch-label elements-inner-label\">要素</div>\n  <div class=\"brace elements-inner-brace\" aria-hidden=\"true\"></div>\n\n  <section class=\"content elements-content\">\n    <div><span class=\"blue\">德育管理目标：</span>具有定向、调节、评价作用；</div>\n    <div><span class=\"blue\">德育管理主体：</span>组织机构；管理者；自我管理；</div>\n    <div><span class=\"blue\">德育管理客体：</span>人、财、物、课程、时空等资源；</div>\n    <div><span class=\"blue\">德育管理制度：</span>中央到地方文件，学校与班级的规章；</div>\n  </section>\n\n  <div class=\"branch-label level-label\">层次：</div>\n  <section class=\"content level-content\">\n    <div>学校上层是核心定方向；学校中层是枢纽抓落实；学校基</div>\n    <div>层及班级是基本单位执行者。</div>\n  </section>\n\n  <div class=\"branch-label mechanism-label\">机制<br>与<br>实施</div>\n  <div class=\"brace mechanism-brace\" aria-hidden=\"true\"></div>\n\n  <div class=\"branch-label mechanism-word\">机制：</div>\n  <section class=\"content mechanism-content\">\n    <div>德育要素进行相互作用、耦合、联系的运作方式。</div>\n  </section>\n\n  <div class=\"branch-label implementation-word\">实施</div>\n  <div class=\"brace implementation-brace\" aria-hidden=\"true\"></div>\n\n  <section class=\"content implementation-content\">\n    <div><span class=\"blue\">导向机制：</span>目标、舆论、行为、评价等导向；</div>\n    <div><span class=\"blue\">动力机制：</span>奖惩、竞争、意义或价值等激励；</div>\n    <div><span class=\"blue\">协调机制：</span>制度、文化协调；</div>\n    <div><span class=\"blue\">约束机制：</span>法规、道德约束；</div>\n  </section>\n\n  <section class=\"content bottom-note\">\n    <div><span class=\"blue\">提高德育管理者能力的途径：</span>（1）提升管理水平（理念、方法、</div>\n    <div>道德）；（2）提高教育素养（教育观、教育理论）；（3）加强道德</div>\n    <div>修养（把握方向、管理公正、以身作则、作风民主）</div>\n  </section>\n</main>\n</body>\n</html>"
