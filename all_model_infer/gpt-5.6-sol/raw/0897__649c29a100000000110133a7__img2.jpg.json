        "content": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>切腹の間とは？</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] },\n  svg: { fontCache: 'global' }\n};\n</script>\n<script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js\"></script>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;background:#fff}\nbody{\n  font-family:\"Yu Gothic\",\"Hiragino Kaku Gothic ProN\",\"Noto Sans JP\",Meiryo,sans-serif;\n  color:#171717;\n}\n.page{\n  position:relative;\n  width:540px;\n  height:540px;\n  margin:0 auto;\n  overflow:hidden;\n  background:#fff;\n}\n.sr-only{\n  position:absolute;\n  width:1px;\n  height:1px;\n  padding:0;\n  margin:-1px;\n  overflow:hidden;\n  clip:rect(0,0,0,0);\n  white-space:nowrap;\n  border:0;\n}\n.header{\n  position:absolute;\n  left:23px;\n  top:16px;\n  width:494px;\n  height:65px;\n  white-space:nowrap;\n}\n.title{\n  display:flex;\n  align-items:flex-end;\n  height:64px;\n  font-weight:900;\n  letter-spacing:-3px;\n}\n.title .coral{\n  display:inline-block;\n  color:#e87d88;\n  font-size:49px;\n  line-height:1;\n  -webkit-text-stroke:1.6px #202020;\n  paint-order:stroke fill;\n  text-shadow:1px 2px 0 rgba(0,0,0,.14);\n}\n.title .small-no{\n  font-size:29px;\n  margin:0 7px 5px 5px;\n  letter-spacing:-1px;\n}\n.title .blue{\n  display:inline-block;\n  margin-left:7px;\n  color:#68d4ed;\n  font-size:48px;\n  line-height:1;\n  letter-spacing:-5px;\n  text-shadow:1px 1px 0 rgba(70,174,197,.15);\n}\n.credit{\n  position:absolute;\n  right:2px;\n  bottom:8px;\n  font-size:15px;\n  font-weight:700;\n  letter-spacing:-1px;\n}\n.intro{\n  position:absolute;\n  left:25px;\n  top:87px;\n  width:492px;\n  font-size:12.6px;\n  line-height:20px;\n  letter-spacing:-.35px;\n  white-space:nowrap;\n}\n.intro .line{height:20px}\n.badge-inline{\n  display:inline-flex;\n  width:20px;\n  height:20px;\n  margin:0 2px;\n  border-radius:50%;\n  align-items:center;\n  justify-content:center;\n  vertical-align:-4px;\n  color:#fff;\n  background:#9997ed;\n  font-size:16px;\n  font-weight:900;\n  line-height:20px;\n}\n.diagrams{\n  position:absolute;\n  left:27px;\n  top:188px;\n  width:483px;\n  height:168px;\n}\n.placeholder{margin:0}\n.top-diagram{\n  position:absolute;\n  inset:0;\n  width:483px;\n  height:168px;\n}\n.lower{\n  position:absolute;\n  left:25px;\n  top:374px;\n  width:295px;\n  font-size:12.8px;\n  line-height:20px;\n  letter-spacing:-.45px;\n  white-space:nowrap;\n}\n.lower .line{height:20px}\n.floor-plan{\n  position:absolute;\n  left:329px;\n  top:362px;\n  width:181px;\n  height:148px;\n}\nsvg text{\n  font-family:\"Yu Gothic\",\"Hiragino Kaku Gothic ProN\",\"Noto Sans JP\",Meiryo,sans-serif;\n}\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <header class=\"header\">\n    <div class=\"title\" aria-label=\"切腹の間とは？\">\n      <span class=\"coral\" style=\"transform:rotate(-7deg)\">切</span>\n      <span class=\"coral\" style=\"transform:rotate(-3deg)\">腹</span>\n      <span class=\"coral small-no\">の</span>\n      <span class=\"coral\" style=\"transform:rotate(-8deg)\">間</span>\n      <span class=\"blue\">とは？</span>\n    </div>\n    <div class=\"credit\">©甚助[?]</div>\n  </header>\n\n  <section class=\"intro\">\n    <div class=\"line\">四畳半の畳の敷き方について、たまに「切腹の間」という話を聞きます。多くの場合は <span class=\"badge-inline\">①</span> のよう</div>\n    <div class=\"line\">な敷き方については縁起が悪いので避けるべきだということのようですが、調べてみてもきちん</div>\n    <div class=\"line\">とした出典がなく（いくつかの工務店等のウェブサイトに中途半端な言及がある程度）、内容も</div>\n    <div class=\"line\">地方によってまちまちなもので、気にする必要はあまり無さそうです。どうしても気になるようであ</div>\n    <div class=\"line\">れば、<span class=\"badge-inline\">③</span>についてはなるべく避けるようにする、ぐらいで大丈夫だと思います。</div>\n  </section>\n\n  <section class=\"diagrams\">\n    <figure class=\"placeholder top-diagram\">\n      <figcaption class=\"sr-only\">[Diagram: three four-and-a-half-tatami layouts centered beneath the introductory text]</figcaption>\n      <svg viewBox=\"0 0 483 168\" width=\"483\" height=\"168\" role=\"img\" aria-label=\"三つの四畳半の畳配置図\">\n        <defs>\n          <linearGradient id=\"tatami\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0\" stop-color=\"#c8e8a4\"/>\n            <stop offset=\".55\" stop-color=\"#bfe19a\"/>\n            <stop offset=\"1\" stop-color=\"#aed582\"/>\n          </linearGradient>\n          <pattern id=\"grain\" width=\"5\" height=\"5\" patternUnits=\"userSpaceOnUse\">\n            <path d=\"M0 4.5H5\" stroke=\"#d7edbb\" stroke-width=\".45\" opacity=\".5\"/>\n          </pattern>\n          <filter id=\"shadow\" x=\"-10%\" y=\"-10%\" width=\"120%\" height=\"125%\">\n            <feDropShadow dx=\"1\" dy=\"2\" stdDeviation=\"1\" flood-color=\"#777\" flood-opacity=\".35\"/>\n          </filter>\n        </defs>\n\n        <!-- Number labels -->\n        <circle cx=\"18\" cy=\"16\" r=\"13\" fill=\"#9896ee\"/>\n        <text x=\"18\" y=\"22\" fill=\"#fff\" font-size=\"21\" font-weight=\"900\" text-anchor=\"middle\">①</text>\n        <circle cx=\"186\" cy=\"16\" r=\"13\" fill=\"#9896ee\"/>\n        <text x=\"186\" y=\"22\" fill=\"#fff\" font-size=\"21\" font-weight=\"900\" text-anchor=\"middle\">②</text>\n        <circle cx=\"354\" cy=\"16\" r=\"13\" fill=\"#9896ee\"/>\n        <text x=\"354\" y=\"22\" fill=\"#fff\" font-size=\"21\" font-weight=\"900\" text-anchor=\"middle\">③</text>\n\n        <!-- Layout 1 -->\n        <g transform=\"translate(2 25)\" filter=\"url(#shadow)\" stroke=\"#161616\" stroke-width=\"2.7\" stroke-linejoin=\"round\">\n          <rect x=\"0\" y=\"0\" width=\"145\" height=\"142\" fill=\"url(#tatami)\"/>\n          <rect x=\"0\" y=\"0\" width=\"96\" height=\"49\" fill=\"url(#grain)\"/>\n          <rect x=\"0\" y=\"49\" width=\"96\" height=\"47\" fill=\"url(#grain)\"/>\n          <rect x=\"96\" y=\"0\" width=\"49\" height=\"96\" fill=\"url(#grain)\"/>\n          <rect x=\"0\" y=\"96\" width=\"49\" height=\"46\" fill=\"url(#grain)\"/>\n          <rect x=\"49\" y=\"96\" width=\"96\" height=\"46\" fill=\"url(#grain)\"/>\n        </g>\n\n        <!-- Red annotation over layout 1 -->\n        <path d=\"M139 41c-10 2-17-6-17-16 0-12 9-21 20-21 12 0 20 8 20 19 0 8-3 14-10 19\"\n              fill=\"none\" stroke=\"#dc777b\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n        <path d=\"M142 42l9-7\" fill=\"none\" stroke=\"#dc777b\" stroke-width=\"2.3\" stroke-linecap=\"round\"/>\n\n        <!-- Layout 2 -->\n        <g transform=\"translate(170 25)\" filter=\"url(#shadow)\" stroke=\"#161616\" stroke-width=\"2.7\" stroke-linejoin=\"round\">\n          <rect x=\"0\" y=\"0\" width=\"145\" height=\"142\" fill=\"url(#tatami)\"/>\n          <rect x=\"0\" y=\"0\" width=\"47\" height=\"96\" fill=\"url(#grain)\"/>\n          <rect x=\"47\" y=\"0\" width=\"98\" height=\"49\" fill=\"url(#grain)\"/>\n          <rect x=\"47\" y=\"49\" width=\"50\" height=\"47\" fill=\"url(#grain)\"/>\n          <rect x=\"97\" y=\"49\" width=\"48\" height=\"93\" fill=\"url(#grain)\"/>\n          <rect x=\"0\" y=\"96\" width=\"97\" height=\"46\" fill=\"url(#grain)\"/>\n        </g>\n\n        <!-- Red annotation over layout 2 -->\n        <path d=\"M307 40c-10 3-17-4-17-15 0-13 9-22 21-23 11 0 19 8 19 19 0 9-5 17-12 21\"\n              fill=\"none\" stroke=\"#dc777b\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n\n        <!-- Layout 3 -->\n        <g transform=\"translate(337 25)\" filter=\"url(#shadow)\" stroke=\"#161616\" stroke-width=\"2.7\" stroke-linejoin=\"round\">\n          <rect x=\"0\" y=\"0\" width=\"144\" height=\"142\" fill=\"url(#tatami)\"/>\n          <rect x=\"0\" y=\"0\" width=\"97\" height=\"49\" fill=\"url(#grain)\"/>\n          <rect x=\"97\" y=\"0\" width=\"47\" height=\"96\" fill=\"url(#grain)\"/>\n          <rect x=\"0\" y=\"49\" width=\"49\" height=\"47\" fill=\"url(#grain)\"/>\n          <rect x=\"49\" y=\"49\" width=\"48\" height=\"47\" fill=\"url(#grain)\"/>\n          <rect x=\"0\" y=\"96\" width=\"144\" height=\"46\" fill=\"url(#grain)\"/>\n        </g>\n\n        <!-- Red triangle and question mark -->\n        <path d=\"M452 36l9-34 26 31z\" fill=\"none\" stroke=\"#dc777b\" stroke-width=\"2.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        <text x=\"473\" y=\"16\" fill=\"#dc777b\" font-size=\"31\" font-weight=\"500\">?</text>\n      </svg>\n    </figure>\n  </section>\n\n  <section class=\"lower\">\n    <div class=\"line\">むしろ和室では、<strong>床の間に対して畳の長辺が平行</strong>になる</div>\n    <div class=\"line\">ことや、<strong>出入り口に対して畳の目が垂直</strong>になることが重</div>\n    <div class=\"line\">要です。さらに茶室や掘り炬燵のある和室では中央に半</div>\n    <div class=\"line\">畳の畳が来るので、右図のような間取りでは <span class=\"badge-inline\">③</span> のよう</div>\n    <div class=\"line\">な敷き方になることも多いようです。ただこれらも「<strong>でき</strong></div>\n    <div class=\"line\"><strong>れば守る</strong>」程度の決まり事で、<strong>場合によって変わってくる</strong></div>\n    <div class=\"line\">ので、<strong>あまり拘りすぎない</strong>のが良いと思います。</div>\n  </section>\n\n  <figure class=\"placeholder floor-plan\">\n    <figcaption class=\"sr-only\">[Diagram: bottom-right floor plan showing the entrance, tatami direction, sunken kotatsu, and tokonoma]</figcaption>\n    <svg viewBox=\"0 0 181 148\" width=\"181\" height=\"148\" role=\"img\" aria-label=\"和室の間取り図\">\n      <defs>\n        <linearGradient id=\"roomTatami\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n          <stop offset=\"0\" stop-color=\"#caeca7\"/>\n          <stop offset=\"1\" stop-color=\"#b5dd8a\"/>\n        </linearGradient>\n        <linearGradient id=\"tokonoma\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n          <stop offset=\"0\" stop-color=\"#edc6a5\"/>\n          <stop offset=\"1\" stop-color=\"#dfa982\"/>\n        </linearGradient>\n        <filter id=\"planShadow\" x=\"-10%\" y=\"-10%\" width=\"125%\" height=\"125%\">\n          <feDropShadow dx=\"1.5\" dy=\"2\" stdDeviation=\"1.2\" flood-color=\"#666\" flood-opacity=\".4\"/>\n        </filter>\n      </defs>\n\n      <!-- Entrance label -->\n      <path d=\"M38 15c8-3 15-3 22-2M59 13l-4-4m4 4l-5 3\" fill=\"none\" stroke=\"#161616\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n      <text x=\"40\" y=\"13\" font-size=\"14\" font-weight=\"700\" transform=\"rotate(-4 40 13)\">出入口</text>\n\n      <!-- Floor plan -->\n      <g transform=\"translate(4 17)\" filter=\"url(#planShadow)\" stroke=\"#171717\" stroke-width=\"2.5\" stroke-linejoin=\"round\">\n        <rect x=\"0\" y=\"0\" width=\"130\" height=\"128\" fill=\"url(#roomTatami)\"/>\n        <rect x=\"130\" y=\"0\" width=\"47\" height=\"70\" fill=\"url(#tokonoma)\"/>\n\n        <!-- Room divisions -->\n        <path d=\"M40 0v128M0 42h130M80 42v43M40 85h90\" fill=\"none\"/>\n        <rect x=\"40\" y=\"42\" width=\"40\" height=\"43\" fill=\"#c4e79e\"/>\n        <path d=\"M130 0v70M130 70h47\" fill=\"none\"/>\n\n        <!-- Slight hand-drawn outer irregularity -->\n        <path d=\"M-2 2l2-4h50M82-1h47l3 3M-1 126l3 3h45M82 129h48\" fill=\"none\" stroke=\"#222\" stroke-width=\"1.5\"/>\n\n        <!-- Sunken kotatsu label -->\n        <text x=\"60\" y=\"65\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"800\">掘</text>\n        <text x=\"60\" y=\"79\" text-anchor=\"middle\" font-size=\"11\" font-weight=\"800\">ゴタツ</text>\n\n        <!-- Tokonoma label -->\n        <text x=\"153\" y=\"20\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"800\">\n          <tspan x=\"153\" dy=\"0\">床</tspan>\n          <tspan x=\"153\" dy=\"18\">の</tspan>\n          <tspan x=\"153\" dy=\"18\">間</tspan>\n        </text>\n      </g>\n\n      <!-- Red direction notes -->\n      <g fill=\"none\" stroke=\"#df7b72\" stroke-width=\"2\" stroke-linecap=\"round\">\n        <path d=\"M17 29v22m0 0l-4-6m4 6l4-6\"/>\n        <path d=\"M27 29v22m0 0l-4-6m4 6l4-6\"/>\n        <path d=\"M37 29v22m0 0l-4-6m4 6l4-6\"/>\n        <path d=\"M126 49v49m0 0l-4-7m4 7l4-7\"/>\n      </g>\n      <text x=\"43\" y=\"49\" fill=\"#df7b72\" fo