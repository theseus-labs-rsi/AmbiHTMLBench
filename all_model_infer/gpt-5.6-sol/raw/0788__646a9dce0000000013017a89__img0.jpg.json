5px;\n      margin: 0 auto 9px;\n      padding: 4px 12px 5px;\n      color: #fff;\n      background: #b9471a;\n      border-radius: 24px;\n      font-size: 25px;\n      font-weight: 700;\n      line-height: 1.15;\n      text-align: center;\n      box-shadow: 0 1px 0 rgba(117, 50, 16, 0.45) inset;\n    }\n\n    .subtitle::before,\n    .subtitle::after {\n      content: \"•\";\n      margin: 0 8px;\n      font-size: 16px;\n      vertical-align: 3px;\n    }\n\n    .poems {\n      display: flex;\n      flex-direction: column;\n    }\n\n    .row {\n      display: grid;\n      align-items: stretch;\n      border-bottom: 2px dashed rgba(215, 218, 197, 0.58);\n    }\n\n    .row:last-child {\n      border-bottom: 0;\n    }\n\n    .row.two {\n      grid-template-columns: repeat(2, 1fr);\n    }\n\n    .row.three {\n      grid-template-columns: repeat(3, 1fr);\n    }\n\n    .poem {\n      min-width: 0;\n      padding: 8px 9px 10px;\n      text-align: center;\n    }\n\n    .row .poem + .poem {\n      border-left: 2px dashed rgba(215, 218, 197, 0.58);\n    }\n\n    .poem-title {\n      margin: 0 0 3px;\n      color: #a2442e;\n      font-size: 20px;\n      font-weight: 700;\n      line-height: 1.35;\n      white-space: nowrap;\n    }\n\n    .author {\n      margin: 0 0 3px;\n      color: #555;\n      font-size: 17px;\n      line-height: 1.35;\n    }\n\n    .verse {\n      margin: 0;\n      font-size: 17px;\n      font-weight: 600;\n      line-height: 1.6;\n      white-space: nowrap;\n    }\n\n    @media (max-width: 470px) {\n      .page {\n        min-height: 100vh;\n        border-width: 5px;\n        padding-left: 6px;\n        padding-right: 6px;\n      }\n\n      .title {\n        font-size: 8vw;\n      }\n\n      .subtitle {\n        width: 45vw;\n        font-size: 5vw;\n      }\n\n      .poem {\n        padding-left: 4px;\n        padding-right: 4px;\n      }\n\n      .poem-title {\n        font-size: 3.7vw;\n      }\n\n      .author,\n      .verse {\n        font-size: 3.2vw;\n      }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <h1 class=\"title\">小学生1-6年级必背古诗</h1>\n    <div class=\"subtitle\">一年级·下册</div>\n\n    <section class=\"poems\">\n      <div class=\"row two\">\n        <article class=\"poem\">\n          <h2 class=\"poem-title\">《春晓》</h2>\n          <p class=\"author\">【唐】孟浩然</p>\n          <p class=\"verse\">春眠不觉晓，<br>处处闻啼鸟。<br>夜来风雨声，<br>花落知多少。</p>\n        </article>\n\n        <article class=\"poem\">\n          <h2 class=\"poem-title\">《赠汪伦》</h2>\n          <p class=\"author\">【唐】李白</p>\n          <p class=\"verse\">李白乘舟将欲行，<br>忽闻岸上踏歌声。<br>桃花潭水深千尺，<br>不及汪伦送我情。</p>\n        </article>\n      </div>\n\n      <div class=\"row three\">\n        <article class=\"poem\">\n          <h2 class=\"poem-title\">《静夜思》</h2>\n          <p class=\"author\">【唐】李白</p>\n          <p class=\"verse\">床前明月光，<br>疑是地上霜。<br>举头望明月，<br>低头思故乡。</p>\n        </article>\n\n        <article class=\"poem\">\n          <h2 class=\"poem-title\">《寻隐者不遇》</h2>\n          <p class=\"author\">【唐】贾岛</p>\n          <p class=\"verse\">松下问童子，<br>言师采药去。<br>只在此山中，<br>云深不知处。</p>\n        </article>\n\n        <article class=\"poem\">\n          <h2 class=\"poem-title\">《池上》</h2>\n          <p class=\"author\">【唐】白居易</p>\n          <p class=\"verse\">小娃撑小艇，<br>偷采白莲回。<br>不解藏踪迹，<br>浮萍一道开。</p>\n        </article>\n      </div>\n\n      <div class=\"row two\">\n        <article class=\"poem\">\n          <h2 class=\"poem-title\">《小池》</h2>\n          <p class=\"author\">【宋】杨万里</p>\n          <p class=\"verse\">泉眼无声惜细流，<br>树阴照水爱晴柔。<br>小荷才露尖尖角，<br>早有蜻蜓立上头。</p>\n        </article>\n\n        <article class=\"poem\">\n          <h2 class=\"poem-title\">《画鸡》</h2>\n          <p class=\"author\">【明】唐寅</p>\n          <p class=\"verse\">头上红冠不用裁，<br>满身雪白走将来。<br>平生不敢轻言语，<br>一叫千门万户开。</p>\n        </article>\n      </div>\n    </section>\n  </main>\n</body>\n</html>"
