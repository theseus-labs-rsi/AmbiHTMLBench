        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Detect and Treat Postpartum Haemorrhage Early</title>\n  <script>\n    window.MathJax = {\n      tex: {\n        inlineMath: [['$', '$']],\n        displayMath: [['$$', '$$']]\n      }\n    };\n  </script>\n  <script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    :root {\n      --background: #def3f3;\n      --sidebar: #d0eeee;\n      --purple: #58298a;\n      --blue: #1264a3;\n      --turquoise: #67c8c9;\n      --white: #fff;\n      --pink: #f14e70;\n      --orange: #ffae18;\n      --body-font: Arial, Helvetica, sans-serif;\n    }\n\n    * {\n      box-sizing: border-box;\n    }\n\n    html,\n    body {\n      margin: 0;\n      min-width: 1180px;\n      min-height: 100%;\n      background: var(--background);\n      font-family: var(--body-font);\n      color: var(--blue);\n    }\n\n    body {\n      overflow-x: auto;\n    }\n\n    .poster {\n      position: relative;\n      width: 1600px;\n      height: 1132px;\n      margin: 0 auto;\n      overflow: hidden;\n      background: var(--background);\n    }\n\n    .sidebar {\n      position: absolute;\n      inset: 0 auto 0 0;\n      z-index: 1;\n      width: 306px;\n      padding: 78px 36px 30px 52px;\n      background: var(--sidebar);\n    }\n\n    .heading {\n      position: absolute;\n      top: 78px;\n      left: 53px;\n      z-index: 6;\n      display: flex;\n      align-items: center;\n      gap: 13px;\n      white-space: nowrap;\n      color: var(--purple);\n    }\n\n    .heading .boxed {\n      padding: 6px 20px 7px;\n      border: 1.5px solid var(--blue);\n      border-radius: 23px;\n      background: #fff;\n      font-size: 45px;\n      font-weight: 700;\n      line-height: 1.1;\n    }\n\n    .heading .and {\n      font-size: 23px;\n      font-weight: 400;\n      letter-spacing: 1p