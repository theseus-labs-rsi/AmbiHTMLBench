nt-weight: 700;\n    }\n\n    .strategy-icon {\n      position: relative;\n      width: 68px;\n      height: 72px;\n      color: var(--blue);\n    }\n\n    .newsletter {\n      width: 55px;\n      height: 75px;\n      border: 2px solid var(--blue);\n      border-radius: 6px;\n      background:\n        repeating-linear-gradient(to bottom, transparent 0 8px, var(--blue) 8px 10px) 9px 15px / 30px 40px no-repeat,\n        #bce4df;\n    }\n\n    .newsletter::after {\n      position: absolute;\n      top: 0;\n      right: 0;\n      width: 18px;\n      height: 18px;\n      border-left: 2px solid var(--blue);\n      border-bottom: 2px solid var(--blue);\n      content: \"\";\n      background: #fff;\n      clip-path: polygon(0 0, 100% 100%, 0 100%);\n    }\n\n    .trolley {\n      width: 80px;\n      height: 48px;\n      border: 2px solid var(--blue);\n      border-radius: 5px;\n      background:\n        linear-gradient(to right,\n          #bb8fbc 0 16%,\n          var(--blue) 16% 19%,\n          #bb8fbc 19% 71%,\n          var(--blue) 71% 74%,\n          #bb8fbc 74%);\n    }\n\n    .trolley::before {\n      position: absolute;\n      top: -11px;\n      left: 27px;\n      width: 23px;\n      height: 10px;\n      border: 2px solid var(--blue);\n      border-bottom: 0;\n      border-radius: 4px 4px 0 0;\n      content: \"\";\n      background: #fff;\n    }\n\n    .trophy {\n      width: 44px;\n      height: 58px;\n      margin-left: 6px;\n      border: 2px solid var(--blue);\n      background: var(--orange);\n      clip-path: polygon(0 0, 100% 0, 96% 56%, 66% 75%, 66% 88%, 85% 88%, 85% 100%, 15% 100%, 15% 88%, 34% 88%, 34% 75%, 4% 56%);\n    }\n\n    .trophy::before,\n    .trophy::after {\n      position: absolute;\n      top: 3px;\n      width: 20px;\n      height: 28px;\n      border: 2px solid var(--blue);\n      content: \"\";\n      background: transparent;\n    }\n\n    .trophy::before {\n      left: -13px;\n      border-radius: 4px 0 15px 8px;\n    }\n\n    .trophy::after {\n      right: 4px;\n      border-radius: 0 4px 8px 15px;\n    }\n\n    .training {\n      width: 76px;\n      height: 57px;\n      border: 2px solid var(--blue);\n      background: #a9dcd6;\n    }\n\n    .training::before {\n      position: absolute;\n      top: -9px;\n      left: -4px;\n      width: 76px;\n      height: 7px;\n      border: 2px solid var(--blue);\n      content: \"\";\n      background: #a9dcd6;\n    }\n\n    .training::after {\n      position: absolute;\n      top: 21px;\n      left: 13px;\n      width: 48px;\n      height: 25px;\n      content: \"\";\n      background:\n        linear-gradient(135deg, transparent 0 47%, var(--blue) 48% 51%, transparent 52%) 0 0 / 24px 25px,\n        linear-gradient(45deg, transparent 0 47%, var(--blue) 48% 51%, transparent 52%) 24px 0 / 24px 25px;\n    }\n\n    @media (max-width: 1599px) {\n      .poster {\n        transform-origin: top left;\n      }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"poster\">\n    <aside class=\"sidebar\" aria-label=\"Early detection and trigger criteria\"></aside>\n\n    <header class=\"heading\">\n      <span class=\"boxed\">DETECT</span>\n      <span class=\"and\">AND</span>\n      <span class=\"boxed\">TREAT</span>\n      <span class=\"title-rest\">POSTPARTUM HAEMORRHAGE EARLY</span>\n    </header>\n\n    <div class=\"cloud cloud-top\" aria-hidden=\"true\"></div>\n    <div class=\"cloud cloud-bottom\" aria-hidden=\"true\"></div>\n    <div class=\"ribbon\" aria-hidden=\"true\"></div>\n\n    <div class=\"step-letter letter-e-left\">E</div>\n    <div class=\"step-letter letter-m\">M</div>\n    <div class=\"step-letter letter-o\">O</div>\n    <div class=\"step-letter letter-t\">T</div>\n    <div class=\"step-letter letter-iv\">IV</div>\n    <div class=\"step-letter letter-e-right\">E</div>\n\n    <div class=\"placeholder icon-drape\" role=\"img\" aria-label=\"Illustration of calibrated blood-loss collection drape\">\n      <div class=\"drape-shape\"></div>\n      <span class=\"caption\">[Illustration: calibrated drape]</span>\n    </div>\n\n    <div class=\"placeholder icon-massage\" role=\"img\" aria-label=\"Illustration of uterine massage\">\n      <span class=\"caption\">[Illustration: massage of uterus]</span>\n    </div>\n\n    <div class=\"placeholder icon-drug\" role=\"img\" aria-label=\"Illustration of oxytocic drug syringe\">\n      <div class=\"syringe\"></div>\n      <span class=\"caption\">[Illustration: oxytocic drug syringe]</span>\n    </div>\n\n    <div class=\"placeholder icon-txa\" role=\"img\" aria-label=\"Illustration of tranexamic acid syringe\">\n      <div class=\"syringe\"></div>\n      <span class=\"caption\">[Illustration: tranexamic acid syringe]</span>\n    </div>\n\n    <div class=\"placeholder icon-iv\" role=\"img\" aria-label=\"Illustration of IV fluids\">\n      <div class=\"iv-bag\"></div>\n      <div class=\"iv-tube\"></div>\n      <span class=\"caption\">[Illustration: IV fluids]</span>\n    </div>\n\n    <div class=\"placeholder icon-exam\" role=\"img\" aria-label=\"Illustration of examination\">\n      <div class=\"magnifier\"></div>\n      <span class=\"caption\">[Illustration: examination]</span>\n    </div>\n\n    <section class=\"early\">\n      <div class=\"section-title\">\n        <span><strong>Early</strong> detection<br>and trigger criteria</span>\n      </div>\n      <div class=\"section-body\">\n        <ul>\n          <li>Calibrated drape for blood loss collection with trigger lines at <mark>300ml and 500ml</mark> for the first hour after birth</li>\n          <li>Observations (blood loss, blood flow, uterine tone) every <mark>15 minutes</mark> documented on the blood loss monitoring chart</li>\n          <li>Blood pressure and pulse carried out once in the <mark>1st hour</mark> postpartum and documented on the blood loss monitoring chart</li>\n        </ul>\n      </div>\n    </section>\n\n    <section class=\"trigger\">\n      <h3>Trigger criteria</h3>\n      <p><b>1</b> Clinical judgement</p>\n      <p><b>2</b> Blood loss 500ml or more</p>\n      <p><b>3</b> Blood loss 300ml or more<br>&nbsp;&nbsp;&nbsp;plus one abnormal<br>&nbsp;&nbsp;&nbsp;observation</p>\n    </section>\n\n    <div class=\"logos\" aria-label=\"World Health Organization and HRP logos\">\n      <div class=\"who-mark\">\n        <span class=\"who-symbol\">WHO</span>\n        <span>World Health<br>Organization</span>\n      </div>\n      <div class=\"hrp\">\n        human<br>reproduction<br>programme\n        <strong>hrp</strong>\n        research for impact\n      </div>\n    </div>\n\n    <section class=\"content-section massage\">\n      <div class=\"section-title\"><strong>Massage</strong>&nbsp;of uterus</div>\n      <div class=\"section-body\">\n        <ul>\n          <li>Massage until uterus has contracted or<br>for <mark>one minute</mark></li>\n        </ul>\n      </div>\n    </section>\n\n    <section class=\"content-section oxytocic\">\n      <div class=\"section-title\"><strong>Oxytocic</strong>&nbsp;drugs</div>\n      <div class=\"section-body\">\n        <ul>\n          <li><mark>10 IU IV oxytocin injection</mark> or diluted in <mark>200-500ml crystalloid</mark> over <mark>10 minutes</mark> plus a maintenance dose for <mark>20 IU IV oxytocin</mark> diluted in <mark>1000ml saline</mark> over <mark>4 hours</mark> (+-misoprostol 800mcg PR/SL if used)</li>\n        </ul>\n      </div>\n    </section>\n\n    <section class=\"content-section tranexamic\">\n      <div class=\"section-title\"><strong>Tranexamic</strong>&nbsp;acid</div>\n      <div class=\"section-body\">\n        <ul>\n          <li><mark>1g IV injection of tranexamic acid</mark> or diluted in <mark>20ml crystalloid</mark> over <mark>10 minutes</mark></li>\n        </ul>\n      </div>\n    </section>\n\n    <section class=\"content-section fluids\">\n      <div class=\"section-title\"><strong>IV</strong>&nbsp;fluids</div>\n      <div class=\"section-body\">\n        <ul>\n          <li>IV fluids in addition to the infusion should be given if clinically indicated for resuscitation and will require a <mark>2nd IV access</mark></li>\n        </ul>\n      </div>\n    </section>\n\n    <section class=\"content-section examination\">\n      <div class=\"section-title\">\n        <span><strong>Examination</strong><br>and escalation</span>\n      </div>\n      <div class=\"section-body\">\n        <ul>\n          <li>Ensure bladder is empty, evacuate clots, check for tears with an internal examination and placenta for completeness</li>\n          <li>Escalate if bleeding does not stop after first response or you are unable to identify or manage cause of bleeding</li>\n        </ul>\n      </div>\n    </section>\n\n    <section class=\"implementation\">\n      <h2>Implementation strategies</h2>\n      <div class=\"strategies\">\n        <div class=\"strategy-icon newsletter placeholder\" role=\"img\" aria-label=\"Newsletter illustration\">\n          <span class=\"caption\">[Illustration: audit newsletter]</span>\n        </div>\n        <p class=\"strategy-text\"><strong>Audit newsletters:</strong> sharing with all staff monthly detection and bundle use rates along with PPH, severe PPH, blood transfusion, laparotomy and death from PPH rates and given feedback at monthly departmental meetings</p>\n\n        <div class=\"strategy-icon trolley placeholder\" role=\"img\" aria-label=\"Trolley or carry case illustration\">\n          <span class=\"caption\">[Illustration: trolley or carry case]</span>\n        </div>\n        <p class=\"strategy-text\"><strong>Trolley and/or carry case:</strong> including all medicines and devices required for the treatment of PPH restocked after every use and complete a stocking checklist at the start of every shift</p>\n\n        <div class=\"strategy-icon trophy placeholder\" role=\"img\" aria-label=\"Champions trophy illustration\">\n          <span class=\"caption\">[Illustration: champions trophy]</span>\n        </div>\n        <p class=\"strategy-text\"><strong>Champions:</strong> midwife and doctor to oversee change, troubleshoot, give feedback on audit newsletters, connect with other champions through chats, meeting and websites for sharing knowledge and lessons learnt</p>\n\n        <div class=\"strategy-icon training placeholder\" role=\"img\" aria-label=\"Training flipchart illustration\">\n          <span class=\"caption\">[Illustration: training flipchart]</span>\n        </div>\n        <p class=\"strategy-text\"><strong>Training:</strong> on-site, simulation-based, and peer-assisted training of 90 minutes to a whole day facilitated by the use of provider guides, flipcharts and job aids displayed in labour wards</p>\n      </div>\n    </section>\n  </main>\n</body>\n</html>"
