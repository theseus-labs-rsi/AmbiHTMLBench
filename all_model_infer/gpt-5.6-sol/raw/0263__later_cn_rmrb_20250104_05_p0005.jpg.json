ar-gradient(90deg,transparent 34%,#838e93 35% 65%,transparent 66%),\n    linear-gradient(145deg,#d9e3e6,#53646c);\n}\n.card h3{\n  margin:2px 0 5px;\n  font-family:\"Microsoft YaHei\",\"SimHei\",sans-serif;\n  font-size:10px;\n  line-height:1.3;\n  text-align:center;\n  white-space:nowrap;\n}\n.card p{margin:0;text-indent:2em}\n.right-column{\n  min-width:0;\n  height:100%;\n}\n.right-main{\n  position:relative;\n  height:802px;\n  padding-top:25px;\n  overflow:hidden;\n}\n.right-label{\n  position:absolute;\n  top:4px;\n  left:3px;\n  color:#b11828;\n  font-family:\"Microsoft YaHei\",\"SimHei\",sans-serif;\n  font-size:12px;\n  font-weight:bold;\n}\n.vertical-title{\n  position:absolute;\n  top:106px;\n  right:5px;\n  height:230px;\n  writing-mode:vertical-rl;\n  text-orientation:upright;\n  font-family:\"Microsoft YaHei\",\"SimHei\",sans-serif;\n  font-size:22px;\n  letter-spacing:4px;\n  font-weight:500;\n}\n.vertical-author{\n  position:absolute;\n  top:185px;\n  right:42px;\n  writing-mode:vertical-rl;\n  font-size:6px;\n  letter-spacing:2px;\n}\n.right-copy{\n  position:absolute;\n  top:36px;\n  left:4px;\n  width:137px;\n  bottom:6px;\n  column-count:2;\n  column-gap:7px;\n  column-fill:auto;\n  font-size:5.8px;\n  line-height:1.52;\n  text-align:justify;\n}\n.right-copy p{margin:0 0 6px;text-indent:2em}\n.research{\n  height:274px;\n  border-top:1px solid #7aa7bb;\n  padding:5px 4px 0;\n  overflow:hidden;\n}\n.research .right-label{\n  position:static;\n  height:18px;\n}\n.research h2{\n  margin:5px 2px 6px;\n  font-family:\"Microsoft YaHei\",\"SimHei\",sans-serif;\n  font-size:12px;\n  line-height:1.45;\n  text-align:center;\n}\n.research .dateline{\n  margin:0 2px 4px;\n  font-size:6.2px;\n  font-weight:bold;\n  line-height:1.45;\n}\n.research p{\n  margin:0 2px 5px;\n  font-size:5.9px;\n  line-height:1.5;\n  text-align:justify;\n  text-indent:2em;\n}\n.research .credit{\n  margin-top:5px;\n  text-align:center;\n  text-indent:0;\n  font-size:5.7px;\n}\n.illegible{letter-spacing:.05px}\n@media(max-width:800px){\n  .page{\n    transform-origin:top left;\n    transform:scale(calc(100vw / 800));\n    margin-bottom:calc((100vw / 800 - 1) * 1131px);\n  }\n}\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <header class=\"header\">\n    <div class=\"logo\">人民日报</div>\n    <div class=\"header-spacer\"></div>\n    <div class=\"date\">2025年1月4日&nbsp;&nbsp;星期六</div>\n    <div class=\"page-no\">5</div>\n    <div class=\"channel\">科技·新知</div>\n  </header>\n\n  <div class=\"content\">\n    <section class=\"left-column\">\n      <article class=\"feature\">\n        <div class=\"ribbon\"><span class=\"r\">R</span>瞰前沿</div>\n        <h1 class=\"feature-title\">数字人与机器人，更加“通情达理”</h1>\n        <div class=\"byline\">王姝&nbsp;&nbsp;张欣</div>\n\n        <div class=\"placeholder hero-art\">[插图：数字人与机器人]</div>\n\n        <div class=\"editor-heading\">编者的话</div>\n        <aside class=\"editor-note\">\n          <p>科技深刻发展，并极大推动日常生活。[illegible]。</p>\n          <p>近年来，人工智能技术快速发展。[illegible]。</p>\n          <p>从会说话、会动作，到理解人的情绪和需求，[illegible]。</p>\n          <p>数字人与机器人正变得更加自然、更加智能。[illegible]。</p>\n          <p>[illegible]，它们将在更多领域发挥作用。</p>\n          <p>[illegible]。</p>\n        </aside>\n\n        <div class=\"decor-left\"></div>\n        <div class=\"decor-right\"></div>\n\n        <div class=\"article-flow\">\n          <p class=\"intro\">近年来，人工智能发展迅速，大模型、强化学习、感知计算等新技术不断取得突破。[illegible]。</p>\n          <p>“下一代具有情感感知的智能体”，[illegible]，从而使数字人与机器人能够更自然地与人交流。</p>\n          <p>[illegible]。这些技术正在促进虚拟人与实体机器人向更加智能、更加人性化的方向发展。</p>\n\n          <h2 class=\"subhead\">情智融合：认知与情感<br>的完美融合</h2>\n          <p>情感智能融合了认知智能和情感智能，代表了全新的智能演进方向。[illegible]。</p>\n          <p>在与人的交流中，系统不仅需要听懂语言，还需要理解语气、表情和动作中传递出的情绪。[illegible]。</p>\n          <p>[illegible]，从而形成更加自然、更加可信的互动体验。</p>\n\n          <h2 class=\"subhead\">突破之路：多技术协同<br>发展是关键</h2>\n          <p>在通往情智融合的技术路径中，认知智能和感知能力都不可或缺。[illegible]。</p>\n          <p>大语言模型能够帮助系统理解上下文，多模态感知技术则使其能够综合处理声音、图像、动作等信息。[illegible]。</p>\n          <p>[illegible]，还需要语音识别、计算机视觉、自然语言处理等多项技术协同发展。</p>\n          <p>此外，如何让系统形成长期记忆，并在互动中持续学习，也是当前研究的重要方向。[illegible]。</p>\n\n          <h2 class=\"subhead\">三大挑战：情绪感知、<br>个性化分析与仿生化交互</h2>\n          <p>要让数字人与机器人真正“懂人”，仍需解决多项关键技术难题。[illegible]。</p>\n          <p>一是情绪感知。人的情绪表达方式复杂多样，同一句话在不同语境中可能具有不同含义。[illegible]。</p>\n          <p>二是个性化分析。不同人的表达习惯和情感需求不同，系统需要在保护隐私的前提下持续学习。[illegible]。</p>\n          <p>三是仿生化交互。动作、表情、语音节奏等细节都会影响交互体验。[illegible]。</p>\n          <p>[illegible]，使数字角色与实体机器人表现得更加自然。</p>\n\n          <h2 class=\"subhead\">应用前景：医疗<br>护理、教育与企业服务</h2>\n          <p>情感智能技术的广泛应用将深入影响医疗护理、教育、服务等多个领域。[illegible]。</p>\n          <p>在医疗护理领域，懂得察言观色的机器人可以陪伴老人，及时识别情绪变化，为医护人员提供参考。[illegible]。</p>\n          <p>在教育领域，系统可根据学习者的状态调整教学节奏，提供更加个性化的指导。[illegible]。</p>\n          <p>在企业服务领域，情感智能技术可用于客户服务、员工培训和协同办公。[illegible]。</p>\n          <p>未来，随着技术不断发展与完善，数字人与机器人将不再只是执行命令的工具，而会成为能够理解、回应人的智能伙伴。[illegible]。</p>\n        </div>\n      </article>\n\n      <section class=\"bottom-section\">\n        <div class=\"bottom-head\"><span class=\"r\">R</span>探科普</div>\n        <div class=\"bottom-title\">人形机器人知多少</div>\n        <div class=\"bottom-intro\">人形机器人是以智能系统为基础，模拟或具有人类形态及行动能力的机器人。[illegible]</div>\n\n        <div class=\"cards\">\n          <article class=\"card\">\n            <div class=\"placeholder robot-picture\">[图片：Atlas]</div>\n            <h3>波士顿动力公司的 Atlas</h3>\n            <p>波士顿动力公司推出的人形机器人 Atlas，[illegible]。其运动能力和灵活性受到广泛关注。[illegible]。</p>\n          </article>\n\n          <article class=\"card\">\n            <div class=\"placeholder robot-picture\">[图片：Optimus]</div>\n            <h3>特斯拉发布的 Optimus</h3>\n            <p>Optimus 是特斯拉发布的人形机器人项目。[illegible]，可执行搬运、分拣等任务。[illegible]。</p>\n          </article>\n\n          <article class=\"card\">\n            <div class=\"placeholder robot-picture\">[图片：“青龙”人形机器人]</div>\n            <h3>“青龙”人形机器人</h3>\n            <p>“青龙”人形机器人是由人形机器人（上海）有限公司自主研发的全尺寸通用人形机器人开放平台。[illegible]。</p>\n          </article>\n\n          <article class=\"card\">\n            <div class=\"placeholder robot-picture\">[图片：Walker S1]</div>\n            <h3>优必选的 Walker S1</h3>\n            <p>优必选发布的工业人形机器人 Walker S1，[illegible]，可进入工业制造场景执行相关任务。[illegible]。</p>\n          </article>\n        </div>\n      </section>\n    </section>\n\n    <aside class=\"right-column\">\n      <article class=\"right-main\">\n        <div class=\"right-label\"><span class=\"r\">R</span>时·科</div>\n        <h1 class=\"vertical-title\">准时，究竟以何为准</h1>\n        <div class=\"vertical-author\">张[?]莉</div>\n\n        <div class=\"right-copy\">\n          <p>时间，与每个人相伴，也常常让人产生疑问。人们每天看表、校时，[illegible]。</p>\n          <p>现代生活离不开统一、准确的时间标准。[illegible]。</p>\n          <p>从古代观测日月星辰，到机械钟、石英钟，再到原子钟，人类计时方式不断进步。[illegible]。</p>\n          <p>[illegible]，时间测量的精度也在持续提高。</p>\n          <p>今天，世界各地的标准时间以高精度原子钟为基础。[illegible]。</p>\n          <p>原子内部的能级跃迁具有极高的稳定性，可作为精密计时的依据。[illegible]。</p>\n          <p>在日常生活中，人们常用“北京时间”。[illegible]。</p>\n          <p>时间基准关系到通信、电力、交通、金融、导航等众多领域。[illegible]。</p>\n          <p>卫星导航系统需要对时间进行极其精确的测量，微小误差也可能带来明显的位置偏差。[illegible]。</p>\n          <p>[illegible]，高精度计时也是基础科学研究的重要工具。</p>\n          <p>随着量子技术的发展，新型原子钟的稳定度与准确度不断提升。[illegible]。</p>\n          <p>如何让不同地点、不同设备保持同步，是时间频率研究的重要课题。[illegible]。</p>\n          <p>科学家通过多种技术进行时间比对与传递。[illegible]。</p>\n          <p>从“日出而作，日落而息”到精确至极短时间尺度的现代计时，人类对时间的认识不断深入。[illegible]。</p>\n          <p>[illegible]，准确的时间将继续支撑科技发展和社会运行。</p>\n        </div>\n      </article>\n\n      <section class=\"research\">\n        <div class=\"right-label\"><span class=\"r\">R</span>学术眼</div>\n        <h2>国科大张康团队揭示帕金森病干预获重要进展</h2>\n        <div class=\"dateline\">本报北京1月3日电（记者吴月辉）[illegible]</div>\n        <p>近日，相关研究团队在帕金森病研究方面取得重要进展。[illegible]。</p>\n        <p>帕金森病是一种常见的神经退行性疾病，[illegible]。研究人员围绕其发生机制和潜在干预路径开展研究。</p>\n        <p>研究团队通过多种实验手段发现，[illegible]，为理解疾病进程提供了新的线索。</p>\n        <p>[illegible]。相关成果为进一步开展药物研发及临床研究提供了参考。</p>\n        <p>研究人员表示，仍需开展更多研究，以验证相关机制及干预方式的安全性、有效性。[illegible]。</p>\n        <p class=\"credit\">学术支持：中国科学院大学<br>[illegible]</p>\n      </section>\n    </aside>\n  </div>\n</main>\n</body>\n</html>"
