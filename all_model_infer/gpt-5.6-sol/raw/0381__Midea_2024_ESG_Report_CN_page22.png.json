round: linear-gradient(to bottom, #fff 0, #fff 77%, #f4f4f4 100%);\n  }\n\n  .feature-copy {\n    position: absolute;\n    top: -4px;\n    left: 36px;\n    width: 545px;\n    color: #666;\n    font-size: 28px;\n    font-weight: 300;\n    line-height: 1.78;\n    letter-spacing: .1px;\n  }\n\n  .feature-copy p {\n    margin: 0;\n  }\n\n  .photo-placeholder {\n    position: absolute;\n    top: 0;\n    right: 56px;\n    width: 668px;\n    height: 547px;\n    overflow: hidden;\n    border: 0;\n    color: #777;\n    background:\n      linear-gradient(135deg, rgba(39,72,83,.82), rgba(89,131,114,.72)),\n      #879b92;\n  }\n\n  .photo-placeholder::before {\n    content: \"\";\n    position: absolute;\n    left: 265px;\n    top: 100px;\n    width: 110px;\n    height: 310px;\n    border-radius: 60px 60px 20px 20px;\n    background: rgba(245,245,245,.75);\n    box-shadow:\n      -175px 55px 0 -18px rgba(244,244,244,.68),\n      178px 17px 0 -8px rgba(238,238,238,.72),\n      320px 46px 0 -15px rgba(246,246,246,.73);\n  }\n\n  .photo-placeholder::after {\n    content: \"[Photo: 大熊猫认养仪式]\";\n    position: absolute;\n    left: 0;\n    bottom: 0;\n    width: 100%;\n    padding: 12px;\n    background: rgba(255,255,255,.78);\n    color: #777;\n    font-size: 18px;\n    text-align: center;\n  }\n\n  .feature-caption {\n    position: absolute;\n    right: 56px;\n    bottom: 46px;\n    width: 668px;\n    color: #666;\n    font-size: 25px;\n    font-weight: 300;\n    white-space: nowrap;\n  }\n\n  .feature-caption::before {\n    content: \"\";\n    display: inline-block;\n    width: 15px;\n    height: 15px;\n    margin-right: 18px;\n    border-radius: 50%;\n    background: #08b1a9;\n    vertical-align: 1px;\n  }\n\n  .page-number {\n    position: absolute;\n    bottom: 78px;\n    color: #202020;\n    font-family: Arial, sans-serif;\n    font-size: 25px;\n    font-weight: 400;\n  }\n\n  .left-page .page-number {\n    left: 157px;\n  }\n\n  .right-page .page-number {\n    right: 151px;\n  }\n</style>\n</head>\n<body>\n<div class=\"spread\">\n  <header>\n    <p class=\"report-label\">2024 · 美的集团ESG报告</p>\n    <nav class=\"top-nav\" aria-label=\"报告目录\">\n      <span>关于本报告</span>\n      <span>走进美的</span>\n      <span>可持续发展治理</span>\n      <span class=\"active\">守护蓝色星球</span>\n      <span>构建和谐社区</span>\n      <span>践行科技尽善</span>\n      <span>共创繁荣生态</span>\n      <span>附录</span>\n    </nav>\n  </header>\n\n  <section class=\"page left-page\">\n    <p class=\"left-intro\">\n      同时，我们定期开展废弃物管理相关的主题培训，持续推广减少废弃物的实践。报告期内，我们开展零废工厂<br>\n      建设的主题培训，通过零废工厂建设核心思路及实践案例等关键领域的介绍，提升了员工的减废意识，促进跨<br>\n      部门协作，共同推动美的集团向零废弃物排放的目标迈进。\n    </p>\n\n    <div class=\"management-stack\">\n      <article class=\"management-item\">\n        <div class=\"management-label\">\n          <div class=\"label-icon\"><span class=\"drop-icon\" aria-hidden=\"true\"></span></div>\n          <div class=\"label-title\">废水管理</div>\n        </div>\n        <span class=\"connector-line\" aria-hidden=\"true\"></span>\n        <span class=\"connector-dot\" aria-hidden=\"true\"></span>\n        <div class=\"management-card\">\n          <p>\n            美的集团生产运营过程中产生的废水主要包括生活废水及工业废水。我们建立了<br>\n            相应的污水排放管理制度，对废水进行分类管理，生活废水及工业废水主要通过<br>\n            化粪池或工厂污水处理站等预处理达标后，排放至市政污水处理管网及污水处理<br>\n            厂或监管部门指定的排放区域。同时，我们还积极优化现有废水处理工艺，提升<br>\n            废水处理效果，并推进旧厂区雨污分流、废水处理设备升级等，以综合的方式整<br>\n            体减少废水排放，强化废水管理。\n          </p>\n        </div>\n      </article>\n\n      <article class=\"management-item compact\">\n        <div class=\"management-label\">\n          <div class=\"label-icon\">\n            <div class=\"air-icon\" aria-hidden=\"true\">\n              <span class=\"box-outline\"></span>\n              <span class=\"wind\"></span>\n              <span class=\"curl\"></span>\n              <span class=\"curl bottom\"></span>\n            </div>\n          </div>\n          <div class=\"label-title\">废气管理</div>\n        </div>\n        <span class=\"connector-line\" aria-hidden=\"true\"></span>\n        <span class=\"connector-dot\" aria-hidden=\"true\"></span>\n        <div class=\"management-card\">\n          <p>\n            美的集团严格遵守运营所在地适用的法律法规，并对厂区整体产生的废气进行排<br>\n            放管控，通过严格的废气处理流程，确保其经废气处理装置处理后达标排放，防<br>\n            止对大气造成污染。\n          </p>\n        </div>\n      </article>\n    </div>\n\n    <div class=\"placeholder left-illustration\" role=\"img\" aria-label=\"底部生态城市与地球装饰插图\">\n      [Illustration: bottom ecological city and globe]\n    </div>\n\n    <div class=\"page-number\">41</div>\n  </section>\n\n  <section class=\"page right-page\">\n    <div class=\"right-title-highlight\" aria-hidden=\"true\"></div>\n    <h1 class=\"right-title\">和谐共生 坚守生态红线</h1>\n\n    <div class=\"right-copy\">\n      <p>\n        生物多样性是人类社会生存和发展的基石。为了进一步加强生物多样性保护，美的集团开展了一系列多样化的<br>\n        保护项目，积极践行可持续发展的承诺。2024年度，我们制定并发布了《美的集团生物多样性保护政策》，<br>\n        明确美的集团在生物多样性保护以及森林保护方面的承诺和行动方向，将通过合规管控、生物多样性风险评估、<br>\n        利益相关者参与等多方面措施，切实推进生物多样性保护工作。\n      </p>\n      <p>\n        在业务发展和运营过程中，美的集团始终将生物多样性保护作为重要考量因素。为了实现生物多样性保护的目<br>\n        标，我们优先选择避免对生物多样性产生影响的设计和施工方案，尤其避免对生物多样性保护重点区域的可能<br>\n        影响。在选址设计时，我们进行实地考察，并通过开展环境影响评价，评估施工对当地物种多样性及运营所在<br>\n        地周边生态环境的影响。同时，美的集团还制定并严格执行排放物处理流程和管理制度，对运营过程中产生的<br>\n        废水、废气等污染物进行有效处理和控制，严格监控自身运营活动对周围环境的影响。\n      </p>\n      <p>此外，我们亦开展多样化的生物多样性保护项目，以践行可持续发展承诺。</p>\n    </div>\n\n    <section class=\"feature\">\n      <div class=\"feature-header\">\n        <div class=\"feature-icon-pill\" aria-hidden=\"true\">\n          <span class=\"list-symbol\">\n            <i></i><i></i><i></i>\n            <b></b><b></b><b></b>\n          </span>\n        </div>\n        <div class=\"feature-heading\">美的集团官宣认养大熊猫“渝可”“渝爱”</div>\n      </div>\n\n      <div class=\"feature-card\">\n        <div class=\"feature-copy\">\n          <p>\n            美的集团与重庆动物园签署认养协议，认养<br>\n            大熊猫“渝可”“渝爱”，宣布将与重庆动物园<br>\n            共同启动“国宝美好生活计划”，承诺将为熊<br>\n            猫定制专属全屋智慧空气，以美的集团的创<br>\n            新能力，为重庆动物园的大熊猫打造更适宜<br>\n            的居住环境，为大熊猫保护、熊猫生存环境<br>\n            改善的公益事业作出美的贡献。美的集团作<br>\n            为首家认养大熊猫的科技集团，希望借此让<br>\n            更多人关注熊猫保护。未来，美的公益将继<br>\n            续整合资源，探索大熊猫保护发展之路，实<br>\n            现企业与社会共同可持续发展。\n          </p>\n        </div>\n\n        <figure class=\"placeholder photo-placeholder\" aria-label=\"大熊猫认养仪式照片\"></figure>\n        <div class=\"feature-caption\">大熊猫认养仪式</div>\n      </div>\n    </section>\n\n    <div class=\"page-number\">42</div>\n  </section>\n</div>\n</body>\n</html>"
      },
      "finish_reason": "stop"
    }
