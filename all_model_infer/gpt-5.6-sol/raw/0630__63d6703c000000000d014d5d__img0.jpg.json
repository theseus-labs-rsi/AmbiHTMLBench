n    color: rgba(95,100,95,.055);\n    font-size: 16px;\n    line-height: 2.2;\n    transform: scaleX(-1) rotate(-2deg);\n    white-space: nowrap;\n  }\n\n  .note {\n    position: absolute;\n    white-space: nowrap;\n    font-size: 19px;\n    line-height: 1.42;\n    font-weight: 500;\n    letter-spacing: .5px;\n    text-shadow: .15px .15px 0 rgba(0,0,0,.28);\n  }\n\n  .small { font-size: 17px; }\n  .medium { font-size: 18px; }\n\n  .line {\n    position: absolute;\n    height: 1.4px;\n    background: #3c403a;\n    transform-origin: left center;\n    border-radius: 50%;\n  }\n\n  .curve {\n    position: absolute;\n    border-top: 1.4px solid #3c403a;\n    border-radius: 50%;\n    height: 15px;\n  }\n\n  .divider {\n    position: absolute;\n    left: 4px;\n    top: 328px;\n    width: 500px;\n    height: 1px;\n    background: #464a44;\n    transform: rotate(-.3deg);\n  }\n\n  .brace {\n    position: absolute;\n    left: 197px;\n    top: 50px;\n    width: 17px;\n    height: 76px;\n  }\n\n  .brace::before,\n  .brace::after {\n    content: \"\";\n    position: absolute;\n    left: 2px;\n    width: 13px;\n    height: 34px;\n    border-left: 1.5px solid #3b4039;\n  }\n\n  .brace::before {\n    top: 0;\n    border-bottom-left-radius: 11px;\n    transform: skewY(22deg);\n  }\n\n  .brace::after {\n    bottom: 0;\n    border-top-left-radius: 11px;\n    transform: skewY(-22deg);\n  }\n\n  .patch {\n    position: absolute;\n    width: 17px;\n    height: 19px;\n    background: rgba(218,224,225,.92);\n    transform: rotate(-2deg);\n  }\n\n  .finger {\n    position: absolute;\n    left: -12px;\n    bottom: -9px;\n    width: 68px;\n    height: 155px;\n    border-radius: 37px 37px 11px 7px;\n    transform: rotate(28deg);\n    background:\n      linear-gradient(90deg, #9a5d4d 0%, #bd806d 43%, #d29a82 70%, #a96756 100%);\n    box-shadow:\n      inset -5px 0 7px rgba(95,42,35,.22),\n      2px 0 5px rgba(40,35,30,.28);\n  }\n\n  .fingernail {\n    position: absolute;\n    left: 22px;\n   