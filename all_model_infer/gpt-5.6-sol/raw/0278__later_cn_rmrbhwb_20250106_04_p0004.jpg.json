deg,#4a92a7 0 18%,#d5d8d7 18% 23%,#22485d 23% 46%,#f8f8f8 46% 57%,#a0a6a6 57% 100%);\n}\n.transit-photo:before{\n  content:\"\";\n  position:absolute;\n  left:42px;\n  top:50px;\n  width:116px;\n  height:15px;\n  background:#0c587c;\n  border:5px solid #1f2428;\n  box-shadow:40px 65px 0 0 #154f6c;\n}\n.transit-photo:after{\n  content:\"\";\n  position:absolute;\n  right:22px;\n  top:5px;\n  width:223px;\n  height:147px;\n  border-radius:50%;\n  border:3px solid #fff;\n  background:\n    linear-gradient(35deg,#f2ba42 0 20%,#ae2b1e 20% 39%,#f2e4ca 39% 61%,#4d3027 61% 72%,#f38d26 72%);\n  box-shadow:0 1px 3px #444;\n}\n.transit-photo span{\n  position:relative;\n  z-index:3;\n  margin-left:186px;\n  background:rgba(0,0,0,.48);\n  padding:3px 7px;\n}\n.transit-caption{\n  position:absolute;\n  right:5px;\n  bottom:9px;\n  z-index:4;\n  width:100px;\n  padding:4px;\n  background:rgba(255,255,255,.9);\n  font-size:6.3px;\n  line-height:1.55;\n  text-align:justify;\n}\n.agriculture{\n  height:280px;\n  margin-top:10px;\n  padding:9px 13px 8px;\n  border:1px solid #333;\n  overflow:hidden;\n}\n.agriculture h2{\n  margin:0;\n  color:#086087;\n  text-align:center;\n  font-family:\"Microsoft YaHei\",\"SimHei\",sans-serif;\n  font-size:22px;\n  line-height:27px;\n  font-weight:500;\n  letter-spacing:1px;\n}\n.byline{\n  margin:2px 0 7px;\n  text-align:center;\n  font-size:8px;\n}\n.agri-layout{\n  display:grid;\n  grid-template-columns:212px 1fr;\n  gap:13px;\n}\n.agri-photo{\n  width:212px;\n  height:176px;\n  background:\n    repeating-linear-gradient(to bottom,#e7f4ed 0 20px,#65aa36 20px 26px,#f5f1e8 26px 41px,#a6333c 41px 49px);\n  color:#fff;\n}\n.agri-photo span{background:rgba(0,0,0,.4);padding:3px 5px}\n.agri-caption{\n  margin:4px 2px 0;\n  font-size:6.1px;\n  line-height:1.35;\n  text-align:center;\n}\n.agri-copy{\n  height:200px;\n  column-count:2;\n  column-gap:10px;\n  overflow:hidden;\n}\n.right-column{\n  padding-top:5px;\n}\n.side-story{\n  padding:0 8px 7px;\n  margin-bottom:5px;\n}\n.side-story + .side-story{\n  border-top:1px solid #9c9c9c;\n  padding-top:9px;\n}\n.side-title{\n  margin:0 0 12px;\n  text-align:center;\n  font-size:16px;\n  line-height:21px;\n  font-weight:700;\n}\n.side-subtitle{\n  margin:-7px 0 11px;\n  text-align:center;\n  font-size:11px;\n  font-weight:700;\n}\n.side-columns{\n  column-count:2;\n  column-gap:11px;\n  font-size:6.9px;\n  line-height:1.48;\n  text-align:justify;\n}\n.side-columns p{\n  margin:0 0 5px;\n  text-indent:2em;\n}\n.side-columns p.no-indent{text-indent:0}\n.right-photo{\n  width:248px;\n  height:178px;\n  margin-top:3px;\n  background:\n    linear-gradient(100deg,#b37042 0 16%,#252b2c 16% 36%,#d4b49a 36% 56%,#381c18 56% 68%,#c9412f 68% 86%,#e3c1a0 86%);\n  color:#fff;\n}\n.right-photo span{background:rgba(0,0,0,.45);padding:4px 7px}\n.right-caption{\n  margin:4px 4px 0;\n  font-size:6.2px;\n  line-height:1.4;\n  text-align:justify;\n}\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <header class=\"header\">\n    <div class=\"section-number\">04</div>\n    <div class=\"section-name\">要闻·台港澳</div>\n    <div class=\"masthead\">人民日报<small>海外版</small></div>\n    <div class=\"issue\">\n      <div>2025年1月6日　星期一</div>\n      <div class=\"line2\">责编：王平　朱棣　版式：张丹峰</div>\n    </div>\n  </header>\n\n  <div class=\"content\">\n    <section class=\"left-column\">\n      <article class=\"main-story\">\n        <h1 class=\"main-title\">粤港澳携手推动大湾区教育高质量发展</h1>\n\n        <div class=\"main-lead\">\n          <div class=\"article-text\">\n            <p>粤港澳大湾区正掀起人才培养与教育合作作为发展核心引擎之一，共享优质课程、联合培养人才、共建融合实验室，教育、科技、人才一体化发展，共同谱写粤港澳教育强国的崭新篇章。</p>\n            <p>2024年12月9日，澳门大学横琴粤澳深度合作区校区正式开工，预计于2028年投入使用。10年前，澳门大学横琴校区占地约1.09平方公里的建设正式投入使用。新校区从澳门大学主校区出发，同样，通过大学教育的3个国家重点实验室，学生规模约1.5万人，在大湾区教育合作的背景下，澳门大学率先实现了跨区域办学。</p>\n            <p>2024年10月14日，在联合后台粤港澳高等教育科技平台，中山大学粤港澳学院正式揭牌成立，这是中国内地高校在港澳设立的综合性研究机构。</p>\n          </div>\n\n          <div class=\"main-photo-wrap\">\n            <div class=\"placeholder campus-photo\"><span>[照片：澳门大学横琴校区]</span></div>\n            <div class=\"photo-credit\"><span>澳门大学横琴校区。</span><span>澳门大学供图</span></div>\n          </div>\n        </div>\n\n        <div class=\"main-body article-text\">\n          <p>中山大学还与香港大学、香港中文大学、香港理工大学等香港高校签署了一系列校际合作协议，在教学、科研和人才培养等领域合作密切。</p>\n          <p>近年来，香港、澳门多所高校先后在大湾区设立分校或合作办学机构，成立了香港中文大学（深圳）、香港科技大学（广州）、香港城市大学（东莞）等学校；深圳大学、中山大学等内地大学也积极同港澳高校开展课程共建、内地与港澳联合培养研究生，为中国高等教育突破过去的疆界、人才展现提供了新模式。</p>\n          <p>人工智能、大数据、物联网等新兴技术不断推动教育方式变革，大湾区探索创新开放共享的办学模式，通过粤港澳大湾区高校在线开放课程联盟，汇聚了700多门优质课程，面向大湾区高校开放、共享。</p>\n          <p>广东省教育厅有关负责人表示，要深入推进粤港澳大湾区教育合作发展，支持广东省高校在港澳地区设立教学科研机构，加大粤港澳高校联合开展研究生培养和重大科技攻关的力度。</p>\n          <p>除了高等教育，粤港澳大湾区基础教育领域的合作也在深化。2024年11月9日，位于横琴粤澳深度合作区的澳门中学附属学校正式启用。该校由澳门教育及青年发展局与珠海有关方面共同建设。</p>\n          <p>[illegible]</p>\n          <p>日前，广东已有包括暨南大学等学校在内的多所学校，与港澳开展学校、教师和学生的多种学校交流活动。自2004年起，广东每年组织开展粤港澳姊妹学校缔结工作，至今已缔结1546对，占内地总对数超一半。</p>\n          <p>不仅有“结对”，粤港澳基础教育还在协同设计对学生参与度、选科方向等方面开展交流。</p>\n          <p>香港特区政府及大湾区有关部门通过内地港澳游学等方式积极优化协同培养项目，共创设在实验和培养具有坚定专业信念和使命感、愿意不断学习进步的团队，积极探究创新课程与具体培养模式。</p>\n          <p>香港教师提升计划和同伴互助计划等项目已深入推进，粤港澳三地在师资队伍建设、课程设置和人才培养方面探索出更多合作形式。</p>\n          <p>“发挥自身优势，创造发展机会，合作、共赢。”</p>\n        </div>\n      </article>\n\n      <section class=\"transit-block\">\n        <div class=\"placeholder transit-photo\"><span>[照片：香港西九龙站及高速列车，右上为餐饮服务场景]</span></div>\n        <div class=\"transit-caption\">\n          1月5日，G828次列车停靠香港西九龙站，旅客准备进站乘车。<br>\n          上图：旅客候车场景。<br>\n          右上图：内地与香港旅客在列车上体验特色服务。<br>\n          [illegible]\n        </div>\n      </section>\n\n      <article class=\"agriculture\">\n        <h2>智慧农业闪耀香港渔农美食嘉年华</h2>\n        <div class=\"byline\">孙　龙 文/图</div>\n        <div class=\"agri-layout\">\n          <div>\n            <div class=\"placeholder agri-photo\"><span>[照片：智慧农业立体种植展示]</span></div>\n            <div class=\"agri-caption\">2025年香港“本地渔农美食嘉年华”展出的智慧农业、可持续农业成果。</div>\n          </div>\n          <div class=\"agri-copy article-text\">\n            <p>智能照明系统培育的蔬菜、智能恒温养殖的小番茄、循环水系统养殖的石斑鱼……这些融合现代科技元素的渔农产品，在1月3日揭幕的2025年香港“本地渔农美食嘉年华”上亮相，吸引众多市民好奇。</p>\n            <p>由香港特区政府渔农自然护理署主办的“本地渔农美食嘉年华”，连续多天在旺角花墟公园开幕。这场为期3天的嘉年华共设置约420个展销摊位，创历年之最。</p>\n            <p>嘉年华现场人头攒动，大批市民专程前来购买新鲜的本地鱼、蔬菜、水果、蜂蜜、花卉等特色产品。市民在各摊位前精心挑选。“今天很热闹，本地农产品味道不错。”30多岁的市民表示。</p>\n            <p>嘉年华的一大亮点是现代农业科技成果展示。香港本地科研机构、渔农团体带来的智能种植照明系统、鱼菜共生系统等，展现传统农业不同的发展面貌。</p>\n            <p>“智能种植照明系统是今年嘉年华展区的特色之一。”嘉年华有关负责人介绍，这套系统采用无土栽培技术，用水量仅为传统土培方式的1/10，且农作物不受季节限制，能够调节温度、湿度、光照，生产过程更加高效环保。</p>\n            <p>“香港的都市空间有限，发展智慧农业能够提高土地利用效率。”现场工作人员表示，这些新模式为本地渔农提供更多选择，推动产业升级。</p>\n            <p>[illegible]</p>\n          </div>\n        </div>\n      </article>\n    </section>\n\n    <aside class=\"right-column\">\n      <article class=\"side-story\">\n        <h2 class=\"side-title\">宋涛会见台东县长饶庆铃一行</h2>\n        <div class=\"side-columns\">\n          <p class=\"no-indent\">本报北京1月5日电（记者王尧）中共中央台办、国务院台办主任宋涛4日在北京会见台东县长饶庆铃一行。</p>\n          <p>宋涛表示，习近平总书记强调，两岸同胞一家亲。福建先行先试探索两岸融合发展新路、建设两岸融合发展示范区，为两岸同胞带来发展机遇。希望台东乡亲坚持一个中国原则和“九二共识”，推动两岸关系和平发展、推进祖国统一进程。</p>\n          <p>饶庆铃表示，两岸同胞血脉相连，持续推动两岸交流和平发展。希望两岸关系回归和平稳定发展的正确轨道，人员往来更加顺畅。</p>\n        </div>\n      </article>\n\n      <article class=\"side-story\">\n        <h2 class=\"side-title\">港珠澳大桥去年客流车流量创新高</h2>\n        <div class=\"side-subtitle\">同比增长均超70%</div>\n        <div class=\"side-columns\">\n          <p class=\"no-indent\">本报珠海1月5日电（记者贺林平）据港珠澳大桥边检站统计，2024年经港珠澳大桥珠海公路口岸出入境客流超2700万人次，同比增长72%；出入境车流超550万辆次，同比增长71%，这是大桥开通以来客流车流量首次双双创下新高。</p>\n          <p>2024年，经港珠澳大桥珠海公路口岸出入境的港澳旅客超1620万人次，同比增长63%，占口岸客流总量近六成。2024年经口岸日均客流量超10万人次以上天数达50天，是2023年的10倍。</p>\n          <p>随着内地赴港澳“个人游”城市持续扩容、国际旅游恢复等因素影响，港珠澳大桥口岸客流车流量增长明显。2024年，经港珠澳大桥往来的内地旅客超524万人次，同比增长55%，创2018年2月口岸开通以来新高。</p>\n          <p>“周末游”“节假日游”等旅游消费需求持续增长，港珠澳大桥跨境出行的便捷优势更加突出。</p>\n        </div>\n      </article>\n\n      <article class=\"side-story\">\n        <h2 class=\"side-title\">《香港文学》创刊40周年志庆办书画展</h2>\n        <div class=\"side-columns\">\n          <p class=\"no-indent\">新华社香港1月5日电（记者褚萌萌）为庆祝《香港文学》杂志创刊40周年，由香港文学出版社主办的“风华四十年——《香港文学》四十周年志庆书画展暨新书发布会”5日在香港中央图书馆开幕。</p>\n          <p>此次展览汇聚来自香港、北京、广州、深圳、澳门、巴黎等多地的书画作品80余幅，以文学与艺术相互辉映的形式，书写香港文学的发展历程。</p>\n          <p>开幕典礼上，香港特区行政长官李家超通过视频致辞。香港文学与各地华文文学携手同一根脉，都是中国文学的组成部分。香港作为一座国际城市，拥有特殊且重要的地位，能够成为沟通东西文化的桥梁。</p>\n          <p>香港文学出版社社长陶然表示，此次展览回顾作品所承载的文学记忆，并进一步推动香港与海内外文学艺术界交流。</p>\n          <p>书画及相关出版物将在香港中央图书馆展出至1月10日。</p>\n        </div>\n      </article>\n\n      <article class=\"side-story\">\n        <h2 class=\"side-title\">香港话剧团《天下第一楼》在京演出</h2>\n        <div class=\"side-columns\">\n          <p class=\"no-indent\">本报北京1月5日电（记者郑海鸥）3日至5日，香港话剧团《天下第一楼》在北京天桥艺术中心连演4场，共吸引5000余名观众观看。</p>\n          <p>《天下第一楼》自1988年在北京人民艺术剧院首演以来，已成为经典舞台作品。香港话剧团以粤语演绎，通过鲜明人物与戏剧冲突，呈现老字号饭庄“福聚德”兴衰变迁。</p>\n          <p>《天下第一楼》讲述了清末民初京城老字号烤鸭店“福聚德”由盛到衰的故事。演员以细腻表演刻画人物，舞台布景和服装设计突出时代氛围。</p>\n          <p>此次演出系香港特区政府推出的交流项目之一。香港话剧团希望以舞台艺术促进京港文化交流，让更多观众了解香港戏剧艺术。</p>\n          <p>演出期间，主创团队还参加交流活动，与观众分享作品创排及表演经验。</p>\n        </div>\n      </article>\n\n      <div class=\"placeholder right-photo\"><span>[照片：香港迎春联谊活动中的手工编织场景]</span></div>\n      <div class=\"right-caption\">\n        “新春同心迎新岁 共叙两岸同胞情”迎春联谊活动近日在香港举行。现场嘉宾体验传统手工技艺，感受中华优秀传统文化魅力。[illegible]\n      </div>\n    </aside>\n  </div>\n</main>\n</body>\n</html>"
