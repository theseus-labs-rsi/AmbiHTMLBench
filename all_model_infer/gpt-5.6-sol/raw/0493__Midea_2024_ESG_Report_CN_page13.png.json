5px;\n    display: flex;\n    align-items: center;\n    padding: 38px 34px;\n    font-size: 25px;\n    line-height: 1.55;\n  }\n\n  .opportunity-impact {\n    grid-column: 3;\n    height: 285px;\n    padding: 70px 24px 30px 58px;\n    font-size: 25px;\n    line-height: 1.5;\n  }\n\n  .opportunity-strategy {\n    grid-column: 5;\n    height: 285px;\n    padding: 67px 23px 25px 58px;\n    font-size: 25px;\n    line-height: 1.5;\n  }\n\n  .opportunity-period {\n    grid-column: 6;\n    height: 285px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 13px;\n    font-size: 24px;\n  }\n\n  .opportunity-finance {\n    grid-column: 7;\n    height: 285px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 13px;\n    font-size: 24px;\n  }\n\n  .page-number {\n    position: absolute;\n    bottom: 41px;\n    font-family: Arial, sans-serif;\n    font-size: 25px;\n  }\n\n  .page-number.left {\n    left: 156px;\n  }\n\n  .page-number.right {\n    right: 156px;\n  }\n\n  @media (max-width: 4096px) {\n    .document {\n      zoom: calc(100vw / 4096);\n    }\n  }\n</style>\n</head>\n<body>\n<main class=\"document\">\n  <header class=\"topline\">\n    <div class=\"report-name\">2024 · 美的集团ESG报告</div>\n\n    <nav class=\"navigation\" aria-label=\"报告章节\">\n      <span>关于本报告</span>\n      <span>走进美的</span>\n      <span>可持续发展治理</span>\n      <span class=\"active\">守护蓝色星球</span>\n      <span>构建和谐社区</span>\n      <span>践行科技尽善</span>\n      <span>共创繁荣生态</span>\n      <span>附录</span>\n    </nav>\n\n    <div class=\"placeholder cover-art\" role=\"img\" aria-label=\"左上角山峰、树木和太阳能板插图\">\n      <span class=\"mountain one\"></span>\n      <span class=\"mountain two\"></span>\n      <span class=\"tree t1\"></span>\n      <span class=\"tree t2\"></span>\n      <span class=\"solar\"></span>\n      <span class=\"ground\"></span>\n    </div>\n  </header>\n\n  <div class=\"decorations\" aria-hidden=\"true\">\n    <span class=\"decor-tree a\"></span>\n    <span class=\"decor-tree b\"></span>\n    <span class=\"decor-tree c\"></span>\n    <span class=\"decor-tree d\"></span>\n  </div>\n\n  <section class=\"risk-section\">\n    <div class=\"grid header-row\">\n      <div class=\"heading type\">风险类型</div>\n      <div class=\"heading description\">风险描述</div>\n      <div class=\"heading impact\">风险影响</div>\n      <div class=\"spacer\"></div>\n      <div class=\"heading strategy\">应对策略</div>\n      <div class=\"heading period\">影响周期</div>\n      <div class=\"heading finance\">财务冲击</div>\n    </div>\n\n    <div class=\"grid content-grid\">\n      <div class=\"box risk-type\">\n        <div class=\"type-cell\">物理风险</div>\n        <div class=\"type-cell\">转型风险</div>\n      </div>\n\n      <div class=\"box risk-description\">\n        <div class=\"cell physical\">洪灾程度增加</div>\n        <div class=\"cell physical\">极端高温</div>\n        <div class=\"cell physical\">台风等频次增加</div>\n        <div class=\"cell\">对产品能效、冷媒、材料等强制性监管要求的提升</div>\n        <div class=\"cell\">对新能源、储能、新能源汽车核心零部件等产业的投入和转型</div>\n        <div class=\"cell\">绿色能源成本的不确定性</div>\n      </div>\n\n      <div class=\"box risk-impact\">\n        <div class=\"cell\">\n          <ul>\n            <li>严重洪灾可能对排水能力较差的仓储区造成成品及生产设备损毁，进而导致运营成本增加与设备加速折旧</li>\n            <li>交通中断或拥堵，无法保证员工的通勤时间，可能导致雇员生产力下降</li>\n          </ul>\n        </div>\n        <div class=\"cell\">\n          <ul>\n            <li>极端高温将降低户外工作者的工作效率，增加员工健康安全风险</li>\n            <li>为办公、生产等区域员工提供舒适的工作环境所需的制冷能源消耗将增加，进一步加大了制冷相关的碳排放，并有可能增加运营成本</li>\n          </ul>\n        </div>\n        <div class=\"cell\">\n          <ul>\n            <li>对部分海运物料供应、成品运输的时效性可能造成影响，进一步增加运营成本</li>\n          </ul>\n        </div>\n        <div class=\"cell\">\n          <ul>\n            <li>更高级能效市场准入及消费者偏好将影响研发和市场投入方向</li>\n            <li>《蒙特利尔议定书》对破坏臭氧层物质管制的要求及欧盟、美洲等地区对不同环保型冷媒产品及二氧化碳压缩机等产品的引入将在中长期影响研发和市场的投入方向</li>\n            <li>在循环经济体系背景下环保型材料尤其是再生材料应用占比的提出可能增加产品材料来源的不确定性进一步提升材料的潜在成本</li>\n          </ul>\n        </div>\n        <div class=\"cell\">\n          <ul>\n            <li>在应对和适应气候背景下，以合康新能、科陆电子、汽车部件等代表的新业务板块有巨大的市场潜力和竞争压力</li>\n          </ul>\n        </div>\n        <div class=\"cell\">\n          <ul>\n            <li>当前可售的绿色电力资源紧缺，市场需求上涨，长期以往可能导致绿色电力在市场化机制下绿电环境溢价进一步提升，增加制造工厂能源成本</li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"box strategy-box\">\n        <div class=\"cell\">\n          <ul>\n            <li>提升各基地应对50年一遇洪灾的应对能力，并购置相关保险</li>\n            <li>进一步完善员工宿舍建设，缩短员工通勤路程</li>\n          </ul>\n        </div>\n        <div class=\"cell\">\n          <ul>\n            <li>完善户外作业管理要求，通过制冷设备升级和智能化控制手段，开展制冷相关节能降碳项目</li>\n            <li>通过绿色建筑建设，采用围护结构改造、自然通风等有效措施提升办公区域的舒适度</li>\n          </ul>\n        </div>\n        <div class=\"cell\">\n          <ul>\n            <li>通过制造能力全球布局、制造基地安全库存、供方布局及唯一性排查、各基地柔性制造能力提升等措施提升供应链气候韧性</li>\n          </ul>\n        </div>\n        <div class=\"cell\">\n          <ul>\n            <li>通过绿色设计标准牵引加快更高能效、水效等产品的技术领先性</li>\n            <li>加快环保型冷媒产品研发、制造、市场的投入，保持行业市场领先</li>\n            <li>联合包括大宗物料供方、废旧家电回收商、家电拆解工厂、再生资源生产商、塑料改性生产商等上下游价值链推动内外双循环制造模式，加快绿色低碳材料研究和应用，并在合适的区域建设自有拆解工厂，提升再生资源的生产能力</li>\n          </ul>\n        </div>\n        <div class=\"cell\">\n          <ul>\n            <li>通过绿色工业等布局进一步提升相关业务综合服务能力</li>\n            <li>通过研发和技术创新抓住产品突破方向及市场机遇</li>\n          </ul>\n        </div>\n        <div class=\"cell\">\n          <ul>\n            <li>加强智能制造和绿色工艺突破，能源脱碳和节能降碳同步推进</li>\n            <li>提升自制件相关供应商研发生产、供应交付能力，进一步降低价值链碳排放，降低集团工厂的自制件生产压力</li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"box period-box\">\n        <div class=\"cell\">\n          <div class=\"icon shield leaf red placeholder\" role=\"img\" aria-label=\"红色盾牌叶片图标\"></div>\n          <span>短中期</span>\n        </div>\n        <div class=\"cell\">\n          <div class=\"icon shield tree placeholder\" role=\"img\" aria-label=\