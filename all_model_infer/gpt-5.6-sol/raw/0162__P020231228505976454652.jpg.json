        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>A Needle is an Outlier in a Haystack</title>\n<script>\nwindow.MathJax = {\n  tex: {inlineMath: [['$', '$']], displayMath: [['$$', '$$']]}\n};\n</script>\n<script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;padding:0;background:#eee}\nbody{font-family:\"Times New Roman\",Times,serif;color:#111}\n.page{\n  position:relative;\n  width:768px;\n  min-height:1729px;\n  margin:0 auto;\n  overflow:hidden;\n  background:\n    radial-gradient(circle at 8% 79%,rgba(248,196,89,.09),transparent 18%),\n    linear-gradient(#fff 0,#fffaf0 100%);\n}\n.top-banner{\n  position:relative;\n  height:172px;\n  overflow:hidden;\n  color:#fff;\n  background:\n    radial-gradient(circle at 54px 54px,rgba(255,211,0,.42),transparent 75px),\n    linear-gradient(180deg,#ff7900 0%,#ff9900 48%,#ffb525 65%,#ff6d18 66%,#ff8b2b 78%,#fff 100%);\n}\n.top-banner:before{\n  content:\"\";\n  position:absolute;\n  left:-35px;\n  top:113px;\n  width:850px;\n  height:44px;\n  transform:rotate(5deg);\n  background:rgba(255,255,255,.78);\n  border-radius:50%;\n}\n.top-banner:after{\n  content:\"\";\n  position:absolute;\n  left:-50px;\n  top:137px;\n  width:870px;\n  height:28px;\n  transform:rotate(-4deg);\n  background:#ff6e16;\n  border-radius:50%;\n  box-shadow:0 11px 0 rgba(255,184,91,.5);\n}\n.network{\n  position:absolute;\n  left:4px;\n  top:7px;\n  width:145px;\n  height:92px;\n  opacity:.28;\n  border-radius:50%;\n  background:\n    radial-gradient(circle at 20px 20px,#fff 0 2px,transparent 3px),\n    radial-gradient(circle at 70px 17px,#fff 0 2px,transparent 3px),\n    radial-gradient(circle at 105px 47px,#fff 0 2px,transparent 3px),\n    radial-gradient(circle at 50px 70px,#fff 0 2px,transparent 3px);\n  border:1px solid #ffd354;\n}\