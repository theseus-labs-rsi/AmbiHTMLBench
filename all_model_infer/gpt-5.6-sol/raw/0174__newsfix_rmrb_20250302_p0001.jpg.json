 text-align: center;\n    white-space: nowrap;\n  }\n\n  .cppcc h3 {\n    margin: 2px 0 9px;\n    font-family: \"STKaiti\", \"KaiTi\", serif;\n    font-size: 16px;\n    font-weight: normal;\n    text-align: center;\n  }\n\n  .cppcc-body {\n    column-count: 3;\n    column-gap: 9px;\n    min-height: 99px;\n    font-size: 6.2px;\n    line-height: 1.45;\n    text-align: justify;\n  }\n\n  .cppcc-body p {\n    margin: 0 0 5px;\n    text-indent: 2em;\n  }\n\n  .aircraft {\n    display: grid;\n    grid-template-columns: 122px 1fr;\n    gap: 8px;\n    margin-top: 7px;\n    border-top: 1px solid #777;\n    padding-top: 7px;\n  }\n\n  .aircraft h2 {\n    margin: 0;\n    font-family: \"Noto Sans CJK SC\", \"Microsoft YaHei\", sans-serif;\n    font-size: 14px;\n    line-height: 1.4;\n    text-align: center;\n  }\n\n  .aircraft-text {\n    column-count: 2;\n    column-gap: 9px;\n    font-size: 6px;\n    line-height: 1.45;\n    text-align: justify;\n  }\n\n  .aircraft-text p {\n    margin: 0 0 4px;\n    text-indent: 2em;\n  }\n\n  .bridge h2 {\n    margin: 0 0 1px;\n    font-family: \"Noto Sans CJK SC\", \"Microsoft YaHei\", sans-serif;\n    font-size: 22px;\n    font-weight: 900;\n    line-height: 1.3;\n    text-align: center;\n    white-space: nowrap;\n  }\n\n  .bridge-subtitle {\n    margin-bottom: 4px;\n    font-family: \"STKaiti\", \"KaiTi\", serif;\n    font-size: 12px;\n    text-align: center;\n  }\n\n  .bridge-author {\n    margin-bottom: 7px;\n    font-size: 6px;\n    text-align: center;\n  }\n\n  .bridge-body {\n    column-count: 3;\n    column-gap: 10px;\n    font-size: 6.2px;\n    line-height: 1.48;\n    text-align: justify;\n  }\n\n  .bridge-body h3 {\n    margin: 4px 0;\n    break-after: avoid;\n    font-size: 10px;\n    text-align: center;\n  }\n\n  .bridge-body p {\n    margin: 0 0 5px;\n    text-indent: 2em;\n  }\n\n  .note {\n    text-indent: 0 !important;\n    text-align: right;\n  }\n\n  @media (max-width: 800px) {\n    .page {\n      width: 800px;\n      margin: 0;\n    }\n  }\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <header class=\"masthead\">\n    <section class=\"brand\">\n      <div class=\"brand-name\">人民日报</div>\n      <div class=\"brand-latin\">RENMIN RIBAO</div>\n      <div class=\"website\">人民网网址：http://www.people.com.cn</div>\n    </section>\n\n    <section class=\"issue-box\">\n      <div class=\"issue-date\">2025年3月</div>\n      <div class=\"issue-day\">2</div>\n      <div class=\"issue-week\">星期日</div>\n      <div class=\"issue-small\">\n        乙巳年二月初三<br>\n        人民日报社出版<br>\n        国内统一连续出版物号<br>\n        CN 11-0065<br>\n        代号1-1<br>\n        第27934期<br>\n        今日8版\n      </div>\n    </section>\n\n    <section class=\"lead\">\n      <h1>把老百姓身边的大事小情解决好</h1>\n      <div class=\"lead-subtitle\">——总书记领航推进中国式现代化中不断增进民生福祉</div>\n      <div class=\"lead-columns\">\n        <p>“人民幸福安康是推动高质量发展的最终目的。”</p>\n        <p>中国式现代化，民生为大。</p>\n        <p>[illegible]</p>\n        <p>悠悠万事，民生为大。习近平总书记始终把人民放在心中最高位置，念兹在兹的是百姓冷暖，夙夜在公的是万家忧乐。</p>\n        <p>[illegible]</p>\n        <p>在发展中保障和改善民生是中国式现代化的重大任务。</p>\n        <p>[illegible]</p>\n        <p>增进民生福祉是发展的根本目的。</p>\n        <p>[illegible]</p>\n      </div>\n    </section>\n  </header>\n\n  <section class=\"main-area\">\n    <article class=\"left-feature\">\n      <div class=\"feature-top\">\n        <div class=\"vertical-headline\">\n          <span class=\"small-column\">习近平在中共中央政治局第十九次集体学习时强调</span>\n          <span>坚持平安中国建设推向更高水平</span>\n          <span>把平安中国建设推向更高水平</span>\n        </div>\n\n        <div class=\"bullet-list\">\n          <div class=\"bullet-item\">建设更高水平平安中国，事关事业兴旺发达、事关人民美好生活、事关国家长治久安。要坚定不移贯彻总体国家安全观，在国家更加安全、社会更加有序、治理更加有效、人民更加满意上持续用力，把平安中国建设推向更高水平</div>\n          <div class=\"bullet-item\">党的十八大以来，党中央不断完善国家安全领导体制和法治体系、战略体系、政策体系、风险监测预警体系、国家应急管理体系，建设更高水平平安中国的总体格局基本形成，安全发展基础更加牢固。要坚持党的领导、人民至上、统筹发展和安全，推动平安中国建设不断迈上新台阶</div>\n          <div class=\"bullet-item\">总体国家安全观是建设更高水平平安中国的重要遵循，必须坚定不移贯彻。各级党委和政府要坚持系统思维，进一步健全发展和安全动态平衡机制，推动公共安全治理模式向事前预防转型</div>\n          <div class=\"bullet-item\">平安中国建设为了人民、依靠人民。要不断增进民生福祉，扎实推进共同富裕，切实维护人民群众合法权益，维护社会公平正义。完善社会治理体系，健全社会工作体制机制，动员人民群众人人参与、人人尽责、人人享有</div>\n          <div class=\"bullet-item\">防范化解各类风险是平安中国建设的一项重要任务。要把捍卫国家政治安全摆在首位，坚定维护国家政权安全、制度安全、意识形态安全。完善社会治安整体防控体系，推进扫黑除恶常态化</div>\n          <div class=\"bullet-item\">建设更高水平平安中国，必须强化社会治安整体防控。要指导各级加强和创新社会治理，健全共建共治共享的社会治理制度，及时把矛盾纠纷化解在基层、化解在萌芽状态</div>\n          <div class=\"bullet-item\">党的领导是平安中国建设的根本保证。要始终坚持党中央对国家安全工作的集中统一领导，落实维护国家安全责任制，形成齐抓共管的强大合力</div>\n        </div>\n      </div>\n\n      <div class=\"feature-body\">\n        <p>新华社北京3月1日电　中共中央政治局2月28日下午就建设更高水平平安中国进行第十九次集体学习。中共中央总书记习近平在主持学习时强调，建设更高水平平安中国，事关事业兴旺发达、事关人民美好生活、事关国家长治久安。要坚定不移贯彻总体国家安全观，在国家更加安全、社会更加有序、治理更加有效、人民更加满意上持续用力，把平安中国建设推向更高水平。</p>\n        <p>[illegible]</p>\n        <p>习近平强调，党的领导是平安中国建设的根本保证。要始终坚持党中央对国家安全工作的集中统一领导，落实维护国家安全责任制，形成齐抓共管的强大合力。</p>\n        <p>[illegible]</p>\n        <p>中共中央政治局各位同志认真听取讲解，并进行了讨论。</p>\n      </div>\n    </article>\n\n    <section class=\"right-news\">\n      <div class=\"right-top\">\n        <article class=\"news-column\">\n          <h2>中国式现代化，民生为大</h2>\n          <p>岁末年初，人民群众最关心的事，始终是习近平总书记最深的牵挂。</p>\n          <p>[illegible]</p>\n          <p>习近平总书记指出，现代化的本质是人的现代化。</p>\n          <p>[illegible]</p>\n        </article>\n\n        <article class=\"news-column\">\n          <p>[illegible]</p>\n          <p>在习近平总书记心中，民生是“国之大者”，要“把人民群众的小事当作自己的大事”。</p>\n          <p>[illegible]</p>\n          <p>一项项民生举措落地见效，一个个民生愿景变为幸福实景。</p>\n          <p>[illegible]</p>\n        </article>\n\n        <article class=\"news-column\">\n          <p>[illegible]</p>\n          <h2>在发展中保障和改善民生是中国式现代化的重大任务</h2>\n          <p>民生是人民幸福之基、社会和谐之本。</p>\n          <p>[illegible]</p>\n          <p>发展为了人民、发展依靠人民、发展成果由人民共享。</p>\n          <p>[illegible]</p>\n        </article>\n      </div>\n\n      <article class=\"quote-section\">\n        <div class=\"quote-label\">总书记两会上的这句话</div>\n        <h2 class=\"quote-title\">“没有高质量发展，就谈不上社会主义现代化”</h2>\n        <div class=\"quote-attribution\">本报记者　[illegible]</div>\n        <div class=\"quote-body\">\n          <p>春来潮涌，万象更新。全国两会即将召开，代表委员带着人民心声齐聚北京。</p>\n          <p>[illegible]</p>\n          <p>高质量发展是全面建设社会主义现代化国家的首要任务。</p>\n          <p>[illegible]</p>\n          <p>牢牢把握高质量发展这个首要任务，因地制宜发展新质生产力。</p>\n          <p>[illegible]</p>\n          <p>发展新质生产力不是忽视、放弃传统产业，要用新技术改造提升传统产业。</p>\n          <p>[illegible]</p>\n          <p>中国式现代化关键在科技现代化。</p>\n          <p>[illegible]</p>\n          <p class=\"note\">（相关报道见第二版）</p>\n        </div>\n      </article>\n    </section>\n  </section>\n\n  <section class=\"bottom\">\n    <section class=\"cppcc\">\n      <h2>全国政协十四届常委会第十次会议开幕</h2>\n      <h3>王沪宁出席</h3>\n      <div class=\"cppcc-body\">\n        <p>新华社北京3月1日电　政协第十四届全国委员会常务委员会第十次会议3月1日上午在北京开幕。中共中央政治局常委、全国政协主席王沪宁出席开幕会。</p>\n        <p>[illegible]</p>\n        <p>会议审议通过关于召开政协第十四届全国委员会第三次会议的决定等。</p>\n        <p>[illegible]</p>\n      </div>\n\n      <article class=\"aircraft\">\n        <h2>大型水陆两栖飞机AG600“鲲龙”<br>完成全部取证试飞科目</h2>\n        <div class=\"aircraft-text\">\n          <p>本报北京3月1日电（记者[illegible]）记者从中国航空工业集团有限公司获悉：AG600“鲲龙”大型水陆两栖飞机完成全部取证试飞科目。</p>\n          <p>[illegible]</p>\n        </div>\n      </article>\n    </section>\n\n    <article class=\"bridge\">\n      <h2>架起高效畅通的民意桥梁</h2>\n      <div class=\"bridge-subtitle\">——为代表委员履职能力提供制度保障</div>\n      <div class=\"bridge-author\">本报记者　[illegible]</div>\n      <div class=\"bridge-body\">\n        <p>在春天启航，向未来进发。近3000名全国人大代表、2000多名全国政协委员齐聚首都北京，共商国是、共谋发展。</p>\n        <p>习近平总书记强调：“各国家机关要支持和保障人大代表依法履职，充分发挥人大代表作用。”</p>\n        <p>[illegible]</p>\n        <h3>联系群众更加密切</h3>\n        <p>代表委员来自人民、植根人民，依法履职、担当尽责，把群众的意见建议带到全国两会。</p>\n        <p>[illegible]</p>\n        <h3>履职能力不断提高</h3>\n        <p>一条条建议、一件件提案，凝结着深入调研和认真思考。</p>\n        <p>[illegible]</p>\n        <p class=\"note\">（下转第三版）</p>\n      </div>\n    </article>\n  </section>\n</main>\n</body>\n</html>"
      },
