        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>光明日报 2025年2月28日</title>\n<script>\nwindow.MathJax = {\n  tex: {inlineMath: [['$', '$']], displayMath: [['$$', '$$']]}\n};\n</script>\n<script defer src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;background:#ececec;color:#111}\nbody{font-family:\"Noto Serif SC\",\"Songti SC\",\"SimSun\",serif}\n.page{\n  width:1262px;\n  min-height:1536px;\n  margin:0 auto;\n  padding:30px 21px 20px;\n  background:#fff;\n}\n.header{\n  display:grid;\n  grid-template-columns:590px 1fr;\n  column-gap:30px;\n  height:284px;\n  border-bottom:1px solid #555;\n}\n.brand{padding:0 11px}\n.logo{\n  height:202px;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  color:#c9002b;\n  font-family:\"STKaiti\",\"KaiTi\",cursive;\n  font-size:116px;\n  font-weight:700;\n  letter-spacing:8px;\n  transform:rotate(-2deg);\n  white-space:nowrap;\n}\n.roman{\n  margin-top:-3px;\n  text-align:center;\n  font-family:Arial,sans-serif;\n  font-size:20px;\n  letter-spacing:9px;\n}\n.datebar{\n  height:25px;\n  margin-top:10px;\n  background:#076b9d;\n  color:#fff;\n  text-align:center;\n  font-family:Arial,\"Microsoft YaHei\",sans-serif;\n  font-weight:700;\n  font-size:15px;\n  line-height:25px;\n  word-spacing:16px;\n}\n.issue{\n  margin-top:10px;\n  font-family:Arial,\"Microsoft YaHei\",sans-serif;\n  font-size:11px;\n  font-weight:700;\n  text-align:center;\n}\n.top-news{padding-top:4px}\n.top-news h1{\n  margin:0 0 14px;\n  font-family:\"Microsoft YaHei\",\"SimHei\",sans-serif;\n  font-size:43px;\n  line-height:1.47;\n  letter-spacing:2px;\n  font-weight:900;\n}\n.top-columns{\n  display:grid;\n  grid-template-columns:1fr 1fr;\n  gap:22px;\n  font-size:10.8px;\n  line-height:1.53;\n  text-align:justify;\n}\n.top-columns p{margin:0 0 5px;text-indent:2em}\n.top-columns h2{\n  font-size:16px;\n  margin:2px 0 4px;\n  text-align:center;\n  font-weight:900;\n}\n.hero{\n  height:558px;\n  margin-top:14px;\n  padding:13px 13px 0;\n  background:linear-gradient(#d7e6f6 0,#edf4fb 45%,#fff 84%);\n  border-bottom:1px solid #999;\n}\n.kicker{\n  text-align:center;\n  font-size:28px;\n  font-weight:900;\n  line-height:38px;\n}\n.hero-title{\n  margin:1px 0 7px;\n  text-align:center;\n  font-family:Arial,\"Microsoft YaHei\",\"SimHei\",sans-serif;\n  font-size:67px;\n  font-weight:900;\n  line-height:1.08;\n  letter-spacing:1px;\n}\n.hero-title .latin{font-family:Arial,sans-serif}\n.bullets{\n  width:970px;\n  margin:5px auto 7px;\n  display:grid;\n  grid-template-columns:1fr 1fr;\n  column-gap:42px;\n  font-family:\"Microsoft YaHei\",\"SimHei\",sans-serif;\n  font-size:20px;\n  font-weight:700;\n  line-height:28px;\n}\n.bullet{white-space:nowrap}\n.dot{\n  display:inline-block;\n  width:16px;height:16px;\n  border-radius:50%;\n  background:#e5003d;\n  margin-right:7px;\n  vertical-align:-1px;\n}\n.byline{text-align:center;font-size:12px;margin:0 0 11px}\n.hero-grid{\n  display:grid;\n  grid-template-columns:202px 252px 257px 253px 193px;\n  gap:13px;\n  align-items:start;\n}\n.text-col{\n  font-size:10.8px;\n  line-height:1.55;\n  text-align:justify;\n}\n.text-col p{margin:0 0 6px;text-indent:2em}\n.photo{\n  height:172px;\n  border:1px solid #777;\n  background:#d4d8d9;\n  overflow:hidden;\n  position:relative;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  text-align:center;\n  color:#555;\n  font-family:Arial,sans-serif;\n  font-size:12px;\n}\n.robot{\n  background:\n    linear-gradient(125deg,rgba(255,255,255,.82),rgba(107,141,164,.28)),\n    repeating-linear-gradient(90deg,#c8d4dc 0 35px,#e7ecef 35px 69px);\n}\n.sweeper{\n  background:\n    linear-gradient(0deg,#65665d 0 22%,transparent 22%),\n    linear-gradient(110deg,#547345,#bed1a7 42%,#46654e);\n}\n.office{\n  background: