t-weight: 500;\n    letter-spacing: -0.55px;\n  }\n\n  .section-title {\n    height: 24px;\n    margin: 0 0 0 0;\n    font-weight: 700;\n  }\n\n  .section-title span {\n    display: inline;\n    padding: 0 3px 1px 2px;\n    background:\n      linear-gradient(\n        to bottom,\n        transparent 8%,\n        #fff257 8%,\n        #fff257 91%,\n        transparent 91%\n      );\n  }\n\n  .line {\n    height: 24.4px;\n    white-space: nowrap;\n  }\n\n  .indent {\n    padding-left: 47px;\n  }\n\n  .continuation {\n    padding-left: 0;\n  }\n\n  .section-gap {\n    height: 20px;\n  }\n\n  .yellow {\n    padding: 0 1px;\n    background:\n      linear-gradient(\n        to bottom,\n        transparent 17%,\n        #ffef42 17%,\n        #ffef42 92%,\n        transparent 92%\n      );\n  }\n\n  .orange {\n    padding: 0 1px;\n    background:\n      linear-gradient(\n        to bottom,\n        transparent 17%,\n        #f7a65f 17%,\n        #f7a65f 92%,\n        transparent 92%\n      );\n  }\n\n  .badge {\n    position: absolute;\n    z-index: 4;\n    top: 100px;\n    right: 50px;\n    width: 79px;\n    height: 44px;\n    border: 5px solid #f0443f;\n    border-radius: 52% 50%;\n    transform: rotate(-11deg);\n    background: rgba(255, 255, 255, 0.78);\n  }\n\n  .badge-inner {\n    position: absolute;\n    left: 13px;\n    top: 5px;\n    color: #23c9de;\n    font-size: 21px;\n    line-height: 24px;\n    font-weight: 900;\n    letter-spacing: -2px;\n    text-shadow:\n      1px 0 #23c9de,\n      -1px 0 #23c9de;\n  }\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <header class=\"title\"><span class=\"title-mark\">一天考过科目一最全知识点!</span></header>\n\n  <div class=\"badge\" aria-label=\"超全\">\n    <div class=\"badge-inner\">超全</div>\n  </div>\n\n  <div class=\"content\">\n    <section>\n      <div class=\"section-title\"><span>三、酒驾相关</span></div>\n      <div class=\"line\">1.公安机关交通管理部门<span class=\"orange\">约束至酒醒</span>。</div>\n      <div class=\"line\">2.处<span class=\"orange\">200-2000元</span>罚款，吊销驾驶证。</div>\n      <div class=\"line\">3.<span class=\"orange\">五年内不得</span>重新取得机动车驾驶证。</div>\n      <div class=\"line\">4.<span class=\"orange\">血液</span>酒精含量:</div>\n      <div class=\"line indent\">a)<span class=\"orange\">20-80mg</span>/ml，酒驾；　b)<span class=\"orange\">80-100mg</span>/ml，醉驾。</div>\n    </section>\n\n    <div class=\"section-gap\"></div>\n\n    <section>\n      <div class=\"section-title\"><span>四、行政</span></div>\n      <div class=\"line\">1.通过路口<span class=\"yellow\">交替使用远近光灯</span>。</div>\n      <div class=\"line\">2.不靠山体的车比较危险，<span class=\"yellow\">会车时先走</span>。</div>\n      <div class=\"line\">3.高速路会车时，<span class=\"yellow\">150米外</span>，改为近光灯。</div>\n      <div class=\"line\">4.<span class=\"yellow\">站3口5</span>:在站点(公交车站，消防站等)30米内，路口、窄路等50米</div>\n      <div class=\"line continuation\">内不得停车。</div>\n      <div class=\"line\">5.实习期间，应让<span class=\"yellow\">3年以上驾龄</span>陪驾。</div>\n      <div class=\"line\">6.在路口，靠路口中心点位应该<span class=\"yellow\">左侧转弯</span></div>\n      <div class=\"line\">7.<span class=\"yellow\">右方道路来车先行</span>，然后看谁的右方没车就谁先行。</div>\n      <div class=\"line\">8.<span class=\"yellow\">转弯车辆</span>让直行车辆先行。</div>\n      <div class=\"line\">9.准备进入环形路口的让<span class=\"yellow\">已在路口内的车</span>先行。</div>\n      <div class=\"line\">10.右转弯车让左转弯车辆先行如遇特殊车辆执行任务，不受规则</div>\n      <div class=\"line continuation\">限制，<span class=\"yellow\">应直接让行</span>。</div>\n      <div class=\"line\">11.当路口没有交通信号灯时，<span class=\"yellow\">减速慢行</span>。</div>\n      <div class=\"line\">12.路口已经过了转弯的地点，只能<span class=\"yellow\">继续向前行驶</span></div>\n      <div class=\"line\">13.驾驶机动车在道路上追逐竞驶，情节恶劣处<span class=\"yellow\">拘役，并处罚金</span>。</div>\n      <div class=\"line\">14.撞人问题:是否逃逸，逃逸与死亡时间前后</div>\n      <div class=\"line indent\">a)撞人没逃逸，<span class=\"yellow\">3年以下</span>；</div>\n      <div class=\"line indent\">b)撞人逃跑或撞伤逃跑后，未致人死亡，<span class=\"yellow\">3~7年</span>；</div>\n    </section>\n  </div>\n</main>\n</body>\n</html>"
