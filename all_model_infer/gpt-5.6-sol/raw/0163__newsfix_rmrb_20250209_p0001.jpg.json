ertical-rl;\n    text-orientation: upright;\n    font-size: 11px;\n    line-height: 1.25;\n  }\n\n  .lower {\n    display: grid;\n    grid-template-columns: 376px 1fr;\n    gap: 9px;\n    height: 122px;\n    margin-top: 5px;\n    padding-top: 5px;\n    border-top: 2px solid #333;\n    overflow: hidden;\n  }\n  .lower-left {\n    padding-right: 7px;\n    border-right: 1px solid #777;\n  }\n  .lower h2 {\n    margin: 0;\n    text-align: center;\n    font-size: 20px;\n    line-height: 1.25;\n    font-weight: normal;\n    white-space: nowrap;\n  }\n  .lower-left .kicker,\n  .sports .kicker {\n    margin: 2px 0 5px;\n    text-align: center;\n    font-size: 10px;\n    letter-spacing: 2px;\n  }\n  .lower-copy {\n    column-count: 3;\n    column-gap: 10px;\n    font-size: 5.8px;\n    line-height: 1.38;\n    text-align: justify;\n  }\n  .lower-copy p { margin: 0 0 3px; }\n  .sports h2 {\n    font-family: \"SimHei\", \"Heiti SC\", sans-serif;\n    font-size: 22px;\n    font-weight: 500;\n    letter-spacing: 7px;\n  }\n  .sports .kicker {\n    margin-bottom: 3px;\n  }\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <header class=\"top\">\n    <section class=\"masthead\">\n      <div class=\"logo\">人民日报</div>\n      <div class=\"roman\">RENMIN RIBAO</div>\n      <div class=\"website\">人民网网址：http://www.people.com.cn</div>\n    </section>\n\n    <section class=\"date-box\">\n      <div class=\"year\">2025年2月</div>\n      <div class=\"day\">9</div>\n      <div class=\"weekday\">星期日</div>\n      <div>乙巳年正月十二</div>\n      <div class=\"small\">人民日报社出版</div>\n      <div class=\"small\">国内统一连续出版物号<br>CN 11-0065</div>\n      <div class=\"small\">代号1-1<br>[illegible]<br>今日8版</div>\n    </section>\n\n    <section class=\"lead\">\n      <h1>习近平对四川宜宾市筠连县山体滑坡作出重要指示强调<br>千方百计搜救失联人员　防止发生次生灾害<br>切实保障人民群众生命财产安全</h1>\n      <div class=\"sub\">李强作出批示</div>\n      <div class=\"lead-copy\">\n        <p>新华社北京2月8日电　2月8日11时50分许，四川宜宾市筠连县[illegible]发生山体滑坡，[illegible]。</p>\n        <p>灾害发生后，习近平高度重视并作出重要指示，[illegible]。</p>\n        <p>[illegible]</p>\n        <p>中共中央政治局常委、国务院总理李强作出批示，[illegible]。</p>\n        <p>[illegible]</p>\n      </div>\n    </section>\n  </header>\n\n  <section class=\"main-heading\">\n    <h2>习近平在听取吉林省委和省政府工作汇报时强调<br>深入落实推动新时代东北全面振兴战略部署<br>在中国式现代化建设中展现更大作为</h2>\n    <div class=\"attendee\">蔡奇出席汇报会</div>\n  </section>\n\n  <section class=\"main-zone\">\n    <article class=\"article-left\">\n      <p class=\"dateline\">本报长春2月8日电　[illegible]</p>\n      <p>近日，中共中央总书记、国家主席、中央军委主席习近平听取吉林省委和省政府工作汇报。他强调，[illegible]。</p>\n      <p>[illegible]</p>\n      <p>习近平指出，[illegible]，深入落实推动新时代东北全面振兴战略部署，[illegible]。</p>\n      <p>[illegible]</p>\n      <p>习近平强调，[illegible]。要统筹发展和安全，[illegible]。</p>\n      <p>[illegible]</p>\n      <p>习近平强调，[illegible]，在中国式现代化建设中展现更大作为。</p>\n      <p>[illegible]</p>\n      <p>蔡奇出席汇报会。</p>\n      <p>[illegible]</p>\n      <p>[illegible]</p>\n    </article>\n\n    <article class=\"center-story\">\n      <figure style=\"margin:0\">\n        <div class=\"photo placeholder\">[Photo: centered]</div>\n        <figcaption class=\"caption\">\n          2月8日上午，习近平在听取吉林省委和省政府工作汇报时发表重要讲话。[illegible]\n          <span class=\"credit\">新华社记者　[illegible]　摄</span>\n        </figcaption>\n      </figure>\n      <div class=\"red-notes\">\n        <p class=\"red-note\">吉林要深入落实党中央关于推动新时代东北全面振兴的战略部署，牢牢把握东北在维护国家“五大安全”中的重要使命，[illegible]</p>\n        <p class=\"red-note\">高质量发展离不开创新驱动和产业支撑。要守牢实体经济这个根基，统筹推动传统产业转型、优势产业壮大和新质生产力培育，[illegible]</p>\n        <p class=\"red-note\">进一步全面深化改革开放对推动东北全面振兴至关重要。要紧紧围绕构建高水平社会主义市场经济体制，[illegible]</p>\n        <p class=\"red-note\">吉林要在加强生态环境系统治理、加快发展方式绿色转型等方面取得更大成效。[illegible]</p>\n        <p class=\"red-note\">要统筹发展和安全，任何时候都要绷紧安全这根弦。[illegible]</p>\n        <p class=\"red-note\">高质量发展需要高水平党建来引领。要巩固深化党纪学习教育成果，[illegible]</p>\n      </div>\n    </article>\n\n    <aside class=\"sidebar\">\n      <div class=\"side-copy\">\n        <p>习近平总书记强调：“深化经济体制改革仍是进一步全面深化改革的重点。”[illegible]</p>\n        <p>[illegible]</p>\n        <p class=\"side-emphasis\">牢牢把握“两个毫不动摇”，公有制经济、非公有制经济共同发展、相得益彰</p>\n        <p>“心无旁骛、实业报国”，[illegible]</p>\n        <p>一视同仁、公平竞争，[illegible]</p>\n        <p>[illegible]</p>\n        <p>激发各类经营主体活力，[illegible]</p>\n        <p>[illegible]</p>\n        <p>2025年，[illegible]</p>\n        <p>[illegible]</p>\n      </div>\n      <div class=\"vertical-title\">\n        <h3>推动标志性改革举措落地见效</h3>\n        <div class=\"series\">——二〇二五年“中国经济这么干③”</div>\n      </div>\n    </aside>\n  </section>\n\n  <footer class=\"lower\">\n    <section class=\"lower-left\">\n      <h2>2024年登记在册的企业数同比增长5.1%</h2>\n      <div class=\"kicker\">企业发展质量稳中有升</div>\n      <div class=\"lower-copy\">\n        <p>本报北京2月8日电　[illegible]</p>\n        <p>截至2024年底，[illegible]。</p>\n        <p>[illegible]</p>\n        <p>[illegible]</p>\n      </div>\n    </section>\n\n    <section class=\"sports\">\n      <div class=\"kicker\">亚冬会首个比赛日</div>\n      <h2>中国体育代表团获八金</h2>\n      <div class=\"lower-copy\">\n        <p>本报哈尔滨2月8日电　[illegible]</p>\n        <p>[illegible]</p>\n        <p>[illegible]</p>\n        <p>[illegible]</p>\n      </div>\n    </section>\n  </footer>\n</main>\n</body>\n</html>"
