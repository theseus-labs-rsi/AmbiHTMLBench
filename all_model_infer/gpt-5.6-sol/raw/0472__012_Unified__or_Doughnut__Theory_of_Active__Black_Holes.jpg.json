-gradient(ellipse at 15% 100%, #325f8a 0 29%, transparent 30%),\n      radial-gradient(circle at 72% 24%, rgba(180,214,255,.75), transparent 28%),\n      linear-gradient(145deg, #244a62, #202644 58%, #090f27);\n  }\n\n  .wise-spacecraft::before {\n    content: \"\";\n    position: absolute;\n    left: 69px;\n    top: 34px;\n    width: 49px;\n    height: 16px;\n    background: linear-gradient(90deg, #776b54 0 40%, #b8d8dc 42% 64%, #456f94 66%);\n    border: 1px solid #c9d1d2;\n    transform: rotate(-35deg);\n  }\n\n  .wise-spacecraft::after {\n    content: \"\";\n    position: absolute;\n    left: 91px;\n    top: 31px;\n    width: 22px;\n    height: 26px;\n    background: #a8c9db;\n    border: 1px solid white;\n    transform: rotate(-35deg);\n  }\n\n  .cluster {\n    left: 181px;\n    top: 46px;\n    width: 391px;\n    height: 201px;\n    border: 1px solid rgba(255,255,255,.2);\n    background:\n      radial-gradient(circle at 54% 51%, rgba(255,255,255,.95) 0 1px, transparent 2px),\n      radial-gradient(circle at 68% 39%, rgba(194,107,255,.9) 0 2px, transparent 3px),\n      radial-gradient(circle at 42% 58%, rgba(140,200,255,.85) 0 2px, transparent 3px),\n      radial-gradient(ellipse at 53% 54%, rgba(143,38,204,.8), rgba(62,28,119,.5) 27%, transparent 56%),\n      radial-gradient(ellipse at 28% 58%, rgba(105,31,162,.65), transparent 37%),\n      radial-gradient(ellipse at 77% 60%, rgba(94,36,151,.55), transparent 34%),\n      #020813;\n  }\n\n  .cluster::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    opacity: .85;\n    background-image:\n      radial-gradient(circle, #fff 0 1px, transparent 1.4px),\n      radial-gradient(circle, #9ec9ff 0 1px, transparent 1.4px),\n      radial-gradient(circle, #fff 0 .8px, transparent 1.2px);\n    background-size: 29px 31px, 43px 37px, 17px 23px;\n    background-position: 7px 9px, 12px 18px, 2px 4px;\n  }\n\n  .wise-left-copy {\n    position: absolute;\n    left: 19px;\n    top: 145px;\n    width: 151px;\n    color: white;\n    font-size: 10px;\n    line-height: 12px;\n    font-weight: 700;\n  }\n\n  .wise-left-copy p {\n    margin: 0 0 11px;\n  }\n\n  .cluster-caption {\n    position: absolute;\n    z-index: 7;\n    left: 184px;\n    top: 251px;\n    width: 390px;\n    margin: 0;\n    color: #fff;\n    font-size: 10px;\n    line-height: 12px;\n    font-weight: 700;\n  }\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <header class=\"masthead\">\n    <div class=\"placeholder nasa-logo\">\n      NASA\n      <span class=\"ph-caption\">[Logo: NASA]</span>\n    </div>\n    <div class=\"brand\">\n      Jet Propulsion Laboratory\n      <small>California Institute of Technology</small>\n    </div>\n  </header>\n\n  <section class=\"anatomy\">\n    <h1>Anatomy of an Active Black Hole</h1>\n\n    <div class=\"beam\" aria-hidden=\"true\"></div>\n\n    <div class=\"placeholder circle black-hole\">\n      <span class=\"ph-caption\">[Illustration: Supermassive black hole]</span>\n      <div class=\"inside-label\">\n        Supermassive Black Hole<br>\n        <em>Size: as big as Mercury’s orbit</em>\n      </div>\n    </div>\n\n    <div class=\"placeholder circle host-galaxy\">\n      <span class=\"ph-caption\">[Illustration: Host galaxy]</span>\n      <div class=\"inside-label\">\n        Host Galaxy<br>\n        <em>Size: about 100,000 light-years</em>\n      </div>\n    </div>\n\n    <div class=\"placeholder circle dust-ring\">\n      <span class=\"ph-caption\">[Illustration: Doughnut ring of dust and gas]</span>\n      <div class=\"inside-label\">\n        “Doughnut” Ring of Dust &amp; Gas<br>\n        <em>Size: around 1 light-year</em>\n      </div>\n    </div>\n\n    <p class=\"small-copy anatomy-left-copy\">\n      Astronomers call supermassive black<br>\n      holes and their surrounding disks<br>\n      “Active Galactic Nuclei” or “AGN”\n    </p>\n\n    <p class=\"small-copy anatomy-right-copy\">\n      Black holes emit no light, but<br>\n      the glow from the bright<br>\n      material swirling around them<br>\n      can be seen by telescopes.\n    </p>\n  </section>\n\n  <section class=\"different\">\n    <h2>Why Do Active Black Holes Look Different?</h2>\n\n    <div class=\"placeholder circle face-on\">\n      <span class=\"ph-caption\">[Illustration: Face-on active black hole]</span>\n    </div>\n\n    <div class=\"unified-copy\">\n      <p>\n        In some galaxies the<br>\n        black hole regions are<br>\n        <em>incredibly bright</em>, while in<br>\n        other galaxies they<br>\n        appear <em>much darker</em>.\n      </p>\n      <p>\n        A <em>“unified model”</em><br>\n        suggests the angle at<br>\n        which we view them can<br>\n        explain the differences.\n      </p>\n    </div>\n\n    <div class=\"placeholder circle edge-on\">\n      <span class=\"ph-caption\">[Illustration: Edge-on dusty doughnut]</span>\n    </div>\n\n    <p class=\"small-copy face-caption\">\n      Seen face-on, we detect the light from the<br>\n      hot material surrounding the black hole.\n    </p>\n\n    <p class=\"small-copy edge-caption\">\n      When viewed through the edge of the dusty<br>\n      doughnut, the black hole is hidden.\n    </p>\n  </section>\n\n  <section class=\"expect\">\n    <h2>What We Expect to See</h2>\n\n    <div class=\"placeholder galaxy edge g1\"><span class=\"ph-caption\">[Galaxy: edge-on]</span></div>\n    <div class=\"placeholder galaxy edge g2\"><span class=\"ph-caption\">[Galaxy: edge-on]</span></div>\n    <div class=\"placeholder galaxy edge g3\"><span class=\"ph-caption\">[Galaxy: edge-on]</span></div>\n    <div class=\"placeholder galaxy face g4\"><span class=\"ph-caption\">[Galaxy: face-on]</span></div>\n    <div class=\"placeholder galaxy face g5\"><span class=\"ph-caption\">[Galaxy: face-on]</span></div>\n    <div class=\"placeholder galaxy face g6\"><span class=\"ph-caption\">[Galaxy: face-on]</span></div>\n    <div class=\"placeholder galaxy edge g7\"><span class=\"ph-caption\">[Galaxy: edge-on]</span></div>\n    <div class=\"placeholder galaxy edge g8\"><span class=\"ph-caption\">[Galaxy: edge-on]</span></div>\n    <div class=\"placeholder galaxy face g9\"><span class=\"ph-caption\">[Galaxy: tilted]</span></div>\n    <div class=\"placeholder galaxy face g10\"><span class=\"ph-caption\">[Galaxy: face-on]</span></div>\n    <div class=\"placeholder galaxy edge g11\"><span class=\"ph-caption\">[Galaxy: edge-on]</span></div>\n\n    <div class=\"expect-copy\">\n      <p>\n        Galaxies are oriented randomly in the sky so the disks<br>\n        in their centers should be oriented randomly as well.\n      </p>\n      <p>\n        Thus we expect to see a random mix of exposed and<br>\n        hidden black holes <em>everywhere we look.</em>\n      </p>\n    </div>\n  </section>\n\n  <section class=\"wise\">\n    <h2>WISE Observations Challenge “Unified Model”</h2>\n\n    <div class=\"placeholder wise-spacecraft\">\n      <span class=\"ph-caption\">[Illustration: NASA Wide-field Infrared Survey Explorer spacecraft]</span>\n    </div>\n\n    <div class=\"placeholder cluster\">\n      <span class=\"ph-caption\">[Illustration: Strongly clumped galaxies and purple dark matter halos]</span>\n    </div>\n\n    <div class=\"wise-left-copy\">\n      <p>\n        Observations with NASA’s Wide-<br>\n        field Infrared Survey Explorer<br>\n        reveal that hidden black holes<br>\n        tend to be <em>more clumped<br>\n        together</em> than exposed ones.\n      </p>\n      <p>\n        This violates the “unified model,”<br>\n        which predicts we should see<br>\n        the same random distribution of<br>\n        dusty doughnuts regardless of<br>\n        how clumped the objects are.\n      </p>\n    </div>\n\n    <p class=\"cluster-caption\">\n      Strongly clumped galaxies are likely to have larger halos of dark matter (shown<br>\n      artistically here in purple), which might provide a clue about what else besides the<br>\n      doughnuts could be hiding the black holes.\n    </p>\n  </section>\n</main>\n</body>\n</html>"
