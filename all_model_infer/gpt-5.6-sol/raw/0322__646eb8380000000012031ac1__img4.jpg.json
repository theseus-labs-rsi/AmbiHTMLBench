        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>绕口令儿歌</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] },\n  svg: { fontCache: 'global' }\n};\n</script>\n<script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js\"></script>\n<style>\n  * {\n    box-sizing: border-box;\n  }\n\n  html,\n  body {\n    margin: 0;\n    padding: 0;\n    background: #ffffff;\n  }\n\n  body {\n    display: flex;\n    justify-content: center;\n    align-items: flex-start;\n    min-height: 100vh;\n  }\n\n  .page {\n    position: relative;\n    width: 540px;\n    height: 722px;\n    overflow: hidden;\n    background: #ffffff;\n    color: #292929;\n    font-family: \"KaiTi\", \"STKaiti\", \"Kaiti SC\", \"Microsoft YaHei\", serif;\n  }\n\n  .page-border {\n    position: absolute;\n    z-index: 1;\n    top: 8px;\n    right: 7px;\n    bottom: 7px;\n    left: 8px;\n    border: 3px solid #24acd0;\n    box-shadow:\n      inset 0 0 0 1px #9de5ef,\n      0 0 0 1px #b8edf3;\n    pointer-events: none;\n  }\n\n  .poem {\n    position: absolute;\n    z-index: 2;\n  }\n\n  .top-left {\n    top: 34px;\n    left: 21px;\n    width: 246px;\n  }\n\n  .top-right {\n    top: 34px;\n    left: 274px;\n    width: 258px;\n  }\n\n  .bottom-left {\n    top: 394px;\n    left: 24px;\n    width: 238px;\n  }\n\n  .bottom-right {\n    top: 394px;\n    left: 274px;\n    width: 238px;\n  }\n\n  .title {\n    margin: 0 0 12px 10px;\n    color: #3972d0;\n    font-family: \"Microsoft YaHei\", \"PingFang SC\", \"Noto Sans CJK SC\", sans-serif;\n    font-size: 22px;\n    font-weight: 700;\n    line-height: 30px;\n    white-space: nowrap;\n  }\n\n  .top-right .title,\n  .bottom-right .title {\n    margin-left: 0;\n  }\n\n  .lines {\n    font-size: 18px;\n    font-weight: 400;\n    line-height: 25px;\n    white-space: nowrap;\n  }\n\n  .top-right .lines,\n  .bottom-right .lines {\n    margin-left: 5px;\n  }\n\n  .line {\n    height: 25px;\n  }\n\n  .placeholder {\n    position: absolute;\n    z-index: 3;\n  }\n\n  .visual-caption {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    overflow: hidden;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n  }\n\n  .sun {\n    top: 10px;\n    left: 11px;\n    width: 28px;\n    height: 29px;\n  }\n\n  .sun-core {\n    position: absolute;\n    top: 5px;\n    left: 6px;\n    width: 14px;\n    height: 14px;\n    border-radius: 50%;\n    background: #f4d52e;\n    box-shadow: 0 0 2px rgba(220, 177, 0, 0.35);\n  }\n\n  .ray {\n    position: absolute;\n    top: 0;\n    left: 12px;\n    width: 2px;\n    height: 6px;\n    border-radius: 2px;\n    background: #f1d129;\n    transform-origin: 1px 14px;\n  }\n\n  .ray:nth-of-type(2) { transform: rotate(45deg); }\n  .ray:nth-of-type(3) { transform: rotate(90deg); }\n  .ray:nth-of-type(4) { transform: rotate(135deg); }\n  .ray:nth-of-type(5) { transform: rotate(180deg); }\n  .ray:nth-of-type(6) { transform: rotate(225deg); }\n  .ray:nth-of-type(7) { transform: rotate(270deg); }\n  .ray:nth-of-type(8) { transform: rotate(315deg); }\n\n  .drink {\n    right: 9px;\n    bottom: 11px;\n    width: 33px;\n    height: 65px;\n  }\n\n  .glass {\n    position: absolute;\n    right: 2px;\n    bottom: 0;\n    width: 25px;\n    height: 40px;\n    border: 2px solid #58bfd4;\n    border-radius: 2px 2px 7px 7px;\n    background: rgba(184, 237, 245, 0.14);\n    clip-path: polygon(0 0, 100% 0, 82% 100%, 18% 100%);\n  }\n\n  .glass::before {\n    content: \"\";\n    position: absolute;\n    top: 5px;\n    left: 2px;\n    width: 19px;\n    height: 2px;\n    background: #7ad0df;\n    transform: rotate(8deg);\n  }\n\n  .straw {\n    position: absolute;\n    top: 0;\n    right: 8px;\n    width: 2px;\n    height: 53px;\n    background: #4eb5ce;\n    transform: rotate(16deg);\n    transform-origin: bottom center;\n  }\n\n  .straw::after {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 2px;\n    height: 12px;\n    background: #4eb5ce;\n  }\n\n  @media (max-width: 540px) {\n    body {\n      justify-content: flex-start;\n    }\n\n    .page {\n      transform-origin: top left;\n    }\n  }\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <div class=\"page-border\"></div>\n\n  <div class=\"placeholder sun\">\n    <span class=\"visual-caption\">[Illustration: sun at top-left]</span>\n    <div class=\"sun-core\"></div>\n    <span class=\"ray\"></span>\n    <span class=\"ray\"></span>\n    <span class=\"ray\"></span>\n    <span class=\"ray\"></span>\n    <span class=\"ray\"></span>\n    <span class=\"ray\"></span>\n    <span class=\"ray\"></span>\n    <span class=\"ray\"></span>\n  </div>\n\n  <section class=\"poem top-left\">\n    <h2 class=\"title\">《猫吃桃》</h2>\n    <div class=\"lines\">\n      <div class=\"line\">河边有座窑，</div>\n      <div class=\"line\">窑上有个槽，</div>\n      <div class=\"line\">槽里放件袍，</div>\n      <div class=\"line\">袍包个桃。</div>\n      <div class=\"line\">对岸有只猫，</div>\n      <div class=\"line\">想吃窑上槽里袍包桃，</div>\n      <div class=\"line\">可惜岸上没有桥。</div>\n      <div class=\"line\">过不了河，</div>\n      <div class=\"line\">上不了窑，</div>\n      <div class=\"line\">够不着槽，</div>\n      <div class=\"line\">咬不住袍，</div>\n      <div class=\"line\">吃不了桃。</div>\n    </div>\n  </section>\n\n  <section class=\"poem top-right\">\n    <h2 class=\"title\">《数青蛙》</h2>\n    <div class=\"lines\">\n      <div class=\"line\">一只青蛙一张嘴，</div>\n      <div class=\"line\">两只眼睛四条腿，</div>\n      <div class=\"line\">扑通一声跳下水。</div>\n      <div class=\"line\">两只青蛙两张嘴，</div>\n      <div class=\"line\">四只眼睛八条腿，</div>\n      <div class=\"line\">扑通扑通两声跳下水。</div>\n      <div class=\"line\">三只青蛙三张嘴，</div>\n      <div class=\"line\">六只眼睛十二条腿，</div>\n      <div class=\"line\">扑通扑通扑通三声跳下水。</div>\n      <div class=\"line\">四只青蛙四张嘴，</div>\n      <div class=\"line\">八只眼睛十六条腿，</div>\n      <div class=\"line\">扑通扑通扑通扑通四声跳下水。</div>\n    </div>\n  </section>\n\n  <section class=\"poem bottom-left\">\n    <h2 class=\"title\">《姥姥有个宝宝》</h2>\n    <div class=\"lines\">\n      <div class=\"line\">姥姥有个宝宝，</div>\n      <div class=\"line\">宝宝有位姥姥，</div>\n      <div class=\"line\">姥姥疼爱宝宝，</div>\n      <div class=\"line\">宝宝喜爱姥姥。</div>\n      <div class=\"line\">姥姥天天抱宝宝，</div>\n      <div class=\"line\">宝宝天天亲姥姥，</div>\n      <div class=\"line\">姥姥老，走不好，</div>\n      <div class=\"line\">抱着宝宝摔一跤，</div>\n      <div class=\"line\">跌了姥姥，摔了宝宝，</div>\n      <div class=\"line\">宝宝连忙扶姥姥，</div>\n      <div class=\"line\">姥姥赶快抱宝宝。</div>\n    </div>\n  </section>\n\n  <section class=\"poem bottom-right\">\n    <h2 class=\"title\">《南南有个篮》</h2>\n    <div class=\"lines\">\n      <div class=\"line\">南南有个篮篮，</div>\n      <div class=\"line\">篮篮装着盘盘，</div>\n      <div class=\"line\">盘盘放着碗碗，</div>\n      <div class=\"line\">碗碗盛着饭饭。</div>\n      <div class=\"line\">南南翻了篮篮，</div>\n      <div class=\"line\">篮篮扣了盘盘，</div>\n      <div class=\"line\">盘盘打了碗碗，</div>\n      <div class=\"line\">碗碗撒了饭饭。</div>\n    </div>\n  </section>\n\n  <div class=\"placeholder drink\">\n    <span class=\"visual-caption\">[Illustration: drinking glass with straw at bottom-right]</span>\n    <div class=\"straw\"></div>\n    <div class=\"glass\"></div>\n  </div>\n</main>\n</body>\n</html>"
