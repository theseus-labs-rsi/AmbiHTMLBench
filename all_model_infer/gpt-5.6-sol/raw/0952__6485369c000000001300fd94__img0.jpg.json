in-left:13px;\n  font-size:11px;\n  line-height:1.48;\n}\n.feeding-grid .label{font-weight:700}\n.subrows{display:grid;grid-template-columns:62px 1fr}\n.bottom-note{\n  position:absolute;\n  left:31px;\n  right:34px;\n  bottom:20px;\n  min-height:18px;\n  padding:3px 7px;\n  transform:rotate(-2deg);\n  color:#5d672e;\n  background:#b5c06a;\n  font-size:8px;\n  line-height:1.35;\n}\n.recipe-heading{\n  margin:0 0 12px;\n  color:#58751e;\n  font-size:16px;\n  font-weight:700;\n}\n.recipe{\n  margin:0 0 14px;\n  font-size:10px;\n  line-height:1.48;\n}\n.recipe-label{\n  display:inline-block;\n  margin:0 0 4px -4px;\n  padding:2px 10px 2px 7px;\n  border-radius:10px 13px 13px 10px;\n  color:#34430e;\n  background:#8fa640;\n  font-size:11px;\n  line-height:1.25;\n  font-weight:700;\n}\n.ingredients{margin:0 0 1px}\n.method{margin:0}\n.method strong,.ingredients strong{font-weight:700}\n.recipe ol{\n  margin:1px 0 0 33px;\n  padding-left:14px;\n}\n.recipe li{padding-left:1px;margin-bottom:1px}\n.rule-note{\n  margin:5px 0 13px;\n  padding:3px 5px;\n  color:#596426;\n  background:#b6c36f;\n  font-size:8px;\n  line-height:1.35;\n}\n@media(max-width:1120px){\n  body{padding:10px}\n  .spread{transform:scale(calc((100vw - 20px)/1080));margin-bottom:calc(-750px + (750px * ((100vw - 20px)/1080)))}\n}\n</style>\n</head>\n<body>\n<main class=\"spread\">\n  <section class=\"page left-page\">\n    <header class=\"top-band\">\n      <h1>11 月龄宝宝的精细过渡</h1>\n    </header>\n\n    <section class=\"section\">\n      <h2 class=\"section-title\">喂养要点</h2>\n      <ul class=\"text-list\">\n        <li>辅食注意荤、素、肉合理搭配，保证主食摄入量</li>\n        <li>注意为宝宝准备容易消化的食物，鼓励他学会进食</li>\n        <li>如果给宝宝吃汤泡饭、零食，要学会控制[illegible]</li>\n        <li>如果宝宝[illegible]，可用相对喜欢的食物替代练习</li>\n        <li>继续定期给宝宝补充鱼肝油，适量晒太阳加强[illegible]</li>\n      </ul>\n    </section>\n\n    <section class=\"section\">\n      <h2 class=\"section-title\">搭配建议</h2>\n      <p class=\"intro\">较大的块状食物（如水饺、面条、南瓜、蔬菜、饭团等）。</p>\n      <div class=\"food-layout\" aria-label=\"食物搭配图片\">\n        <div class=\"food-item i1\">\n          <div class=\"food-photo placeholder\">[食物照片]</div>\n          <span>水饺</span>\n        </div>\n        <div class=\"food-item i2\">\n          <div class=\"food-photo placeholder\">[食物照片]</div>\n          <span>面条</span>\n        </div>\n        <div class=\"food-item i3\">\n          <div class=\"food-photo placeholder\">[食物照片]</div>\n          <span>[?]肉</span>\n        </div>\n        <div class=\"food-item i4\">\n          <div class=\"food-photo placeholder\">[食物照片]</div>\n          <span>蔬菜</span>\n        </div>\n        <div class=\"food-item i5\">\n          <div class=\"food-photo placeholder\">[食物照片]</div>\n          <span>南瓜</span>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section\">\n      <h2 class=\"section-title\">喂养建议</h2>\n      <div class=\"feeding-grid\">\n        <div class=\"label\">母乳喂养</div>\n        <div>每日 2～4 次，约计 600～700ml</div>\n\n        <div class=\"label\">辅食喂养</div>\n        <div>每日 2～3 次，每次 3/4 碗</div>\n\n        <div class=\"label\">食物选择</div>\n        <div class=\"subrows\">\n          <span><strong>谷薯类：</strong></span><span>面条、碎米饭、小馒头、面包 12～34 克</span>\n          <span><strong>蔬菜类：</strong></span><span>碎菜 1/2 碗</span>\n          <span><strong>水果类：</strong></span><span>水果小块 1/2 碗</span>\n          <span><strong>肉、蛋、鱼、豆类：</strong></span><span>碎肉、鱼、蛋 4～6 勺</span>\n        </div>\n\n        <div class=\"label\">油脂</div>\n        <div>每日 5～10g，不加盐</div>\n      </div>\n    </section>\n\n    <div class=\"bottom-note\">注意：[illegible]</div>\n  </section>\n\n  <section class=\"page right-page\">\n    <header class=\"top-band\"></header>\n\n    <h2 class=\"recipe-heading\">经典食谱</h2>\n\n    <article class=\"recipe\">\n      <h3 class=\"recipe-label\">食谱一　[illegible]</h3>\n      <p class=\"ingredients\"><strong>用料：</strong>面条、肉馅、面粉、葱、食用油、水</p>\n      <div class=\"method\"><strong>做法：</strong>\n        <ol>\n          <li>用香油将肉馅炒熟