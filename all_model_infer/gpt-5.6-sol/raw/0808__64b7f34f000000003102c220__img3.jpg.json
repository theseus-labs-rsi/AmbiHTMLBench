1fr 1fr;\n      gap: 12px;\n      margin-top: 5px;\n    }\n\n    .n2 {\n      left: 545px;\n      top: 25px;\n      width: 185px;\n    }\n\n    .n3 {\n      left: 363px;\n      top: 21px;\n      width: 169px;\n    }\n\n    .n4 {\n      left: 20px;\n      top: 18px;\n      width: 329px;\n    }\n\n    .n4 .split {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 13px;\n    }\n\n    .n5 {\n      left: 798px;\n      top: 264px;\n      width: 294px;\n    }\n\n    .n6 {\n      left: 568px;\n      top: 259px;\n      width: 214px;\n    }\n\n    .n7 {\n      left: 351px;\n      top: 260px;\n      width: 202px;\n    }\n\n    .n8 {\n      left: 17px;\n      top: 259px;\n      width: 317px;\n    }\n\n    .n9 {\n      left: 755px;\n      top: 553px;\n      width: 339px;\n    }\n\n    .n10 {\n      left: 518px;\n      top: 554px;\n      width: 219px;\n    }\n\n    .n11 {\n      left: 268px;\n      top: 549px;\n      width: 230px;\n    }\n\n    .n12 {\n      left: 18px;\n      top: 548px;\n      width: 229px;\n    }\n\n    .top-label {\n      position: absolute;\n      top: 3px;\n      left: 744px;\n      width: 348px;\n      text-align: right;\n      color: #057d72;\n      font-size: 19px;\n      font-weight: 700;\n    }\n\n    .side-label {\n      position: absolute;\n      left: 9px;\n      top: 519px;\n      color: #167d74;\n      font-size: 16px;\n      font-weight: 700;\n    }\n\n    ul {\n      margin: 2px 0 2px 17px;\n      padding: 0;\n    }\n\n    li {\n      margin: 0;\n    }\n\n    @media (max-width: 1155px) {\n      body {\n        padding: 0;\n        overflow-x: auto;\n      }\n\n      .page {\n        margin: 0;\n      }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <div class=\"top-label cyan\">乡土社会的基本社会结构特征</div>\n\n    <section class=\"note n1\">\n      <div class=\"heading cyan\">①乡土本色</div>\n      <div class=\"columns small\">\n        <div>\n          <p class=\"subheading\">乡土社会</p>\n          <p>“土”是乡土社会的本色。</p>\n          <p>[illegible]</p>\n          <p>农业和土地不能分离，人口附着在土地上。</p>\n          <p class=\"green\">安土重迁</p>\n        </div>\n        <div class=\"boxed\">\n          <p>乡土社会是熟人社会。</p>\n          <p>生活富于地方性。</p>\n          <p>[illegible]</p>\n          <p>从熟悉里得到信任。</p>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"note n2\">\n      <div class=\"heading cyan\">②文字下乡</div>\n      <p class=\"small\">文字是间接的说话。</p>\n      <p class=\"small\">面对面的社群里，人们可以用声音、表情和动作传情达意。</p>\n      <p class=\"small blue\">[illegible]</p>\n      <p class=\"small\">文字所能传的情、达的意是不完全的。</p>\n    </section>\n\n    <section class=\"note n3\">\n      <div class=\"heading cyan\">③再论文字下乡</div>\n      <p class=\"small\">时间上的阻隔：</p>\n      <p class=\"small\">个人的今昔之隔，社会的世代之隔。</p>\n      <p class=\"small\">乡土社会中经验在同一生活定型中反复发生。</p>\n      <p class=\"small blue\">语言足够传递世代间的经验。</p>\n      <p class=\"tiny\">[illegible]</p>\n    </section>\n\n    <section class=\"note n4\">\n      <div class=\"split\">\n        <div>\n          <div class=\"heading cyan\">④差序格局</div>\n          <p class=\"small\">以“己”为中心，像石子投入水中形成的波纹。</p>\n          <p class=\"small\">每个人都是他社会影响所推出去的圈子的中心。</p>\n          <p class=\"small red\">范围的大小依中心势力厚薄而定。</p>\n        </div>\n        <div>\n          <div class=\"heading cyan\">⑤系维着私人的道德</div>\n          <p class=\"small\">社会结构格局的差别引起不同的道德观念。</p>\n          <p class=\"small\">团体格局中，道德的基本观念建立在团体和个人的关系上。</p>\n          <p class=\"small\">差序格局中，道德体系以私人关系为基础。</p>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"note n5\">\n      <div class=\"heading cyan\">⑥家族</div>\n      <p class=\"small\"><span class=\"boxed\">氏族</span>是以血缘为基础的生育社群。</p>\n      <p class=\"small\">家族可以包括很广的范围，氏族是家族的扩大。</p>\n      <p class=\"small\">乡土社会中的家是绵续性的事业组织。</p>\n      <p class=\"small red\">主轴在父子、婆媳之间，是纵的。</p>\n      <p class=\"tiny\">[illegible]</p>\n    </section>\n\n    <section class=\"note n6\">\n      <div class=\"heading cyan\">⑦男女有别</div>\n      <p class=\"small\">感情定向：[illegible]</p>\n      <p class=\"small\">乡土社会是个男女有别的社会。</p>\n      <p class=\"small\">男女间的关系必须有一种安排，使他们之间不发生激动性的感情。</p>\n      <p class=\"small red\">男女授受不亲。</p>\n    </section>\n\n    <section class=\"note n7\">\n      <div class=\"heading cyan\">⑧礼治秩序</div>\n      <p class=\"small\">礼是社会公认合式的行为规范。</p>\n      <p class=\"small\">礼并不是靠外在权力来推行，而是从教化中养成个人的敬畏。</p>\n      <p class=\"small blue\">传统是社会所累积的经验。</p>\n      <p class=\"small\">礼治社会并不是文质彬彬的社会。</p>\n    </section>\n\n    <section class=\"note n8\">\n      <div class=\"heading cyan\">⑨无讼</div>\n      <p class=\"small\">乡土社会是礼治的社会。</p>\n      <p class=\"small\">维持礼治秩序的理想手段是教化，而不是折狱。</p>\n      <p class=\"small\">诉讼表示教化失败。</p>\n      <p class=\"small red\">现代司法制度进入乡土社会，破坏了原有的礼治秩序。</p>\n      <p class=\"tiny\">[illegible]</p>\n    </section>\n\n    <div class=\"center-title\">\n      <span class=\"book\">乡土中国</span>\n      <span class=\"author\">费孝通</span>\n    </div>\n\n    <div class=\"side-label cyan\">乡土社会的变迁</div>\n\n    <section class=\"note n9\">\n      <div class=\"heading yellow\">⑩无为政治</div>\n      <p class=\"small\">权力的四种形式：</p>\n      <p class=\"small\">横暴权力、同意权力、教化权力、时势权力。</p>\n      <p class=\"small\">乡土社会中，横暴权力受到经济条件的限制。</p>\n      <p class=\"small red\">皇权为了维持自身，常以无为作为理想。</p>\n      <p class=\"tiny\">[illegible]</p>\n    </section>\n\n    <section class=\"note n10\">\n      <div class=\"heading yellow\">⑪长老统治</div>\n      <p class=\"small\">教化性的权力虽则在亲子关系里表现得最明显，却并不限于亲子关系。</p>\n      <p class=\"small\">文化是社会共同经验的累积。</p>\n      <p class=\"small red\">乡土社会中形成长老统治。</p>\n    </section>\n\n    <section class=\"note n11\">\n      <div class=\"heading yellow\">⑫血缘和地缘</div>\n      <p class=\"small\">血缘是稳定的力量。</p>\n      <p class=\"small\">血缘社会是想用生物上的新陈代谢来维持社会结构的稳定。</p>\n      <p class=\"small\">地缘是从商业里发展出来的社会关系。</p>\n      <p class=\"small red\">从血缘结合转变到地缘结合是社会性质的转变。</p>\n    </section>\n\n    <section class=\"note n12\">\n      <div class=\"heading yellow\">⑬名实的分离</div>\n      <p class=\"small\">社会变迁中，旧有形式并不立刻消失。</p>\n      <p class=\"small\">名义上还保持着旧的形式，事实上内容已经改变。</p>\n      <p class=\"small red\">名实之间发生分离。</p>\n      <p class=\"tiny\">[illegible]</p>\n    </section>\n\n    <section class=\"note\" style=\"left:18px; top:700px; width:1074px;\">\n      <span class=\"heading yellow\">⑭从欲望到需要</span>\n      <span class=\"small\">　乡土社会中欲望经文化陶冶，可以作为行为的指导；现代社会里，人开始注意行为和目的之间的关系，形成“需要”的概念。</span>\n      <span class=\"small red\">　[illegible]</span>\n    </section>\n\n    <div class=\"arrow\" style=\"left:724px; top:75px; width:22px; transform:rotate(180deg);\"></div>\n    <div class=\"arrow\" style=\"left:536px; top:97px; width:16px; transform:rotate(180deg);\"></div>\n    <div class=\"arrow\" style=\"left:353px; top:99px; width:17px; transform:rotate(180deg);\"></div>\n\n    <div class=\"arrow\" style=\"left:716px; top:495px; width:77px; transform:rotate(-21deg);\"></div>\n    <div class=\"arrow\" style=\"left:557px; top:468px; width:79px; transform:rotate(35deg);\"></div>\n    <div class=\"arrow orange-arrow\" style=\"left:333px; top:483px; width:81px; transform:rotate(9deg);\"></div>\n\n    <div class=\"arrow orange-arrow\" style=\"left:710px; top:532px; width:78px; transform:rotate(29deg);\"></div>\n    <div class=\"arrow orange-arrow\" style=\"left:522px; top:532px; width:66px; transform:rotate(121deg);\"></div>\n    <div class=\"arrow orange-arrow\" style=\"left:400px; top:525px; width:89px; transform:rotate(151deg);\"></div>\n\n    <div class=\"vertical-rule\" style=\"left:748px; top:277px; height:179px;\"></div>\n    <div class=\"vertical-rule\" style=\"left:341px; top:277px; height:173px;\"></div>\n  </main>\n</body>\n</html>"
