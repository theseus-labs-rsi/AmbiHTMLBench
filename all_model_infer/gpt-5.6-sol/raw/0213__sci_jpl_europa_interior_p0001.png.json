        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Determination of the Interior Structure of Europa from Gravity and Magnetic Data</title>\n  <script>\n    window.MathJax = {\n      tex: {\n        inlineMath: [['$', '$']],\n        displayMath: [['$$', '$$']]\n      }\n    };\n  </script>\n  <script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * {\n      box-sizing: border-box;\n    }\n\n    html,\n    body {\n      margin: 0;\n      padding: 0;\n      background: #d8d8d8;\n      color: #000;\n      font-family: Arial, Helvetica, sans-serif;\n    }\n\n    body {\n      min-width: 1200px;\n    }\n\n    .poster {\n      width: 1500px;\n      min-height: 1000px;\n      margin: 0 auto;\n      background: #fff;\n      overflow: hidden;\n    }\n\n    .agency-header {\n      height: 132px;\n      padding: 28px 75px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      color: #fff;\n      background: #000;\n      border-bottom: 5px solid #fff;\n    }\n\n    .agency-name {\n      font-size: 18px;\n      font-weight: 400;\n    }\n\n    .nasa-logo {\n      position: relative;\n      width: 92px;\n      height: 92px;\n      flex: 0 0 92px;\n      border: 1px solid #fff;\n      border-radius: 50%;\n      color: #fff;\n      font-size: 19px;\n      font-weight: 700;\n      font-style: italic;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n    }\n\n    .nasa-logo::before,\n    .nasa-logo::after {\n      content: \"\";\n      position: absolute;\n      left: 3px;\n      width: 88px;\n      height: 2px;\n      background: #aaa;\n      transform: rotate(-34deg);\n    }\n\n    .nasa-logo::after {\n      transform: rotate(48deg);\n    }\n\n    .title-band {\n      height: 350px;\n      padding: 40px 2