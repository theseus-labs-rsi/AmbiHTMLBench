: \"\";\n      display: inline-block;\n      width: 22px;\n      margin-right: 6px;\n      vertical-align: middle;\n      border-top: 2px dashed #000;\n    }\n\n    .panel-a {\n      position: absolute;\n      top: 0;\n      right: 0;\n      left: 0;\n      height: 51%;\n      border-bottom: 4px solid #fff;\n    }\n\n    .panel-b {\n      position: absolute;\n      right: 0;\n      bottom: 0;\n      left: 0;\n      height: 49%;\n    }\n\n    .panel-a .distribution,\n    .panel-b .distribution {\n      position: absolute;\n      left: 24px;\n      right: 10px;\n      bottom: 0;\n      height: 86%;\n      opacity: 0.68;\n      background: #7698e4;\n    }\n\n    .panel-a .distribution {\n      clip-path: polygon(0 84%, 6% 70%, 16% 66%, 24% 48%, 31% 2%, 38% 0, 45% 9%, 51% 51%, 57% 82%, 63% 96%, 70% 100%, 100% 100%);\n    }\n\n    .panel-b .distribution {\n      clip-path: polygon(0 70%, 3% 9%, 9% 1%, 18% 0, 27% 8%, 34% 48%, 41% 84%, 49% 98%, 58% 100%, 100% 100%);\n    }\n\n    .figure-caption {\n      margin: 0 10px 24px;\n      font-size: 16px;\n      line-height: 1.35;\n      text-align: center;\n    }\n\n    .heatmap-chart {\n      width: 100%;\n      height: 267px;\n      margin-top: 5px;\n      padding: 8px 25px 22px 52px;\n      border: 0;\n      background: #fff;\n    }\n\n    .heatmap-stack {\n      height: 100%;\n      display: grid;\n      grid-template-rows: repeat(3, 1fr);\n      gap: 6px;\n    }\n\n    .heatmap {\n      position: relative;\n      border: 1px solid #777;\n      background:\n        linear-gradient(to right, transparent 0 8%, rgba(252, 239, 144, 0.98) 9%, #f47451 16%, #761d84 25%, #120b38 35%, #02020c 48%),\n        #020208;\n      overflow: visible;\n    }\n\n    .heatmap:first-child {\n      background:\n        linear-gradient(169deg, transparent 0 18%, #f8e68d 19%, #f77857 23%, #7c2185 30%, #160d42 39%, #02020b 47%),\n        linear-gradient(158deg, #541466 0 11%, #f27852 14%, #f9e68b 17%, #4e155e 25%, #02020b 34%);\n    }\n\n    .heatmap:nth-child(2) {\n      background:\n        linear-gradient(to right, #f9e58e 0 3%, #f47753 6%, #791f83 11%, #180e3f 17%, #02020b 23%);\n    }\n\n    .heatmap:nth-child(3) {\n      background:\n        radial-gradient(ellipse at 4% 7%, #fff0a3 0 2%, #f57b54 4%, #762084 8%, #160d3e 14%, #02020b 20%);\n    }\n\n    .heatmap::before {\n      content: \"Ocean Depth [km]\";\n      position: absolute;\n      left: -53px;\n      top: 26px;\n      width: 72px;\n      color: #000;\n      font-size: 9px;\n      transform: rotate(-90deg);\n    }\n\n    .heatmap::after {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      background:\n        repeating-linear-gradient(to right, transparent 0, transparent 74px, rgba(190, 190, 190, 0.7) 75px, transparent 77px),\n        repeating-linear-gradient(to bottom, transparent 0, transparent 31px, rgba(190, 190, 190, 0.7) 32px, transparent 34px);\n    }\n\n    .heatmap-x {\n      position: absolute;\n      right: 0;\n      bottom: -22px;\n      left: 0;\n      color: #000;\n      font-size: 10px;\n      text-align: center;\n    }\n\n    .colorbar {\n      position: absolute;\n      top: 5px;\n      right: -17px;\n      width: 8px;\n      height: calc(100% - 10px);\n      border: 1px solid #555;\n      background: linear-gradient(to top, #05020e, #3b0f70, #971d80, #ee6556, #fff2a5);\n    }\n\n    .colorbar-label {\n      position: absolute;\n      top: 27px;\n      right: -44px;\n      width: 55px;\n      color: #000;\n      font-size: 8px;\n      transform: rotate(-90deg);\n    }\n\n    .future {\n      margin-top: 5px;\n      margin-bottom: 26px;\n    }\n\n    .future p {\n      font-size: 18px;\n      line-height: 1.43;\n      text-align: center;\n    }\n\n    .footer-grid {\n      display: grid;\n      grid-template-columns: 34% 66%;\n      gap: 28px;\n      align-items: stretch;\n      margin: 0 -35px;\n    }\n\n    .institution {\n      padding: 22px 35px 18px;\n      font-size: 17px;\n      line-height: 1.45;\n    }\n\n    .institution .agency {\n      margin-bottom: 30px;\n      font-weight: 700;\n    }\n\n    .institution .lab {\n      margin-bottom: 30px;\n    }\n\n    .institution .clearance p {\n      margin-bottom: 17px;\n    }\n\n    .institution strong {\n      font-weight: 700;\n    }\n\n    .acknowledgements {\n      min-height: 220px;\n      padding: 17px 12px 12px;\n      border: 1px solid #000;\n      background: #f4f4f4;\n    }\n\n    .acknowledgements h2 {\n      font-size: 24px;\n      margin-bottom: 12px;\n    }\n\n    .acknowledgements p {\n      font-size: 17px;\n      line-height: 1.35;\n      margin-bottom: 13px;\n    }\n\n    .contact-title {\n      margin-top: 15px;\n    }\n\n    .contact-row {\n      display: flex;\n      align-items: center;\n      gap: 15px;\n      color: #7d7979;\n      font-size: 22px;\n      font-weight: 700;\n      font-style: italic;\n      white-space: nowrap;\n    }\n\n    .mail-icon {\n      position: relative;\n      width: 30px;\n      height: 22px;\n      flex: 0 0 30px;\n      border: 2px solid #000;\n      background: #fff;\n    }\n\n    .mail-icon::before,\n    .mail-icon::after {\n      content: \"\";\n      position: absolute;\n      top: 5px;\n      width: 19px;\n      border-top: 2px solid #000;\n    }\n\n    .mail-icon::before {\n      left: 0;\n      transform: rotate(38deg);\n    }\n\n    .mail-icon::after {\n      right: 0;\n      transform: rotate(-38deg);\n    }\n\n    .phone-icon {\n      width: 18px;\n      height: 31px;\n      flex: 0 0 18px;\n      border: 2px solid #000;\n      border-radius: 2px;\n      background: #fff;\n    }\n\n    strong {\n      font-weight: 700;\n    }\n\n    .placeholder-caption {\n      position: absolute;\n      width: 1px;\n      height: 1px;\n      overflow: hidden;\n      clip-path: inset(50%);\n      white-space: nowrap;\n    }\n\n    @media (max-width: 1499px) {\n      body {\n        min-width: 0;\n      }\n\n      .poster {\n        transform-origin: top left;\n      }\n    }\n\n    @media print {\n      body {\n        background: #fff;\n      }\n\n      .poster {\n        margin: 0;\n      }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"poster\">\n    <header class=\"agency-header\">\n      <div class=\"agency-name\">National Aeronautics and Space Administration</div>\n      <div class=\"nasa-logo placeholder\" aria-label=\"NASA insignia\">\n        NASA\n        <span class=\"placeholder-caption\">[Logo: NASA insignia, top-right]</span>\n      </div>\n    </header>\n\n    <section class=\"title-band\">\n      <p class=\"program\">Postdoc Research</p>\n      <h1>Determination of the Interior Structure of Europa<br>from Gravity and Magnetic Data</h1>\n      <p class=\"author\">Flavio Petricca (JPL Postdoctoral Fellow, 322)</p>\n      <p class=\"collaborators\">J. Castillo-Rogez (4000), S. Vance (322), M. Melwani Daswani (322), C. Cochrane (322)</p>\n    </section>\n\n    <div class=\"content\">\n      <section class=\"background\">\n        <h2>Background</h2>\n        <p>\n          The Galileo mission provided measurements of <strong>Europa’s gravity and magnetic fields</strong>, indicating that the moon hosts a subsurface ocean and<br>\n          that its interior is mostly made by rocks (90 wt. %). However, the interior structure is still poorly understood, with the <strong>main uncertainties<br>\n          affecting the ice shell thickness and ocean depth, and the size of a putative metallic core</strong> whose existence was inferred from the first analysis<br>\n          of Galileo’s gravity data (Anderson et al., 1998). A recent reanalysis indicated a smaller level of differentiation (Gomez-Casajus et al., 2021),<br>\n          challenging the inference of the existence of the metallic core. Knowledge of the degree of differentiation is crucial to understand the origins<br>\n          and evolution of Europa. Furthermore, <strong>gravity and magnetic data</strong> have only been used separately, and developing methodologies to <strong>jointly<br>\n          analyze</strong> them will be fundamental for <strong>Europa Clipper’s investigations.</strong>\n        </p>\n      </section>\n\n      <div class=\"main-columns\">\n        <div class=\"left-column\">\n          <section class=\"section\">\n            <h2>Objectives</h2>\n            <p class=\"section-text objectives-intro\">\n              We analyze measurements of Europa’s gravity and magnetic fields<br>\n              based on Galileo data with <strong>new generation interior models and<br>\n              techniques</strong> to answer the following questions:\n            </p>\n            <ol>\n              <li>Did Europa differentiate a metallic core? What is the<br>composition of the rocky mantle?</li>\n              <li>How can we combine gravity and magnetic data in an effective<br>way to infer the ice thickness and ocean depth and salinity?</li>\n            </ol>\n          </section>\n\n          <section class=\"section\">\n            <h2>Approach and Results</h2>\n            <p class=\"section-text\">\n              We developed new interior models that use Bayesian inference and<br>\n              Markov-chain Monte Carlo (MCMC) algorithms to combine gravity and<br>\n              magnetic observations with geochemical data on the composition of<br>\n              the ocean and the rocky mantle. Our two main results are:\n            </p>\n            <ol class=\"results-list\">\n              <li>\n                Our models indicate that Europa <strong>did not differentiate a metallic<br>\n                core (Figure 1).</strong> This implies that <strong>Europa’s evolution was colder</strong><br>\n                than previously thought. The resulting structure and composition<br>\n                of the rocky mantle indicates that <strong>Europa and the Jupiter system<br>\n                likely formed from dry CV chondrite-like material.</strong>\n              </li>\n              <li>\n                The combination of gravity and magnetic data can <strong>separately<br>\n                constrain the ice shell and ocean thicknesses</strong>, while separate<br>\n                inversions are degenerate (<strong>Figure 2</strong>).\n              </li>\n            </ol>\n          </section>\n\n          <section class=\"section\">\n            <h2>Significance of Results/Benefits to NASA/JPL</h2>\n            <p class=\"section-text\">\n              The unprecedented constraint on the structure of the deep interior<br>\n              <strong>changes our understanding of the evolution of Europa.</strong> The lack of a<br>\n              metallic core indicates a cold evolution, with implications for the origin<br>\n              of the Jupiter system and the evolution of the other Galilean moons.<br>\n              The <strong>methodology developed to combine gravity and magnetic data<br>\n              will be fundamental in the context of Europa Clipper’s interior<br>\n              science.</strong> This technique will provide a framework to connect interior<br>\n              models with the results of ongoing lab work at JPL (PSIE, PI: S. Vance).<br>\n              New experimental data on the thermodynamic and electric properties<br>\n              of solutions relevant to Europa’s ocean are being collected and will be<br>\n              implemented in this interior modeling framework.\n            </p>\n          </section>\n        </div>\n\n        <div class=\"right-column\">\n          <figure style=\"margin:0;\">\n            <div class=\"chart chart-one placeholder\">\n              <span class=\"placeholder-caption\">[Chart: two-panel core-radius probability distributions, upper-right]</span>\n              <div class=\"panel-a\">\n                <span class=\"panel-letter\">a</span>\n                <span class=\"axis-y\">Sample models</span>\n                <div class=\"distribution\"></div>\n                <div class=\"credible first\"></div>\n                <div class=\"credible second\"></div>\n              </div>\n              <div class=\"panel-b\">\n                <span class=\"panel-letter\">b</span>\n                <span class=\"axis-y\">Sample models</span>\n                <span class=\"axis-x\">Core Radius [km]</span>\n                <span class=\"legend\">1σ level credible interval</span>\n                <div class=\"distribution\"></div>\n                <div class=\"credible first\" style=\"left:15%;\"></div>\n                <div class=\"credible second\" style=\"left:30%;\"></div>\n              </div>\n            </div>\n            <figcaption class=\"figure-caption\">\n              <strong>Figure 1:</strong> metallic core radius resulting from the inversion of Europa’s gravity field<br>\n              measurements from the earlier analysis (Anderson et al., 1998; <strong>Panel A</strong>) and the<br>\n              more recent analysis (Gomez-Casajus et al., 2021; <strong>Panel B</strong>).\n            </figcaption>\n          </figure>\n\n          <figure style=\"margin:0;\">\n            <div class=\"chart heatmap-chart placeholder\">\n              <span class=\"placeholder-caption\">[Chart: three stacked heatmaps of ice-shell thickness and ocean depth, right-center]</span>\n              <div class=\"heatmap-stack\">\n                <div class=\"heatmap\">\n                  <div class=\"colorbar\"></div>\n                  <div class=\"colorbar-label\">Samples</div>\n                </div>\n                <div class=\"heatmap\">\n                  <div class=\"colorbar\"></div>\n                  <div class=\"colorbar-label\">Samples</div>\n                </div>\n                <div class=\"heatmap\">\n                  <div class=\"colorbar\"></div>\n                  <div class=\"colorbar-label\">Samples</div>\n                  <div class=\"heatmap-x\">Ice Shell Thickness [km]</div>\n                </div>\n              </div>\n            </div>\n            <figcaption class=\"figure-caption\">\n              <strong>Figure 2:</strong> Europa’s ice and ocean thicknesses derived from inversion of <strong>(A) gravity<br>\n              data only, (B) magnetic data only, (C) combination of gravity and magnetic data.</strong>\n            </figcaption>\n          </figure>\n        </div>\n      </div>\n\n      <section class=\"future\">\n        <h2>Future Work</h2>\n        <p>\n          The framework developed will be expanded to include new experimental data in preparation for the analysis of Europa Clipper’s data. It will be<br>\n          also applied to Ganymede, Callisto and Titan to explore their interiors. Finally, ongoing work includes the application of this framework to the<br>\n          moons of Uranus in the context of the formulation of the Uranus Orbiter and Probe, highly prioritized by the Planetary Science Decadal Survey.\n        </p>\n      </section>\n\n      <div class=\"footer-grid\">\n        <footer class=\"institution\">\n          <p class=\"agency\">National Aeronautics and Space Administration</p>\n          <p class=\"lab\">\n            <strong>Jet Propulsion Laboratory</strong><br>\n            California Institute of Technology<br>\n            Pasadena, California\n          </p>\n          <p style=\"font-weight:700; margin-bottom:34px;\">www.nasa.gov</p>\n          <div class=\"clearance\">\n            <p>Clearance Number: CL#00-0000</p>\n            <p>Poster Number: PRD-</p>\n            <p>Copyright 2024. All rights reserved.</p>\n          </div>\n        </footer>\n\n        <aside class=\"acknowledgements\">\n          <h2>Publications and Acknowledgements:</h2>\n          <p>\n            <strong>Petricca F.</strong> et al., Partial Differentiation of Europa and Implications for the Origin of<br>\n            Materials in the Jupiter System, <strong>Nature Astronomy</strong>, in press<br>\n            <strong>Petricca F.</strong> et al., Characterization of Icy Moon Hydrospheres Through Joint Inversion of<br>\n            Gravity and Magnetic Field Measurements, <strong>Geophysical Research Letters</strong>\n          </p>\n          <p>\n            This work is funded and supported by the JPL Office of Research and Development via<br>\n            the JPL Postdoctoral Program.\n          </p>\n          <h2 class=\"contact-title\">Author Contact Information:</h2>\n          <div class=\"contact-row\">\n            <span class=\"mail-icon\" aria-hidden=\"true\"></span>\n            <span>flavio.petricca@jpl.nasa.gov</span>\n            <span class=\"phone-icon\" aria-hidden=\"true\"></span>\n            <span>(626) 497-8608</span>\n          </div>\n        </aside>\n      </div>\n    </div>\n  </main>\n</body>\n</html>"
      },
