dth: 420px;\n    height: 105px;\n    right: 5px;\n    bottom: 29px;\n    transform: skewY(12deg);\n    border-radius: 5px;\n    background: linear-gradient(145deg, #bfc2c7, #656970);\n    box-shadow: 0 8px 12px rgba(0,0,0,.25);\n  }\n  .glow {\n    position: absolute;\n    width: 390px;\n    height: 50px;\n    right: 20px;\n    bottom: 91px;\n    background: #ffae35;\n    filter: blur(19px);\n    opacity: .95;\n    transform: skewY(13deg);\n  }\n  .upper {\n    position: absolute;\n    width: 445px;\n    height: 220px;\n    right: 20px;\n    top: 88px;\n    border-radius: 17px;\n    background: linear-gradient(145deg, #dfe1e3, #8d9198);\n    transform: skewY(-7deg);\n    box-shadow: 0 18px 20px rgba(0,0,0,.2);\n  }\n  .upper:after {\n    content: \"\";\n    position: absolute;\n    width: 183px;\n    height: 91px;\n    left: 125px;\n    top: 18px;\n    border-radius: 50%;\n    background:\n      radial-gradient(ellipse at center, #70747c 0 35%, #161719 37% 50%, #b45c17 53% 66%, #6e2e0d 68% 76%, #db7c25 78% 84%, transparent 86%);\n    box-shadow: 0 0 23px 13px rgba(255, 142, 29, .7);\n  }\n  .hole {\n    position: absolute;\n    width: 23px;\n    height: 13px;\n    border-radius: 50%;\n    background: #34363a;\n    box-shadow: inset 3px 2px 5px #111;\n  }\n  .h1 { left: 43px; top: 25px; }\n  .h2 { right: 32px; top: 28px; }\n  .h3 { left: 194px; bottom: 20px; }\n  .h4 { right: 105px; bottom: 20px; }\n\n  .main {\n    width: 1475px;\n    max-width: calc(100% - 254px);\n    margin: 0 auto;\n    padding-top: 105px;\n    display: grid;\n    grid-template-columns: 670px 1fr;\n    column-gap: 124px;\n  }\n  section { margin: 0; }\n  h2 {\n    color: #174896;\n    font-size: 32px;\n    line-height: 1.28;\n    margin: 0 0 19px;\n    font-weight: 700;\n  }\n  p {\n    font-size: 23px;\n    line-height: 1.35;\n    margin: 0;\n  }\n  .left section + section { margin-top: 70px; }\n  .right h2 { margin-bottom: 36px; }\n  .table-wrap { width: 100%; }\n  table {\n    border-collapse