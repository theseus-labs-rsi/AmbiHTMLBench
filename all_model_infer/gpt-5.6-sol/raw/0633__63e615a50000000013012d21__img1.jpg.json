        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>3～6岁儿童学习与发展指南</title>\n<script>\n  window.MathJax = {\n    tex: {\n      inlineMath: [['$', '$']],\n      displayMath: [['$$', '$$']]\n    }\n  };\n</script>\n<script defer src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * {\n    box-sizing: border-box;\n  }\n\n  html,\n  body {\n    margin: 0;\n    min-height: 100%;\n    background: #d8d2c7;\n  }\n\n  body {\n    display: flex;\n    justify-content: center;\n    align-items: flex-start;\n    font-family: \"SimSun\", \"Songti SC\", \"Noto Serif CJK SC\", serif;\n    color: #25231f;\n  }\n\n  .page {\n    position: relative;\n    width: 540px;\n    height: 720px;\n    overflow: hidden;\n    background:\n      linear-gradient(90deg, rgba(117,101,78,.035), transparent 15%, transparent 84%, rgba(105,89,66,.06)),\n      #f3efe6;\n    box-shadow: 0 0 9px rgba(0,0,0,.26);\n  }\n\n  .running-header {\n    position: absolute;\n    top: 8px;\n    left: 26px;\n    font-size: 15px;\n    line-height: 20px;\n    letter-spacing: .2px;\n  }\n\n  .continuation {\n    position: absolute;\n    top: 55px;\n    right: 67px;\n    font-size: 14px;\n    line-height: 18px;\n  }\n\n  .development-table {\n    position: absolute;\n    top: 78px;\n    left: 65px;\n    width: 409px;\n    height: 156px;\n    border-collapse: collapse;\n    table-layout: fixed;\n    font-size: 14px;\n    background: rgba(255,255,255,.08);\n    transform: rotate(-0.45deg);\n    transform-origin: center;\n  }\n\n  .development-table th,\n  .development-table td {\n    border: 1.35px solid #28251f;\n  }\n\n  .development-table th {\n    height: 39px;\n    padding: 3px 4px;\n    text-align: center;\n    vertical-align: middle;\n    font-weight: normal;\n  }\n\n  .development-table td {\n    height: 116px;\n    padding: 7px 4px 5px;\n    vertical-align: