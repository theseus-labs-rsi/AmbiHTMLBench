n    repeating-linear-gradient(90deg, #6b4228 0 12px, #3c2417 12px 18px);\n  box-shadow: 0 5px 3px rgba(0,0,0,.5);\n  transform: skewX(-12deg);\n}\n\n.tray.one { top: 0; }\n.tray.two { top: 76px; left: 10px; width: 177px; }\n.tray.three { top: 143px; left: 35px; width: 134px; }\n\n.cabinet {\n  position: absolute;\n  right: 37px;\n  top: 450px;\n  width: 168px;\n  height: 286px;\n  opacity: .64;\n  filter: saturate(.75) brightness(.66);\n  transform: perspective(400px) rotateY(-3deg);\n}\n\n.cabinet .top {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 158px;\n  height: 16px;\n  background: #7c512d;\n  transform: skewX(-25deg);\n}\n\n.cabinet .red {\n  position: absolute;\n  top: 15px;\n  right: 4px;\n  width: 116px;\n  height: 85px;\n  background: #99160d;\n  border: 7px solid #6b301d;\n}\n\n.cabinet .green {\n  position: absolute;\n  top: 100px;\n  right: 4px;\n  width: 135px;\n  height: 90px;\n  background: #096a4d;\n  border: 7px solid #5c351f;\n}\n\n.cabinet .blue {\n  position: absolute;\n  top: 190px;\n  right: 4px;\n  width: 144px;\n  height: 101px;\n  background: #477d90;\n  border: 7px solid #5b3c27;\n}\n\n.cabinet .knob {\n  position: absolute;\n  right: 23px;\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: #d7ad5a;\n}\n\n.cabinet .knob.a { top: 52px; }\n.cabinet .knob.b { top: 136px; }\n.cabinet .knob.c { top: 230px; }\n\n.colored-blocks {\n  position: absolute;\n  left: 282px;\n  top: 474px;\n  width: 58px;\n  height: 39px;\n  opacity: .62;\n}\n\n.colored-blocks span {\n  position: absolute;\n  bottom: 0;\n  width: 25px;\n  height: 25px;\n  border: 4px solid rgba(50,30,20,.6);\n}\n\n.colored-blocks .blue-block {\n  left: 0;\n  background: #276fb1;\n}\n\n.colored-blocks .red-block {\n  right: 0;\n  background: #a92125;\n}\n\n.photo-darkener {\n  position: absolute;\n  inset: 0;\n  background:\n    linear-gradient(to bottom,\n      rgba(0,0,0,.44) 0%,\n      rgba(0,0,0,.46) 49.8%,\n      rgba(65,65,65,.23) 50%,\n      rgba(50,50,50,.28) 100%);\n}\n\n.content {\n  position: absolute;\n  inset: 0;\n  z-index: 2;\n  text-align: center;\n  text-shadow: 0 1px 2px #000;\n}\n\n.title {\n  position: absolute;\n  top: 31px;\n  left: 87px;\n  margin: 0;\n  padding: 5px 8px 7px;\n  background: rgba(0,0,0,.76);\n  font-size: 38px;\n  line-height: 48px;\n  font-weight: 400;\n  letter-spacing: -1.5px;\n  white-space: nowrap;\n}\n\n.line {\n  position: absolute;\n  left: 0;\n  width: 100%;\n  margin: 0;\n  font-size: 18px;\n  line-height: 27px;\n  font-weight: 400;\n  white-space: nowrap;\n}\n\n.ink {\n  display: inline-block;\n  padding: 0 3px 1px;\n  background: rgba(0,0,0,.77);\n}\n\n.intro-1 { top: 118px; }\n.intro-2 { top: 151px; }\n.intro-3 { top: 186px; }\n.intro-4 { top: 220px; }\n\n.section {\n  font-size: 19px;\n}\n\n.section-one { top: 254px; }\n\n.bullet-one { top: 287px; }\n.bullet-two { top: 321px; }\n.bullet-three { top: 355px; }\n.bullet-three-cont { top: 389px; }\n.bullet-four { top: 423px; }\n.bullet-five { top: 457px; }\n\n.section-two { top: 522px; }\n\n.bullet-six { top: 556px; }\n.bullet-seven { top: 590px; }\n.bullet-eight { top: 624px; }\n.bullet-eight-cont { top: 658px; }\n.bullet-eight-last { top: 692px; }\n\n.wave {\n  position: absolute;\n  height: 13px;\n  z-index: 3;\n}\n\n.wave svg {\n  display: block;\n  width: 100%;\n  height: 100%;\n  overflow: visible;\n}\n\n.wave-one {\n  top: 241px;\n  left: 142px;\n  width: 99px;\n}\n\n.wave-two {\n  top: 478px;\n  left: 148px;\n  width: 252px;\n}\n\n.wave-three {\n  top: 708px;\n  left: 269px;\n  width: 91px;\n}\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <figure class=\"photo placeholder\">\n    <figcaption class=\"photo-caption\">[Photo: Montessori classroom materials filling the background]</figcaption>\n    <div class=\"wall-shadow\"></div>\n\n    <div class=\"left-trays\">\n      <div class=\"tray one\"></div>\n      <div class=\"tray two\"></div>\n      <div class=\"tray three\"></div>\n    </div>\n\n    <div class=\"colored-blocks\">\n      <span class=\"blue-block\"></span>\n      <span class=\"red-block\"></span>\n    </div>\n\n    <div class=\"cabinet\">\n      <div class=\"top\"></div>\n      <div class=\"red\"></div>\n      <div class=\"green\"></div>\n      <div class=\"blue\"></div>\n      <i class=\"knob a\"></i>\n      <i class=\"knob b\"></i>\n      <i class=\"knob c\"></i>\n    </div>\n\n    <div class=\"photo-darkener\"></div>\n  </figure>\n\n  <section class=\"content\">\n    <h1 class=\"title\">蒙台梭利Montessori</h1>\n\n    <p class=\"line intro-1\"><span class=\"ink\">蒙特梭利教学法并非一成不变，这种教学法是开放的，</span></p>\n    <p class=\"line intro-2\"><span class=\"ink\">且建立在蒙特梭利教育哲学和精神之上。</span></p>\n    <p class=\"line intro-3\"><span class=\"ink\">非常强调环境对儿童的影响，</span></p>\n    <p class=\"line intro-4\"><span class=\"ink\">主张理想的教室必须具备以下五种要素：</span></p>\n\n    <div class=\"wave wave-one\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 99 13\" preserveAspectRatio=\"none\">\n        <path d=\"M1 7 L7 3 L13 9 L19 3 L25 9 L31 3 L37 9 L43 3 L49 9 L55 3 L61 9 L67 3 L73 9 L79 3 L85 9 L91 3 L98 7\"\n              fill=\"none\" stroke=\"#fff400\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n    </div>\n\n    <p class=\"line section section-one\"><span class=\"ink\">1、自由的观念</span></p>\n\n    <p class=\"line bullet-one\"><span class=\"ink\">●儿童只有在自由、开放的环境下才能将学习发挥到极点</span></p>\n    <p class=\"line bullet-two\"><span class=\"ink\">●蒙特梭利并不赞同没有经过过滤的自由。</span></p>\n    <p class=\"line bullet-three\"><span class=\"ink\">●儿童可以依照自己的兴趣选择教具，</span></p>\n    <p class=\"line bullet-three-cont\"><span class=\"ink\">也可以依照自己的喜好选择学习的地点及时间。</span></p>\n    <p class=\"line bullet-four\"><span class=\"ink\">●孩子之间可以相互观摩学习，是一种混龄式的教学。</span></p>\n    <p class=\"line bullet-five\"><span class=\"ink\">●废除传统教学中惯用的奖惩制度</span></p>\n\n    <div class=\"wave wave-two\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 252 13\" preserveAspectRatio=\"none\">\n        <path d=\"M2 7 L8 3 L14 9 L20 3 L26 9 L32 3 L38 9 L44 3 L50 9 L56 3 L62 9 L68 3 L74 9 L80 3 L86 9 L92 3 L98 9 L104 3 L110 9 L116 3 L122 9 L128 3 L134 9 L140 3 L146 9 L152 3 L158 9 L164 3 L170 9 L176 3 L182 9 L188 3 L194 9 L200 3 L206 9 L212 3 L218 9 L224 3 L230 9 L236 3 L242 9 L250 6\"\n              fill=\"none\" stroke=\"#fff400\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n    </div>\n\n    <p class=\"line section section-two\"><span class=\"ink\">2、结构与秩序</span></p>\n\n    <p class=\"line bullet-six\"><span class=\"ink\">●将教具按照其难度加以排列，较有秩序及结构感。</span></p>\n    <p class=\"line bullet-seven\"><span class=\"ink\">●养成儿童自动自发、物归原处的生活习惯。</span></p>\n    <p class=\"line bullet-eight\"><span class=\"ink\">●外在环境的结构只是为配合儿童的学习，</span></p>\n    <p class=\"line bullet-eight-cont\"><span class=\"ink\">教师们应视儿童的需要而适时更换教室的陈设，</span></p>\n    <p class=\"line bullet-eight-last\"><span class=\"ink\">在有序中保持弹性。</span></p>\n\n    <div class=\"wave wave-three\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 91 13\" preserveAspectRatio=\"none\">\n        <path d=\"M1 7 L7 3 L13 9 L19 3 L25 9 L31 3 L37 9 L43 3 L49 9 L55 3 L61 9 L67 3 L73 9 L79 3 L85 9 L90 6\"\n              fill=\"none\" stroke=\"#fff400\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n    </div>\n  </section>\n</main>\n</body>\n</html>"
