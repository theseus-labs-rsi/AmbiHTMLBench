ine\"><span class=\"label\">原因</span><span class=\"text\">病原微生物引起在夏季高发</span></div>\n        <div class=\"line\"><span class=\"label\">症状</span><span class=\"text\">腹痛恶心，发热，没食欲</span></div>\n        <div class=\"line\"><span class=\"label\">大便</span><span class=\"text\">大便稀且有黏液，严重的便血</span></div>\n        <div class=\"line\"><span class=\"label\">护理</span><span class=\"text\">补液避免脱水，<br>注意饮食卫生</span></div>\n      </article>\n\n      <article class=\"item compact\">\n        <h2>乳糖不耐受腹泻</h2>\n        <div class=\"line\"><span class=\"label\">原因</span><span class=\"text\">由于肠道中缺乏乳糖酶引起</span></div>\n        <div class=\"line\"><span class=\"label\">症状</span><span class=\"text\">肠胀气、肠绞痛，吃奶就拉</span></div>\n        <div class=\"line\"><span class=\"label\">大便</span><span class=\"text\">次数多，大便有奶瓣混状</span></div>\n        <div class=\"line\"><span class=\"label\">护理</span><span class=\"text\">母乳妈妈忌口高糖和奶制品</span></div>\n      </article>\n\n      <article class=\"item compact\">\n        <h2>受凉引起腹泻</h2>\n        <div class=\"line\"><span class=\"label\">原因</span><span class=\"text\">由腹部或身体受凉引起</span></div>\n        <div class=\"line\"><span class=\"label\">症状</span><span class=\"text\">胃胀，恶心，呕吐，屁多</span></div>\n        <div class=\"line\"><span class=\"label\">大便</span><span class=\"text\">大便水样，有泡沫</span></div>\n        <div class=\"line\"><span class=\"label\">护理</span><span class=\"text\">注意身体和肚子保暖，<br>不能生冷辛辣</span></div>\n      </article>\n    </section>\n  </main>\n</body>\n</html>"
