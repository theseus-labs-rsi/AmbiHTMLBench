        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Notebook Document</title>\n  <script>\n    window.MathJax = {\n      tex: { inlineMath: [['$', '$'], ['\\\\(', '\\\\)']], displayMath: [['$$', '$$'], ['\\\\[', '\\\\]']] },\n      svg: { fontCache: 'global' }\n    };\n  </script>\n  <script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js\"></script>\n  <style>\n    :root {\n      --paper: #f1f0d9;\n      --grid: rgba(102, 119, 103, 0.23);\n      --ink: #394554;\n      --red: #a94d56;\n      --blue: #4d6d9a;\n      --border: #6e7065;\n    }\n\n    * {\n      box-sizing: border-box;\n    }\n\n    body {\n      margin: 0;\n      min-width: 980px;\n      background: #20262b;\n      color: var(--ink);\n      font-family: \"KaiTi\", \"STKaiti\", \"FangSong\", serif;\n      font-size: 15px;\n      line-height: 1.48;\n    }\n\n    .document {\n      width: 1450px;\n      min-height: 900px;\n      margin: 28px auto;\n      padding: 30px 25px;\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 36px;\n      position: relative;\n      transform: rotate(-0.3deg);\n      background:\n        linear-gradient(90deg, transparent 0 49.3%, rgba(65, 66, 57, .5) 49.3% 49.7%, transparent 49.7%),\n        var(--paper);\n      box-shadow: 0 3px 18px rgba(0,0,0,.5);\n      border: 1px solid #b0ae91;\n    }\n\n    .page {\n      min-height: 840px;\n      padding: 18px 22px 24px;\n      position: relative;\n      background-color: var(--paper);\n      background-image:\n        linear-gradient(var(--grid) 1px, transparent 1px),\n        linear-gradient(90deg, var(--grid) 1px, transparent 1px);\n      background-size: 22px 22px;\n      overflow: hidden;\n    }\n\n    .left-page {\n      border-right: 1px solid rgba(100,100,90,.42);\n    }\n\n    .right-page {\n      border-left: 1px solid rgba(100,100,90,.42);\n    }\n\n    