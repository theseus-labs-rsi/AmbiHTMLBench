        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>科学咨询·教育科研</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] },\n  svg: { fontCache: 'global' }\n};\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  html, body {\n    width: 100%;\n    height: 100%;\n    margin: 0;\n    background: #eef1f7;\n    color: #252525;\n    font-family: \"SimSun\", \"Songti SC\", serif;\n  }\n\n  .viewer {\n    position: relative;\n    width: 540px;\n    height: 720px;\n    margin: 0 auto;\n    overflow: hidden;\n    background: #f5f6fa;\n  }\n\n  .statusbar {\n    position: relative;\n    height: 16px;\n    padding: 2px 5px 0;\n    color: #111;\n    font-family: Arial, sans-serif;\n    font-size: 8px;\n    font-weight: 600;\n  }\n  .status-center {\n    position: absolute;\n    left: 259px;\n    top: 0;\n    font-size: 13px;\n    letter-spacing: 2px;\n    color: #777;\n  }\n  .status-right {\n    position: absolute;\n    right: 5px;\n    top: 2px;\n    white-space: nowrap;\n  }\n  .battery {\n    display: inline-block;\n    width: 15px;\n    height: 7px;\n    margin-left: 2px;\n    border: 1px solid #111;\n    border-radius: 1px;\n    vertical-align: -1px;\n  }\n  .battery::after {\n    content: \"\";\n    display: block;\n    width: 7px;\n    height: 5px;\n    margin: 0;\n    background: #111;\n  }\n\n  .toolbar {\n    height: 39px;\n    border-bottom: 1px solid #cfd3da;\n    display: flex;\n    align-items: center;\n    padding: 0 10px;\n    color: #236b9c;\n    background: #f6f7fb;\n    font-family: Arial, sans-serif;\n  }\n  .tool {\n    display: inline-flex;\n    width: 27px;\n    height: 29px;\n    align-items: center;\n    justify-content: center;\n    margin-right: 3px;\n    font-size: 20px;\n    font-weight: 300;\n  }\n 