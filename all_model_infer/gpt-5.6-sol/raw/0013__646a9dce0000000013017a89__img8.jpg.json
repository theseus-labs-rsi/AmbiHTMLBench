ground: rgba(255, 255, 255, .95);\n      clip-path: polygon(\n        15px 0,\n        calc(100% - 15px) 0,\n        100% 15px,\n        100% calc(100% - 15px),\n        calc(100% - 15px) 100%,\n        15px 100%,\n        0 calc(100% - 15px),\n        0 15px\n      );\n      box-shadow: inset 0 0 15px rgba(142, 110, 48, .12);\n    }\n\n    .level {\n      position: absolute;\n      top: 76px;\n      left: 152px;\n      z-index: 4;\n      width: 236px;\n      height: 40px;\n      border-radius: 22px;\n      background: #c94513;\n      color: #fff;\n      text-align: center;\n      font-size: 27px;\n      line-height: 40px;\n      font-weight: 800;\n      letter-spacing: 0;\n      box-shadow: 0 2px 1px rgba(126, 71, 20, .2);\n    }\n\n    .poem-grid {\n      display: grid;\n      grid-template-columns: 159px 177px 162px;\n      grid-template-rows: 183px 200px 190px;\n      width: 498px;\n      height: 573px;\n    }\n\n    .poem {\n      position: relative;\n      padding: 2px 6px 0;\n      text-align: center;\n      color: #272321;\n      border-right: 1px dashed #d8d8cd;\n      border-bottom: 1px dashed #d8d8cd;\n    }\n\n    .poem:nth-child(3n) {\n      border-right: 0;\n    }\n\n    .poem:nth-child(n+7) {\n      border-bottom: 0;\n    }\n\n    .poem h2 {\n      margin: 0 0 2px;\n      color: #9e402c;\n      font-size: 19px;\n      line-height: 1.35;\n      font-weight: 800;\n      letter-spacing: 0;\n      white-space: nowrap;\n    }\n\n    .poem .author {\n      margin: 0 0 2px;\n      color: #54504d;\n      font-size: 18px;\n      line-height: 1.35;\n      font-weight: 500;\n      white-space: nowrap;\n    }\n\n    .poem .lines {\n      margin: 0;\n      font-family: \"KaiTi\", \"STKaiti\", \"Microsoft YaHei\", serif;\n      font-size: 18px;\n      line-height: 1.52;\n      font-weight: 500;\n      white-space: nowrap;\n    }\n\n    .poem.long-title {\n      padding-left: 1px;\n      padding-right: 1px;\n    }\n\n    .poem.long-title h2 {\n      font-size: 17px;\n      line-height: 1.45;\n    }\n\n    .poem-grid .poem:nth-child(4),\n    .poem-grid .poem:nth-child(5),\n    .poem-grid .poem:nth-child(6) {\n      padding-top: 10px;\n    }\n\n    .poem-grid .poem:nth-child(7),\n    .poem-grid .poem:nth-child(8),\n    .poem-grid .poem:nth-child(9) {\n      padding-top: 10px;\n    }\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <h1 class=\"title\">小学生1-6年级<span class=\"dark\">必背古诗</span></h1>\n    <div class=\"level\">· 三年级 · 下册 ·</div>\n\n    <section class=\"sheet\">\n      <div class=\"poem-grid\">\n        <article class=\"poem\">\n          <h2>《绝句》</h2>\n          <p class=\"author\">【唐】杜甫</p>\n          <p class=\"lines\">迟日江山丽，<br>春风花草香。<br>泥融飞燕子，<br>沙暖睡鸳鸯。</p>\n        </article>\n\n        <article class=\"poem\">\n          <h2>《惠崇春江晚景》</h2>\n          <p class=\"author\">【宋】苏轼</p>\n          <p class=\"lines\">竹外桃花三两枝，<br>春江水暖鸭先知。<br>蒌蒿满地芦芽短，<br>正是河豚欲上时。</p>\n        </article>\n\n        <article class=\"poem\">\n          <h2>《三衢道中》</h2>\n          <p class=\"author\">【宋】曾几</p>\n          <p class=\"lines\">梅子黄时日日晴，<br>小溪泛尽却山行。<br>绿阴不减来时路，<br>添得黄鹂四五声。</p>\n        </article>\n\n        <article class=\"poem\">\n          <h2>《忆江南》</h2>\n          <p class=\"author\">【唐】白居易</p>\n          <p class=\"lines\">江南好，<br>风景旧曾谙。<br>日出江花红胜火，<br>春来江水绿如蓝，<br>能不忆江南？</p>\n        </article>\n\n        <article class=\"poem\">\n          <h2>《元日》</h2>\n          <p class=\"author\">【宋】王安石</p>\n          <p class=\"lines\">爆竹声中一岁除，<br>春风送暖入屠苏。<br>千门万户曈曈日，<br>总把新桃换旧符。</p>\n        </article>\n\n        <article class=\"poem\">\n          <h2>《清明》</h2>\n          <p class=\"author\">【唐】杜牧</p>\n          <p class=\"lines\">清明时节雨纷纷，<br>路上行人欲断魂。<br>借问酒家何处有，<br>牧童遥指杏花村。</p>\n        </article>\n\n        <article class=\"poem long-title\">\n          <h2>《九月九日忆山东兄弟》</h2>\n          <p class=\"author\">【唐】王维</p>\n          <p class=\"lines\">独在异乡为异客，<br>每逢佳节倍思亲。<br>遥知兄弟登高处，<br>遍插茱萸少一人。</p>\n        </article>\n\n        <article class=\"poem\">\n          <h2>《滁州西涧》</h2>\n          <p class=\"author\">【唐】韦应物</p>\n          <p class=\"lines\">独怜幽草涧边生，<br>上有黄鹂深树鸣。<br>春潮带雨晚来急，<br>野渡无人舟自横。</p>\n        </article>\n\n        <article class=\"poem\">\n          <h2>《大林寺桃花》</h2>\n          <p class=\"author\">【唐】白居易</p>\n          <p class=\"lines\">人间四月芳菲尽，<br>山寺桃花始盛开。<br>长恨春归无觅处，<br>不知转入此中来。</p>\n        </article>\n      </div>\n    </section>\n  </main>\n</body>\n</html>"
