        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Well Calibrated Simulation Study of a Novel Adaptive Parallelised Bayesian Inference</title>\n<script>\nwindow.MathJax = {\n  tex: {inlineMath: [['$', '$']], displayMath: [['$$', '$$']]}\n};\n</script>\n<script defer src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    background: #ededed;\n    color: #111;\n    font-family: \"Times New Roman\", Times, serif;\n  }\n  .poster {\n    width: 1200px;\n    min-height: 1600px;\n    margin: 0 auto;\n    padding: 14px 14px 10px;\n    background: white;\n  }\n  .main-title {\n    margin: 0 auto 18px;\n    width: 1080px;\n    text-align: center;\n    font-size: 27px;\n    line-height: 1.22;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: .15px;\n  }\n  .identity {\n    height: 133px;\n    display: grid;\n    grid-template-columns: 260px 1fr 205px;\n    align-items: center;\n    column-gap: 18px;\n    margin: 0 14px 4px;\n  }\n  .auckland-logo {\n    height: 78px;\n    background: #06618f;\n    color: white;\n    display: grid;\n    grid-template-columns: 66px 1fr;\n    align-items: center;\n    padding: 9px 12px;\n    clip-path: polygon(4% 0,100% 0,100% 82%,94% 100%,0 100%,0 14%);\n  }\n  .crest {\n    height: 58px;\n    border: 2px solid white;\n    border-radius: 5px 5px 18px 18px;\n    text-align: center;\n    font-size: 9px;\n    padding-top: 8px;\n    line-height: 1.1;\n  }\n  .crest strong { display: block; font-size: 19px; }\n  .uni-name {\n    font-family: Arial, Helvetica, sans-serif;\n    line-height: 1;\n  }\n  .uni-name .small { font-size: 12px; font-weight: bold; }\n  .uni-name .large { font-size: 22px; font-weight: bold; }\n  .uni-name .maori { font-size: 7px; margin-top: 4px; }\n  .uni-name .nz { font-size: 9px; lett