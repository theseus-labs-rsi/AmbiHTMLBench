        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>案例与思考 CASE AND CONSIDERATION</title>\n<script>\nwindow.MathJax = {\n  tex: {\n    inlineMath: [['$', '$']],\n    displayMath: [['$$', '$$']]\n  }\n};\n</script>\n<script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * {\n    box-sizing: border-box;\n  }\n\n  html,\n  body {\n    margin: 0;\n    min-height: 100%;\n    background: #ececec;\n    color: #313131;\n    font-family: \"SimSun\", \"Songti SC\", serif;\n  }\n\n  body {\n    padding: 18px 0;\n  }\n\n  .page {\n    position: relative;\n    width: 794px;\n    min-height: 1123px;\n    margin: 0 auto;\n    padding: 71px 49px 42px;\n    overflow: hidden;\n    background: #fff;\n  }\n\n  .watermark {\n    position: absolute;\n    z-index: 0;\n    color: rgba(168, 178, 185, 0.12);\n    font-family: \"Microsoft YaHei\", sans-serif;\n    font-size: 25px;\n    white-space: nowrap;\n    transform: rotate(-26deg);\n    pointer-events: none;\n  }\n\n  .w1 { top: 23px; left: -24px; }\n  .w2 { top: 31px; left: 293px; }\n  .w3 { top: 35px; right: -32px; }\n  .w4 { top: 286px; left: -27px; }\n  .w5 { top: 283px; right: -30px; }\n  .w6 { top: 553px; left: -22px; }\n  .w7 { top: 550px; right: -28px; }\n  .w8 { top: 817px; left: -20px; }\n  .w9 { top: 814px; right: -25px; }\n\n  .content {\n    position: relative;\n    z-index: 1;\n  }\n\n  .page-header {\n    height: 29px;\n    margin-bottom: 114px;\n    border-top: 1px solid #61a977;\n    border-bottom: 1px solid #a8cdb2;\n    font-family: Arial, \"Microsoft YaHei\", sans-serif;\n  }\n\n  .page-header h1 {\n    margin: 4px 0 0;\n    font-size: 13px;\n    line-height: 19px;\n    font-weight: 700;\n    letter-spacing: 0;\n  }\n\n  .columns {\n    display: grid;\n    grid-template-columns: 347px 1fr;\n    column-gap: 17px;\n    align-items: start;\n  }\n\n  