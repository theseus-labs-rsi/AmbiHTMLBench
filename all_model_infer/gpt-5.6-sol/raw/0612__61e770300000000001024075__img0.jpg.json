dth=\"1.8\"/>\n              <text x=\"109\" y=\"63\" font-size=\"14\" font-style=\"italic\" font-weight=\"700\">x</text>\n              <text x=\"61\" y=\"19\" font-size=\"14\" font-style=\"italic\" font-weight=\"700\">y</text>\n              <text x=\"58\" y=\"72\" font-size=\"13\" font-style=\"italic\">O</text>\n            </svg>\n          </div>\n        </td>\n        <td class=\"diagram-cell\">\n          <div class=\"placeholder curve-diagram\">\n            <span class=\"visually-hidden\">[Diagram: second- and fourth-quadrant branches of a reciprocal function]</span>\n            <svg viewBox=\"0 0 137 108\" aria-hidden=\"true\">\n              <defs>\n                <marker id=\"arrow-negative-x\" viewBox=\"0 0 8 8\" refX=\"7\" refY=\"4\" markerWidth=\"5\" markerHeight=\"5\" orient=\"auto\">\n                  <path d=\"M0,0 L8,4 L0,8 Z\" fill=\"#111\"/>\n                </marker>\n                <marker id=\"arrow-negative-y\" viewBox=\"0 0 8 8\" refX=\"7\" refY=\"4\" markerWidth=\"5\" markerHeight=\"5\" orient=\"auto\">\n                  <path d=\"M0,0 L8,4 L0,8 Z\" fill=\"#111\"/>\n                </marker>\n              </defs>\n              <line x1=\"17\" y1=\"55\" x2=\"105\" y2=\"55\" stroke=\"#111\" stroke-width=\"2\" marker-end=\"url(#arrow-negative-x)\"/>\n              <line x1=\"54\" y1=\"96\" x2=\"54\" y2=\"9\" stroke=\"#111\" stroke-width=\"2\" marker-end=\"url(#arrow-negative-y)\"/>\n              <path d=\"M23 49 C30 47, 37 43, 42 37 C47 31, 49 24, 50 15\" fill=\"none\" stroke=\"#111\" stroke-width=\"1.8\"/>\n              <path d=\"M60 93 C62 84, 66 76, 72 70 C78 64, 85 61, 94 59\" fill=\"none\" stroke=\"#111\" stroke-width=\"1.8\"/>\n              <text x=\"109\" y=\"63\" font-size=\"14\" font-style=\"italic\" font-weight=\"700\">x</text>\n              <text x=\"61\" y=\"19\" font-size=\"14\" font-style=\"italic\" font-weight=\"700\">y</text>\n              <text x=\"58\" y=\"72\" font-size=\"13\" font-style=\"italic\">O</text>\n  