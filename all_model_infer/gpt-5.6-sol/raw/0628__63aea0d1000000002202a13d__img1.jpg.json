        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>40 篇短文背完 3500 词——Mark and a Seal</title>\n<script>\nwindow.MathJax = {\n  tex: {\n    inlineMath: [['$', '$']],\n    displayMath: [['$$', '$$']]\n  }\n};\n</script>\n<script defer src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * {\n    box-sizing: border-box;\n  }\n\n  html,\n  body {\n    margin: 0;\n    padding: 0;\n    background: #f3f3f3;\n  }\n\n  body {\n    display: flex;\n    justify-content: center;\n    min-height: 100vh;\n  }\n\n  .page {\n    position: relative;\n    width: 540px;\n    height: 720px;\n    overflow: hidden;\n    background: #fff;\n    color: #111;\n  }\n\n  .main-title {\n    position: absolute;\n    top: 20px;\n    left: 26px;\n    margin: 0;\n    white-space: nowrap;\n    font-family: \"STKaiti\", \"KaiTi\", \"Kaiti SC\", \"Microsoft YaHei\", sans-serif;\n    font-size: 45px;\n    line-height: 1.15;\n    font-weight: 900;\n    letter-spacing: 0.2px;\n  }\n\n  .subtitle {\n    position: absolute;\n    top: 104px;\n    left: 177px;\n    margin: 0;\n    white-space: nowrap;\n    color: #087da7;\n    font-family: \"Comic Sans MS\", \"Trebuchet MS\", \"Kaiti SC\", \"KaiTi\", sans-serif;\n    font-size: 18px;\n    line-height: 22px;\n    font-weight: 700;\n    letter-spacing: -0.15px;\n  }\n\n  .passage {\n    position: absolute;\n    top: 147px;\n    left: 20px;\n    width: 510px;\n  }\n\n  .text-row {\n    position: relative;\n    width: 510px;\n    height: 40.4px;\n  }\n\n  .english {\n    height: 20px;\n    overflow: visible;\n    white-space: nowrap;\n    font-family: \"Comic Sans MS\", \"Trebuchet MS\", sans-serif;\n    font-size: 14.4px;\n    line-height: 19px;\n    font-weight: 600;\n    letter-spacing: -0.38px;\n    transform: scaleX(0.985);\n    transform-origin: left top;\n  }\n\n  .red {\n    color: #e20f18;\n    font-weight: 700;\n  }\n\n  .number {\n    display: inline-block;\n    margin-right: 1px;\n    font-family: Arial, sans-serif;\n    font-weight: 900;\n    letter-spacing: 0;\n  }\n\n  .gloss {\n    position: absolute;\n    top: 20px;\n    left: 0;\n    width: 510px;\n    height: 19px;\n    white-space: nowrap;\n    font-family: \"STKaiti\", \"KaiTi\", \"Kaiti SC\", serif;\n    font-size: 13.3px;\n    line-height: 18px;\n    font-weight: 500;\n  }\n\n  .gloss span {\n    position: absolute;\n    top: 0;\n  }\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <h1 class=\"main-title\">40 篇短文背完 3500 词</h1>\n  <div class=\"subtitle\">一. Mark and a Seal 马克和海豹</div>\n\n  <section class=\"passage\">\n    <div class=\"text-row\">\n      <div class=\"english\"><span class=\"number\">❶</span>Mark <span class=\"red\">rented</span> an accommodation with his <span class=\"red\">pension</span> near the <span class=\"red\">shore</span>. He paid</div>\n      <div class=\"gloss\">\n        <span style=\"left:61px;\">租借</span>\n        <span style=\"left:157px;\">住处</span>\n        <span style=\"left:278px;\">养老金</span>\n        <span style=\"left:337px;\">在...旁边</span>\n        <span style=\"left:433px;\">海岸</span>\n      </div>\n    </div>\n\n    <div class=\"text-row\">\n      <div class=\"english\"><span class=\"red\">annual visits</span> there to enjoy the <span class=\"red\">vivid beauty</span> in the depths of the <span class=\"red\">pure</span> sea.</div>\n      <div class=\"gloss\">\n        <span style=\"left:3px;\">每年的访问</span>\n        <span style=\"left:171px;\">享受</span>\n        <span style=\"left:235px;\">生动的美丽</span>\n        <span style=\"left:357px;\">深处</span>\n        <span style=\"left:444px;\">纯粹的</span>\n      </div>\n    </div>\n\n    <div class=\"text-row\">\n      <div class=\"english\"><span class=\"number\">❷</span><span class=\"red\">Once</span>, with his <span class=\"red\">underwater telescope</span> and flashlight. Mark <span class=\"red\">dived along</span> the</div>\n      <div class=\"gloss\">\n        <span style=\"left:18px;\">有一次</span>\n        <span style=\"left:124px;\">水下</span>\n        <span style=\"left:195px;\">望远镜</span>\n        <span style=\"left:293px;\">手电筒</span>\n        <span style=\"left:410px;\">潜</span>\n        <span style=\"left:464px;\">沿着</span>\n      </div>\n    </div>\n\n    <div class=\"text-row\">\n      <div class=\"english\"><span class=\"red\">boundary between</span> the <span class=\"red\">steep reef</span> and the <span class=\"red\">area</span> of <span class=\"red\">seaweed conservation</span>.</div>\n      <div class=\"gloss\">\n        <span style=\"left:4px;\">分界线</span>\n        <span style=\"left:88px;\">在...之间</span>\n        <span style=\"left:188px;\">陡峭的暗礁</span>\n        <span style=\"left:309px;\">地区</span>\n        <span style=\"left:378px;\">海草</span>\n        <span style=\"left:458px;\">保护区</span>\n      </div>\n    </div>\n\n    <div class=\"text-row\">\n      <div class=\"english\"><span class=\"red\">Suddenly</span> an <span class=\"red\">awesome Antarctic seal</span> with <span class=\"red\">sharp teeth appeared opposite</span></div>\n      <div class=\"gloss\">\n        <span style=\"left:3px;\">突然</span>\n        <span style=\"left:71px;\">令人敬畏的</span>\n        <span style=\"left:168px;\">南极的</span>\n        <span style=\"left:226px;\">海豹</span>\n        <span style=\"left:302px;\">锋利的牙齿</span>\n        <span style=\"left:410px;\">出现</span>\n        <span style=\"left:454px;\">在...对面</span>\n      </div>\n    </div>\n\n    <div class=\"text-row\">\n      <div class=\"english\">him. Every <span class=\"red\">cell</span> in his <span class=\"red\">body</span> was <span class=\"red\">scared</span> to death. <span class=\"red\">But</span> soon, he was <span class=\"red\">aware</span></div>\n      <div class=\"gloss\">\n        <span style=\"left:68px;\">细胞</span>\n        <span style=\"left:145px;\">身体</span>\n        <span style=\"left:213px;\">被吓死了</span>\n        <span style=\"left:330px;\">但是</span>\n        <span style=\"left:442px;\">意识到</span>\n      </div>\n    </div>\n\n    <div class=\"text-row\">\n      <div class=\"english\">that he wasn't the <span class=\"red\">target</span> of an <span class=\"red\">attack</span>. With a <span class=\"red\">neat wound</span> in its <span class=\"red\">lip caused</span></div>\n      <div class=\"gloss\">\n        <span style=\"left:105px;\">目标</span>\n        <span style=\"left:192px;\">袭击</span>\n        <span style=\"left:285px;\">整齐的伤口</span>\n        <span style=\"left:409px;\">嘴唇</span>\n        <span style=\"left:470px;\">造成</span>\n      </div>\n    </div>\n\n    <div class=\"text-row\">\n      <div class=\"english\">by a <span class=\"red\">shark</span>, this grey seal <span class=\"red\">was washed</span> <span class=\"red\">upside down</span> by the <span class=\"red\">tides time after</span></div>\n      <div class=\"gloss\">\n        <span style=\"left:48px;\">鲨鱼</span>\n        <span style=\"left:117px;\">灰色的海豹</span>\n        <span style=\"left:225px;\">被水冲</span>\n        <span style=\"left:293px;\">头上</span>\n        <span style=\"left:345px;\">脚下</span>\n        <span style=\"left:407px;\">潮水</span>\n        <span style=\"left:463px;\">时不时地</span>\n      </div>\n    </div>\n\n    <div class=\"text-row\">\n      <div class=\"english\"><span class=\"red\">time</span>. But it <span class=\"red\">tried</span> to <span class=\"red\">jog</span> Mark <span class=\"red\">as if</span> to <span class=\"red\">urge</span> him to <span class=\"red\">help</span> it. So Mark <span class=\"red\">abandoned</span></div>\n      <div class=\"gloss\">\n        <span style=\"left:81px;\">努力</span>\n        <span style=\"left:151px;\">轻轻碰撞</span>\n        <span style=\"left:254px;\">好像</span>\n        <span style=\"left:319px;\">催促</span>\n        <span style=\"left:376px;\">帮助</span>\n        <span style=\"left:473px;\">放弃</span>\n      </div>\n    </div>\n\n    <div class=\"text-row\">\n      <div class=\"english\"><span class=\"red\">fleeing away</span>. With its <span class=\"red\">teamwork</span>, Mark used a <span class=\"red\">net</span> to drag the <span class=\"red\">seal</span> to the</div>\n      <div class=\"gloss\">\n        <span style=\"left:34px;\">逃跑</span>\n        <span style=\"left:158px;\">团队合作</span>\n        <span style=\"left:285px;\">用</span>\n        <span style=\"left:332px;\">网</span>\n        <span style=\"left:391px;\">拖</span>\n        <span style=\"left:459px;\">海豹</span>\n      </div>\n    </div>\n\n    <div class=\"text-row\">\n      <div class=\"english\"><span class=\"red\">shallow water</span>. Without <span class=\"red\">pausing</span> he <span class=\"red\">helped it out</span> after a simple operation</div>\n      <div class=\"gloss\">\n        <span style=\"left:18px;\">浅水区</span>\n        <span style=\"left:138px;\">毫不停歇地</span>\n        <span style=\"left:257px;\">帮助它解决问题</span>\n        <span style=\"left:411px;\">简单的</span>\n        <span style=\"left:480px;\">手术</span>\n      </div>\n    </div>\n\n    <div class=\"text-row\">\n      <div class=\"english\">and <span class=\"red\">settled</span> in a <span class=\"red\">narrow cave</span> by the <span class=\"red\">seaside</span>. Every time he brought it <span class=\"red\">tasty</span></div>\n      <div class=\"gloss\">\n        <span style=\"left:30px;\">安顿</span>\n        <span style=\"left:130px;\">狭窄的</span>\n        <span style=\"left:205px;\">山洞</span>\n        <span style=\"left:282px;\">海边</span>\n        <span style=\"left:363px;\">每次</span>\n        <span style=\"left:467px;\">美味的</span>\n      </div>\n    </div>\n\n    <div class=\"text-row\">\n      <div class=\"english\">fish it would <span class=\"red\">yell</span> and <span class=\"red\">suck</span> his hands <span class=\"red\">happily</span>. <span class=\"red\">Witnesses</span> said their <span class=\"red\">anecdotes</span></div>\n      <div class=\"gloss\">\n        <span style=\"left:106px;\">叫喊</span>\n        <span style=\"left:173px;\">吮吸</span>\n        <span style=\"left:266px;\">开心地</span>\n        <span style=\"left:349px;\">目击者</span>\n        <span style=\"left:426px;\">他们的</span>\n        <span style=\"left:486px;\">轶事</span>\n      </div>\n    </div>\n\n    <div class=\"text-row\">\n      <div class=\"english\"><span class=\"red\">reflected</span> a <span class=\"red\">magic dimension</span> of the <span class=\"red\">relationship</span> between <span class=\"red\">humans</span> and <span class=\"red\">animals</span>.</div>\n      <div class=\"gloss\">\n        <span style=\"left:13px;\">映射</span>\n        <span style=\"left:94px;\">奇妙的</span>\n        <span style=\"left:178px;\">方面</span>\n        <span style=\"left:292px;\">关系</span>\n        <span style=\"left:405px;\">人</span>\n        <span style=\"left:456px;\">与</span>\n        <span style=\"left:489px;\">动物</span>\n      </div>\n    </div>\n  </section>\n</main>\n</body>\n</html>"
      },
