ight: 544px;\n  }\n\n  .item {\n    position: relative;\n    display: grid;\n    grid-template-columns: 85px 1fr;\n    min-width: 0;\n    padding: 7px 5px 5px 5px;\n  }\n\n  .item:nth-child(odd) {\n    border-right: 7px dotted #9b2c32;\n  }\n\n  .item:not(:nth-last-child(-n+2)) {\n    border-bottom: 7px dotted #9b2c32;\n  }\n\n  .placeholder {\n    position: relative;\n    width: 78px;\n    height: 118px;\n    align-self: center;\n    overflow: hidden;\n  }\n\n  .ph-caption {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    margin: -1px;\n    overflow: hidden;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n    border: 0;\n  }\n\n  .bottle {\n    position: absolute;\n    left: 50%;\n    bottom: 3px;\n    width: 37px;\n    height: 82px;\n    transform: translateX(-50%);\n    border: 1px solid rgba(45,35,25,.65);\n    border-radius: 5px 5px 8px 8px;\n    box-shadow: inset 5px 0 7px rgba(255,255,255,.18), 1px 2px 2px rgba(0,0,0,.22);\n  }\n\n  .bottle::before {\n    content: \"\";\n    position: absolute;\n    left: 11px;\n    top: -34px;\n    width: 13px;\n    height: 36px;\n    border: 1px solid rgba(45,35,25,.65);\n    border-bottom: 0;\n    border-radius: 3px 3px 0 0;\n    background: inherit;\n  }\n\n  .bottle::after {\n    content: \"\";\n    position: absolute;\n    left: 4px;\n    top: 25px;\n    width: 27px;\n    height: 38px;\n    border: 1px solid rgba(92,74,53,.45);\n    background: #e6dfbf;\n  }\n\n  .black .bottle {\n    width: 42px;\n    height: 76px;\n    background: linear-gradient(90deg, #101314, #303534 50%, #101313);\n  }\n\n  .black .bottle::before {\n    left: 13px;\n    width: 14px;\n    background: #171b1c;\n  }\n\n  .amber .bottle {\n    background: linear-gradient(90deg, #8d3f16, #e39a38 45%, #743213);\n  }\n\n  .gold .bottle {\n    width: 35px;\n    height: 79px;\n    background: linear-gradient(90deg, #e3a51d, #ffd656 48%, #b9700b);\n  }\n\n  .gold .bottle::before {\n    left: 10px;\n    background: #