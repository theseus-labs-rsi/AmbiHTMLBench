: 900;\n    white-space: nowrap;\n    letter-spacing: -1px;\n  }\n\n  .heading.long {\n    font-size: 17px;\n    letter-spacing: -1.4px;\n  }\n\n  .description {\n    margin: 7px 0 0;\n    font-size: 11.1px;\n    line-height: 1.35;\n    font-weight: 800;\n    text-align: left;\n  }\n\n  .item.compact .description {\n    font-size: 10.45px;\n    line-height: 1.28;\n    margin-top: 6px;\n  }\n</style>\n</head>\n<body>\n<div class=\"canvas\">\n  <main class=\"page\">\n    <header class=\"masthead\">\n      <h1>八款最好喝的梅酒</h1>\n      <div class=\"subtitle\">女生微醺必备酒款</div>\n    </header>\n\n    <section class=\"catalog\">\n      <article class=\"item\">\n        <div class=\"placeholder black\" role=\"img\" aria-label=\"山崎梅酒樽仕入酒瓶\">\n          <span class=\"ph-caption\">[Product bottle image: left]</span>\n          <div class=\"bottle\"></div>\n        </div>\n        <div class=\"copy\">\n          <h2 class=\"heading\">山崎梅酒樽仕入</h2>\n          <p class=\"description\">山崎入门级梅酒，也是最经典的一款，口感也是接受度最高的一款。目前已经停产，市场上存量越来越少，想喝或者想收藏小伙伴可以尽快尝试一下。</p>\n        </div>\n      </article>\n\n      <article class=\"item\">\n        <div class=\"placeholder gold\" role=\"img\" aria-label=\"山崎梅酒樽熟酒瓶\">\n          <span class=\"ph-caption\">[Product bottle image: left]</span>\n          <div class=\"bottle\"></div>\n        </div>\n        <div class=\"copy\">\n          <h2 class=\"heading\">山崎梅酒樽熟</h2>\n          <p class=\"description\">代替樽仕入经典款的新产品，与经典款相同的是，都是使用白兰地作为基酒，但是新款的酒精度到了20度，相比经典款香味与酒气味道更重一些。</p>\n        </div>\n      </article>\n\n      <article class=\"item\">\n        <div class=\"placeholder amber\" role=\"img\" aria-label=\"俏雅黑金本格酒瓶\">\n          <span class=\"ph-caption\">[Product bottle image: left]</span>\n          <div class=\"bottle\"></div>\n        </div>\n        <div class=\"copy\">\n          <h2 class=\"heading\">俏雅黑金本格</h2>\n          <p class=\"description\">这是一款白兰地本格梅酒，所以品尝起来会感觉洋酒的味道浓厚一些，可以搭配气泡水一起饮用，口感会更顺滑。</p>\n        </div>\n      </article>\n\n      <article class=\"item\">\n        <div class=\"placeholder green\" role=\"img\" aria-label=\"杂贺纪州梅酒酒瓶\">\n          <span class=\"ph-caption\">[Product bottle image: left]</span>\n          <div class=\"bottle\"></div>\n        </div>\n        <div class=\"copy\">\n          <h2 class=\"heading\">杂贺纪州梅酒</h2>\n          <p class=\"description\">闻名遐迩的杂贺清酒为基底，放入梅子加以浸泡，最后再放入美味的梅子酱，口感浓稠甘甜，而青梅的酸度对健康多有益处。</p>\n        </div>\n      </article>\n\n      <article class=\"item\">\n        <div class=\"placeholder orange\" role=\"img\" aria-label=\"三得利梅酒酒瓶\">\n          <span class=\"ph-caption\">[Product bottle image: left]</span>\n          <div class=\"bottle\"></div>\n        </div>\n        <div class=\"copy\">\n          <h2 class=\"heading\">三得利梅酒</h2>\n          <p class=\"description\">这款是三得利旗下的经典梅酒，酸甜爽口，口感愉悦，冰镇后梅酒的口感进一步被激发，再加上一杯苏打水，不论是配餐还是睡前轻酌都是很好的选择。</p>\n        </div>\n      </article>\n\n      <article class=\"item compact\">\n        <div class=\"placeholder square\" role=\"img\" aria-label=\"明石信威士忌梅酒酒瓶\">\n          <span class=\"ph-caption\">[Product bottle image: left]</span>\n          <div class=\"bottle\"></div>\n        </div>\n        <div class=\"copy\">\n          <h2 class=\"heading long\">明石信威士忌梅酒</h2>\n          <p class=\"description\">女生会喜欢的威士忌梅酒，黄金比例调配，醇厚香甜的酒体，细腻顺口的口感。第一次尝试时，让人很难感受到威士忌的存在，直到喝完后的回甘才发现它们完美的融合在了一起。</p>\n        </div>\n      </article>\n\n      <article class=\"item compact\">\n        <div class=\"placeholder black\" role=\"img\" aria-label=\"蝶矢黑糖梅酒酒瓶\">\n          <span class=\"ph-caption\">[Product bottle image: left]</span>\n          <div class=\"bottle\"></div>\n        </div>\n        <div class=\"copy\">\n          <h2 class=\"heading\">蝶矢黑糖梅酒</h2>\n          <p class=\"description\">一款浓郁的黑糖与梅酒的完美融合，黑糖里的甘蔗矿物质给梅酒带来了独特的芳香甜味，推荐与牛奶一起搭配，口感顺滑醇厚又饱满~</p>\n        </div>\n      </article>\n\n      <article class=\"item compact\">\n        <div class=\"placeholder carton-pair\" role=\"img\" aria-label=\"长乐无忧梅酒包装与酒瓶\">\n          <span class=\"ph-caption\">[Product packaging and bottle image: left]</span>\n          <div class=\"carton\"></div>\n          <div class=\"small-bottle\"></div>\n        </div>\n        <div class=\"copy\">\n          <h2 class=\"heading\">长乐无忧梅酒</h2>\n          <p class=\"description\">一款国产的优秀梅酒，被超高颜值吸引来尝试，被其超棒的口感俘获，清爽顺滑的口感，入口后，淡淡的青梅香气保留得很棒，酸甜适中，这款酒十分健康，即便是正在身材管理的女生也可以放心饮用~</p>\n        </div>\n      </article>\n    </section>\n  </main>\n</div>\n</body>\n</html>"
