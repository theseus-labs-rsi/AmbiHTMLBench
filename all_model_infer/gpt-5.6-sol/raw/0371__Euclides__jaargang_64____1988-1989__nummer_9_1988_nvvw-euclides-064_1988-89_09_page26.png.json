ont-style: italic;\n  }\n\n  .footer .department {\n    font-style: normal;\n  }\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <header class=\"section-banner\" aria-label=\"Bijdrage\">\n    <span class=\"dot\"></span>\n    <span class=\"label\">Bijdrage</span>\n    <span class=\"dot\"></span>\n    <span class=\"dot\"></span>\n    <span class=\"dot\"></span>\n    <span class=\"dot\"></span>\n  </header>\n\n  <section class=\"top-table\" aria-label=\"Scorefrequenties\">\n    <table class=\"frequency-table\">\n      <colgroup>\n        <col style=\"width:11%\">\n        <col style=\"width:18%\">\n        <col style=\"width:21%\">\n        <col style=\"width:11%\">\n        <col style=\"width:18%\">\n        <col style=\"width:21%\">\n      </colgroup>\n      <thead>\n        <tr>\n          <th>score</th>\n          <th>frequentie</th>\n          <th>cumulatieve<br>frequentie</th>\n          <th>score</th>\n          <th>frequentie</th>\n          <th>cumulatieve<br>frequentie</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr><td>36</td><td>1</td><td>1</td><td>18</td><td>20</td><td>158</td></tr>\n        <tr><td>35</td><td>0</td><td>1</td><td>17</td><td>41</td><td>199</td></tr>\n        <tr><td>34</td><td>1</td><td>2</td><td>16</td><td>33</td><td>232</td></tr>\n        <tr><td>33</td><td>2</td><td>4</td><td>15</td><td>50</td><td>282</td></tr>\n        <tr><td>32</td><td>1</td><td>5</td><td>14</td><td>69</td><td>351</td></tr>\n        <tr><td>31</td><td>2</td><td>7</td><td>13</td><td>59</td><td>410</td></tr>\n        <tr><td>30</td><td>2</td><td>9</td><td>12</td><td>66</td><td>476</td></tr>\n        <tr><td>29</td><td>4</td><td>13</td><td>11</td><td>73</td><td>549</td></tr>\n        <tr><td>28</td><td>2</td><td>15</td><td>10</td><td>99</td><td>648</td></tr>\n        <tr><td>27</td><td>6</td><td>21</td><td>9</td><td>105</td><td>753</td></tr>\n        <tr><td>26</td><td>5</td><td>26</td><td>8</td><td>121</td><td>874</td></tr>\n        <tr><td>25</td><