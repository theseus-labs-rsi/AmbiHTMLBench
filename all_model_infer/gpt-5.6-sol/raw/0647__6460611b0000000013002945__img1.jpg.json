n    background: #c25ae5;\n  }\n  .blue-dot {\n    background: #426ed2;\n  }\n  .connector {\n    position: absolute;\n    background: #1d6595;\n  }\n  .connector.thin {\n    background: #4f86a5;\n  }\n  .h { height: 1px; }\n  .v { width: 1px; }\n  .left-bracket {\n    position: absolute;\n    left: 22px;\n    top: 59px;\n    width: 3px;\n    height: 627px;\n    background: #126193;\n  }\n  .left-bracket-top {\n    position: absolute;\n    left: 23px;\n    top: 53px;\n    width: 15px;\n    height: 3px;\n    background: #126193;\n    transform: rotate(-45deg);\n    transform-origin: left center;\n  }\n  .left-bracket-bottom {\n    position: absolute;\n    left: 22px;\n    top: 685px;\n    width: 20px;\n    height: 3px;\n    background: #126193;\n    transform: rotate(48deg);\n    transform-origin: left center;\n  }\n  .side-highlight {\n    position: absolute;\n    left: 0;\n    top: 242px;\n    width: 12px;\n    line-height: 17px;\n    text-align: center;\n    font-size: 12px;\n  }\n  .side-highlight span {\n    display: block;\n    width: 12px;\n    height: 17px;\n  }\n  .green { background: #c9eb80; }\n  .yellow { background: #efe37a; }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"title\">第一章&nbsp;&nbsp;教育与教育学</div>\n\n  <div class=\"side-highlight\">\n    <span class=\"green\">教</span>\n    <span class=\"green\">育</span>\n    <span class=\"green\">与</span>\n    <span class=\"yellow\">教</span>\n    <span class=\"green\">育</span>\n    <span class=\"yellow\">学</span>\n  </div>\n\n  <div class=\"left-bracket\"></div>\n  <div class=\"left-bracket-top\"></div>\n  <div class=\"left-bracket-bottom\"></div>\n\n  <div class=\"section-title\" style=\"left:32px; top:51px;\">1、教育及其产生与发展</div>\n\n  <div class=\"connector thin h\" style=\"left:24px; top:75px; width:80px;\"></div>\n  <div class=\"connector thin v\" style=\"left:86px; top:75px; height:197px;\"></div>\n  <div class=\"connector thin h\" style=\"left:86px; top:75px; width:17px;\"></div>\n  <div class=\"small-label\" style=\"left:101px; top:69px;\">研究对象和任务</div>\n\n  <div class=\"connector thin h\" style=\"left:86px; top:88px; width:51px;\"></div>\n  <div class=\"connector thin v\" style=\"left:136px; top:88px; height:625px;\"></div>\n\n  <div class=\"stage\" style=\"top:87px;\">（四）发展多样化阶段（19世纪末——20世纪初）</div>\n\n  <div class=\"bullet blue-dot\" style=\"top:109px;\"></div>\n  <div class=\"line\" style=\"top:103px;\">杜威——“现代教育”代言人，实用主义代表</div>\n\n  <div class=\"line indent\" style=\"top:120px;\">①《民主主义与教育》</div>\n  <div class=\"connector thin h\" style=\"left:260px; top:128px; width:11px;\"></div>\n  <div class=\"connector thin v\" style=\"left:270px; top:128px; height:51px;\"></div>\n  <div class=\"connector thin h\" style=\"left:270px; top:133px; width:8px;\"></div>\n  <div class=\"connector thin h\" style=\"left:270px; top:149px; width:8px;\"></div>\n  <div class=\"connector thin h\" style=\"left:270px; top:165px; width:8px;\"></div>\n  <div class=\"connector thin h\" style=\"left:270px; top:178px; width:8px;\"></div>\n\n  <div class=\"line deep\" style=\"top:120px;\">活动课程：从做中学</div>\n  <div class=\"line deep\" style=\"top:136px;\">五部教学法：困难、问题、假设、验证、结论</div>\n  <div class=\"line deep\" style=\"top:152px;\">儿童中心论：儿童、活动、经验</div>\n  <div class=\"line deep\" style=\"top:168px;\">教育无目的论</div>\n\n  <div class=\"line indent\" style=\"top:183px;\">②论教育的本质——什么是教育？</div>\n  <div class=\"connector thin h\" style=\"left:316px; top:191px; width:10px;\"></div>\n  <div class=\"connector thin v\" style=\"left:326px; top:191px; height:49px;\"></div>\n  <div class=\"connector thin h\" style=\"left:326px; top:192px; width:8px;\"></div>\n  <div class=\"connector thin h\" style=\"left:326px; top:208px; width:8px;\"></div>\n  <div class=\"connector thin h\" style=\"left:326px; top:224px; width:8px;\"></div>\n  <div class=\"line\" style=\"left:332px; top:184px;\">教育即生长</div>\n  <div class=\"line\" style=\"left:332px; top:200px;\">教育即生活</div>\n  <div class=\"line\" style=\"left:332px; top:216px;\">教育即经验的改组和改造</div>\n\n  <div class=\"section-title\" style=\"left:25px; top:184px;\">2、教育学</div>\n  <div class=\"multi-label\" style=\"left:31px; top:202px;\">的产生<br>与发展</div>\n\n  <div class=\"connector thin h\" style=\"left:24px; top:239px; width:63px;\"></div>\n  <div class=\"connector thin h\" style=\"left:86px; top:255px; width:50px;\"></div>\n  <div class=\"small-label\" style=\"left:96px; top:234px; line-height:18px;\">产生和<br>发展历程</div>\n\n  <div class=\"bullet\" style=\"top:232px;\"></div>\n  <div class=\"line\" style=\"top:226px;\">梅伊曼、拉伊——首次提出实验教育学</div>\n\n  <div class=\"bullet\" style=\"top:248px;\"></div>\n  <div class=\"line\" style=\"top:242px;\">斯宾塞——教育的任务是教导人们怎样生活</div>\n\n  <div class=\"bullet\" style=\"top:264px;\"></div>\n  <div class=\"line\" style=\"top:258px;\">凯洛夫——世界上第一部马克思主义教育学著作</div>\n\n  <div class=\"bullet\" style=\"top:280px;\"></div>\n  <div class=\"line\" style=\"top:274px;\">福禄贝尔——世界“幼儿教育之父”</div>\n\n  <div class=\"bullet\" style=\"top:296px;\"></div>\n  <div class=\"line\" style=\"top:290px;\">马卡连柯——《集体主义教育思想》</div>\n\n  <div class=\"stage\" style=\"top:303px;\">（五）教育学的分化与拓展阶段（20世纪中期至今）</div>\n\n  <div class=\"bullet\" style=\"top:326px;\"></div>\n  <div class=\"line\" style=\"top:320px;\">布卢姆（美国）《教育目标的分类系统》—认知、情感、动作、技能目标</div>\n\n  <div class=\"bullet\" style=\"top:344px;\"></div>\n  <div class=\"line\" style=\"top:338px;\">巴班斯基（苏联）《教学过程最优化》</div>\n\n  <div class=\"bullet\" style=\"top:362px;\"></div>\n  <div class=\"line\" style=\"top:356px;\">苏霍姆林斯基（苏联）《给教师的一百条建议》《把整个心灵献给孩子》</div>\n\n  <div class=\"small-label\" style=\"left:139px; top:376px; line-height:17px;\">现代教育理<br>论三大流派</div>\n  <div class=\"connector thin h\" style=\"left:136px; top:384px; width:50px;\"></div>\n  <div class=\"connector thin v\" style=\"left:186px; top:384px; height:61px;\"></div>\n  <div class=\"connector thin h\" style=\"left:186px; top:384px; width:8px;\"></div>\n  <div class=\"connector thin h\" style=\"left:186px; top:416px; width:8px;\"></div>\n  <div class=\"connector thin h\" style=\"left:186px; top:440px; width:8px;\"></div>\n\n  <div class=\"line\" style=\"left:193px; top:376px;\">①赞可夫《教学与发展》五大教学原则</div>\n  <div class=\"line\" style=\"left:285px; top:392px;\">高难度、高速度、理论指导作用、理解学习过程、</div>\n  <div class=\"line\" style=\"left:285px; top:408px;\">使所有学生得到一般发展</div>\n  <div class=\"line\" style=\"left:193px; top:424px;\">②布鲁纳《教学过程》——结构教学论、发现法</div>\n  <div class=\"line\" style=\"left:193px; top:440px;\">③瓦·根舍因——范例教学</div>\n\n  <div class=\"stage\" style=\"top:453px;\">（六）中国近现代的教育思想</div>\n\n  <div class=\"bullet\" style=\"top:474px;\"></div>\n  <div class=\"line\" style=\"top:468px;\">蔡元培</div>\n  <div class=\"connector thin h\" style=\"left:183px; top:476px; width:8px;\"></div>\n  <div class=\"connector thin v\" style=\"left:190px; top:476px; height:61px;\"></div>\n  <div class=\"connector thin h\" style=\"left:190px; top:476px; width:7px;\"></div>\n  <div class=\"connector thin h\" style=\"left:190px; top:492px; width:7px;\"></div>\n  <div class=\"connector thin h\" style=\"left:190px; top:508px; width:7px;\"></div>\n  <div class=\"connector thin h\" style=\"left:190px; top:524px; width:7px;\"></div>\n  <div class=\"line\" style=\"left:197px; top:468px;\">①学界泰斗，人世楷模——毛泽东</div>\n  <div class=\"line\" style=\"left:197px; top:484px;\">②“五育并举”——教育第一人</div>\n  <div class=\"line\" style=\"left:197px; top:500px;\">③完全人格</div>\n  <div class=\"line\" style=\"left:197px; top:516px;\">④北大改革——思想自由，兼容并包</div>\n\n  <div class=\"bullet\" style=\"top:535px;\"></div>\n  <div class=\"line\" style=\"top:529px;\">陶行知</div>\n  <div class=\"connector thin h\" style=\"left:183px; top:537px; width:8px;\"></div>\n  <div class=\"connector thin v\" style=\"left:190px; top:537px; height:65px;\"></div>\n  <div class=\"connector thin h\" style=\"left:190px; top:537px; width:7px;\"></div>\n  <div class=\"connector thin h\" style=\"left:190px; top:553px; width:7px;\"></div>\n  <div class=\"connector thin h\" style=\"left:190px; top:569px; width:7px;\"></div>\n\n  <div class=\"line\" style=\"left:197px; top:529px;\">①伟大的人民教育家——毛泽东，万世师表——宋庆龄</div>\n  <div class=\"line\" style=\"left:197px; top:545px;\">②捧着一颗心来，不带半根草去</div>\n  <div class=\"line\" style=\"left:197px; top:561px;\">③生活教育论——生活即教育：核心思想</div>\n  <div class=\"line\" style=\"left:285px; top:577px;\">社会即学校：范围论、重要命题</div>\n  <div class=\"line\" style=\"left:285px; top:593px;\">教学做合一：方法论</div>\n\n  <div class=\"bullet\" style=\"top:614px;\"></div>\n  <div class=\"line\" style=\"top:608px;\">陈鹤琴</div>\n  <div class=\"connector thin h\" style=\"left:183px; top:616px; width:8px;\"></div>\n  <div class=\"connector thin v\" style=\"left:190px; top:616px; height:45px;\"></div>\n  <div class=\"connector thin h\" style=\"left:190px; top:616px; width:7px;\"></div>\n  <div class=\"connector thin h\" style=\"left:190px; top:632px; width:7px;\"></div>\n  <div class=\"connector thin h\" style=\"left:190px; top:648px; width:7px;\"></div>\n\n  <div class=\"line\" style=\"left:197px; top:608px;\">①中国幼儿教育奠基人（之父）</div>\n  <div class=\"line\" style=\"left:197px; top:624px;\">②创办了中国第一所实验幼稚园——南京鼓楼幼稚园</div>\n  <div class=\"line\" style=\"left:197px; top:640px;\">③活教育体系——四个步骤：实验观察/阅读思考/创作发表/批评研讨</div>\n\n  <div class=\"bullet\" style=\"top:665px;\"></div>\n  <div class=\"line\" style=\"top:659px;\">杨贤江《新教育大纲》1930年是我国第一部马克思主义的教育学著作</div>\n\n  <div class=\"bullet\" style=\"top:681px;\"></div>\n  <div class=\"line\" style=\"top:675px;\">黄炎培——中国职业教育之父</div>\n\n  <div class=\"bullet\" style=\"top:697px;\"></div>\n  <div class=\"line\" style=\"top:691px;\">晏阳初——国际平民教育之父</div>\n\n  <div class=\"bullet\" style=\"top:713px;\"></div>\n  <div class=\"line\" style=\"top:707px;\">梁漱溟——中国最后一位大儒</div>\n\n  <div class=\"connector thin h\" style=\"left:136px; top:112px; width:8px;\"></div>\n  <div class=\"connector thin h\" style=\"left:136px; top:235px; width:8px;\"></div>\n  <div class=\"connector thin h\" style=\"left:136px; top:251px; width:8px;\"></div>\n  <div cla