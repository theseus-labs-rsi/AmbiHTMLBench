"page\">\n  <div class=\"header-fields\">\n    <div>No.<span class=\"line\"></span></div>\n    <div>Date<span class=\"line\"></span></div>\n  </div>\n  <div class=\"top-curve\"></div>\n\n  <section class=\"top-example\">\n    <div class=\"example-row\">\n      <div class=\"example-label\">例：设</div>\n      <div class=\"top-matrices\">\n        <span class=\"math\">\n          $A=\\begin{pmatrix}\n          1&0&-1\\\\\n          -1&1&0\\\\\n          0&1&-1\n          \\end{pmatrix}$\n        </span>\n        <span class=\"math\">\n          $B=\\begin{pmatrix}\n          0&3&4\\\\\n          1&2&-1\\\\\n          3&1&-1\n          \\end{pmatrix}$\n        </span>\n        <span>求 $AB$</span>\n      </div>\n    </div>\n\n    <div class=\"ab-result\">\n      <span>$AB=$</span>\n      <span>\n        $\\begin{pmatrix}\n        $<span class=\"circled\">$-3$</span>$&6&7\\\\\n        0&-2&-6\\\\\n        -2&1&10\n        \\end{pmatrix}$\n      </span>\n      <span class=\"calculation-note\">$=1{\\times}0+0{\\times}1+(-1){\\times}3$</span>\n    </div>\n  </section>\n\n  <div class=\"section-heading\">2. 比较：</div>\n\n  <section class=\"comparison\">\n    <div class=\"compare-label\">行列式：</div>\n    <div class=\"matrix-pair\">\n      <span>\n        $\\left|\\begin{matrix}\n        a_{11}&a_{12}\\\\\n        a_{21}&a_{22}\n        \\end{matrix}\\right|$\n      </span>\n      <span>……</span>\n      <span>\n        $\\left|\\begin{matrix}\n        b_{11}&b_{12}&b_{13}\\\\\n        b_{21}&b_{22}&b_{23}\\\\\n        b_{31}&b_{32}&b_{33}\n        \\end{matrix}\\right|$\n      </span>\n    </div>\n    <div class=\"definition\">有定义</div>\n    <div class=\"triangle-note\">△ 只有当第一个矩阵<br>的列数等于第二个<br>矩阵的行数时，<br>两个矩阵乘积才有定义</div>\n\n    <div class=\"compare-label\">矩阵：</div>\n    <div class=\"matrix-pair\">\n      <span>\n        $\\begin{pmatrix}\n        a_{11}&a_{12}\\\\\n        a_{21}&a_{22}\n        \\end{pmatrix}$\n      </span>\n      <span>\n        $\\begin{pmatrix}\n        b_{11}&b_{12}&b_{13}\\\\\n        b_{21}&b_{22}&b_{23}\\\\\n        b_{31}&b_{32}&b_{33}\n        \\end{pmatrix}$\n      </span>\n    </div>\n    <div class=\"definition\">无意义</div>\n    <div></div>\n  </section>\n\n  <section class=\"rule\">\n    <div class=\"rule-main\">\n      <span>相乘结果矩阵形状：</span>\n      <span>结果矩阵行数 = 第一个矩阵的行数</span>\n    </div>\n    <div class=\"rule-right\">列数 = 第二个矩阵的列数</div>\n    <div class=\"mnemonic\">（中间相等，取两头：$A_{m\\times n}\\cdot B_{n\\times s}=C_{m\\times s}$）</div>\n  </section>\n\n  <div class=\"small-example\">\n    <span>例：</span>\n    <span>$(1\\quad 2\\quad 3)$</span>\n    <span>$\\begin{pmatrix}3\\\\2\\\\1\\end{pmatrix}$</span>\n    <span>$=(10)$</span>\n  </div>\n\n  <section class=\"worked\">\n    <div class=\"worked-line\">\n      <span>\n        $\\begin{pmatrix}\n        -2&4\\\\\n        1&-2\n        \\end{pmatrix}$\n      </span>\n      <span class=\"size\">$2{\\times}2$</span>\n      <span>\n        $\\begin{pmatrix}\n        -3&4\\\\\n        -3&-6\n        \\end{pmatrix}$\n      </span>\n      <span class=\"size\">$2{\\times}2$</span>\n      <span>=</span>\n      <span>\n        $\\begin{pmatrix}\n        -6&-32\\\\\n        3&16\n        \\end{pmatrix}$\n      </span>\n      <span class=\"size\">$2{\\times}2$</span>\n      <span class=\"side-note\">$AB\\ne BA$</span>\n    </div>\n\n    <div class=\"worked-line\">\n      <span>\n        $\\begin{pmatrix}\n        -2&4\\\\\n        1&-2\n        \\end{pmatrix}$\n      </span>\n      <span class=\"size\">$2{\\times}2$</span>\n      <span>\n        $\\begin{pmatrix}\n        -2&4\\\\\n        -1&2\n        \\end{pmatrix}$\n      </span>\n      <span class=\"size\">$2{\\times}2$</span>\n      <span>=</span>\n      <span>\n        $\\begin{pmatrix}\n        0&0\\\\\n        0&0\n        \\end{pmatrix}$\n      </span>\n      <span class=\"size\">$2{\\times}2$</span>\n    </div>\n  </section>\n\n  <section class=\"observations\">\n    <div class=\"observation\">\n      <span 