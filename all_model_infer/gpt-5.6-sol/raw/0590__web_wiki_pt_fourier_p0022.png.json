$</th>\n          <th class=\"column-head\">$F(\\omega)$</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr class=\"h51\">\n          <td>$\\delta(t)$</td>\n          <td>$1$</td>\n        </tr>\n        <tr class=\"h51\">\n          <td>$\\delta(t-a)$</td>\n          <td>$e^{-ia\\omega}$</td>\n        </tr>\n        <tr class=\"h71\">\n          <td>$u(t)$</td>\n          <td>$\\pi\\delta(\\omega)+\\dfrac{1}{i\\omega}$</td>\n        </tr>\n        <tr class=\"h50\">\n          <td>$1$</td>\n          <td>$2\\pi\\delta(\\omega)$</td>\n        </tr>\n        <tr class=\"h71\">\n          <td>$\\operatorname{sgn}(t)$</td>\n          <td>$\\dfrac{2}{i\\omega}$</td>\n        </tr>\n        <tr class=\"h51\">\n          <td>$e^{i\\omega_0t}$</td>\n          <td>$2\\pi\\delta(\\omega-\\omega_0)$</td>\n        </tr>\n        <tr class=\"h51\">\n          <td>$\\cos\\omega_0t$</td>\n          <td>$\\pi\\bigl(\\delta(\\omega-\\omega_0)+\\delta(\\omega+\\omega_0)\\bigr)$</td>\n        </tr>\n        <tr class=\"h64\">\n          <td>$\\operatorname{sen}\\omega_0t$</td>\n          <td>$\\dfrac{\\pi}{i}\\bigl(\\delta(\\omega-\\omega_0)-\\delta(\\omega+\\omega_0)\\bigr)$</td>\n        </tr>\n        <tr class=\"h81\">\n          <td>$\\operatorname{rect}\\!\\left(\\dfrac{t}{a}\\right)$</td>\n          <td>$|a|\\cdot\\operatorname{sinc}\\!\\left(a\\,\\dfrac{\\omega}{2\\pi}\\right)=\\dfrac{2}{\\omega}\\operatorname{sen}\\!\\left(\\dfrac{\\omega}{a}\\right)$</td>\n        </tr>\n        <tr class=\"h83\">\n          <td>$\\cos(\\omega_0t)u(t)$</td>\n          <td>$\\dfrac{\\pi}{2}\\bigl(\\delta(\\omega-\\omega_0)+\\delta(\\omega+\\omega_0)\\bigr)+\\dfrac{i\\omega}{\\omega_0^2-\\omega^2}$</td>\n        </tr>\n        <tr class=\"h87\">\n          <td>$\\operatorname{sen}(\\omega_0t)u(t)$</td>\n          <td>$\\dfrac{\\pi}{2i}\\bigl(\\delta(\\omega-\\omega_0)-\\delta(\\omega+\\omega_0)\\bigr)+\\dfrac{\\omega^2}{\\omega_0^2-\\omega^2}$</td>\n        </tr>\n        <tr class=\"h84\">\n          <td>$\\operatorname{rect}(t/a)\\cos(\\omega_0t)$</td>\n          <td>$a\\left(\\operatorname{sinc}\\dfrac{(\\omega-\\omega_0)a}{2\\pi}+\\operatorname{sinc}\\dfrac{(\\omega+\\omega_0)a}{2\\pi}\\right)$</td>\n        </tr>\n        <tr class=\"h80\">\n          <td>$\\operatorname{sinc}\\!\\left(\\dfrac{t}{a}\\right)$</td>\n          <td>$|a|\\cdot\\operatorname{rect}\\!\\left(\\dfrac{\\omega}{2\\pi a}\\right)$</td>\n        </tr>\n        <tr class=\"h80\">\n          <td>$\\operatorname{sinc}^{2}\\!\\left(\\dfrac{t}{a}\\right)$</td>\n          <td>$|a|\\cdot\\operatorname{tri}\\!\\left(\\dfrac{\\omega}{2\\pi a}\\right)$</td>\n        </tr>\n        <tr class=\"h72\">\n          <td>$e^{-at}u(t),\\operatorname{Re}(a)>0$</td>\n          <td>$\\dfrac{1}{a+i\\omega}$</td>\n        </tr>\n        <tr class=\"h51\">\n          <td>$t^n$</td>\n          <td>$2\\pi i^n\\delta^n(\\omega)$</td>\n        </tr>\n        <tr class=\"h85\">\n          <td>$t^{n-1}e^{-at}u(t),\\operatorname{Re}(a)>0$</td>\n          <td>$\\dfrac{(n-1)!}{(a+i\\omega)^n}$</td>\n        </tr>\n        <tr class=\"h76\">\n          <td>$e^{-a|t|},\\operatorname{Re}(a)>0$</td>\n          <td>$\\dfrac{2a}{a^2+\\omega^2}$</td>\n        </tr>\n        <tr class=\"h61\">\n          <td>$e^{-\\pi t^2}$</td>\n          <td>$e^{-\\frac{\\omega^2}{4\\pi}}$</td>\n        </tr>\n        <tr class=\"h95\">\n          <td>$\\dfrac{1}{\\sqrt{|t|}}$</td>\n          <td>$\\sqrt{\\dfrac{2\\pi}{|\\omega|}}$</td>\n        </tr>\n        <tr class=\"h76\">\n          <td>$\\dfrac{1}{t^2+a^2}$</td>\n          <td>$\\dfrac{\\pi}{a}e^{-a|\\omega|}$</td>\n        </tr>\n        <tr class=\"h69\">\n          <td>$\\operatorname{tri}(t)$</td>\n          <td>$\\operatorname{sinc}^{2}\\!\\left(\\dfrac{\\omega}{2\\pi}\\right)$</td>\n        </tr>\n      </tbody>\n    </table>\n\n    <section class=\"operations\">\n      <h1>Transformadas operacionais</h1>\n      <div class=\"secondary-rule\"></div>\n      <