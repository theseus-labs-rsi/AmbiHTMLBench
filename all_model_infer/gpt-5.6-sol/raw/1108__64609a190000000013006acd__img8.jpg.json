        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>蒸馏操作与质量守恒定律验证</title>\n  <script>\n    window.MathJax = {\n      tex: { inlineMath: [['$', '$'], ['\\\\(', '\\\\)']], displayMath: [['$$', '$$'], ['\\\\[', '\\\\]']] },\n      svg: { fontCache: 'global' }\n    };\n  </script>\n  <script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      background: #fff;\n      color: #3d3d3d;\n      font-family: \"SimSun\", \"Songti SC\", serif;\n      font-size: 15px;\n      line-height: 1.72;\n    }\n    .page {\n      width: 540px;\n      min-height: 720px;\n      margin: 0 auto;\n      padding: 24px 38px 10px;\n      position: relative;\n    }\n    h2 {\n      width: max-content;\n      margin: 0 auto 9px;\n      padding: 1px 7px 2px;\n      background: #14a9d5;\n      color: #fff;\n      font-size: 18px;\n      font-weight: bold;\n      line-height: 1.35;\n      letter-spacing: 0;\n    }\n    .apparatus {\n      height: 96px;\n      margin: 0 auto 5px;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n    }\n    .apparatus .placeholder {\n      width: 365px;\n      height: 96px;\n      border: 0;\n      color: #555;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      font-size: 11px;\n      text-align: center;\n      background:\n        linear-gradient(90deg, transparent 0 4%, #555 4.2% 4.7%, transparent 4.9% 25%,\n        #666 25.2% 25.7%, transparent 26% 48%, #555 48.2% 48.7%,\n        transparent 49% 68%, #666 68.2% 68.7%, transparent 69%);\n      opacity: .8;\n    }\n    .apparatus .placeholder span {\n      background: rgba(255,255,255,.72);\n      padding: 1px 4px;\n    }\n    .notes {\n      margin: 0;\n      padding-left: 0;\n      list-style: none;\n    }\n    