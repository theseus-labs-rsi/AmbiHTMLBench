        "content": "<!DOCTYPE html><html lang='en'><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width, initial-scale=1.0'><title>CUDA C++ Programming Guide, Release 13.3</title><script>window.MathJax={tex:{inlineMath:[['$','$']],displayMath:[['$$','$$']]}};</script><script async src='https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js'></script><style>*{box-sizing:border-box}html,body{margin:0;padding:0;background:#fff;color:#111}body{font-family:Arial,Helvetica,sans-serif;overflow-x:auto}.page{position:relative;width:1170px;min-height:1900px;margin:0 auto;padding-top:84px}.header{height:36px;border-bottom:1px solid #222;font-size:25px;font-weight:700;line-height:30px;padding-bottom:5px}.continuation,.next-page{text-align:right;font-size:20px;line-height:24px}.continuation{margin-top:65px;margin-bottom:4px}.wide{width:1184px;margin-left:-8px}.code-block{background:#f2f2f2;font-family:'Courier New',Courier,monospace;font-size:22px;letter-spacing:0;overflow:hidden}.code-line{height:27px;line-height:27px;white-space:pre}.top-code{height:453px;padding-top:31px}.top-code .indented{margin-left:62px}.top-code .flush{margin-left:8px}.top-code .gap-short{margin-top:28px}.top-code .gap-long{margin-top:82px}.comment{color:#37879a;font-style:italic}.keyword{color:#087c25;font-weight:700}.literal{color:#087c45}.function{color:#003b98}.type-keyword{color:#982300;font-weight:700}.wrap-arrow{color:#d22}.section-title{margin:64px 0 0 0;color:#63b600;font-size:24px;font-weight:700;line-height:30px}.description{margin:38px 0 0 0;font-size:25px;line-height:30px;font-weight:400}.description code{font-family:'Courier New',Courier,monospace;font-size:23px}.lower-code{height:756px;margin-top:16px;padding:5px 0 0 8px}.lower-code .code-line{height:27px;line-height:27px}.lower-code .blank{height:27px}.lower-code .wrapped{margin-left:8px}.next-page{margin-top:-5px}.footer{margin-top:45px;border-top:1px solid #222;padding-top:5px;display:flex;justify-content:space-between;align-items:flex-start;font-size:25px;font-weight:700;line-height:30px}.footer-section{display:flex;gap:14px}@media(max-width:1210px){.page{margin-left:20px;margin-right:20px}}</style></head><body><main class='page'><header class='header'>CUDA C++ Programming Guide, Release 13.3</header><div class='continuation'>(continued from previous page)</div><section class='code-block top-code wide' aria-label='Continued CUDA code sample'><div class='code-line indented'>desc.offset = offset;</div><div class='code-line indented gap-short'>desc.size = size;</div><div class='code-line indented gap-long'>cudaExternalMemoryGetMappedBuffer(&amp;ptr, extMem, &amp;desc);</div><div class='code-line indented gap-long'><span class='comment'>// Note: ‘ptr’ must eventually be freed using cudaFree()</span></div><div class='code-line indented gap-short'><span class='keyword'>return</span> ptr;</div><div class='code-line flush gap-short'>}</div></section><h1 class='section-title'>6.2.16.1.4 Mapping Mipmapped Arrays onto Imported Memory Objects</h1><p class='description'>A CUDA mipmapped array can be mapped onto an imported memory object as shown below.&nbsp; The<br>offset, dimensions, format and number of mip levels must match that specified when creating the<br>mapping using the corresponding Vulkan API. Additionally, if the mipmapped array is bound as a color<br>target in Vulkan, the <code>flagcudaArrayColorAttachment</code> must be set. All mapped mipmapped arrays<br>must be freed using <code>cudaFreeMipmappedArray()</code>. The following code sample shows how to convert<br>Vulkan parameters into the corresponding CUDA parameters when mapping mipmapped arrays onto<br>imported memory objects.</p><section class='code-block lower-code wide' aria-label='CUDA mipmapped array code sample'><div class='code-line'>cudaMipmappedArray_t <span class='function'>mapMipmappedArrayOntoExternalMemory</span>(cudaExternalMemory_t extMem,</div><div class='code-line wrapped'><span class='wrap-arrow'>↪</span><span class='type-keyword'>unsigned long long</span> offset, cudaChannelFormatDesc *formatDesc, cudaExtent *extent,</div><div class='code-line wrapped'><span class='wrap-arrow'>↪</span><span class='type-keyword'>unsigned int</span> flags, <span class='type-keyword'>unsigned int</span> numLevels) {</div><div class='code-line'>    cudaMipmappedArray_t mipmap = <span class='literal'>NULL</span>;</div><div class='code-line'>    cudaExternalMemoryMipmappedArrayDesc desc = {};</div><div class='blank'></div><div class='code-line'>    memset(&amp;desc, <span class='literal'>0</span>, <span class='keyword'>sizeof</span>(desc));</div><div class='blank'></div><div class='code-line'>    desc.offset = offset;</div><div class='code-line'>    desc.formatDesc = *formatDesc;</div><div class='code-line'>    desc.extent = *extent;</div><div class='code-line'>    desc.flags = flags;</div><div class='code-line'>    desc.numLevels = numLevels;</div><div class='blank'></div><div class='code-line'>    <span class='comment'>// Note: ‘mipmap’ must eventually be freed using cudaFreeMipmappedArray()</span></div><div class='code-line'>    cudaExternalMemoryGetMappedMipmappedArray(&amp;mipmap, extMem, &amp;desc);</div><div class='blank'></div><div class='code-line'>    <span class='keyword'>return</span> mipmap;</div><div class='code-line'>}</div><div class='blank'></div><div class='code-line'>cudaChannelFormatDesc <span class='function'>getCudaChannelFormatDescForVulkanFormat</span>(VkFormat format)</div><div class='code-line'>{</div><div class='blank'></div><div class='code-line'>    cudaChannelFormatDesc d;</div><div class='blank'></div><div class='code-line'>    memset(&amp;d, <span class='literal'>0</span>, <span class='keyword'>sizeof</span>(d));</div><div class='blank'></div><div class='code-line'>    <span class='keyword'>switch</span> (format) {</div></section><div class='next-page'>(continues on next page)</div><footer class='footer'><div>112</div><div class='footer-section'