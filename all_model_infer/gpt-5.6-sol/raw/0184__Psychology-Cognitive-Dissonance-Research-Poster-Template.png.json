 }\n\n    .method .hand {\n      right: 25px;\n      bottom: 26px;\n      width: 73px;\n      height: 68px;\n    }\n\n    .hand .palm {\n      position: absolute;\n      right: 0;\n      bottom: 0;\n      width: 54px;\n      height: 22px;\n      background: #1fc1f2;\n      clip-path: polygon(0 18%, 32% 18%, 55% 0, 100% 18%, 88% 67%, 53% 100%, 13% 63%);\n    }\n\n    .hand .coin {\n      position: absolute;\n      left: 19px;\n      top: 1px;\n      width: 26px;\n      height: 26px;\n      border: 5px solid #1fc1f2;\n      border-radius: 50%;\n    }\n\n    .hand .finger {\n      position: absolute;\n      left: 3px;\n      bottom: 20px;\n      width: 49px;\n      height: 7px;\n      background: #1fc1f2;\n      transform: rotate(28deg);\n      transform-origin: right center;\n    }\n\n    .results p {\n      width: 129px;\n    }\n\n    .results .arrow {\n      right: 35px;\n      top: 57px;\n      width: 61px;\n      height: 58px;\n    }\n\n    .arrow-shaft {\n      position: absolute;\n      left: 27px;\n      top: 11px;\n      width: 6px;\n      height: 47px;\n      background: #1fc1f2;\n    }\n\n    .arrow-head {\n      position: absolute;\n      left: 9px;\n      top: 2px;\n      width: 39px;\n      height: 39px;\n      border-left: 6px solid #1fc1f2;\n      border-top: 6px solid #1fc1f2;\n      transform: rotate(45deg);\n    }\n\n    .results .star {\n      right: 19px;\n      bottom: 33px;\n      width: 92px;\n      height: 87px;\n      background: #1fc1f2;\n      clip-path: polygon(50% 0, 62% 32%, 98% 35%, 70% 57%, 79% 100%, 50% 78%, 19% 100%, 28% 58%, 0 36%, 38% 32%);\n    }\n\n    .results .star::after {\n      content: \"+\";\n      position: absolute;\n      left: 29px;\n      top: 22px;\n      color: #123d75;\n      font-size: 54px;\n      line-height: 1;\n      font-weight: 700;\n    }\n\n    .conclusion p {\n      width: 135px;\n    }\n\n    .conclusion .payment {\n      top: 55px;\n      right: 25px;\n      width: 79px;\n      height: 78px;\n    }\n\n    .payment .arm {\n      position: absolute;\n      right: 2px;\n      top: 3px;\n      width: 59px;\n      height: 38px;\n      background: #ffffff;\n      border-radius: 4px 15px 13px 15px;\n      clip-path: polygon(25% 0, 70% 0, 100% 40%, 95% 80%, 77% 88%, 61% 74%, 49% 90%, 35% 78%, 23% 91%, 8% 73%, 0 46%);\n    }\n\n    .payment .coin {\n      position: absolute;\n      left: 22px;\n      top: 34px;\n      width: 17px;\n      height: 17px;\n      border-radius: 50%;\n      background: #ffffff;\n    }\n\n    .payment .small-hand {\n      position: absolute;\n      left: 7px;\n      bottom: 0;\n      width: 40px;\n      height: 20px;\n      background: #ffffff;\n      clip-path: polygon(0 75%, 27% 55%, 36% 5%, 56% 0, 70% 54%, 100% 77%, 92% 100%, 0 100%);\n    }\n\n    .conclusion .profile-gear {\n      right: 26px;\n      bottom: 30px;\n      width: 76px;\n      height: 84px;\n    }\n\n    .profile-gear .profile {\n      position: absolute;\n      right: 4px;\n      bottom: 0;\n      width: 54px;\n      height: 70px;\n      background: #ffffff;\n      border-radius: 35px 28px 0 0;\n    }\n\n    .profile-gear .profile::before {\n      content: \"\";\n      position: absolute;\n      left: -13px;\n      top: 20px;\n      width: 23px;\n      height: 32px;\n      background: #ffffff;\n      clip-path: polygon(100% 0, 100% 100%, 0 83%, 38% 56%, 4% 38%, 46% 0);\n    }\n\n    .profile-gear .gear-mark {\n      position: absolute;\n      z-index: 2;\n      left: 15px;\n      top: 20px;\n      color: #182455;\n      font-size: 42px;\n      line-height: 1;\n    }\n\n    @media (max-width: 1056px) {\n      .document {\n        transform-origin: top left;\n        transform: scale(calc(100vw / 1056));\n        margin: 0;\n      }\n\n      body {\n        height: calc(816px * (100vw / 1056));\n        overflow: hidden;\n      }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"document\">\n    <section class=\"intro\">\n      <p class=\"organization\">\n        The National Centre<br>\n        for Neurology and Brain<br>\n        Mechanics Presents\n      </p>\n\n      <h1>\n        Cognitive<br>\n        Dissonance:<br>\n        Performing<br>\n        Menial Tasks\n      </h1>\n\n      <p class=\"authors\">\n        Study conducted by Jonas Festinger,<br>\n        Marcus Carlsmith &amp; Gabriel Chessman\n      </p>\n\n      <div class=\"intro-icons\" aria-label=\"Three profile-head illustrations containing a gear, exclamation mark, and question mark\">\n        <div class=\"head-icon\">\n          <span class=\"profile\"></span>\n          <span class=\"symbol\">⚙</span>\n        </div>\n        <div class=\"head-icon exclamation\">\n          <span class=\"profile\"></span>\n          <span class=\"symbol\">!</span>\n        </div>\n        <div class=\"head-icon question\">\n          <span class=\"profile\"></span>\n          <span class=\"symbol\">?</span>\n        </div>\n      </div>\n\n      <div class=\"intro-rule\"></div>\n\n      <div class=\"references\">\n        <span class=\"label\">REFERENCES:</span>\n        Walsh, Karen., Kemputo, Odelle., “The psychology of self-deception”<br>\n        The Atlantic Journal, 2017 • Satuda, Evelyn., Temitope, Anya., “Neuroscience<br>\n        of Decision-Making” The Science Review, 2018 • Brahms, Hansen., Leigh,<br>\n        Anderson., “The Need and Neurology for Happiness”, The Arch Journal, 2020\n      </div>\n    </section>\n\n    <div class=\"divider\"></div>\n\n    <section class=\"panels\">\n      <article class=\"panel purpose\">\n        <h2>Purpose:</h2>\n        <p>\n          Festinger, Carlsmith and<br>\n          Chessman wanted to<br>\n          understand if making<br>\n          people perform a menial<br>\n          task would result in<br>\n          cognitive dissonance as<br>\n          a result of forced<br>\n          compliance behavior.\n        </p>\n\n        <div class=\"placeholder gears\" aria-label=\"Three blue gears\">\n          <span class=\"gear gear-large\"></span>\n          <span class=\"gear gear-small one\"></span>\n          <span class=\"gear gear-small two\"></span>\n        </div>\n\n        <div class=\"placeholder people\" aria-label=\"Blue group-of-people icon\">\n          <span class=\"person left\"></span>\n          <span class=\"person center\"></span>\n          <span class=\"person right\"></span>\n        </div>\n      </article>\n\n      <article class=\"panel hypothesis\">\n        <h2>Hypothesis:</h2>\n        <p>\n          When asked to do an<br>\n          unenjoyable task, people<br>\n          will not readily admit as<br>\n          much, and tell themselves<br>\n          and others it is actually<br>\n          enjoyable.\n        </p>\n\n        <div class=\"placeholder thumb\" aria-label=\"White thumbs-up icon\"></div>\n\n        <div class=\"placeholder scales\" aria-label=\"White balance scales icon\">\n          <span class=\"scale-post\"></span>\n          <span class=\"scale-base\"></span>\n          <span class=\"scale-beam\"></span>\n          <span class=\"scale-pan left\"></span>\n          <span class=\"scale-pan right\"></span>\n        </div>\n      </article>\n\n      <article class=\"panel participants\">\n        <h2>Participants:</h2>\n        <p>\n          In a lab setting, 71 male<br>\n          students as participants<br>\n          to perform a series of<br>\n          menial tasks (like turning<br>\n          pegs in a peg board for<br>\n          an hour).\n        </p>\n\n        <div class=\"placeholder clock\" aria-label=\"White clock icon\">\n          <span class=\"clock-dot\"></span>\n        </div>\n\n        <div class=\"placeholder board\" aria-label=\"White peg-board icon\">\n          <span class=\"board-node a\"></span>\n          <span class=\"board-node b\"></span>\n          <span class=\"board-node c\"></span>\n          <span class=\"board-node d\"></span>\n          <span class=\"board-line one\"></span>\n          <span class=\"board-line two\"></span>\n          <span class=\"board-line three\"></span>\n        </div>\n      </article>\n\n      <article class=\"panel method\">\n        <h2>Method:</h2>\n        <p>\n          The participants were<br>\n          then paid either $1 or $20<br>\n          to tell a waiting participant<br>\n          (a test confederate) that<br>\n          the tasks were really<br>\n          engaging and fun. Almost<br>\n          all of the participants<br>\n          agreed to walk into the<br>\n          waiting room and<br>\n          persuade the confederate<br>\n          that the boring experiment<br>\n          would be interesting.\n        </p>\n\n        <div class=\"placeholder balloon\" aria-label=\"Blue speech balloon icon\"></div>\n\n        <div class=\"placeholder hand\" aria-label=\"Blue hand holding a coin icon\">\n          <span class=\"coin\"></span>\n          <span class=\"finger\"></span>\n          <span class=\"palm\"></span>\n        </div>\n      </article>\n\n      <article class=\"panel results\">\n        <h2>Results:</h2>\n        <p>\n          When the participants<br>\n          were asked to evaluate<br>\n          the experiment, the<br>\n          participants who were<br>\n          paid only $1 rated the<br>\n          tedious task as more<br>\n          fun and enjoyable than<br>\n          the participants who<br>\n          were paid $20 to lie.\n        </p>\n\n        <div class=\"placeholder arrow\" aria-label=\"Blue upward arrow icon\">\n          <span class=\"arrow-head\"></span>\n          <span class=\"arrow-shaft\"></span>\n        </div>\n\n        <div class=\"placeholder star\" aria-label=\"Blue star containing a plus sign\"></div>\n      </article>\n\n      <article class=\"panel conclusion\">\n        <h2>Conclusion:</h2>\n        <p>\n          Getting paid $1 is not<br>\n          sufficient for lying, so<br>\n          those who were paid $1<br>\n          experienced dissonance.<br>\n          These participants could<br>\n          only overcome that<br>\n          dissonance by coming<br>\n          to believe that the tasks<br>\n          really were interesting<br>\n          and enjoyable.<br><br>\n          Being paid $20 provides<br>\n          a reason, therefore there<br>\n          is no dissonance.\n        </p>\n\n        <div class=\"placeholder payment\" aria-label=\"White hand passing a coin icon\">\n          <span class=\"arm\"></span>\n          <span class=\"coin\"></span>\n          <span class=\"small-hand\"></span>\n        </div>\n\n        <div class=\"placeholder profile-gear\" aria-label=\"White profile-head icon containing a gear\">\n          <span class=\"profile\"></span>\n          <span class=\"gear-mark\">⚙</span>\n        </div>\n      </article>\n    </section>\n  </main>\n</body>\n</html>"
