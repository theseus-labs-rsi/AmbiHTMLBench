47px;\n    line-height: 46px;\n    font-weight: 700;\n  }\n\n  .department {\n    margin-top: 35px;\n    font-size: 17px;\n    line-height: 1.2;\n  }\n\n  .voucher-center-title {\n    text-align: center;\n    padding-top: 5px;\n  }\n\n  .voucher-center-title h1 {\n    margin: 0;\n    font-size: 40px;\n    line-height: 1.05;\n  }\n\n  .no-staple {\n    margin-top: 35px;\n    font-size: 21px;\n    line-height: 1.15;\n    font-weight: 700;\n  }\n\n  .voucher-year {\n    border-left: 2px solid #000;\n    text-align: center;\n  }\n\n  .omb {\n    height: 34px;\n    border-bottom: 2px solid #000;\n    padding-top: 2px;\n    font-size: 18px;\n    line-height: 29px;\n  }\n\n  .year {\n    padding-top: 20px;\n    font-size: 54px;\n    line-height: 1;\n    font-weight: 700;\n    letter-spacing: 1px;\n  }\n\n  .year-outline {\n    color: #fff;\n    -webkit-text-stroke: 1.5px #000;\n    font-weight: 400;\n  }\n\n  .voucher-body {\n    position: relative;\n    height: 302px;\n  }\n\n  .ein-box {\n    position: absolute;\n    left: 0;\n    top: 0;\n    width: 440px;\n    height: 101px;\n    border-top: 2px solid #000;\n    border-right: 2px solid #000;\n    border-bottom: 1px solid #000;\n    padding-top: 4px;\n    font-size: 18px;\n  }\n\n  .ein-dash {\n    text-align: center;\n    margin-top: 20px;\n    font-size: 24px;\n    font-weight: 700;\n  }\n\n  .gray-area {\n    position: absolute;\n    left: 0;\n    top: 101px;\n    width: 440px;\n    height: 201px;\n    background: #c8c8c8;\n    border-right: 2px solid #000;\n    border-bottom: 2px solid #000;\n  }\n\n  .payment-box {\n    position: absolute;\n    left: 440px;\n    top: 0;\n    width: 1062px;\n    height: 102px;\n    border: 5px solid #000;\n    display: grid;\n    grid-template-columns: 657px 282px 118px;\n  }\n\n  .payment-description {\n    position: relative;\n    padding: 4px 12px 0 48px;\n  }\n\n  .box-number {\n    position: absolute;\n    left: 26px;\n    top: 7px;\n    font-size: 18px;\n    font-weight: 700;\n  }\n\n  .amount-title {\n    font-size: 27px;\n    line-height: 1.1;\n    font-weight: 700;\n  }\n\n  .payable-line {\n    margin-top: 4px;\n    font-size: 17px;\n    line-height: 1.15;\n  }\n\n  .dollars,\n  .cents {\n    border-left: 2px solid #000;\n    text-align: center;\n    padding-top: 3px;\n    font-size: 17px;\n  }\n\n  .name-address {\n    position: absolute;\n    left: 440px;\n    top: 102px;\n    width: 1062px;\n    height: 200px;\n    border-bottom: 2px solid #000;\n    padding-left: 59px;\n    padding-top: 5px;\n    font-size: 18px;\n  }\n\n  .name-address .box-number {\n    left: 28px;\n    top: 5px;\n  }\n\n  .field {\n    height: 67px;\n    padding-top: 0;\n  }\n\n  .field + .field {\n    border-top: 1px solid #000;\n    padding-top: 6px;\n  }\n\n  .field:first-of-type {\n    margin-bottom: 0;\n  }\n\n  .bottom-page-space {\n    height: 100px;\n  }\n\n  em {\n    font-style: italic;\n  }\n\n  strong {\n    font-weight: 700;\n  }\n\n  @media (max-width: 1502px) {\n    .page {\n      transform-origin: top left;\n    }\n  }\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <div class=\"top-rule\"></div>\n\n  <header class=\"document-title\">\n    Form 945-V,<br>\n    Payment Voucher\n  </header>\n\n  <div class=\"header-rule\"></div>\n\n  <section class=\"instructions\">\n    <div class=\"column left-column\">\n      <h2>Purpose of Form</h2>\n      <p class=\"intro\">Complete Form 945-V if you’re paying your balance due on Form 945 by check or money order. We will use the completed voucher to credit your payment more promptly and accurately, and to improve our service to you.</p>\n\n      <h3>Making Payments With Form 945</h3>\n      <p class=\"lead\">To avoid a penalty, make your payment with your 2025 Form 945 <strong>only if:</strong></p>\n\n      <ul class=\"bullets\">\n        <li>Your total taxes for the year (Form 945, line 3) are less than $2,500 and you’re paying in full with a timely filed return, or</li>\n        <li>You’re a monthly schedule depositor making a payment in accordance with the Accuracy of Deposits Rule. See section 11 of Pub. 15 for details. In this case, the amount of your payment may be $2,500 or more.</li>\n      </ul>\n\n      <p class=\"indented-paragraph\">Otherwise, you must make deposits by electronic funds transfer (EFT). An EFT can be made using the Electronic Federal Tax Payment System (EFTPS), IRS Direct Pay, or your IRS business tax account. Don’t use Form 945-V to make federal tax deposits. You can also pay your balance due by EFT instead of sending Form 945-V. If you pay your balance due by EFT, file your return using the <em>Without a payment</em> address under <em>Where To File</em> in the Instructions for Form 945; don’t file Form 945-V. For more information about EFTPS or to enroll in EFTPS, go to <em>www.eftps.gov</em>. For more information about IRS Direct Pay, go to <em>www.irs.gov/DirectPay</em>. For more information about making an EFT through your IRS business tax account, go to <em>www.irs.gov/BusinessAccount</em>. See section 11 of Pub. 15 for deposit instructions.</p>\n\n      <div class=\"caution-row\">\n        <div class=\"caution-symbol\" aria-label=\"Caution\">\n          <div class=\"triangle\"></div>\n          <div class=\"exclamation\">!</div>\n          <div class=\"caution-label\">CAUTION</div>\n        </div>\n        <div class=\"caution-text\">\n          Use Form 945-V if you’re paying your balance due on Form 945 by check or money order. However, if you pay an amount with Form 945 that should’ve been deposited, you may be subject to a penalty. See Deposit Penalties in section 11 of Pub. 15.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"column right-column\">\n      <h2>Specific Instructions</h2>\n\n      <p><strong>Box 1—Employer identification number (EIN).</strong> If you don’t have an EIN, you may apply for one online by going to <em>www.irs.gov/EIN</em>. You may also apply for an EIN by faxing or mailing Form SS-4 to the IRS. If you haven’t received your EIN by the due date of Form 945, write “Applied For” and the date you applied in this entry space.</p>\n\n      <p><strong>Box 2—Amount paid.</strong> Enter the amount paid with Form 945.</p>\n\n      <p><strong>Box 3—Name and address.</strong> Enter your name and address as shown on Form 945.</p>\n\n      <p class=\"bullet-paragraph\">Enclose your check or money order made payable to “United States Treasury.” Be sure to enter your EIN, “Form 945,” and “2025” on your check or money order. Don’t send cash. Don’t staple Form 945-V or your payment to the return (or to each other).</p>\n\n      <p class=\"bullet-paragraph\">Detach Form 945-V and send it with your payment and Form 945 to the address provided in the Instructions for Form 945.</p>\n\n      <p><strong>Note:</strong> You must also complete the entity information above line A on Form 945.</p>\n    </div>\n  </section>\n\n  <section class=\"detach-section\">\n    <div class=\"detach-heading\">Detach Here and Mail With Your Payment and Form 945.</div>\n    <div class=\"detach-rule\"></div>\n\n    <div class=\"voucher\">\n      <div class=\"voucher-top\">\n        <div class=\"voucher-identification\">\n          <div class=\"form-number-line\">\n            <span class=\"form-small\">Form</span>\n            <span class=\"form-number\">945-V</span>\n          </div>\n          <div class=\"department\">\n            Department of the Treasury<br>\n            Internal Revenue Service\n          </div>\n        </div>\n\n        <div class=\"voucher-center-title\">\n          <h1>Payment Voucher</h1>\n          <div class=\"no-staple\">Don’t staple this voucher or your payment to Form 945.</div>\n        </div>\n\n        <div class=\"voucher-year\">\n          <div class=\"omb\">OMB No. 1545-0029</div>\n          <div class=\"year\"><span class=\"year-outline\">20</span>25</div>\n        </div>\n      </div>\n\n      <div class=\"voucher-body\">\n        <div class=\"ein-box\">\n          <strong>1</strong> Enter your employer identification number (EIN).\n          <div class=\"ein-dash\">-</div>\n        </div>\n\n        <div class=\"gray-area\"></div>\n\n        <div class=\"payment-box\">\n          <div class=\"payment-description\">\n            <span class=\"box-number\">2</span>\n            <div class=\"amount-title\">Enter the amount of your payment.</div>\n            <div class=\"payable-line\">Make your check or money order payable to <strong>“United States Treasury.”</strong></div>\n          </div>\n          <div class=\"dollars\">Dollars</div>\n          <div class=\"cents\">Cents</div>\n        </div>\n\n        <div class=\"name-address\">\n          <span class=\"box-number\">3</span>\n          <div class=\"field\">Enter your business name (individual name if sole proprietor).</div>\n          <div class=\"field\">Enter your address.</div>\n          <div class=\"field\">Enter your city or town, state or province, country, and ZIP or foreign postal code.</div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"bottom-page-space\"></div>\n</main>\n</body>\n</html>"
