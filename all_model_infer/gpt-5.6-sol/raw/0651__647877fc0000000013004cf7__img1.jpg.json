ary {\n    border-top: 1px solid #555;\n  }\n\n  .vocabulary h2 {\n    height: 20px;\n    margin: 0;\n    padding: 0 2px;\n    color: #e5222a;\n    font-family: \"SimSun\", \"Songti SC\", serif;\n    font-size: 14px;\n    font-weight: bold;\n    line-height: 19px;\n  }\n\n  .vocab-body {\n    padding: 0 2px 1px 2px;\n    font-size: 14px;\n    line-height: 19.5px;\n    white-space: nowrap;\n  }\n\n  .vline {\n    height: 19.5px;\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n  }\n\n  .vline.left {\n    justify-content: flex-start;\n  }\n\n  .gap-sm {\n    margin-left: 19px;\n  }\n\n  .gap-md {\n    margin-left: 29px;\n  }\n\n  .gap-lg {\n    margin-left: 38px;\n  }\n</style>\n</head>\n<body>\n<div class=\"document\">\n  <table class=\"main-table\">\n    <colgroup>\n      <col class=\"left\">\n      <col class=\"right\">\n    </colgroup>\n    <thead>\n      <tr>\n        <th class=\"title\" colspan=\"2\">环境类万能思路</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        <th class=\"section\" colspan=\"2\">常见环境问题</th>\n      </tr>\n      <tr class=\"problem-row\">\n        <td>气候变化，全球变暖</td>\n        <td>Climate change, global warming</td>\n      </tr>\n      <tr class=\"problem-row\">\n        <td>空气污染、垃圾增多</td>\n        <td>Air pollution, increase of rubbish/garbage</td>\n      </tr>\n      <tr class=\"problem-row\">\n        <td>能源危机，水资源匮乏，森林减少</td>\n        <td>Energy crisis, water shortage, deforestation</td>\n      </tr>\n      <tr class=\"problem-row\">\n        <td>自然灾害、酸雨、沙尘暴、干旱、水灾</td>\n        <td>Natural disasters, acid rain, sand storms,<br>drought, flood</td>\n      </tr>\n\n      <tr>\n        <th class=\"section\" colspan=\"2\">所有这些问题的根本原因</th>\n      </tr>\n      <tr class=\"cause-row\">\n        <td>人口增长，工业发展，长期的人类活动</td>\n        <td>Population growth, industrial development,<br>long-term human activities</td>\n      </tr>\n\n      <tr>\n        <th class=\"section\" colspan=\"2\">正确的解决方法</th>\n      </tr>\n      <tr class=\"solution-row\">\n        <td>世界方面：全球合作，达成共识，制定环<br>境保护的国际标准</td>\n        <td>Global cooperation, reach the agreement, set<br>international standards for environmental</td>\n      </tr>\n      <tr class=\"solution-row\">\n        <td>政府方面：制定环保政策，鼓励低碳经济</td>\n        <td>Make laws, encourage low carbon economy</td>\n      </tr>\n      <tr class=\"solution-row\">\n        <td>科技方面：大力开发可再生的、清洁的新<br>能源，投资研发节能科技</td>\n        <td>Exploit renewable, green energy, invest in<br>energy-saving technologies</td>\n      </tr>\n      <tr class=\"solution-row\">\n        <td>公司方面：推出环保产品，引领大众绿色<br>消费习惯</td>\n        <td>Promote environmental-friendly products, lead<br>green consuming habits</td>\n      </tr>\n      <tr class=\"solution-row last-solution\">\n        <td>个人方面：提升环保意识，倡导低碳生活<br>方式</td>\n        <td>raise public’s green awareness, encourage low<br>carbon lifestyle</td>\n      </tr>\n    </tbody>\n  </table>\n\n  <section class=\"vocabulary\">\n    <h2>核心词汇及短语:</h2>\n    <div class=\"vocab-body\">\n      <div class=\"vline\">\n        <span>low carbon 低碳</span>\n        <span>green adj. 环保的</span>\n        <span>environmental-friendly adj. 环保的</span>\n        <span>eco-</span>\n      </div>\n      <div class=\"vline\">\n        <span>friendly adj. 环保的</span>\n        <span>ecosystem n. 生态系统</span>\n        <span>environmental protection 环境保护</span>\n      </div>\n      <div class=\"vline\">\n        <span>preserve vt. 保护</span>\n        <span>sustainable development 可持续发展</span>\n        <span>deplete natural resources 耗</span>\n      </div>\n      <div class=\"vline\">\n        <span>尽自然资源</span>\n        <span>leave a carbon footprint 留下一个碳化足迹</span>\n        <span>discharge/release</span>\n      </div>\n      <div class=\"vline\">\n        <span>pollutants into the environment 向环境排放污染物</span>\n        <span>greenhouse effect 温室效应</span>\n      </div>\n      <div class=\"vline\">\n        <span>global warming 全球变暖</span>\n        <span>discharge v