,1fr);gap:9px}\n    .data-grid .newscol{font-size:8px;line-height:1.35}\n    .bridge{padding-top:10px}\n    .placeholder{border:1px solid #888;color:#555;display:flex;align-items:center;justify-content:center;text-align:center;font-size:10px}\n    .bridge-photo{height:181px;width:574px;background:linear-gradient(#a7d8e9 0 42%,#e9ccb5 43% 57%,#52b8d3 58% 100%);position:relative;overflow:hidden}\n    .bridge-photo:before{content:\"\";position:absolute;left:109px;right:31px;top:90px;height:5px;background:#aa3231;box-shadow:0 4px 0 #777;transform:skewY(-2deg)}\n    .bridge-photo:after{content:\"\";position:absolute;left:138px;top:23px;width:4px;height:105px;background:#555;box-shadow:3px 0 #c34637,351px -5px #555,354px -5px #c34637}\n    .caption{font-size:7px;margin:4px 5px;letter-spacing:.2px}\n    .right-top{height:709px;border-bottom:1px solid #555;position:relative}\n    .right .kicker{font-size:12px;margin-bottom:8px}\n    .policy{font-size:8px;line-height:1.43;text-align:justify;padding-right:3px}\n    .policy p{margin:0 0 6px;text-indent:2em}\n    .vertical-title{float:right;writing-mode:vertical-rl;font-family:\"Heiti SC\",\"Microsoft YaHei\",sans-serif;font-size:25px;line-height:1.05;letter-spacing:2px;margin:3px 1px 0 9px}\n    .right-body{padding-right:3px}\n    .side-story{padding:13px 0 9px;border-bottom:1px solid #777}\n    .side-story h3{font-family:\"Heiti SC\",\"Microsoft YaHei\",sans-serif;font-size:16px;letter-spacing:1px;margin:0 0 3px;text-align:center}\n    .side-story .dek{text-align:center;font-size:9px;margin-bottom:6px}\n    .side-story p{font-size:8px;line-height:1.43;text-align:justify;text-indent:2em;margin:0}\n    .small-label{font-size:8px;text-align:right;margin-top:4px}\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <header class=\"masthead\">\n      <div class=\"section\">要闻</div><div class=\"number\">2</div>\n      <div class=\"date\">2025年1月7日　星期二</div>\n      <div class=\"paper\">人民日报</div>\n    </header>\n\n    <div class=\"layout\">\n      <section class=\"left\">\n        <article class=\"hero\">\n          <div class=\"kicker\"><b>R</b>经济新方位·实体经济和数字经济深度融合</div>\n          <h1>一家工厂的数字化嬗变</h1>\n          <div class=\"byline\">本报记者　张翼　钟春</div>\n          <div class=\"hero-grid\">\n            <div class=\"newscol\">\n              <p class=\"lead\">2024年12月末年的中原起工博览会现场，一条条生产线、一道道工序，在数字技术的赋能下高效运转。</p>\n              <p>“订单接得越来越多，生产效率越来越高。”河南一家装备制造企业负责人说。通过设备联网、数据采集和智能调度，工厂生产经营情况一目了然。</p>\n              <p>企业负责人介绍，数字化改造使生产计划更加精准，原材料、能源消耗明显下降，产品质量稳定性不断提升。</p>\n              <p>数字化转型不是简单地“上设备”，而是对研发、生产、管理和服务全流程进行重塑。围绕关键环节，企业逐步打通数据链路。</p>\n              <p>[illegible]</p>\n            </div>\n            <div class=\"newscol\">\n              <p>物料的到货信息已经出现在系统的看板上。设备运行数据被实时采集，产品从下线到入库都有对应记录。</p>\n              <p>“以前靠经验安排生产，现在靠数据说话。”车间负责人说，系统根据市场需求和库存情况自动生成计划。</p>\n              <p>记者看到，生产线旁的屏幕上显示着订单、设备、质量、能耗等信息。出现异常后，工作人员可及时处置。</p>\n              <p>在数字技术支持下，工厂从单点应用向系统集成延伸，制造过程更加柔性、更加绿色。</p>\n              <p>[illegible]</p>\n            </div>\n            <div class=\"diagram\">\n              <div class=\"diag-title\">数字化转型政策<br>体系不断健全</div>\n              <div class=\"hex h1\">2024年出台多项支持制造业数字化转型的政策文件</div>\n              <div class=\"hex h2\"><strong>重点行业提质<br>步伐加快</strong><br>钢铁、能源、汽车、制造业等领域实现数字化升级</div>\n              <div class=\"hex h3\"><strong>数字基础设施<br>支撑有力</strong><br>截至2024年11月</div>\n              <div class=\"hex h4\"><strong>数字领域</strong><br>创新和应用持续拓展</div>\n              <div class=\"hex h5\"><strong>数据要素</strong><br>加快流通利用</div>\n            </div>\n          </div>\n        </article>\n\n        <article class=\"mid\">\n          <h2>近万家中小企业数字化改造</h2>\n          <div class=\"sub\">工业互联网实现工业大类全覆盖</div>\n          <div class=\"mid-grid\">\n            <div class=\"newscol\">\n              <p>促进实体经济和数字经济深度融合是发展新质生产力的重要抓手。2024年数字经济发展势头良好，工业互联网加快向重点行业和中小企业普及。</p>\n              <p>数据显示，工业互联网已经实现工业大类全覆盖，服务企业数量不断增加。</p>\n              <p>[illegible]</p>\n            </div>\n            <div class=\"newscol\">\n              <p>依托新一代信息技术构建起融合发展的制造体系，制造业数字化转型步伐加快。国家层面持续完善政策供给，推动企业“上云、用数、赋智”。</p>\n              <p>越来越多中小企业通过改造提升研发设计、生产制造和经营管理能力。</p>\n              <p>[illegible]</p>\n            </div>\n            <div class=\"newscol\">\n              <p>数字化转型不是孤立工程，而是贯穿供应链、产业链上下游的系统工程。围绕细分行业特点，各地探索形成了一批可复制、可推广的经验。</p>\n              <p>平台企业、服务商和金融机构共同参与，为中小企业提供低成本、轻量化解决方案。</p>\n              <p>[illegible]</p>\n            </div>\n            <div class=\"arm\" aria-label=\"工业机器人机械臂图\"></div>\n          </div>\n        </article>\n\n        <article class=\"data\">\n          <div class=\"smallhead\">《国家数据局：就促进数据资源开发利用公开征求意见》</div>\n          <h2>将建全国数据“一本账”</h2>\n          <div class=\"data-grid\">\n            <div class=\"newscol\"><p>本报北京1月6日电　记者从国家数据局获悉，相关文件正在公开征求意见。</p><p>[illegible]</p></div>\n            <div class=\"newscol\"><p>文件提出，推动数据资源开发利用，促进数据合规高效流通使用。</p><p>[illegible]</p></div>\n            <div class=\"newscol\"><p>建立数据资源登记制度，形成全国数据资源“一本账”。</p><p>[illegible]</p></div>\n            <div class=\"newscol\"><p>国家数据局将完善基础制度，激发数据要素活力。</p><p>[illegible]</p></div>\n          </div>\n        </article>\n\n        <figure class=\"bridge\">\n          <div class=\"bridge-photo placeholder\">[图片：海面上的跨海大桥]</div>\n          <figcaption class=\"caption\">1月5日，[illegible]大桥主塔施工现场。该大桥是重要交通基础设施项目。</figcaption>\n        </figure>\n      </section>\n\n      <aside class=\"right\">\n        <section class=\"right-top\">\n          <div class=\"kicker\"><b>R</b>政策解读·问答</div>\n          <div class=\"vertical-title\">商业保险年金如何挑选</div>\n          <div class=\"right-body policy\">\n            <p>随着社会保障体系不断完善，商业保险年金受到不少消费者关注。商业保险年金有哪些特点？如何选择适合自己的产品？</p>\n            <p>业内人士表示，消费者购买商业保险产品时，应当根据自身实际需求、收入情况和风险承受能力作出选择，仔细阅读合同条款。</p>\n            <p>商业保险年金通常具有长期性特点，投保人应充分了解缴费期限、领取方式、保险责任和退保损失等内容。</p>\n            <p>“购买年金保险并不意味着可以忽视保障需求。”专家表示，应优先配置基础保障，再结合家庭财务规划进行安排。</p>\n            <p>消费者在比较产品时，要关注保证领取、现金价值、费用扣除、红利分配等项目。对于销售人员的口头承诺，应以保险合同为准。</p>\n            <p>有养老需求的消费者还应关注领取年龄、领取期限和领取金额，避免因提前退保造成不必要损失。</p>\n            <p>监管部门提醒，保险消费者要通过正规渠道购买产品，如实告知健康状况和相关信息，保护自身合法权益。</p>\n            <p>[illegible]</p>\n            <p>[illegible]</p>\n            <p>[illegible]</p>\n          </div>\n        </section>\n\n        <section class=\"side-story\">\n          <h3>铜矿找矿取得重大突破</h3>\n          <div class=\"dek\">青藏高原新发现资源量2000余万吨</div>\n          <p>本报北京1月6日电　记者从有关部门获悉，我国地质找矿工作取得新进展，在青藏高原发现大型铜矿资源基地。</p>\n          <p>据了解，该矿区资源禀赋较好，找矿成果将为国家资源安全提供有力支撑。</p>\n        </section>\n\n        <section class=\"side-story\">\n          <h3>中老铁路货运量超5000万吨</h3>\n          <p>本报昆明1月6日电　中老铁路开通以来，货运量持续增长，跨境物流通道作用日益显现。</p>\n          <p>铁路部门不断优化运输组织，促进沿线产业发展和人员往来。</p>\n          <div class=\"small-label\">（本报记者　[illegible]）</div>\n        </section>\n      </aside>\n    </div>\n  </main>\n</body>\n</html>"
