        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>要闻 2 - 人民日报</title>\n  <script>\n    window.MathJax = { tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] } };\n  </script>\n  <script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    *{box-sizing:border-box}\n    body{margin:0;background:#f1f0ec;color:#191919;font-family:\"Songti SC\",\"SimSun\",\"STSong\",serif}\n    .page{width:800px;min-height:1131px;margin:0 auto;background:#fff;padding:8px 8px 12px}\n    .masthead{height:32px;border-bottom:2px solid #222;position:relative;display:flex;align-items:flex-start}\n    .section{font-family:\"Heiti SC\",\"Microsoft YaHei\",sans-serif;font-size:25px;letter-spacing:1px;line-height:28px}\n    .number{font-family:Arial,sans-serif;font-size:25px;margin-left:11px;line-height:28px}\n    .date{font-family:\"Microsoft YaHei\",sans-serif;font-size:8px;margin-left:17px;padding-top:12px}\n    .paper{margin-left:auto;font-size:22px;font-weight:bold;letter-spacing:4px;line-height:27px}\n    .layout{display:grid;grid-template-columns:576px 186px;gap:16px;margin-top:21px}\n    .left{min-width:0}\n    .right{border-left:1px solid #bcbcbc;padding-left:10px}\n    .kicker{color:#922827;font-family:\"Microsoft YaHei\",sans-serif;font-size:13px;font-weight:bold;letter-spacing:.4px}\n    .kicker b{display:inline-block;background:#9a2825;color:white;font-size:10px;padding:0 2px;margin-right:3px}\n    .hero{height:464px;border-bottom:1px solid #777;position:relative}\n    .hero h1{text-align:center;font-family:\"Heiti SC\",\"Microsoft YaHei\",sans-serif;font-size:34px;letter-spacing:3px;margin:11px 0 2px;line-height:1.2}\n    .byline{text-align:center;font-size:8px;margin-bottom:10px}\n    .hero-grid{display:grid;grid-template-columns:178px 174px 202px;gap:10px}\n    .newscol{font-size:8px;line-height:1.45;