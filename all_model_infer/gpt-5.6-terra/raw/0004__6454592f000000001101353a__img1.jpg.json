        "content": "<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>国际和区域性经济组织</title>\n  <script src=\"https://polyfill.io/v3/polyfill.min.js?features=es6\"></script>\n  <script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      background: #fff;\n      color: #444;\n      font-family: \"SimSun\", \"Songti SC\", serif;\n    }\n    .page {\n      width: 540px;\n      margin: 3px auto;\n      font-size: 9px;\n      line-height: 1.55;\n    }\n    table {\n      width: 532px;\n      height: 295px;\n      margin-left: 4px;\n      border-collapse: collapse;\n      table-layout: fixed;\n    }\n    td {\n      border: 1px solid #a8a8a8;\n      padding: 4px 5px;\n      vertical-align: middle;\n      overflow: hidden;\n    }\n    .c1 { width: 81px; text-align: center; }\n    .c2 { width: 89px; text-align: center; padding: 0; }\n    .c3 { width: 88px; text-align: center; }\n    .c4 { width: 95px; }\n    .c5 { width: 179px; }\n    .r1 { height: 58px; }\n    .r2 { height: 59px; }\n    .r3 { height: 59px; }\n    .r4 { height: 60px; }\n    .r5 { height: 59px; }\n\n    .placeholder {\n      position: relative;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      margin: auto;\n      overflow: hidden;\n      color: #fff;\n      font-family: Arial, sans-serif;\n      text-align: center;\n    }\n    .placeholder small {\n      position: relative;\n      z-index: 2;\n      font-size: 6px;\n      font-weight: normal;\n      line-height: 1.1;\n    }\n    .eu {\n      width: 73px;\n      height: 53px;\n      background: #073d8c;\n    }\n    .eu .stars {\n      position: absolute;\n      width: 33px;\n      height: 33px;\n      border: 2px dotted #ffd425;\n      border-radius: 50%;\n    }\n    .apec {\n     