        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>人民日报 要闻</title>\n  <script src=\"https://polyfill.io/v3/polyfill.min.js?features=es6\"></script>\n  <script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    *{box-sizing:border-box}\n    body{margin:0;background:#fff;color:#151515;font-family:\"Songti SC\",\"SimSun\",\"Noto Serif CJK SC\",serif}\n    .page{width:800px;height:1144px;margin:0 auto;padding:8px 10px 10px;overflow:hidden;background:#fff}\n    .masthead{height:32px;border-bottom:2px solid #333;display:flex;align-items:center;position:relative}\n    .section{font-family:\"Heiti SC\",\"Microsoft YaHei\",sans-serif;font-size:26px;letter-spacing:2px;margin-right:15px}\n    .num{font-family:Arial,sans-serif;font-size:24px;margin-right:15px}\n    .date{font-family:\"Microsoft YaHei\",sans-serif;font-size:8px;margin-top:2px}\n    .paper{position:absolute;right:0;top:0;font-size:22px;font-weight:bold;letter-spacing:3px}\n    .main-grid{display:grid;grid-template-columns:49% 22% 29%;gap:8px;padding-top:21px}\n    .lead-left{border-right:1px solid #888;padding-right:7px}\n    .lead-title{text-align:center;font-size:19px;line-height:1.2;font-weight:bold;margin:4px 0 7px}\n    .lead-sub{text-align:center;font-family:\"Heiti SC\",\"Microsoft YaHei\",sans-serif;font-size:24px;line-height:1.22;font-weight:bold;letter-spacing:-1px;margin:0 0 8px}\n    .columns{column-count:2;column-gap:11px;font-size:8px;line-height:1.45;text-align:justify}\n    .columns p{margin:0 0 5px;text-indent:2em}\n    .mid-info{border-right:1px solid #888;padding-right:7px}\n    .placeholder{display:flex;align-items:center;justify-content:center;text-align:center;color:#426a7d;font-family:\"Microsoft YaHei\",sans-serif}\n    .infographic{height:438px;background:linear-gradient(180deg,#d7f2ff 0,#fbffff 45%,#e8f8ff 100%);position:relative;overflow:hidden;padding:31px 8px 10px}\n    .infographic .arrow{position:absolute;width:104px;height:40px;border-top:10px solid #68b8dc;border-radius:50%;left:25px}\n    .infographic .arrow:before{content:\"\";position:absolute;left:-4px;top:-20px;border-top:15px solid transparent;border-bottom:15px solid transparent;border-right:28px solid #68b8dc;transform:rotate(25deg)}\n    .infographic .a1{top:35px;transform:rotate(13deg)}\n    .infographic .a2{top:243px;transform:rotate(22deg);width:110px}\n    .info-copy{font-family:\"Microsoft YaHei\",sans-serif;font-size:9px;line-height:1.25;color:#42616c;margin-bottom:7px;position:relative;z-index:2}\n    .info-copy b{font-size:13px;color:#2f8899}\n    .devices{position:absolute;right:7px;top:15px;width:55px;height:342px}\n    .car{position:absolute;top:0;left:2px;width:52px;height:25px;background:#f9f9f9;border:2px solid #5e6b70;border-radius:54% 56% 38% 40%;transform:skewX(-10deg)}\n    .car:before,.car:after{content:\"\";position:absolute;bottom:-7px;width:10px;height:10px;background:#222;border-radius:50%}\n    .car:before{left:7px}.car:after{right:7px}\n    .box{position:absolute;right:4px;top:68px;width:29px;height:31px;border:2px solid #9bc3cf;background:#f8ffff}\n    .box:after{content:\"\";position:absolute;left:5px;top:7px;width:16px;height:7px;background:#cceaf3}\n    .fridge{position:absolute;right:4px;top:125px;width:26px;height:63px;border:2px solid #b4d5dc;background:#fff}\n    .fridge:after{content:\"\";position:absolute;left:4px;top:28px;width:15px;border-top:1px solid #b4d5dc}\n    .washer{position:absolute;right:0;top:235px;width:42px;height:43px;border:2px solid #b3d8dc;border-radius:4px;background:#fff}\n    .washer:after{content:\"\";position:absolute;left:10px;top:15px;width:18px;height:18px;border:2px solid #96c6d4;border-radius:50%}\n    .air{position:absolute;right:2px;top:294px;width:45px;height:47px;border:2px solid #b7d9dd;border-radius:4px;background: