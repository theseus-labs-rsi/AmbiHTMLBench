Hei\",sans-serif;font-size:20px;line-height:1.18;margin:4px 0 8px}\n    .patent .tinycols{height:173px}\n    .lower{border-top:2px solid #222;margin-top:8px;display:grid;grid-template-columns:49% 22% 29%;gap:8px;padding-top:6px}\n    .project{grid-column:1 / 2;border-right:1px solid #888;padding-right:7px}\n    .project .eyebrow{text-align:center;font-size:9px;letter-spacing:1px;margin:0 0 3px}\n    .project h2{font-family:\"Heiti SC\",\"Microsoft YaHei\",sans-serif;font-size:18px;line-height:1.18;text-align:center;margin:0 0 5px}\n    .project .brief{column-count:2;column-gap:9px;font-size:8px;line-height:1.36;text-align:justify;height:78px;overflow:hidden}\n    .project p{margin:0 0 4px;text-indent:2em}\n    figure{margin:7px 0 0}\n    .photo{height:197px;width:100%;background:linear-gradient(#b8d6e3 0 16%,#d8cbb8 16% 46%,#cfc0a7 46% 58%,#d9e5c2 58% 100%);border:1px solid #9b9b9b;position:relative;overflow:hidden}\n    .photo:before{content:\"\";position:absolute;left:0;right:0;top:33px;height:68px;background:repeating-linear-gradient(90deg,rgba(255,255,255,.84) 0 13px,rgba(135,135,135,.75) 13px 18px,rgba(236,236,230,.85) 18px 31px)}\n    .photo:after{content:\"\";position:absolute;left:16px;right:13px;bottom:20px;height:54px;background:linear-gradient(90deg,transparent 0 10%,#922d1f 10% 14%,transparent 14% 27%,#222 27% 33%,transparent 33% 48%,#ad3524 48% 54%,transparent 54% 69%,#222 69% 74%,transparent 74% 87%,#983124 87% 92%,transparent 92%);opacity:.9}\n    figcaption{font-size:7px;line-height:1.25;margin-top:3px;text-align:center}\n    .consumption{grid-column:2 / 4;padding-left:1px}\n    .consumption h2{text-align:center;font-family:\"Heiti SC\",\"Microsoft YaHei\",sans-serif;font-size:19px;line-height:1.18;margin:1px 0 9px}\n    .consumption .bodycols{column-count:3;column-gap:10px;font-size:8px;line-height:1.4;text-align:justify;height:288px;overflow:hidden}\n    .bodycols p{margin:0 0 5px;text-indent:2em}\n    .page-no{text-align:right;font-size:7px;margin-top:2px}\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <header class=\"masthead\">\n      <span class=\"section\">要闻</span><span class=\"num\">2</span><span class=\"date\">2025年1月16日　星期四</span>\n      <span class=\"paper\">人民日报</span>\n    </header>\n\n    <section class=\"main-grid\">\n      <article class=\"lead-left\">\n        <div class=\"lead-title\">李强签署国务院令</div>\n        <div class=\"lead-sub\">公布国务院关于规范中介机构为公司公开发行股票提供服务的规定</div>\n        <div class=\"columns\">\n          <p>新华社北京1月15日电　国务院总理李强日前签署国务院令，公布《国务院关于规范中介机构为公司公开发行股票提供服务的规定》（以下简称《规定》），自2025年2月15日起施行。</p>\n          <p>《规定》旨在规范中介机构为公司公开发行股票提供服务行为，防范和惩治证券市场违法违规活动，保护投资者合法权益，促进资本市场健康稳定发展。</p>\n          <p>《规定》明确中介机构执业规范、收费管理、监督管理和法律责任等内容。</p>\n          <p>一是明确中介机构的执业原则。中介机构应当勤勉尽责，遵守法律、行政法规和国家有关规定，按照行业公认的业务标准和道德规范提供服务。</p>\n          <p>二是规范中介机构的收费管理。中介机构在提供服务过程中应当遵循市场化原则，根据工作量、专业能力和责任确定收费标准，不得以不正当方式招揽业务。</p>\n          <p>三是完善监督管理和法律责任。证券监督管理机构依法加强监管，对违法违规行为依法予以查处。</p>\n          <p>《规定》要求有关部门加强协同配合，完善信息共享和风险防控机制，维护公平有序的市场环境。</p>\n        </div>\n      </article>\n\n      <aside class=\"mid-info\">\n        <div class=\"placeholder infographic\" aria-label=\"2024年消费品以旧换新政策带动图\">\n          <span class=\"arrow a1\"></span><span class=\"arrow a2\"></span>\n          <div class=\"info-copy\">2024年<br>新增投放<br><b>汽车以旧换新<br>超680万辆</b></div>\n          <div class=\"info-copy\">超3600万套<br>消费者换新8大类家电<br><b>以旧换新<br>超5600万台</b></div>\n          <div class=\"info-copy\">家装厨卫“焕新”补贴产品<br><b>约6000万套</b></div>\n          <div class=\"info-copy\">电动自行车以旧换新<br><b>超138万辆</b></div>\n          <div class=\"info-copy\" style=\"margin-top:85px\">2025年<br><b>汽车报废更新<br>补贴标准提高<br>最高补贴20000元</b><br>家电以旧换新补贴<br><b>单件最高500元</b></div>\n          <div class=\"devices\"><i class=\"car\"></i><i class=\"box\"></i><i class=\"fridge\"></i><i class=\"washer\"></i><i class=\"air\"></i></div>\n        </div>\n      </aside>\n\n      <article class=\"vertical-zone\">\n        <div class=\"vertical-title\">今年着力稳外贸稳外资扩消费</div>\n        <div class=\"vertical-kicker\">去年消费品以旧换新带动相关销售额一点三万亿元</div>\n        <div class=\"right-copy\">\n          <p>商务部政策研究室负责人表示，2024年旅行服务出口增长明显，服务贸易保持较快增长，结构持续优化。</p>\n          <p>促进外贸稳定增长，2024年旅行服务出口增长1.5倍。</p>\n          <p>李强指出，2024年，中国对外贸易有新突破，全年货物进出口规模再创新高。面对复杂严峻的外部环境，我国坚持扩大高水平对外开放，推动外贸稳量提质。</p>\n          <p>商务部外贸司负责人表示，企业经营信心不断增强，外贸新动能加快培育。下一步，将加大政策支持力度，帮助企业开拓国际市场。</p>\n          <p>关于吸引外资，商务部介绍，2024年，我国实际使用外资保持稳定，制造业和高技术产业吸收外资继续增长。</p>\n          <p>扩大消费方面，消费品以旧换新政策成效明显。汽车、家电、家装厨卫等领域换新需求得到有效释放，市场活力不断增强。</p>\n          <p>商务部表示，将进一步完善促进消费体制机制，培育壮大新型消费，推动消费持续扩大。</p>\n        </div>\n      </article>\n    </section>\n\n    <section class=\"decree\">\n      <article class=\"law\">\n        <h1>国务院关于规范中介机构为公司公开发行股票提供服务的规定</h1>\n        <div class=\"order\">中华人民共和国国务院令<br><small>第798号</small><br><small>《国务院关于规范中介机构为公司公开发行股票提供服务的规定》已经2024年12月27日国务院第49次常务会议通过，现予公布，自2025年2月15日起施行。</small><br><small>总理　李强<br>2025年1月10日</small></div>\n        <div class=\"lawtext\">\n          <p>第一条　为了规范中介机构为公司公开发行股票提供服务行为，保护投资者合法权益，促进资本市场健康稳定发展，制定本规定。</p>\n          <p>第二条　在中华人民共和国境内，中介机构为公司公开发行股票提供服务，适用本规定。</p>\n          <p>本规定所称中介机构，是指为公司公开发行股票提供保荐、承销、审计、法律、资产评估等服务的机构及其从业人员。</p>\n          <p>第三条　中介机构应当遵守法律、行政法规和国家有关规定，遵循诚实守信、勤勉尽责原则，按照行业公认的业务标准和道德规范提供服务。</p>\n          <p>第四条　国务院证券监督管理机构依法对中介机构及其从业人员从事相关业务活动实施监督管理。</p>\n          <p>第五条　中介机构应当建立健全内部控制和风险管理制度，加强对从业人员的管理，防范利益冲突和道德风险。</p>\n          <p>第六条　中介机构应当根据工作量、专业能力和责任，合理确定收费标准，不得以承诺上市结果、返还费用等不正当方式招揽业务。</p>\n          <p>第七条　中介机构及其从业人员应当对所出具文件的真实性、准确性、完整性负责，不得有虚假记载、误导性陈述或者重大遗漏。</p>\n          <p>第八条　有关部门应当加强协同配合，完善信息共享机制，依法查处违法违规行为。</p>\n          <p>第九条　违反本规定的，依照有关法律、行政法规和国家规定追究法律责任。</p>\n          <p>第十条　本规定自2025年2月15日起施行。</p>\n        </div>\n      </article>\n\n      <aside class=\"side-news\">\n        <h2>扩大规模消费，以旧换新加力扩围</h2>\n        <div class=\"tinycols\">\n          <p>2024年，国内消费品以旧换新持续推进，相关政策带动汽车、家电、家装厨卫等产品销售增长。</p>\n          <p>商务部有关负责人表示，2025年将加力扩围实施消费品以旧换新政策，进一步释放消费潜力。</p>\n          <p>在汽车方面，报废更新和置换更新补贴标准提高，支持消费者购买新能源乘用车和符合条件的燃油车。</p>\n          <p>在家电方面，增加补贴品类，优化补贴方式，便利消费者参与换新。手机、平板、智能手表手环等数码产品也纳入支持范围。</p>\n          <p>政策将更加注重统筹供给和需求，推动绿色消费、智能消费和服务消费发展。</p>\n          <p>各地将结合实际细化实施方案，加强资金监管，确保政策落实落细、惠及更多消费者。</p>\n        </div>\n        <div class=\"authority\">权威发布<br><span style=\"font-size:13px\">一分快三 局面 发展新局面</span></div>\n        <div class=\"patent\">\n          <div style=\"text-align:center;font-size:9px\">2024年我国共授权发明专利104.5万件</div>\n          <h2>更多专利走出实验室走向产业链</h2>\n          <div class=\"tinycols\">\n            <p>1月15日，国家知识产权局举行新闻发布会，介绍2024年知识产权工作情况。</p>\n            <p>数据显示，2024年我国共授权发明专利104.5万件，同比增长13.5%；企业发明专利产业化率稳步提升。</p>\n            <p>截至2024年底，国内发明专利有效量达到475.6万件，其中企业拥有的有效发明专利占比持续提高。</p>\n            <p>国家知识产权局有关负责人表示，将持续完善知识产权保护体系，促进更多专利从实验室走向产业链、融入大市场。</p>\n          </div>\n        </div>\n      </aside>\n    </section>\n\n    <section class=\"lower\">\n      <article class=\"project\">\n        <div class=\"eyebrow\">总投资近600亿元，建设石化产业高地</div>\n        <h2>中海壳牌惠州三期乙烯项目开工</h2>\n        <div class=\"brief\">\n          <p>本报广州1月15日电　记者从有关方面获悉，中海壳牌惠州三期乙烯项目在广东惠州大亚湾石化区正式开工建设。</p>\n          <p>项目总投资近600亿元，将建设世界级乙烯装置及下游高端化工产品装置，助力建设石化产业高地。</p>\n          <p>项目建成后，将进一步提升区域产业链供应链现代化水平，促进绿色低碳发展。</p>\n        </div>\n        <figure>\n          <div class=\"placeholder photo\" aria-label=\"中海壳牌惠州三期乙烯项目开工现场\"></div>\n          <figcaption>1月15日，广东惠州大亚湾，中海壳牌惠州三期乙烯项目开工仪式现场。　新华社记者 摄</figcaption>\n        </figure>\n      </article>\n\n      <article class=\"consumption\">\n        <h2>更多专利走出实验室走向产业链</h2>\n        <div class=\"bodycols\">\n          <p>1月15日，国家知识产权局举行新闻发布会，介绍2024年知识产权工作情况。数据显示，2024年我国共授权发明专利104.5万件，同比增长13.5%。</p>\n          <p>截至2024年底，我国国内发明专利有效量达到475.6万件，其中企业拥有的有效发明专利占比不断提升。我国成为世界上首个国内有效发明专利数量突破400万件的国家。</p>\n          <p>国家知识产权局相关负责人介绍，近年来，知识产权创造质量持续提升，高价值发明专利加快增长，专利转化运用取得积极成效。</p>\n          <p>更多专利走出“实验室”，走向产业链、融入大市场。各地围绕重点产业和企业需求，建设运营专利导航服务基地，推动高校和科研院所存量专利盘活利用。</p>\n          <p>有关部门将进一步完善知识产权公共服务体系，加强专利转化运用专项行动，促进科技创新和产业创新深度融合。</p>\n          <p>围绕中小企业成长需要，持续优化知识产权质押融资服务，支持企业运用专利技术增强核心竞争力。</p>\n          <p>下一步，将加快构建高效的知识产权综合管理体制，提升知识产权保护和运用水平，为高质量发展提供有力支撑。</p>\n        </div>\n      </article>\n    </section>\n    <div class=\"page-no\">（责编：张某某）</div>\n  </main>\n</body>\n</html>"
      },
