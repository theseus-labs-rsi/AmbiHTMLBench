padding: 4px 7px; border-radius: 4px; font-size: 18px; }\n    .sandisk { color: #ad1927; font-family: Georgia, serif; font-size: 25px; }\n    .seagate { color: #517f65; letter-spacing: 2px; font-size: 15px; }\n    .dram { color: white; background: #47226c; padding: 6px 4px; font-size: 12px; }\n    .mps { color: #154a7e; font-size: 25px; }\n    .ti { font-size: 14px; }\n    .st { color: #164f91; font-size: 29px; font-style: italic; }\n    .on { background: #4c8d48; color: white; border-radius: 50%; padding: 8px 5px; font-size: 14px; }\n    .lumentum { font-weight: 500; font-size: 17px; }\n    .ciena { color: #b1172b; font-size: 26px; }\n    .coherent { color: #243e8b; font-size: 16px; }\n    .credo { color: #204e84; font-size: 19px; }\n    .dell { color: #29719b; font-size: 19px; }\n    .hpe { font-size: 12px; }\n    .ttm { color: #173968; font-size: 23px; }\n    .nokia { color: #174d95; }\n    .celestica { font-size: 14px; }\n    .smci { font-size: 15px; }\n    .aws { font-size: 27px; font-weight: 500; }\n    .azure { font-size: 14px; color: #333; }\n    .google { font-size: 14px; color: #333; }\n    .meta { color: #2365a4; }\n    .equity { color: #34758b; font-size: 17px; }\n    .oracle { color: #ab1e20; font-size: 20px; letter-spacing: 1px; }\n\n    .keybox {\n      margin-top: 10px;\n      min-height: 90px;\n      border: 2px solid #071a34;\n      border-radius: 10px;\n      display: grid;\n      grid-template-columns: 335px 1fr;\n      overflow: hidden;\n      color: #08162b;\n    }\n    .keytext {\n      position: relative;\n      padding: 8px 13px 7px 71px;\n      border-right: 1px solid #aab2bd;\n      font-size: 12px;\n      line-height: 1.38;\n    }\n    .target {\n      position: absolute;\n      left: 12px;\n      top: 18px;\n      font-size: 47px;\n      line-height: 1;\n      color: #0d2b58;\n    }\n    .keytext strong { display: block; font-size: 17px; }\n    .chain {\n      display: flex;\n      align-items: center;\n      justify-content: space-around;\n      padding: 7px 7px 3px;\n      gap: 2px;\n    }\n    .step {\n      width: 58px;\n      text-align: center;\n      font-size: 11px;\n      line-height: 1.25;\n      color: #111;\n    }\n    .step b {\n      display: block;\n      height: 34px;\n      font-size: 17px;\n      color: #194d7d;\n      padding-top: 3px;\n    }\n    .step .green { color: #5e9b31; }\n    .step .red { color: #a72028; }\n    .step .black { color: #111; }\n    .arrow {\n      margin-top: -19px;\n      color: #283747;\n      font-weight: 900;\n      font-size: 19px;\n    }\n    .footnote {\n      margin: 6px 8px 0;\n      color: #727272;\n      font-size: 12px;\n    }\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <h1>半导体 / <span class=\"blue\">AI 价值链全景图</span></h1>\n    <div class=\"subtitle\">从设计到智能：端到端生态体系</div>\n\n    <table>\n      <colgroup>\n        <col style=\"width:24.5%\">\n        <col style=\"width:19.7%\">\n        <col style=\"width:31.7%\">\n        <col style=\"width:24.1%\">\n      </colgroup>\n      <thead>\n        <tr>\n          <th>层级</th>\n          <th>主要作用</th>\n          <th>代表企业（示例）</th>\n          <th>在AI生态中的角色</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr class=\"row1\">\n          <td class=\"layer\"><span class=\"num\">1</span><span class=\"layer-name\">架构设计 / IP层</span><span class=\"mini-icon\">▣</span></td>\n          <td class=\"function\">创建基础IP<br>和芯片架构</td>\n          <td class=\"logos\"><div class=\"logo-grid\"><span class=\"logo arm\">arm</span><span class=\"logo cadence\">cadence</span><span class=\"logo siemens\">SIEMENS</span><span class=\"logo allegro\">Allegro<br><span class=\"tiny\">Microsystems</span></span></div></td>\n          <td class=\"airole\">定义芯片如何设计，<br>是关键的第一步</td>\n        </tr>\n        <tr class=\"row2\">\n          <td class=\"layer\"><span class=\"num\">2</span><span class=\"layer-name\">芯片设计<br>（无晶圆厂）</span><span class=\"mini-icon\">▣</span></td>\n          <td class=\"function\">使用IP设计芯片，<br>但不生产</td>\n          <td class=\"logos\"><div class=\"logo-grid\"><span class=\"logo nvidia\">NVIDIA</span><span class=\"logo amd\">AMD◩</span><span class=\"logo broadcom\">BROADCOM</span><span class=\"logo qualcomm\">Qualcomm</span><span class=\"logo marvell\">◩ MARVELL</span><span class=\"logo macom\">MACOM.</span><span class=\"logo nxp\">NXP</span></div></td>\n          <td class=\"airole\">打造高性能芯片<br>（GPU、CPU、ASIC、<br>SoC、网络芯片等）</td>\n        </tr>\n        <tr class=\"row3\">\n          <td class=\"layer\"><span class=\"num\">3</span><span class=\"layer-name\">晶圆制造<br>（代工）</span><span class=\"mini-icon\">▥</span></td>\n          <td class=\"function\">在晶圆上制造芯片，<br>使用先进制程</td>\n          <td class=\"logos\"><div class=\"logo-grid\"><span class=\"logo tsmc\">tsmc</span><span class=\"logo umc\">UMC</span><span class=\"logo gf small\">GlobalFoundries</span><span class=\"logo intel\">intel.</span></div></td>\n          <td class=\"airole\">最资本密集的环节，<br>将设计变为现实</td>\n        </tr>\n        <tr class=\"row4\">\n          <td class=\"layer\"><span class=\"num\">4</span><span class=\"layer-name\">设备<br>（生产设备）</span><span class=\"mini-icon\">▥</span></td>\n          <td class=\"function\">提供制造芯片所需<br>的机器和工具</td>\n          <td class=\"logos\"><div class=\"logo-grid\"><span class=\"logo asml\">ASML</span><span class=\"logo applied\">◎ APPLIED<br>MATERIALS.</span><span class=\"logo lam\">◢ Lam<br><span class=\"tiny\">RESEARCH</span></span><span class=\"logo kla\">KLA<span style=\"color:#4b94be\">＋</span></span><span class=\"logo onto\">▣ Onto<br>innovation</span></div></td>\n          <td class=\"airole\">支撑芯片制造的<br>每一步，是进入<br>的高门槛环节</td>\n        </tr>\n        <tr class=\"row5\">\n          <td class=\"layer\"><span class=\"num\">5</span><span class=\"layer-name\">封装与测试<br>（OSAT）</span><span class=\"mini-icon\">▤</span></td>\n          <td class=\"function\">封装、打包并测试<br>芯片以确保可用</td>\n          <td class=\"logos\"><div class=\"logo-grid\"><span class=\"logo amkor\">◉mkor<br><span class=\"tiny\">Technology</span></span><span class=\"logo ase\">✹ ASE</span><span class=\"logo formfactor\">◇ FormFactor</span></div></td>\n          <td class=\"airole\">先进封装是AI芯片<br>（HBM、2.5D/3D等）<br>的关键瓶颈</td>\n        </tr>\n        <tr class=\"row6\">\n          <td class=\"layer\"><span class=\"num\">6</span><span class=\"layer-name\">内存</span><span class=\"mini-icon\">▤</span></td>\n          <td class=\"function\">提供内存芯片<br>（DRAM、HBM、<br>NAND），为AI<br>提供存储与带宽</td>\n          <td class=\"logos\"><div class=\"logo-grid\"><span class=\"logo micron\">Micron</span><span class=\"logo wd\">WD</span><span class=\"logo small\">Western<br>Digital</span><span class=\"logo sandisk\">SanDisk</span><span class=\"logo seagate\">◉ SEAGATE</span><span class=\"logo dram\">DRAM</span></div></td>\n          <td class=\"airole\">内存带宽是AI<br>工作负载的关键<br>瓶颈之一</td>\n        </tr>\n        <tr class=\"row7\">\n          <td class=\"layer\"><span class=\"num\">7</span><span class=\"layer-name\">电源芯片与<br>电力管理</span><span class=\"mini-icon\">ϟ</span></td>\n          <td class=\"function\">高效交付与管理<br>芯片和系统所需<br>的电力</td>\n          <td class=\"logos\"><div class=\"logo-grid\"><span class=\"logo mps\">mps</span><span class=\"logo ti\">▰ TEXAS<br>INSTRUMENTS</span><span class=\"logo st\">ST</span><span class=\"logo nxp\">NXP</span><span class=\"logo on\">ON</span></div></td>\n          <td class=\"airole\">对AI服务器、GPU、<br>电动车等电力效率<br>至关重要</td>\n        </tr>\n        <tr class=\"row8\">\n          <td class=\"layer\"><span class=\"num\">8</span><span class=\"layer-name\">连接与网络</span><span class=\"mini-icon\">⌘</span></td>\n          <td class=\"function\">在芯片、系统和<br>数据中心之间<br>高速传输数据</td>\n          <td class=\"logos\"><div class=\"logo-grid\"><span class=\"logo lumentum\">╱ LUMENTUM</span><span class=\"logo marvell\">◩ MARVELL</span><span class=\"logo ciena\">ciena.</span><span class=\"logo coherent\">✺ COHERENT</span><span class=\"logo credo\">CREDO<br><span class=\"tiny\">We Connect.</span></span></div></td>\n          <td class=\"airole\">高速连接是AI<br>基础设施的<br>关键骨干</td>\n        </tr>\n        <tr class=\"row9\">\n          <td class=\"layer\"><span class=\"num\">9</span><span class=\"layer-name\">系统与基础设施</span><span class=\"mini-icon\">▥</span></td>\n          <td class=\"function\">将芯片集成到服务器、<br>系统和硬件解决方案</td>\n          <td class=\"logos\"><div class=\"logo-grid\"><span class=\"logo dell\">DELL<br><span class=\"tiny\">Technologies</span></span><span class=\"logo hpe\">▱<br>Hewlett Packard<br>Enterprise</span><span class=\"logo ttm\">TTM<br><span class=\"tiny\">Technologies</span></span><span class=\"logo nokia\">NOKIA</span><span class=\"logo celestica\">CELESTICA</span><span class=\"logo smci\">SMCI</span></div></td>\n          <td class=\"airole\">将芯片变为可部署<br>的企业、云和AI<br>基础设施</td>\n        </tr>\n        <tr class=\"row10\">\n          <td class=\"layer\"><span class=\"num\">10</span><span class=\"layer-name\">云计算 / 超大规模<br>（终端用户）</span><span class=\"mini-icon\">☁</span></td>\n          <td class=\"function\">部署大规模计算<br>基础设施并运行<br>AI应用</td>\n          <td class=\"logos\"><div class=\"logo-grid\"><span class=\"logo aws\">aws</span><span class=\"logo azure\">▦ Microsoft<br>Azure</span><span class=\"logo google\">◒ Google Cloud</span><span class=\"logo meta\">∞ Meta</span><span class=\"logo equity\">@equitydd</span><span class=\"logo oracle\">ORACLE</span></div></td>\n          <td class=\"airole\">推动整个AI<br>产业的计算需求</td>\n        </tr>\n      </tbody>\n    </table>\n\n    <section class=\"keybox\">\n      <div class=\"keytext\">\n        <span class=\"target\">◎</span>\n        <strong>关键要点</strong>\n        AI不是芯片，而是一个完整的生态系统。<br>\n        每一层都至关重要，任何一个环节的瓶颈，<br>\n        都会影响大模型和AI的落地。\n      </div>\n      <div class=\"chain\">\n        <div class=\"step\"><b>arm</b>IP</div><span class=\"arrow\">→</span>\n        <div class=\"step\"><b class=\"green\">◉<br>NVIDIA</b>芯片设计</div><span class=\"arrow\">→</span>\n        <div class=\"step\"><b class=\"red\">tsmc</b>晶圆制造</div><span class=\"arrow\">→</span>\n        <div class=\"step\"><b>Amkor</b>封装测试</div><span class=\"arrow\">→</span>\n        <div class=\"step\"><b>Micron</b>内存</div><span class=\"arrow\">→</span>\n        <div class=\"step\"><b>mps</b>电源管理</div><span class=\"arrow\">→</span>\n        <div class=\"step\"><b class=\"black\">◩</b>连接网络</div><span class=\"arrow\">→</span>\n        <div class=\"step\"><b class=\"green\">SUPERMICRO</b>系统集成</div><span class=\"arrow\">→</span>\n        <div class=\"step\"><b class=\"black\">aws</b>云部署</div>\n      </div>\n    </section>\n    <div class=\"footnote\">注：不构成任何投资建议。图中企业为各层级代表性公司，非完整名单。</div>\n  </main>\n</body>\n</html>"
