idth: 126px;\n    height: 126px;\n    margin: 2px 22px 9px 0;\n    border: 6px solid #3c3a38;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font: bold 17px Arial, sans-serif;\n  }\n  .armco-copy p {\n    margin: 0 0 3px;\n    text-align: justify;\n  }\n  .armco-mark {\n    clear: both;\n    margin: 57px auto 90px;\n    text-align: center;\n    font: bold 39px Arial, sans-serif;\n    letter-spacing: 0;\n  }\n  .armco-mark span {\n    display: inline-block;\n    font-size: 28px;\n    vertical-align: middle;\n    margin-right: 13px;\n  }\n  .bottom-blank {\n    height: 110px;\n    width: 100%;\n  }\n  .page-number {\n    margin: 48px 6px 0;\n    font: bold 18px Arial, sans-serif;\n  }\n  .right {\n    padding-top: 0;\n  }\n  .timbers {\n    height: 510px;\n    border: 3px solid #45433f;\n    text-align: center;\n    padding: 37px 15px;\n    font-family: Arial, sans-serif;\n  }\n  .timbers p {\n    margin: 0;\n  }\n  .timbers .small {\n    font-size: 20px;\n    line-height: 2.25;\n    font-style: italic;\n    font-weight: bold;\n  }\n  .timbers .company {\n    margin-top: 58px;\n    font-family: Impact, \"Arial Black\", sans-serif;\n    font-size: 38px;\n    font-weight: bold;\n    letter-spacing: 0;\n  }\n  .timbers .product {\n    margin-top: 38px;\n    font-size: 41px;\n    font-weight: 500;\n  }\n  .timbers .location {\n    margin-top: 56px;\n    font-size: 41px;\n  }\n  .trust {\n    margin-top: 120px;\n  }\n  .trust h1 {\n    margin: 0 0 53px;\n    text-align: center;\n    font-size: 31px;\n    line-height: 1.45;\n    letter-spacing: 13px;\n    font-weight: bold;\n  }\n  .trust p {\n    margin: 0 0 43px;\n    font-size: 25px;\n    line-height: 1.55;\n    font-weight: bold;\n    text-align: justify;\n    hyphens: manual;\n  }\n  .square {\n    float: right;\n    width: 17px;\n    height: 17px;\n    background: #3d3a37;\n    margin: 5px 2px 0 10px;\n  }\n  .publication {\n    clear: both;\n    margin-top: 3