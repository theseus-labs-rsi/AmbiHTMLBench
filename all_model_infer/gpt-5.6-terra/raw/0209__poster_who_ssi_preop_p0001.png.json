        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Surgical Site Infection Prevention Recommendations</title>\n<script src=\"https://polyfill.io/v3/polyfill.min.js?features=es6\"></script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  *{box-sizing:border-box}\n  html,body{margin:0;background:#fff}\n  body{font-family:\"Arial Narrow\",\"Roboto Condensed\",Arial,sans-serif;color:#393939}\n  .page{\n    width:1347px;height:1960px;margin:0 auto;background:#fff;position:relative;\n    border-bottom:5px solid #243488;overflow:hidden;\n  }\n  .masthead{height:305px;position:relative;padding:58px 0 0 0}\n  h1{margin:0;font-stretch:condensed;font-weight:900;line-height:.88;letter-spacing:1px}\n  .line1{display:block;color:#26378c;font-size:58px}\n  .line2{display:block;font-size:58px;color:#26378c}\n  .orange{color:#f27020}\n  .who{\n    position:absolute;right:0;top:65px;color:#0797d5;font-family:Arial,sans-serif;\n    font-size:25px;font-weight:bold;line-height:.95;display:flex;align-items:center;gap:9px;\n  }\n  .seal{width:80px;height:62px;border:2px solid #0797d5;border-radius:50%;font-size:35px;display:flex;align-items:center;justify-content:center}\n  .board{\n    height:1650px;position:relative;padding:31px 0 0 220px;\n    background:linear-gradient(#fafafa 0,#ebebed 570px,#c9c9ca 100%);\n  }\n  .orange-rule{position:absolute;left:160px;top:0;height:1650px;border-left:2px solid #f36e21}\n  .orange-rule:before,.orange-rule:after{content:\"\";position:absolute;left:-2px;width:50px;border-top:2px solid #f36e21}\n  .orange-rule:before{top:0}.orange-rule:after{bottom:0}\n  .vertical{\n    position:absolute;left:61px;top:610px;color:#ef6f24;font-size:31px;line-height:.93;\n    font-weight:900;writing-mode:vertical-rl;transform:rotate(180deg);text-align:center;\n  }\n  .section-title{color:#28388c;font-size:42px;font-weight:900;line-height:.95;margin:0}\n  .section-subtitle{color:#28388c;font-size:17px;font-weight:900;margin:0 0 14px}\n  .labels{height:24px;position:absolute;top:72px;left:958px;width:330px;color:#4c59a8;font-size:18px;font-weight:bold}\n  .labels .action{position:absolute;left:0}.labels .supported{position:absolute;right:0}\n  .rows{margin-top:17px;width:1127px}\n  .row{\n    height:191px;border-bottom:3px solid #bcbcbc;display:grid;\n    grid-template-columns:195px 480px 70px 382px;align-items:center;\n  }\n  .icon{\n    width:180px;height:180px;border:5px solid #303f94;border-radius:50%;\n    background:#fff;display:flex;align-items:center;justify-content:center;\n    color:#61b8cf;font-size:65px;position:relative;overflow:hidden;\n  }\n  .icon small{position:absolute;bottom:16px;font-size:11px;color:#777;max-width:130px;text-align:center}\n  .text-box{\n    background:#fff;border-radius:0 34px 34px 0;min-height:172px;display:flex;\n    align-items:flex-start;justify-content:center;flex-direction:column;padding:18px 30px 18px 0;\n    font-size:22px;font-weight:800;line-height:1.08;\n  }\n  .note{font-size:18px;font-weight:400;font-style:italic;line-height:1.12;margin-top:2px}\n  .arrow{color:#fff;font-size:84px;font-family:Arial;font-weight:200;text-align:center;line-height:1}\n  .support{height:174px;display:flex;align-items:center;justify-content:space-around;text-align:center;font-weight:900;font-size:16px;line-height:.95}\n  .person{display:flex;flex-direction:column;align-items:center;min-width:72px}\n  .avatar{\n    width:57px;height:74px;position:relative;margin-bottom:8px;\n    border-radius:35px 35px 16px 16px;background:#f7c8ad;\n  }\n  .avatar:before{content:\"\";position:absolute;width:63px;height:35px;left:-3px;bottom:-7px;border-radius:25px 25px 5px 5px;background:#4fb8c5}\n  .avatar.dark{background:#b96748}.avatar.dark:before{background:#35b5b7}\n  .avatar.nurse{background:#fac1a2}.avatar.nurse:before{background:#1e71b9}\n  .avatar.doctor{background:#8d5936}.avatar.doctor:before{background:#f5f5f5}\n  .avatar.patient{background:#fac8ae}.avatar.patient:before{background:#9d6da5}\n  .avatar.surgeon{background:#af6045}.avatar.surgeon:before{background:#35b7b8}\n  .groups{display:flex;align-items:flex-end;justify-content:space-around;width:100%}\n  .pharmacy{font-size:50px;line-height:1;margin-bottom:8px}\n  .boxes{font-size:51px;line-height:1;margin-bottom:8px}\n  .team{display:flex;gap:4px;align-items:flex-end;justify-content:center}\n  .team .avatar{transform:scale(.8);margin:0 -7px 4px}\n  .row5{border-bottom:0}\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <header class=\"masthead\">\n    <h1>\n      <span class=\"line1\">SURGICAL SITE INFECTION</span>\n      <span class=\"line2\">PREVENTION <span class=\"orange\">RECOMMENDATIONS</span></span>\n    </h1>\n    <div class=\"who\"><div class=\"seal\">⚕</div><div>World Health<br>Organization</div></div>\n  </header>\n\n  <main class=\"board\">\n    <div class=\"orange-rule\"></div>\n    <div class=\"vertical\">INFECTION PREVENTION<br>AND CONTROL (IPC) TEAM</div>\n\n    <h2 class=\"section-title\">PREOPERATIVE PERIOD</h2>\n    <p class=\"section-subtitle\">PATIENT, CLINICAL AND SUPPORT STAFF AND SURGICAL TEAM ACTIONS</p>\n    <div class=\"labels\"><span class=\"action\">ACTION</span><span class=\"supported\">SUPPORTED BY</span></div>\n\n    <section class=\"rows\">\n      <article class=\"row\">\n        <div class=\"icon\">🚿<small>[Patient bathing illustration]</small></div>\n        <div class=\"text-box\">Patient bathes or showers prior to surgery with<br>either plain or antimicrobial soap</div>\n        <div class=\"arrow\">›</div>\n        <div class=\"support\">\n          <div class=\"person\"><div class=\"avatar\"></div><div>PATIENT</div></div>\n          <div class=\"person\">\n            <div class=\"team\"><div class=\"avatar dark\"></div><div class=\"avatar patient\"></div><div class=\"avatar nurse\"></div></div>\n            <div>SURGICAL TEAM<br>AT PREOPERATIVE CONSULTATION</div>\n          </div>\n        </div>\n      </article>\n\n      <article class=\"row\">\n        <div class=\"icon\">💉<small>[Mupirocin nasal treatment illustration]</small></div>\n        <div class=\"text-box\">\n          Use 2% mupirocin decolonization in known<br>\n          nasal carriers of <em>Staphylococcus aureus</em> in<br>\n          cardiac and orthopaedic surgery\n          <div class=\"note\">(consider for other surgeries)</div>\n        </div>\n        <div class=\"arrow\">›</div>\n        <div class=\"support\">\n          <div class=\"person\"><div class=\"avatar nurse\"></div><div>WARD NURSE</div></div>\n          <div class=\"person\"><div class=\"avatar doctor\"></div><div>DOCTOR</div></div>\n          <div class=\"person\"><div class=\"pharmacy\">💊</div><div>PHARMACY</div></div>\n        </div>\n      </article>\n\n      <article class=\"row\">\n        <div class=\"icon\">🪒<small>[Do not shave symbol]</small></div>\n        <div class=\"text-box\">Do NOT remove patient hair, or if absolutely<br>necessary, remove with a clipper, do not shave</div>\n        <div class=\"arrow\">›</div>\n        <div class=\"support\">\n          <div class=\"person\">\n            <div class=\"team\"><div class=\"avatar surgeon\"></div><div class=\"avatar nurse\"></div></div>\n            <div>SURGICAL TEAM</div>\n          </div>\n          <div class=\"person\"><div class=\"avatar patient\"></div><div>PATIENT INFORMATION<br>AND EDUCATION</div></div>\n        </div>\n      </article>\n\n      <article class=\"row\">\n        <div class=\"icon\">◷<small>[Clock illustration]</small></div>\n        <div class=\"text-box\">\n          Administer surgical antibiotic prophylaxis in the<br>\n          120 minutes preceding surgical incision\n          <div class=\"note\">(depending on the type of operation and the half life of the<br>antibiotic)</div>\n        </div>\n        <div class=\"arrow\">›</div>\n        <div class=\"support\">\n          <div class=\"person\"><div class=\"avatar surgeon\"></div><div>ANAESTHETIST<br>(OR OTHER IN SURGICAL TEAM)</div></div>\n          <div class=\"person\">\n            <div class=\"team\"><div class=\"avatar doctor\"></div><div class=\"pharmacy\">💊</div><div class=\"avatar doctor\"></div></div>\n            <div>IPC TEAM/PHARMACY</div>\n          </div>\n        </div>\n      </article>\n\n      <article class=\"row row5\">\n        <div class=\"icon\">🧴<small>[Hand preparation illustration]</small></div>\n        <div class=\"text-box\">\n          Prepare hands for surgery by scrubbing,<br>\n          using the correct technique with a suitable<br>\n          antimicrobial soap and water OR an<br>\n          alcohol-based handrub\n          <div class=\"note\">(before donning sterile gloves)</div>\n        </div>\n        <div class=\"arrow\">›</div>\n        <div class=\"support\">\n          <div class=\"person\"><div class=\"avatar surgeon\"></div><div>SURGEON</div></div>\n          <div class=\"person\"><div class=\"boxes\">💊📦</div><div>PHARMACY/<br>PROCUREMENT</div></div>\n        </div>\n      </article>\n    </section>\n  </main>\n</div>\n</body>\n</html>"
