d .body-grid, .financial .body-grid { grid-template-rows: 25% 19% 28% 28%; }\n    .period .cell, .financial .cell { padding: 8px; }\n    .icon-value {\n      height: 100%;\n      display: flex;\n      flex-direction: column;\n      justify-content: center;\n      align-items: center;\n      gap: 7px;\n      font-size: 16px;\n    }\n    .shield {\n      width: 42px;\n      height: 50px;\n      border: 3px solid #08ae9f;\n      border-radius: 4px 4px 18px 18px;\n      clip-path: polygon(50% 0,100% 12%,100% 58%,84% 84%,50% 100%,16% 84%,0 58%,0 12%);\n      color: #08ae9f;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 23px;\n      font-weight: bold;\n      background: #f7ffff;\n    }\n    .shield.red { color: #ba380f; border-color: #ba380f; }\n    .money {\n      width: 43px;\n      height: 43px;\n      border: 3px solid #1bb75d;\n      border-radius: 39% 49% 42% 45%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      color: #1bb75d;\n      font-size: 26px;\n      font-weight: bold;\n      position: relative;\n    }\n    .money:before, .money:after {\n      content: \"\";\n      position: absolute;\n      width: 6px;\n      height: 6px;\n      border-radius: 50%;\n      background: currentColor;\n    }\n    .money:before { top: -8px; right: 3px; }\n    .money:after { right: -10px; top: 5px; }\n    .money.red { color: #ba380f; border-color: #ba380f; }\n    .footer {\n      margin-top: 28px;\n      display: flex;\n      justify-content: space-between;\n      font-size: 16px;\n    }\n    .page-break { height: 0; }\n    @media (max-width: 1900px) {\n      .spread { padding-left: 4%; padding-right: 4%; }\n      .cell { font-size: 14px; }\n      .head { font-size: 16px; }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"spread\">\n    <header class=\"masthead\">\n      <div class=\"report-title\">2024·美的集团ESG报告</div>\n      <nav class=\"nav\">\n        <span>关于本报告</span><span>走进美的</span><span>可持续发展治理</span><span class=\"active\">守护蓝色星球</span><span>构建和谐社区</span><span>践行科技尽善</span><span>共创繁荣生态</span><span>附录</span>\n      </nav>\n      <div class=\"scene\" aria-label=\"[Diagram: mountain and solar panels]\">\n        <i class=\"mountain one\"></i><i class=\"mountain two\"></i><i class=\"mountain three\"></i>\n      </div>\n    </header>\n\n    <section class=\"columns\">\n      <section class=\"column\">\n        <div class=\"head\">风险类型</div>\n        <div class=\"box risk-type tall\">\n          <div class=\"type-cell\">物理风险</div>\n          <div class=\"type-cell\">转型风险</div>\n        </div>\n        <div class=\"head\" style=\"margin-top:25px;\">机遇类型</div>\n        <div class=\"box risk-type opportunity\">\n          <div class=\"type-cell\">市场机遇</div>\n        </div>\n      </section>\n\n      <section class=\"column description\">\n        <div class=\"head\">风险描述</div>\n        <div class=\"box body-grid\">\n          <div class=\"cell first\">洪灾程度增加</div>\n          <div class=\"cell second\">极端高温</div>\n          <div class=\"cell\">台风等频次增加</div>\n          <div class=\"cell\">对产品能效、冷媒、材料等强制性监管要求的提升</div>\n          <div class=\"cell\">对新能源、储能、新能源汽车核心零部件等产业的投入和转型</div>\n          <div class=\"cell\">绿色能源成本的不确定性</div>\n        </div>\n        <div class=\"head\" style=\"margin-top:25px;\">机遇描述</div>\n        <div class=\"box body-grid short\">\n          <div class=\"cell\">绿色产品和服务带来的业务机会</div>\n        </div>\n      </section>\n\n      <section class=\"column impact\">\n        <div class=\"head\">风险影响</div>\n        <div class=\"box body-grid\">\n          <div class=\"cell\">\n            <ul>\n              <li>严重洪灾可能对排水能力较差的仓储区造成成品及生产设备损毁，进而导致运营成本增加与设备加速折旧</li>\n              <li>交通中断或拥堵，无法保证员工的通勤时间，可能导致雇员生产力下降</li>\n            </ul>\n          </div>\n          <div class=\"cell\">\n            <ul>\n              <li>极端高温将降低户外工作者的工作效率，增加员工健康安全风险</li>\n              <li>为办公、生产等区域员工提供舒适的工作环境所需的制冷能源消耗将增加，进一步加大了制冷相关的碳排放，并有可能增加运营成本</li>\n            </ul>\n          </div>\n          <div class=\"cell\">\n            <ul>\n              <li>对部分海运物料供应、成品运输的时效性可能造成影响，进一步增加运营成本</li>\n            </ul>\n          </div>\n          <div class=\"cell\">\n            <ul>\n              <li>更高级能效市场准入及消费者偏好将影响研发和市场投入方向</li>\n              <li>《蒙特利尔议定书》对破坏臭氧层物质管制的要求及欧盟、美洲等地区对不同环保型冷媒产品及二氧化碳压缩机等产品的引入将在中长期影响研发和市场的投入方向</li>\n              <li>在循环经济体系背景下环保型材料尤其是再生材料应用占比的提出可能增加产品材料来源的不确定性进一步提升材料的潜在成本</li>\n            </ul>\n          </div>\n          <div class=\"cell\">\n            <ul>\n              <li>在应对和适应气候背景下，以合康新能、科陆电子、汽车部件等代表的新业务板块有巨大的市场潜力和竞争压力</li>\n            </ul>\n          </div>\n          <div class=\"cell\">\n            <ul>\n              <li>当前可靠的绿色电力资源紧缺，市场需求上涨，长期以往可能导致绿色电力在市场化机制下绿电环境溢价进一步提升，增加制造工厂能源成本</li>\n            </ul>\n          </div>\n        </div>\n        <div class=\"head\" style=\"margin-top:25px;\">机遇影响</div>\n        <div class=\"box body-grid short\">\n          <div class=\"cell\">\n            <ul>\n              <li>持续开发和/或扩展低排放产品和服务，获得更多市场份额及消费者青睐，同时在资本市场获得更多投资机会，带来更多收入增长</li>\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"column strategy\">\n        <div class=\"head\">应对策略</div>\n        <div class=\"box body-grid\">\n          <div class=\"cell\">\n            <ul>\n              <li>提升各基地应对50年一遇洪灾的应对能力，并购置相关保险</li>\n              <li>进一步完善员工宿舍建设，缩短员工通勤路程</li>\n            </ul>\n          </div>\n          <div class=\"cell\">\n            <ul>\n              <li>完善户外作业管理要求，通过制冷设备升级和智能化控制手段，开展制冷相关节能降碳项目</li>\n              <li>通过绿色建筑建设，采用围护结构改造、自然通风等有效措施提升办公区域的舒适度</li>\n            </ul>\n          </div>\n          <div class=\"cell\">\n            <ul>\n              <li>通过制造能力全球布局、制造基地安全库存、供方布局及唯一性排查、各基地柔性制造能力提升等措施提升供应链气候韧性</li>\n            </ul>\n          </div>\n          <div class=\"cell\">\n            <ul>\n              <li>通过绿色设计标准牵引加快更高能效、水效等产品的技术领先性</li>\n              <li>加快环保型冷媒产品研发、制造、市场的投入，保持行业市场领先</li>\n              <li>联合包括大宗物料供方、废旧家电回收商、家电拆解工厂、再生资源生产商、塑料改性生产商等上下游价值链推动内外双循环制造模式，加快绿色低碳材料研究和应用，并在合适的区域建设自有拆解工厂，提升再生资源的生产能力</li>\n            </ul>\n          </div>\n          <div class=\"cell\">\n            <ul>\n              <li>通过绿色工业等布局进一步提升相关业务综合服务能力</li>\n              <li>通过研发和技术创新抓住产品突破方向及市场机遇</li>\n            </ul>\n          </div>\n          <div class=\"cell\">\n            <ul>\n              <li>加强智能制造和绿色工艺突破，能源脱碳和节能降碳同步推进</li>\n              <li>提升自制件相关供应商研发生产、供应交付能力，进一步降低价值链碳排放，降低集团工厂的自制件生产压力</li>\n            </ul>\n          </div>\n        </div>\n        <div class=\"head\" style=\"margin-top:25px;\">应对策略</div>\n        <div class=\"box body-grid short\">\n          <div class=\"cell\">\n            <ul>\n              <li>持续推动美的绿色服务，为本集团内部和客户提供绿色解决方案</li>\n              <li>坚持“绿色战略”引领，推进绿色设计，布局绿色低碳技术，研发绿色产品，满足市场与消费者对绿色产品的期待</li>\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"column period\">\n        <div class=\"head\">影响周期</div>\n        <div class=\"box body-grid\">\n          <div class=\"cell\"><div class=\"icon-value\"><div class=\"shield red\">♧</div><span>短中期</span></div></div>\n          <div class=\"cell\"><div class=\"icon-value\"><div class=\"shield\">♧</div><span>长期</span></div></div>\n          <div class=\"cell\"><div class=\"icon-value\"><div class=\"shield red\">♧</div><span>短中期</span></div></div>\n          <div class=\"cell\"><div class=\"icon-value\"><div class=\"shield\">♧</div><span>中长期</span></div></div>\n          <div class=\"cell\"><div class=\"icon-value\"><div class=\"shield\">♧</div><span>中长期</span></div></div>\n          <div class=\"cell\"><div class=\"icon-value\"><div class=\"shield\">♧</div><span>中长期</span></div></div>\n        </div>\n        <div class=\"head\" style=\"margin-top:25px;\">影响周期</div>\n        <div class=\"box body-grid short\"><div class=\"cell\"><div class=\"icon-value\"><div class=\"shield red\">♧</div><span>短中期</span></div></div></div>\n      </section>\n\n      <section class=\"column financial\">\n        <div class=\"head\">财务冲击</div>\n        <div class=\"box body-grid\">\n          <div class=\"cell\"><div class=\"icon-value\"><div class=\"money\">¥</div><span>较小</span></div></div>\n          <div class=\"cell\"><div class=\"icon-value\"><div class=\"money\">¥</div><span>较小</span></div></div>\n          <div class=\"cell\"><div class=\"icon-value\"><div class=\"money\">¥</div><span>较小</span></div></div>\n          <div class=\"cell\"><div class=\"icon-value\"><div class=\"money\">¥</div><span>一般</span></div></div>\n          <div class=\"cell\"><div class=\"icon-value\"><div class=\"money\">¥</div><span>一般</span></div></div>\n          <div class=\"cell\"><div class=\"icon-value\"><div class=\"money\">¥</div><span>较小</span></div></div>\n        </div>\n        <div class=\"head\" style=\"margin-top:25px;\">财务冲击</div>\n        <div class=\"box body-grid short\"><div class=\"cell\"><div class=\"icon-value\"><div class=\"money red\">¥</div><span>较大</span></div></div></div>\n      </section>\n    </section>\n\n    <footer class=\"footer\"><span>23</span><span>24</span></footer>\n  </main>\n</body>\n</html>"
