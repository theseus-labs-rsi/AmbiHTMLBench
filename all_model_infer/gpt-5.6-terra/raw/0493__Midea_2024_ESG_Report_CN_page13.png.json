        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>2024·美的集团ESG报告</title>\n  <script src=\"https://polyfill.io/v3/polyfill.min.js?features=es6\"></script>\n  <script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      min-width: 1800px;\n      background: #fff;\n      color: #181818;\n      font-family: \"Microsoft YaHei\", \"Noto Sans SC\", Arial, sans-serif;\n    }\n    .spread { width: 100%; padding: 48px 4.8% 42px; }\n    .masthead {\n      height: 165px;\n      position: relative;\n      color: #858585;\n      font-size: 16px;\n    }\n    .report-title { position: absolute; top: 7px; left: 0; }\n    .nav {\n      position: absolute;\n      top: 7px;\n      right: 0;\n      display: flex;\n      gap: 23px;\n      align-items: center;\n      white-space: nowrap;\n    }\n    .nav .active {\n      color: #00aaa2;\n      border: 1px solid #00aaa2;\n      border-radius: 18px;\n      padding: 1px 9px 2px;\n      margin: -2px -9px;\n    }\n    .scene {\n      position: absolute;\n      top: 35px;\n      left: -18px;\n      width: 205px;\n      height: 135px;\n    }\n    .mountain {\n      position: absolute;\n      bottom: 0;\n      clip-path: polygon(50% 0,100% 100%,0 100%);\n      background: #00a9a4;\n    }\n    .mountain.one { width: 94px; height: 125px; left: 5px; }\n    .mountain.two { width: 105px; height: 155px; left: 59px; background: #23c3c0; }\n    .mountain.three { width: 82px; height: 105px; left: 95px; background: #8ee2dc; }\n    .placeholder {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      color: #777;\n      font-size: 11px;\n      text-align: center;\n    }\n    .columns {\n      display: grid;\n      grid-template-columns: 10.5% 13.5% 25.7% 25.7%