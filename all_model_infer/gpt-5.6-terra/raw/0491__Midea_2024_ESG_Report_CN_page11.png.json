; left: 50%; width: 1px; height: 47px; }\n\n    .node {\n      position: absolute;\n      z-index: 1;\n      background: #fff;\n      border: 1px solid #00ada7;\n      border-radius: 5px;\n      box-shadow: 6px 6px 0 #bdeceb;\n    }\n    .node-title {\n      position: absolute;\n      left: 50%;\n      transform: translateX(-50%);\n      min-width: 165px;\n      padding: 6px 19px 7px;\n      border-radius: 22px;\n      background: #00ada7;\n      color: #fff;\n      text-align: center;\n      font-size: 15px;\n      line-height: 1.2;\n      white-space: nowrap;\n    }\n    .board {\n      top: 37px;\n      left: 18px;\n      right: 18px;\n      height: 79px;\n      padding: 37px 8% 12px;\n    }\n    .board .node-title { top: -17px; }\n    .board-content {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 16%;\n      font-size: 14px;\n      line-height: 1.65;\n    }\n    .committee {\n      top: 161px;\n      left: 18px;\n      right: 18px;\n      height: 123px;\n      padding: 38px 15px 12px;\n    }\n    .committee .node-title { top: -17px; }\n    .committee-content {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 15px;\n      font-size: 13px;\n      line-height: 1.65;\n    }\n    .team {\n      top: 437px;\n      width: 39%;\n      height: 102px;\n      padding: 32px 14px 10px;\n      font-size: 13px;\n      line-height: 1.65;\n    }\n    .team .node-title { top: -17px; }\n    .team-left { left: 18px; }\n    .team-right { right: 18px; }\n    .subcommittee {\n      top: 584px;\n      left: 18px;\n      right: 18px;\n      height: 115px;\n      padding: 34px 16px 10px;\n    }\n    .subcommittee-content {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 24px;\n      font-size: 13px;\n      line-height: 1.65;\n    }\n    .subcommittee .node-title {\n      top: -17px;\n      min-width: 0;\n      width: calc(100% + 14px);\n      padding-left: 8px;\n      padding-right: 8px;\n      font-size: 13px;\n    }\n    .sub {\n      position: relative;\n    }\n  </style>\n</head>\n<body>\n  <main class=\"spread\">\n    <section class=\"page left-page\">\n      <div class=\"photo placeholder\">[Photo: lakeside lawn and Midea Group office buildings]</div>\n      <div class=\"left-content\">\n        <div class=\"report-label\">2024·美的集团ESG报告</div>\n        <div class=\"topic\">专题</div>\n        <h1>向零笃行 应对气候挑战</h1>\n        <p class=\"intro\">\n          气候变化是全球面临的共同挑战。为了响应国家适应气候变化的<br>\n          战略，美的集团参考国际可持续发展准则理事会（ISSB）发布的<br>\n          IFRS S2《国际财务报告可持续披露准则第 2 号 — 气候相关披露》<br>\n          的披露建议，进一步完善气候变化治理框架及气候风险的识别与<br>\n          管理流程，识别与自身经营相关的气候变化风险与机遇并落实气<br>\n          候变化应对措施，助力全球气候变化治理，全面推进美的集团可<br>\n          持续发展。\n        </p>\n      </div>\n      <div class=\"page-no\">19</div>\n    </section>\n\n    <section class=\"page right-page\">\n      <nav>\n        <span>关于本报告</span>\n        <span>走进美的</span>\n        <span>可持续发展治理</span>\n        <span class=\"active\">守护蓝色星球</span>\n        <span>构建和谐社区</span>\n        <span>践行科技尽善</span>\n        <span>共创繁荣生态</span>\n        <span>附录</span>\n      </nav>\n\n      <h2 class=\"governance-title\">治理</h2>\n      <p class=\"governance-copy\">\n        美的集团高度重视气候变化治理工作，将气候问题的治理纳入整体的ESG管治架构中，搭建了由董事会、ESG<br>\n        委员会、ESG执行组及ESG秘书处、三大ESG分委会组成的四层级气候变化治理架构，明确管理层在评估和管<br>\n        理气候风险方面的职责，确保对气候变化相关事宜进行妥善管理。此外，董事会薪酬与考核委员会负责对核心<br>\n        经营指标进行评估，这些指标涵盖了可持续发展绩效。委员会将评估结果与相关管理层的绩效紧密挂钩，并据<br>\n        此进行考核。\n      </p>\n\n      <div class=\"chart placeholder\">\n        <span class=\"tree-line line-top\"></span>\n        <span class=\"tree-line line-mid\"></span>\n        <span class=\"tree-line line-branch1\"></span>\n        <span class=\"tree-line line-left\"></span>\n        <span class=\"tree-line line-right\"></span>\n        <span class=\"tree-line line-branch2\"></span>\n        <span class=\"tree-line line-bottom\"></span>\n\n        <div class=\"node board\">\n          <div class=\"node-title\">美的集团董事会</div>\n          <div class=\"board-content\">\n            <div>监督气候管理方法的有效性</div>\n            <div>监督气候议题的管理进展及表现，<br>包括目标进度等</div>\n          </div>\n        </div>\n\n        <div class=\"node committee\">\n          <div class=\"node-title\">ESG委员会</div>\n          <div class=\"committee-content\">\n            <div>负责监督和指导美的集团<br>气候变化相关事宜，并向<br>董事会进行汇报</div>\n            <div>制定并检讨气候相关策<br>略、管理及考核方法</div>\n            <div>评估气候相关风险和机遇，<br>定期审阅与检讨气候相关<br>的目标及主要举措</div>\n            <div>确定并管理用于识别、<br>缓解和监测气候相关的<br>预算、资源和投资情况</div>\n          </div>\n        </div>\n\n        <div class=\"node team team-left\">\n          <div class=\"node-title\">ESG执行组</div>\n          推进落实与定期检讨美的集团气候变化战<br>略及风险与机遇管理等事宜\n        </div>\n\n        <div class=\"node team team-right\">\n          <div class=\"node-title\">ESG秘书处</div>\n          跟踪事业群/事业部气候相关绩效及具体管<br>理举措的执行和实施情况\n        </div>\n\n        <div class=\"node subcommittee\">\n          <div class=\"subcommittee-content\">\n            <div class=\"sub\">\n              <div class=\"node-title\">绿色制造与碳排放管理分委会</div>\n              负责落实气候相关风险<br>和机遇的日常管理和执<br>行工作\n            </div>\n            <div class=\"sub\">\n              <div class=\"node-title\">绿色设计与产品碳足迹分委会</div>\n              识别气候变化相关风险、<br>积极采取应对措施\n            </div>\n            <div class=\"sub\">\n              <div class=\"node-title\">绿色供应与冲突矿产分委会</div>\n              协调各事业群/事业部，<br>促进其有效合作\n              <br><br>\n              评估、管理和监测气候相<br>关问题，提供全面的分析、<br>建议和更新内容，供董事<br>会和ESG委员会审议\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"page-no\">20</div>\n    </section>\n  </main>\n</body>\n</html>"
