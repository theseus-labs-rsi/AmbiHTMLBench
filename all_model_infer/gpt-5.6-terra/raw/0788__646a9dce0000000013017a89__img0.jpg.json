ht: 40px;\n      margin: 4px auto 12px;\n      border-radius: 24px;\n      background: #bd451c;\n      color: #fffbe8;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 15px;\n      font-size: 24px;\n      font-weight: 700;\n      letter-spacing: 1px;\n      box-shadow: inset 0 2px 0 rgba(255,255,255,.12);\n    }\n\n    .grade::before,\n    .grade::after {\n      content: \"\";\n      width: 6px;\n      height: 6px;\n      border-radius: 50%;\n      background: #ffe8a1;\n      box-shadow: 0 0 0 2px rgba(105, 42, 17, .28);\n    }\n\n    .poems {\n      display: grid;\n      grid-template-columns: repeat(6, 1fr);\n      grid-template-rows: 178px 196px 196px;\n      width: 100%;\n    }\n\n    .poem {\n      text-align: center;\n      padding: 0 7px;\n      border-right: 2px dashed rgba(211, 211, 180, .65);\n      border-bottom: 2px dashed rgba(211, 211, 180, .65);\n      overflow: hidden;\n    }\n\n    .poem h2 {\n      margin: 0 0 4px;\n      color: #934126;\n      font-size: 20px;\n      line-height: 1.35;\n      font-weight: 800;\n      white-space: nowrap;\n    }\n\n    .poem .author {\n      margin-bottom: 3px;\n      font-size: 17px;\n      line-height: 1.45;\n      color: #555;\n    }\n\n    .poem .verse {\n      margin: 0;\n      font-size: 17px;\n      line-height: 1.62;\n      font-weight: 600;\n      white-space: nowrap;\n    }\n\n    .spring {\n      grid-column: 1 / span 3;\n      grid-row: 1;\n    }\n\n    .wang {\n      grid-column: 4 / span 3;\n      grid-row: 1;\n      border-right: 0;\n    }\n\n    .quiet {\n      grid-column: 1 / span 2;\n      grid-row: 2;\n    }\n\n    .seeker {\n      grid-column: 3 / span 2;\n      grid-row: 2;\n    }\n\n    .pond {\n      grid-column: 5 / span 2;\n      grid-row: 2;\n      border-right: 0;\n    }\n\n    .pool {\n      grid-column: 1 / span 3;\n      grid-row: 3;\n      border-bottom: 0;\n    }\n\n    .chicken {\n      grid-column: 4 / span 3;\n      grid-row: 3;\n     