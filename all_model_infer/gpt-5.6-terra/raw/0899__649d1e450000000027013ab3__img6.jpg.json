        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>初中物理</title>\n<script>\n  window.MathJax = { tex: { inlineMath: [['$','$'], ['\\\\(','\\\\)']] } };\n</script>\n<script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  html, body {\n    margin: 0;\n    padding: 0;\n    background: #fff;\n  }\n  body {\n    font-family: \"SimSun\", \"宋体\", serif;\n    color: #111;\n  }\n  .paper {\n    position: relative;\n    width: 477px;\n    height: 644px;\n    margin: 41px 0 0 31px;\n    overflow: hidden;\n    border: 1px solid #555;\n    background: #fff;\n  }\n  .top-rule {\n    position: absolute;\n    left: 27px;\n    top: 5px;\n    width: 418px;\n    border-top: 1px solid #999;\n  }\n  .top-rule.lower {\n    top: 9px;\n    left: 29px;\n    width: 414px;\n    border-top-color: #c5c5c5;\n  }\n  .fold {\n    position: absolute;\n    right: -1px;\n    top: -1px;\n    width: 28px;\n    height: 20px;\n  }\n  .fold svg { display: block; width: 100%; height: 100%; }\n  .pin {\n    position: absolute;\n    z-index: 3;\n    left: 1px;\n    top: -9px;\n    width: 18px;\n    height: 27px;\n  }\n  .pin .head {\n    position: absolute;\n    left: 5px;\n    top: 1px;\n    width: 9px;\n    height: 9px;\n    border: 1px solid #333;\n    border-radius: 50%;\n    background: #e1d33b;\n    box-shadow: 1px 1px 1px #777;\n  }\n  .pin .cap {\n    position: absolute;\n    left: 2px;\n    top: 5px;\n    width: 15px;\n    height: 5px;\n    border: 1px solid #333;\n    border-radius: 50%;\n    background: #e6d737;\n  }\n  .pin .stem {\n    position: absolute;\n    left: 8px;\n    top: 9px;\n    width: 2px;\n    height: 13px;\n    background: #555;\n  }\n  .pin .point {\n    position: absolute;\n    left: 6px;\n    top: 20px;\n    width: 0;\n    height: 0;\n    border-left: 3px solid transparent;\n    border-right: 3px solid transparent;\n    border-top: 6px solid #555;\n  }\n\n  .content {\n    position: absolute;\n    left: 27px;\n    top: 0;\n    width: 423px;\n    height: 615px;\n    font-size: 10px;\n    line-height: 15px;\n  }\n  .line { white-space: nowrap; }\n  .q6 {\n    position: absolute;\n    left: 29px;\n    top: 84px;\n    width: 390px;\n    font-size: 9.5px;\n  }\n  .q7 {\n    position: absolute;\n    left: 0;\n    top: 100px;\n  }\n  .q8 {\n    position: absolute;\n    left: 0;\n    top: 164px;\n  }\n  .q9 {\n    position: absolute;\n    left: 0;\n    top: 247px;\n  }\n  .q9-options {\n    position: absolute;\n    left: 18px;\n    top: 376px;\n    font-size: 9.5px;\n  }\n  .q10 {\n    position: absolute;\n    left: 0;\n    top: 400px;\n  }\n  .q11 {\n    position: absolute;\n    left: 0;\n    top: 433px;\n  }\n  .q12 {\n    position: absolute;\n    left: 0;\n    top: 544px;\n    font-size: 9.7px;\n  }\n\n  .placeholder {\n    position: absolute;\n    background: transparent;\n  }\n  .placeholder .caption {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    overflow: hidden;\n    clip: rect(0 0 0 0);\n    white-space: nowrap;\n  }\n  .pulley {\n    left: 53px;\n    top: 20px;\n    width: 68px;\n    height: 67px;\n  }\n  .incline-one {\n    left: 48px;\n    top: 313px;\n    width: 115px;\n    height: 67px;\n  }\n  .incline-two {\n    left: 48px;\n    top: 465px;\n    width: 116px;\n    height: 68px;\n  }\n  .footer-title {\n    position: absolute;\n    bottom: 6px;\n    left: 182px;\n    width: 100px;\n    text-align: center;\n    font-size: 10px;\n  }\n  .page-number {\n    position: absolute;\n    right: 27px;\n    bottom: 7px;\n    font-size: 8px;\n  }\n</style>\n</head>\n<body>\n  <main class=\"paper\">\n    <div class=\"top-rule\"></div>\n    <div class=\"top-rule lower\"></div>\n\n    <div class=\"pin\" aria-hidden=\"true\">\n      <div class=\"head\"></div>\n      <div class=\"cap\"></div>\n      <div class=\"stem\"></div>\n      <div class=\"point\"></div>\n    </div>\n\n    <div class=\"fold\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 28 20\">\n        <polygon points=\"0,0 17,0 27,18 27,20\" fill=\"#fff\" stroke=\"#555\" stroke-width=\"1\"/>\n        <polyline points=\"17,0 20,12 27,18\" fill=\"none\" stroke=\"#777\" stroke-width=\"0.8\"/>\n      </svg>\n    </div>\n\n    <div class=\"placeholder pulley\" aria-label=\"滑轮示意图\">\n      <svg viewBox=\"0 0 68 67\" width=\"68\" height=\"67\">\n        <g stroke=\"#222\" fill=\"none\" stroke-width=\"1\">\n          <line x1=\"34\" y1=\"3\" x2=\"51\" y2=\"3\"/>\n          <line x1=\"35\" y1=\"1\" x2=\"35\" y2=\"5\"/>\n          <line x1=\"38\" y1=\"1\" x2=\"38\" y2=\"5\"/>\n          <line x1=\"41\" y1=\"1\" x2=\"41\" y2=\"5\"/>\n          <line x1=\"44\" y1=\"1\" x2=\"44\" y2=\"5\"/>\n          <line x1=\"47\" y1=\"1\" x2=\"47\" y2=\"5\"/>\n          <line x1=\"50\" y1=\"1\" x2=\"50\" y2=\"5\"/>\n          <circle cx=\"43\" cy=\"15\" r=\"5\"/>\n          <circle cx=\"43\" cy=\"15\" r=\"1.2\" fill=\"#222\"/>\n          <line x1=\"43\" y1=\"10\" x2=\"43\" y2=\"7\"/>\n          <line x1=\"43\" y1=\"20\" x2=\"43\" y2=\"54\"/>\n          <path d=\"M38,20 L38,54 Q38,58 43,58 Q48,58 48,54 L48,20\"/>\n          <circle cx=\"43\" cy=\"43\" r=\"5\"/>\n          <circle cx=\"43\" cy=\"43\" r=\"1.2\" fill=\"#222\"/>\n          <line x1=\"38\" y1=\"43\" x2=\"38\" y2=\"61\"/>\n          <line x1=\"48\" y1=\"43\" x2=\"48\" y2=\"61\"/>\n          <rect x=\"38\" y=\"58\" width=\"10\" height=\"7\"/>\n          <line x1=\"33\" y1=\"28\" x2=\"22\" y2=\"28\"/>\n          <line x1=\"22\" y1=\"28\" x2=\"22\" y2=\"39\"/>\n          <line x1=\"21\" y1=\"31\" x2=\"24\" y2=\"31\"/>\n          <line x1=\"21\" y1=\"34\" x2=\"24\" y2=\"34\"/>\n          <line x1=\"21\" y1=\"37\" x2=\"24\" y2=\"37\"/>\n          <rect x=\"0.5\" y=\"22\" width=\"10\" height=\"10\"/>\n        </g>\n        <text x=\"3.1\" y=\"30\" font-size=\"8\" fill=\"#222\">4</text>\n      </svg>\n      <span class=\"caption\">[Diagram: pulley]</span>\n    </div>\n\n    <div class=\"content\">\n      <section class=\"q6\">\n        <div class=\"line\">A. F=90N；W=27J　　B. F=60N；W=54J　　C. F=30N；W=27J　　D. F=60N；W=18J</div>\n      </section>\n\n      <section class=\"q7\">\n        <div class=\"line\">7. 平台上放着的甲、乙两辆汽车，在相同牵引力作用下匀速行驶，如果在相同时间内通过的</div>\n        <div class=\"line\">路程之比为3：2，则甲、乙（　）</div>\n        <div class=\"line\">A. 牵引力做功之比为2：3　　B. 牵引力做功之比为3：2</div>\n        <div class=\"line\">C. 牵引力的功率之比为1：1　　D. 汽车所受的阻力之比为3：2</div>\n      </section>\n\n      <section class=\"q8\">\n        <div class=\"line\">8. 小明用40N的水平推力将一个重90N的箱子水平推动了1m，用时2s；小明又将这个</div>\n        <div class=\"line\">箱子匀速推上了0.4m高的台阶，所用时间1.5s。比较小明前后所做的功W<sub>1</sub>、W<sub>2</sub>和</div>\n        <div class=\"line\">做功的功率P<sub>1</sub>、P<sub>2</sub>之间的关系是（　）</div>\n        <div class=\"line\">A. W<sub>1</sub>&gt;W<sub>2</sub>　 P<sub>1</sub>&lt;P<sub>2</sub>　　B. W<sub>1</sub>&gt;W<sub>2</sub>　 P<sub>1</sub>&gt;P<sub>2</sub></div>\n        <div class=\"line\">C. W<sub>1</sub>&lt;W<sub>2</sub>　 P<sub>1</sub>&lt;P<sub>2</sub>　　D. W<sub>1</sub>&lt;W<sub>2</sub>　 P<sub>1</sub>&gt;P<sub>2</sub></div>\n      </section>\n\n      <section class=\"q9\">\n        <div class=\"line\">9. 放在倾角为α斜面上的物体，对斜面的压力与物体重力的关系是N=Gcosα，而摩擦力与压力</div>\n        <div class=\"line\">成正比。如图所示，将同一物体，分别用F<sub>1</sub>、F<sub>2</sub>的推力，沿斜面推动粗糙程度相同的AB、</div>\n        <div class=\"line\">AC两斜面从底端缓慢相同时间同时到达斜面顶端，推力F<sub>1</sub>、F<sub>2</sub>所做的功分别为W<sub>1</sub>、W<sub>2</sub>；</div>\n        <div class=\"line\">做功的功率分别为P<sub>1</sub>、P<sub>2</sub>。下列说法正确的是（　）</div>\n      </section>\n\n      <section class=\"q9-options\">\n        <div class=\"line\">A. W<sub>1</sub>=W<sub>2</sub>，P<sub>1</sub>=P<sub>2</sub>　 B. W<sub>1</sub>&gt;W<sub>2</sub>，P<sub>1</sub>&gt;P<sub>2</sub>　 C. W<sub>1</sub>&lt;W<sub>2</sub>，P<sub>1</sub>&lt;P<sub>2</sub>　 D. W<sub>1</sub>&gt;W<sub>2</sub>，P<sub>1</sub>&lt;P<sub>2</sub></div>\n      </section>\n\n      <section class=\"q10\">\n        <div class=\"line\">10. A、B两物体分别在水平拉力作用下都做匀速直线运动，如果B所受的拉力是A的3倍，</div>\n        <div class=\"line\">A的功率是B的几分之几？（　）</div>\n      </section>\n\n      <section class=\"q11\">\n        <div class=\"line\">11. 把一个重物以相同的速度沿AD、BD、CD三个光滑斜面匀速向顶端，如图所示，则推</div>\n        <div class=\"line\">力的功率是（　）</div>\n      </section>\n\n      <section class=\"q12\">\n        <div class=\"line\">12. 用如图所示滑轮组，将质量为48kg的物体以0.3m/s的速度匀速提升，绳子自由端的拉力</div>\n        <div class=\"line\">为200N；若用该滑轮组将重为570N的物体匀速提升2m时，不计绳重、绳子的伸长和滑轮内部</div>\n        <div class=\"line\">的摩擦（g=10N/kg），则（　）</div>\n      </section>\n    </div>\n\n    <figure class=\"placeholder incline-one\" aria-label=\"斜面示意图\">\n      <svg viewBox=\"0 0 115 67\" width=\"115\" height=\"67\">\n        <g fill=\"none\" stroke=\"#222\" stroke-width=\"1.2\">\n          <line x1=\"1\" y1=\"48\" x2=\"112\" y2=\"48\"/>\n          <line x1=\"19\" y1=\"48\" x2=\"72\" y2=\"1\"/>\n          <line x1=\"72\" y1=\"1\" x2=\"101\" y2=\"48\"/>\n          <line x1=\"13\" y1=\"48\" x2=\"25\" y2=\"48\"/>\n          <line x1=\"87\" y1=\"48\" x2=\"108\" y2=\"48\"/>\n        </g>\n        <g fill=\"#111\">\n          <rect x=\"15\" y=\"43\" width=\"9\" height=\"6\"/>\n          <rect x=\"91\" y=\"43\" width=\"9\" height=\"6\"/>\n        </g>\n        <g font-family=\"SimSun, serif\" font-size=\"8\" fill=\"#111\">\n          <text x=\"68\" y=\"8\">A</text>\n          <text x=\"13\" y=\"57\">B</text>\n          <text x=\"101\" y=\"57\">C</text>\n        </g>\n        <span class=\"caption\">[Diagram: inclined planes AB and AC]</span>\n      </svg>\n    </figure>\n\n    <figure class=\"placeholder incline-two\" aria-label=\"三个斜面示意图\">\n      <svg viewBox=\"0 0 116 68\" width=\"116\" height=\"68\">\n        <g fill=\"none\" stroke=\"#222\" stroke-width=\"1.1\">\n          <line x1=\"15\" y1=\"54\" x2=\"100\" y2=\"54\"/>\n          <line x1=\"15\" y1=\"54\" x2=\"69\" y2=\"1\"/>\n          <line x1=\"45\" y1=\"54\" x2=\"69\" y2=\"1\"/>\n          <line x1=\"100\" y1=\"54\" x2=\"69\" y2=\"1\"/>\n        </g>\n        <g font-family=\"SimSun, serif\" font-size=\"8\" fill=\"#111\">\n          <text x=\"12\" y=\"63\">A</text>\n          <text x=\"42\" y=\"63\">B</text>\n          <text x=\"98\" y=\"63\">C</text>\n          <text x=\"66\" y=\"8\">D</text>\n        </g>\n        <span class=\"caption\">[Diagram: three inclined planes AD, BD, CD]</span>\n      </svg>\n    </figure>\n\n    <div class=\"footer-title\">初中物理</div>\n    <div class=\"page-number\">第 2 页</div>\n  </main>\n</body>\n</html>"
