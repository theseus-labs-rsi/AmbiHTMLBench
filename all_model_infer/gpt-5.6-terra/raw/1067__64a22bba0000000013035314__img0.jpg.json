        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>习题 11.1</title>\n  <script>\n    window.MathJax = { tex: { inlineMath: [['$', '$'], ['\\\\(', '\\\\)']], displayMath: [['$$', '$$']] } };\n  </script>\n  <script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      min-height: 100vh;\n      background: #f5f4f2;\n      display: flex;\n      justify-content: center;\n      align-items: flex-start;\n      padding-top: 56px;\n      color: #77706b;\n      font-family: \"Songti SC\", \"SimSun\", serif;\n    }\n    .page {\n      position: relative;\n      width: 472px;\n      min-height: 670px;\n      padding: 0 13px 31px;\n      background:\n        radial-gradient(ellipse at 50% 22%, rgba(255,255,255,.75), transparent 45%),\n        linear-gradient(100deg, #f4eeee 0%, #fbf5f1 52%, #f1eeea 100%);\n      box-shadow: 0 0 8px rgba(100,80,70,.04);\n      font-size: 12px;\n      line-height: 1.55;\n    }\n    .header {\n      height: 26px;\n      margin: 0 -13px 19px;\n      padding: 3px 12px;\n      color: white;\n      font-size: 14px;\n      font-weight: bold;\n      letter-spacing: .8px;\n      background: linear-gradient(90deg, #b79651, #d6b976 58%, rgba(230,210,181,.25));\n    }\n    h2 {\n      margin: 0 0 6px;\n      font-size: 14px;\n      color: #625e5b;\n      font-weight: bold;\n    }\n    .q {\n      margin: 4px 0;\n      padding-left: 17px;\n      text-indent: -17px;\n      white-space: normal;\n    }\n    .sub {\n      margin-left: 17px;\n      padding-left: 19px;\n      text-indent: -19px;\n    }\n    .diagram {\n      display: block;\n      margin: 2px auto 2px;\n      overflow: visible;\n    }\n    .caption {\n      text-align: center;\n      font-size: 11px;\n      margin-top: -4px;\n      margin-bottom: 5px;\n      color