        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>诗歌思想感情笔记</title>\n  <script>\n    window.MathJax = { tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] } };\n  </script>\n  <script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      min-height: 100vh;\n      display: flex;\n      justify-content: center;\n      background: #292421;\n      font-family: \"KaiTi\", \"STKaiti\", \"FangSong\", serif;\n    }\n    .page {\n      position: relative;\n      width: 540px;\n      height: 720px;\n      overflow: hidden;\n      color: #38322d;\n      background:\n        repeating-linear-gradient(\n          to bottom,\n          #ddd9cd 0px,\n          #ddd9cd 22px,\n          #aaa79f 23px,\n          #d4d1c7 24px,\n          #ddd9cd 25px\n        );\n      transform: rotate(-1.1deg);\n      transform-origin: center top;\n      box-shadow: 0 0 8px rgba(0,0,0,.45);\n      padding-top: 1px;\n    }\n    .page::before {\n      content: \"\";\n      position: absolute;\n      top: 0;\n      bottom: 0;\n      left: 104px;\n      width: 1px;\n      background: rgba(176, 89, 75, .53);\n    }\n    .page::after {\n      content: \"\";\n      position: absolute;\n      top: 0;\n      right: 22px;\n      width: 1px;\n      height: 100%;\n      background: rgba(80,70,58,.15);\n    }\n    .notes {\n      position: relative;\n      z-index: 1;\n      width: 100%;\n      padding: 0 18px 0 13px;\n      font-size: 18px;\n      line-height: 25.2px;\n      letter-spacing: .3px;\n      text-shadow: .15px .15px 0 rgba(0,0,0,.18);\n    }\n    .line {\n      display: grid;\n      grid-template-columns: 94px 1fr;\n      min-height: 25.2px;\n      white-space: nowrap;\n    }\n    .title {\n      color: #9d5d4b;\n      text-align: right;\n      padding-right: 8px;\n      font-size: 17px;\n    }\n    .text {\n      padding-left: 2px;\n    }\n    .blank { color: transparent; }\n    .watermark {\n      position: absolute;\n      z-index: 2;\n      right: 14px;\n      bottom: 7px;\n      color: rgba(255,255,255,.83);\n      font-family: Arial, sans-serif;\n      font-size: 14px;\n      transform: rotate(1.1deg);\n      text-shadow: 0 1px 2px rgba(0,0,0,.28);\n    }\n    .watermark small {\n      display: block;\n      width: max-content;\n      margin-left: auto;\n      margin-bottom: 1px;\n      padding: 1px 4px;\n      font-size: 10px;\n      font-weight: bold;\n      color: #777;\n      background: rgba(255,255,255,.75);\n      border-radius: 3px;\n    }\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <section class=\"notes\">\n      <div class=\"line\"><span class=\"title\">《咏柳》</span><span class=\"text\">表达了作者对于春天的喜爱赞美之情</span></div>\n      <div class=\"line\"><span class=\"title\">《江南》</span><span class=\"text\">表达了诗人对江南的绿景热爱，也描绘出春意盎</span></div>\n      <div class=\"line\"><span class=\"title blank\">　</span><span class=\"text\">然，明丽风光的向往</span></div>\n      <div class=\"line\"><span class=\"title\">《画》</span><span class=\"text\">表达了诗人对画中美好事物的向往和对现实风景的忧伤</span></div>\n      <div class=\"line\"><span class=\"title\">《悯农》</span><span class=\"text\">表达了作者对于农夫辛勤劳作的赞美之情，同时也表达</span></div>\n      <div class=\"line\"><span class=\"title blank\">　</span><span class=\"text\">出对辛勤农夫[illegible]的同情。</span></div>\n      <div class=\"line\"><span class=\"title\">《江南春》</span><span class=\"text\">表达了作者对江南的天景之爱，反映了中国的蓬勃</span></div>\n      <div class=\"line\"><span class=\"title blank\">　</span><span class=\"text\">的喜爱之情。</span></div>\n      <div class=\"line\"><span class=\"title\">《风》</span><span class=\"text\">表达了诗人对大自然的热爱之情</span></div>\n      <div class=\"line\"><span class=\"title\">《春晓》</span><span class=\"text\">表达了诗人对春天的热爱和对春日的喜爱之情。抒发了诗人一</span></div>\n      <div class=\"line\"><span class=\"title blank\">　</span><span class=\"text\">种惋惜、无奈惜春光明思想感情。</span></div>\n      <div class=\"line\"><span class=\"title\">《赠汪伦》</span><span class=\"text\">表达了李白对汪伦的深厚友情。</span></div>\n      <div class=\"line\"><span class=\"title\">《静夜思》</span><span class=\"text\">表达了诗人在寂静的夜晚思念家乡的思想感情</span></div>\n      <div class=\"line\"><span class=\"title\">《寻隐者不遇》</span><span class=\"text\">表达了作者对隐者生活的向往之情，并和对他追求自</span></div>\n      <div class=\"line\"><span class=\"title blank\">　</span><span class=\"text\">由的精神的赞美之情。</span></div>\n      <div class=\"line\"><span class=\"title\">《池上》</span><span class=\"text\">表达了诗人对清净优美的夏天夏水相忘活动的</span></div>\n      <div class=\"line\"><span class=\"title blank\">　</span><span class=\"text\">劳动的喜爱，以及对田园生活的赞美之情。</span></div>\n      <div class=\"line\"><span class=\"title\">《小池》</span><span class=\"text\">表达了作者对大自然景物的喜爱之情</span></div>\n      <div class=\"line\"><span class=\"title\">《画鸡》</span><span class=\"text\">表达了作者对[illegible]鸡的赞美与喜爱之情。</span></div>\n      <div class=\"line\"><span class=\"title\">《梅花》</span><span class=\"text\">表达了作者坚强自我的气质，说明坚强背后的[illegible]</span></div>\n      <div class=\"line\"><span class=\"title blank\">　</span><span class=\"text\">所具有的伟大毅力。</span></div>\n      <div class=\"line\"><span class=\"title\">《小鹿斑比》</span><span class=\"text\">表达了作者对强[illegible]的喜爱之情，也表达了对于小孩</span></div>\n      <div class=\"line\"><span class=\"title blank\">　</span><span class=\"text\">六[illegible]成长的敬佩之情。</span></div>\n      <div class=\"line\"><span class=\"title\">《[illegible]》</span><span class=\"text\">表现出诗人积极明朗精神面貌，表达了诗人早[illegible]向上</span></div>\n      <div class=\"line\"><span class=\"title blank\">　</span><span class=\"text\">的世界精神。</span></div>\n    </section>\n    <div class=\"watermark\"><small>小红书</small>小红书号: 4130673107</div>\n  </main>\n</body>\n</html>"
