items: center;\n      justify-content: center;\n      text-align: center;\n      color: #333;\n      background:\n        linear-gradient(135deg, rgba(255,255,255,.65), rgba(240,240,240,.8)),\n        #e7e7e7;\n      border: 2px solid #777;\n      font-family: Georgia, serif;\n      font-size: 24px;\n    }\n    .model {\n      height: 420px;\n      position: relative;\n      background: #fff;\n    }\n    .model .node {\n      position: absolute;\n      border-radius: 50%;\n      width: 30px;\n      height: 30px;\n      border: 1px solid #111;\n    }\n    .model .blue { background: #0b33a3; border-radius: 2px; }\n    .model .gray { background: #aaa; }\n    .model .green { background: #00e51b; }\n    .model .red { background: #f22108; }\n    .line {\n      position: absolute;\n      height: 6px;\n      background: #07569c;\n      transform-origin: left center;\n    }\n    .l1 { width: 210px; left: 130px; top: 95px; transform: rotate(132deg); }\n    .l2 { width: 195px; left: 130px; top: 273px; transform: rotate(-47deg); }\n    .l3 { width: 170px; left: 295px; top: 245px; background: #498600; transform: rotate(170deg); }\n    .n1 { left: 350px; top: 44px; } .n2 { left: 178px; top: 192px; }\n    .n3 { left: 314px; top: 260px; } .n4 { left: 440px; top: 227px; }\n    .n5 { left: 92px; top: 309px; } .n6 { left: 70px; top: 378px; }\n    .n7 { left: 575px; top: 286px; } .n8 { left: 620px; top: 325px; }\n    .n9 { left: 670px; top: 372px; }\n    .model-label {\n      position: absolute;\n      font-family: Georgia, serif;\n      font-size: 20px;\n    }\n    .bottom-sections {\n      margin-top: 105px;\n      display: grid;\n      grid-template-columns: 1.05fr 1.25fr;\n      gap: 44px;\n    }\n    .section-box {\n      min-height: 1170px;\n      background: rgba(255,255,255,.72);\n    }\n    .section-box h2 {\n      margin: 0 0 45px;\n      padding: 18px 35px;\n      border-radius: 0 12px 12px 0;\n      background: #fff0cc;\n      text-align: center;\n      font-size: 39px;\n    }\n    .equivalence-text {\n      font-size: 27px;\n      line-height: 1.55;\n      padding: 0 34px;\n    }\n    .scenario-pair {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 22px;\n      padding: 25px 32px;\n    }\n    .traffic {\n      height: 250px;\n      background: #2a2726;\n      color: white;\n      border: 1px solid #777;\n      font-family: Georgia, serif;\n      font-size: 24px;\n    }\n    .caption {\n      font-family: Georgia, serif;\n      font-size: 18px;\n      text-align: center;\n      padding-top: 9px;\n    }\n    .classes {\n      margin: 50px 34px 0;\n      height: 460px;\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 8px;\n      padding: 15px;\n      border: 3px solid #2776bb;\n      border-radius: 22px;\n    }\n    .class-card {\n      border: 3px solid #2776bb;\n      border-radius: 18px;\n      padding: 12px;\n      position: relative;\n      background: #fff;\n      overflow: hidden;\n    }\n    .class-card:nth-child(3) { grid-column: 1 / 3; }\n    .class-card::before {\n      content: \"↖     ←     ↗\";\n      display: block;\n      color: #246d1a;\n      font-size: 37px;\n      text-align: center;\n    }\n    .class-card::after {\n      content: \"Class\";\n      position: absolute;\n      bottom: 8px;\n      width: calc(100% - 24px);\n      left: 12px;\n      text-align: center;\n      font-size: 19px;\n    }\n    .footer {\n      height: 410px;\n      margin-top: 120px;\n      background:\n        radial-gradient(circle at 20% 50%, rgba(255,255,255,.9) 0 2%, transparent 2.4%),\n        linear-gradient(174deg, #fffdf8 0 20%, #ffcd79 20.2% 27%, #ff7200 27.2% 100%);\n      position: relative;\n    }\n    .footer::before {\n      content: \"\";\n      position: absolute;\n      left: 0;\n      right: 0;\n      top: 105px;\n      height: 150px;\n      background: rgba(255,255,255,.82);\n      clip-path: polygon(0 0,100% 60%,100% 100%,0 44%);\n    }\n    @media (max-width: 900px) {\n      .banner { padding: 60px 7% 80px; min-height: 470px; }\n      .banner h1 { font-size: 54px; margin-top: 70px; }\n      .banner .cn-title { position: static; white-space: normal; margin-top: 15px; font-size: 22px; }\n      .year { font-size: 52px; }\n      .conference { font-size: 17px; }\n      .subtitle, .subtitle-cn { font-size: 23px; }\n      .content { padding: 55px 5%; }\n      .main-title { font-size: 37px; }\n      .authors, .affiliations { font-size: 20px; }\n      .section-tag { width: 100%; font-size: 28px; margin: 55px auto 35px; }\n      .abstract { font-size: 21px; }\n      .three-col, .flow-grid, .bottom-sections { grid-template-columns: 1fr; }\n      .semantic { padding-left: 0; font-size: 23px; }\n      .properties { font-size: 17px; }\n      .diagram { min-height: 600px; }\n      .bottom-sections { gap: 70px; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"page\">\n    <header class=\"banner\">\n      <div class=\"banner-top\">\n        <div class=\"conference\">中国科学技术研究所学术年会<br>暨计算机与国家重点实验室开放周</div>\n        <div class=\"year\">2023</div>\n      </div>\n      <h1>智能驾驶</h1>\n      <div class=\"cn-title\">自动驾驶软件研发与开源生态</div>\n      <div class=\"subtitle\">Simulation-Based Validation for<br>Autonomous Driving Systems</div>\n      <div class=\"subtitle-cn\">常杰</div>\n    </header>\n\n    <main class=\"content\">\n      <h1 class=\"main-title\">Simulation-Based Validation for<br>Autonomous Driving Systems</h1>\n      <div class=\"authors\">Changwen Li, Joseph Sifakis, Qiang Wang, Rongjie Yan, Jiang Zhu</div>\n      <div class=\"affiliations\">常杰会议： International Symposium on Software Testing and Analysis<br>联系方式： 姜杰 yj@ios.ac.cn　李昌文 liw@ios.ac.cn</div>\n\n      <section>\n        <div class=\"section-tag\">Abstract</div>\n        <p class=\"abstract\">\n          We investigate a rigorous simulation and testing-based validation method for autonomous driving systems that integrates an existing industrial simulator and a formally defined testing environment. The environment includes a scenario generator that drives the simulation process and a monitor that checks at runtime the observed behavior of the system against a set of system properties to be validated. The validation method consists in extracting from the simulator a semantic model of the simulated system including a metric graph, which is a mathematical model of the environment in which the vehicles of the system evolve. The monitor can verify properties formalized in a first-order linear temporal logic and provide diagnostics explaining their non-satisfaction. Instead of exploring the system behavior randomly as many simulators do, we propose a method to systematically generate sets of scenarios that cover potentially risky situations, especially for different types of junctions where specific traffic rules must be respected. We show that the systematic exploration of risky situations has uncovered many flaws in the real simulator that would have been very difficult to discover by a random exploration process.\n        </p>\n      </section>\n\n      <section>\n        <div class=\"section-tag\">The Validation Framework RVADS</div>\n        <div class=\"three-col\">\n          <div class=\"roles\">\n            <h2>Scenario Generator</h2>\n            <div class=\"role\"><div class=\"icon\">⚙</div><div>The Scenario Generator drives the simulation process. It generates scenarios as the coordinated sequences of actions executed by the agents in the Simulator.</div></div>\n            <h2>Simulator</h2>\n            <div class=\"role\"><div class=\"icon\">▣</div><div>The Simulator executes an ADS model obtained as the composition of the world model and the behavior model.</div></div>\n            <h2>Monitor</h2>\n            <div class=\"role\"><div class=\"icon\">⌕</div><div>The Monitor observes the system behavior as sequences of global states and applies a runtime verification method of the properties</div></div>\n          </div>\n\n          <div class=\"diagram\">\n            <div class=\"diagram-title\">RVADS</div>\n            <div class=\"box sg\">Scenario<br>Generator</div>\n            <div class=\"box sim\">Extended<br>Simulator</div>\n            <div class=\"box monitor\">Semantic<br>model</div>\n            <div class=\"box property\">Property<br>Specification</div>\n            <div class=\"arrow a1\"></div>\n            <div class=\"arrow a2\"></div>\n            <div class=\"arrow a3\"></div>\n          </div>\n\n          <div class=\"properties\">\n            <div class=\"rule\"></div>\n            <p><i>Properties for a stop junction $j$:</i></p>\n            <div class=\"rule\"></div>\n            <p><i>$p_1$:</i> If a vehicle is in the junction, then no other vehicle can be in the junction:</p>\n            <p>$$\\forall a.\\forall a'.\\Box[a@_j \\land a \\ne a' \\longrightarrow \\neg a'@_j]$$</p>\n            <p><i>$p_2$:</i> If a vehicle arrives at the same time as another vehicle, the vehicle on the right has the right-of-way:</p>\n            <p>$$\\forall j.en.\\forall j.en'.\\forall a.\\forall a'.\\Box[[a@_j.en \\land a'@_j.en' \\land a.wt=a'.wt' \\land j.en\\ right\\!-\\!of\\ j.en'] \\longrightarrow [\\neg a'@_j.en'\\ \\mathcal{U}\\ a@_j]]$$</p>\n            <p><i>$p_3$:</i> The vehicle that arrives first at the entrance will pass before other vehicles:</p>\n            <p>$$\\forall j.en.\\forall j.en'.\\forall a.\\forall a'.\\Box[[a@_j.en \\land a'@_j.en' \\land a.wt&lt;a'.wt'] \\longrightarrow [\\neg a@_j.en\\ \\mathcal{U}\\ a'@_j]]$$</p>\n            <div class=\"rule\"></div>\n            <p><i>Properties for a traffic light junction $j$:</i></p>\n            <div class=\"rule\"></div>\n            <p><i>$p_4$:</i> Any vehicle facing a red light must stop until the traffic light turns green, unless the vehicle is turning right.</p>\n            <p>$$\\forall j.en.\\forall a.\\forall lt.\\Box[[a@_j.en \\land lt@_j.en \\land lt.cl=red \\land \\neg take(a,j.en,right)] \\rightarrow [a@_j.en\\ \\mathcal{U}\\ lt.cl=green]]$$</p>\n            <p><i>$p_5$:</i> If a vehicle facing a red light is turning right, then the vehicle should wait until there is no vehicle on the left.</p>\n            <p><i>$p_6$:</i> If two vehicles arrive at the entrances of a junction opposite each other and the traffic lights are green, the vehicle turning left must give way to the other.</p>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"flow-section\">\n        <div class=\"section-tag\">Semantic Model</div>\n        <div class=\"flow-grid\">\n          <div>\n            <p class=\"semantic\">The system is modeled as a semantic model with a well-defined notion of system state as the distribution of vehicles and objects on a map with all their kinetic and time attributes.</p>\n            <div class=\"model placeholder\">\n              <span>[Diagram: semantic road graph with states, actions and colored transitions]</span>\n              <div class=\"line l1\"></div><div class=\"line l2\"></div><div class=\"line l3\"></div>\n              <div class=\"node gray n1\"></div><div class=\"node green n2\"></div><div class=\"node red n3\"></div>\n              <div class=\"node gray n4\"></div><div class=\"node gray n5\"></div><div class=\"node gray n6\"></div>\n              <div class=\"node blue n7\"></div><div class=\"node blue n8\"></div><div class=\"node gray n9\"></div>\n            </div>\n          </div>\n          <div class=\"properties\">\n            <p><i>Properties for a stop junction $j$:</i></p>\n            <div class=\"rule\"></div>\n            <p><i>$p_1$:</i> If a vehicle is in the junction, then no other vehicle can be in the junction:</p>\n            <p>$$\\forall a.\\forall a'.\\Box[a@_j \\land a \\ne a' \\rightarrow \\neg a'@_j]$$</p>\n            <p><i>$p_2$:</i> If a vehicle arrives at the same time as another vehicle, the vehicle on the right has the right-of-way:</p>\n            <p><i>$p_3$:</i> The vehicle that arrives first at the entrance will pass before other vehicles:</p>\n            <div class=\"rule\"></div>\n            <p><i>Properties for a traffic light junction $j$:</i></p>\n            <div class=\"rule\"></div>\n            <p><i>$p_4$:</i> Any vehicle facing a red light must stop until the traffic light turns green, unless the vehicle is turning right.</p>\n            <p><i>$p_5$:</i> If a vehicle facing a red light is turning right, then the vehicle should wait until there is no vehicle on the left.</p>\n            <p><i>$p_6$:</i> If two vehicles arrive at the entrances of a junction opposite each other and the traffic lights are green, the vehicle turning left must give way to the other.</p>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"bottom-sections\">\n        <div class=\"section-box\">\n          <h2>Scenario Generation</h2>\n          <p class=\"equivalence-text\">\n            We define structurally equivalent abstract scenarios by simply rotating the inputs and preserving the symbolic directions based on the assumption that the traffic rules do not particularize the inputs of the junction according to their positions.<br><br>\n            It is sufficient to apply one test case per equivalence class for the system that is assumed to be consistent. If equivalent test scenarios differ in the properties tested, it means that test process is inconsistent.\n          </p>\n          <div class=\"classes\">\n            <div class=\"class-card\"></div>\n            <div class=\"class-card\"></div>\n            <div class=\"class-card\"></div>\n          </div>\n          <div class=\"caption\">[Diagram: classes of structurally equivalent abstract scenarios]</div>\n        </div>\n\n        <div class=\"section-box\">\n          <h2>Examples of Property Violation</h2>\n          <div class=\"scenario-pair\">\n            <div><div class=\"placeholder traffic\">[Traffic-junction simulator image: blue vehicle $a'$ and yellow vehicle $a$]</div><div class=\"caption\">(a) Violation of $p_2$ (at time $t-1$)</div></div>\n            <div><div class=\"placeholder traffic\">[Traffic-junction simulator image: blue vehicle $a'$ and yellow vehicle $a$]</div><div class=\"caption\">(b) Violation of $p_2$ (at time $t$)</div></div>\n            <div><div class=\"placeholder traffic\">[Traffic-junction simulator image: vehicle $a'$ and vehicle $a$]</div><div class=\"caption\">(c) Violation of $p_5$ (at time $t-1$)</div></div>\n            <div><div class=\"placeholder traffic\">[Traffic-junction simulator image: vehicle $a'$ and vehicle $a$]</div><div class=\"caption\">(d) Violation of $p_5$ (at time $t$)</div></div>\n            <div><div class=\"placeholder traffic\">[Traffic-light junction simulator image: vehicle $a'$ and vehicle $a$]</div><div class=\"caption\">(e) Violation of $p_6$ (at time $t-1$)</div></div>\n            <div><div class=\"placeholder traffic\">[Traffic-light junction simulator image: vehicle $a'$ and vehicle $a$]</div><div class=\"caption\">(f) Violation of $p_6$ (at time $t$)</div></div>\n          </div>\n        </div>\n      </section>\n    </main>\n    <footer class=\"footer\"></footer>\n  </div>\n</body>\n</html>"
      },
