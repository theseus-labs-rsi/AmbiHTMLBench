        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Smart Autonomous Driving Systems</title>\n  <script>\n    window.MathJax = { tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] } };\n  </script>\n  <script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      color: #050505;\n      font-family: Arial, \"Microsoft YaHei\", \"Noto Sans SC\", sans-serif;\n      background: #fffdf8;\n    }\n    .page {\n      width: 100%;\n      overflow: hidden;\n      background:\n        linear-gradient(165deg, transparent 0 87%, #ffe2ac 87.2% 88%, transparent 88.2%),\n        #fffdf8;\n    }\n    .banner {\n      min-height: 690px;\n      color: #fff;\n      padding: 128px 9% 90px;\n      background:\n        radial-gradient(circle at 12% 22%, rgba(255,216,45,.5) 0 4%, transparent 4.2%),\n        radial-gradient(circle at 91% 31%, rgba(255,234,100,.55) 0 3%, transparent 3.2%),\n        linear-gradient(160deg, #ff5c00 0%, #ff7800 50%, #ffbe24 100%);\n      position: relative;\n    }\n    .banner::after {\n      content: \"\";\n      position: absolute;\n      inset: auto -5% 0;\n      height: 110px;\n      background: rgba(255,255,255,.72);\n      clip-path: polygon(0 65%, 42% 5%, 73% 70%, 100% 25%, 100% 100%, 0 100%);\n    }\n    .banner-top {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-start;\n      position: relative;\n      z-index: 1;\n    }\n    .conference {\n      font-size: 28px;\n      font-weight: 400;\n      text-shadow: 0 3px 3px rgba(0,0,0,.35);\n    }\n    .year {\n      font-size: 98px;\n      line-height: .8;\n      font-weight: 800;\n      letter-spacing: 3px;\n      text-shadow: 0 4px 4px rgba(0,0,0,.3);\n    }\n    .banner h1 {\n      margin: 105px 0 28px;\n      color: #002b70;\