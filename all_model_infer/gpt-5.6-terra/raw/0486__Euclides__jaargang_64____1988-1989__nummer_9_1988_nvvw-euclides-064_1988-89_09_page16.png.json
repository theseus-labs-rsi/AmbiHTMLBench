        "content": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Euclides Boekbeschouwing</title>\n  <script>\n    window.MathJax = { tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] } };\n  </script>\n  <script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      background: #fff;\n      color: #090909;\n      font-family: \"Times New Roman\", Times, serif;\n    }\n    .page {\n      width: 1430px;\n      min-height: 1885px;\n      margin: 0 auto;\n      padding: 92px 102px 105px;\n      position: relative;\n    }\n    .dot {\n      position: absolute;\n      top: 92px;\n      left: 104px;\n      width: 31px;\n      height: 31px;\n      border-radius: 50%;\n      background: #000;\n    }\n    .columns {\n      display: grid;\n      grid-template-columns: 590px 1fr;\n      gap: 67px;\n      padding-top: 86px;\n    }\n    .left, .right {\n      font-size: 28px;\n      line-height: 1.15;\n    }\n    .equation {\n      font-size: 27px;\n      margin: 0 0 35px 29px;\n      min-height: 60px;\n    }\n    p {\n      margin: 0 0 25px;\n    }\n    .intro {\n      width: 575px;\n      margin-bottom: 26px;\n    }\n    .placeholder {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      color: transparent;\n      border: 0;\n      overflow: hidden;\n    }\n    .portrait {\n      width: 589px;\n      height: 653px;\n      margin: 0 0 39px 2px;\n      background:\n        linear-gradient(115deg, #050505 0 26%, transparent 26% 100%),\n        linear-gradient(70deg, transparent 0 40%, #777 40% 46%, #101010 46% 100%),\n        radial-gradient(ellipse at 55% 29%, #d8d8d8 0 5%, #333 5.2% 11%, #080808 11.5% 100%);\n      background-color: #070707;\n    }\n    .caption {\n      font-size: 22px;\n      font-style: italic;\n      margi