se-table th:nth-child(2) { width: 37%; }\n    .disease-table td:nth-child(3),\n    .disease-table th:nth-child(3) { width: 36%; }\n    .disease-table td {\n      text-align: left;\n    }\n    .disease-table td:first-child {\n      color: #333;\n    }\n    .dehydration td:first-child,\n    .dehydration th:first-child { width: 24%; }\n    .dehydration td:nth-child(2),\n    .dehydration th:nth-child(2) { width: 25%; }\n    .dehydration td:nth-child(3),\n    .dehydration th:nth-child(3) { width: 25%; }\n    .dehydration td:nth-child(4),\n    .dehydration th:nth-child(4) { width: 26%; }\n    .note {\n      margin: 5px 0 23px 16px;\n      font-size: 11px;\n    }\n    .section-15 h2 {\n      margin-top: 0;\n      margin-bottom: 20px;\n    }\n    .section-16 h2 {\n      margin: 30px 0 22px;\n    }\n    .bottom-note {\n      margin: 7px 0 0 14px;\n      font-size: 11px;\n      white-space: nowrap;\n      overflow: hidden;\n    }\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <div class=\"top-rule\"></div>\n\n    <section>\n      <h2>14．鹅口疮与外阴阴道假丝酵母菌病</h2>\n      <h3>鹅口疮与外阴阴道假丝酵母菌病异同点</h3>\n      <table class=\"comparison\">\n        <tr>\n          <th>疾病</th>\n          <th>鹅口疮</th>\n          <th>外阴阴道假丝酵母菌病</th>\n        </tr>\n        <tr>\n          <td>致病菌</td>\n          <td>白色念珠菌</td>\n          <td>白色念珠菌</td>\n        </tr>\n        <tr>\n          <td>临床表现</td>\n          <td>口腔黏膜白色乳凝块</td>\n          <td>白带呈豆渣样</td>\n        </tr>\n        <tr>\n          <td>治疗</td>\n          <td>2% 碳酸氢钠</td>\n          <td>2%～4% 碳酸氢钠</td>\n        </tr>\n      </table>\n      <p class=\"note\">注：白色念珠菌属于真菌，又名假丝酵母菌</p>\n    </section>\n\n    <section class=\"section-15\">\n      <h2>15．胃溃疡和十二指肠溃疡</h2>\n      <h3>胃溃疡和十二指肠溃疡的特点</h3>\n      <table class=\"disease-table\">\n        <tr>\n          <th></th>\n          <th>胃溃疡（GU）</th>\n          <th>十二指肠溃疡（DU）</th>\n        </tr>\n        <tr>\n          <td>病变部位</td>\n          <td><strong>胃角和胃窦小弯</strong></td>\n          <td>球部前壁</td>\n        </tr>\n        <tr>\n          <td>发病机制</td>\n          <td>主要是保护因素减弱</td>\n          <td>主要是侵袭因素增强</td>\n        </tr>\n        <tr>\n          <td>疼痛部位</td>\n          <td>剑突下正中或偏左</td>\n          <td>上腹正中</td>\n        </tr>\n        <tr>\n          <td>疼痛性质</td>\n          <td>烧灼感或痉挛感</td>\n          <td>饥饿感或烧灼感</td>\n        </tr>\n        <tr>\n          <td>疼痛时间</td>\n          <td><strong>餐后痛</strong>即进食后 0.5～1 小时出现，至下餐前消失</td>\n          <td>空腹痛即进食后 2～3 小时出现，<br>下次进餐后缓解，可有夜间痛</td>\n        </tr>\n        <tr>\n          <td>疼痛节律</td>\n          <td>进食－疼痛－缓解</td>\n          <td>疼痛－进食－缓解</td>\n        </tr>\n      </table>\n    </section>\n\n    <section class=\"section-16\">\n      <h2>16．小儿腹泻脱水临床表现</h2>\n      <h3>不同程度脱水的临床表现</h3>\n      <table class=\"dehydration\">\n        <tr>\n          <th>脱水程度</th>\n          <th>轻度</th>\n          <th>中度</th>\n          <th>重度</th>\n        </tr>\n        <tr>\n          <td>体重减轻</td>\n          <td>&lt;5%</td>\n          <td>5%～10%</td>\n          <td>&gt;10%</td>\n        </tr>\n        <tr>\n          <td>皮肤、黏膜</td>\n          <td>弹性可，稍干燥</td>\n          <td>弹性差，干燥</td>\n          <td>弹性极差，极干燥</td>\n        </tr>\n        <tr>\n          <td>眼窝、前囟</td>\n          <td>稍凹陷</td>\n          <td>明显凹陷</td>\n          <td>深度凹陷</td>\n        </tr>\n        <tr>\n          <td>尿量</td>\n          <td>略少</td>\n          <td>明显减少</td>\n          <td>少尿/无尿</td>\n        </tr>\n        <tr>\n          <td>末梢循环</td>\n          <td>正常</td>\n          <td>四肢稍凉</td>\n          <td>四肢厥冷</td>\n        </tr>\n        <tr>\n          <td>精神状态</td>\n          <td>稍差</td>\n          <td>烦躁/萎靡</td>\n          <td>昏睡/昏迷</td>\n        </tr>\n      </table>\n      <p class=\"bottom-note\">注：轻度往往指有轻度脱水，重度往往指重度脱水</p>\n    </section>\n  </main>\n</body>\n</html>"
