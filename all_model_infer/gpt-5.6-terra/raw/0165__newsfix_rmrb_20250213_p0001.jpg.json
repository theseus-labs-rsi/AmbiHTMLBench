: 20px;\n      line-height: 1.18;\n      letter-spacing: 1px;\n      padding: 7px 3px;\n      border-right: 1px solid #999;\n      height: 282px;\n    }\n    .vertical-story small {\n      font-family: \"SimSun\", serif;\n      font-size: 8px;\n      letter-spacing: 0;\n    }\n    .science {\n      padding-right: 7px;\n      border-right: 1px solid #999;\n    }\n    .science .small-cols { font-size: 7px; line-height: 1.42; }\n    .science h3 {\n      font-family: \"Heiti SC\", sans-serif;\n      font-size: 15px;\n      margin: 1px 0 5px;\n      text-align: center;\n    }\n    .sidebar { font-size: 7px; line-height: 1.45; }\n    .sidebar .read {\n      color: #fff;\n      background: #c90020;\n      font: bold 14px \"Heiti SC\", sans-serif;\n      text-align: center;\n      width: 43px;\n      margin-left: auto;\n      padding: 2px;\n    }\n    .sidebox {\n      background: #f4f4f4;\n      padding: 7px 8px;\n      margin-bottom: 8px;\n      border: 1px solid #eee;\n    }\n    .sidebox h4 {\n      font-family: \"Heiti SC\", sans-serif;\n      font-size: 12px;\n      text-align: center;\n      margin: 0 0 6px;\n      font-weight: normal;\n    }\n    .bottom {\n      display: grid;\n      grid-template-columns: 1fr 165px;\n      gap: 7px;\n      padding-top: 8px;\n    }\n    .photo {\n      height: 177px;\n      border: 1px solid #aaa;\n      background:\n        linear-gradient(180deg, rgba(113,184,204,.45), rgba(255,255,255,.15) 47%, rgba(112,137,101,.36)),\n        linear-gradient(125deg, #b9d7df 0%, #eff7f6 45%, #afb48b 46%, #c3c0a3 100%);\n      position: relative;\n      overflow: hidden;\n    }\n    .photo:before {\n      content: \"[照片：多名身着制服、戴红色安全帽的工作人员站在户外，一架无人机飞行]\";\n      position: absolute;\n      color: rgba(20,20,20,.68);\n      font-size: 9px;\n      left: 8px;\n      bottom: 7px;\n      width: 300px;\n      line-height: 1.2;\n      background: rgba(255,255,255,.4);\n      padding: 2px;\n    }\n    .photo .drone {\n      position: absolute;\n      top: 54px;\n      left: 215px;\n      font-family: Arial, sans-serif;\n      font-size: 22px;\n      color: #333;\n    }\n    .bottom-side {\n      border: 1px solid #ddd;\n      padding: 6px;\n      font-size: 7px;\n      line-height: 1.45;\n    }\n    .bottom-side h4 {\n      font: bold 13px \"Heiti SC\", sans-serif;\n      color: #c90020;\n      margin: 0 0 5px;\n      text-align: center;\n    }\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <header class=\"masthead\">\n      <div class=\"logo\">\n        人民日报\n        <div class=\"english\">RENMIN RIBAO</div>\n        <div class=\"website\">人民网网址：http://www.people.com.cn</div>\n      </div>\n      <div class=\"datebox\">\n        <div>2025年2月</div>\n        <div class=\"day\">13</div>\n        <div class=\"weekday\">星期四</div>\n        <div>乙巳年正月十六</div>\n        <div class=\"price\">人民日报社出版<br>国内统一连续出版物号<br>CN 11—0065<br>代号1—1<br>第21777期<br>今日20版</div>\n      </div>\n      <section class=\"top-news\">\n        <h1>中央军委表彰全军备战标兵单位和标兵个人</h1>\n        <div class=\"briefs\">\n          <p>新华社北京2月12日电　中央军委日前印发通报，对10个全军备战标兵单位和20名全军备战标兵个人予以表彰。</p>\n          <p>通报指出，近年来，全军部队深入贯彻习近平强军思想，聚焦备战打仗，狠抓练兵备战，各项工作取得新进展。</p>\n          <p>通报要求，全军部队要以受表彰的单位和个人为榜样，凝聚强军兴军意志力量，全面提高新时代练兵备战水平。</p>\n        </div>\n      </section>\n    </header>\n\n    <div class=\"lead-grid\">\n      <section class=\"main-left\">\n        <h2>北京数字经济发展动能澎湃</h2>\n        <div class=\"red-bar\">坚定信心，打开改革发展新天地</div>\n        <div class=\"columns2\">\n          <p>新春，又出发。北京加快建设全球数字经济标杆城市，走进生产生活场景，数字技术不断释放新动能。</p>\n          <p>从人工智能到工业互联网，从数据要素到智慧城市，数字经济正在深刻改变生产方式和生活方式。</p>\n          <p>“以前靠经验，现在看数据。”企业负责人说，数字化转型让生产效率不断提升，市场响应更加敏捷。</p>\n          <p>近年来，北京持续优化数字经济发展环境，推动关键核心技术攻关，促进数字产业化和产业数字化。</p>\n          <p>面向未来，北京将进一步强化创新引领，培育新产业、新业态、新模式，为高质量发展注入澎湃动力。</p>\n          <p>[illegible]</p>\n        </div>\n      </section>\n\n      <section class=\"middle-col\">\n        <p>推动高质量发展，既要保持战略定力，也要增强发展信心。</p>\n        <p>新质生产力加快形成，科技创新成果不断涌现，改革开放持续深化。</p>\n        <p>在发展中保障和改善民生，更多群众共享发展成果。</p>\n        <p>各地干部群众表示，要坚定信心、迎难而上，努力完成全年经济社会发展目标任务。</p>\n        <p>[illegible]</p>\n      </section>\n\n      <section class=\"vertical-editorial\">\n        <h2>从百分之五增长看定力与信心</h2>\n        <div class=\"tag\">全<br>国<br>两<br>会<br>特<br>别<br>报<br>道</div>\n        <div class=\"editorial-text\">\n          <p>海内之变，全球最大的经济体之一，依然保持稳定增长，显示出中国经济的强大韧性和活力。</p>\n          <p>面对复杂严峻的外部环境，中国经济顶压前行、向新向优，交出了一份来之不易的成绩单。</p>\n          <p>百分之五左右的增长目标，体现了稳中求进、以进促稳的政策取向，也体现了对发展大势的深刻把握。</p>\n          <p>看定力，要看战略定力。集中精力办好自己的事，坚定不移推动高质量发展，才能赢得主动、赢得未来。</p>\n          <p>看信心，要看发展信心。超大规模市场、完整产业体系、丰富人才资源和持续创新能力，是中国经济的坚实支撑。</p>\n          <p>新的一年，改革发展稳定任务繁重。保持定力、增强信心，凝心聚力、真抓实干，必能不断开创中国式现代化建设新局面。</p>\n          <p>[illegible]</p>\n        </div>\n      </section>\n    </div>\n\n    <div class=\"section-row\">\n      <section class=\"research\">\n        <div class=\"red-bar\">高质量发展调研行</div>\n        <div class=\"small-cols\">\n          <p>新年伊始，走进基层调研，处处可见干事创业的热潮。广大干部群众牢记嘱托，扎实推动高质量发展。</p>\n          <p>一座座现代化厂房里，智能设备高速运转；一片片希望的田野上，春耕备耕有序展开。</p>\n          <h3>“千万工程”持续<br>重塑和美乡村</h3>\n          <p>浙江学习运用“千万工程”经验，因地制宜推进乡村全面振兴，村庄环境不断改善，产业发展更有活力。</p>\n          <p>从美丽乡村到美丽经济，从绿水青山到金山银山，一幅宜居宜业和美乡村新画卷正在徐徐展开。</p>\n          <p>[illegible]</p>\n        </div>\n      </section>\n\n      <section class=\"food\">\n        <div class=\"section-label\">读者点题·共同关注</div>\n        <h3>主食吃得少了，我们还需要这么多粮食吗？</h3>\n        <div class=\"small-cols\">\n          <p>春节餐桌上，主食消费出现新的变化。随着生活水平提高，居民膳食结构更加多元。</p>\n          <p>“主食吃得少”并不意味着粮食安全不重要。粮食安全始终是“国之大者”，必须把饭碗牢牢端在自己手中。</p>\n          <p>专家表示，要树立大食物观，统筹粮食生产、储备、流通和消费，推动节约减损，保障粮食供给。</p>\n          <p>我国粮食产量连续多年稳定在较高水平，粮食综合生产能力不断提升，市场供应充足。</p>\n          <p>[illegible]</p>\n        </div>\n      </section>\n    </div>\n\n    <div class=\"lower\">\n      <aside class=\"vertical-story\">\n        <small>重庆市</small>科创经纪人为技术和市场牵线搭桥\n      </aside>\n\n      <section class=\"science\">\n        <h3>把科技成果转化为现实生产力</h3>\n        <div class=\"small-cols\">\n          <p>西部地区重视发挥科技创新的支撑作用，推动高校、科研院所与企业深度合作，让更多创新成果走出实验室。</p>\n          <p>一名名科创经纪人穿梭在科研团队和市场主体之间，帮助技术找市场、帮助企业找成果。</p>\n          <p>从需求挖掘、技术评估到成果转让、企业孵化，专业服务让供需双方沟通更加顺畅。</p>\n          <p>“我们既要懂技术，也要懂产业。”相关负责人说，完善科技成果转化机制，才能让创新链和产业链更好衔接。</p>\n          <p>越来越多科技成果正在加速转化，成为推动地方经济高质量发展的新引擎。</p>\n          <p>[illegible]</p>\n        </div>\n      </section>\n\n      <aside class=\"sidebar\">\n        <div class=\"read\">导读</div>\n        <div class=\"sidebox\">\n          <h4>专访《聊斋》主创　解锁城市密码</h4>\n          <p>人民日报客户端　“戏曲”版</p>\n          <p>从传统文化中汲取创作灵感，以创新表达讲好中国故事。</p>\n        </div>\n        <div class=\"sidebox\">\n          <h4>从田间地头到海外市场</h4>\n          <p>好产品走向更广阔的市场，乡村产业发展活力更足。</p>\n          <p>[illegible]</p>\n        </div>\n      </aside>\n    </div>\n\n    <div class=\"bottom\">\n      <figure class=\"photo placeholder\">\n        <span class=\"drone\">⌁</span>\n      </figure>\n      <section class=\"bottom-side\">\n        <h4>绿色发展新画卷</h4>\n        <p>无人机巡检、数字化管理等技术手段不断应用，为安全生产和生态保护提供有力支撑。</p>\n        <p>一线建设者坚守岗位，奋力推进重点项目建设。</p>\n        <p>[illegible]</p>\n      </section>\n    </div>\n  </main>\n</body>\n</html>"
