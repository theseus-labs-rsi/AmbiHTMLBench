id-template-columns: 1.15fr 1.05fr .75fr;\n    align-items: center;\n    margin: 8px 95px 27px 94px;\n    font-size: 21px;\n    font-weight: bold;\n  }\n  .q13-options > div { white-space: nowrap; }\n  .q13-options .box { margin-right: 14px; margin-left: 0; }\n  .q14 .question {\n    padding-bottom: 7px;\n  }\n  .comp-grid {\n    margin-left: 88px;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    column-gap: 68px;\n    row-gap: 12px;\n    font-size: 20px;\n    font-weight: bold;\n    align-items: center;\n  }\n  .comp-grid div { white-space: nowrap; }\n  .comp-grid .box { margin: 0 14px 0 0; }\n  .line {\n    display: inline-block;\n    height: 22px;\n    border-bottom: 2px solid #111;\n    vertical-align: 2px;\n  }\n  .line.amount { width: 129px; }\n  .line.month { width: 122px; }\n  .line.commission { width: 102px; }\n  .line.percent { width: 169px; }\n  .line.fee { width: 144px; }\n  .line.other { width: 285px; }\n  .q14-bottom { margin-bottom: 35px; }\n  .q15 {\n    padding-top: 0;\n  }\n  .q15 .question {\n    padding-right: 27px;\n    line-height: 1.22;\n  }\n  .yes-no {\n    display: inline-flex;\n    align-items: center;\n    gap: 14px;\n    margin-left: 132px;\n    white-space: nowrap;\n  }\n  .q15-if {\n    margin: 25px 0 30px 48px;\n    font-weight: bold;\n  }\n  .contrib-head {\n    display: grid;\n    grid-template-columns: 145px 310px 455px 1fr;\n    margin-left: 44px;\n    font-weight: bold;\n    font-size: 20px;\n  }\n  .contrib-area {\n    height: 274px;\n  }\n  .execution-rule {\n    border-top: 3px solid #111;\n  }\n  .execution-title {\n    text-align: center;\n    font-weight: bold;\n    font-size: 25px;\n    margin-top: 11px;\n    letter-spacing: .5px;\n  }\n  .execution-text {\n    margin: 28px 7px 0;\n    font-weight: bold;\n    font-size: 19px;\n    line-height: 1.15;\n  }\n  .signature-row {\n    display: grid;\n    grid-template-columns: 1fr 1.22fr;\n    column-gap: 220px;\n    margin: 47px 84px 0;\n    font-family: Arial, sans-serif;\n    font-size: 19px;\n    font-weight: bold;\n    white-space: nowrap;\n  }\n  .sig-line {\n    border-bottom: 2px solid #111;\n    height: 29px;\n  }\n  .date-line { width: 330px; }\n  .name-line { width: 490px; }\n  .sig-caption-row {\n    display: grid;\n    grid-template-columns: 330px 490px;\n    column-gap: 220px;\n    margin: 0 84px;\n    font-size: 18px;\n    font-style: italic;\n    font-weight: bold;\n    text-align: center;\n  }\n  .signature-name {\n    position: relative;\n  }\n  .esigned {\n    position: absolute;\n    right: -80px;\n    top: 0;\n  }\n  .lower-space {\n    height: 297px;\n  }\n  .footnote-rule {\n    border-top: 3px solid #111;\n  }\n  .footnote {\n    font-size: 15px;\n    font-weight: bold;\n    line-height: 1.03;\n    margin-top: 2px;\n  }\n  .bottom-received {\n    margin: 75px 0 0 84px;\n    font-size: 29px;\n    white-space: nowrap;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <div class=\"received\">Received by NSD/FARA Registration Unit&nbsp;&nbsp; 10/28/2016&nbsp;&nbsp; 1:42:39 PM</div>\n\n  <div class=\"rule\"></div>\n\n  <section class=\"section q12\">\n    <div class=\"question\"><span class=\"number\">12.</span>Do any of the above described services include political activity as defined in Section 1(o) of the Act and in the footnote below?</div>\n    <div class=\"choice-row\">\n      <span>Yes<span class=\"box\"></span></span>\n      <span>No<span class=\"box checked\"></span></span>\n    </div>\n    <div class=\"ifyes\">If yes, describe separately and in detail such political activity.</div>\n    <div class=\"blank-q12\"></div>\n  </section>\n\n  <div class=\"section-rule\"></div>\n\n  <section class=\"section q13\">\n    <div class=\"question\"><span class=\"number\">13.</span>The services described in Items 11 and 12 are to be rendered on a</div>\n    <div class=\"q13-options\">\n      <div><span class=\"box checked\"></span>full time basis</div>\n      <div><span class=\"box\"></span>part time basis</div>\n      <div><span class=\"box\"></span>special basis</div>\n    </div>\n  </section>\n\n  <div class=\"section-rule\"></div>\n\n  <section class=\"section q14\">\n    <div class=\"question\"><span class=\"number\">14.</span>What compensation or thing of value have you received to date or will you receive for the above services?</div>\n    <div class=\"comp-grid\">\n      <div><span class=\"box checked\"></span>Salary:&nbsp; Amount $ <span class=\"line amount\">8,000</span>&nbsp; per <span class=\"line month\">month</span></div>\n      <div><span class=\"box\"></span>Commission at <span class=\"line commission\"></span>&nbsp;% of <span class=\"line percent\"></span></div>\n      <div><span class=\"box\"></span>Salary: Not based solely on services rendered to the foreign principal(s).</div>\n      <div></div>\n      <div class=\"q14-bottom\"><span class=\"box\"></span>Fee:&nbsp; Amount $ <span class=\"line fee\"></span></div>\n      <div class=\"q14-bottom\"><span class=\"box\"></span>Other thing of value <span class=\"line other\"></span></div>\n    </div>\n  </section>\n\n  <div class=\"section-rule\"></div>\n\n  <section class=\"section q15\">\n    <div class=\"question\">\n      <span class=\"number\">15.</span>During the period beginning 60 days prior to the date of your obligation to register to the time of filing this statement, did you<br>\n      <span style=\"margin-left:40px;\">make any contributions of money or other things of value from your own funds or possessions and on your own behalf in</span><br>\n      <span style=\"margin-left:40px;\">connection with any election to political office or in connection with any primary election, convention, or caucus held to select</span><br>\n      <span style=\"margin-left:40px;\">candidates for any political office?</span>\n      <span class=\"yes-no\">Yes<span class=\"box\"></span>&nbsp;&nbsp; No<span class=\"box checked\"></span></span>\n    </div>\n    <div class=\"q15-if\">If yes, furnish the following