talic;border:3px solid #fff9d7;\n      box-shadow:0 1px 1px #d28558;\n    }\n    .section:nth-child(2) .badge{background:#7582c9}\n    .section:nth-child(3) .badge{background:#efc72d}\n    .section:nth-child(4) .badge{background:#ec8a38}\n    .panel{\n      height:calc(100% - 43px);background:#fff;border:3px solid #f4a12d;border-radius:14px;\n      padding:5px 6px;overflow:hidden;\n    }\n    .intro{\n      min-height:34px;padding:3px 5px 3px;font-size:9px;font-weight:bold;line-height:1.35;\n      background:#f9f0c3;border-radius:4px;margin-bottom:3px;\n    }\n    .ribbon{\n      height:18px;margin:2px 0 3px -2px;width:170px;border-radius:0 10px 10px 0;\n      padding:2px 8px;color:#fff;font-size:10px;font-weight:bold;line-height:14px;\n      background:linear-gradient(90deg,#f18886,#f3a383);\n      position:relative;\n    }\n    .ribbon.green{background:linear-gradient(90deg,#65c9ad,#83d1a9)}\n    .ribbon.yellow{background:linear-gradient(90deg,#f2a631,#f3c64b)}\n    .ribbon:after{content:\"\";position:absolute;right:-14px;top:0;border-top:9px solid transparent;border-bottom:9px solid transparent;border-left:14px solid currentColor;opacity:.22}\n    .item{\n      position:relative;min-height:44px;padding:3px 43px 2px 5px;font-size:8.5px;line-height:1.28;\n      border-bottom:1px dashed #e6c76f;\n    }\n    .item:last-child{border-bottom:0}\n    .item b{font-size:9px;color:#555}\n    .pic{\n      position:absolute;right:1px;top:2px;width:39px;height:38px;border-radius:5px;\n      display:flex;align-items:center;justify-content:center;font-size:26px;\n      background:#d9f2f3;border:1px solid #b9e2df;\n    }\n    .two .panel{padding:5px 7px}\n    .two .item{min-height:44px;padding-right:41px;background:linear-gradient(90deg,#fff 0 69%,#eff8e9 69%);padding-top:4px}\n    .two .item b{font-size:10px}\n    .two .pic{background:transparent;border:0;font-size:29px}\n    .three .panel{padding:4px 6px}\n    .three .item{\n      min-height:38px;padding:4px 44px 3px 6px;background:#d9f1f5;border-bottom:2px solid white;\n      border-radius:2px;font-size:8.5px;line-height:1.25;\n    }\n    .three .pic{top:2px;background:#f8fbdf;font-size:25px}\n    .four .panel{padding:4px;display:grid;grid-template-columns:1fr 1fr 1fr;grid-template-rows:137px 126px;gap:2px}\n    .note{\n      position:relative;overflow:hidden;border-radius:3px;padding:5px 3px 3px 5px;\n      font-size:8px;line-height:1.25;background:#ddebfa;border:1px solid #fff;\n    }\n    .note:nth-child(2){background:#e9e3fa}\n    .note:nth-child(3){background:#f6f1d4}\n    .note:nth-child(4){background:#eee6fa}\n    .note:nth-child(5){background:#dff5e9}\n    .note:nth-child(6){background:#f7e6e5}\n    .note b{font-size:8px}\n    .symbol{position:absolute;bottom:5px;left:0;right:0;text-align:center;font-size:13px;font-weight:bold}\n    .symbol .no{color:#e23b47}.symbol .yes{color:#45a952}\n    .food{font-size:29px;display:block;text-align:center;line-height:33px}\n    .baby{font-size:29px;position:absolute;right:2px;bottom:2px}\n    .corner-star{position:absolute;font-size:21px;color:#7ec5c4;font-weight:bold;right:7px;top:99px}\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <div class=\"sheet\">\n      <header class=\"title\"><span>宝宝米粉添加指南</span></header>\n\n      <div class=\"grid\">\n        <section class=\"section one\">\n          <div class=\"section-heading\"><div class=\"badge\">1</div>不同阶段宝宝米粉选择</div>\n          <div class=\"panel\">\n            <div class=\"intro\">每个阶段宝宝对膳食的营养需求会存在差异，根据宝宝生长发育选择分阶段米粉，为宝宝提供更精准更科学的营养。</div>\n            <div class=\"ribbon\">第一阶段：宝宝刚吃辅食</div>\n            <div class=\"item\"><b>宝宝可以辅食营养餐——这时添加量少来。</b><br>1段米粉含铁高，粉质细腻好吸收。<br>适量用温开水调糊。</div>\n            <div class=\"ribbon green\">第二阶段：宝宝爱吃了</div>\n            <div class=\"item\"><b>宝宝刚开始——这时可添加2段米粉。</b><br>2段米粉在1段基础上含添加一些蔬果颗粒，用以启蒙咀嚼，避免宝宝偏食情况较。</div>\n            <div class=\"ribbon yellow\">第三阶段：宝宝能吃</div>\n            <div class=\"item\"><b>宝宝会能行——这时可添加3段米粉。</b><br>3段米粉相比较米粉添加了多种更大的果蔬颗粒，以锻炼咀嚼宝宝咀嚼力，并且多种食材搭配，口感丰富，更能激发宝宝的味蕾，让宝宝爱上吃。</div>\n            <div class=\"corner-star\">★</div>\n          </div>\n        </section>\n\n        <section class=\"section two\">\n          <div class=\"section-heading\"><div class=\"badge\">2</div>宝宝吃米粉的好处</div>\n          <div class=\"panel\">\n            <div class=\"item\"><b>1、补充乳类中不足的营养</b><br>添加米粉等辅食，可及时补充母乳中铁和维生素D的不足。<div class=\"pic\">🥣</div></div>\n            <div class=\"item\"><b>2、训练宝宝的吞咽能力</b><br>宝宝可以从吃糊状、细软的食品开始。逐步适应、接受成年人的固体食物。<div class=\"pic\">🥣</div></div>\n            <div class=\"item\"><b>3、为断奶做准备</b><br>辅食逐渐取代乳类，让宝宝逐渐由喝奶、吸吮变为用成年人方式咀嚼食物。<div class=\"pic\">👶</div></div>\n            <div class=\"item\"><b>4、开启宝宝智力</b><br>添加辅食可以给予宝宝多种刺激，进而达到促进智力的目的。<div class=\"pic\">🧠</div></div>\n            <div class=\"item\"><b>5、训练咀嚼能力</b><br>及时添加辅食有利于训练宝宝的咀嚼能力，有利于颌骨的发育和牙齿的萌出。<div class=\"pic\">👶</div></div>\n          </div>\n        </section>\n\n        <section class=\"section three\">\n          <div class=\"section-heading\"><div class=\"badge\">3</div>如何挑选宝宝米粉</div>\n          <div class=\"panel\">\n            <div class=\"item\"><b>1、选择品牌产品</b><br>建议选择大品牌、口碑好的产品，其质量相对有保证有保障。<div class=\"pic\">🧃</div></div>\n            <div class=\"item\"><b>2、查看产品标识</b><br>看一看正常商品应该有的标识是否齐全，宝宝产品特有的标志以及说明是否印在包装上。<div class=\"pic\">Ⓢ</div></div>\n            <div class=\"item\"><b>3、查看营养成分表</b><br>查看所含的具体营养成分及其含量是否在合理范围内。<div class=\"pic\">▦</div></div>\n            <div class=\"item\"><b>4、查看包装说明</b><br>查看外包装上是否有提示性说明，比如新奶粉购买时食品等。<div class=\"pic\">📦</div></div>\n            <div class=\"item\"><b>5、看颜色与气味</b><br>正常米粉白色、大小均匀，香味纯正，煮起来粉状有的气味，且无其他异味。<div class=\"pic\">🥣</div></div>\n            <div class=\"item\"><b>6、看组织形态和冲调性</b><br>其性状松散无结块，冲调后为凝糊状。<div class=\"pic\">🥣</div></div>\n          </div>\n        </section>\n\n        <section class=\"section four\">\n          <div class=\"section-heading\"><div class=\"badge\">4</div>宝宝吃米粉的注意事项</div>\n          <div class=\"panel\">\n            <div class=\"note\"><b>1、冲调米粉水温</b><br>不宜过高，用80度<br>的水冲调40-50度<br>左右再喂养宝宝。<span class=\"food\">🌡️</span><div class=\"symbol\"><span class=\"no\">▣ No</span><br><span class=\"yes\">▣ Yes</span></div></div>\n            <div class=\"note\"><b>2、喂米粉时需要<br>用勺子喂，不建<br>议使用奶瓶</b><span class=\"food\">🍼</span><div class=\"symbol\"><span class=\"no\">No</span><br><span class=\"yes\">Yes</span></div></div>\n            <div class=\"note\"><b>3、选择营养素含<br>量多的配方米粉，<br>不添加蔗糖和盐</b><span class=\"food\">🥣</span><div class=\"symbol\"><span class=\"no\">No</span><br><span class=\"yes\">Yes</span></div></div>\n            <div class=\"note\"><b>4、不要把米粉<br>当成正餐，以免<br>长久喂养影响生<br>长发育</b><span class=\"food\">🥣</span><div class=\"symbol\"><span class=\"no\">No</span></div></div>\n            <div class=\"note\"><b>5、刚刚添加米<br>先稀后逐渐增加<br>稠度</b><span class=\"food\">🥣</span><div class=\"symbol\"><span class=\"yes\">Yes</span></div></div>\n            <div class=\"note\"><b>6、首次添加1-2，<br>宝宝适应后慢慢<br>增加到3-4勺，<br>大约1-2次。</b><span class=\"food\">🥄</span><div class=\"symbol\"><span class=\"yes\">Yes</span></div></div>\n          </div>\n        </section>\n      </div>\n    </div>\n  </main>\n</body>\n</html>"
