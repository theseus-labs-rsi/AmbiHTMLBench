   <div class=\"unit\"><span class=\"pinyin\">guāng wǔ xīng</span><span class=\"hanzi\">光武兴，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">wéi dōng hàn</span><span class=\"hanzi\">为东汉。</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">sì bǎi nián</span><span class=\"hanzi\">四百年，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">zhōng yú xiàn</span><span class=\"hanzi\">终于献。</span></div>\n      </div>\n      <div class=\"line\">\n        <div class=\"unit\"><span class=\"pinyin\">wèi shǔ wú</span><span class=\"hanzi\">魏蜀吴，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">zhēng hàn dǐng</span><span class=\"hanzi\">争汉鼎。</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">hào sān guó</span><span class=\"hanzi\">号三国，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">qì liǎng jìn</span><span class=\"hanzi\">迄两晋。</span></div>\n      </div>\n      <div class=\"line\">\n        <div class=\"unit\"><span class=\"pinyin\">sòng qí jì</span><span class=\"hanzi\">宋齐继，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">liáng chén chéng</span><span class=\"hanzi\">梁陈承。</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">wéi nán cháo</span><span class=\"hanzi\">为南朝，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">dū jīn líng</span><span class=\"hanzi\">都金陵。</span></div>\n      </div>\n      <div class=\"line\">\n        <div class=\"unit\"><span class=\"pinyin\">běi yuán wèi</span><span class=\"hanzi\">北元魏，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">fēn dōng xī</span><span class=\"hanzi\">分东西。</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">yǔ wén zhōu</span><span class=\"hanzi\">宇文周，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">yǔ gāo qí</span><span class=\"hanzi\">与高齐。</span></div>\n      </div>\n      <div class=\"line\">\n        <div class=\"unit\"><span class=\"pinyin\">dài zhì suí</span><span class=\"hanzi\">迨至隋，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">yī tǔ yǔ</span><span class=\"hanzi\">一土宇。</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">bù zài chuán</span><span class=\"hanzi\">不再传，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">shī tǒng xù</span><span class=\"hanzi\">失统绪。</span></div>\n      </div>\n      <div class=\"line\">\n        <div class=\"unit\"><span class=\"pinyin\">táng gāo zǔ</span><span class=\"hanzi\">唐高祖，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">qǐ yì shī</span><span class=\"hanzi\">起义师。</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">chú suí luàn</span><span class=\"hanzi\">除隋乱，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">chuàng guó jī</span><span class=\"hanzi\">创国基。</span></div>\n      </div>\n      <div class=\"line\">\n        <div class=\"unit\"><span class=\"pinyin\">èr shí chuán</span><span class=\"hanzi\">二十传，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">sān bǎi zǎi</span><span class=\"hanzi\">三百载。</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">liáng miè zhī</span><span class=\"hanzi\">梁灭之，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">guó nǎi gǎi</span><span class=\"hanzi\">国乃改。</span></div>\n      </div>\n      <div class=\"line\">\n        <div class=\"unit\"><span class=\"pinyin\">liáng táng jìn</span><span class=\"hanzi\">梁唐晋，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">jí hàn zhōu</span><span class=\"hanzi\">及汉周。</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">chēng wǔ dài</span><span class=\"hanzi\">称五代，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">jiē yǒu yóu</span><span class=\"hanzi\">皆有由。</span></div>\n      </div>\n      <div class=\"line\">\n        <div class=\"unit\"><span class=\"pinyin\">yán sòng xīng</span><span class=\"hanzi\">炎宋兴，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">shòu zhōu shàn</span><span class=\"hanzi\">受周禅。</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">shí bā chuán</span><span class=\"hanzi\">十八传，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">nán běi hùn</span><span class=\"hanzi\">南北混。</span></div>\n      </div>\n      <div class=\"line\">\n        <div class=\"unit\"><span class=\"pinyin\">liáo yǔ jīn</span><span class=\"hanzi\">辽与金，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">dì hào fēn</span><span class=\"hanzi\">帝号纷。</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">dài miè liáo</span><span class=\"hanzi\">迨灭辽，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">sòng yóu cún</span><span class=\"hanzi\">宋犹存。</span></div>\n      </div>\n      <div class=\"line\">\n        <div class=\"unit\"><span class=\"pinyin\">zhì yuán xīng</span><span class=\"hanzi\">至元兴，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">jīn xù xiē</span><span class=\"hanzi\">金绪歇。</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">yǒu sòng shì</span><span class=\"hanzi\">有宋世，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">yī tóng miè</span><span class=\"hanzi\">一同灭。</span></div>\n      </div>\n      <div class=\"line\">\n        <div class=\"unit\"><span class=\"pinyin\">bìng zhōng guó</span><span class=\"hanzi\">并中国，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">jiān róng dí</span><span class=\"hanzi\">兼戎狄。</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">jiǔ shí nián</span><span class=\"hanzi\">九十年，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">guó zuò fèi</span><span class=\"hanzi\">国祚废。</span></div>\n      </div>\n      <div class=\"line\">\n        <div class=\"unit\"><span class=\"pinyin\">míng tài zǔ</span><span class=\"hanzi\">明太祖，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">jiǔ qīn shī</span><span class=\"hanzi\">久亲师。</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">chuán jiàn wén</span><span class=\"hanzi\">传建文，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">fāng sì sì</span><span class=\"hanzi\">方四祀。</span></div>\n      </div>\n      <div class=\"line\">\n        <div class=\"unit\"><span class=\"pinyin\">qiān běi jīng</span><span class=\"hanzi\">迁北京，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">yǒng lè sì</span><span class=\"hanzi\">永乐嗣。</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">dài chóng zhēn</span><span class=\"hanzi\">迨崇祯，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">méi shān shì</span><span class=\"hanzi\">煤山逝。</span></div>\n      </div>\n      <div class=\"line\">\n        <div class=\"unit\"><span class=\"pinyin\">qīng tài zǔ</span><span class=\"hanzi\">清太祖，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">shàn jǐng mìng</span><span class=\"hanzi\">膺景命。</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">jìng sì fāng</span><span class=\"hanzi\">靖四方，</span></div>\n        <div class=\"unit\"><span class=\"pinyin\">kè dà dìng</span><span class=\"hanzi\">克大定。</span></div>\n      </div>\n    </section>\n\n    <aside class=\"title-strip\" aria-label=\"篇章标题\">\n      <div class=\"title\">三字经</div>\n      <div class=\"subtitle\">国学君子分　幸福家国兴</div>\n      <div class=\"chapter\">三</div>\n    </aside>\n  </main>\n</body>\n</html>"
