        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>光明日报 - 2025年2月28日</title>\n  <script>\n    window.MathJax = { tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] } };\n  </script>\n  <script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      background: #fff;\n      color: #111;\n      font-family: \"Songti SC\", \"SimSun\", serif;\n    }\n    .page {\n      width: 1260px;\n      min-height: 1780px;\n      margin: 0 auto;\n      padding: 26px 21px 20px;\n      background: #fff;\n    }\n    .masthead {\n      height: 287px;\n      border-bottom: 1px solid #777;\n      position: relative;\n      display: grid;\n      grid-template-columns: 590px 1fr;\n      column-gap: 26px;\n    }\n    .paper-name {\n      height: 250px;\n      position: relative;\n      overflow: hidden;\n    }\n    .calligraphy {\n      color: #d7092f;\n      font-family: \"KaiTi\", \"STKaiti\", cursive;\n      font-size: 124px;\n      font-weight: 700;\n      line-height: .88;\n      letter-spacing: 20px;\n      white-space: nowrap;\n      transform: skew(-8deg);\n      margin: 18px 0 0 34px;\n    }\n    .roman {\n      position: absolute;\n      bottom: 12px;\n      left: 162px;\n      font-family: Georgia, serif;\n      font-size: 22px;\n      letter-spacing: 9px;\n    }\n    .issue-bar {\n      height: 25px;\n      background: #0872a4;\n      color: #fff;\n      text-align: center;\n      font-family: Arial, sans-serif;\n      font-size: 15px;\n      font-weight: bold;\n      line-height: 25px;\n      word-spacing: 15px;\n    }\n    .publisher {\n      font-family: Arial, \"Microsoft YaHei\", sans-serif;\n      font-size: 12px;\n      font-weight: bold;\n      padding: 11px 0 0 18px;\n      letter-spacing: .3px;\n    }\n    .mast-story h1 {\n   