        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>2024·美的集团ESG报告</title>\n<script src=\"https://polyfill.io/v3/polyfill.min.js?features=es6\"></script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  *{box-sizing:border-box}\n  body{margin:0;background:#fff;font-family:\"Microsoft YaHei\",\"Noto Sans SC\",Arial,sans-serif;color:#555}\n  .page{width:1132px;height:768px;margin:auto;position:relative;padding:37px 53px 25px}\n  .top{height:76px;position:relative}\n  .report{position:absolute;top:0;left:0;font-size:9px;color:#9a9a9a}\n  .nav{position:absolute;right:2px;top:0;font-size:8px;color:#979797;white-space:nowrap}\n  .nav span{margin-left:17px}\n  .nav .active{color:#00aaa6;border:1px solid #00aaa6;border-radius:8px;padding:1px 5px;margin-left:17px}\n  .mountains{position:absolute;left:0;top:18px;width:108px;height:57px}\n  .mountains:before,.mountains:after{content:\"\";position:absolute;bottom:0}\n  .mountains:before{left:3px;border-left:33px solid transparent;border-right:25px solid transparent;border-bottom:54px solid #4bcfc9}\n  .mountains:after{left:26px;border-left:43px solid transparent;border-right:44px solid transparent;border-bottom:31px solid #01a9a6;filter:opacity(.88)}\n  .peak{position:absolute;border-left:6px solid transparent;border-right:6px solid transparent;border-bottom:18px solid #04aaa5;bottom:18px}\n  .p1{left:51px}.p2{left:71px;bottom:26px}.p3{left:88px;bottom:14px}\n  .table{width:1026px}\n  .grid{display:grid;grid-template-columns:93px 117px 230px 250px 94px 99px;column-gap:10px}\n  .header{height:22px;align-items:start}\n  .header div{height:21px;background:#00aaa6;color:#fff;border-radius:13px;text-align:center;font-size:10px;font-weight:bold;padding-top:4px}\n  .cell{border:1.2px solid #00aaa6;border-radius:6px;background:#fff;position:relative;font-size:9px;line-height:1.36}\n  .type{background:linear-gradient(90deg,#e6fbfa,#c9f2ef);display:flex;flex-direction:column;align-items:center;justify-content:center;color:#6d8888;font-size:10px}\n  .desc{display:flex;justify-content:center;align-items:center;text-align:center;padding:8px;color:#606060}\n  .content{padding:8px 9px 5px 12px}\n  .content ul{padding:0;margin:0;list-style:none}\n  .content li{position:relative;padding-left:9px;margin:0 0 4px}\n  .content li:before{content:\"•\";position:absolute;left:0}\n  .strategy{padding:8px 10px 4px 12px}\n  .period,.finance{display:flex;flex-direction:column;justify-content:center;align-items:center;font-size:9px;color:#555}\n  .icon{width:25px;height:27px;margin-bottom:2px;position:relative}\n  .shield{border:1.8px solid #e65b38;border-radius:13px 13px 10px 10px;width:20px;height:23px;margin-top:2px;clip-path:polygon(50% 0,94% 16%,88% 67%,50% 100%,12% 67%,6% 16%)}\n  .shield:after{content:\"♧\";position:absolute;font-size:15px;left:3px;top:1px;color:#e65b38}\n  .green{border-color:#18bd78}.green:after{color:#18bd78}\n  .blue{border-color:#00b8c1}.blue:after{color:#00b8c1}\n  .gear{font-size:29px;line-height:25px;font-weight:bold;color:#00aaa6}\n  .gear.red{color:#d94e2f}\n  .physical{height:220px}\n  .physical .type,.transition .type{grid-row:1 / span 3}\n  .physical .desc,.physical .impact,.physical .strategy,.physical .period,.physical .finance{height:73px}\n  .physical .cell:not(.type){border-radius:0}\n  .physical .desc.first,.physical .impact.first,.physical .strategy.first,.physical .period.first,.physical .finance.first{border-radius:6px 6px 0 0}\n  .physical .desc.last,.physical .impact.last,.physical .strategy.last,.physical .period.last,.physical .finance.last{border-radius:0 0 6px 6px}\n  .transition{height:272px;margin-top:0}\n  .transition .desc,.transition .impact,.transition .strategy,.transition .period,.transition .finance{height:91px}\n  .transition .cell:not(.type){border-radius:0}\n  .transition .desc.first,.transition .impact.first,.transition .strategy.first,.transition .period.first,.transition .finance.first{border-radius:6px 6px 0 0}\n  .transition .desc.last,.transition .impact.last,.transition .strategy.last,.transition .period.last,.transition .finance.last{border-radius:0 0 6px 6px}\n  .opportunity{margin-top:10px;height:90px}\n  .opportunity .cell{height:90px}\n  .opportunity .type{font-size:10px}\n  .footer{position:absolute;bottom:25px;left:54px;font-size:9px;color:#777}\n  .footer-right{position:absolute;bottom:25px;right:54px;font-size:9px;color:#777}\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <div class=\"top\">\n    <div class=\"report\">2024·美的集团ESG报告</div>\n    <div class=\"nav\"><span>关于本报告</span><span>走进美的</span><span>可持续发展治理</span><span class=\"active\">守护蓝色星球</span><span>构建和谐社区</span><span>践行科技尽善</span><span>共创繁荣生态</span><span>附录</span></div>\n    <div class=\"mountains\"><i class=\"peak p1\"></i><i class=\"peak p2\"></i><i class=\"peak p3\"></i></div>\n  </div>\n\n  <div class=\"table\">\n    <div class=\"grid header\">\n      <div>风险类型</div><div>风险描述</div><div>风险影响</div><div>应对策略</div><div>影响周期</div><div>财务冲击</div>\n    </div>\n\n    <div class=\"grid physical\">\n      <div class=\"cell type\">物理风险</div>\n      <div class=\"cell desc first\">洪灾程度增加</div>\n      <div class=\"cell impact content first\"><ul>\n        <li>严重洪灾可能对排水能力较差的仓储区造成成品及生产设备损毁，进而导致运营成本增加与设备加速折旧</li>\n        <li>交通中断或拥堵，无法保证员工的通勤时间，可能导致雇员生产力下降</li>\n      </ul></div>\n      <div class=\"cell strategy first\"><ul class=\"content\">\n        <li>提升各基地应对50年一遇洪灾的应对能力，并购置相关保险</li>\n        <li>进一步完善员工宿舍建设，缩短员工通勤路程</li>\n      </ul></div>\n      <div class=\"cell period first\"><div class=\"icon shield\"></div>短中期</div>\n      <div class=\"cell finance first\"><div class=\"gear\">⚙</div>较小</div>\n\n      <div class=\"cell desc\">极端高温</div>\n      <div class=\"cell impact content\"><ul>\n        <li>极端高温将催化户外工作的工作效率增加，增加员工健康安全风险</li>\n        <li>为办公、生产等区域员工提供舒适的工作环境所需的制冷能源消耗将增加，进一步加大了制冷相关的碳排放，并有可能增加运营成本</li>\n      </ul></div>\n      <div class=\"cell strategy\"><ul class=\"content\">\n        <li>完善户外作业管理要求，通过对冷设备升级和智能化控制手段，开展制冷相关节能降碳项目</li>\n        <li>通过绿色建筑建设，采用围护结构改造、自然通风等有效措施提升办公区域的舒适度</li>\n      </ul></div>\n      <div class=\"cell period\"><div class=\"icon shield green\"></div>长期</div>\n      <div class=\"cell finance\"><div class=\"gear\">⚙</div>较小</div>\n\n      <div class=\"cell desc last\">台风等级增加</div>\n      <div class=\"cell impact content last\"><ul>\n        <li>对部分海运物料供应、成品运输的时效性可能造成影响，进一步增加运营成本</li>\n      </ul></div>\n      <div class=\"cell strategy last\"><ul class=\"content\">\n        <li>通过制造能力全球布局，制造基地安全库存、供方布局及唯一性排查，完善基地相关制造能力提升及关键供应链等级韧性</li>\n      </ul></div>\n      <div class=\"cell period last\"><div class=\"icon shield\"></div>短中期</div>\n      <div class=\"cell finance last\"><div class=\"gear\">⚙</div>较小</div>\n    </div>\n\n    <div class=\"grid transition\">\n      <div class=\"cell type\">转型风险</div>\n      <div class=\"cell desc first\">对产品能效、涂装、材料等差异性管控要求的提升</div>\n      <div class=\"cell impact content first\"><ul>\n        <li>更高级能效市场准入及消费者偏好将影响研发和市场投入方向</li>\n        <li>《材料和涂装管控》对碳中聚氨酯和规模管制的要求及欧盟、美洲等地区对不同环保型涂装产品及二氧化碳压缩机产品入口标准在年处调整将对现有市场的投入方向</li>\n        <li>在碳经济体系背景下环保型材料尤其是再生材料产品的比例起可能增加产品材料来源的不确定性进一步提升材料的潜在成本</li>\n      </ul></div>\n      <div class=\"cell strategy first\"><ul class=\"content\">\n        <li>通过绿色设计标准牵引加快更高能效、水效等产品的技术领先性</li>\n        <li>加快环保型涂装产品研发、制造、市场的投入，保持行业市场领先</li>\n        <li>联合巴斯夫来料供方、废旧家电回收商、家电拆解工厂、再生资源生产商、塑料改性生产商等上下游价值链推动内外双循环制造模式，加快绿色低碳材料研究和应用，并在合适的区域建设自有拆解工厂，提升再生资源的生产能力</li>\n      </ul></div>\n      <div class=\"cell period first\"><div class=\"icon shield blue\"></div>中长期</div>\n      <div class=\"cell finance first\"><div class=\"gear\">⚙</div>一般</div>\n\n      <div class=\"cell desc\">对新能源、储能、新能源汽车产业链等客户企业的投入和转型</div>\n      <div class=\"cell impact content\"><ul>\n        <li>在应对和适应气候背景下，以合格新能源、科电电子、汽车部件等优秀的新业务板块有巨大的市场潜力与竞争压力</li>\n      </ul></div>\n      <div class=\"cell strategy\"><ul class=\"content\">\n        <li>通过绿色工业等布局进一步提升相关业务综合服务能力</li>\n        <li>通过研发和技术创新抓住突破方向及市场机遇</li>\n      </ul></div>\n      <div class=\"cell period\"><div class=\"icon shield blue\"></div>中长期</div>\n      <div class=\"cell finance\"><div class=\"gear\">⚙</div>一般</div>\n\n      <div class=\"cell desc last\">绿色能源成本的不确定性</div>\n      <div class=\"cell impact content last\"><ul>\n        <li>当前可负担的绿色电力资源紧缺，市场需求上涨，长期以往可能导致绿色电力在市场化机制下绿电环境溢价进一步提升，增加制造工厂能源成本</li>\n      </ul></div>\n      <div class=\"cell strategy last\"><ul class=\"content\">\n        <li>加强新能源进程和绿色工艺突破，能源脱碳和节能降碳安排推进</li>\n        <li>提升自制件相关供应商开发生产、供应交付能力，进一步降低价值链碳排放，降低重点工厂的自制件生产成本</li>\n      </ul></div>\n      <div class=\"cell period last\"><div class=\"icon shield blue\"></div>中长期</div>\n      <div class=\"cell finance last\"><div class=\"gear\">⚙</div>较小</div>\n    </div>\n\n    <div class=\"grid header\" style=\"margin-top:10px\">\n      <div>机遇类型</div><div>机遇描述</div><div>机遇影响</div><div>应对策略</div><div>影响周期</div><div>财务冲击</div>\n    </div>\n    <div class=\"grid opportunity\">\n      <div class=\"cell type\">市场机遇</div>\n      <div class=\"cell desc\">绿色产品和服务带来的业务机会</div>\n      <div class=\"cell impact content\"><ul><li>持续开发和/或扩展低碳产品和服务，获得更多市场份额及消费者青睐，同时在资本市场获得更多投资机会，带来更多收入增长</li></ul></div>\n      <div class=\"cell strategy\"><ul class=\"content\"><li>持续推动美的绿色服务，为本集团内部和客户提供绿色解决方案</li><li>坚持“绿色战略”引领，推进绿色设计，布局绿色低碳技术、研发绿色产品，满足市场与消费者对绿色产品的期待</li></ul></div>\n      <div class=\"cell period\"><div class=\"icon shield\"></div>短中期</div>\n      <div class=\"cell finance\"><div class=\"gear red\">⚙</div>较大</div>\n    </div>\n  </div>\n  <div class=\"footer\">23</div>\n  <div class=\"footer-right\">24</div>\n</div>\n</body>\n</html>",
