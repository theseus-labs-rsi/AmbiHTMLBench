        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>光明日报 2025年1月18日</title>\n  <script>\n    window.MathJax = { tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] } };\n  </script>\n  <script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      background: #f3f1ed;\n      color: #151515;\n      font-family: \"Songti SC\", \"SimSun\", serif;\n    }\n    .page {\n      width: 1262px;\n      min-height: 1792px;\n      margin: 0 auto;\n      padding: 26px 22px 20px;\n      background: #fff;\n    }\n    .top {\n      display: grid;\n      grid-template-columns: 600px 1fr;\n      column-gap: 24px;\n      border-bottom: 1px solid #8b8b8b;\n      padding-bottom: 8px;\n    }\n    .brand {\n      min-height: 258px;\n      position: relative;\n    }\n    .masthead {\n      color: #cf002b;\n      font-family: \"STKaiti\", \"KaiTi\", cursive;\n      font-size: 124px;\n      font-weight: bold;\n      line-height: .92;\n      transform: scaleY(1.12);\n      white-space: nowrap;\n      margin: 16px 0 0 20px;\n      letter-spacing: 16px;\n    }\n    .roman {\n      margin: 38px 0 8px 160px;\n      font-family: Arial, sans-serif;\n      font-size: 21px;\n      letter-spacing: 8px;\n    }\n    .datebar {\n      width: 572px;\n      height: 24px;\n      margin-left: 10px;\n      background: #08729d;\n      color: #fff;\n      text-align: center;\n      font-family: Arial, sans-serif;\n      font-size: 15px;\n      font-weight: bold;\n      line-height: 24px;\n      word-spacing: 10px;\n    }\n    .issue {\n      padding-top: 7px;\n      font-family: Arial, \"SimSun\", sans-serif;\n      font-size: 12px;\n      font-weight: bold;\n      text-align: center;\n      white-space: nowrap;\n    }\n    .lead h1 {\n      margin: 8px 0 10px;\n      font-family: \"SimHei\", sans-serif;\n      font-size: 44px;\n      line-height: 1.15;\n      white-space: nowrap;\n    }\n    .top-copy {\n      columns: 3;\n      column-gap: 14px;\n      height: 182px;\n      overflow: hidden;\n      font-size: 12px;\n      line-height: 1.38;\n      text-align: justify;\n    }\n    .top-copy p { margin: 0 0 7px; text-indent: 2em; }\n    .main {\n      display: grid;\n      grid-template-columns: 610px 1fr;\n      column-gap: 16px;\n      margin-top: 14px;\n    }\n    .left {\n      border-right: 1px solid #aaa;\n      padding-right: 15px;\n    }\n    .education-logo {\n      margin: 2px auto 10px;\n      width: 360px;\n      height: 82px;\n      color: #fff;\n      background: linear-gradient(100deg, transparent 0 14%, #c54743 14% 92%, transparent 92%);\n      font-family: \"SimHei\", sans-serif;\n      font-size: 30px;\n      font-weight: bold;\n      text-align: center;\n      line-height: 82px;\n    }\n    .feature {\n      display: grid;\n      grid-template-columns: 145px 1fr;\n      gap: 12px;\n      border-bottom: 1px solid #999;\n      padding-bottom: 13px;\n    }\n    .vertical-title {\n      display: flex;\n      align-items: center;\n      font-family: \"SimHei\", sans-serif;\n      font-size: 39px;\n      line-height: 1.18;\n      font-weight: bold;\n      writing-mode: vertical-rl;\n      text-orientation: upright;\n      letter-spacing: 5px;\n      padding-left: 20px;\n    }\n    .byline-vertical {\n      writing-mode: vertical-rl;\n      font-size: 13px;\n      line-height: 1.5;\n      padding: 70px 0 0 6px;\n    }\n    .feature-body {\n      display: grid;\n      grid-template-columns: 1fr 18px;\n      gap: 8px;\n    }\n    .text-columns {\n      columns: 2;\n      column-gap: 13px;\n      font-size: 12px;\n      line-height: 1.52;\n      text-align: justify;\n    }\n    .text-columns p, .article p { margin: 0 0 6px; text-indent: 2em; }\n    .portrait {\n      width: 136px;\n      margin: 8px 7px 6px 0;\n      float