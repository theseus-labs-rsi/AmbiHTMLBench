ria-label=\"洋葱学院\">\n      <span class=\"brand-mark\"><i></i><b></b></span>\n      <span class=\"brand-text\">洋葱学院<span class=\"brand-sub\">YANGCONG XUEYUAN</span></span>\n    </div>\n    <div class=\"top-rule\"></div>\n\n    <h1>1&nbsp;&nbsp;机械运动</h1>\n\n    <section class=\"section\">\n      <div class=\"section-heading\">\n        【考点1】长度、时间及其测量\n        <span class=\"rating\">难度&nbsp;★&nbsp;&nbsp;考频&nbsp;☆☆☆</span>\n      </div>\n      <table class=\"first-table\">\n        <tr>\n          <td class=\"label\">单位换算<br>和估测</td>\n          <td class=\"content-a\">\n            1km=10<sup>3</sup>m；1dm=10<sup>-1</sup>m；<br>\n            1cm=10<sup>-2</sup>m；1mm=10<sup>-3</sup>m；<br>\n            1μm=10<sup>-6</sup>m；1nm=10<sup>-9</sup>m\n          </td>\n          <td class=\"content-b\">\n            一支新的2B铅笔的长度约为18cm；<br>\n            隧道音乐厅舞台长约为9dm；<br>\n            物理书的长宽是25cm；<br>\n            他自己的身高是17dm；<br>\n            人的心脏跳动一次的时间约为0.8s。\n          </td>\n        </tr>\n        <tr>\n          <td class=\"label\">刻度尺<br>读数</td>\n          <td class=\"content-a\">\n            测量结果由数字和单位组成，其中数字部分由准确值和一位估计值组成\n          </td>\n          <td class=\"content-b\">\n            若测量尺的分度值是1mm，需读数到分度值的下一位，如图“4.30cm、4.31cm”，最后一位“0”、“1”是估读值。\n          </td>\n        </tr>\n        <tr>\n          <td class=\"label\" rowspan=\"4\">长度测量<br>的特殊<br>方法</td>\n          <td class=\"method\">累积法</td>\n          <td class=\"content-b\">测一张纸的厚度时，可先测50张的厚度。</td>\n        </tr>\n        <tr>\n          <td class=\"method\">化曲为直法</td>\n          <td class=\"content-b\">用棉线测量圆形物体长度。</td>\n        </tr>\n        <tr>\n          <td class=\"method\">平移法（配合法）</td>\n          <td class=\"content-b\">用两把卡尺测量球直径；<br>测路旁用的卡尺。</td>\n        </tr>\n        <tr>\n          <td class=\"method\">比例法</td>\n          <td class=\"content-b\">利用科学和艺术尺测量建筑物高度。</td>\n        </tr>\n      </table>\n    </section>\n\n    <section class=\"section\">\n      <div class=\"section-heading\">\n        【考点2】机