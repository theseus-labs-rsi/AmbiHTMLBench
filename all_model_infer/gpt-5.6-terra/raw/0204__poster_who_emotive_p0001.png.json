dding-left: 29px; }\n    .content li { padding-left: 0; margin-bottom: 8px; }\n    .content b {\n      font-weight: 700;\n      background: #fff;\n    }\n    .early-copy { left: 68px; width: 290px; }\n    .massage-copy { left: 434px; top: 697px; width: 260px; }\n    .oxy-copy { left: 758px; top: 759px; width: 320px; padding-left: 28px; border-left: 1px solid #0064aa; min-height: 228px; }\n    .tx-copy { left: 1090px; top: 760px; width: 314px; padding-left: 28px; border-left: 1px solid #0064aa; min-height: 227px; }\n    .iv-copy { left: 1422px; top: 697px; width: 310px; padding-left: 29px; border-right: 1px solid #0064aa; min-height: 290px; }\n    .exam-copy { left: 1732px; top: 628px; width: 274px; }\n\n    .trigger {\n      position: absolute;\n      top: 1059px;\n      left: 68px;\n      width: 295px;\n      color: #1262a4;\n      font-size: 23px;\n      line-height: 1.2;\n      z-index: 3;\n    }\n    .trigger h2 {\n      display: inline-block;\n      margin: 0 0 29px;\n      padding: 4px 11px;\n      background: #fff;\n      font-size: 22px;\n    }\n    .trigger p { margin: 0 0 10px; }\n    .trigger b { color: #572b8c; font-size: 27px; }\n\n    .implementation {\n      position: absolute;\n      left: 441px;\n      top: 1035px;\n      width: 1585px;\n      height: 385px;\n      padding: 21px 28px;\n      border: 1.5px solid #0064aa;\n      border-radius: 29px;\n      background: #fff;\n      z-index: 3;\n    }\n    .implementation h2 {\n      margin: 0 0 25px;\n      color: #572b8c;\n      font-size: 29px;\n      line-height: 1;\n    }\n    .strategy-grid {\n      display: grid;\n      grid-template-columns: 112px 1fr 112px 1fr;\n      column-gap: 22px;\n      row-gap: 26px;\n      align-items: start;\n      font-size: 22px;\n      line-height: 1.27;\n    }\n    .strategy-grid p { margin: 0; }\n    .strategy-grid b { font-weight: 700; }\n    .strategy-icon {\n      width: 92px;\n      height: 92px;\n      justify-self: center;\n      border: 2px solid #1262a4;\n      color: #1262a4;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      text-align: center;\n      font-size: 12px;\n    }\n    .strategy-icon.audit { clip-path: polygon(15% 0, 70% 0, 100% 28%, 100% 100%, 15% 100%); background: #b8e2df; }\n    .strategy-icon.trophy { border: 0; background: #ffae17; clip-path: polygon(15% 0, 85% 0, 80% 50%, 60% 67%, 60% 88%, 78% 100%, 22% 100%, 40% 88%, 40% 67%, 20% 50%); }\n    .strategy-icon.case { height: 62px; background: #ac91be; border-radius: 5px; }\n    .strategy-icon.training { background: #b8e2df; }\n    .who {\n      position: absolute;\n      left: 64px;\n      bottom: 72px;\n      color: #0098d7;\n      font-weight: 700;\n      font-size: 17px;\n      line-height: .95;\n      z-index: 3;\n    }\n    .who:before {\n      content: \"◎\";\n      float: left;\n      margin-right: 7px;\n      font-size: 50px;\n      line-height: .7;\n    }\n    .hrp {\n      position: absolute;\n      left: 240px;\n      bottom: 72px;\n      font-size: 14px;\n      line-height: .8;\n      color: #0098d7;\n      z-index: 3;\n    }\n    .hrp strong { font-size: 37px; font-weight: 400; }\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <div class=\"left-panel\"></div>\n    <div class=\"band\"></div>\n    <div class=\"wave one\"></div>\n    <div class=\"wave two\"></div>\n    <div class=\"wave three\"></div>\n    <div class=\"cloud top\"></div>\n    <div class=\"cloud lower\"></div>\n\n    <header class=\"title\">\n      <strong>DETECT</strong>\n      <span class=\"and\">AND</span>\n      <strong>TREAT</strong>\n      <span class=\"rest\">POSTPARTUM HAEMORRHAGE EARLY</span>\n    </header>\n\n    <div class=\"letters e-left\">E</div>\n    <div class=\"letters m\">M</div>\n    <div class=\"letters o\">O</div>\n    <div class=\"letters t\">T</div>\n    <div class=\"letters iv\">IV</div>\n    <div class=\"letters e-right\">E</div>\n\n    <div class=\"circle drape\"><div class=\"placeholder\" aria-label=\"[Diagram: calibrated drape]\">[Diagram: calibrated drape]</div></div>\n    <div class=\"circle massage\"><div class=\"placeholder\" aria-label=\"[Diagram: uterine massage]\">[Diagram: uterine massage]</div></div>\n    <div class=\"circle oxy\"><div class=\"placeholder\" aria-label=\"[Diagram: syringe]\">[Diagram: syringe]</div></div>\n    <div class=\"circle tx\"><div class=\"placeholder\" aria-label=\"[Diagram: syringe]\">[Diagram: syringe]</div></div>\n    <div class=\"circle ivfluid\"><div class=\"placeholder\" aria-label=\"[Diagram: IV fluid bag]\">[Diagram: IV fluid bag]</div></div>\n    <div class=\"circle exam\"><div class=\"placeholder\" aria-label=\"[Diagram: magnifying glass]\">[Diagram: magnifying glass]</div></div>\n\n    <div class=\"pill early\">Early detection<br>and trigger criteria</div>\n    <div class=\"pill massage\">Massage of uterus</div>\n    <div class=\"pill oxy\">Oxytocic drugs</div>\n    <div class=\"pill tx\">Tranexamic acid</div>\n    <div class=\"pill iv\">IV fluids</div>\n    <div class=\"pill exam\">Examination<br>and escalation</div>\n\n    <section class=\"content early-copy\">\n      <ul>\n        <li>Calibrated drape for blood loss collection with trigger lines at <b>300ml and 500ml</b> for the first hour after birth</li>\n        <li>Observations (blood loss, blood flow, uterine tone) every <b>15 minutes</b> documented on the blood loss monitoring chart</li>\n        <li>Blood pressure and pulse carried out once in the <b>1st hour</b> postpartum and documented on the blood loss monitoring chart</li>\n      </ul>\n    </section>\n\n    <section class=\"content massage-copy\">\n      <ul>\n        <li>Massage until uterus has contracted or for <b>one minute</b></li>\n      </ul>\n    </section>\n\n    <section class=\"content oxy-copy\">\n      <ul>\n        <li><b>10 IU IV oxytocin injection</b> or diluted in <b>200-500ml crystalloid</b> over <b>10 minutes</b></li>\n      </ul>\n      <div style=\"margin-left:29px;\">IV infusion maintenance dose for <b>20 IU IV oxytcin</b> diluted in <b>1000ml saline</b> over <b>4 hours</b> (+- misoprostol 800mcg PR/SL if used)</div>\n    </section>\n\n    <section class=\"content tx-copy\">\n      <ul>\n        <li><b>1g IV injection of tranexamic acid</b> or diluted in <b>200ml crystalloid</b> over <b>10 minutes</b></li>\n      </ul>\n    </section>\n\n    <section class=\"content iv-copy\">\n      <ul>\n        <li>IV fluids in addition to the infusion should be given if clinically indicated. For resuscitation and will require a <b>2nd IV access</b></li>\n      </ul>\n    </section>\n\n    <section class=\"content exam-copy\">\n      <ul>\n        <li>Ensure bladder is empty, evacuate clots, check for tears with an internal examination and placenta for completeness</li>\n        <li>Escalate if bleeding does not stop after first response or you are unable to identify or manage cause of bleeding</li>\n      </ul>\n    </section>\n\n    <section class=\"trigger\">\n      <h2>Trigger criteria</h2>\n      <p><b>1</b> Clinical judgement</p>\n      <p><b>2</b> Blood loss 500ml or more</p>\n      <p><b>3</b> Blood loss 300ml or more<br>&nbsp;&nbsp;&nbsp;plus one abnormal<br>&nbsp;&nbsp;&nbsp;observation</p>\n    </section>\n\n    <section class=\"implementation\">\n      <h2>Implementation strategies</h2>\n      <div class=\"strategy-grid\">\n        <div class=\"strategy-icon audit\"><span>[Diagram: audit newsletter]</span></div>\n        <p><b>Audit newsletters:</b> sharing with all staff monthly detection and bundle use rates along with PPH, severe PPH, blood transfusion, laparotomy and death from PPH rates and given feedback at monthly departmental meetings</p>\n        <div class=\"strategy-icon case\"><span>[Diagram: trolley/carry case]</span></div>\n        <p><b>Trolley and/or carry case:</b> including all medicines and devices required for the treatment of PPH restocked after every use and complete a stocking checklist at the start of every shift</p>\n\n        <div class=\"strategy-icon trophy\"><span>[Diagram: trophy]</span></div>\n        <p><b>Champions:</b> midwife and doctor to oversee change, troubleshoot, give feedback on audit newsletters, connect with other champions through chats, meeting and websites for sharing knowledge and lessons learnt</p>\n        <div class=\"strategy-icon training\"><span>[Diagram: training chart]</span></div>\n        <p><b>Training:</b> on-site, simulation-based, and peer-assisted training of 90 minutes to a whole day facilitated by the use of provider guides, flipcharts and job aids displayed in labour wards</p>\n      </div>\n    </section>\n\n    <div class=\"who\">World Health<br>Organization</div>\n    <div class=\"hrp\">human<br>reproduction<br>programme<br><strong>hrp</strong></div>\n  </main>\n</body>\n</html>"
