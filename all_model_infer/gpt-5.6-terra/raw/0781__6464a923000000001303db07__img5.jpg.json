/span><span class=\"text\">辅食清淡易消化</span></div>\n      </section>\n\n      <section class=\"section\">\n        <h2>过敏性腹泻</h2>\n        <div class=\"item\"><span class=\"label\">原因</span><span class=\"text\">食物中的蛋白质过敏</span></div>\n        <div class=\"item\"><span class=\"label\">症状</span><span class=\"text\">湿疹、荨麻疹、哮喘</span></div>\n        <div class=\"item\"><span class=\"label\">大便</span><span class=\"text\">大便增多，无明显水样便</span></div>\n        <div class=\"item\"><span class=\"label\">护理</span><span class=\"text\">辅食避开过敏原，<br>换深度水解奶粉</span></div>\n      </section>\n\n      <section class=\"section\">\n        <h2>喂养不当腹泻</h2>\n        <div class=\"item\"><span class=\"label\">原因</span><span class=\"text\">辅食添加过早过杂消化不良</span></div>\n        <div class=\"item\"><span class=\"label\">症状</span><span class=\"text\">呕吐、哭闹</span></div>\n        <div class=\"item\"><span class=\"label\">大便</span><span class=\"text\">有泡沫，混有颗粒物/粘液</span></div>\n        <div class=\"item\"><span class=\"label\">护理</span><span class=\"text\">暂停或减少辅食，清淡<br>饮食，少量多次给予</span></div>\n      </section>\n\n      <section class=\"section\">\n        <h2>细菌性腹泻</h2>\n        <div class=\"item\"><span class=\"label\">原因</span><span class=\"text\">病原微生物引起在夏季高发</span></div>\n        <div class=\"item\"><span class=\"label\">症状</span><span class=\"text\">腹痛恶心，发热，食欲不振</span></div>\n        <div class=\"item\"><span class=\"label\">大便</span><span class=\"text\">大便稀且有黏液，严重的便血</span></div>\n        <div class=\"item\"><span class=\"label\">护理</span><span class=\"text\">补液避免脱水，<br>注意饮食卫生</span></div>\n      </section>\n\n      <section class=\"section\">\n        <h2>乳糖不耐受腹泻</h2>\n        <div class=\"item\"><span class=\"label\">原因</span><span class=\"text\">由于肠道中缺乏乳糖酶引起</span></div>\n        <div class=\"item\"><span class=\"label\">症状</span><span class=\"text\">肠胀气、肠绞痛，吃奶就拉</span></div>\n        <div class=\"item\"><span class=\"label\">大便</span><span class=\"text\">次数多，大便有奶瓣泥状</span></div>\n        <div class=\"item\"><span class=\"label\">护理</span><span class=\"text\">母乳妈妈忌口高糖和奶制品</span></div>\n      </section>\n\n      <section class=\"section\">\n        <h2>受凉引起腹泻</h2>\n        <div class=\"item\"><span class=\"label\">原因</span><span class=\"text\">由腹部或身体受凉引起</span></div>\n        <div class=\"item\"><span class=\"label\">症状</span><span class=\"text\">胃胀，恶心，呕吐，屁多</span></div>\n        <div class=\"item\"><span class=\"label\">大便</span><span class=\"text\">大便水样，有泡沫</span></div>\n        <div class=\"item\"><span class=\"label\">护理</span><span class=\"text\">注意身体和肚子保暖，<br>不能生冷辛辣</span></div>\n      </section>\n    </div>\n  </main>\n</body>\n</html>"
