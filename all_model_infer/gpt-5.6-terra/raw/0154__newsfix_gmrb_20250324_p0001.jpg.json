        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>光明日报 2025年3月24日</title>\n  <script>\n    window.MathJax = { tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] } };\n  </script>\n  <script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      background: #ececec;\n      color: #171717;\n      font-family: \"Noto Serif CJK SC\", \"Songti SC\", SimSun, serif;\n    }\n    .page {\n      width: 1260px;\n      min-height: 1782px;\n      margin: 0 auto;\n      padding: 25px 22px 22px;\n      background: #fff;\n    }\n    .masthead {\n      display: grid;\n      grid-template-columns: 590px 1fr;\n      column-gap: 20px;\n      min-height: 258px;\n      border-bottom: 2px solid #888;\n    }\n    .brand { padding: 2px 10px 0; }\n    .logo {\n      height: 166px;\n      color: #ca0029;\n      font-family: KaiTi, STKaiti, cursive;\n      font-size: 126px;\n      font-weight: bold;\n      line-height: 1.25;\n      letter-spacing: 18px;\n      transform: scaleX(.9);\n      transform-origin: left center;\n      white-space: nowrap;\n    }\n    .roman {\n      margin-left: 151px;\n      font-family: Arial, sans-serif;\n      font-size: 20px;\n      letter-spacing: 8px;\n      white-space: nowrap;\n    }\n    .datebar {\n      margin-top: 8px;\n      height: 25px;\n      background: #006597;\n      color: white;\n      text-align: center;\n      font-family: Arial, sans-serif;\n      font-size: 15px;\n      line-height: 25px;\n      word-spacing: 15px;\n    }\n    .issue {\n      padding: 7px 14px 0;\n      font-family: Arial, sans-serif;\n      font-size: 12px;\n      text-align: center;\n      white-space: nowrap;\n    }\n    .headline-zone { padding-top: 13px; }\n    .top-title {\n      margin: 0 0 12px;\n      font-size: 35px;\n   