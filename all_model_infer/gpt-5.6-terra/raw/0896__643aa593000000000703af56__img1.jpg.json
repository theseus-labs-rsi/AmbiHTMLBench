ight: 24px;\n      font-size: 18px;\n    }\n\n    .time {\n      display: block;\n      height: 23px;\n      line-height: 23px;\n      font-size: 15px;\n      white-space: nowrap;\n    }\n\n    .handwritten {\n      font-family: \"KaiTi\", \"STKaiti\", cursive;\n    }\n\n    .marked {\n      text-decoration: underline;\n      text-decoration-color: #9a1235;\n      text-decoration-thickness: 2px;\n      text-underline-offset: 3px;\n    }\n\n    @media (max-width: 560px) {\n      body {\n        background: #f7f7f5;\n      }\n\n      .page {\n        width: 100%;\n        padding-left: 5px;\n        padding-right: 5px;\n      }\n\n      body {\n        font-size: 16px;\n      }\n\n      table {\n        font-size: 15px;\n      }\n\n      .time {\n        font-size: 13px;\n      }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <h1>十、日积月累。</h1>\n\n    <section class=\"item\">\n      <div class=\"title\">1.《村居》（清·高鼎）：</div>\n      <div class=\"poem\">\n        草长莺飞二月天，拂堤杨柳醉春烟。<br>\n        儿童散学归来早，忙趁东风放纸鸢。\n      </div>\n    </section>\n\n    <section class=\"item\">\n      <div class=\"title\">2.《咏柳》（唐·贺知章）：</div>\n      <div class=\"poem\">\n        碧玉妆成一树高，万条垂下绿丝绦。<br>\n        不知细叶谁裁出，二月春风似剪刀。\n      </div>\n    </section>\n\n    <section class=\"item\">\n      <div class=\"title\">3.《赋得古原草送别》（唐·白居易）：</div>\n      <div class=\"poem\">\n        离离原上草，一岁一枯荣。<br>\n        野火烧不尽，春风吹又生。\n      </div>\n    </section>\n\n    <section class=\"item sentence\">4. 赠人玫瑰，手有余香。</section>\n    <section class=\"item sentence\">5. 平时肯帮人，急时有人帮。</section>\n    <section class=\"item sentence\">6. 与其锦上添花不如雪中送炭。</section>\n\n    <section class=\"item instruction\">\n      7. 在古代，一天被分为12个时辰，每个时辰对应一个生肖，下面的表格你会填吗？试一试吧！\n    </section>\n\n    <table aria-label=\"十二生肖与时辰对应表\">\n      <tbody>\n        <tr>\n          <td>\n            <span class=\"zodiac\">子鼠</span>\n            <span class=\"time\">(23:00--1:00)</span>\n          </td>\n          <td>\n            <span class=\"zodiac\">丑牛</span>\n            <span class=\"time\">(1:00--3:00)</span>\n          </td>\n          <td>\n            <span class=\"zodiac\">寅虎</span>\n            <span class=\"time\">(3:00--5:00)</span>\n          </td>\n          <td>\n            <span class=\"zodiac\">卯兔</span>\n            <span class=\"time\">(5:00--7:00)</span>\n          </td>\n        </tr>\n        <tr>\n          <td>\n            <span class=\"zodiac\">辰龙</span>\n            <span class=\"time\">(7:00--9:00)</span>\n          </td>\n          <td>\n            <span class=\"zodiac\">巳蛇</span>\n            <span class=\"time\">(9:00--11:00)</span>\n          </td>\n          <td>\n            <span class=\"zodiac\">午马</span>\n            <span class=\"time\">(11:00--13:00)</span>\n          </td>\n          <td>\n            <span class=\"zodiac\">未羊</span>\n            <span class=\"time\">(13:00--15:00)</span>\n          </td>\n        </tr>\n        <tr>\n          <td>\n            <span class=\"zodiac\">申猴</span>\n            <span class=\"time\">(15:00--17:00)</span>\n          </td>\n          <td>\n            <span class=\"zodiac\">酉鸡</span>\n            <span class=\"time\">(17:00--19:00)</span>\n          </td>\n          <td>\n            <span class=\"zodiac\">戌狗</span>\n            <span class=\"time\">(19:00--21:00)</span>\n          </td>\n          <td>\n            <span class=\"zodiac\">亥猪</span>\n            <span class=\"time\">(21:00--23:00)</span>\n          </td>\n        </tr>\n      </tbody>\n    </table>\n  </main>\n</body>\n</html>"
