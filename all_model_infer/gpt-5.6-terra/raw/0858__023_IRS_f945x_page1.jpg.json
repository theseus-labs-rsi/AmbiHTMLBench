px; flex:1; }\n  .address-labels, .foreign-labels { display:grid; margin-left:80px; grid-template-columns:562px 120px 1fr; font-size:18px; }\n  .address-labels span:nth-child(2), .foreign-labels span:nth-child(2) { text-align:center; }\n  .address-labels span:nth-child(3), .foreign-labels span:nth-child(3) { text-align:center; }\n  .address-fields { display:grid; grid-template-columns:562px 102px 202px; gap:18px; margin-left:80px; margin-top:8px; }\n  .field { height:52px; border:1.5px solid #000; }\n  .city-fields { display:grid; grid-template-columns:442px 222px 202px; gap:18px; margin-left:80px; margin-top:8px; }\n  .foreign-labels { grid-template-columns:442px 222px 202px; gap:18px; margin-left:80px; margin-top:3px; }\n  .side { display:flex; flex-direction:column; gap:31px; }\n  .sidebox { border:2px solid #111; height:168px; padding:15px 19px; }\n  .sidebox.date { height:168px; padding-top:16px; }\n  .blackhead { display:inline-block; background:#000; color:#fff; font-weight:bold; font-size:24px; padding:3px 7px 2px; line-height:1.05; }\n  .sidebox p { margin:7px 0 11px; font-size:21px; font-weight:bold; line-height:1.05; }\n  .yearbox { width:162px; height:36px; border:2px solid #111; display:inline-block; vertical-align:middle; }\n  .yyyy { margin-left:10px; }\n  .dateboxes { margin-top:16px; display:flex; align-items:center; gap:6px; }\n  .dateboxes .d { width:47px; height:36px; border:1.5px solid #000; }\n  .dateboxes .yr { width:68px; }\n  .date-format { margin-top:1px; font-size:21px; }\n  .instructions { font-size:24px; line-height:1.22; margin:1px 0 8px; }\n  .sectionbar { height:35px; border-top:2px solid #000; border-bottom:1px solid #000; display:flex; align-items:center; font-weight:bold; font-size:24px; }\n  .tag { background:#000; color:#fff; align-self:stretch; padding:3px 8px 0; margin-right:18px; }\n  .choices { padding:31px 20px 19px; }\n  .choice { display:grid; grid-template-columns:42px 1fr; column-gap:18px; margin-bottom:28px; font-size:21px; line-height:1.18; }\n  .check { width:35px; height:35px; border:1.5px solid #000; }\n  .choice b { font-weight:bold; }\n  .part2 { margin-top:0; }\n  .table-head { margin-left:480px; width:742px; display:grid; grid-template-columns:220px 40px 220px 40px 220px; text-align:center; padding-top:34px; }\n  .coltop { font-style:italic; font-size:21px; }\n  .subhead { margin-top:30px; font-size:18px; line-height:1.16; font-style:italic; font-weight:bold; }\n  .lines { margin-top:52px; margin-left:80px; width:1142px; }\n  .line { display:grid; grid-template-columns:400px 222px 38px 222px 38px 222px; align-items:center; min-height:83px; font-size:20px; }\n  .line-label { line-height:1.08; }\n  .line-label .num { display:inline-block; width:38px; }\n  .line-label b { font-weight:bold; }\n  .line-label .indent { margin-left:38px; }\n  .amount { width:222px; height:52px; border:1.5px solid #000; position:relative; }\n  .amount::after { content:\".\"; position:absolute; bottom:1px; right:66px; font-size:18px; }\n  .operator { text-align:center; font-size:23px; }\n  .total-line { display:flex; align-items:center; margin-top:20px; min-height:48px; font-size:20px; }\n  .total-label { width:920px; }\n  .dots { letter-spacing:14px; margin-left:12px; }\n  .total-line .amount { margin-left:auto; }\n  .note { margin-left:119px; margin-top:17px; width:1180px; font-size:20px; line-height:1.2; }\n  .note b { display:block; margin-bottom:28px; }\n  .note ul { padding-left:19px; margin:0 0 48px; }\n  .note li { margin:6px 0; }\n  .owenote { margin-top:0; }\n  .footer { margin-top:36px; border-top:2px solid #000; padding-top:5px; display:flex; align-items:center; font-size:18px; }\n  .footer strong { font-size:21px; }\n  .footer .website { margin-left:25px; font-style:italic; }\n  .footer .cat { margin-left:auto; }\n  .footer .formfoot { margin-left:auto; }\n  .formfoot b { font-size:26px; }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <div class=\"topline\">\n    <div class=\"formno\">\n      <small>Form</small><strong>945-X:</strong>\n      <div class=\"rev\">(Rev. February 2025)</div>\n    </div>\n    <div class=\"title\">Adjusted Annual Return of Withheld Federal Income Tax or Claim for Refund</div>\n    <div class=\"dept\">Department of the Treasury — Internal Revenue Service</div>\n    <div class=\"omb\">OMB No. 1545-0029</div>\n  </div>\n\n  <div class=\"entry-area\">\n    <div class=\"main-info\">\n      <div class=\"info-row\">\n        <div class=\"ein-label\">Employer identification number<br>(EIN)</div>\n        <div class=\"ein-boxes\">\n          <div class=\"digit\"></div><div class=\"digit\"></div><span class=\"hyphen\">−</span><div class=\"digit\"></div><div class=\"digit\"></div><div class=\"digit\"></div><div class=\"digit\"></div><div class=\"digit\"></div><div class=\"digit\"></div><div class=\"digit\"></div>\n        </div>\n      </div>\n      <div class=\"info-row\">\n        <div class=\"field-label\">Name <i>(not your trade name)</i></div><div class=\"longbox\"></div>\n      </div>\n      <div class=\"info-row trade\">\n        <div class=\"field-label\">Trade name <i>(if any)</i></div><div class=\"longbox\"></div>\n      </div>\n      <div class=\"addr-line\">\n        <div class=\"field-label\">Address</div><div class=\"address-box\"></div>\n      </div>\n      <div class=\"address-labels\"><span>Number</span><span>Street</span><span>Suite or room number</span></div>\n      <div class=\"address-fields\"><div class=\"field\"></div><div class=\"field\"></div><div class=\"field\"></div></div>\n      <div class=\"address-labels\"><span>City</span><span>State</span><span>ZIP code</span></div>\n      <div class=\"city-fields\"><div class=\"field\"></div><div class=\"field\"></div><div class=\"field\"></div></div>\n      <div class=\"foreign-labels\"><span>Foreign country name</span><span>Foreign province/county</span><span>Foreign postal code</span></div>\n    </div>\n\n    <div class=\"side\">\n      <div class=\"sidebox\">\n        <div class=\"blackhead\">Return You’re Correcting ...</div>\n        <p>Enter the calendar year of the return<br>you’re correcting:</p>\n        <div><span class=\"yearbox\"></span><span class=\"yyyy\">(YYYY)</span></div>\n      </div>\n      <div class=\"sidebox date\">\n        <div class=\"blackhead\">Enter the date you discovered errors:</div>\n        <div class=\"dateboxes\"><div class=\"d\"></div><span>/</span><div class=\"d\"></div><span>/</span><div class=\"d yr\"></div></div>\n        <div class=\"date-format\">(MM / DD / YYYY)</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"instructions\">Read the separate instructions before you complete this form. Use this form to correct administrative errors made on Form 945,<br>Annual Return of Withheld Federal Income Tax. Use a separate Form 945-X for each year that needs correction. Type or print within<br>the boxes. You MUST complete both pages. Don’t attach this form to Form 945.</div>\n\n  <div class=\"sectionbar\"><span class=\"tag\">Part 1:</span> Select ONLY one process.</div>\n\n  <div class=\"choices\">\n    <div class=\"choice\">\n      <div class=\"check\"></div>\n      <div><b>1. Adjusted return of withheld federal income tax.</b> Check this box if you underreported amounts. Also check this box if you overreported<br>\n      amounts and you would like to use the adjustment process to correct the errors. You must check this box if you’re correcting both<br>\n      underreported and overreported amounts on this form. The amount shown on line 5, if less than zero, may only be applied as a credit to<br>\n      your Form 945 for the tax period in which you’re filing this form.</div>\n    </div>\n    <div class=\"choice\">\n      <div class=\"check\"></div>\n      <div><b>2. Claim.</b> Check this box if you overreported amounts only and you would like to use the claim process to ask for a refund or abatement of the<br>\n      amount shown on line 5. Don’t check this box if you’re correcting ANY underreported amounts on this form.</div>\n    </div>\n  </div>\n\n  <div class=\"sectionbar part2\"><span class=\"tag\">Part 2:</span> Enter the corrections for the calendar year you’re correcting. If any line doesn’t apply, leave it blank.</div>\n\n  <div class=\"table-head\">\n    <div class=\"coltop\">Column 1</div><div></div><div class=\"coltop\">Column 2</div><div></div><div class=\"coltop\">Column 3</div>\n    <div class=\"subhead\">Total corrected<br>amount<br>(for ALL payees)</div><div class=\"subhead\">−</div>\n    <div class=\"subhead\">Amount originally<br>reported or as<br>previously corrected<br>(for ALL payees)</div><div class=\"subhead\">=</div>\n    <div class=\"subhead\">Difference<br>(If this amount is a<br>negative number, use<br>a minus sign.)</div>\n  </div>\n\n  <div class=\"lines\">\n    <div class=\"line\">\n      <div class=\"line-label\"><span class=\"num\">3.</span> <b>Federal income tax withheld</b><br><span class=\"indent\">(Form 945, line 1)</span></div>\n      <div class=\"amount\"></div><div class=\"operator\">−</div><div class=\"amount\"></div><div class=\"operator\">=</div><div class=\"amount\"></div>\n    </div>\n    <div class=\"line\">\n      <div class=\"line-label\"><span class=\"num\">4.</span> <b>Backup withholding</b><br><span class=\"indent\">(Form 945, line 2)</span></div>\n      <div class=\"amount\"></div><div class=\"operator\">−</div><div class=\"amount\"></div><div class=\"operator\">=</div><div class=\"amount\"></div>\n    </div>\n    <div class=\"total-line\">\n      <div class=\"total-label\"><b>5.</b> &nbsp; <b>Total.</b> Combine the amounts on lines 3 and 4 of Column 3 <span class=\"dots\">. . . . . . .</span></div>\n      <div class=\"amount\"></div>\n    </div>\n  </div>\n\n  <div class=\"note\">\n    <b>If line 5 is less than zero:</b>\n    <ul>\n      <li>If you checked line 1, this is the amount you want applied as a credit to your Form 945 for the tax period in which you’re<br> filing this form.</li>\n      <li>If you checked line 2, this is the amount you want refunded or abated.</li>\n    </ul>\n    <div class=\"owenote\"><b style=\"display:inline;\">If line 5 is more than zero, this is the amount you owe.</b> Pay this amount when you file this return. For information on how to pay, see<br><i>Amount you owe</i> in the instructions for line 5.</div>\n  </div>\n\n  <div class=\"footer\">\n    <strong>For Paperwork Reduction Act Notice, see the separate instructions.</strong>\n    <span class=\"website\">www.irs.gov/Form945X</span>\n    <span class=\"cat\">Cat. No. 20336X</span>\n    <span class=\"formfoot\">Form <b>945-X</b> (Rev. 2-2025)</span>\n  </div>\n</div>\n</body>\n</html>"
