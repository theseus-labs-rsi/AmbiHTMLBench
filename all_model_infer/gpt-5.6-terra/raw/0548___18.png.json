ventnodes .arrow { width:39px; }\n  .eventnodes .bars { height:75px; }\n  .eventnodes .mlp { margin-left:2px; }\n  .eventnodes .lstm { margin-left:-1px; }\n  .event-formulas {\n    position:absolute; top:36px; left:375px; color:#747d7c; font-size:16px;\n  }\n  .event-sub {\n    position:absolute; top:84px; left:255px; color:#6a7772; font-size:10px;\n  }\n  .diagonal {\n    position:absolute; left:350px; top:177px; transform:rotate(43deg);\n    font-size:16px;\n  }\n  .connector {\n    position:absolute; height:0; border-top:2px dashed #111;\n  }\n  .c1 { left:164px; top:144px; width:325px; }\n  .c2 { left:164px; top:315px; width:325px; }\n  .force-path {\n    position:absolute; left:1086px; top:132px; width:111px; height:189px;\n    border-right:1px solid #111; border-bottom:1px solid #111;\n  }\n  .force-path:before {\n    content:\"+\"; position:absolute; right:-8px; bottom:-8px; width:14px; height:14px;\n    color:#fff; text-align:center; line-height:14px; border-radius:50%; background:#06386c;\n    font:bold 14px Arial;\n  }\n  .force-path2 {\n    position:absolute; left:1130px; top:222px; width:44px; height:98px;\n    border-top:1px solid #111; border-right:1px solid #111;\n  }\n  .dynamicbox, .staticbox {\n    height:112px; margin:15px 9px 0; border:4px dashed #ffe18e; background:#fff4d7;\n    text-align:center; padding-top:6px; font-size:17px; font-weight:bold;\n  }\n  .staticbox { margin-top:39px; border-color:#dcb7dc; background:#f3eafa; }\n  .plot {\n    position:relative; margin:2px auto; width:91px; height:59px; border-left:3px solid #111; border-bottom:3px solid #111;\n  }\n  .plot:before { content:\"F\"; position:absolute; left:-13px; top:0; font-size:13px; font-weight:normal; }\n  .plot:after { content:\"\"; position:absolute; left:2px; bottom:7px; width:72px; height:29px; border-top:2px solid #122a64; border-radius:55% 45% 10% 60%; transform:skewX(-23deg); }\n  .caption {\n    margin-top: 15px;\n    font-size: 21px;\n    line-height: 24px;\n    letter-spacing: -.25px;\n  }\n\n  .bottom {\n    display: grid;\n    grid-template-columns: 670px 670px;\n    column-gap: 31px;\n    margin-top: 49px;\n    font-family: Georgia, \"Times New Roman\", serif;\n  }\n  .article {\n    font-size: 27px;\n    line-height: 32px;\n    text-align: justify;\n    letter-spacing: .05px;\n  }\n  .article p { margin: 0 0 0 0; text-indent: 26px; }\n  .article p:first-child { text-indent: 0; }\n  .article .subhead { font-style: italic; }\n  .algorithm {\n    border-top: 2px solid #111;\n    border-bottom: 2px solid #111;\n    height: 630px;\n    padding-top: 0;\n    font-size: 26px;\n    line-height: 29px;\n  }\n  .alg-title {\n    border-bottom: 2px solid #999;\n    font-size: 26px;\n    line-height: 34px;\n  }\n  .alg-title b { font-weight: bold; }\n  .alg-content { padding-left: 26px; }\n  .alg-content .indent { padding-left: 47px; }\n  .alg-content .indent2 { padding-left: 49px; }\n  .alg-content b { font-weight: bold; }\n  .alg-content i { font-style: italic; }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"diagram\" aria-label=\"FGER-Net architecture diagram\">\n    <div class=\"placeholder receptors\">\n      <div class=\"sensor-title\">Rapidly Adapting Receptors</div>\n      <div class=\"sensor rapid\">\n        <div class=\"labels\"><span>Meissner’s corpuscles</span><span>Ruffini endings</span></div>\n        <div class=\"skinrow\">\n          <div class=\"skin\"><span class=\"nerve\"></span></div>\n          <div class=\"skin\"><span class=\"slug\"></span></div>\n        </div>\n      </div>\n      <div class=\"sensor-title\">Slowly Adapting Receptors</div>\n      <div class=\"sensor slow\">\n        <div class=\"labels\"><span>Merkel disks</span><span>Pacinian corpuscles</span></div>\n        <div class=\"skinrow\">\n          <div class=\"skin\"><span class=\"nerve\"></span></div>\n          <div class=\"skin\"><span class=\"slug\"></span></div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"placeholder mechanism\">\n      <div class=\"small-title\">Common perceptual<br>mechanism</div>\n      <div class=\"dynamic\">Perceiving<br>dynamic<br>force</div>\n      <div class=\"static\">Perceiving<br>static<br>force</div>\n    </div>\n\n    <div class=\"placeholder event-stream\">\n      <div class=\"stream-title\">Event Stream Recurrent Network</div>\n      <div class=\"event-formulas\">(h<sub>t−1</sub>,c<sub>t−1</sub>)<br>&nbsp;&nbsp;&nbsp;&nbsp;(h<sub>t</sub>,c<sub>t</sub>)</div>\n      <div class=\"event-sub\">Pooling</div>\n      <div class=\"nodes eventnodes\">\n        <div class=\"imageicon\"></div><div class=\"arrow\"></div><div class=\"bars\"></div><div class=\"arrow\"></div>\n        <div class=\"mlp\"></div><div class=\"bars\"></div><div class=\"bars\"></div><div class=\"arrow\"></div>\n        <div class=\"bars\"></div><div class=\"arrow\"></div><div class=\"lstm\"></div><div class=\"arrow\"></div><div class=\"mlp\"></div>\n      </div>\n      <div class=\"time-label\">At time step t+1</div>\n    </div>\n\n    <div class=\"placeholder frame-net\">\n      <div class=\"stream-title\">Frame-Guided Network</div>\n      <div class=\"nodes\">\n        <div class=\"imageicon\"></div><div class=\"arrow\"></div><div class=\"cnn\">CNN</div><div class=\"arrow\"></div>\n        <div class=\"bars\"></div><div class=\"bars\"></div><div class=\"arrow\"></div><div class=\"mlp\"></div><div class=\"arrow\"></div>\n      </div>\n      <div class=\"time-label\">At time step t+1</div>\n    </div>\n\n    <div class=\"connector c1\"></div>\n    <div class=\"connector c2\"></div>\n    <div class=\"diagonal\">Time Series</div>\n    <div class=\"force-path\"></div>\n    <div class=\"force-path2\"></div>\n\n    <div class=\"placeholder perceiving\">\n      <div class=\"small-title\">Perceiving</div>\n      <div class=\"dynamicbox\">Dynamic<div class=\"plot\"></div></div>\n      <div class=\"staticbox\">Static<div class=\"plot\"></div></div>\n    </div>\n  </div>\n\n  <div class=\"caption\">\n    Fig. 2.  The architecture of the proposed FGER-Net is presented, alongside its conceptual underpinnings. The left portion illustrates the biological inspiration for the network: the synergistic function of fast and slow adapting mechanoreceptors in perceiving dynamic and static forces, respectively. These biological principles are emulated by the FGER-Net. In the network itself (center), event streams and image frames are synergistically fused for robust force estimation. In this architecture, frames are used to periodically correct for drift during training and to continuously stabilize the high frequency force predictions derived from the event stream during inference. The resulting force estimation is thereby made accurate and robust against drift, successfully capturing both dynamic and static tactile information, mirroring the perceptual capabilities shown on the right side of the diagram.\n  </div>\n\n  <div class=\"bottom\">\n    <div class=\"article\">\n      <p>dual rate architecture mirrors biological perception: a high frequency recurrent pathway integrates transient force increments from the event stream, while a low frequency pathway extracts absolute spatial references from single image frames for periodic training corrections.</p>\n      <p>During inference, we maximize estimation stability via a continuous correction strategy. By persistently fusing the most recent frame feature with incoming events, this absolute spatial anchor effectively eliminates integration drift.</p>\n      <p>The architecture utilizes dual parallel pathways optimized for each modality’s distinct characteristics. To circumvent the extreme sparsity typical of standard convolutions on event data, individual events are normalized and processed by a pointwise MLP, followed by max-pooling to generate an aggregated feature vector for each packet. Conversely, dense spatial information from image frames is extracted into a compact feature vector using a residual CNN backbone coupled with average pooling.</p>\n      <p><span class=\"subhead\">a) Data Stream Segmentation:</span> The algorithm’s processing cycle is driven by the arrival of new frames. A cycle is</p>\n    </div>\n\n    <div class=\"algorithm\">\n      <div class=\"alg-title\"><b>Algorithm 1</b> FGER-Net</div>\n      <div class=\"alg-content\">\n        <b>Input:</b> \\(I_{\\mathrm{guide}}, \\{P_m\\}_{m=1}^{M}, f_{\\mathrm{prev\\_cycle}}, (h_{\\mathrm{prev\\_cycle}}, C_{\\mathrm{prev\\_cycle}})\\)<br>\n        <b>Output:</b> \\(\\hat f_{\\mathrm{final}}, (h_M,C_M)\\)<br>\n        <i>Guiding Frame Feature Extraction</i><br>\n        \\(\\mathbf{f}_{\\mathrm{frame}} \\leftarrow \\Phi_f(I_{\\mathrm{guide}})\\)<br>\n        <i>Recurrent Processing Loop</i><br>\n        \\(\\hat f_0 \\leftarrow f_{\\mathrm{prev\\_cycle}};\\ (h_0,C_0)\\leftarrow(h_{\\mathrm{prev\\_cycle}},C_{\\mathrm{prev\\_cycle}})\\)<br>\n        <b>for</b> \\(m \\leftarrow 1\\) <b>to</b> \\(M\\) <b>do</b><br>\n        <div class=\"indent\">\n          \\(\\mathbf{f}_{e,m} \\leftarrow \\Phi_e(P_m)\\)<br>\n          \\(\\mathbf{x}_m \\leftarrow \\mathrm{concatenate}(\\mathbf{f}_{e,m},\\hat f_{m-1})\\)<br>\n          \\((h_m,C_m) \\leftarrow \\mathrm{LSTM}(\\mathbf{x}_m,(h_{m-1},C_{m-1}))\\)<br>\n          \\(\\Delta\\hat f_m \\leftarrow \\mathrm{MLP}_{\\Delta f}(h_m)\\)<br>\n          \\(\\hat f_m \\leftarrow \\hat f_{m-1}+\\Delta\\hat f_m\\)\n        </div>\n        <b>end for</b><br>\n        <i>Fusion and Correction</i><br>\n        \\(\\mathbf{f}_{\\mathrm{fusion}} \\leftarrow \\mathrm{concatenate}(\\hat f_M,\\mathbf{f}_{\\mathrm{frame}})\\)<br>\n        \\(\\Delta f_{\\mathrm{corr}} \\leftarrow \\mathrm{MLP}_{\\mathrm{corr}}(\\mathbf{f}_{\\mathrm{fusion}})\\)<br>\n        \\(\\hat f_{\\mathrm{final}} \\leftarrow \\hat f_M+\\Delta f_{\\mathrm{corr}}\\)<br>\n        <b>return</b> \\(\\hat f_{\\mathrm{final}},(h_M,C_M)\\)\n      </div>\n    </div>\n  </div>\n</div>\n</body>\n</html>"
