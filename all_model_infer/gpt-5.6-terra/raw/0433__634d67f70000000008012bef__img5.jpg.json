ht: 1.05;\n    }\n    .left-top { position: absolute; left: 9px; top: 7px; width: 221px; }\n    .left-mid { position: absolute; left: 9px; top: 173px; width: 221px; }\n    .left-bottom { position: absolute; left: 10px; top: 500px; width: 219px; }\n    .right-top { position: absolute; left: 8px; top: 10px; width: 211px; }\n    .right-mid { position: absolute; left: 10px; top: 186px; width: 209px; }\n    .right-bottom { position: absolute; left: 10px; top: 468px; width: 210px; }\n    .faint-line {\n      height: 10px;\n      margin-left: 10px;\n      border-bottom: 1px solid rgba(70,70,70,.15);\n      width: 164px;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"scene\">\n    <main class=\"notebook\">\n      <section class=\"page left-page\" aria-label=\"left notebook page\">\n        <div class=\"notes\">\n          <div class=\"left-top\">\n            <p class=\"heading black\">3. 大改變</p>\n            <p class=\"black\">解決方法：<span class=\"blue\">找到問題根源</span>，<span class=\"purple\">提出做法</span></p>\n            <p class=\"blue\">4. 調整時間與未來</p>\n            <p class=\"purple\">（1）學習與生活</p>\n            <p class=\"black indent\">① <span class=\"mark blue\">舊習慣</span>　② <span class=\"mark purple\">新方法</span></p>\n            <p class=\"black indent\">③ <span class=\"red\">自我提醒</span></p>\n            <p class=\"blue\">（2）建立目標</p>\n            <p class=\"black indent\">○ 了解自己所需的改變</p>\n            <p class=\"black indent\">◎ <span class=\"purple\">重視過程</span>，不要只看結果</p>\n            <p class=\"red indent\">→ 自己應該做到</p>\n          </div>\n\n          <div class=\"left-mid\">\n            <p class=\"purple heading\">5. 特殊情況</p>\n            <p class=\"blue\">（1）因環境而改變，才會慢慢習慣</p>\n            <p class=\"black\">（2）不要因為一時的挫折而放棄</p>\n            <p class=\"blue\">（3）生活與學習的平衡</p>\n            <p class=\"black indent\">目標與行動要相互配合</p>\n            <p class=\"purple\">（4）挫折時的反省</p>\n            <p class=\"black indent\">改變不是一次完成，而是反覆練習</p>\n            <p class=\"red\">要把握機會，記錄自己的進步。</p>\n            <p class=\"blue\">2. 調整與選擇</p>\n            <p class=\"black\">當發現方法不合適時，要重新思考；</p>\n            <p class=\"black\">學習接納自己，並找出適合的做法。</p>\n            <p class=\"purple\">不要只追求結果，過程也很重要。</p>\n            <p class=\"black\">建立好習慣後，就可以慢慢改變。</p>\n          </div>\n\n          <div class=\"left-bottom\">\n            <p class=\"blue heading\">（三）成長與改變</p>\n            <p class=\"black\">要持續練習，找到自己的方向。</p>\n            <p class=\"purple\">學習不是短時間的事</p>\n            <p class=\"boxed blue\">不斷累積經驗與信心</p>\n            <p class=\"red\">三、培養良好習慣</p>\n            <p class=\"black\">（五）能夠規劃</p>\n            <p class=\"blue\">了解自己，調整步伐</p>\n            <p class=\"purple\">勇敢面對新的挑戰</p>\n          </div>\n        </div>\n      </section>\n\n      <div class=\"binding\" aria-hidden=\"true\">\n        <span class=\"ring r1\"></span><span class=\"ring r2\"></span><span class=\"ring r3\"></span><span class=\"ring r4\"></span>\n        <span class=\"ring r5\"></span><span class=\"ring r6\"></span><span class=\"ring r7\"></span><span class=\"ring r8\"></span>\n        <span class=\"ring r9\"></span><span class=\"ring r10\"></span><span class=\"ring r11\"></span><span class=\"ring r12\"></span>\n        <span class=\"ring r13\"></span><span class=\"ring r14\"></span><span class=\"ring r15\"></span><span class=\"ring r16\"></span>\n        <span class=\"ring r17\"></span><span class=\"ring r18\"></span><span class=\"ring r19\"></span><span class=\"ring r20\"></span>\n        <span class=\"ring r21\"></span><span class=\"ring r22\"></span>\n      </div>\n\n      <section class=\"page right-page\" aria-label=\"right notebook page\">\n        <div class=\"notes\">\n          <div class=\"right-top\">\n            <p class=\"black heading\">（四）學習與改變</p>\n            <p class=\"blue\">目標要清楚，才能慢慢做到。</p>\n            <p class=\"black\">當學習有困難時，<span class=\"purple\">自己要找方法</span></p>\n            <p class=\"black\">一、<span class=\"red\">其他學習與改變的因素</span></p>\n            <p class=\"black indent\">1. 時間安排　2. 環境影響</p>\n            <p class=\"blue indent\">3. 自我要求與努力</p>\n            <p class=\"purple\">（一）能不能持續</p>\n            <p class=\"black indent\">① 每天做一點，慢慢累積</p>\n            <p class=\"black indent\">② 訂出自己的規則</p>\n            <p class=\"blue\">（二）了解自己的狀況</p>\n            <p class=\"black indent\">有些事情不是立刻就能完成</p>\n            <p class=\"purple\">（三）從錯誤中學習</p>\n            <p class=\"black indent\">面對問題，才能找到答案。</p>\n          </div>\n\n          <div class=\"right-mid\">\n            <p class=\"red heading\">三、其他自我管理的重點</p>\n            <p class=\"purple\">（一）學習要有計畫</p>\n            <p class=\"black indent\">依照自己的時間來安排</p>\n            <p class=\"blue\">（二）不要只是等待</p>\n            <p class=\"black indent\">主動去做，才會有改變</p>\n            <p class=\"purple\">（三）建立規律生活</p>\n            <p class=\"black indent\">早睡早起、整理環境</p>\n            <p class=\"blue\">（四）做好每一件小事</p>\n            <p class=\"black indent\">把事情分成小步驟完成</p>\n            <p class=\"red\">→ 學習不是壓力，而是一種累積。</p>\n            <p class=\"black\">遇到不懂的地方，可以請教別人。</p>\n            <p class=\"purple\">自己也要願意練習與嘗試。</p>\n            <p class=\"blue\">時間管理能讓事情更有秩序。</p>\n          </div>\n\n          <div class=\"right-bottom\">\n            <p class=\"black heading\">二、如何改善</p>\n            <p class=\"blue\">（一）訂定計畫　　（二）實際行動</p>\n            <p class=\"purple\">（三）檢討與修正</p>\n            <p class=\"black\">1. 檢視自己的問題</p>\n            <p class=\"black\">2. 尋求協助</p>\n            <p class=\"blue\">3. 養成固定的習慣</p>\n            <p class=\"black\">4. 努力做到最好</p>\n            <p class=\"purple\">（二）利用時間</p>\n            <p class=\"black\">1. 對自己負責　2. 改善拖延</p>\n            <p class=\"black\">3. 充實自己的生活</p>\n            <p class=\"blue\">4. 保持積極態度</p>\n          </div>\n        </div>\n      </section>\n    </main>\n  </div>\n</body>\n</html>"
