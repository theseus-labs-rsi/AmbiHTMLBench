        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>历史资料</title>\n  <script>\n    window.MathJax = {\n      tex: { inlineMath: [['$', '$'], ['\\\\(', '\\\\)']], displayMath: [['$$', '$$'], ['\\\\[', '\\\\]']] },\n      svg: { fontCache: 'global' }\n    };\n  </script>\n  <script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js\"></script>\n  <style>\n    * {\n      box-sizing: border-box;\n    }\n\n    html,\n    body {\n      margin: 0;\n      min-height: 100%;\n      background: #d9d7d4;\n    }\n\n    body {\n      width: 540px;\n      min-height: 720px;\n      padding: 34px 25px 30px 39px;\n      color: #333;\n      font-family: \"SimSun\", \"Songti SC\", serif;\n      font-size: 11px;\n      line-height: 1.48;\n      letter-spacing: 0;\n    }\n\n    main {\n      width: 100%;\n    }\n\n    .timeline,\n    .economic,\n    .global {\n      margin: 0;\n      padding: 0;\n      list-style: none;\n    }\n\n    .timeline {\n      margin-bottom: 11px;\n    }\n\n    .timeline li,\n    .economic li,\n    .global li {\n      display: flex;\n      align-items: flex-start;\n      margin: 0;\n      white-space: nowrap;\n    }\n\n    .timeline .num,\n    .economic .num,\n    .global .num {\n      flex: 0 0 32px;\n      color: #a8662e;\n    }\n\n    .timeline .year {\n      flex: 0 0 68px;\n    }\n\n    .economic .num,\n    .global .num {\n      color: #333;\n    }\n\n    .economic {\n      margin-top: 1px;\n      margin-bottom: 12px;\n    }\n\n    .economic .year {\n      flex: 0 0 76px;\n    }\n\n    .economic li {\n      line-height: 1.55;\n    }\n\n    .global .year {\n      flex: 0 0 67px;\n    }\n\n    .global li {\n      line-height: 1.55;\n    }\n\n    .section-title {\n      margin: 0 0 2px 0;\n      font-weight: bold;\n      font-size: 12px;\n    }\n\n    .continuation {\n      padding-left: 100px;\n    }\n\n    .placeholder {\n      display: none;\n    }\n  </style>\n</head>\n<body>\n  <main>\n    <ul class=\"timeline\">\n      <li>\n        <span class=\"num\">（1）</span>\n        <span class=\"year\">1918—1921</span>\n        <span>战时共产主义政策（余粮收集制）</span>\n      </li>\n      <li>\n        <span class=\"num\">（2）</span>\n        <span class=\"year\">1921—1927</span>\n        <span>新经济政策（粮食税、租用市场和商品货币关系发展生产）</span>\n      </li>\n      <li>\n        <span class=\"num\">（3）</span>\n        <span class=\"year\">1928—1932</span>\n        <span>第一个五年计划（优先发展重工业）</span>\n      </li>\n      <li>\n        <span class=\"num\">（4）</span>\n        <span class=\"year\">1929—1937</span>\n        <span>农业集体化（为保证国家工业化建设的原料进行）</span>\n      </li>\n      <li>\n        <span class=\"num\">（5）</span>\n        <span class=\"year\">1933—1937</span>\n        <span>第二个五年计划（成为世界第二大工业强国）</span>\n      </li>\n      <li>\n        <span class=\"num\">（6）</span>\n        <span class=\"year\">1991</span>\n        <span>苏联解体，两极格局形成。1947年杜鲁门主义冷战开始，马歇尔计划，1949年北约，</span>\n      </li>\n      <li>\n        <span class=\"num\"></span>\n        <span class=\"year\">1955</span>\n        <span>年华约等美苏两极格局形成</span>\n      </li>\n    </ul>\n\n    <h2 class=\"section-title\">资本主义经济：</h2>\n    <ul class=\"economic\">\n      <li>\n        <span class=\"num\">（1）</span>\n        <span class=\"year\">1929—1933</span>\n        <span>以美国为首的资本主义国家爆发经济大危机</span>\n      </li>\n      <li>\n        <span class=\"num\">（2）</span>\n        <span class=\"year\">20世纪30年代</span>\n        <span>罗斯福新政，开创了资本主义国家干预经济发展的新模式</span>\n      </li>\n      <li>\n        <span class=\"num\">（3）</span>\n        <span class=\"year\">20世纪50年代—20世纪60年代</span>\n        <span>美国经济“黄金时代”（美国经济、“黄金时代”）</span>\n      </li>\n      <li>\n        <span class=\"num\">（4）</span>\n        <span class=\"year\">20世纪70年代</span>\n        <span>美国经济陷入“滞胀”（凯恩斯主义失灵）</span>\n      </li>\n      <li>\n        <span class=\"num\">（5）</span>\n        <span class=\"year\">20世纪80年代</span>\n        <span>美国经济回升（货币学派和供给学派）</span>\n      </li>\n      <li>\n        <span class=\"num\">（6）</span>\n        <span class=\"year\">20世纪90年代</span>\n        <span>“新经济”时代（“宏观调控、微观自主”），既反对完全自由放任，又反对过度的政府干预</span>\n      </li>\n      <li>\n        <span class=\"num\"></span>\n        <span class=\"year\"></span>\n        <span>（指干预）</span>\n      </li>\n    </ul>\n\n    <h2 class=\"section-title\">全球化趋势</h2>\n    <ul class=\"global\">\n      <li>\n        <span class=\"num\">（1）</span>\n        <span class=\"year\">1944</span>\n        <span>布雷顿森林体系（美元与黄金直接挂钩，是以美元为中心的资本主义世界货币体系）</span>\n      </li>\n      <li>\n        <span class=\"num\">（2）</span>\n        <span class=\"year\">1945</span>\n        <span>世界银行建立（WB）；国际货币基金组织成立（IMF）</span>\n      </li>\n      <li>\n        <span class=\"num\">（3）</span>\n        <span class=\"year\">1948</span>\n        <span>关贸总协定总协定</span>\n      </li>\n      <li>\n        <span class=\"num\">（4）</span>\n        <span class=\"year\">1967</span>\n        <span>欧洲共同体成立（经济一体化）</span>\n      </li>\n      <li>\n        <span class=\"num\">（5）</span>\n        <span class=\"year\">1993</span>\n        <span>欧盟成立（经济政治一体化）</span>\n      </li>\n      <li>\n        <span class=\"num\">（6）</span>\n        <span class=\"year\">1999</span>\n        <span>欧元问世</span>\n      </li>\n      <li>\n        <span class=\"num\">（7）</span>\n        <span class=\"year\">1995</span>\n        <span>“关贸总协定”发展为“世界贸易组织”（WTO）</span>\n      </li>\n      <li>\n        <span class=\"num\"></span>\n        <span class=\"year\">1960年</span>\n        <span>极标作非洲年</span>\n      </li>\n    </ul>\n  </main>\n</body>\n</html>"
