        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>大数据白皮书（2022 年）</title>\n  <script>\n    window.MathJax = {\n      tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] }\n    };\n  </script>\n  <script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * {\n      box-sizing: border-box;\n    }\n\n    html,\n    body {\n      margin: 0;\n      background: #fff;\n      color: #111;\n    }\n\n    body {\n      font-family: \"SimSun\", \"宋体\", serif;\n    }\n\n    .page {\n      width: 1065px;\n      min-height: 1450px;\n      margin: 0 auto;\n      padding-top: 77px;\n      position: relative;\n      overflow: hidden;\n    }\n\n    .header {\n      width: 1045px;\n      margin: 0 auto;\n      text-align: center;\n      font-size: 20px;\n      line-height: 27px;\n      padding-bottom: 4px;\n      border-bottom: 2px solid #111;\n    }\n\n    .diagram {\n      width: 960px;\n      height: 620px;\n      margin: 50px auto 0;\n      position: relative;\n    }\n\n    .step {\n      width: 277px;\n      min-height: 145px;\n      padding: 15px 13px 10px;\n      background: #d9d9d9;\n      border-radius: 15px;\n      position: absolute;\n      font-family: Arial, \"Microsoft YaHei\", sans-serif;\n      color: #111;\n    }\n\n    .step h3 {\n      margin: 0 0 16px;\n      font-size: 20px;\n      line-height: 23px;\n      font-weight: 700;\n    }\n\n    .step p {\n      margin: 0;\n      font-size: 16px;\n      line-height: 25px;\n    }\n\n    .step p::first-letter {\n      font-weight: 700;\n    }\n\n    .s1 { left: 38px; top: 0; }\n    .s2 { left: 380px; top: 0; }\n    .s3 { left: 722px; top: 0; }\n    .s4 { left: 722px; top: 211px; }\n    .s5 { left: 380px; top: 211px; }\n    .s6 { left: 38px; top: 211px; }\n    .s7 { left: 38px; top: 421px; }\n\n    .arrow {\n      position: absolute;\n   