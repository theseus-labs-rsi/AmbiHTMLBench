       linear-gradient(135deg, #e4d7cf, #dca583 43%, #8c5048 44%, #d7c1a5);\n    }\n    .photo.responsiveness {\n      background:\n        linear-gradient(142deg, transparent 42%, #f1f2eb 43% 53%, transparent 54%),\n        linear-gradient(25deg, #337caa, #d9e7eb 46%, #154366 47%, #d8e5e6);\n    }\n    .photo.authenticity {\n      background:\n        radial-gradient(circle at 49% 49%, #9f0317 0 21%, #d7545f 22% 26%, transparent 27%),\n        linear-gradient(135deg, #e6e6e3, #a8a8a4);\n    }\n    .photo.relevance {\n      background:\n        radial-gradient(circle at 27% 30%, #f0cfbd 0 13%, transparent 14%),\n        radial-gradient(circle at 62% 38%, #eed0bc 0 15%, transparent 16%),\n        linear-gradient(135deg, #ebe8da, #ae6955 47%, #e0c9af);\n    }\n    .photo.differentiation {\n      background:\n        linear-gradient(62deg, transparent 37%, #f3dd42 38% 53%, transparent 54%),\n        repeating-linear-gradient(90deg, #1e292e 0 7px, #b7afa0 7px 13px, #242d2d 13px 20px);\n    }\n    .photo.consistency {\n      background:\n        radial-gradient(circle at 22% 25%, #f3e9cf 0 5%, transparent 6%),\n        radial-gradient(circle at 50% 54%, #f3e9cf 0 5%, transparent 6%),\n        radial-gradient(circle at 76% 31%, #f3e9cf 0 5%, transparent 6%),\n        linear-gradient(135deg, #476a34, #9d7946);\n    }\n    .photo.presence {\n      background:\n        linear-gradient(90deg, rgba(244,78,53,.85) 0 27%, transparent 28%),\n        linear-gradient(135deg, #2474a0, #cf5141 50%, #425e83);\n    }\n    .photo.understanding {\n      background:\n        radial-gradient(circle at 42% 34%, #dcb89a 0 12%, transparent 13%),\n        radial-gradient(circle at 67% 42%, #e3c5a8 0 12%, transparent 13%),\n        linear-gradient(135deg, #dad4c5, #72574d 50%, #d7b694);\n    }\n    .card-copy {\n      position: absolute;\n      left: 60px;\n      top: 0;\n      width: 240px;\n    }\n    .card-title {\n      display: block;\n      margin: 0 0 0 0;\n      color: #f3f3f3;\n      font-size: 16px;\n      line-height: 17px;\n      font-weight: 700;\n      letter-spacing: -.2px;\n    }\n    .card-body {\n      display: block;\n      margin-top: 0;\n      font-size: 9.5px;\n      line-height: 10.2px;\n      font-weight: 400;\n      letter-spacing: -.06px;\n      color: #dedede;\n    }\n    .right .card-copy { width: 250px; }\n    .right .card-body { font-size: 9.5px; line-height: 10px; }\n    .interbrand {\n      position: absolute;\n      right: 82px;\n      bottom: 25px;\n      color: white;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: 24px;\n      letter-spacing: -1.7px;\n      line-height: 24px;\n    }\n  </style>\n</head>\n<body>\n  <main class=\"slide\">\n    <div class=\"kicker\">BRAND STRENGTH</div>\n    <h1>WE MEASURE THE LEVERS FOR SUSTAINABLE DEMAND</h1>\n\n    <div class=\"person\" style=\"left:73px; top:168px;\">\n      <div class=\"head\"></div><div class=\"torso\"></div>\n      <div class=\"arm left\"></div><div class=\"arm right\"></div>\n      <div class=\"leg left\"></div><div class=\"leg right\"></div>\n    </div>\n    <div class=\"audience-label\" style=\"left:19px; top:264px;\">Employees<span>(Current &amp; Prospective)</span></div>\n\n    <div class=\"person\" style=\"left:73px; top:380px;\">\n      <div class=\"head\"></div><div class=\"torso\"></div>\n      <div class=\"arm left\"></div><div class=\"arm right\"></div>\n      <div class=\"leg left\"></div><div class=\"leg right\"></div>\n    </div>\n    <div class=\"audience-label\" style=\"left:19px; top:479px;\">Customers<span>(Current &amp; Prospective)</span></div>\n\n    <div class=\"factor\" style=\"left:157px; top:326px;\">INTERNAL<br>FACTORS</div>\n    <div class=\"factor\" style=\"left:577px; top:326px;\">EXTERNAL<br>FACTORS</div>\n\n    <section class=\"left\">\n      <div class=\"card\" style=\"left:207px; top:201px; width:310px;\">\n        <div class=\"photo clarity\"><span>[Photo: clarity]</span></div>\n        <div class=\"card-copy\">\n          <span class=\"card-title\">Clarity</span>\n          <span class=\"card-body\">Clarity is internally about what the brand stands for and its values,<br>positioning and proposition. Clarity too about target audiences,<br>customer insights and drivers. Because so much hinges on this, it is<br>vital that these are articulated and shared across the organization.</span>\n        </div>\n      </div>\n\n      <div class=\"card\" style=\"left:263px; top:274px; width:275px;\">\n        <div class=\"photo commitment\"><span>[Photo: commitment]</span></div>\n        <div class=\"card-copy\">\n          <span class=\"card-title\">Commitment</span>\n          <span class=\"card-body\">Internal commitment to brand, and a belief internally<br>in the importance of brand. The extent to which the<br>brand receives support in terms of time, influence, and<br>investment.</span>\n        </div>\n      </div>\n\n      <div class=\"card\" style=\"left:263px; top:347px; width:275px;\">\n        <div class=\"photo protection\"><span>[Photo: protection]</span></div>\n        <div class=\"card-copy\">\n          <span class=\"card-title\">Protection</span>\n          <span class=\"card-body\">How secure the brand is across a number of<br>dimensions: legal protection, proprietary ingredients<br>or design, scale or geographical spread.</span>\n        </div>\n      </div>\n\n      <div class=\"card\" style=\"left:207px; top:421px; width:320px;\">\n        <div class=\"photo responsiveness\"><span>[Photo: responsiveness]</span></div>\n        <div class=\"card-copy\">\n          <span class=\"card-title\">Responsiveness</span>\n          <span class=\"card-body\">The ability to respond to market changes, challenges and<br>opportunities. The brand should have a sense of leadership<br>internally and a desire and ability to constantly evolve and<br>renew.</span>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"right\">\n      <div class=\"connector\" style=\"left:568px; top:125px; width:219px;\"></div>\n      <div class=\"connector\" style=\"left:568px; top:198px; width:334px;\"></div>\n      <div class=\"connector\" style=\"left:683px; top:270px; width:219px;\"></div>\n      <div class=\"connector\" style=\"left:683px; top:343px; width:219px;\"></div>\n      <div class=\"connector\" style=\"left:628px; top:415px; width:274px;\"></div>\n      <div class=\"connector\" style=\"left:568px; top:488px; width:334px;\"></div>\n\n      <div class=\"card\" style=\"left:568px; top:131px; width:335px;\">\n        <div class=\"photo authenticity\"><span>[Photo: authenticity]</span></div>\n        <div class=\"card-copy\">\n          <span class=\"card-title\">Authenticity</span>\n          <span class=\"card-body\">The brand is soundly based on an internal<br>truth and capability. It has a defined heritage and a well grounded<br>value set. It can deliver against the (high) expectations that customers<br>have of it.</span>\n        </div>\n      </div>\n\n      <div class=\"card\" style=\"left:628px; top:202px; width:275px;\">\n        <div class=\"photo relevance\"><span>[Photo: relevance]</span></div>\n        <div class=\"card-copy\">\n          <span class=\"card-title\">Relevance</span>\n          <span class=\"card-body\">The fit with customers/consumer needs, desires, and<br>decision criteria across all relevant demographic and<br>geographies.</span>\n        </div>\n      </div>\n\n      <div class=\"card\" style=\"left:683px; top:275px; width:250px;\">\n        <div class=\"photo differentiation\"><span>[Photo: differentiation]</span></div>\n        <div class=\"card-copy\">\n          <span class=\"card-title\">Differentiation</span>\n          <span class=\"card-body\">The degree to which customers/<br>consumers perceive the brand to have a<br>differentiated positioning distinctive from the<br>competition.</span>\n        </div>\n      </div>\n\n      <div class=\"card\" style=\"left:683px; top:348px; width:250px;\">\n        <div class=\"photo consistency\"><span>[Photo: consistency]</span></div>\n        <div class=\"card-copy\">\n          <span class=\"card-title\">Consistency</span>\n          <span class=\"card-body\">The degree to which a brand is experienced<br>without fail across all touchpoints or formats.</span>\n        </div>\n      </div>\n\n      <div class=\"card\" style=\"left:628px; top:421px; width:280px;\">\n        <div class=\"photo presence\"><span>[Photo: presence]</span></div>\n        <div class=\"card-copy\">\n          <span class=\"card-title\">Presence</span>\n          <span class=\"card-body\">The degree to which a brand feels omnipresent and is<br>talked about positively by consumers, customers and<br>opinion formers in both traditional and social media.</span>\n        </div>\n      </div>\n\n      <div class=\"card\" style=\"left:568px; top:494px; width:334px;\">\n        <div class=\"photo understanding\"><span>[Photo: understanding]</span></div>\n        <div class=\"card-copy\">\n          <span class=\"card-title\">Understanding</span>\n          <span class=\"card-body\">The brand is not only recognised by customers,<br>but there is also an in-depth knowledge and understanding of its<br>distinctive qualities and characteristics (Where relevant, this is)<br>consumer understanding of the company that owns the brand.</span>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"interbrand\">Interbrand</div>\n  </main>\n</body>\n</html>"
