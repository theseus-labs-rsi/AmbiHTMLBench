        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Aircraft Engine Systems</title>\n  <script>\n    window.MathJax = { tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] } };\n  </script>\n  <script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      background: #fff;\n      color: #222;\n      font-family: Georgia, \"Times New Roman\", serif;\n    }\n    .page {\n      width: 1700px;\n      min-height: 2200px;\n      margin: 0 auto;\n      padding: 108px 142px 70px;\n    }\n    .columns {\n      display: grid;\n      grid-template-columns: 646px 658px;\n      gap: 53px;\n      align-items: start;\n    }\n    .column { width: 100%; }\n    p {\n      font-size: 30px;\n      line-height: 1.19;\n      margin: 0 0 27px;\n    }\n    h2 {\n      font-family: Arial, Helvetica, sans-serif;\n      font-size: 27px;\n      line-height: 1.1;\n      margin: 28px 0 10px;\n      font-weight: 700;\n    }\n    .left > p:first-child { margin-bottom: 29px; }\n    .right > p:first-child { margin-bottom: 28px; }\n    figure { margin: 20px 0 0; }\n    .chart {\n      width: 646px;\n      height: 440px;\n      border: 3px solid #333;\n      position: relative;\n      background: #fff;\n      font-family: Arial, Helvetica, sans-serif;\n    }\n    .plot {\n      position: absolute;\n      left: 99px;\n      top: 35px;\n      width: 502px;\n      height: 323px;\n      border: 3px solid #262626;\n      overflow: hidden;\n      background:\n        repeating-linear-gradient(to right, rgba(255,255,255,.58) 0, rgba(255,255,255,.58) 1px, transparent 1px, transparent 26px),\n        repeating-linear-gradient(to bottom, rgba(255,255,255,.58) 0, rgba(255,255,255,.58) 1px, transparent 1px, transparent 32px),\n        #59b9e1;\n    }\n    .high {\n      position: absolute;\n      inset: 0 0 auto 0;\n      height: 129px;\n      background: rgba(177,226,243,.82);\n      border-bottom: 1px solid rgba(255,255,255,.55);\n    }\n    .high::after {\n      content: \"\";\n      position: absolute;\n      right: 47px;\n      top: 0;\n      width: 140px;\n      height: 129px;\n      background: rgba(67,180,225,.6);\n    }\n    .plot-label {\n      position: absolute;\n      z-index: 2;\n      width: 100%;\n      text-align: center;\n      font-size: 22px;\n      line-height: 1.02;\n    }\n    .high-label { top: 42px; }\n    .possible {\n      top: 197px;\n      color: white;\n      font-weight: 700;\n      font-size: 21px;\n    }\n    .y-title {\n      position: absolute;\n      left: 10px;\n      top: 126px;\n      transform: rotate(-90deg);\n      transform-origin: left top;\n      font-size: 20px;\n      white-space: nowrap;\n    }\n    .y-ticks {\n      position: absolute;\n      left: 29px;\n      top: 27px;\n      font-size: 19px;\n      line-height: 32px;\n      text-align: right;\n    }\n    .x-ticks {\n      position: absolute;\n      left: 76px;\n      bottom: 29px;\n      width: 556px;\n      display: flex;\n      justify-content: space-between;\n      font-size: 18px;\n      line-height: 19px;\n      text-align: center;\n    }\n    .x-title {\n      position: absolute;\n      width: 100%;\n      bottom: 3px;\n      text-align: center;\n      font-size: 20px;\n    }\n    figcaption {\n      font-family: Arial, Helvetica, sans-serif;\n      font-size: 23px;\n      font-weight: 700;\n      line-height: 1.28;\n      margin-top: 25px;\n      max-width: 640px;\n    }\n    .system {\n      width: 658px;\n      height: 433px;\n      margin-top: 22px;\n      border: 3px solid #333;\n      position: relative;\n      overflow: hidden;\n      font-family: Arial, Helvetica, sans-serif;\n      background: #fff;\n    }\n    .system .tank {\n      position: absolute;\n      width: 104px;\n      height: 78px;\n      right: 46px;\n      top: 170px;\n      border: 2px solid #333;\n      background: linear-gradient(to bottom, white 0 29%, #38b6e8 30% 100%);\n    }\n    .system .pipe {\n      position: absolute;\n      background: #174892;\n      border: 4px solid #174892;\n      border-radius: 8px;\n    }\n    .pipe.one { width: 184px; height: 18px; left: 220px; top: 292px; }\n    .pipe.two { width: 17px; height: 205px; left: 263px; top: 96px; }\n    .pipe.three { width: 95px; height: 17px; left: 264px; top: 96px; }\n    .pipe.four { width: 88px; height: 18px; left: 359px; top: 237px; }\n    .pipe.five { width: 17px; height: 68px; left: 430px; top: 188px; }\n    .pump, .unit {\n      position: absolute;\n      border: 2px solid #333;\n      background: #d6d6d6;\n      border-radius: 50%;\n    }\n    .pump.engine { left: 313px; top: 273px; width: 42px; height: 42px; }\n    .pump.aux { left: 402px; top: 266px; width: 50px; height: 52px; border-radius: 4px; }\n    .unit { left: 181px; top: 280px; width: 58px; height: 66px; border-radius: 8px; }\n    .valve {\n      position: absolute;\n      left: 221px;\n      top: 121px;\n      width: 45px;\n      height: 24px;\n      border: 2px solid #333;\n      border-radius: 50%;\n      background: #ddd;\n    }\n    .label {\n      position: absolute;\n      font-size: 20px;\n      line-height: 1.08;\n    }\n    .arrow {\n      position: absolute;\n      height: 2px;\n      background: #111;\n      transform-origin: left center;\n    }\n    .arrow::after {\n      content: \"\";\n      position: absolute;\n      right: -1px;\n      top: -4px;\n      width: 0;\n      height: 0;\n      border-left: 9px solid #111;\n      border-top: 5px solid transparent;\n      border-bottom: 5px solid transparent;\n    }\n    .figure-right figcaption { margin-top: 28px; }\n    .page-number {\n      margin-top: 68px;\n      font-family: Arial, Helvetica, sans-serif;\n      font-size: 23px;\n      font-weight: 700;\n    }\n    @media (max-width: 900px) {\n      .page { width: 100%; min-height: 0; padding: 34px 24px; }\n      .columns { grid-template-columns: 1fr; gap: 35px; }\n      p { font-size: 20px; }\n      .chart, .system { width: 100%; transform-origin: top left; }\n      .chart { height: 440px; }\n      h2 { font-size: 23px; }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <section class=\"columns\">\n      <article class=\"column left\">\n        <p>Operating an aircraft at a lower altitude airport with the jets set for higher altitudes will create too lean of a mixture, heat up the engine, and cause the engine to seize. The pilot must be aware of the jetting for the machine to adjust the mixture. Consult your POH for specific procedures for setting jets at different altitudes.</p>\n\n        <h2>Four-Stroke Mixture Settings</h2>\n        <p>Four-stroke engines typically have automatic mixture control for higher altitudes or a mixture control that can be operated by the pilot.</p>\n\n        <h2>Carburetor Icing</h2>\n        <p>One disadvantage of the carburetor system versus the fuel injected system is its icing tendency. Carburetor ice occurs due to the effect of fuel vaporization and the decrease in air pressure in the venturi, which causes a sharp temperature drop in the carburetor. If water vapor in the air condenses when the carburetor temperature is at or below freezing, ice may form on internal surfaces of the carburetor, including the throttle valve.</p>\n\n        <p>Ice generally forms in the vicinity of the venturi throat. This restricts the flow of the fuel-air mixture and reduces power. If enough ice builds up, the engine may cease to operate. Carburetor ice is most likely to occur when temperatures are below 70°F (21°C) and the relative humidity is above 80 percent. However, due to the sudden cooling that takes place in the carburetor, icing can occur even with temperatures as high as 100°F (38°C) and humidity as low as 50 percent. This temperature drop can be as much as 60 to 70°F. Therefore, at an outside air temperature of 100°F, a temperature drop of 70°F results in an air temperature in the carburetor of 30°F. [Figure 4-10]</p>\n\n        <figure>\n          <div class=\"chart\" aria-label=\"Chart: carburetor icing potential by relative humidity and outside air temperature\">\n            <div class=\"y-title\">Relative Humidity</div>\n            <div class=\"y-ticks\">100%<br>90%<br>80%<br>70%<br>60%<br>50%</div>\n            <div class=\"plot\">\n              <div class=\"high\"></div>\n              <div class=\"plot-label high-label\">High Carburetor<br>Icing Potential</div>\n              <div class=\"plot-label possible\">Carburetor Icing Possible</div>\n            </div>\n            <div class=\"x-ticks\">\n              <span>20°F<br>(-7°C)</span>\n              <span>32°F<br>(0°C)</span>\n              <span>70°F<br>(21°C)</span>\n              <span>100°F<br>(38°C)</span>\n            </div>\n            <div class=\"x-title\">Outside Air Temperature</div>\n          </div>\n          <figcaption>Figure 4-10. Although carburetor ice is most likely to form when the temperature and humidity are in ranges indicated by this chart, carburetor ice is also possible under conditions not depicted.</figcaption>\n        </figure>\n        <div class=\"page-number\">4-8</div>\n      </article>\n\n      <article class=\"column right\">\n        <p>The first indication of carburetor icing in a powered parachute is a decrease in engine RPM, which may be followed by engine roughness. Although carburetor ice can occur during any phase of flight, it is particularly dangerous when using reduced power during a descent. Under certain conditions, carburetor ice could build unnoticed until you try to add power. To combat the effects of carburetor ice, some engines have a carb heat option. Some of the newer four-stroke engines have carburetor heat turned on all the time to combat icing. Two-stroke engines are typically less susceptible to icing but specific installations dictate how susceptible the carburetor is to icing. Consult the aircraft POH for the probability of carb ice for the specific installation you have and for carb ice procedures.</p>\n\n        <h2>Fuel Injection Systems</h2>\n        <p>In a fuel injection system, the fuel is injected either directly into the cylinders, or just ahead of the intake valve. A fuel injection system usually incorporates these basic components: an engine-driven fuel pump, a fuel-air control unit, fuel manifold (fuel distributor), discharge nozzles, an auxiliary fuel pump, and fuel pressure/flow indicators. [Figure 4-11]</p>\n\n        <p>The auxiliary fuel pump provides fuel under pressure to the fuel-air control unit for engine starting and/or emergency use. After starting, the engine-driven fuel pump provides fuel under pressure from the fuel tank to the fuel-air control unit. This control unit, which essentially replaces the carburetor, meters the fuel and sends it to the fuel manifold valve at a rate controlled by the throttle. After reaching the fuel manifold valve, the fuel is distributed to the individual fuel discharge nozzles. The discharge nozzles, which are located in each cylinder head, inject the fuel-air mixture directly into each cylinder intake port.</p>\n\n        <figure class=\"figure-right\">\n          <div class=\"system placeholder\" aria-label=\"Diagram: fuel injection system\">\n            <div class=\"tank\"></div>\n            <div class=\"pipe one\"></div>\n            <div class=\"pipe two\"></div>\n            <div class=\"pipe three\"></div>\n            <div class=\"pipe four\"></div>\n            <div class=\"pipe five\"></div>\n            <div class=\"valve\"></div>\n            <div class=\"unit\"></div>\n            <div class=\"pump engine\"></div>\n            <div class=\"pump aux\"></div>\n\n            <div class=\"label\" style=\"left:47px;top:20px;\">Fuel<br>Manifold<br>Valve</div>\n            <div class=\"arrow\" style=\"left:108px;top:81px;width:87px;transform:rotate(31deg);\"></div>\n\n            <div class=\"label\" style=\"left:47px;top:176px;\">Fuel<br>Discharge<br>Nozzle</div>\n            <div class=\"arrow\" style=\"left:103px;top:215px;width:97px;transform:rotate(-20deg);\"></div>\n\n            <div class=\"label\" style=\"left:47px;top:335px;\">Fuel/Air<br>Control<br>Unit</div>\n            <div class=\"arrow\" style=\"left:125px;top:351px;width:68px;transform:rotate(-30deg);\"></div>\n\n            <div class=\"label\" style=\"left:282px;top:150px;\">Engine-Driven<br>Fuel Pump</div>\n            <div class=\"arrow\" style=\"left:343px;top:203px;width:74px;transform:rotate(102deg);\"></div>\n\n            <div class=\"label\" style=\"left:432px;top:336px;\">Auxiliary<br>Fuel Pump</div>\n            <div class=\"arrow\" style=\"left:502px;top:327px;width:50px;transform:rotate(-137deg);\"></div>\n\n            <div class=\"label\" style=\"right:57px;top:286px;\">Fuel Tank</div>\n            <div class=\"arrow\" style=\"right:91px;top:269px;width:42px;transform:rotate(-90deg);\"></div>\n          </div>\n          <figcaption>Figure 4-11. Fuel injection system.</figcaption>\n        </figure>\n      </article>\n    </section>\n  </main>\n</body>\n</html>"
