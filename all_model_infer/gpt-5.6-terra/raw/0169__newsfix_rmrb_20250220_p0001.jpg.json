        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>人民日报 2025年2月20日</title>\n  <script>\n    window.MathJax = { tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] } };\n  </script>\n  <script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      background: #e7e7e7;\n      color: #161616;\n      font-family: \"Songti SC\", \"SimSun\", serif;\n    }\n    .paper {\n      width: 800px;\n      min-height: 1137px;\n      margin: 0 auto;\n      padding: 8px 9px 10px;\n      background: #fff;\n      overflow: hidden;\n    }\n    .masthead {\n      height: 160px;\n      display: grid;\n      grid-template-columns: 292px 92px 1fr;\n      column-gap: 10px;\n      border-bottom: 2px solid #161616;\n      align-items: start;\n    }\n    .logo {\n      color: #c90020;\n      text-align: center;\n      padding-top: 3px;\n    }\n    .logo-cn {\n      font-family: \"KaiTi\", \"STKaiti\", cursive;\n      font-size: 75px;\n      font-weight: bold;\n      line-height: .95;\n      letter-spacing: 5px;\n      white-space: nowrap;\n      transform: scaleX(1.05);\n    }\n    .logo-en {\n      margin-top: 8px;\n      font-family: Georgia, serif;\n      font-size: 17px;\n      letter-spacing: 2px;\n    }\n    .logo-url {\n      margin-top: 3px;\n      color: #222;\n      font-family: Arial, sans-serif;\n      font-size: 6px;\n      letter-spacing: .4px;\n    }\n    .datebox {\n      height: 151px;\n      border: 2px solid #999;\n      padding: 7px 4px;\n      text-align: center;\n      font-size: 7px;\n      line-height: 1.5;\n    }\n    .datebox .day {\n      font-family: Arial, sans-serif;\n      font-size: 23px;\n      line-height: 1.1;\n    }\n    .right-head {\n      padding-top: 1px;\n    }\n    .right-head h1 {\n      margin: 0;\n    