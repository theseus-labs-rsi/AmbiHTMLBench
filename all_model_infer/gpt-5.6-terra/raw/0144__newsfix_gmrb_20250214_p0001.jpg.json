        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>光明日报 2025年2月14日</title>\n<script src=\"https://polyfill.io/v3/polyfill.min.js?features=es6\"></script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  *{box-sizing:border-box}\n  body{margin:0;background:#f3f0e8;color:#171717;font-family:\"Songti SC\",\"SimSun\",serif}\n  .page{width:768px;min-height:1086px;margin:0 auto;background:#fffdf8;padding:20px 14px 14px}\n  .mast{height:163px;position:relative;border-bottom:1px solid #bdbdb7}\n  .logo{position:absolute;left:8px;top:-13px;color:#c9152a;font-family:cursive;font-size:75px;font-weight:bold;letter-spacing:7px;transform:skew(-10deg)}\n  .roman{position:absolute;left:98px;top:105px;font:12px Arial,sans-serif;letter-spacing:5px;color:#333}\n  .datebar{position:absolute;left:4px;top:126px;width:349px;height:16px;background:#00719f;color:#fff;font:bold 9px Arial;text-align:center;line-height:16px}\n  .pub{position:absolute;left:5px;top:145px;width:352px;text-align:center;font:7px Arial,sans-serif}\n  .topstory{position:absolute;right:0;top:0;width:361px;height:160px}\n  .topstory h1{margin:0 0 5px;font-size:20px;line-height:1.15;font-weight:bold}\n  .newspaper{font-size:7px;line-height:1.48;text-align:justify;column-count:3;column-gap:8px}\n  .rule{border-top:1px solid #c3c3be;margin-top:5px}\n  .upper{display:grid;grid-template-columns:361px 1fr;gap:18px;margin-top:12px}\n  .headline{font-family:\"Heiti SC\",\"Microsoft YaHei\",sans-serif;font-size:28px;line-height:1.45;font-weight:900;letter-spacing:-1px;margin:0 0 8px;border-bottom:1px solid #aaa;padding-bottom:7px}\n  .subcols{column-count:3;column-gap:12px;font-size:7px;line-height:1.5;text-align:justify}\n  .photo-side{padding-top:0}\n  .placeholder{border:1px solid #9bb8c5;background:linear-gradient(#a5d7ed 0