1px solid #888;\n      padding-top: 28px;\n    }\n    h1, h2, h3, p { margin: 0; }\n    .lead-title {\n      font-family: \"Heiti SC\", \"SimHei\", sans-serif;\n      font-size: 47px;\n      letter-spacing: 3px;\n      line-height: 1.35;\n      font-weight: 900;\n    }\n    .lead-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 13px;\n      margin-top: 14px;\n    }\n    .text {\n      font-size: 12.5px;\n      line-height: 1.47;\n      text-align: justify;\n    }\n    .section {\n      border-bottom: 1px solid #888;\n      padding: 31px 0 18px;\n    }\n    .section-title {\n      font-family: \"Heiti SC\", \"SimHei\", sans-serif;\n      font-size: 38px;\n      letter-spacing: 1px;\n      line-height: 1.18;\n      font-weight: 900;\n      text-align: center;\n    }\n    .subtitle {\n      font-size: 23px;\n      font-weight: bold;\n      text-align: center;\n      margin: 6px 0 15px;\n    }\n    .three-col {\n      columns: 3;\n      column-gap: 15px;\n    }\n    .three-col p { margin-bottom: 8px; }\n    .mid-heading {\n      font-size: 17px;\n      font-weight: bold;\n      line-height: 1.4;\n      margin: 9px 0 5px;\n    }\n    .story {\n      padding: 24px 0 12px;\n      border-bottom: 1px solid #999;\n    }\n    .story-title {\n      font-size: 34px;\n      line-height: 1.2;\n      text-align: center;\n      font-weight: bold;\n      letter-spacing: 4px;\n    }\n    .byline {\n      text-align: center;\n      margin: 11px 0 14px;\n      font-size: 13px;\n    }\n    .story-grid {\n      display: grid;\n      grid-template-columns: 180px 1fr;\n      gap: 15px;\n    }\n    .campaign {\n      margin-top: 36px;\n      border-top: 5px solid #aa2e29;\n      border-bottom: 5px solid #aa2e29;\n      padding: 17px 25px 18px;\n    }\n    .campaign-title {\n      text-align: center;\n      font-size: 31px;\n      letter-spacing: 3px;\n      margin-bottom: 13px;\n    }\n    .campaign .text { columns: 2; column-gap: 20px; }\n    .right-hea