        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>人民日报 2025年2月2日</title>\n  <script>\n    window.MathJax = { tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] } };\n  </script>\n  <script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      background: #e9e9e9;\n      color: #111;\n      font-family: \"Songti SC\", \"SimSun\", serif;\n    }\n    .page {\n      width: 800px;\n      min-height: 1132px;\n      margin: 0 auto;\n      padding: 8px 7px 7px;\n      background: #fff;\n    }\n    .masthead {\n      height: 177px;\n      border-bottom: 2px solid #111;\n      position: relative;\n    }\n    .paper-name {\n      position: absolute;\n      left: 7px;\n      top: 2px;\n      color: #cc0025;\n      font-family: \"STKaiti\", \"KaiTi\", cursive;\n      font-size: 74px;\n      line-height: .96;\n      font-weight: bold;\n      letter-spacing: 3px;\n      transform: skew(-7deg);\n    }\n    .roman {\n      position: absolute;\n      top: 119px;\n      left: 72px;\n      color: #a41527;\n      font-family: Georgia, serif;\n      font-size: 17px;\n      letter-spacing: 2px;\n    }\n    .site {\n      position: absolute;\n      top: 151px;\n      left: 60px;\n      font-size: 7px;\n      letter-spacing: 1px;\n    }\n    .datebox {\n      position: absolute;\n      left: 304px;\n      top: 0;\n      width: 89px;\n      height: 168px;\n      border: 2px solid #999;\n      padding-top: 7px;\n      text-align: center;\n      font-family: Arial, sans-serif;\n      font-size: 8px;\n    }\n    .datebox .day {\n      margin: 7px 0 6px;\n      font-size: 21px;\n    }\n    .datebox .small { font-size: 7px; line-height: 1.55; }\n    .head-main {\n      position: absolute;\n      left: 418px;\n      top: 5px;\n      font-family: \"Micr