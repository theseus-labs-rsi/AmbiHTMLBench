        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>量子信息前沿论坛</title>\n  <script>\n    window.MathJax = {\n      tex: { inlineMath: [['$', '$'], ['\\\\(', '\\\\)']], displayMath: [['$$', '$$'], ['\\\\[', '\\\\]']] }\n    };\n  </script>\n  <script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      background: #fff;\n      color: #000;\n      font-family: \"Noto Sans CJK SC\", \"Microsoft YaHei\", SimSun, Arial, sans-serif;\n    }\n    .page {\n      min-height: 100vh;\n      overflow: hidden;\n      background: #fffdf9;\n    }\n    .top {\n      height: 505px;\n      position: relative;\n      overflow: hidden;\n      color: #fff;\n      background:\n        linear-gradient(165deg, transparent 0 59%, rgba(255,225,73,.6) 59.2% 63%, transparent 63.2%),\n        linear-gradient(174deg, transparent 0 67%, rgba(255,255,255,.75) 67.2% 68.2%, transparent 68.4%),\n        linear-gradient(0deg, #ff7a21 0%, #ffb326 29%, #ff6d00 75%);\n    }\n    .top::before {\n      content: \"\";\n      position: absolute;\n      width: 520px;\n      height: 520px;\n      left: -120px;\n      top: -80px;\n      border: 2px solid rgba(255,230,94,.38);\n      border-radius: 50%;\n      box-shadow: 120px 82px 0 -118px rgba(255,231,94,.5), 320px 40px 0 -318px rgba(255,231,94,.5);\n      opacity: .8;\n    }\n    .top::after {\n      content: \"\";\n      position: absolute;\n      width: 145%;\n      height: 105px;\n      left: -10%;\n      bottom: -22px;\n      transform: rotate(-4deg);\n      background: rgba(255,255,255,.87);\n      box-shadow: 0 -21px 0 rgba(255,204,58,.7);\n    }\n    .event {\n      position: absolute;\n      top: 58px;\n      right: 10%;\n      font-size: 24px;\n      text-shadow: 2px 2px 3px rgba(0,0,0,.34);\n      white-space: n