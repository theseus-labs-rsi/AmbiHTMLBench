        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>人民日报 2025年3月15日</title>\n  <script>\n    window.MathJax = { tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] } };\n  </script>\n  <script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      background: #e8e8e8;\n      color: #161616;\n      font-family: \"Songti SC\", \"SimSun\", serif;\n    }\n    .page {\n      width: 800px;\n      min-height: 1000px;\n      margin: 0 auto;\n      padding: 8px 10px 10px;\n      background: #fff;\n    }\n    .masthead {\n      display: grid;\n      grid-template-columns: 290px 90px 1fr;\n      gap: 10px;\n      align-items: start;\n      height: 158px;\n      border-bottom: 4px solid #111;\n    }\n    .logo {\n      height: 148px;\n      color: #c9001b;\n      text-align: center;\n      font-family: \"STKaiti\", \"KaiTi\", serif;\n      font-weight: bold;\n      font-size: 72px;\n      line-height: 1.22;\n      letter-spacing: 6px;\n      white-space: nowrap;\n    }\n    .english {\n      margin-top: -2px;\n      font-family: Georgia, serif;\n      font-size: 18px;\n      letter-spacing: 2px;\n    }\n    .subline {\n      color: #111;\n      font-family: \"Songti SC\", \"SimSun\", serif;\n      font-size: 8px;\n      letter-spacing: 0;\n      margin-top: 4px;\n    }\n    .datebox {\n      height: 150px;\n      border: 2px solid #999;\n      padding-top: 7px;\n      text-align: center;\n      font-size: 9px;\n      line-height: 1.3;\n    }\n    .datebox strong {\n      display: block;\n      font-family: Arial, sans-serif;\n      font-size: 20px;\n      font-weight: normal;\n      margin: 2px 0;\n    }\n    .datebox .tiny {\n      margin-top: 7px;\n      font-size: 8px;\n      line-height: 1.3;\n    }\n    .toplead h1 {\n      margin: