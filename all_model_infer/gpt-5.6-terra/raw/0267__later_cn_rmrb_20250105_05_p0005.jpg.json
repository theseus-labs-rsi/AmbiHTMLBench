olute;\n    right: 28px;\n    top: 34px;\n    width: 135px;\n    height: 150px;\n    background:\n      radial-gradient(circle at 24% 30%, #dc2d64 0 11px, transparent 12px),\n      radial-gradient(circle at 55% 25%, #e51b4f 0 12px, transparent 13px),\n      radial-gradient(circle at 77% 48%, #f3d9ae 0 15px, transparent 16px),\n      radial-gradient(circle at 38% 63%, #f5d2b0 0 17px, transparent 18px),\n      linear-gradient(45deg, transparent 30%, rgba(255,255,255,.3) 31% 32%, transparent 33%);\n    opacity: .9;\n  }\n  .middle-text {\n    margin: 0 7px 0 9px;\n  }\n  .middle-text p {\n    margin-bottom: 6px;\n  }\n  .middle-section {\n    margin-top: 6px;\n  }\n  .right-intro {\n    margin: 2px 0 7px;\n    color: #a42a1d;\n    line-height: 1.4;\n  }\n  .right-intro strong {\n    font-family: Arial, sans-serif;\n    font-size: 26px;\n    font-weight: normal;\n    vertical-align: -4px;\n  }\n  .right-box {\n    margin-bottom: 10px;\n  }\n  .right-heading {\n    padding: 5px 8px 4px;\n    margin: 0 0 7px;\n    color: #fff;\n    font-family: \"SimHei\", \"Microsoft YaHei\", sans-serif;\n    font-size: 11px;\n    font-weight: bold;\n    text-align: center;\n    background: linear-gradient(to right, #d96d41, #ef9a6b 50%, #d9683b);\n    border-radius: 2px;\n  }\n  .right-list {\n    margin: 0;\n    padding-left: 13px;\n    list-style-position: outside;\n  }\n  .right-list li {\n    margin: 0;\n    padding: 0;\n  }\n  .round-photo {\n    width: 119px;\n    height: 119px;\n    margin: 8px auto 8px;\n    border: 1px solid #ae8857;\n    border-radius: 50%;\n  }\n  .round-photo.one {\n    background:\n      radial-gradient(circle at 48% 38%, #f5dfbd 0 20px, transparent 21px),\n      radial-gradient(circle at 67% 48%, #d34c32 0 16px, transparent 17px),\n      linear-gradient(145deg, #74a0a1 0 31%, #e4d0a4 32% 60%, #9d4b2d 61%);\n  }\n  .round-photo.two {\n    width: 139px;\n    height: 139px;\n    background:\n      repeating-conic-gradient(from 15deg, #f7f0d1 0 15deg, #c62827 16deg 31deg),\n      radial-gradient(circle, #fff1c9 0 32px, transparent 33px);\n  }\n  .round-photo.two:after {\n    content: \"\";\n    position: absolute;\n    width: 45px;\n    height: 74px;\n    top: 30px;\n    left: 46px;\n    border-radius: 40% 40% 20% 20%;\n    background: #fff2ce;\n    box-shadow: 18px 7px 0 #d23b2d, -19px 12px 0 #d23b2d;\n    opacity: .8;\n  }\n  .right-foot {\n    margin-top: 6px;\n  }\n  .footer-notes {\n    position: absolute;\n    left: 516px;\n    top: 868px;\n    width: 261px;\n    font-size: 7px;\n    line-height: 1.45;\n  }\n  .footer-notes p {\n    text-indent: 0;\n    margin: 0 0 2px;\n  }\n  .bottom-landscape {\n    position: absolute;\n    left: 170px;\n    top: 946px;\n    width: 607px;\n    height: 181px;\n    overflow: hidden;\n    background:\n      radial-gradient(ellipse at 66% 89%, #6b9b37 0 90px, transparent 91px),\n      radial-gradient(ellipse at 38% 101%, #a5c75c 0 134px, transparent 135px),\n      linear-gradient(to bottom, #b6d4df 0 32%, #dbe8da 33% 44%, #619b41 45% 100%);\n  }\n  .bottom-landscape:before {\n    content: \"\";\n    position: absolute;\n    left: -15px;\n    top: 30px;\n    width: 660px;\n    height: 150px;\n    opacity: .8;\n    background:\n      repeating-linear-gradient(171deg, transparent 0 16px, rgba(232,244,188,.82) 17px 20px, transparent 21px 32px),\n      repeating-linear-gradient(8deg, transparent 0 21px, rgba(43,112,42,.46) 22px 25px, transparent 26px 38px);\n    transform: rotate(-3deg);\n  }\n  .bottom-landscape:after {\n    content: \"\";\n    position: absolute;\n    right: 83px;\n    top: 55px;\n    width: 144px;\n    height: 53px;\n    background:\n      linear-gradient(161deg, transparent 0 26%, #503e2e 27% 32%, transparent 33%),\n      linear-gradient(180deg, #e7eadc 0 65%, #80725a 66% 100%);\n    clip-path: polygon(0 64%, 18% 32%, 50% 52%, 74% 20%, 100% 53%, 100% 100%, 0 100%);\n    opacity: .93;\n  }\n  .left-column .last {\n    margin-top: 7px;\n  }\n  .caption {\n    position: absolute;\n    color: #3b3b3b;\n    font-size: 7px;\n    line-height: 1.4;\n  }\n  .caption-left {\n    left: 522px;\n    top: 1024px;\n    width: 140px;\n  }\n  .caption-right {\n    left: 670px;\n    top: 1024px;\n    width: 103px;\n  }\n  .decor {\n    position: absolute;\n    width: 57px;\n    height: 35px;\n    border: 2px solid rgba(222,150,80,.32);\n    border-left-color: transparent;\n    border-bottom-color: transparent;\n    border-radius: 50%;\n    transform: rotate(23deg);\n  }\n  .decor.d1 { right: 13px; top: 254px; }\n  .decor.d2 { right: 11px; top: 503px; transform: rotate(-25deg); }\n  .decor.d3 { right: 13px; top: 715px; transform: rotate(18deg); }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <header class=\"masthead\">\n    <div class=\"logo\">人民日报</div>\n    <div class=\"issue\">2025年1月5日 星期日</div>\n    <div class=\"edition\">5 人文</div>\n  </header>\n\n  <main class=\"paper\">\n    <div class=\"strapline\">越来越多中国非物质文化遗产成为世界认同和欣赏的中华文化符号——</div>\n    <div class=\"headline\">传承人话非遗</div>\n\n    <div class=\"decor d1\"></div>\n    <div class=\"decor d2\"></div>\n    <div class=\"decor d3\"></div>\n\n    <div class=\"columns\">\n      <section class=\"left-column\">\n        <p class=\"intro\">随着时代的发展，越来越多的非物质文化遗产走进百姓生活。近年来，各地在保护与传承中不断探索，让古老技艺焕发新的活力，让中华优秀传统文化得到更好的传播和发展。</p>\n\n        <h2 class=\"section-title\">普洱茶飘香世界</h2>\n        <p>云南普洱茶主要产于云南省西南部，茶树生长在高海拔、云雾缭绕的山地。这里四季温暖湿润，良好的生态环境为茶叶生产提供了得天独厚的条件。</p>\n        <p>普洱茶制作技艺伴随着茶叶生产发展而逐渐形成。人们在采摘、杀青、揉捻、晒干等工序中积累经验，形成了独具特色的传统技艺。</p>\n        <p>联合国教科文组织将中国传统制茶技艺及其相关习俗列入人类非物质文化遗产代表作名录，让更多人认识中国茶文化。</p>\n\n        <h2 class=\"section-title\">让非遗融入百姓生活</h2>\n        <p>非物质文化遗产来自生活，也服务于生活。今天，许多非遗项目走进社区、校园和旅游景区，传统技艺通过展览、体验、研学等方式被更多人了解。</p>\n        <p>一项项古老技艺正在获得新的生命力。传承人既坚守传统，又不断创新，让非遗在现代社会中找到适合自己的表达方式。</p>\n\n        <h2 class=\"section-title\">让民间技艺焕发新生</h2>\n        <p>在长期的生产生活实践中，各族人民创造了丰富多彩的非物质文化遗产。传统工艺、民俗活动、民间文学和表演艺术，构成了中华优秀传统文化的重要组成部分。</p>\n        <p>保护非遗，关键在于保护其独特的文化内涵和技艺体系。传承人要耐得住寂寞，也要善于把握时代需求，让传统技艺真正融入当代生活。</p>\n        <p>近年来，各地加大非遗保护力度，建立传承基地，开展记录、展示和培训工作，推动非遗保护成果惠及更多群众。</p>\n\n        <h2 class=\"section-title\">用器皿传递中国意蕴</h2>\n        <p>北京景泰蓝制作技艺已有六百多年的历史。点蓝、烧蓝、磨光等工序精细复杂，每一道工艺都凝聚着匠人的智慧。今天，景泰蓝仍然在生活中展现独特魅力。</p>\n        <p>古老技艺需要在守正基础上创新。传承人通过设计新产品、拓展新场景，让传统工艺更贴近现代审美。</p>\n      </section>\n\n      <section class=\"middle-column\">\n        <figure class=\"placeholder hero\">\n          <span>[Photo: traditional cultural heritage performance]</span>\n        </figure>\n\n        <div class=\"middle-text\">\n          <p>红灯笼、欢快的锣鼓声和热闹的节庆活动，构成了许多人记忆中的年味。对于非遗传承人来说，节日不仅是展示技艺的舞台，也是讲述中国故事、传递文化情感的重要时刻。</p>\n          <p>在传承中创新，在创新中发展。越来越多的年轻人加入非遗保护队伍，学习传统技艺，利用网络平台传播非遗，让古老文化以更加鲜活的方式走近大众。</p>\n          <p>文化遗产是历史留下来的宝贵财富。只有深入挖掘其时代价值，推动创造性转化、创新性发展，才能让中华优秀传统文化绽放更加夺目的光彩。</p>\n\n          <h2 class=\"section-title middle-section\">传统与时尚交织出云锦之美</h2>\n          <p>南京云锦织造技艺是中国传统丝织技艺的杰出代表。织机、纹样、色彩和工艺共同构成了云锦的独特魅力，精美的织物承载着深厚的历史文化。</p>\n          <p>云锦传承人坚持师徒传授、口传心授的传统方式，耐心培养年轻一代。同时，他们也尝试把传统纹样融入服饰、家居和文创产品，使云锦更好地进入现代生活。</p>\n          <p>一根根丝线在织机上交错，一幅幅纹样在经纬之间展开。传统技艺需要时间和耐心，更需要一代又一代人的坚守。</p>\n\n          <h2 class=\"section-title middle-section\">流淌在新时代的中国故事</h2>\n          <p>新时代为非物质文化遗产保护传承提供了更加广阔的舞台。数字技术、短视频和网络直播，让许多原本只在乡土社会流传的技艺被更多人看见。</p>\n          <p>从民间文学到传统音乐，从戏剧曲艺到传统工艺，非遗项目所蕴含的审美价值、道德观念和生活智慧，依然能够为今天的人们带来启迪。</p>\n          <p>保护非遗不是把它束之高阁，而是让它在当代社会中继续生长。只有让非遗与群众生活相连，与时代发展同频，文化传承才能拥有持久的生命力。</p>\n          <p>在新的历史起点上，广大非遗传承人将继续守护文化根脉，讲好中国故事，让中华优秀传统文化在交流互鉴中走向世界。</p>\n\n          <p class=\"small plain\">（本文配图除署名外均为资料图片）</p>\n        </div>\n      </section>\n\n      <aside class=\"right-column\">\n        <div class=\"right-intro\">截至目前，我国已有<br><strong>44</strong>个项目列入联合国教科文组织非物质文化遗产名录、名册</div>\n\n        <div class=\"right-box\">\n          <h3 class=\"right-heading\">人类非物质文化遗产代表作名录（39项）</h3>\n          <ol class=\"right-list\">\n            <li>春节——中国人庆祝传统新年的社会实践</li>\n            <li>昆曲</li>\n            <li>维吾尔族木卡姆艺术</li>\n            <li>中国传统桑蚕丝织技艺</li>\n            <li>中国传统木结构营造技艺</li>\n            <li>中国传统制茶技艺及其相关习俗</li>\n            <li>太极拳</li>\n            <li>藏医药浴法</li>\n            <li>蒙古族长调民歌</li>\n            <li>朝鲜族农乐舞</li>\n            <li>蒙古族呼麦</li>\n            <li>南音</li>\n            <li>中国书法</li>\n            <li>中国端午节</li>\n            <li>妈祖信俗</li>\n            <li>藏戏</li>\n            <li>格萨（斯）尔</li>\n            <li>侗族大歌</li>\n            <li>羌年</li>\n            <li>中国蚕桑丝织技艺</li>\n            <li>古琴艺术</li>\n            <li>蒙古族长调民歌</li>\n            <li>新疆维吾尔木卡姆艺术</li>\n            <li>呼麦</li>\n            <li>粤剧</li>\n            <li>中国剪纸</li>\n            <li>中国传统印染技艺</li>\n            <li>中国活字印刷术</li>\n            <li>中国传统医药</li>\n            <li>中国珠算</li>\n            <li>中国传统制茶技艺及其相关习俗</li>\n            <li>藏族唐卡</li>\n            <li>赫哲族伊玛堪</li>\n            <li>木卡姆艺术</li>\n            <li>古琴艺术</li>\n            <li>昆曲</li>\n          </ol>\n        </div>\n\n        <figure class=\"placeholder round-photo one\">\n          <span>[Photo: heritage craft]</span>\n        </figure>\n\n        <figure class=\"placeholder round-photo two\">\n          <span>[Photo: traditional performance]</span>\n        </figure>\n\n        <div class=\"right-box right-foot\">\n          <h3 class=\"right-heading\">急需保护的非物质文化遗产名录（4项）</h3>\n          <ol class=\"right-list\">\n            <li>赫哲族伊玛堪</li>\n            <li>中国木拱桥传统营造技艺</li>\n            <li>中国传统木结构营造技艺</li>\n            <li>麦西热甫</li>\n          </ol>\n        </div>\n\n        <div class=\"right-box\">\n          <h3 class=\"right-heading\">优秀保护实践名册（1项）</h3>\n          <p class=\"plain\">福建木偶戏后继人才培养计划</p>\n        </div>\n      </aside>\n\n      <div class=\"footer-notes\">\n        <p>图①：传统节庆活动展演，村民共同参与，展示中华优秀传统文化。</p>\n        <p>图②：传统工艺与现代生活相结合，非遗传承焕发新的活力。</p>\n        <p>图③：茶园景观与乡村建筑，体现人与自然和谐共生。</p>\n        <p>图④：青年传承人学习传统技艺，推动非遗创新发展。</p>\n      </div>\n\n      <div class=\"caption caption-left\">\n        资料来源：文化和旅游部非物质文化遗产司<br>\n        图片资料：新华社、人民日报资料图片\n      </div>\n      <div class=\"caption caption-right\">\n        责任编辑<br>\n        刘晓宇<br>\n        版式设计：本报美术部\n      </div>\n\n      <figure class=\"placeholder bottom-landscape\">\n        <span>[Landscape photo: tea fields and traditional village]</span>\n      </figure>\n    </div>\n  </main>\n</div>\n</body>\n</html>"
