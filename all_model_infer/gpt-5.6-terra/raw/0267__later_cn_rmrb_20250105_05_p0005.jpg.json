        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>传承人话非遗</title>\n<script>\n  window.MathJax = {\n    tex: {inlineMath: [['$', '$'], ['\\\\(', '\\\\)']], displayMath: [['$$', '$$'], ['\\\\[', '\\\\]']]}\n  };\n</script>\n<script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  html, body {\n    margin: 0;\n    padding: 0;\n    background: #fff;\n    color: #171717;\n  }\n  body {\n    font-family: \"SimSun\", \"Songti SC\", serif;\n  }\n  .page {\n    position: relative;\n    width: 800px;\n    height: 1150px;\n    margin: 0 auto;\n    overflow: hidden;\n    background: #fff;\n  }\n  .masthead {\n    position: relative;\n    height: 51px;\n    background: #fff;\n    border-bottom: 2px solid #111;\n  }\n  .masthead:after {\n    content: \"\";\n    position: absolute;\n    right: 6px;\n    bottom: -7px;\n    width: 784px;\n    height: 14px;\n    border-bottom: 2px solid #111;\n    border-radius: 0 0 16px 16px;\n  }\n  .logo {\n    position: absolute;\n    left: 10px;\n    top: 10px;\n    font-family: \"KaiTi\", \"STKaiti\", cursive;\n    font-size: 23px;\n    font-weight: bold;\n    letter-spacing: -3px;\n  }\n  .issue {\n    position: absolute;\n    right: 111px;\n    top: 27px;\n    font-size: 7px;\n    letter-spacing: .5px;\n  }\n  .edition {\n    position: absolute;\n    right: 14px;\n    top: 9px;\n    font-family: \"SimHei\", sans-serif;\n    font-size: 25px;\n    letter-spacing: 7px;\n  }\n  .paper {\n    position: absolute;\n    top: 52px;\n    left: 8px;\n    width: 784px;\n    height: 1077px;\n    overflow: hidden;\n    background:\n      radial-gradient(circle at 10% 7%, rgba(255,255,255,.7) 0 22px, transparent 24px),\n      radial-gradient(circle at 22% 6%, rgba(255,255,255,.48) 0 23px, transparent 25px),\n      radial-gradient(circle at 93% 62%, rgba(2