        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>50个行为经济学概念</title>\n  <script>\n    window.MathJax = {\n      tex: { inlineMath: [['$', '$'], ['\\\\(', '\\\\)']], displayMath: [['$$', '$$'], ['\\\\[', '\\\\]']] },\n      svg: { fontCache: 'global' }\n    };\n  </script>\n  <script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js\"></script>\n  <style>\n    * {\n      box-sizing: border-box;\n    }\n\n    html,\n    body {\n      margin: 0;\n      padding: 0;\n      background: #ffffff;\n      color: #222222;\n      font-family: \"Microsoft YaHei\", \"Noto Sans CJK SC\", Arial, sans-serif;\n    }\n\n    .document {\n      width: 540px;\n      margin: 0 auto;\n      padding-bottom: 6px;\n    }\n\n    .title {\n      height: 84px;\n      display: flex;\n      align-items: center;\n      padding: 0 4px;\n      background: #090909;\n      color: #ffffff;\n      font-size: 47px;\n      font-weight: 700;\n      line-height: 1;\n      white-space: nowrap;\n    }\n\n    .concepts {\n      padding: 5px 6px 0;\n    }\n\n    .concept {\n      display: flex;\n      width: 100%;\n      min-height: 57px;\n      margin-bottom: 3px;\n      overflow: hidden;\n      border-radius: 10px;\n    }\n\n    .concept-name {\n      flex: 0 0 188px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      padding: 4px 8px;\n      color: #ffffff;\n      font-size: 17px;\n      font-weight: 400;\n      line-height: 1.08;\n      text-align: center;\n    }\n\n    .concept-name .english {\n      display: block;\n      margin-top: 2px;\n      font-size: 16px;\n    }\n\n    .concept-description {\n      flex: 1;\n      display: flex;\n      align-items: center;\n      padding: 5px 9px 5px 8px;\n      font-size: 15px;\n      line-height: 1.28;\n    }\n\n    .concept-description::first-letter {\n      font-size: 16px;\n    }\n\n    .orange .concept-name { background: #ff7200; }\n    .orange .concept-description { background: #f8d8ce; }\n\n    .gray .concept-name { background: #a7a7a7; }\n    .gray .concept-description { background: #e3e3e3; }\n\n    .yellow .concept-name { background: #ffc000; }\n    .yellow .concept-description { background: #fbe8c2; }\n\n    .blue .concept-name { background: #168bc8; }\n    .blue .concept-description { background: #d3e4f1; }\n\n    .green .concept-name { background: #4cae2d; }\n    .green .concept-description { background: #d9e8d4; }\n\n    .concept-description::before {\n      content: \"•\";\n      flex: 0 0 auto;\n      margin-right: 5px;\n      font-size: 17px;\n      line-height: 1;\n    }\n  </style>\n</head>\n<body>\n  <main class=\"document\">\n    <header class=\"title\">50个行为经济学概念</header>\n\n    <section class=\"concepts\">\n      <article class=\"concept orange\">\n        <div class=\"concept-name\">\n          <div>内在动机 <span class=\"english\">（Intrinsic<br>Motivation）</span></div>\n        </div>\n        <div class=\"concept-description\">基于内在兴趣和满足感进行行动的动机，而非外部奖励或惩罚。</div>\n      </article>\n\n      <article class=\"concept gray\">\n        <div class=\"concept-name\">\n          <div>比较效用 <span class=\"english\">（Relative<br>Utility）</span></div>\n        </div>\n        <div class=\"concept-description\">人们对于收益和满足感的评估通常是基于相对参照点的比较，而非绝对数值。</div>\n      </article>\n\n      <article class=\"concept yellow\">\n        <div class=\"concept-name\">\n          <div>消费者无知 <span class=\"english\">（Consumer<br>Ignorance）</span></div>\n        </div>\n        <div class=\"concept-description\">消费者对于市场信息和产品特性的缺乏了解，导致决策受到影响。</div>\n      </article>\n\n      <article class=\"concept blue\">\n        <div class=\"concept-name\">\n          <div>合作与竞争 <span class=\"english\">（Cooperation vs.<br>Competition）</span></div>\n        </div>\n        <div class=\"concept-description\">人们在决策和行为中受到与他人合作或竞争的影响，从而改变决策策略。</div>\n      </article>\n\n      <article class=\"concept green\">\n        <div class=\"concept-name\">\n          <div>持续效应 <span class=\"english\">（Sunk Cost<br>Fallacy）</span></div>\n        </div>\n        <div class=\"concept-description\">人们倾向于将过去已经发生的成本视为不可逆转，继续投入资源，即使当前决策并不理性。</div>\n      </article>\n\n      <article class=\"concept orange\">\n        <div class=\"concept-name\">\n          <div>心理账户 <span class=\"english\">（Mental<br>Account）</span></div>\n        </div>\n        <div class=\"concept-description\">人们对于不同资金来源的分配和使用会有不同的偏好和行为，形成不同的心理账户。</div>\n      </article>\n\n      <article class=\"concept gray\">\n        <div class=\"concept-name\">\n          <div>失败回避 <span class=\"english\">（Loss<br>Avoidance）</span></div>\n        </div>\n        <div class=\"concept-description\">人们更倾向于避免损失而非追求收益，因此在决策中可能会选择保守的选择。</div>\n      </article>\n\n      <article class=\"concept yellow\">\n        <div class=\"concept-name\">\n          <div>群体迷思 <span class=\"english\">（Groupthink）</span></div>\n        </div>\n        <div class=\"concept-description\">在群体中，人们为了与他人保持一致和获得认同而放弃独立思考，导致决策偏差。</div>\n      </article>\n\n      <article class=\"concept blue\">\n        <div class=\"concept-name\">\n          <div>时间不一致 <span class=\"english\">（Time<br>Inconsistency）</span></div>\n        </div>\n        <div class=\"concept-description\">人们在时间跨度较长的决策中容易受到即时满足的影响，而忽视长期利益。</div>\n      </article>\n\n      <article class=\"concept green\">\n        <div class=\"concept-name\">\n          <div>心理障碍 <span class=\"english\">（Psychological<br>Barrier）</span></div>\n        </div>\n        <div class=\"concept-description\">人们在决策中受到情绪、态度和信念等心理因素的影响，产生决策偏差。</div>\n      </article>\n    </section>\n  </main>\n</body>\n</html>"
