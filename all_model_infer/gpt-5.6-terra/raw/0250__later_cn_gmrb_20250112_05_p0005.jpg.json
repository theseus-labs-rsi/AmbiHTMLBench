        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>光明日报 2025年1月12日 第05版</title>\n  <script>\n    window.MathJax = {\n      tex: { inlineMath: [['$', '$'], ['\\\\(', '\\\\)']] },\n      svg: { fontCache: 'global' }\n    };\n  </script>\n  <script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js\"></script>\n  <style>\n    * {\n      box-sizing: border-box;\n    }\n\n    html,\n    body {\n      margin: 0;\n      padding: 0;\n      background: #ffffff;\n      color: #222;\n    }\n\n    body {\n      font-family: \"SimSun\", \"宋体\", serif;\n    }\n\n    .page {\n      width: 1220px;\n      min-height: 1720px;\n      margin: 20px auto;\n      padding: 0 20px 24px;\n      position: relative;\n      overflow: hidden;\n    }\n\n    .top-rule {\n      height: 9px;\n      background: #8baaca;\n      margin-bottom: 8px;\n    }\n\n    .masthead {\n      height: 66px;\n      border-bottom: 1px solid #777;\n      display: flex;\n      align-items: center;\n      position: relative;\n    }\n\n    .paper-name {\n      width: 140px;\n      color: #a21c4a;\n      font-family: \"STKaiti\", \"KaiTi\", cursive;\n      font-size: 32px;\n      letter-spacing: 2px;\n      white-space: nowrap;\n    }\n\n    .date-line {\n      align-self: center;\n      font-family: \"SimHei\", sans-serif;\n      font-size: 9px;\n      font-weight: bold;\n      white-space: nowrap;\n    }\n\n    .section-label {\n      position: absolute;\n      top: 0;\n      right: 62px;\n      height: 78px;\n      width: 245px;\n      padding: 13px 25px;\n      color: #7f9dc0;\n      font-family: \"SimHei\", sans-serif;\n      font-size: 42px;\n      font-weight: bold;\n      background: #d7e5f1;\n      clip-path: polygon(0 0, 72% 0, 100% 100%, 14% 100%);\n    }\n\n    .page-number {\n      position: absolute;\n      right: 0;\n      top: 14px;\n      font-family: Arial, sa