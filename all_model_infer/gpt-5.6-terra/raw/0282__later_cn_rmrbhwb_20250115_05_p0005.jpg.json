        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>人民日报·焦点关注 05</title>\n  <script>\n    window.MathJax = { tex: { inlineMath: [['$', '$'], ['\\\\(', '\\\\)']], displayMath: [['$$', '$$'], ['\\\\[', '\\\\]']] } };\n  </script>\n  <script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      background: #fff;\n      color: #222;\n      font-family: \"Songti SC\", \"SimSun\", serif;\n    }\n    .page {\n      width: 800px;\n      min-height: 1226px;\n      margin: 0 auto;\n      padding: 34px 15px 12px;\n      overflow: hidden;\n      position: relative;\n      background:\n        linear-gradient(106deg, transparent 0 6%, rgba(246,235,184,.40) 6.1% 10.5%, transparent 10.6% 29%,\n        rgba(246,235,184,.30) 29.1% 34%, transparent 34.1% 54%,\n        rgba(246,235,184,.30) 54.1% 59%, transparent 59.1% 79%,\n        rgba(246,235,184,.25) 79.1% 84%, transparent 84.1%) 0 72px / 100% 215px no-repeat;\n    }\n    .topline {\n      height: 33px;\n      position: relative;\n      border-bottom: 2px solid #185278;\n      font-family: Arial, \"SimSun\", sans-serif;\n    }\n    .date {\n      position: absolute;\n      top: 7px;\n      left: 7px;\n      font-size: 7px;\n      line-height: 11px;\n      color: #222;\n    }\n    .paper-name {\n      position: absolute;\n      top: -4px;\n      left: 340px;\n      color: #b4001e;\n      font-size: 28px;\n      letter-spacing: 4px;\n      font-family: \"STKaiti\", \"KaiTi\", serif;\n      font-weight: bold;\n      white-space: nowrap;\n    }\n    .paper-name small {\n      font-size: 9px;\n      letter-spacing: 0;\n      vertical-align: top;\n      margin-left: 1px;\n    }\n    .section {\n      position: absolute;\n      right: 45px;\n      top: -1px;\n      background: #15577d;\n      color: whit