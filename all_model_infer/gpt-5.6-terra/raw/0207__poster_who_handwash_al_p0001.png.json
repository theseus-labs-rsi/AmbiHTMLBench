tion\">\n      <div class=\"clock\">◷</div>\n      <div>Kohëzgjatja e gjithë procedurës: <span class=\"muted\">40 – 60 sekonda</span></div>\n    </section>\n\n    <section class=\"steps\">\n      <article class=\"step\">\n        <div class=\"image\"><div class=\"number\">0</div><div class=\"placeholder\">[Diagram: washing hands with water at a sink]</div></div>\n        <p class=\"caption\">Lagini duart me ujë;</p>\n      </article>\n      <article class=\"step\">\n        <div class=\"image\"><div class=\"number\">1</div><div class=\"placeholder\">[Diagram: applying soap from dispenser]</div></div>\n        <p class=\"caption\">Vendosni mjaft sapun që të mbulohet e gjithë sipërfaqja e dorës;</p>\n      </article>\n      <article class=\"step\">\n        <div class=\"image\"><div class=\"number\">2</div><div class=\"placeholder\">[Diagram: rubbing palms together]</div></div>\n        <p class=\"caption\">Fërkojini duart pëllëmbë me pëllëmbë;</p>\n      </article>\n      <article class=\"step\">\n        <div class=\"image\"><div class=\"number\">3</div><div class=\"placeholder\">[Diagram: palm over back of opposite hand with interlaced fingers]</div></div>\n        <p class=\"caption\">Pëllëmba e djathtë mbi shpinën e së majtës me gishtat e gërshetuar dhe anasjelltas;</p>\n      </article>\n      <article class=\"step\">\n        <div class=\"image\"><div class=\"number\">4</div><div class=\"placeholder\">[Diagram: palm to palm with fingers interlaced]</div></div>\n        <p class=\"caption\">Pëllëmbë me pëllëmbë me gishtat e gërshetuar;</p>\n      </article>\n      <article class=\"step\">\n        <div class=\"image\"><div class=\"number\">5</div><div class=\"placeholder\">[Diagram: backs of fingers against opposing palms]</div></div>\n        <p class=\"caption\">Shpinën e gishtave kundër pëllëmbëve me gishtat e gërshetuar;</p>\n      </article>\n      <article class=\"step\">\n        <div class=\"image\"><div class=\"number\">6</div><div class=\"placeholder\">[Diagram: rotational rubbing of left thumb]</div></div>\n        <p class=\"caption\">Fërkim rrotullues i gishtit të madh të majtë duke e shtrënguar në pëllëmbën e djathtë dhe anasjelltas;</p>\n      </article>\n      <article class=\"step\">\n        <div class=\"image\"><div class=\"number\">7</div><div class=\"placeholder\">[Diagram: rotational rubbing of fingertips in palm]</div></div>\n        <p class=\"caption\">Fërkim rrotullues, prapa dhe përpara me gishtat e shtrënguar të dorës së djathtë në pëllëmbën e majtë dhe anasjelltas;</p>\n      </article>\n      <article class=\"step\">\n        <div class=\"image\"><div class=\"number\">8</div><div class=\"placeholder\">[Diagram: rinsing hands with water at a tap]</div></div>\n        <p class=\"caption\">Shpëlaji duart me ujë;</p>\n      </article>\n      <article class=\"step\">\n        <div class=\"image\"><div class=\"number\">9</div><div class=\"placeholder\">[Diagram: drying hands thoroughly with a single-use towel]</div></div>\n        <p class=\"caption\">Thaji duart tërësisht me peshqir për një përdorim;</p>\n      </article>\n      <article class=\"step\">\n        <div class=\"image\"><div class=\"number\">10</div><div class=\"placeholder\">[Diagram: using towel to turn off tap]</div></div>\n        <p class=\"caption\">Përdore peshqirin për ta ndalur rubinetin;</p>\n      </article>\n      <article class=\"step\">\n        <div class=\"image\"><div class=\"number\">11</div><div class=\"placeholder\">[Diagram: clean hands]</div></div>\n        <p class=\"caption\">Duart tuaja tash janë të sigurta.</p>\n      </article>\n    </section>\n\n    <footer class=\"footer\">\n      <div class=\"orange\">\n        <div class=\"seal\">[Emblem]</div>\n        MINISTRIA E<br>SHËNDETËSISË\n      </div>\n      <div class=\"gray-footer\">\n        5 momentet e mia për higjienë të duarve<br>\n        ‘Bazuar në: ’My 5 moments for Hand Hygiene’,<br>\n        URL: http://www.who.int/gpsc/5may/background/5moments/en/in