rflow: hidden;\n      color: rgba(240, 240, 235, .72);\n      text-align: center;\n      font-family: Arial, sans-serif;\n      font-size: 12px;\n    }\n    .crowd {\n      height: 1015px;\n      background:\n        linear-gradient(0deg, rgba(7,8,8,.95) 0 19%, transparent 19%),\n        radial-gradient(ellipse at 18% 55%, #e7e6de 0 4%, #151616 4.5% 8%, transparent 8.5%),\n        radial-gradient(ellipse at 39% 51%, #dddcd5 0 4.5%, #121313 5% 8%, transparent 8.5%),\n        radial-gradient(ellipse at 63% 61%, #e6e4dc 0 4%, #141515 4.5% 8%, transparent 8.5%),\n        radial-gradient(ellipse at 82% 53%, #e2e0d8 0 5%, #151616 5.5% 9%, transparent 9.5%),\n        repeating-radial-gradient(ellipse at 50% 68%, #171818 0 14px, #cbc9c1 15px 31px, #1b1c1c 32px 48px);\n      background-color: #a8a7a0;\n    }\n    .banner {\n      position: absolute;\n      top: 0;\n      right: -2%;\n      width: 46%;\n      height: 52%;\n      transform: rotate(7deg);\n      background: #ae272b;\n      border-left: 7px solid #351719;\n      box-shadow: -6px 9px 0 rgba(0,0,0,.36);\n    }\n    .banner::before,\n    .banner::after {\n      content: \"\";\n      position: absolute;\n      left: 3%;\n      width: 104%;\n      height: 12%;\n      border-radius: 48% 18% 38% 24%;\n      background: #e9e8df;\n    }\n    .banner::before { top: 12%; transform: rotate(-4deg); }\n    .banner::after { top: 31%; transform: rotate(2deg); }\n    .photo-label {\n      position: absolute;\n      left: 12px;\n      top: 12px;\n      padding: 3px 5px;\n      background: rgba(0,0,0,.38);\n      font-size: 10px;\n    }\n    .footer {\n      min-height: 112px;\n      padding: 13px 40px 10px 58px;\n      color: #a92e33;\n      font-size: clamp(20px, 2.75vw, 31px);\n      font-weight: 700;\n      line-height: 1.01;\n      letter-spacing: .2px;\n    }\n    .author {\n      font-family: Arial, sans-serif;\n      font-size: .42em;\n      vertical-align: middle;\n      color: #b24647;\n    }\n    @media (max-width: 600p