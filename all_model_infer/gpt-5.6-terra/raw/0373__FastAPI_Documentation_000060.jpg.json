ormal; }\n    .shortcut { margin-left:auto; padding:3px 5px; background:#00685e; font-size:10px; border-radius:2px; }\n    .github { font-size:13px; line-height:17px; }\n    .github b { font-size:21px; float:left; margin-right:7px; }\n    .github small { color:#b6ddd8; }\n    .nav { height:43px; display:flex; align-items:center; gap:28px; color:#bbdfda; }\n    .nav span:first-child, .nav span:nth-child(3) { color:white; }\n    .page { width:1202px; margin:0 auto; display:grid; grid-template-columns:220px 690px 225px; column-gap:30px; padding-top:53px; }\n    .sidebar { font-size:14px; line-height:1.25; }\n    .sidebar .learn { font-weight:bold; margin-bottom:10px; }\n    .side-item { margin:0 0 10px 0; }\n    .side-item.indent { margin-left:12px; }\n    .side-item.current { color:#009688; }\n    .chev { float:right; font-size:21px; line-height:12px; margin-right:5px; }\n    .main { padding-bottom:40px; }\n    .crumbs { color:#777; font-size:14px; margin:1px 0 21px; }\n    .crumbs span { margin:0 8px; color:#aaa; }\n    h1 { font-size:31px; font-weight:300; color:#707070; margin:0 0 44px; line-height:1.1; }\n    h2 { font-size:24px; font-weight:400; margin:46px 0 20px; color:#222; }\n    p { font-size:16px; line-height:1.55; margin:0 0 17px; }\n    a { border-bottom:1px dotted #555; color:inherit; text-decoration:none; }\n    code { font-family:\"Courier New\", monospace; background:#edf0f1; padding:2px 4px; color:#4b555a; font-size:14px; }\n    .toc { color:#222; font-size:14px; }\n    .toc-title { font-weight:bold; color:#777; margin:2px 0 11px; }\n    .toc div { margin:0 0 11px; line-height:1.15; }\n    .toc .sub { margin-left:13px; }\n    .toc .sub2 { margin-left:26px; }\n    .code-label { height:29px; padding:6px 15px; font-weight:bold; font-size:12px; border-bottom:2px solid #222; width:109px; margin-top:27px; }\n    pre { position:relative; width:689px; height:746px; margin:0; padding:14px 15px; overflow:hidden; background:#f6f6f6; color:#4c555a; font:14px/19px \"Courier New\", monospace; white-space:pre; }\n    pre:before { content:\"\"; position:absolute; left:0; top:144px; height:20px; border-left:2px solid #2196f3; }\n    pre:after { content:\"□\"; position:absolute; top:13px; right:14px; color:#ddd; font-size:20px; }\n    .blue { color:#4276aa; } .purple { color:#a34ca0; } .green { color:#287d5d; } .string { color:#247f5d; }\n    .ask { position:fixed; right:35px; bottom:19px; width:61px; height:61px; border-radius:50%; background:#00a394; color:white; box-shadow:0 2px 8px #aaa; display:flex; flex-direction:column; align-items:center; justify-content:center; font-size:11px; }\n    .ask b { font-size:21px; line-height:22px; }\n  </style>\n</head>\n<body>\n  <div class=\"topbar\">\n    <span class=\"conf\">▣ FastAPI Conf '26</span>&nbsp;— Oct 28, 2026, Amsterdam&nbsp; 🎤\n    <div class=\"sponsor\"><small>sponsor</small>BlockBee&nbsp;&nbsp; <span style=\"font-size:12px;color:#b59300\">Effortless crypto payments<br>with instant payouts</span></div>\n  </div>\n\n  <header class=\"header\">\n    <div class=\"header-inner\">\n      <div class=\"head-top\">\n        <div class=\"bolt\">⚡</div><div class=\"brand\">FastAPI</div>\n        <div class=\"tools\">\n          <div>◕<sub>A</sub></div>\n          <div class=\"translate\">文</div>\n          <div class=\"search\"><strong>⌕</strong> Search <span class=\"shortcut\">⌘K</span></div>\n          <div class=\"github\"><b>◉</b> fastapi/fastapi<br><small>◇ 0.136.1　☆ 98.4k　⌘ 9.3k</small></div>\n        </div>\n      </div>\n      <div class=\"nav\">\n        <span>FastAPI</span><span>Features</span><span>Learn</span><span>Reference</span><span>FastAPI People</span><span>Resources</span><span>About</span><span>Release Notes</span>\n      </div>\n    </div>\n  </header>\n\n  <div class=\"page\">\n    <aside class=\"sidebar\">\n      <div class=\"learn\">Learn</div>\n      <div class=\"side-item\">Python Types Intro</div>\n      <div class=\"side-item\">Concurrency and async / await</div>\n      <div class=\"side-item\">Environment Variables</div>\n      <div class=\"side-item\">Virtual Environments</div>\n      <div class=\"side-item\">Tutorial - User Guide <span class=\"chev\">›</span></div>\n      <div class=\"side-item\">Advanced User Guide <span class=\"chev\">›</span></div>\n      <div class=\"side-item\">FastAPI CLI</div>\n      <div class=\"side-item\">Editor Support</div>\n      <div class=\"side-item\">Deployment <span class=\"chev\">›</span></div>\n      <div class=\"side-item\">How To - Recipes <span class=\"chev\">⌄</span></div>\n      <div class=\"side-item indent\">General - How To - Recipes</div>\n      <div class=\"side-item indent\">Migrate from Pydantic v1 to<br>Pydantic v2</div>\n      <div class=\"side-item indent\">GraphQL</div>\n      <div class=\"side-item indent\">Custom Request and APIRoute<br>class</div>\n      <div class=\"side-item indent\">Conditional OpenAPI</div>\n      <div class=\"side-item indent\">Extending OpenAPI</div>\n      <div class=\"side-item indent\">Separate OpenAPI Schemas for<br>Input and Output or Not</div>\n      <div class=\"side-item indent current\">Custom Docs UI Static Assets<br>(Self-Hosting)</div>\n      <div class=\"side-item indent\">Configure Swagger UI</div>\n      <div class=\"side-item indent\">Testing a Database</div>\n      <div class=\"side-item indent\">Use OAuth2 Authentication<br>Error Status Codes</div>\n    </aside>\n\n    <main class=\"main\">\n      <div class=\"crumbs\">FastAPI <span>▫</span> › <span>Learn</span> ▫ › <span>How To - Recipes</span> ▫</div>\n      <h1>Custom Docs UI Static Assets (Self-Hosting)</h1>\n\n      <p>The API docs use <b>Swagger UI</b> and <b>ReDoc</b>, and each of those need some JavaScript and CSS<br>files.</p>\n      <p>By default, those files are served from a <a>CDN</a>.</p>\n      <p>But it's possible to customize it, you can set a specific CDN, or serve the files yourself.</p>\n\n      <h2>Custom CDN for JavaScript and CSS</h2>\n      <p>Let's say that you want to use a different <a>CDN</a>, for example you want to use<br><code>https://unpkg.com/</code>.</p>\n      <p>This could be useful if for example you live in a country that restricts some URLs.</p>\n\n      <h2>Disable the automatic docs</h2>\n      <p>The first step is to disable the automatic docs, as by default, those use the default CDN.</p>\n      <p>To disable them, set their URLs to <code>None</code> when creating your <code>FastAPI</code> app:</p>\n\n      <div class=\"code-label\">Python 3.10+</div>\n      <pre><span class=\"blue\">from</span> <span class=\"purple\">fastapi</span> <span class=\"blue\">import</span> FastAPI\n<span class=\"blue\">from</span> <span class=\"purple\">fastapi.openapi.docs</span> <span class=\"blue\">import</span> (\n    get_redoc_html,\n    get_swagger_ui_html,\n    get_swagger_ui_oauth2_redirect_html,\n)\n\napp = FastAPI(docs_url=None, redoc_url=None)\n\n\n<span class=\"blue\">@app</span>.get(<span class=\"string\">\"/docs\"</span>, include_in_schema=False)\n<span class=\"blue\">async def</span> <span class=\"purple\">custom_swagger_ui_html</span>():\n    <span class=\"blue\">return</span> get_swagger_ui_html(\n        openapi_url=app.openapi_url,\n        title=app.title + <span class=\"string\">\" - Swagger UI\"</span>,\n        oauth2_redirect_url=app.swagger_ui_oauth2_redirect_url,\n        swagger_js_url=<span class=\"string\">\"https://unpkg.com/swagger-ui-dist@5/swagger-ui-bundle.js\"</span>,\n        swagger_css_url=<span class=\"string\">\"https://unpkg.com/swagger-ui-dist@5/swagger-ui.css\"</span>,\n    )\n\n\n<span class=\"blue\">@app</span>.get(app.swagger_ui_oauth2_redirect_url, include_in_schema=False)\n<span class=\"blue\">async def</span> <span class=\"purple\">swagger_ui_redirect</span>():\n    <span class=\"blue\">return</span> get_swagger_ui_oauth2_redirect_html()\n\n\n<span class=\"blue\">@app</span>.get(<span class=\"string\">\"/redoc\"</span>, include_in_schema=False)\n<span class=\"blue\">async def</span> <span class=\"purple\">redoc_html</span>():\n    <span class=\"blue\">return</span> get_redoc_html(\n        openapi_url=app.openapi_url,\n        title=app.title + <span class=\"string\">\" - ReDoc\"</span>,\n        redoc_js_url=<span class=\"string\">\"https://unpkg.com/redoc@2/bundles/redoc.standalone.js\"</span>,\n    )\n\n\n<span class=\"blue\">@app</span>.get(<span class=\"string\">\"/users/{username}\"</span>)\n<span class=\"blue\">async def</span> read_user(username: str):\n    <span class=\"blue\">return</span> {<span class=\"string\">\"message\"</span>: f<span class=\"string\">\"Hello {username}\"</span>}</pre>\n    </main>\n\n    <aside class=\"toc\">\n      <div class=\"toc-title\">On this page</div>\n      <div>Custom CDN for JavaScript and<br>CSS</div>\n      <div class=\"sub\">Disable the automatic docs</div>\n      <div class=\"sub\">Include the custom docs</div>\n      <div class=\"sub\">Create a <i>path</i> operation to test it</div>\n      <div class=\"sub\">Test it</div>\n      <div>Self-hosting JavaScript and CSS<br>for docs</div>\n      <div class=\"sub\">Project file structure</div>\n      <div class=\"sub\">Download the files</div>\n      <div class=\"sub\">Serve the static files</div>\n      <div class=\"sub\">Test the static files</div>\n      <div class=\"sub\">Disable the automatic docs for<br>static files</div>\n      <div class=\"sub\">Include the custom docs for<br>static files</div>\n      <div class=\"sub\">Create a <i>path</i> operation to test<br>static files</div>\n      <div class=\"sub\">Test Static Files UI</div>\n    </aside>\n  </div>\n  <div class=\"ask\"><b>♙</b>Ask AI</div>\n</body>\n</html>"
