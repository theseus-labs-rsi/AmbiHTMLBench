lower p { margin-bottom: 6px; }\n    .arrow {\n      position: absolute;\n      left: 248px;\n      top: 453px;\n      height: 56px;\n      width: 18px;\n      color: #444;\n      font-size: 28px;\n      line-height: 45px;\n      text-align: center;\n    }\n    .arrow:before {\n      content: \"\";\n      position: absolute;\n      left: 4px;\n      top: 0;\n      width: 10px;\n      height: 44px;\n      border-left: 1px solid #555;\n      border-bottom: 1px solid #555;\n    }\n    .footer {\n      position: absolute;\n      z-index: 1;\n      bottom: 18px;\n      left: 34px;\n      right: 34px;\n      font-family: Arial, sans-serif;\n      font-size: 6px;\n      color: #777;\n    }\n    .page-no {\n      color: #222;\n      font-size: 11px;\n      margin-right: 13px;\n    }\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <div class=\"watermark\" aria-hidden=\"true\">\n      <span class=\"w1\">学术期刊网</span><span class=\"w2\">学术期刊网</span><span class=\"w3\">学术期刊网</span>\n      <span class=\"w4\">学术期刊网</span><span class=\"w5\">学术期刊网</span><span class=\"w6\">学术期刊网</span>\n      <span class=\"w7\">学术期刊网</span><span class=\"w8\">学术期刊网</span><span class=\"w9\">学术期刊网</span>\n      <span class=\"w10\">学术期刊网</span><span class=\"w11\">学术期刊网</span><span class=\"w12\">学术期刊网</span>\n    </div>\n\n    <div class=\"content\">\n      <header>案例与思考 CASE AND CONSIDERATION</header>\n      <div class=\"top-space\"></div>\n\n      <section class=\"upper\">\n        <div class=\"diagram\">\n          <svg class=\"flow-svg\" viewBox=\"0 0 231 168\" role=\"img\" aria-label=\"[图表：课程实施流程图]\">\n            <defs>\n              <marker id=\"arrowhead\" markerWidth=\"5\" markerHeight=\"5\" refX=\"4\" refY=\"2.5\" orient=\"auto\">\n                <path d=\"M0,0 L5,2.5 L0,5 Z\" fill=\"#555\"></path>\n              </marker>\n            </defs>\n            <rect x=\"7\" y=\"0\" width=\"52\" height=\"17\" rx=\"2\" fill=\"#727981\"></rect>\n            <text x=\"33\" y=\"11\" text-anchor=\"middle\" fill=\"#fff\">总体支持策略</text>\n            <rect x=\"84\" y=\"0\" width=\"38\" height=\"17\" rx=\"2\" fill=\"#727981\"></rect>\n            <text x=\"103\" y=\"11\" text-anchor=\"middle\" fill=\"#fff\">课程</text>\n            <rect x=\"160\" y=\"0\" width=\"52\" height=\"17\" rx=\"2\" fill=\"#727981\"></rect>\n            <text x=\"186\" y=\"11\" text-anchor=\"middle\" fill=\"#fff\">课程实施策略</text>\n\n            <rect x=\"4\" y=\"33\" width=\"59\" height=\"24\" rx=\"3\" fill=\"#fff\" stroke=\"#555\"></rect>\n            <text x=\"33\" y=\"43\" text-anchor=\"middle\">支持幼儿</text><text x=\"33\" y=\"51\" text-anchor=\"middle\">自主探究活动</text>\n            <rect x=\"4\" y=\"65\" width=\"59\" height=\"24\" rx=\"3\" fill=\"#fff\" stroke=\"#555\"></rect>\n            <text x=\"33\" y=\"75\" text-anchor=\"middle\">创设幼儿</text><text x=\"33\" y=\"83\" text-anchor=\"middle\">充分活动空间</text>\n            <rect x=\"4\" y=\"97\" width=\"59\" height=\"24\" rx=\"3\" fill=\"#fff\" stroke=\"#555\"></rect>\n            <text x=\"33\" y=\"107\" text-anchor=\"middle\">提供幼儿</text><text x=\"33\" y=\"115\" text-anchor=\"middle\">探究空间</text>\n            <rect x=\"4\" y=\"129\" width=\"59\" height=\"33\" rx=\"3\" fill=\"#fff\" stroke=\"#555\"></rect>\n            <text x=\"33\" y=\"140\" text-anchor=\"middle\">以一系列由</text><text x=\"33\" y=\"148\" text-anchor=\"middle\">不同活动组成的</text><text x=\"33\" y=\"156\" text-anchor=\"middle\">开放探究空间</text>\n\n            <path d=\"M33 17 V28 M33 28 H63 M33 28 H4\" fill=\"none\" stroke=\"#555\" stroke-dasharray=\"2 2\"></path>\n            <path d=\"M33 57 V65 M33 89 V97 M33 121 V129\" fill=\"none\" stroke=\"#555\" marker-end=\"url(#arrowhead)\"></path>\n\n            <rect x=\"79\" y=\"33\" width=\"52\" height=\"18\" fill=\"#fff\" stroke=\"#555\"></rect>\n            <text x=\"105\" y=\"44\" text-anchor=\"middle\">预设导读过程</text>\n            <rect x=\"79\" y=\"59\" width=\"52\" height=\"18\" fill=\"#fff\" stroke=\"#555\"></rect>\n            <text x=\"105\" y=\"70\" text-anchor=\"middle\">PVC管螺纹</text>\n            <rect x=\"79\" y=\"85\" width=\"52\" height=\"18\" fill=\"#fff\" stroke=\"#555\"></rect>\n            <text x=\"105\" y=\"96\" text-anchor=\"middle\">石头城堡</text>\n            <rect x=\"79\" y=\"111\" width=\"52\" height=\"18\" fill=\"#fff\" stroke=\"#555\"></rect>\n            <text x=\"105\" y=\"122\" text-anchor=\"middle\">塑料吸管</text>\n            <rect x=\"79\" y=\"137\" width=\"52\" height=\"18\" fill=\"#fff\" stroke=\"#555\"></rect>\n            <text x=\"105\" y=\"148\" text-anchor=\"middle\">水流迷宫</text>\n            <path d=\"M105 17 V33 M105 51 V59 M105 77 V85 M105 103 V111 M105 129 V137\" fill=\"none\" stroke=\"#555\" marker-end=\"url(#arrowhead)\"></path>\n\n            <rect x=\"140\" y=\"23\" width=\"88\" height=\"27\" fill=\"#fff\" stroke=\"#555\"></rect>\n            <text x=\"143\" y=\"29\">利用幼儿已有生活经验，提出问题，</text><text x=\"143\" y=\"35\">引导、支持、鼓励幼儿自主探究，</text><text x=\"143\" y=\"41\">发现、思考，解决问题。</text>\n            <rect x=\"140\" y=\"54\" width=\"88\" height=\"27\" fill=\"#fff\" stroke=\"#555\"></rect>\n            <text x=\"143\" y=\"60\">提供相应材料，引导幼儿在操作中</text><text x=\"143\" y=\"66\">发现问题，产生探究兴趣，形成初步</text><text x=\"143\" y=\"72\">的科学探究意识。</text>\n            <rect x=\"140\" y=\"85\" width=\"88\" height=\"27\" fill=\"#fff\" stroke=\"#555\"></rect>\n            <text x=\"143\" y=\"91\">师生共同观察活动现象，鼓励幼儿</text><text x=\"143\" y=\"97\">大胆猜想，进行实验验证，提升解决</text><text x=\"143\" y=\"103\">问题的能力。</text>\n            <rect x=\"140\" y=\"116\" width=\"88\" height=\"39\" fill=\"#fff\" stroke=\"#555\"></rect>\n            <text x=\"143\" y=\"122\">针对幼儿在活动中发现的问题，引导</text><text x=\"143\" y=\"128\">幼儿积极探索，合作交流，并在操作</text><text x=\"143\" y=\"134\">中获得经验；教师及时观察、指导，</text><text x=\"143\" y=\"140\">帮助幼儿完成探究活动。</text>\n            <path d=\"M131 42 H140 M131 68 H140 M131 94 H140 M131 120 H140\" fill=\"none\" stroke=\"#555\" marker-end=\"url(#arrowhead)\"></path>\n          </svg>\n        </div>\n\n        <div class=\"upper-text\">\n          <p>能力；帮助幼儿不断积累经验，并运用于新的学习活动。幼儿是经常会的学习者和创造者。在本次探究活动中，幼儿5次尝试解决同一个问题，接连失败经验，但是始终积极面对了教师以幼儿为主体的正确理念。教师应在幼儿的身后，扶持他的观念中重视幼儿的兴趣和需要，乐于支持幼儿投入探究过程中，尽管最后解决问题的方法缺乏挑战性，但是教师能正确认识到，教师的一次次探究过程会使幼儿的学习与发展创造了丰富的教育机会。在整个活动中，用木棍理于地底下这一策略在如电于高、有趣的探究过程中显得不那么重要，这其中教师对于幼儿年龄特点的正确理解。</p>\n        </div>\n      </section>\n\n      <section class=\"middle\">\n        <div class=\"left-copy\">\n          <p>开展。幼儿在多次探究中尝试解决“弹弹池”中水消失的问题。整个探究活动包含较多的幼儿深度学习的过程，例如她们尝试“弹弹池”，制作生态管理，本意入沙子的阻隔与共享。</p>\n          <p><strong>注重自然、游戏和生活。</strong>本次活动在户外的水区开展，是幼儿亲近自然的重要机会。幼儿与沙、水、石头等自然资源进行了有效的互动，感受到了自然物的基本属性和特点。户外场地具有更直观的活动空间，为幼儿充分发挥生活经验打下基础。</p>\n          <p>学习发展，清晰可见。中班幼儿的各项能力水平有限，在解决问题中表现出的认知和操作技能的发展是明显的。幼儿在多次尝试发展仍然坚持不懈地投入探究中去，是本次活动最主要的亮点。除此之外，幼儿能常常活动地联系物体和材料并乐在其中，能对事物或现象进行观察比较并发表其观点，能根据观察结果提出问题并大胆猜猜答案。能用图画或其他符号进行记录，这些都达到了（3－6岁儿童学习与发展指南》中的发展目标。</p>\n        </div>\n\n        <div class=\"right-figure\">\n          <div class=\"figure-title\">师幼同伴<br>欢乐于海洋池</div>\n          <svg class=\"small-flow\" viewBox=\"0 0 170 68\" role=\"img\" aria-label=\"[流程图：游戏规则与活动区域]\">\n            <defs>\n              <marker id=\"smallarrow\" markerWidth=\"5\" markerHeight=\"5\" refX=\"4\" refY=\"2.5\" orient=\"auto\">\n                <path d=\"M0,0 L5,2.5 L0,5 Z\" fill=\"#555\"></path>\n              </marker>\n            </defs>\n            <rect x=\"3\" y=\"27\" width=\"47\" height=\"16\" fill=\"#fff\" stroke=\"#777\"></rect>\n            <text x=\"26\" y=\"37\" text-anchor=\"middle\" font-size=\"6\">幼儿规则</text>\n            <rect x=\"65\" y=\"27\" width=\"47\" height=\"16\" fill=\"#fff\" stroke=\"#777\"></rect>\n            <text x=\"88\" y=\"37\" text-anchor=\"middle\" font-size=\"6\">活动区域</text>\n            <rect x=\"116\" y=\"10\" width=\"52\" height=\"15\" fill=\"#fff\" stroke=\"#777\"></rect>\n            <text x=\"142\" y=\"19\" text-anchor=\"middle\" font-size=\"5\">水池墙：长方形水池</text>\n            <rect x=\"116\" y=\"43\" width=\"52\" height=\"15\" fill=\"#fff\" stroke=\"#777\"></rect>\n            <text x=\"142\" y=\"52\" text-anchor=\"middle\" font-size=\"5\">陆地：最基本的游戏区</text>\n            <path d=\"M26 0 V27 M50 35 H65 M112 35 H116 V18 M112 35 H116 V51\" fill=\"none\" stroke=\"#555\" marker-end=\"url(#smallarrow)\"></path>\n          </svg>\n          <table>\n            <tr><th>区域</th><th>探究活动</th><th>探究结果</th></tr>\n            <tr><td>水池区</td><td>观察水的流动</td><td>水流需要一定的坡度</td></tr>\n            <tr><td>材料区</td><td>PVC管螺纹、塑料吸管</td><td>水能通过不同材料流动</td></tr>\n            <tr><td>建构区</td><td>用石头搭建水流通道</td><td>水流沿着通道进入水中</td></tr>\n            <tr><td>合作区</td><td>探索不同的组合方式</td><td>共同解决问题</td></tr>\n          </table>\n        </div>\n      </section>\n\n      <div class=\"arrow\">↓</div>\n\n      <section class=\"lower\">\n        <div class=\"left-lower\">\n          <div class=\"section-heading\">2. 教师的支持策略分析。</div>\n          <p>《3－6岁儿童学习与发展指南》中明确指出，幼儿科学的核心是激发探究兴趣，体验探究过程，发展初步的探究能力。成人要善于发现和保护幼儿的好奇心。充分利用自然和实际生活机会，引导幼儿通过观察、比较、操作、实验等方法，掌握科学探究问题，分析问题和解决问题。</p>\n        </div>\n        <div class=\"right-lower\">\n          <div class=\"section-heading\">幼儿的发展</div>\n          <p>本次项目活动在海滨弹生物的讨论中，幼儿形成了“海洋池”的共同愿景。幼儿通过“弹弹池”玩水、位置的构思规划到了本次活动的探究方向。随后师幼的4次失败和1次成功，凸显了幼儿在活动中所拥有的积极主动、认真专注、不怕困难、敢于探究和尝试、乐于想象和创造等良好学习品质，围绕沙子的渗水性、幼儿从发现问题，到提出解决方法，在一次次的实践中总结经验。尽管最终提出的解决方案是“投放水子”的。但是幼儿在整个活动中表现出的探究学习是显而易见的。他们能认真参与问题、新问题和解决问题的思维是清晰的。</p>\n        </div>\n      </section>\n    </div>\n\n    <footer class=\"footer\">\n      <span class=\"page-no\">52</span>\n      <span>中幼儿 100　2020/09</span><br>\n      <span>©1994-2022 China Academic Journal Electronic Publishing House. All rights reserved.　http://www.cnki.net</span>\n    </footer>\n  </main>\n</body>\n</html>"
      },
