        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>案例与思考</title>\n  <script>\n    window.MathJax = { tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] } };\n  </script>\n  <script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      background: #ececec;\n      font-family: \"SimSun\", \"Songti SC\", serif;\n      color: #333;\n    }\n    .page {\n      position: relative;\n      width: 540px;\n      height: 760px;\n      margin: 0 auto;\n      padding: 48px 34px 20px;\n      overflow: hidden;\n      background: #fff;\n      font-size: 8px;\n      line-height: 1.55;\n    }\n    .watermark {\n      position: absolute;\n      inset: 0;\n      pointer-events: none;\n      overflow: hidden;\n      color: rgba(133, 165, 157, .13);\n      font-family: sans-serif;\n      font-weight: bold;\n      font-size: 22px;\n    }\n    .watermark span {\n      position: absolute;\n      transform: rotate(-28deg);\n      white-space: nowrap;\n    }\n    .w1 { top: 5px; left: -23px; }\n    .w2 { top: 4px; left: 156px; }\n    .w3 { top: 6px; left: 364px; }\n    .w4 { top: 193px; left: -18px; }\n    .w5 { top: 197px; left: 178px; }\n    .w6 { top: 196px; left: 373px; }\n    .w7 { top: 390px; left: -34px; }\n    .w8 { top: 390px; left: 161px; }\n    .w9 { top: 390px; left: 362px; }\n    .w10 { top: 587px; left: -18px; }\n    .w11 { top: 587px; left: 179px; }\n    .w12 { top: 588px; left: 372px; }\n    .content { position: relative; z-index: 1; }\n    header {\n      height: 21px;\n      border-top: 1px solid #91c6ae;\n      border-bottom: 1px solid #c4d8ca;\n      padding-top: 3px;\n      font-family: Arial, \"Microsoft YaHei\", sans-serif;\n      font-size: 9px;\n      font-weight: 700;\n    }\n    .top-space { height: 98px; }\n    .upp