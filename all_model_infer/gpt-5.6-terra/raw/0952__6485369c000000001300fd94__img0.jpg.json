radient(#57771d, #688824);\n      font-weight: bold;\n      font-size: 19px;\n      letter-spacing: .5px;\n    }\n    .chapter span {\n      margin-right: 8px;\n      font-size: 22px;\n    }\n    h2 {\n      margin: 0 0 7px;\n      color: #55762a;\n      font-size: 15px;\n      letter-spacing: .4px;\n    }\n    .intro ul, .tips ul {\n      margin: 0;\n      padding-left: 15px;\n      font-size: 11px;\n      line-height: 1.55;\n      color: #606254;\n    }\n    .intro { margin-bottom: 15px; }\n    .tiny-note {\n      margin: 0 0 8px;\n      font-size: 10px;\n      color: #636554;\n    }\n    .dish-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      column-gap: 14px;\n      row-gap: 5px;\n      width: 305px;\n      margin: 3px 0 18px 4px;\n    }\n    .dish:nth-child(4) { grid-column: 1 / 2; margin-left: 30px; }\n    .dish:nth-child(5) { grid-column: 2 / 3; margin-left: 13px; }\n    .dish {\n      text-align: center;\n      font-size: 9px;\n      color: #67685a;\n    }\n    .food {\n      width: 75px;\n      height: 50px;\n      border-radius: 50%;\n      margin: 0 auto 2px;\n      border: 1px solid #bebcab;\n      background-color: #d2cfbd;\n      background-repeat: no-repeat;\n      box-shadow: inset 0 1px 3px rgba(0,0,0,.2);\n      position: relative;\n      overflow: hidden;\n    }\n    .food:after {\n      content: \"\";\n      position: absolute;\n      inset: 7px 13px;\n      border-radius: 50%;\n      background: rgba(66,48,30,.65);\n    }\n    .food.rice:after { background: radial-gradient(ellipse, #e2d4b3 0 23%, #8d6d4d 26% 56%, #e9e1cc 59%); }\n    .food.noodle:after { background: radial-gradient(ellipse, #a77946 0 17%, #dfc487 20% 38%, #73553c 41%); }\n    .food.meat:after { background: radial-gradient(ellipse, #d8bd73 0 18%, #947149 22% 45%, #504433 48%); }\n    .food.veg:after { background: radial-gradient(ellipse, #437037 0 25%, #b44429 28% 35%, #1d4825 38%); }\n    .food.pumpkin:after { background: radial-gradient(ellipse, #e69b16 0 32%, #8f682d 35% 48%, #493e29 50%); }\n    .tips { margin-top: 3px; }\n    .tip-columns {\n      display: grid;\n      grid-template-columns: 115px 1fr;\n      gap: 7px;\n      font-size: 10px;\n      line-height: 1.58;\n      color: #5f6152;\n    }\n    .tip-columns ul { margin: 0; padding-left: 14px; }\n    .food-list p { margin: 0; }\n    .bottom-band {\n      position: absolute;\n      left: 37px;\n      right: 33px;\n      bottom: 20px;\n      height: 17px;\n      padding: 2px 7px;\n      background: #bfd072;\n      color: #5a6738;\n      font-size: 9px;\n    }\n    .recipe-title {\n      margin: -12px 0 10px;\n      font-size: 13px;\n      color: #55762a;\n      font-weight: bold;\n    }\n    .recipe {\n      position: relative;\n      padding: 0 4px 12px;\n      margin-bottom: 7px;\n      border-bottom: 1px solid #d7d6c6;\n      min-height: 131px;\n    }\n    .recipe:last-child { border-bottom: none; }\n    .label {\n      display: inline-block;\n      margin: 0 0 4px -3px;\n      padding: 2px 12px 2px 8px;\n      border-radius: 11px 15px 15px 11px;\n      background: #698b2f;\n      color: #f4f5db;\n      font-size: 11px;\n      font-weight: bold;\n    }\n    .ingredients {\n      margin: 0 0 3px;\n      font-size: 10px;\n      color: #5f6153;\n      line-height: 1.4;\n    }\n    .method {\n      margin: 0;\n      padding-left: 20px;\n      font-size: 10px;\n      line-height: 1.55;\n      color: #55574c;\n    }\n    .method li { padding-left: 2px; }\n    .green-strip {\n      height: 13px;\n      margin: -2px 0 8px;\n      background: #c5d67d;\n      opacity: .9;\n    }\n  </style>\n</head>\n<body>\n  <main class=\"spread\">\n    <section class=\"page left-page\">\n      <div class=\"chapter\"><span>11</span>肉鸽金的精食攻略</div>\n\n      <section class=\"intro\">\n        <h2>选择原则</h2>\n        <ul>\n          <li>鸽肉应色泽鲜亮，肉质细嫩，保证营养摄入量</li>\n          <li>注意为宝宝选择容易消化吸收、敏感性小的食谱</li>\n          <li>如果宝宝食欲不佳，可搭配一些色泽鲜艳的蔬菜</li>\n          <li>如宝宝感觉腥味偏大，可用甜椒或葱姜等食材去腥</li>\n          <li>根据宝宝的咀嚼能力，选择适合的烹调方式</li>\n        </ul>\n      </section>\n\n      <section>\n        <h2>搭配建议</h2>\n        <p class=\"tiny-note\">●按宝宝的年龄及口味来，搭配米、面、奶、蛋、蔬菜、肉类为例：</p>\n        <div class=\"dish-grid\">\n          <div class=\"dish\"><div class=\"food rice\"></div>米饭</div>\n          <div class=\"dish\"><div class=\"food noodle\"></div>面条</div>\n          <div class=\"dish\"><div class=\"food meat\"></div>炒肉</div>\n          <div class=\"dish\"><div class=\"food veg\"></div>蔬菜</div>\n          <div class=\"dish\"><div class=\"food pumpkin\"></div>南瓜</div>\n        </div>\n      </section>\n\n      <section class=\"tips\">\n        <h2>喂养建议</h2>\n        <div class=\"tip-columns\">\n          <ul>\n            <li>婴儿辅食</li>\n            <li>辅食添加</li>\n            <li>断奶食谱</li>\n          </ul>\n          <div class=\"food-list\">\n            <p>每日2～4次，奶汁600～700ml</p>\n            <p>每日2～3次，每次34g</p>\n            <p>营养餐：蔬菜、碎肉、八宝粥、蛋白 12～34g</p>\n            <p>蔬菜类：可煮12根</p>\n            <p>水果类：水果块12根</p>\n            <p>肉、蛋、鱼、虾、豆类，每日4～6g</p>\n            <p>每日5～10g，不超过</p>\n          </div>\n        </div>\n      </section>\n\n      <div class=\"bottom-band\">注：以上食材搭配仅供参考，请根据宝宝实际情况调整。</div>\n    </section>\n\n    <div class=\"gutter\"></div>\n\n    <section class=\"page right-page\">\n      <h1 class=\"recipe-title\">经典食谱</h1>\n\n      <article class=\"recipe\">\n        <div class=\"label\">食谱一：糯米肉鸽炖盅</div>\n        <p class=\"ingredients\"><strong>用料：</strong>肉鸽、糯米、红枣、枸杞、姜片、食盐</p>\n        <p class=\"ingredients\"><strong>做法：</strong></p>\n        <ol class=\"method\">\n          <li>糯米洗净浸泡片刻。</li>\n          <li>肉鸽处理干净后入沸水焯水，捞出沥干备用。</li>\n          <li>把糯米放入炖盅中，再放入肉鸽和红枣。</li>\n          <li>加入适量清水，炖熟后加入少许食盐调味即可。</li>\n        </ol>\n      </article>\n\n      <article class=\"recipe\">\n        <div class=\"label\">食谱二：香菇肉鸽</div>\n        <p class=\"ingredients\"><strong>用料：</strong>鸽子、香菇、胡萝卜、姜片、葱、少许食盐</p>\n        <p class=\"ingredients\"><strong>做法：</strong></p>\n        <ol class=\"method\">\n          <li>将香菇洗净后切片备用，胡萝卜切成小块。</li>\n          <li>肉鸽洗净切成小块，与香菇和姜片放入锅中加水煮熟。</li>\n          <li>最后加入胡萝卜煮至软烂，放入少许食盐调味即可。</li>\n        </ol>\n      </article>\n\n      <article class=\"recipe\">\n        <div class=\"label\">食谱三：排骨烧鸽</div>\n        <p class=\"ingredients\"><strong>用料：</strong>肉鸽、姜、葱、蒜、食盐、料酒、水</p>\n        <p class=\"ingredients\"><strong>做法：</strong></p>\n        <ol class=\"method\">\n          <li>肉鸽洗净后焯水，捞出沥干水分，放入碗中备用。</li>\n          <li>炒锅放少量油，加入葱姜蒜煸香。</li>\n          <li>放入肉鸽翻炒，加入适量清水和调味料，煮至肉质酥烂。</li>\n          <li>待汤汁略收后即可食用。</li>\n        </ol>\n      </article>\n\n      <div class=\"green-strip\"></div>\n\n      <article class=\"recipe\">\n        <div class=\"label\">食谱四：清蒸鸽</div>\n        <p class=\"ingredients\"><strong>用料：</strong>肉鸽、姜、葱、少许食盐</p>\n        <p class=\"ingredients\"><strong>做法：</strong></p>\n        <ol class=\"method\">\n          <li>将肉鸽洗净切成小块，放在碗中，铺上姜片和葱段。</li>\n          <li>加入适量清水和少许食盐，搅拌均匀后放入蒸锅蒸熟。</li>\n          <li>蒸熟后稍凉即可食用，适合小宝宝食用。</li>\n        </ol>\n      </article>\n    </section>\n  </main>\n</body>\n</html>"
