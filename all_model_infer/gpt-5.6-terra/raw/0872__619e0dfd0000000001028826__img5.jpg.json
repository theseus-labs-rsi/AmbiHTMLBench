nowrap; }\n    th { height: 29px; background: #a9d6e1; font-weight: 700; }\n    td.duration { color: #ee3125; text-align: center; font-weight: 700; }\n    .total td { font-weight: 700; text-align: center; }\n    .schedule { display: grid; grid-template-columns: 1fr 1fr; column-gap: 18px; position: relative; }\n    .schedule::before { content: \"\"; position: absolute; top: 30px; bottom: 6px; left: 50%; width: 3px; margin-left: -1px; background: #222; border-radius: 4px; }\n    .schedule::after { content: \"◆\\A◆\\A◆\\A◆\"; white-space: pre; position: absolute; top: 28px; left: calc(50% - 5px); font-size: 8px; line-height: 47px; color: #222; }\n    .column { min-width: 0; }\n    .event { margin: 0 0 5px; font-family: SimSun, \"Microsoft YaHei\", serif; font-size: 13px; line-height: 18px; }\n    .event-title { display: inline; padding: 1px 4px 1px 2px; font-family: \"Microsoft YaHei\", sans-serif; font-size: 13px; line-height: 18px; font-weight: 700; background: #fff22b; }\n    .event-title::before { content: \"●\"; padding-right: 7px; font-size: 11px; color: #111; }\n    .cyan { background: #17e8ee; padding: 1px 2px; }\n    .event p { margin: 0; }\n    .spacer { height: 3px; }\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <h1>四级考试时间/流程</h1>\n\n    <div class=\"table-wrap\">\n      <table>\n        <thead>\n          <tr><th>试卷结构</th><th>测试内容</th><th>测试题型</th><th>分值占比</th><th>考试时长</th></tr>\n        </thead>\n        <tbody>\n          <tr><td>作文</td><td>作文</td><td>短文写作</td><td>15%</td><td class=\"duration\">30分钟</td></tr>\n          <tr><td rowspan=\"3\">听力</td><td>短篇阅读3段</td><td>选择题（单选）</td><td>7%</td><td class=\"duration\" rowspan=\"3\">25分钟</td></tr>\n          <tr><td>长对话2篇</td><td>选择题（单选）</td><td>8%</td></tr>\n          <tr><td>听力篇章3篇</td><td>选择题（单选）</td><td>20%</td></tr>\n          <tr><td rowspan=\"3\">阅读理解</td><td>词汇理解</td><td>选词填空</td><td>5%</td><td class=\"duration\" rowspan=\"3\">40分钟</td></tr>\n          <tr><td>长篇阅读</td><td>匹配</td><td>10%</td></tr>\n          <tr><td>仔细阅读</td><td>选择题（单选）</td><td>20%</td></tr>\n          <tr><td>翻译</td><td>汉译英</td><td>段落翻译</td><td>15%</td><td class=\"duration\">30分钟</td></tr>\n          <tr class=\"total\"><td colspan=\"3\">总计</td><td>100%</td><td>125分钟</td></tr>\n        </tbody>\n      </table>\n    </div>\n\n    <section class=\"schedule\">\n      <div class=\"column\">\n        <div class=\"event\">\n          <span class=\"event-title\">8:40 考生入场</span>\n          <p>1. 出示准考证、身份证、学生证。</p>\n          <p>2. 手机严禁带入考场。</p>\n          <p>3. 入座后请试听耳机试听。</p>\n          <p>①证件不齐者严禁入场，不能参加考试。</p>\n          <p>②校对好耳机声音，考后不再试听。</p>\n        </div>\n        <div class=\"event\">\n          <span class=\"event-title\">9:00 下发考试材料</span>\n          <p>1. 检查试题册、条形码、答题卡的印刷质量。</p>\n          <p>2. 阅读试题册正面“敬告考生”内容。</p>\n          <p>3. 粘贴条形码、填写个人信息。</p>\n          <p>①非听力考试期间不得佩戴耳机<br>且不得提前翻阅试题册，违规处理。</p>\n          <p>②作文题目在试题册背面，<br>使用黑色签字笔在<span class=\"cyan\">答题卡1</span>上作答。</p>\n        </div>\n        <div class=\"event\">\n          <span class=\"event-title\">9:10 考试正式开始</span>\n          <p>开始作答作文。30分钟。</p>\n          <p>之后将立即进行听力考试。</p>\n        </div>\n        <div class=\"event\">\n          <span class=\"event-title\">9:35 提示考生</span>\n          <p>继续作答。</p>\n          <p>监考老师口头提醒，5分钟后开始听力考试。</p>\n        </div>\n      </div>\n      <div class=\"column\">\n        <div class=\"event\">\n          <span class=\"event-title\">9:40 听力考试开始</span>\n          <p>1. 打开试题册，戴上耳机。</p>\n          <p>2. 进行听力考试。</p>\n          <p>听力考试时间为25分钟，<br>请考生掌握好答题卡1的填涂时间，<br><span class=\"cyan\">听力录音播放完毕，将立即回收答题卡1。</span></p>\n        </div>\n        <div class=\"event\">\n          <span class=\"event-title\">10:05 听力考试结束</span>\n          <p>停止作答，摘下耳机。</p>\n          <p>考试暂停5分钟，等待收答题卡1。</p>\n        </div>\n        <div class=\"event\">\n          <span class=\"event-title\">10:10 命令考生继续作答</span>\n          <p>作答阅读理解和翻译部分。</p>\n          <p>监考老师口头提醒。</p>\n        </div>\n        <div class=\"event\">\n          <span class=\"event-title\">11:10 提示考生</span>\n          <p>继续作答，掌握好时间。</p>\n          <p>监考老师口头提醒，10分钟后考试将结束。</p>\n        </div>\n        <div class=\"event\">\n          <span class=\"event-title\">11:20 考试结束</span>\n          <p>考生停止作答。</p>\n          <p>①考生交回试题册、答题卡2。</p>\n          <p>②监考老师清点无误后考生方可离场。</p>\n        </div>\n      </div>\n    </section>\n  </main>\n</body>\n</html>\n"
