        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>光明日报 2025年1月14日</title>\n  <script>\n    window.MathJax = { tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] } };\n  </script>\n  <script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body { margin: 0; background: #ececec; color: #222; font-family: \"Songti SC\", \"SimSun\", serif; }\n    .page { width: 1260px; min-height: 1780px; margin: 0 auto; padding: 25px 22px 20px; background: #fff; }\n    .masthead { height: 275px; position: relative; border-bottom: 1px solid #555; }\n    .logo { position: absolute; top: -8px; left: 18px; color: #c90026; font-family: \"STKaiti\", \"KaiTi\", cursive; font-size: 130px; font-weight: bold; letter-spacing: 19px; transform: scaleY(1.15); }\n    .roman { position: absolute; top: 182px; left: 160px; font-family: Arial, sans-serif; font-size: 20px; letter-spacing: 8px; }\n    .spring { position: absolute; top: 6px; right: 106px; color: #a92e38; font-family: \"Microsoft YaHei\", sans-serif; font-size: 29px; font-weight: bold; border: 2px solid #b23d48; border-radius: 18px; padding: 4px 15px; }\n    .spring b { display: inline-block; color: white; background: #b8202e; border-radius: 50%; padding: 9px 14px; margin: -9px 4px; font-family: \"STKaiti\", \"KaiTi\"; font-size: 37px; transform: rotate(-11deg); }\n    .motto { position: absolute; top: 94px; right: 0; width: 580px; font-size: 12px; line-height: 1.65; text-align: justify; }\n    .datebar { position: absolute; left: 10px; bottom: 34px; width: 585px; padding: 4px; text-align: center; background: #06628c; color: white; font-family: Arial, sans-serif; font-size: 16px; font-weight: bold; }\n    .pub { position: absolute; left: 17px; bottom: 9px; font-family: Arial, sans-serif; font-size: 12px; font-weight: bold;