        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>唐诗六首</title>\n  <script>\n    window.MathJax = {\n      tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] }\n    };\n  </script>\n  <script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      min-height: 100vh;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      background: #f3ca89;\n      color: #111;\n      font-family: \"KaiTi\", \"STKaiti\", \"Kaiti SC\", \"SimKai\", serif;\n    }\n    .page {\n      width: min(92vw, 540px);\n      aspect-ratio: 540 / 724;\n      padding: 24px;\n      background-color: #fcfcf9;\n      background-image:\n        linear-gradient(rgba(205, 215, 211, .25) 1px, transparent 1px),\n        linear-gradient(90deg, rgba(205, 215, 211, .25) 1px, transparent 1px);\n      background-size: 12px 12px;\n      box-shadow: 0 1px 6px rgba(110, 70, 25, .22);\n    }\n    .poem-grid {\n      width: 100%;\n      height: 100%;\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      grid-template-rows: repeat(3, 1fr);\n      border: 4px solid #dda178;\n    }\n    .poem {\n      min-width: 0;\n      padding: 8px 10px 6px;\n      text-align: center;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n    }\n    .poem:nth-child(odd) {\n      border-right: 5px solid #dda178;\n    }\n    .poem:nth-child(-n+4) {\n      border-bottom: 5px solid #dda178;\n    }\n    h2 {\n      margin: 0;\n      white-space: nowrap;\n      font-size: clamp(23px, 5vw, 33px);\n      line-height: 1.08;\n      font-weight: 700;\n    }\n    .author {\n      width: 100%;\n      margin: 3px 0 13px;\n      padding-right: 1px;\n      text-align: right;\n      white-space: nowrap;\n      font-size: clamp(15px, 3.3vw, 21px);\n      line-height: 1;\n    }\n    .lines {\n      width: 100%;\n      text-align: left;\n      padding-left: 22px;\n      white-space: nowrap;\n      font-size: clamp(21px, 4.6vw, 29px);\n      line-height: 1.27;\n      font-weight: 500;\n    }\n    @media (max-width: 390px) {\n      .page { padding: 14px; }\n      .poem { padding: 7px 5px; }\n      .lines { padding-left: 12px; }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <section class=\"poem-grid\">\n      <article class=\"poem\">\n        <h2>《登鹳雀楼》</h2>\n        <div class=\"author\">（唐—王之涣）</div>\n        <div class=\"lines\">白日依山尽，<br>黄河入海流。<br>欲穷千里目，<br>更上一层楼。</div>\n      </article>\n      <article class=\"poem\">\n        <h2>《静夜思》</h2>\n        <div class=\"author\">（唐—李白）</div>\n        <div class=\"lines\">床前明月光，<br>疑是地上霜。<br>举头望明月，<br>低头思故乡。</div>\n      </article>\n      <article class=\"poem\">\n        <h2>《古朗月行》</h2>\n        <div class=\"author\">（唐—李白）</div>\n        <div class=\"lines\">小时不识月，<br>呼作白玉盘。<br>又疑瑶台镜，<br>飞在青云端。</div>\n      </article>\n      <article class=\"poem\">\n        <h2>《寻隐者不遇》</h2>\n        <div class=\"author\">（唐—贾岛）</div>\n        <div class=\"lines\">松下问童子，<br>言师采药去。<br>只在此山中，<br>云深不知处。</div>\n      </article>\n      <article class=\"poem\">\n        <h2>《咏鹅》</h2>\n        <div class=\"author\">（唐—骆宾王）</div>\n        <div class=\"lines\">鹅鹅鹅，<br>曲项向天歌。<br>白毛浮绿水，<br>红掌拨清波。</div>\n      </article>\n      <article class=\"poem\">\n        <h2>《草》</h2>\n        <div class=\"author\">（唐—白居易）</div>\n        <div class=\"lines\">离离原上草，<br>一岁一枯荣。<br>野火烧不尽，<br>春风吹又生。</div>\n      </article>\n    </section>\n  </main>\n</body>\n</html>"
