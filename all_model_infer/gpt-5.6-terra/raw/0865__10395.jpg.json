4px \"Microsoft YaHei\", sans-serif;\n    line-height: 18px;\n  }\n  .left-photo { width: 376px; height: 252px; }\n  .chorus { background: linear-gradient(135deg,#1e2729,#5c7158 44%,#1c2025); }\n  .talk { background: linear-gradient(120deg,#80947d,#d9e1d4 42%,#718575); }\n  .tug { background: linear-gradient(120deg,#263630,#6f846a 44%,#202a2a); }\n  .article {\n    font-size: 14px;\n    line-height: 18px;\n    text-align: left;\n    color: #4a4a4a;\n  }\n  .article p {\n    margin: 0 0 9px;\n    text-indent: 2em;\n  }\n  .article .author {\n    margin-top: 16px;\n    text-align: right;\n    font: 14px \"Microsoft YaHei\", sans-serif;\n    color: #333;\n  }\n  .right-stack { width: 388px; }\n  .right-photo2 {\n    width: 388px;\n    height: 517px;\n    margin-top: 0;\n    background: linear-gradient(125deg,#7695ad 0,#e7e0b0 35%,#bba971 52%,#283a2e 53%,#d8d5c2 100%);\n  }\n  .right-photo3 {\n    width: 388px;\n    height: 260px;\n    margin-top: 59px;\n    background: linear-gradient(120deg,#6f8870,#bcc3b8 48%,#46584e 49%,#849789);\n  }\n  .bottom-row {\n    display: grid;\n    grid-template-columns: 490px 290px 388px;\n    column-gap: 40px;\n    padding: 0 4px;\n    margin-top: 31px;\n  }\n  .qr-area {\n    display: flex;\n    align-items: center;\n    margin-top: 18px;\n    margin-left: 38px;\n    gap: 20px;\n  }\n  .qr {\n    width: 93px;\n    height: 93px;\n    border: 1px solid #999;\n    background:\n      repeating-linear-gradient(90deg,#222 0 3px,#fff 3px 6px),\n      repeating-linear-gradient(#fff 0 4px,#333 4px 7px);\n    position: relative;\n  }\n  .qr:after {\n    content:\"\";\n    position:absolute;\n    inset: 14px;\n    background: rgba(255,255,255,.48);\n    border: 3px solid #333;\n  }\n  .qr-text { font: 14px \"Microsoft YaHei\", sans-serif; line-height: 21px; }\n  .footer {\n    position: absolute;\n    bottom: 5px;\n    left: 8px;\n    right: 8px;\n    border-top: 1px solid #777;\n    padding: 8px 12px 0;\n    font: 12px \"Microsoft YaHei\", sans-serif;\n    white-space: nowrap;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <header class=\"header\">\n    <div class=\"page-no\">4</div>\n    <div class=\"section\">求是苑·剪影</div>\n    <div class=\"issue\">2018年9月14日　星期五<br>责任编辑：张 岩　联系电话：0571-88981339</div>\n    <div class=\"masthead\">\n      <div class=\"cn\">浙江大学报</div>\n      <div class=\"en\">ZHE JIANG DA XUE BAO</div>\n    </div>\n  </header>\n\n  <section class=\"top-strip\">\n    <div class=\"top-item\">\n      <div class=\"top-caption\">汗水流过坚毅的脸庞<br>陈佳轩　摄</div>\n      <div class=\"placeholder top-photo sky\"><span>[照片：军训学生特写]</span></div>\n    </div>\n    <div class=\"top-item\">\n      <div class=\"top-caption\">挥旗<br>施良辰　摄</div>\n      <div class=\"placeholder top-photo flag\"><span>[照片：学生挥旗]</span></div>\n    </div>\n    <div class=\"top-item\">\n      <div class=\"top-caption\">别担心，我不累<br>梁汉卿　摄</div>\n      <div class=\"placeholder top-photo soldier\"><span>[照片：军训学生]</span></div>\n    </div>\n    <div class=\"top-item\">\n      <div class=\"top-caption\">关怀<br>何念泽　摄</div>\n      <div class=\"placeholder top-photo drill\"><span>[照片：军训队列]</span></div>\n    </div>\n  </section>\n\n  <section class=\"headline\">\n    <h1>在军训中磨砺青春</h1>\n    <p>——浙江大学2018年学生军训掠影</p>\n  </section>\n\n  <section class=\"upper\">\n    <div>\n      <div class=\"placeholder main-photo\"><span>[照片：军训队伍两侧列队，中央学生行进]</span></div>\n      <div class=\"photo-caption caption-right\">在校园的每个角落练习着<br>军姿<br>陈佳轩　摄</div>\n    </div>\n    <div>\n      <div class=\"placeholder right-photo1\"><span>[照片：学生在校园中奔跑]</span></div>\n      <div class=\"photo-caption caption-center\">在定向越野中奋力奔跑<br>陈佳轩　摄</div>\n    </div>\n  </section>\n\n  <section class=\"content\">\n    <div class=\"left-stack\">\n      <div class=\"side-cap\">用一场合唱<br>比赛铭记这些闪<br>亮的日子<br>胡琪宣　摄</div>\n      <div class=\"placeholder left-photo chorus\"><span>[照片：军训学生合唱]</span></div>\n\n      <div class=\"side-cap\">用一份入党<br>申请书见证理想<br>与信念<br>胡琪宣　摄</div>\n      <div class=\"placeholder left-photo talk\"><span>[照片：军训学生交流]</span></div>\n\n      <div class=\"side-cap\">用一场拔河<br>比赛演绎青春的<br>力量<br>陈佳轩　摄</div>\n      <div class=\"placeholder left-photo tug\"><span>[照片：学生拔河比赛]</span></div>\n    </div>\n\n    <article class=\"article\">\n      <p>紫金港，你五点钟的晨曦真美。</p>\n      <p>见过早晨五点钟的校园吗？柔亮的光里忽地划出几声嘹亮的口号，然后啪地大团的绿，不同大自然肆意的绿色，那是一种属于军人的——规矩的绿！军装整齐，步伐一致，口号响亮，浙大的新入们迎来了他们军训的一天。</p>\n      <p>谁言书生只喜欢文，军训场上显神威！既不得眠懒之志，岂能无钢铁之躯？壮志凌云，跃跃欲试；意气风发，整装待发。能文善武，成大国之器；强弩挥刀，铸全能之材！</p>\n      <p>紫金港，你日光下汗浸衣襟的战士们真帅。</p>\n      <p>“向左转！向右转！”“齐步走！”一遍两遍，百遍千遍。不厌不倦，不懈不怕。浙大人不怕苦，浙大人要磨练钢铁意志！心中有理想，脚下有力量。日光激定，我们向往成为钢铁一般的战士；敌我们忍耐，我们奋发，至刚至坚，长空亮剑，气贯云天！</p>\n      <p>烈日炎炎，熔不了心中激情；汗水淋淋，带不走崇高信念。青春年华，用汗水诠释；前路漫漫，用血泪征服！</p>\n      <p>白云泻能展后生，丈夫未可轻年少！不屈不服——！</p>\n      <p>紫金港，你夕阳里的缠绵故事好看。</p>\n      <p>最后道：“路漫漫其修远兮，吾将上下而求索。”笔老校长一同犹然在耳，唯有向前，全力以赴，才可不负重托。前人栽树，学者同众新力的学长学姐一起，为我们守护着这方生机盎然的土地。战火中的西迁故事，林俊德院士的事迹……既传达了力量，更是我们的榜样！专属的重任在肩，要传承的是一代代浙大人艰苦创业的精神，要传承的是一代代浙大人求是创新的灵魂！</p>\n      <p>紫金港，你路灯下的油冰轻轻泛涟漪，你黑暗中的桔枝柔柔地扭动腰肢，你月牙楼边传来的歌声微微回响。</p>\n      <p>这一天来了，战士们都进人梦乡。</p>\n      <p>紫金港，你今天真好看。我想，明天的你一定更加美丽！</p>\n      <div class=\"author\">本版文字　包睿　杨萝萝</div>\n    </article>\n\n    <div class=\"right-stack\">\n      <div class=\"placeholder right-photo2\"><span>[照片：篮球场上的军训学生]</span></div>\n      <div class=\"photo-caption caption-center\">一排男生站成一列，用<br>自己的影子给姑娘挡住烈日</div>\n\n      <div class=\"placeholder right-photo3\"><span>[照片：大规模军训队列航拍]</span></div>\n      <div class=\"photo-caption caption-center\">迷彩的颜色是今夏紫金<br>港最靓丽的风景线<br>陈佳轩　摄</div>\n    </div>\n  </section>\n\n  <section class=\"bottom-row\">\n    <div></div>\n    <div class=\"qr-area\">\n      <div class=\"qr\" aria-label=\"二维码\"></div>\n      <div class=\"qr-text\">用手机QQ<br>扫一扫二维码<br>加入浙江大学<br>QQ智慧校园</div>\n    </div>\n    <div></div>\n  </section>\n\n  <footer class=\"footer\">\n    本报通讯地址：浙江大学紫金港校区东三105　《浙江大学报》编辑部　邮编：310058　电子信箱：zdx b@zju.edu.cn　电话：0571-88981339　88273707　总编：应 题　副总编：章昊　电子编辑：李梦　承印：新华社浙江分社印刷厂\n  </footer>\n</div>\n</body>\n</html>"
