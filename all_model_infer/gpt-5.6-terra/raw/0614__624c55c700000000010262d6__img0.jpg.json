        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Handwritten Teaching Notes</title>\n  <script>\n    window.MathJax = { tex: { inlineMath: [['$', '$'], ['\\\\(', '\\\\)']], displayMath: [['$$', '$$'], ['\\\\[', '\\\\]']] } };\n  </script>\n  <script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      min-height: 100vh;\n      background: #5d5e55;\n      display: flex;\n      justify-content: center;\n      align-items: flex-start;\n      padding: 6px 0 14px;\n      font-family: \"KaiTi\", \"STKaiti\", \"FangSong\", serif;\n    }\n    .photo-area {\n      width: 540px;\n      min-height: 714px;\n      background:\n        linear-gradient(90deg, rgba(55,54,48,.15), transparent 9%, transparent 91%, rgba(42,42,37,.18)),\n        #b9b9ac;\n      padding: 37px 39px 22px 32px;\n      box-shadow: inset 0 0 30px rgba(40,40,32,.35);\n    }\n    .paper {\n      width: 100%;\n      min-height: 652px;\n      position: relative;\n      padding: 10px 8px 18px 10px;\n      background:\n        repeating-linear-gradient(to bottom, transparent 0, transparent 21px, rgba(80,120,130,.11) 22px, transparent 23px),\n        linear-gradient(105deg, #e5e4d5, #dbdccf 52%, #e0dfd1);\n      box-shadow: 0 1px 5px rgba(0,0,0,.22);\n      transform: rotate(-1.1deg);\n      color: #262b2b;\n    }\n    .paper:after {\n      content: \"\";\n      position: absolute;\n      top: 0;\n      bottom: 0;\n      left: 51.2%;\n      width: 3px;\n      background: linear-gradient(90deg, rgba(90,90,80,.20), rgba(255,255,250,.48), rgba(80,80,72,.10));\n      opacity: .72;\n    }\n    .columns {\n      position: relative;\n      z-index: 1;\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      column-gap: 21px;\n    }\n    .col {\n      min-width: 0;\n      font-size: 14px;\n      line-height: 1.44;\n      letter-spacing: .1px;\n    }\n    .section {\n      margin: 0 0 11px;\n    }\n    .heading {\n      color: #b04a4e;\n      font-size: 16px;\n      font-weight: 500;\n      line-height: 1.22;\n      margin-bottom: 2px;\n      white-space: nowrap;\n    }\n    .line {\n      min-height: 20px;\n      white-space: nowrap;\n    }\n    .indent { padding-left: 8px; }\n    .subindent { padding-left: 17px; }\n    .boxed {\n      float: right;\n      margin: -3px 4px 2px 4px;\n      min-width: 49px;\n      height: 30px;\n      border: 2px solid #a93742;\n      color: #263b82;\n      font-size: 20px;\n      line-height: 26px;\n      text-align: center;\n      transform: rotate(1deg);\n    }\n    .redmark { color: #b04a4e; }\n    .smallgap { margin-top: 3px; }\n  </style>\n</head>\n<body>\n  <main class=\"photo-area\">\n    <article class=\"paper\">\n      <div class=\"columns\">\n        <section class=\"col\">\n          <div class=\"section\">\n            <div class=\"heading\">直观性原则（经济性教育原则）</div>\n            <div class=\"boxed\">教学</div>\n            <div class=\"line\">〈1〉必须依据学生的感知和认识规律。</div>\n            <div class=\"line\">〈2〉直观教具能加深学生的感性认识。</div>\n            <div class=\"line\">〈3〉要正确选择和运用直观教具。</div>\n            <div class=\"line\">〈4〉防止直观教学的形式化。</div>\n          </div>\n\n          <div class=\"section\">\n            <div class=\"heading\">启发性原则（师生互动）</div>\n            <div class=\"line\">〈1〉加强学生的主动性和创造性学习。</div>\n            <div class=\"line\">〈2〉启发引导学生思考，培养逻辑思维能力。</div>\n            <div class=\"line\">〈3〉启发学生，提出问题和解决问题的能力。</div>\n            <div class=\"line\">〈4〉根据教材和学生实际进行教学。</div>\n          </div>\n\n          <div class=\"section\">\n            <div class=\"heading\">循序渐进原则（教师为主导）</div>\n            <div class=\"line\">〈1〉教师对教学要有计划性。</div>\n            <div class=\"line\">〈2〉注意教材内容的系统性和连贯性。</div>\n            <div class=\"line\">〈3〉按照学生的认识规律，由浅入深、由易到难。</div>\n            <div class=\"line\">〈4〉把握好教学的速度和进度。</div>\n          </div>\n\n          <div class=\"section\">\n            <div class=\"heading\">巩固性原则（学生为主）</div>\n            <div class=\"line\">〈1〉要使学生在理解的基础上巩固知识。</div>\n            <div class=\"line\">〈2〉组织复习学生的学习活动。</div>\n            <div class=\"line\">〈3〉在拓展、巩固和运用知识中掌握知识。</div>\n          </div>\n\n          <div class=\"section\">\n            <div class=\"heading\">因材施教原则</div>\n            <div class=\"line\">〈1〉了解学生的个性差异，从实际情况出发。</div>\n            <div class=\"line\">〈2〉根据学生认识发展规律和个性。</div>\n          </div>\n\n          <div class=\"section\">\n            <div class=\"heading\">因材施教原则</div>\n            <div class=\"line\">〈1〉针对学生的不同特点进行有目的的教学。</div>\n            <div class=\"line\">〈2〉教师要使教学适应学生的个别差异。</div>\n            <div class=\"line smallgap\">方法：①进行分层教学　②尊重学生差异</div>\n            <div class=\"line subindent\">③面向全体学生</div>\n          </div>\n        </section>\n\n        <section class=\"col\">\n          <div class=\"section\">\n            <div class=\"heading\">理论联系实际的原则——原则</div>\n            <div class=\"line\">〈1〉加强科学知识的理解。</div>\n            <div class=\"line\">〈2〉联系实际，培养学生的实践能力。</div>\n            <div class=\"line\">〈3〉重视科学知识和技能的学习。</div>\n            <div class=\"line\">〈4〉教师要加强理论联系实际的教学。</div>\n            <div class=\"line\">〈5〉结合具体事例进行启发和检验。</div>\n          </div>\n\n          <div class=\"section\">\n            <div class=\"heading\">提高教学质量原则！</div>\n            <div class=\"line\">〈1〉教师要认真备课和教学。</div>\n            <div class=\"line\">〈2〉课堂教学要生动活泼。</div>\n            <div class=\"line\">〈3〉正确处理教与学、理论与实践的关系。</div>\n            <div class=\"line\">〈4〉掌握和运用教学规律。</div>\n          </div>\n\n          <div class=\"section\">\n            <div class=\"heading\">讲授法：</div>\n            <div class=\"line indent\">〈1〉讲述和讲解相结合。</div>\n            <div class=\"line indent\">〈2〉要有明确的目的和问题。</div>\n            <div class=\"line indent\">〈3〉讲授要注意重点。</div>\n            <div class=\"line indent\">〈4〉要注意学生听讲。</div>\n          </div>\n\n          <div class=\"section\">\n            <div class=\"heading\">谈话法：</div>\n            <div class=\"line indent\">〈1〉提出问题和回答问题。</div>\n            <div class=\"line indent\">〈2〉要有针对性和启发性。</div>\n          </div>\n\n          <div class=\"section\">\n            <div class=\"heading\">演示法：</div>\n            <div class=\"line indent\">〈1〉利用实物、模型和图表进行演示。</div>\n            <div class=\"line indent\">〈2〉演示要与讲授密切配合。</div>\n          </div>\n\n          <div class=\"section\">\n            <div class=\"heading\">讨论法：</div>\n            <div class=\"line indent\">〈1〉引导学生围绕问题进行讨论。</div>\n            <div class=\"line indent\">〈2〉教师要作必要的指导和总结。</div>\n          </div>\n\n          <div class=\"section\">\n            <div class=\"heading\">读书指导法：</div>\n            <div class=\"line indent\">〈1〉教师指导学生阅读教材。</div>\n            <div class=\"line indent\">〈2〉教给学生读书的方法。</div>\n            <div class=\"line indent\">〈3〉善于引导学生发现问题。</div>\n            <div class=\"line indent\">〈4〉独立思考，认真读书。</div>\n          </div>\n        </section>\n      </div>\n    </article>\n  </main>\n</body>\n</html>"
