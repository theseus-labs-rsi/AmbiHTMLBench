        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>CASE AND CONSIDERATION 案例与反思</title>\n  <script>\n    window.MathJax = { tex: { inlineMath: [['$', '$'], ['\\\\(', '\\\\)']], displayMath: [['$$', '$$'], ['\\\\[', '\\\\]']]} };\n  </script>\n  <script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    html, body { margin: 0; padding: 0; background: #f4f4f1; }\n    body {\n      font-family: \"SimSun\", \"Songti SC\", serif;\n      color: #333;\n    }\n    .page {\n      position: relative;\n      width: 540px;\n      height: 759px;\n      margin: 0 auto;\n      overflow: hidden;\n      background: #fff;\n      padding: 0 38px;\n    }\n    .watermark {\n      position: absolute;\n      color: rgba(174, 184, 180, .14);\n      font-family: \"Microsoft YaHei\", sans-serif;\n      font-size: 22px;\n      white-space: nowrap;\n      transform: rotate(-32deg);\n      pointer-events: none;\n      letter-spacing: 2px;\n    }\n    .wm1 { top: 18px; left: -26px; }\n    .wm2 { top: 20px; left: 174px; }\n    .wm3 { top: 125px; left: -40px; }\n    .wm4 { top: 122px; left: 250px; }\n    .wm5 { top: 310px; left: -25px; }\n    .wm6 { top: 307px; left: 266px; }\n    .wm7 { top: 496px; left: -13px; }\n    .wm8 { top: 495px; left: 263px; }\n    .header {\n      position: relative;\n      margin-top: 47px;\n      height: 21px;\n      border-top: 1px solid #aac7b8;\n      border-bottom: 1px solid #c4d6ca;\n    }\n    .header h1 {\n      position: absolute;\n      right: 0;\n      top: 3px;\n      margin: 0;\n      font-size: 10px;\n      font-weight: bold;\n      color: #222;\n      line-height: 12px;\n    }\n    .content {\n      position: relative;\n      display: grid;\n      grid-template-columns: 221px 221px;\n      column-gap: 14px;\n      margin-top: 102px;\n      height: 5