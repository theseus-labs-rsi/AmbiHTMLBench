ative;\n    margin-left: 15px;\n  }\n  .arrow:after {\n    content: \"\";\n    position: absolute;\n    top: -12px;\n    right: -20px;\n    border-top: 23px solid transparent;\n    border-bottom: 23px solid transparent;\n    border-left: 20px solid #6abc43;\n  }\n  .payout {\n    padding-left: 28px;\n    font-size: 25px;\n    line-height: 1.1;\n    letter-spacing: .25px;\n  }\n  .increased {\n    position: absolute;\n    left: 140px;\n    top: 621px;\n    width: 690px;\n  }\n  .increased h2 { margin-bottom: 12px; }\n  .increased ul {\n    margin: 0;\n    padding-left: 48px;\n    font-size: 25px;\n    line-height: 1.1;\n    letter-spacing: .3px;\n  }\n  .philosophy {\n    position: absolute;\n    left: 133px;\n    top: 807px;\n    width: 1385px;\n  }\n  .philosophy h2 {\n    color: #6abc43;\n    font-size: 24px;\n    margin: 0 0 18px 0;\n  }\n  .philosophy p {\n    margin: 0;\n    font-size: 24px;\n    line-height: 1.35;\n    letter-spacing: .5px;\n  }\n  .principles {\n    margin: 18px 0 0 48px;\n    padding-left: 49px;\n    font-size: 24px;\n    line-height: 1.35;\n    letter-spacing: .45px;\n  }\n  .principles li {\n    padding-left: 0;\n    margin: 0 0 15px 0;\n  }\n  .principles strong {\n    font-weight: 700;\n    letter-spacing: .2px;\n  }\n  .closing {\n    position: absolute;\n    left: 133px;\n    top: 1309px;\n    font-size: 24px;\n    letter-spacing: .45px;\n  }\n  .page-number {\n    position: absolute;\n    bottom: 42px;\n    left: 0;\n    width: 100%;\n    text-align: center;\n    font-size: 22px;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <section class=\"top\">\n    <div class=\"left\">\n      <h2>Target Pay Adjustments</h2>\n      <ul>\n        <li>Increase in proportion of “at-risk” target pay to <strong class=\"green\">96%</strong> of<br>CEO target pay and <strong class=\"green\">90%</strong> of other NEO target pay</li>\n        <li>Increased CEO target variable cash to 200% of base<br>salary (representing 50th percentile of peers)<