        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>要闻</title>\n  <script>\n    window.MathJax = {\n      tex: {inlineMath: [['$', '$'], ['\\\\(', '\\\\)']], displayMath: [['$$', '$$'], ['\\\\[', '\\\\]']]}\n    };\n  </script>\n  <script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    html, body { margin: 0; padding: 0; background: #fff; color: #111; }\n    body {\n      width: 800px;\n      margin: 0 auto;\n      font-family: \"SimSun\", \"Songti SC\", \"Noto Serif CJK SC\", serif;\n      font-size: 10px;\n      line-height: 1.42;\n    }\n    .page { padding: 8px 8px 14px; }\n    .masthead {\n      height: 31px;\n      border-bottom: 2px solid #111;\n      display: flex;\n      align-items: flex-start;\n      justify-content: space-between;\n      padding: 0 4px;\n    }\n    .brand {\n      font-family: \"SimHei\", \"Heiti SC\", sans-serif;\n      font-size: 24px;\n      letter-spacing: 3px;\n      line-height: 25px;\n    }\n    .brand small {\n      font-size: 19px;\n      letter-spacing: 0;\n      margin-left: 3px;\n    }\n    .date {\n      font-size: 8px;\n      margin-left: -250px;\n      margin-top: 10px;\n      white-space: nowrap;\n    }\n    .people {\n      font-family: \"KaiTi\", \"STKaiti\", serif;\n      font-size: 20px;\n      font-weight: bold;\n      transform: skew(-8deg);\n      margin-top: 1px;\n    }\n    .top-grid {\n      display: grid;\n      grid-template-columns: 1.04fr 1fr 1.06fr;\n      gap: 10px;\n      padding-top: 9px;\n      border-bottom: 1px solid #111;\n    }\n    .top-grid > article {\n      min-width: 0;\n      padding-right: 8px;\n      border-right: 1px solid #888;\n    }\n    .top-grid > article:last-child {\n      border-right: 0;\n      padding-right: 0;\n    }\n    .section-title {\n      font-family: \"SimHe