 11px;\n      line-height: 2.4;\n    }\n    .problem p {\n      margin: 0;\n    }\n    .choices {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      column-gap: 22px;\n      row-gap: 4px;\n      margin-top: 7px;\n      padding-left: 1px;\n      line-height: 1.55;\n    }\n    .choice { white-space: nowrap; }\n    mjx-container { margin: 0 !important; }\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <h1>模型60　与二次函数有关的综合问题（1）</h1>\n\n    <div class=\"section-title\">【模型分析】</div>\n\n    <table aria-label=\"二次函数模型分析表\">\n      <thead>\n        <tr>\n          <th class=\"formula\">解析式</th>\n          <th class=\"condition\">$a$ 取值</th>\n          <th class=\"vertex\">顶点坐标</th>\n          <th class=\"axis\">对称轴</th>\n          <th class=\"intercept\">与 $y$ 轴交点</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td class=\"formula\">$y=ax^2$</td>\n          <td class=\"condition description\" rowspan=\"2\">\n            当 $a&gt;0$<br>\n            开口向上，在对称<br>\n            轴右侧，$y$ 随 $x$ 增大<br>\n            而增大；在对称轴\n          </td>\n          <td class=\"vertex\">$(0,0)$</td>\n          <td class=\"axis\">$x=0$</td>\n          <td class=\"intercept\">$(0,0)$</td>\n        </tr>\n        <tr>\n          <td class=\"formula\">$y=ax^2+k$</td>\n          <td class=\"vertex\">$(0,k)$</td>\n          <td class=\"axis\">$x=0$</td>\n          <td class=\"intercept\">$(0,k)$</td>\n        </tr>\n        <tr>\n          <td class=\"formula\">$y=a(x+h)^2$</td>\n          <td class=\"condition description\" rowspan=\"2\">\n            的右侧 $y$ 随 $x$ 增大<br>\n            而增大；<br>\n            当 $a&lt;0$ 时\n          </td>\n          <td class=\"vertex\">$(-h,0)$</td>\n          <td class=\"axis\">$x=-h$</td>\n          <td class=\"intercept\">$(0,ah^2)$</td>\n        </tr>\n        <tr>\n          <td class=\"formula\">$y=a(x+h)^2+k$</td>\n          <td class=\"vertex\">$(-h,k)$</td>\n          <td class=\"axis\">$x=-h$</td>\n          <td class=\"intercept\">$(0,ah^2+k)$</td>\n        </tr>\n        <tr class=\"taller\">\n          <td class=\"formula\">$y=ax^2+bx+c$</td>\n          <td class=\"condition description\">\n            开口向下，在对称<br>\n            轴右侧 $y$ 随 $x$ 增大<br>\n            而减小，在对称轴<br>\n            的右侧\n          </td>\n          <td class=\"vertex\">$\\left(-\\dfrac{b}{2a},\\dfrac{4ac-b^2}{4a}\\right)$</td>\n          <td class=\"axis\">$x=-\\dfrac{b}{2a}$</td>\n          <td class=\"intercept\">$(0,c)$</td>\n        </tr>\n      </tbody>\n    </table>\n\n    <div class=\"example-title\">【经典例题】</div>\n\n    <section class=\"problem\">\n      <p>例1．（2020·福建九年级专题）若二次函数 $y=ax^2+bx+c$（$-c&lt;5$ 且 $0&lt;a&lt;\\dfrac{3}{2}$）过</p>\n      <p>$A(m,n)$，$B(3,y_1)$，$C(2-m,n)$，$D\\left(-\\dfrac{\\sqrt5}{2},y_2\\right)$，$E(1,y_3)$，且 $A,C$ 到对称轴的距离相</p>\n      <p>等 $n\\ne0$，则 $y_1$，$y_2$，$y_3$ 的大小关系是（　）</p>\n\n      <div class=\"choices\">\n        <div class=\"choice\">A．$y_3&gt;y_1&gt;y_2$</div>\n        <div class=\"choice\">B．$y_2&gt;y_1&gt;y_3$</div>\n        <div class=\"choice\">C．$y_1&gt;y_2&gt;y_3$</div>\n        <div class=\"choice\">D．$y_1&lt;y_3&lt;y_2$</div>\n      </div>\n    </section>\n  </main>\n</body>\n</html>"
