        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>光明日报 2025年3月17日</title>\n  <script>\n    window.MathJax = { tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] } };\n  </script>\n  <script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      background: #eee;\n      color: #171717;\n      font-family: \"Songti SC\", \"SimSun\", serif;\n    }\n    .page {\n      width: 1260px;\n      min-height: 1780px;\n      margin: 0 auto;\n      padding: 28px 22px 22px;\n      background: #fff;\n    }\n    .masthead {\n      height: 270px;\n      border-bottom: 1px solid #666;\n      position: relative;\n    }\n    .calligraphy {\n      position: absolute;\n      top: -22px;\n      left: 20px;\n      color: #c90028;\n      font-family: \"STKaiti\", \"KaiTi\", cursive;\n      font-size: 128px;\n      font-weight: bold;\n      letter-spacing: 25px;\n      transform: rotate(-3deg);\n      white-space: nowrap;\n    }\n    .name {\n      position: absolute;\n      left: 160px;\n      top: 174px;\n      font-family: Arial, sans-serif;\n      font-size: 20px;\n      letter-spacing: 10px;\n    }\n    .main-title {\n      position: absolute;\n      top: 10px;\n      right: 0;\n      font-size: 41px;\n      font-family: \"SimHei\", sans-serif;\n      letter-spacing: 1px;\n      white-space: nowrap;\n    }\n    .top-columns {\n      position: absolute;\n      top: 92px;\n      right: 0;\n      width: 595px;\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 15px;\n      font-size: 12px;\n      line-height: 1.38;\n      text-align: justify;\n    }\n    .datebar {\n      position: absolute;\n      left: 10px;\n      right: 637px;\n      bottom: 33px;\n      height: 24px;\n      padding: 3px 0;\n      color: white;\n 