sition: absolute;\n    bottom: -18px;\n    width: 37px;\n    height: 104px;\n    background: #e2a777;\n    border-radius: 45% 43% 17% 20%;\n    transform: rotate(-10deg);\n  }\n  .hand.left { left: 37px; }\n  .hand.right { right: 22px; transform: rotate(10deg); }\n  .cuff {\n    position: absolute;\n    bottom: -15px;\n    width: 38px;\n    height: 39px;\n    background: #0c5a85;\n    transform: skew(-7deg);\n  }\n  .cuff.left { left: 37px; }\n  .cuff.right { right: 21px; }\n  .divider {\n    height: 4px;\n    margin: 17px 1px 23px;\n    background: #53aaf0;\n    border-radius: 2px;\n  }\n  .grid {\n    display: grid;\n    grid-template-columns: 207px 207px 207px;\n    gap: 38px;\n    align-items: start;\n  }\n  h2 {\n    color: #143a75;\n    font-size: 13px;\n    line-height: 1;\n    margin: 0;\n    font-weight: 700;\n  }\n  .rule {\n    height: 2px;\n    margin: 11px 0 10px;\n    background: #4aa9e9;\n  }\n  p {\n    margin: 0;\n    font-size: 10px;\n    line-height: 1.38;\n  }\n  .section { margin-bottom: 26px; }\n  .aim { margin-top: 26px; }\n  .methodology { margin-top: 29px; }\n  .methodology .rule { margin-bottom: 13px; }\n  .step {\n    position: relative;\n    padding-top: 24px;\n    margin-bottom: 15px;\n  }\n  .number {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 18px;\n    height: 18px;\n    border-radius: 50%;\n    background: #7ed8ef;\n    color: #237399;\n    font-size: 9px;\n    line-height: 18px;\n    text-align: center;\n    font-weight: bold;\n  }\n  .results .rule { margin-bottom: 10px; }\n  .results-intro {\n    min-height: 103px;\n    font-size: 10px;\n    line-height: 1.38;\n  }\n  table {\n    border-collapse: collapse;\n    width: 100%;\n    margin-top: 10px;\n    font-size: 7px;\n    text-align: center;\n  }\n  th {\n    height: 46px;\n    padding: 4px 2px;\n    color: #9fdcf6;\n    background: #0a397b;\n    font-weight: normal;\n    font-size: 6px;\n    line-height: 1.15;\n  }\n  td {\n    height: 39px;\n    padding: 4px 3px;\n    border-bottom: 1px solid #f0f0f0;\n    color: #4d5560;\n  }\n  td:first-child {\n    padding-left: 10px;\n    text-align: left;\n    font-size: 6.5px;\n  }\n  .photo {\n    width: 207px;\n    height: 213px;\n    margin-top: 12px;\n    position: relative;\n    overflow: hidden;\n    background: linear-gradient(135deg, #e9f8fc 0%, #c9e4ef 45%, #f8f4f0 46%, #e1edf4 100%);\n    border: 0;\n  }\n  .photo:before {\n    content: \"\";\n    position: absolute;\n    left: 54px;\n    bottom: -38px;\n    width: 144px;\n    height: 185px;\n    background: radial-gradient(ellipse at 58% 10%, #f3b9a6 0 18%, transparent 19%), linear-gradient(135deg, transparent 0 33%, #ffffff 34% 72%, #bdddeb 73%);\n    border-radius: 46% 45% 0 0;\n    opacity: .8;\n  }\n  .photo:after {\n    content: \"\";\n    position: absolute;\n    width: 86px;\n    height: 86px;\n    border: 3px solid #304a62;\n    border-radius: 50%;\n    left: 18px;\n    bottom: -40px;\n    box-shadow: 82px -52px 0 -38px #1b3a4f;\n  }\n  .placeholder-label {\n    position: absolute;\n    font-size: 6px;\n    color: transparent;\n  }\n  .chartblock {\n    width: 100%;\n    text-align: center;\n    margin-bottom: 45px;\n  }\n  .chart-title {\n    color: #254875;\n    font-weight: bold;\n    font-size: 8px;\n    text-align: center;\n    margin: 0 0 18px;\n  }\n  .donut {\n    width: 79px;\n    height: 79px;\n    margin: auto;\n    border-radius: 50%;\n    background: conic-gradient(#52a8ed 0 20%, #8ed9ef 20% 40%, #d6e2f7 40% 100%);\n    position: relative;\n  }\n  .donut:after {\n    content: \"\";\n    position: absolute;\n    inset: 20px;\n    border-radius: 50%;\n    background: white;\n  }\n  .legend {\n    display: inline-block;\n    margin-top: 11px;\n    text-align: left;\n    color: #4a6e99;\n    font-size: 6px;\n    line-height: 2.05;\n    white-space: nowrap;\n  }\n  .swatch {\n    display: inline-block;\n    width: 6px;\n    height: 6px;\n    margin-right: 4px;\n    vertical-align: middle;\n  }\n  .pct {\n    display: inline-block;\n    width: 22px;\n    text-align: right;\n    margin-left: 13px;\n    color: #477297;\n  }\n  .conclusion {\n    margin-top: 27px;\n  }\n  .conclusion .rule { margin-bottom: 11px; }\n  .syringe {\n    height: 215px;\n    position: relative;\n    overflow: hidden;\n    margin-top: 8px;\n  }\n  .syringe .needle {\n    position: absolute;\n    left: 82px;\n    top: 1px;\n    width: 2px;\n    height: 48px;\n    background: #8a8d8c;\n  }\n  .syringe .barrel {\n    position: absolute;\n    left: 78px;\n    top: 51px;\n    width: 12px;\n    height: 78px;\n    border: 1px solid #c99b18;\n    background: repeating-linear-gradient(to bottom, #f5ca2c 0 9px, #c99714 10px 11px);\n  }\n  .syringe .plunger {\n    position: absolute;\n    left: 81px;\n    top: 129px;\n    width: 6px;\n    height: 58px;\n    background: #bfc7cd;\n  }\n  .syringe .hand-photo {\n    position: absolute;\n    right: -10px;\n    bottom: -8px;\n    width: 165px;\n    height: 119px;\n    border-radius: 55% 23% 0 0;\n    background: radial-gradient(ellipse at 42% 50%, #f2d6cf 0 20%, transparent 21%), linear-gradient(140deg, transparent 0 28%, #ecd0ca 29% 80%, #f8e8e2 81%);\n    opacity: .9;\n  }\n  .footerline {\n    height: 4px;\n    background: #50aaf0;\n    border-radius: 3px;\n    margin: 23px 1px 16px;\n  }\n  footer {\n    text-align: center;\n    color: #323943;\n    font-size: 9px;\n    line-height: 1.45;\n  }\n</style>\n</head>\n<body>\n<div class=\"poster\">\n  <header class=\"header\">\n    <h1>Uncontrolled type 1 diabetes among Egyptian<br>adolescents; risk determinants and clinical outcomes</h1>\n    <div class=\"authors\">Safina Adel Elhabashya, Eman M Mounir Sherifa, Nouran Yousef Salaha,<br>Mostafa Ahmed Elsayed Abd Elkaderb, Dina Ahmed Hosney Youssefa</div>\n    <div class=\"institution\">Pediatrics Department, Faculty of Medicine, Ain Shams University, Cairo, Egypt</div>\n    <div class=\"stethoscope\" aria-label=\"[Diagram: stethoscope held by hands]\">\n      <div class=\"tube\"></div><div class=\"ear\"></div><div class=\"ear2\"></div>\n      <div class=\"hand left\"></div><div class=\"hand right\"></div>\n      <div class=\"cuff left\"></div><div class=\"cuff right\"></div>\n    </div>\n  </header>\n\n  <div class=\"divider\"></div>\n\n  <main class=\"grid\">\n    <section>\n      <div class=\"section\">\n        <h2>Introduction</h2>\n        <div class=\"rule\"></div>\n        <p>Adolescents are exposed to multiple developmental, cognitive and emotional challenges, including independence and autonomy acquisition, identity and self esteem development, and social bond creation.</p>\n      </div>\n\n      <div class=\"section aim\">\n        <h2>Aim</h2>\n        <div class=\"rule\"></div>\n        <p>To assess the risk determinants and clinical outcomes of uncontrolled diabetes among Egyptian adolescents with T1D.</p>\n      </div>\n\n      <div class=\"section methodology\">\n        <h2>Methodology</h2>\n        <div class=\"rule\"></div>\n\n        <div class=\"step\">\n          <span class=\"number\">1</span>\n          <p>Six hundred adolescents with T1D were recruited from the Pediatric and Adolescents Diabetology Clinic, Ain-Shams University.</p>\n        </div>\n\n        <div class=\"step\">\n          <span class=\"number\">2</span>\n          <p>From the studied cohort, 200 with good glycemic control (&lt;7%) and 200 with poor control (&gt;7%) were assessed for diabetes-duration, insulin regimen, frequency of diabetic-ketoacidosis, clinically significant hypoglycemia and the Mini-International Neuropsychiatric-Interview for Children and Adolescents.</p>\n        </div>\n\n        <div class=\"step\">\n          <span class=\"number\">3</span>\n          <p>Auxological assessment, fundus and clinical screening for complications were done.</p>\n        </div>\n\n        <div class=\"step\">\n          <span class=\"number\">4</span>\n          <p>Neuropathy was confirmed by nerve conduction velocity.</p>\n        </div>\n\n        <div class=\"step\">\n          <span class=\"number\">5</span>\n          <p>Thyroid profile, anti-tissue transglutaminase-IgG, fasting lipids and urinary albumin/excretion ratio (UAER) were measured.</p>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"results\">\n      <h2>Results</h2>\n      <div class=\"rule\"></div>\n      <p class=\"results-intro\">Adolescents having uncontrolled diabetes have significantly higher diabetes onset age (p = 0.037), diabetes-duration (p = 0.038), eating disorders (p = 0.027), sadness (p = 0.038), depression (p = 0.003), suicidal manifestations (p = 0.001) and anxiety (p&lt;0.001) than the well-controlled group.</p>\n\n      <table aria-label=\"Clinical variables table\">\n        <thead>\n          <tr>\n            <th>Variables</th>\n            <th>Adolescents with<br>T1D (n =400)</th>\n            <th>Well controlled<br>Adolescents with<br>T1D (n = 200)</th>\n            <th>Well controlled<br>Adolescents with<br>T1D (n = 200)</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr><td>Empty Cell</td><td>f</td><td>p-value</td><td>f</td></tr>\n          <tr><td>Age (years)</td><td>−0.054</td><td>0.282</td><td>0.000</td></tr>\n          <tr><td>Age at diabetes<br>onset (y)</td><td>0.122*</td><td>0.014</td><td>−0.011</td></tr>\n          <tr><td>Diabetes<br>duration (y)</td><td>0.103*</td><td>0.039</td><td>0.098</td></tr>\n          <tr><td>Insulin dosage<br>(U/kg/day)</td><td>−0.051</td><td>0.312</td><td>0.082</td></tr>\n          <tr><td>Parent social<br>standard</td><td>−0.021</td><td>0.671</td><td>−0.121</td></tr>\n          <tr><td>Weight z-score</td><td>−0.043</td><td>0.391</td><td>−0.025</td></tr>\n          <tr><td>Height z-score</td><td>−0.081</td><td>0.106</td><td>0.065</td></tr>\n          <tr><td>BMI z-score</td><td>0.040</td><td>0.425</td><td>−0.067</td></tr>\n        </tbody>\n      </table>\n\n      <figure class=\"photo placeholder\" aria-label=\"[Photo: doctor holding a stethoscope]\">\n        <span class=\"placeholder-label\">[Photo: doctor holding a stethoscope]</span>\n      </figure>\n    </section>\n\n    <aside>\n      <div class=\"chartblock\">\n        <div class=\"chart-title\">Generalized anxiety</div>\n        <div class=\"donut\" aria-label=\"[Chart: generalized anxiety donut chart]\"></div>\n        <div class=\"legend\">\n          <div><span class=\"swatch\" style=\"background:#52a8ed\"></span>Adolescents with T1D <span class=\"pct\">20%</span></div>\n          <div><span class=\"swatch\" style=\"background:#8ed9ef\"></span>Well controlled Adolescents <span class=\"pct\">20%</span></div>\n          <div><span class=\"swatch\" style=\"background:#d6e2f7\"></span>Poorly controlled Adolescents <span class=\"pct\">60%</span></div>\n        </div>\n      </div>\n\n      <div class=\"chartblock\">\n        <div class=\"chart-title\">Frequency of DKA /yeared anxiety</div>\n        <div class=\"donut\" aria-label=\"[Chart: frequency of DKA donut chart]\"></div>\n        <div class=\"legend\">\n          <div><span class=\"swatch\" style=\"background:#52a8ed\"></span>Adolescents with T1D <span class=\"pct\">20%</span></div>\n          <div><span class=\"swatch\" style=\"background:#8ed9ef\"></span>Well controlled Adolescents <span class=\"pct\">20%</span></div>\n          <div><span class=\"swatch\" style=\"background:#d6e2f7\"></span>Poorly controlled Adolescents <span class=\"pct\">60%</span></div>\n        </div>\n      </div>\n\n      <div class=\"conclusion\">\n        <h2>Conclusion</h2>\n        <div class=\"rule\"></div>\n        <p>Uncontrolled T1D among adolescents is associated with older age and psychiatric comorbidities. Furthermore, it is linked to school absenteeism, hyperlipidemia, diabetic nephropathy and neuropathy.</p>\n      </div>\n\n      <div class=\"syringe placeholder\" aria-label=\"[Photo: hand holding insulin syringe]\">\n        <span class=\"needle\"></span><span class=\"barrel\"></span><span class=\"plunger\"></span><span class=\"hand-photo\"></span>\n        <span class=\"placeholder-label\">[Photo: hand holding insulin syringe]</span>\n      </div>\n    </aside>\n  </main>\n\n  <div class=\"footerline\"></div>\n  <footer>Elhabashy, S.A., Sherif, E.M.M., Salah, N.Y., Abd Elkader, M.A.E. and Youssef, D.A.H., 2022. Uncontrolled type 1 diabetes among Egyptian<br>adolescents; risk determinants and clinical outcomes. Diabetes Epidemiology and Management, 6, p.100051.</footer>\n</div>\n</body>\n</html>",
