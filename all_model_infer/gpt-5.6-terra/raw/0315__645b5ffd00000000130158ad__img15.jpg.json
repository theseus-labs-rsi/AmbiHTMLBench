rial, sans-serif;\n      font-size: 28px;\n      font-weight: 700;\n      letter-spacing: 4px;\n      line-height: 1;\n      writing-mode: vertical-rl;\n      transform: rotate(180deg);\n      white-space: nowrap;\n    }\n\n    .content {\n      position: absolute;\n      top: 17px;\n      left: 193px;\n      width: 324px;\n    }\n\n    .section {\n      margin: 0 0 8px 0;\n    }\n\n    .section-head {\n      display: inline-flex;\n      align-items: center;\n      height: 25px;\n      padding: 0 8px 0 4px;\n      color: #17151c;\n      font-size: 13px;\n      font-weight: 700;\n      line-height: 25px;\n      white-space: nowrap;\n    }\n\n    .section-head.red {\n      background: #ffdf21;\n    }\n\n    .section-head.orange {\n      background: #ffdb25;\n    }\n\n    .section-head.yellow {\n      background: #ffd929;\n    }\n\n    .section-head.green {\n      background: #f2dc26;\n    }\n\n    .section-head .number {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      width: 17px;\n      height: 17px;\n      margin-right: 6px;\n      border-radius: 50%;\n      color: white;\n      font-size: 12px;\n      font-weight: 700;\n      line-height: 17px;\n    }\n\n    .red .number {\n      background: #e94355;\n    }\n\n    .orange .number {\n      background: #ed9941;\n    }\n\n    .yellow .number {\n      background: #eabf15;\n    }\n\n    .green .number {\n      background: #26aa75;\n    }\n\n    .items {\n      margin: 11px 0 0 0;\n      padding: 0;\n      list-style: none;\n    }\n\n    .item {\n      position: relative;\n      min-height: 24px;\n      margin: 0 0 10px 0;\n      padding-left: 25px;\n      padding-right: 2px;\n      font-size: 9.2px;\n      font-weight: 600;\n      line-height: 1.62;\n      letter-spacing: 0.25px;\n    }\n\n    .item::before {\n      position: absolute;\n      top: 3px;\n      left: 7px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      width: 11px;\n      height: 11px;\n      border-radius: 50%;\n      color: white;\n      font-family: Arial, sans-serif;\n      font-size: 9px;\n      font-weight: 700;\n      line-height: 11px;\n      content: \"*\";\n    }\n\n    .section-knowledge .item::before {\n      background: #e95261;\n    }\n\n    .section-insight .item::before {\n      background: #e9a444;\n    }\n\n    .section-instruction .item::before {\n      background: #e4c914;\n    }\n\n    .section-charm .item::before {\n      background: #25ac75;\n    }\n\n    .section-knowledge {\n      margin-bottom: 7px;\n    }\n\n    .section-insight {\n      margin-bottom: 8px;\n    }\n\n    .section-instruction {\n      margin-bottom: 8px;\n    }\n\n    .section-charm {\n      margin-bottom: 0;\n    }\n\n    .section-insight .items,\n    .section-instruction .items,\n    .section-charm .items {\n      margin-top: 11px;\n    }\n\n    .section-insight .item {\n      margin-bottom: 13px;\n    }\n\n    .section-instruction .item {\n      margin-bottom: 11px;\n    }\n\n    .section-charm .item {\n      margin-bottom: 12px;\n    }\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <div class=\"left-title\" aria-label=\"Master Coach 业界高手他们的五项技能\">\n      <div class=\"title-line master\">Master</div>\n      <div class=\"title-line coach\">Coach</div>\n      <div class=\"title-line chinese\">业界高手</div>\n      <div class=\"title-line chinese\">他们的五项</div>\n      <div class=\"title-line chinese last\">技能</div>\n    </div>\n\n    <div class=\"watermark\">ZONG HENG SI HAI</div>\n\n    <div class=\"content\">\n      <section class=\"section section-knowledge\">\n        <div class=\"section-head red\">\n          <span class=\"number\">1</span>\n          <span>知识矩阵</span>\n        </div>\n        <ul class=\"items\">\n          <li class=\"item\">从各个角度思考：推演出无穷无尽的点</li>\n          <li class=\"item\">是一种神秘的混合物，包含了技术上的知识、策略、经验</li>\n          <li class=\"item\">能信手拈来，判断理解学生的进度，接下来应该朝哪方向努力</li>\n          <li class=\"item\">这是「教」的知识矩阵，属于你独有的心理表征，而不是「做」的知识矩阵。教学是一项区别于亲身实践的独立技能。</li>\n        </ul>\n      </section>\n\n      <section class=\"section section-insight\">\n        <div class=\"section-head orange\">\n          <span class=\"number\">2</span>\n          <span>洞察力</span>\n        </div>\n        <ul class=\"items\">\n          <li class=\"item\">著名的篮球教练John Wooden，对一些球员大多是表扬，对另一些球员则主要是批评</li>\n          <li class=\"item\">Wooden认为，每一位球员的身高、体重、背景、智力、才能，都不一样。每一位球员都需要区别对待</li>\n          <li class=\"item\">好的教练必须拥有对他人（而不仅仅是对自己）极高的洞察力，才能因材施教</li>\n        </ul>\n      </section>\n\n      <section class=\"section section-instruction\">\n        <div class=\"section-head yellow\">\n          <span class=\"number\">3</span>\n          <span>简洁的指示</span>\n        </div>\n        <ul class=\"items\">\n          <li class=\"item\">John Wooden的讲话很少超过20秒；动作示范才3秒</li>\n          <li class=\"item\">在记录的2326次教练行为中，仅6.9%是表扬，6.6%是批评，75%是指示的信息：该做什么，何时做，何时强化</li>\n          <li class=\"item\">示范使用总分总：先整体如何，再拆解（或演示错误的做法），再整体</li>\n          <li class=\"item\">这对表达能力是很高的要求</li>\n        </ul>\n      </section>\n\n      <section class=\"section section-charm\">\n        <div class=\"section-head green\">\n          <span class=\"number\">4</span>\n          <span>个人魅力</span>\n        </div>\n        <ul class=\"items\">\n          <li class=\"item\">天才的早期老师，大多不是世界高手，但天才会跟他们学习长达5-6年的时间</li>\n          <li class=\"item\">他们是那种孩子喜欢的老师，人和蔼可亲，对孩子鼓励，给孩子榜样，爱护孩子</li>\n          <li class=\"item\">万事开头难，一开始处处都是出错，重点是把这件事变得令人向往；检讨，能坚持；有所回报</li>\n          <li class=\"item\">教练必须拥有共情力，有个人魅力，牢牢吸住学生</li>\n        </ul>\n      </section>\n    </div>\n  </main>\n</body>\n</html>"
