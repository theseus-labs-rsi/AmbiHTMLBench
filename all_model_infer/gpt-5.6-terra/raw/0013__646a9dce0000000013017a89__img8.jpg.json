        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>小学生1-6年级必背古诗·三年级下册</title>\n  <script>\n    window.MathJax = { tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] } };\n  </script>\n  <script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      min-height: 100vh;\n      display: flex;\n      justify-content: center;\n      align-items: flex-start;\n      background:\n        radial-gradient(circle at 15% 12%, rgba(255,239,153,.85) 0 3%, transparent 3.5%),\n        radial-gradient(circle at 84% 8%, rgba(255,230,123,.72) 0 4%, transparent 4.5%),\n        linear-gradient(135deg, #ffcf55, #ffe497 45%, #f9c84b);\n      font-family: \"KaiTi\", \"STKaiti\", \"SimSun\", serif;\n      color: #303030;\n    }\n    .poster {\n      width: 540px;\n      min-height: 720px;\n      padding-top: 16px;\n      position: relative;\n      overflow: hidden;\n      background:\n        linear-gradient(90deg, rgba(255,215,92,.24) 0 5%, transparent 5% 95%, rgba(255,215,92,.24) 95%),\n        radial-gradient(circle at 20% 2%, rgba(255,244,180,.72), transparent 18%),\n        linear-gradient(135deg, #ffd05c, #ffe29a 55%, #f6c548);\n    }\n    .main-title {\n      text-align: center;\n      white-space: nowrap;\n      color: #d71942;\n      font-family: \"Microsoft YaHei\", \"Heiti SC\", sans-serif;\n      font-size: 42px;\n      font-weight: 900;\n      letter-spacing: 1px;\n      line-height: 1.25;\n      text-shadow:\n        -2px -2px 0 #fff8d4,\n         2px -2px 0 #fff8d4,\n        -2px  2px 0 #fff8d4,\n         2px  2px 0 #fff8d4,\n         0 4px 2px rgba(160,77,27,.3);\n    }\n    .sheet {\n      position: relative;\n      margin: 23px 10px 12px;\n      padding: 30px 6px 9px;\n      border-radius: 18px 18px 4px 4px;\n      background:\n        repeating-linear-gradient(0deg, rgba(129,158,166,.09) 0 1px, transparent 1px 15px),\n        repeating-linear-gradient(90deg, rgba(129,158,166,.08) 0 1px, transparent 1px 15px),\n        rgba(255,255,249,.94);\n      box-shadow: 0 1px 0 rgba(255,255,255,.9);\n    }\n    .grade {\n      position: absolute;\n      left: 50%;\n      top: -25px;\n      transform: translateX(-50%);\n      min-width: 237px;\n      height: 43px;\n      padding: 4px 23px 6px;\n      color: white;\n      background: #bd461b;\n      border-radius: 23px;\n      text-align: center;\n      font-family: \"Microsoft YaHei\", sans-serif;\n      font-size: 26px;\n      font-weight: 800;\n      line-height: 33px;\n      letter-spacing: 1px;\n      box-shadow: inset 0 1px 0 rgba(255,238,192,.5);\n    }\n    .grade::before,\n    .grade::after {\n      content: \"•\";\n      position: absolute;\n      top: 2px;\n      font-size: 25px;\n      color: #fff1cf;\n    }\n    .grade::before { left: 10px; }\n    .grade::after { right: 10px; }\n    .poem-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n    }\n    .poem {\n      min-height: 188px;\n      padding: 0 7px 7px;\n      text-align: center;\n      border-right: 2px dashed rgba(159,162,148,.36);\n      border-bottom: 2px dashed rgba(159,162,148,.36);\n    }\n    .poem:nth-child(3n) { border-right: 0; }\n    .poem:nth-last-child(-n+3) {\n      border-bottom: 0;\n      padding-top: 15px;\n    }\n    .poem-title {\n      color: #a6482c;\n      font-family: \"Microsoft YaHei\", \"SimHei\", sans-serif;\n      font-size: 18px;\n      font-weight: 800;\n      line-height: 1.35;\n      white-space: nowrap;\n      margin-bottom: 1px;\n    }\n    .author {\n      font-size: 18px;\n      line-height: 1.28;\n      color: #555;\n    }\n    .lines {\n      margin-top: 2px;\n      font-size: 18px;\n      font-weight: 600;\n      line-height: 1.52;\n      white-space: nowrap;\n    }\n    .poem.long .lines { font-size: 17px; }\n  </style>\n</head>\n<body>\n  <main class=\"poster\">\n    <div class=\"main-title\">小学生1-6年级必背古诗</div>\n\n    <section class=\"sheet\">\n      <div class=\"grade\">三年级・下册</div>\n\n      <div class=\"poem-grid\">\n        <article class=\"poem\">\n          <div class=\"poem-title\">《绝句》</div>\n          <div class=\"author\">【唐】杜甫</div>\n          <div class=\"lines\">迟日江山丽，<br>春风花草香。<br>泥融飞燕子，<br>沙暖睡鸳鸯。</div>\n        </article>\n\n        <article class=\"poem long\">\n          <div class=\"poem-title\">《惠崇春江晚景》</div>\n          <div class=\"author\">【宋】苏轼</div>\n          <div class=\"lines\">竹外桃花三两枝，<br>春江水暖鸭先知。<br>蒌蒿满地芦芽短，<br>正是河豚欲上时。</div>\n        </article>\n\n        <article class=\"poem\">\n          <div class=\"poem-title\">《三衢道中》</div>\n          <div class=\"author\">【宋】曾几</div>\n          <div class=\"lines\">梅子黄时日日晴，<br>小溪泛尽却山行。<br>绿阴不减来时路，<br>添得黄鹂四五声。</div>\n        </article>\n\n        <article class=\"poem\">\n          <div class=\"poem-title\">《忆江南》</div>\n          <div class=\"author\">【唐】白居易</div>\n          <div class=\"lines\">江南好，<br>风景旧曾谙。<br>日出江花红胜火，<br>春来江水绿如蓝，<br>能不忆江南？</div>\n        </article>\n\n        <article class=\"poem\">\n          <div class=\"poem-title\">《元日》</div>\n          <div class=\"author\">【宋】王安石</div>\n          <div class=\"lines\">爆竹声中一岁除，<br>春风送暖入屠苏。<br>千门万户曈曈日，<br>总把新桃换旧符。</div>\n        </article>\n\n        <article class=\"poem\">\n          <div class=\"poem-title\">《清明》</div>\n          <div class=\"author\">【唐】杜牧</div>\n          <div class=\"lines\">清明时节雨纷纷，<br>路上行人欲断魂。<br>借问酒家何处有，<br>牧童遥指杏花村。</div>\n        </article>\n\n        <article class=\"poem\">\n          <div class=\"poem-title\">《九月九日忆山东兄弟》</div>\n          <div class=\"author\">【唐】王维</div>\n          <div class=\"lines\">独在异乡为异客，<br>每逢佳节倍思亲。<br>遥知兄弟登高处，<br>遍插茱萸少一人。</div>\n        </article>\n\n        <article class=\"poem\">\n          <div class=\"poem-title\">《滁州西涧》</div>\n          <div class=\"author\">【唐】韦应物</div>\n          <div class=\"lines\">独怜幽草涧边生，<br>上有黄鹂深树鸣。<br>春潮带雨晚来急，<br>野渡无人舟自横。</div>\n        </article>\n\n        <article class=\"poem\">\n          <div class=\"poem-title\">《大林寺桃花》</div>\n          <div class=\"author\">【唐】白居易</div>\n          <div class=\"lines\">人间四月芳菲尽，<br>山寺桃花始盛开。<br>长恨春归无觅处，<br>不知转入此中来。</div>\n        </article>\n      </div>\n    </section>\n  </main>\n</body>\n</html>"
