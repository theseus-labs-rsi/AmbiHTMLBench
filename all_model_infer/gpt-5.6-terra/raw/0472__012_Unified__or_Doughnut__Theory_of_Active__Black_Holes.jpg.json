e-height: 12px;\n      font-weight: bold;\n      text-align: center;\n    }\n    .why .caption {\n      position: absolute;\n      bottom: 18px;\n      width: 205px;\n      font-size: 10px;\n      line-height: 11px;\n      font-weight: bold;\n      text-align: center;\n    }\n    .why .caption.left { left: 23px; }\n    .why .caption.right { right: 23px; }\n    .expect {\n      height: 302px;\n      background: #042942;\n      position: relative;\n    }\n    .galaxy {\n      position: absolute;\n      border-radius: 50%;\n      background: radial-gradient(ellipse at center, #fff0b9 0 4%, #d0863e 10%, #38251a 24%, transparent 52%);\n      transform: rotate(28deg);\n    }\n    .g1 { width: 92px; height: 63px; left: 5px; top: 35px; }\n    .g2 { width: 76px; height: 83px; left: 235px; top: 4px; background: radial-gradient(ellipse, #25170d 0 33%, transparent 38%); }\n    .g3 { width: 91px; height: 87px; left: 351px; top: 12px; }\n    .g4 { width: 78px; height: 85px; right: 20px; top: 2px; background: radial-gradient(ellipse, #21160e 0 32%, transparent 38%); }\n    .g5 { width: 85px; height: 64px; left: 91px; top: 101px; }\n    .g6 { width: 95px; height: 58px; right: 12px; top: 151px; }\n    .g7 { width: 91px; height: 55px; left: 7px; bottom: 4px; background: radial-gradient(ellipse, #21160e 0 32%, transparent 38%); }\n    .g8 { width: 89px; height: 58px; left: 113px; bottom: 28px; background: radial-gradient(ellipse, #21160e 0 32%, transparent 38%); }\n    .g9 { width: 92px; height: 56px; left: 218px; bottom: 7px; }\n    .g10 { width: 90px; height: 85px; right: 122px; bottom: 1px; }\n    .expect-copy {\n      position: absolute;\n      left: 169px;\n      top: 116px;\n      width: 258px;\n      font-size: 11px;\n      font-weight: bold;\n      line-height: 13px;\n      text-align: center;\n      text-shadow: 0 1px 2px #000;\n    }\n    .wise {\n      min-height: 392px;\n      background: #005743;\n      position: relative;\n      padding-bottom: 14px;\n    }\n    .wise h2 { padding-bottom: 11px; }\n    .wise-grid {\n      display: grid;\n      grid-template-columns: 151px 1fr;\n      gap: 13px;\n      padding: 0 19px;\n      align-items: start;\n    }\n    .satellite {\n      width: 151px;\n      height: 88px;\n      background:\n        radial-gradient(circle at 15% 20%, #fffac1 0 3%, #a0985a 6%, transparent 13%),\n        linear-gradient(135deg, #234781 0 44%, #597d91 45% 50%, #19263b 51% 100%);\n      border: 1px solid #2c8a85;\n    }\n    .small-copy {\n      margin-top: 4px;\n      font-size: 11px;\n      line-height: 12px;\n      font-weight: bold;\n    }\n    .purple {\n      height: 185px;\n      border: 1px solid #418f98;\n      background:\n        radial-gradient(circle at 67% 49%, #c775ff 0 1%, #722f9e 8%, transparent 24%),\n        radial-gradient(circle at 54% 57%, #e3a0ff 0 1%, #8d3db3 8%, transparent 28%),\n        radial-gradient(circle at 48% 15%, #879ac1 0 1%, transparent 4%),\n        #041220;\n    }\n    .purple::before {\n      content: \"\";\n      display: block;\n      width: 100%;\n      height: 100%;\n      background-image: radial-gradient(#c4d5ff 0.7px, transparent 0.8px);\n      background-size: 11px 11px;\n      opacity: .65;\n    }\n    .wide-copy {\n      grid-column: 2;\n      margin-top: -1px;\n      font-size: 11px;\n      line-height: 12px;\n      font-weight: bold;\n    }\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <header class=\"header\">\n      <div class=\"nasa\">NASA</div>\n      <div class=\"jpl\">Jet Propulsion Laboratory<small>California Institute of Technology</small></div>\n    </header>\n\n    <section class=\"top\">\n      <h1>Anatomy of an Active Black Hole</h1>\n      <div class=\"circle black-hole placeholder\">\n        <span>Supermassive Black Hole<br><i>Size: as big as Mercury's orbit</i></span>\n        <span class=\"bottom-label\">[Black hole and disk]</span>\n      </div>\n      <div class=\"circle host placeholder\">\n        <span>Host Galaxy<br><i>Size: about 100,000 light-years</i></span>\n        <span class=\"bottom-label\">[Host galaxy]</span>\n      </div>\n      <div class=\"circle dust placeholder\">\n        <span class=\"bottom-label\">\"Doughnut\" Ring of Dust &amp; Gas<br><i>Size: around 1 light year</i></span>\n      </div>\n      <p class=\"top-text top-left\">Astronomers call supermassive black<br>holes and their surrounding disks<br>\"Active Galactic Nuclei\" or \"AGN\"</p>\n      <p class=\"top-text top-right\">Black holes emit no light, but<br>the glow from the bright<br>material swirling around them<br>can be seen by telescopes.</p>\n    </section>\n\n    <section class=\"why\">\n      <h2>Why Do Active Black Holes Look Different?</h2>\n      <div class=\"circle face placeholder\">[Face-on dusty doughnut]</div>\n      <div class=\"circle edge placeholder\">[Edge-on dusty doughnut]</div>\n      <p class=\"why center-copy\">In some galaxies the black hole regions are <i>incredibly bright</i>, while in other galaxies they appear <i>much darker</i>.<br><br>A <i>\"unified model\"</i> suggests the angle at which we view them can explain the differences.</p>\n      <p class=\"caption left\">Seen face-on, we detect the light from the hot material surrounding the black hole.</p>\n      <p class=\"caption right\">When viewed through the edge of the dusty doughnut, the black hole is hidden.</p>\n    </section>\n\n    <section class=\"expect\">\n      <h2>What We Expect to See</h2>\n      <div class=\"galaxy g1\"></div><div class=\"galaxy g2\"></div><div class=\"galaxy g3\"></div><div class=\"galaxy g4\"></div>\n      <div class=\"galaxy g5\"></div><div class=\"galaxy g6\"></div><div class=\"galaxy g7\"></div><div class=\"galaxy g8\"></div>\n      <div class=\"galaxy g9\"></div><div class=\"galaxy g10\"></div>\n      <p class=\"expect-copy\">Galaxies are oriented randomly in the sky so the disks<br>in their centers should be oriented randomly as well.<br><br>Thus we expect to see a random mix of exposed and<br>hidden black holes everywhere we look.</p>\n    </section>\n\n    <section class=\"wise\">\n      <h2>WISE Observations Challenge “Unified Model”</h2>\n      <div class=\"wise-grid\">\n        <div>\n          <div class=\"satellite placeholder\">[WISE satellite]</div>\n          <p class=\"small-copy\">Observations with NASA's Wide-field Infrared Survey Explorer reveal that hidden black holes tend to be <i>more clumped together</i> than exposed ones.<br><br>This violates the \"unified model,\" which predicts we should see the same distribution of dusty doughnuts regardless of the viewing angle.</p>\n        </div>\n        <div class=\"purple placeholder\">[Infrared galaxy distribution map]</div>\n        <p class=\"wide-copy\">Strongly clumped galaxies are likely to have larger halos of dark matter (shown artistically here in purple), which might provide a clue about what else besides the angle could be hiding the black holes.</p>\n      </div>\n    </section>\n  </main>\n</body>\n</html>"
