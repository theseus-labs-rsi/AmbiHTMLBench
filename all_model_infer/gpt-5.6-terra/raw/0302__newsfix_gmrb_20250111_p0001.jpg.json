YaHei\",sans-serif;font-weight:bold;font-size:42px;line-height:1.23;writing-mode:vertical-rl;text-orientation:upright;letter-spacing:2px;height:697px}\n.article-box{background:#fdf0ee;padding:11px 10px 8px}\n.article-box h1{font-family:\"SimSun\",serif;font-size:31px;font-weight:normal;line-height:1.3;margin:0 0 12px;border-bottom:1px solid #e7c7c1;padding-bottom:8px}\n.article-box p,.article p{font-size:13px;line-height:1.65;text-align:justify;margin:5px 0}\n.byline{text-align:right;font-size:12px!important;margin-top:7px!important}\n.columns{display:grid;grid-template-columns:1fr 1fr;gap:17px;padding:13px 8px 0}\n.image-block{margin-top:14px;border-top:1px solid #777;padding-top:12px}\n.placeholder{background:#d9e0df;border:1px solid #aaa;display:flex;align-items:center;justify-content:center;color:#555;text-align:center}\n.photo{height:290px;background:linear-gradient(#8db4c7 0 30%,#4c8eaa 30% 50%,#789c55 50% 100%);position:relative;overflow:hidden}\n.photo:before{content:\"\";position:absolute;inset:47% 0 0;background:repeating-linear-gradient(165deg,#547c42 0 17px,#b66e3d 18px 31px,#678d46 32px 55px,#d19b51 56px 69px)}\n.photo:after{content:\"\";position:absolute;left:0;right:0;top:31%;height:18%;background:linear-gradient(180deg,#86b9d0,#3d7f9d)}\n.caption{font-size:13px;text-align:center;margin:5px 0 0}\n.caption strong{background:#e36d45;color:#fff;font-size:20px;padding:2px 8px;margin-right:18px}\n.bottom-article{margin-top:13px;border:2px solid #b34e3f;padding:18px 19px 12px;position:relative}\n.bottom-article:before{content:\"\";position:absolute;left:4px;right:4px;top:5px;height:8px;border-top:2px solid #b34e3f}\n.bottom-article h2{text-align:center;font-size:35px;margin:12px 0 14px;font-weight:normal}\n.bottom-article .columns{padding:0;gap:18px}\n.bottom-article p{font-size:13px;line-height:1.7;text-align:justify;margin:4px 0}\n.right-top{height:261px;background:#fff3f0;margin-top:0;padding:9px 14px;display:grid;grid-template-columns:1fr 1fr;gap:18px}\n.right-top h2{grid-column:1/-1;text-align:center;font-size:31px;margin:0 0 -6px;font-weight:normal}\n.right-top p{font-size:12px;line-height:1.55;text-align:justify;margin:0}\n.right-intro{font-size:13px;line-height:1.5;padding:5px 12px 10px;border-bottom:1px solid #888}\n.right-intro p{margin:0}\n.right-main{padding-top:22px;border-bottom:1px solid #888;padding-bottom:12px}\n.right-main h1{font-size:37px;font-weight:normal;text-align:center;margin:0 0 1px;line-height:1.25}\n.right-main h2{text-align:center;font-size:22px;font-weight:normal;margin:0 0 14px}\n.right-main .columns{padding:0 12px;grid-template-columns:1fr 1fr 1fr;gap:17px}\n.right-main p{font-size:12.5px;line-height:1.55;text-align:justify;margin:0 0 8px}\n.section-title{text-align:center;font-size:39px;letter-spacing:15px;margin:20px 0 5px;font-weight:bold}\n.section-title em{font-style:normal;color:#c55f3d;font-size:31px;letter-spacing:1px;margin-left:60px}\n.section-sub{text-align:center;font-size:14px;margin-bottom:9px}\n.feature{background:#fff5ef;padding:10px 18px 11px;border-bottom:1px solid #aaa}\n.feature .columns{padding:0;grid-template-columns:1fr 1fr;gap:28px}\n.feature p{font-size:13px;line-height:1.6;text-align:justify;margin:3px 0}\n.continue{padding-top:20px}\n.continue-label{text-align:center;color:#0a8caa;font-size:28px;font-weight:bold;margin-bottom:10px}\n.continue h1{text-align:center;font-size:36px;font-weight:normal;margin:0 0 13px}\n.continue .columns{padding:0 10px;grid-template-columns:1fr 1fr 1fr;gap:18px}\n.continue p{font-size:12.5px;line-height:1.62;text-align:justify;margin:0}\n.footer-note{text-align:right;font-size:11px;margin-top:11px}\n@media(max-width:900px){\n.page{width:100%;padding:12px}\n.masthead{height:auto;display:block}\n.logo{width:100%;height:145px}\n.logo-script{font-size:72px;left:8px}\n.logo-name{left:75px;font-size:13px;bottom:8px}\n.headline{padding:5px 0 10px}\n.headline .small{font-size:20px}\n.headline .large{font-size:27px}\n.content{display:block}\n.left{border-right:0;padding-right:0}\n.right{margin-top:20px}\n.vertical-title{font-size:30px;height:500px}\n.lead-left{grid-template-columns:125px 1fr}\n.article-box h1{font-size:23px}\n.columns,.right-main .columns,.continue .columns{grid-template-columns:1fr}\n.right-top{height:auto}\n}\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <header>\n    <div class=\"masthead\">\n      <div class=\"logo\">\n        <div class=\"logo-script\">光明日报</div>\n        <div class=\"logo-name\">GUANGMING RIBAO</div>\n      </div>\n      <div class=\"headline\">\n        <div class=\"small\">习近平回信勉励国家京剧院青年艺术工作者</div>\n        <div class=\"large\">坚持崇德尚艺守正创新<br>让京剧艺术持续焕发时代光彩</div>\n      </div>\n    </div>\n    <div class=\"datebar\">2025年1月11日　星期六　农历甲辰年十二月十二　今日12版</div>\n    <div class=\"subbar\">光明网网址:http://www.gmw.cn　国内统一连续出版物号 CN 11-0026　代号1-16　邮 27374号</div>\n  </header>\n\n  <main class=\"content\">\n    <section class=\"left\">\n      <div class=\"lead-left\">\n        <div class=\"vertical-title\">习近平致信中国法学会第九次全国会员代表大会强调</div>\n        <article class=\"article-box\">\n          <h1>努力开创法学会事业发展新局面</h1>\n          <p>习近平致中国法学会第九次全国会员代表大会的信</p>\n          <p>值此中国法学会第九次全国会员代表大会召开之际，我向全国广大法学法律工作者致以问候！</p>\n          <p>党的十八大以来，各级法学会广大法律工作者坚持以习近平法治思想为指导，深入贯彻落实依法治国基本方略，积极投身全面依法治国实践，为推进中国式现代化作出了积极贡献。</p>\n          <p>新时代新征程，各级法学会要持续深入贯彻党的二十大和二十届二中、三中全会精神，坚持以习近平新时代中国特色社会主义思想为指导，全面贯彻新时代中国特色社会主义法治思想，坚持服务党和国家工作大局，坚持守正创新，努力开创法学会事业发展新局面。</p>\n          <p>希望广大法学法律工作者坚持正确政治方向，坚持中国特色社会主义法治道路，坚定法治信仰，厚植为民情怀，积极为推进中国式现代化建设贡献智慧和力量。</p>\n          <p class=\"byline\">习近平<br>2025年1月10日<br>（新华社北京1月10日电）</p>\n        </article>\n      </div>\n      <div class=\"columns\">\n        <article class=\"article\">\n          <p>新华社北京1月10日电　在中国法学会第九次全国会员代表大会召开之际，中共中央总书记、国家主席、中央军委主席习近平致信大会。</p>\n          <p>习近平指出，党的十八大以来，各级法学会和广大法学法律工作者坚持以习近平新时代中国特色社会主义思想为指导，深入贯彻习近平法治思想，积极投身全面依法治国实践，为推进中国式现代化作出了积极贡献。</p>\n          <p>习近平强调，新征程上，各级法学会要坚持正确政治方向，坚持中国特色社会主义法治道路，坚持守正创新，努力开创法学会事业发展新局面。</p>\n          <p>要坚持党的领导，深入学习贯彻习近平法治思想，坚定法治信仰，厚植为民情怀，积极服务党和国家工作大局。</p>\n        </article>\n        <article class=\"article\">\n          <p>习近平指出，要加强法学会自身建设，努力建设一支忠于党、忠于国家、忠于人民、忠于法律的法学法律工作者队伍。</p>\n          <p>要充分发挥法学会在全面依法治国中的重要作用，深入开展法治宣传教育，繁荣发展法学研究，推进法治人才培养，为推进中国式现代化、建设社会主义法治国家作出新的更大贡献。</p>\n          <p>全国人大常委会副委员长、中华全国总工会主席王东明在大会上致辞。他说，各级法学会要深入学习贯彻习近平总书记重要指示精神，坚持党的全面领导，强化政治引领，依法履职尽责，勇于改革创新。</p>\n          <p>大会审议通过了中国法学会第八届理事会工作报告，选举产生了中国法学会第九届理事会。</p>\n        </article>\n      </div>\n\n      <div class=\"image-block\">\n        <div class=\"placeholder photo\">[照片：城市湖泊与秋色景观，位于版面左下]</div>\n        <p class=\"caption\"><strong>大美中国</strong>如画冬景　近日，国务院举行电力扩能补强建设工程，换貌洲机场市天际线，助力青岛文旅融合发展。图为近日，徐州北湖公园的如画美景。 <b>孙井焕摄/光明图片</b></p>\n      </div>\n\n      <article class=\"bottom-article\">\n        <h2>宝庆瓷刻</h2>\n        <div class=\"columns\">\n          <div>\n            <p>讲述人：湖南省非物质文化遗产“宝庆瓷刻”省级代表性传承人　刘金锋</p>\n            <p>“吾魂兮——”又春那滨克的鸣唱声，在今仍在耳畔回响。过去，他是走南闯北的号票匠，所到之处，小孩们总喜欢围拢来。他乐呵呵地从兜里摸出瓷器，等人发上一小块，拍手说：“快去哦，快去哦……”小咖叫“们”们使演辉事略。</p>\n            <p>及时，家庭户户要在烧成刻字之中，白白喜喜喜，家家欢歌笑语，载在一块片，勤劳并留下鲜艳新年景色。萍罗织“号票”。</p>\n            <p>乡湖南邵阳古称“宝庆”，因而宝庆瓷刻如如今，残摊近百余年的农工，在烧制好的瓷器上，以刻刀代笔，雕琢出精美图案。</p>\n          </div>\n          <div>\n            <p>瓷刻步骤不繁，却讲究精细：先用毛笔勾勒线条，整幅布局精细，再用刻刀雕刻，由方尖圆润。最后是填色，按形填色，晕染自然。</p>\n            <p>随着时代的不断变迁，瓷刻技艺也面临传承难题。为了让更多年轻人了解这项技艺，我坚持走进校园、社区开展教学，培养传承人。</p>\n            <p>如今，宝庆瓷刻已形成了独具特色的艺术风格，作品内容丰富，表现手法多样。希望这门古老技艺能够焕发新的生命力。</p>\n            <p style=\"text-align:center;font-size:24px;color:#ad4a3d;font-weight:bold\">中国传统手艺</p>\n          </div>\n        </div>\n      </article>\n    </section>\n\n    <section class=\"right\">\n      <div class=\"right-top\">\n        <h2>回　信</h2>\n        <div>\n          <p><b>国家京剧院青年艺术工作者：</b></p>\n          <p>来信收悉。值此国家京剧院建院70周年之际，向你们以及全院演职人员表示祝贺和问候。</p>\n          <p>国家京剧院成立以来，坚持党的文艺方针政策，创排了许多经典剧目，涌现出不少优秀艺术人才，为中华戏曲艺术的发展作出了积极贡献。新征点上，希望你们传承创新、以德艺双馨的艺术家为民。</p>\n        </div>\n        <div>\n          <p>你们传承革命老戏院传统，践行艺术为民，坚持崇德尚艺，守正创新，认真做好艺术传承发展的时代接力，为繁荣京剧艺术、建设文化强国贡献力量。</p>\n          <p style=\"text-align:right;font-weight:bold\">习近平<br>2025年1月9日<br>（新华社北京1月10日电）</p>\n        </div>\n      </div>\n      <div class=\"right-intro\">\n        <p><b>新华社北京1月10日电</b>　近日，国家京剧院成立70周年之际，中共中央总书记、国家主席、中央军委主席习近平回信，向全院演职人员表示祝贺和问候。</p>\n      </div>\n\n      <article class=\"right-main\">\n        <h1>矢志不渝做党和人民的忠诚卫士</h1>\n        <h2>——写在第五个中国人民警察节到来之际</h2>\n        <div class=\"columns\">\n          <div>\n            <p>2025年1月10日，第五个中国人民警察节。公安机关和广大公安民警忠实履行新时代使命任务，坚定不移做党和人民的忠诚卫士。</p>\n            <p>这是一支有着光荣传统和英雄辈出的队伍，也是一支朝气蓬勃、最善战最勇敢的广大队伍。</p>\n            <h3>砺剑——提升公安机关新质战斗力</h3>\n            <p>2024年5月28日，北京人民大会堂，习近平总书记会见全国公安工作会议代表，强调全国公安机关要坚持政治建警、改革强警、科技兴警、从严治警。</p>\n            <p>锚定公安工作现代化目标，全国公安机关落实创新、主动、规范、协同、精细、务实的新时代警务理念。</p>\n          </div>\n          <div>\n            <p>寻找“蛛丝马迹”，一支支特战的侦查团队也同步上峰，他们在缉查破案中大海捞针；用好人才，才能打造智慧警务。</p>\n            <p>“智能交通管理模型”数字化防控，强化公安交通管理；公安机关坚持高标准严要求，筑牢平安底线。</p>\n            <p>“全警深拥科技创新”，通过梳理底层逻辑、加强顶层设计持续优化工作模式，建立起犯罪查处新机制。</p>\n            <p>新质战斗力提升，充分体现公安机关坚持科技兴警、数字赋能，不断提升打击犯罪、维护稳定、服务群众的能力水平。</p>\n          </div>\n          <div>\n            <p>服务工作，累计发布各类愉情预警16.4万余条。</p>\n            <p>“实时推送预警、路面即时管控、同步落实”，把预警信息的触角延伸至各类复杂场景，多措并举，全力维护道路交通安全。</p>\n            <p>着力提高专业能力，完善“情指行”一体化运行机制，推进公安大数据智能化建设应用，“专业卡机制大数据”新型警务运行模式。</p>\n            <h3>为民——服务人民<br>保障经济社会高质量发展</h3>\n            <p>“网上申请、邮寄到家。”北京东海地区的李先生因出差无法办理业务，在网上申请身份证补领业务，不到一周便收到新身份证。</p>\n          </div>\n        </div>\n      </article>\n\n      <div class=\"section-title\">搭 帐 篷 <em>我在现场</em></div>\n      <div class=\"section-sub\">本报前方报道组</div>\n      <section class=\"feature\">\n        <div class=\"columns\">\n          <div>\n            <p>“这边还能再搭两顶！”</p>\n            <p>“地”方面好了，再把防风绳系上！”</p>\n            <p>深夜，西藏日喀则市多吉措村临时安置点，气温已降到零下20摄氏度。驻地的寒风中，记者看到一群青年干警正在紧锣密鼓。</p>\n            <p>顶账篷。我们大下午5点就开始搭55顶帐篷。我们队伍下兵点就开始。</p>\n          </div>\n          <div>\n            <p>村民给搭帐篷，现在忙好了近40顶，得得再加把力！”谢通们早公安支援安置工作组说。</p>\n            <p>从灾区到家园建设，工作人员积极支援，帮助受灾群众渡过难关。</p>\n            <p>凌晨2点，帐篷终于全部搭好。见全村人都进了帐篷，小伙子们终于松了口气。</p>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"continue\">\n        <div class=\"continue-label\">/ 连续报道 /</div>\n        <h1>我为奔赴西部的“队友”骄傲！</h1>\n        <div class=\"columns\">\n          <div>\n            <p><b>光明日报编辑部：</b></p>\n            <p>读者来信把西部、新时代学子这样选择！一众，我立刻分享引发朋友圈，还点出发给了几个位在西部工作的同路人。</p>\n            <p>很快，回复发来三三两两：“为这些青年点赞啦，他们为我们的青春点赞！”其实，想起了我的西部岁月，那段记忆，永远都留在心里。</p>\n            <p>看着这些字句，我的思绪禁不住飘回一个叫古浪的地方。</p>\n            <p>2013年8月，作为福建师范大学第十五届扶贫接力计划研究生支教团的一员，我从福州跨越2500公里，来到甘肃武威古浪县。</p>\n          </div>\n          <div>\n            <p>“什么都别怕，只管努力去闯！”数学班的孩子，一定不会给生活困住！</p>\n            <p>我们为高原铁路下一对一贫困人，全年为上不断做功勋，生活十分贫困。</p>\n            <p>如今，孩子们都已长大成人，走上了各自的工作岗位。有的成为一名优秀教师，有的进入科研单位，也有的从事基层工作。</p>\n            <p>在新疆工作，像您那样我一样，尽力去帮助更多的人。“现在，地上已经养新鲜营养丰富的一名小学教师。”</p>\n            <p>就像最择择评论所说，“西部是淬化心灵、激扬心志的课堂”。我愿来感到，我将给西部的大小太，西部给予我的业多太多。</p>\n          </div>\n          <div>\n            <p>现在想来，许是那时他们心里便有了打算。2018年，那都告诉了家乡高校的工作，盐上同为支教队友的发育人曾增。</p>\n            <p>无数个分别日夜，印刻在党校这片土地上，记忆在工作队中从未被抹去。</p>\n            <p>我打心底里替他们高兴，向他们致敬！</p>\n            <p>我也一直和古浪娃娃们保持着联系，他们一个个都从懵懂得不敢与陌生人对视的孩子，成长为在各自岗位上独当一面的青年才俊。</p>\n            <p>我会继续为西部喝彩，为新时代的青年喝彩！</p>\n            <p class=\"footer-note\">福建师范大学马克思主义学院<br>博士生 杨媛<br>读者来信邮箱：gmrbzxb@163.com</p>\n          </div>\n        </div>\n      </section>\n    </section>\n  </main>\n</div>\n</body>\n</html>"
      },
