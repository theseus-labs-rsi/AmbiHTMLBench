        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>光明日报 2025年1月21日</title>\n<script>\nwindow.MathJax = { tex: { inlineMath: [['$', '$'], ['\\\\(', '\\\\)']] } };\n</script>\n<script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n    * { box-sizing: border-box; }\n    html, body { margin: 0; padding: 0; background: #fff; color: #111; }\n    body {\n        width: 1240px;\n        margin: 0 auto;\n        font-family: \"Noto Serif SC\", \"Songti SC\", \"SimSun\", serif;\n        font-size: 15px;\n        line-height: 1.55;\n    }\n    .page {\n        padding: 25px 20px 20px;\n    }\n    .masthead {\n        display: grid;\n        grid-template-columns: 49% 51%;\n        align-items: start;\n        min-height: 210px;\n    }\n    .logo {\n        height: 180px;\n        color: #c90035;\n        font-family: \"KaiTi\", \"STKaiti\", cursive;\n        font-size: 118px;\n        font-weight: bold;\n        line-height: 1;\n        letter-spacing: 14px;\n        padding: 5px 0 0 18px;\n        white-space: nowrap;\n    }\n    .pinyin {\n        text-align: center;\n        font-family: Arial, sans-serif;\n        font-size: 19px;\n        letter-spacing: 9px;\n        margin-top: 3px;\n    }\n    .welcome {\n        text-align: center;\n        font-family: \"SimHei\", \"Microsoft YaHei\", sans-serif;\n        font-weight: bold;\n        line-height: 1.25;\n        padding-top: 3px;\n    }\n    .welcome h1 {\n        margin: 0;\n        font-size: 47px;\n        letter-spacing: 1px;\n    }\n    .welcome h2 {\n        margin: 8px 0 0;\n        font-size: 27px;\n    }\n    .welcome h3 {\n        margin: 4px 0 0;\n        font-size: 26px;\n    }\n    .photo {\n        width: 100%;\n        height: 385px;\n        border: 1px solid #aaa;\n        background: #eee;\n        overflow: hidden;\n        positi