n      position: absolute;\n      top: 285px;\n      left: 95px;\n      transform: rotate(-34deg);\n      color: rgba(126,132,128,.15);\n      font-size: 43px;\n      font-weight: bold;\n      white-space: nowrap;\n      pointer-events: none;\n    }\n    .entry {\n      position: relative;\n      z-index: 1;\n      min-height: 74px;\n      padding: 4px 0 3px;\n      font-size: 14px;\n      line-height: 1.78;\n      letter-spacing: .15px;\n    }\n    .entry.short { min-height: 48px; }\n    .entry.e1 { min-height: 48px; }\n    .entry.e2 { min-height: 75px; }\n    .entry.e3 { min-height: 75px; }\n    .entry.e4 { min-height: 75px; }\n    .entry.e5 { min-height: 92px; }\n    .entry.e6 { min-height: 74px; }\n    .entry.e7 { min-height: 75px; }\n    .entry.e8 { min-height: 70px; }\n    .num {\n      display: inline-block;\n      width: 22px;\n      vertical-align: top;\n    }\n    .content {\n      display: inline;\n    }\n    .mark {\n      border: 1px solid rgba(157,50,48,.7);\n      background: rgba(255,226,222,.13);\n      padding: 0 2px;\n      margin: 0 1px;\n    }\n    .footer {\n      position: absolute;\n      right: 8px;\n      bottom: 7px;\n      font-family: Arial, sans-serif;\n      font-size: 5px;\n      color: rgba(105,110,108,.45);\n    }\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <div class=\"binding\"></div>\n\n    <div class=\"tiny-top\">\n      <span class=\"notes\">Notes / Contents</span>\n      <div class=\"circles\">\n        <span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span>\n        <span>7</span><span>8</span><span>9</span><span>10</span><span>11</span><span>12</span>\n        <span>13</span><span>14</span><span>15</span>\n      </div>\n    </div>\n\n    <header class=\"heading\">\n      <span class=\"label\">Title</span>\n      <h1>人民日报金句—清正廉洁篇</h1>\n      <div class=\"date\"><span class=\"label\">Date</span><span>05.30</span></div>\n    </header>\n\n    <section class=\"sheet\">\n      <div class=\"watermark\">人民日报</div>\n\n      <div class=\"entry e1\">\n        <span class=\"num\">1、</span><span class=\"content\">心在正中，不存邪念，是为“忠”；言而能成，不掩虚假，则为“诚”。</span>\n      </div>\n\n      <div class=\"entry e2\">\n        <span class=\"num\">2、</span><span class=\"content\">要从一开始就扣好人生的扣子，常怀<span class=\"mark\">感恩之心、敬畏之心、律己之心</span>，<br>常用真善美来雕琢自己，在清廉自守中正心修身、矢志图强。</span>\n      </div>\n\n      <div class=\"entry e3\">\n        <span class=\"num\">3、</span><span class=\"content\">要树立“君子固穷”的清正意识，以<span class=\"mark\">[illegible]</span>淡泊与坦然除去心灵的<br>“杂质”，要摒弃奉承讨好世俗的<span class=\"mark\">“小九九”</span>，<span class=\"mark\">[illegible]</span>权利的<span class=\"mark\">“小山头”</span>。</span>\n      </div>\n\n      <div class=\"entry e4\">\n        <span class=\"num\">4、</span><span class=\"content\">要涵养廉洁自律的道德修为，<span class=\"mark\">心有所畏、言有所戒、行有所止</span>，不断锤<br>炼意志力、坚忍力、自制力，做一个<span class=\"mark\">一心为公、一身正气、一尘不染</span>的人。</span>\n      </div>\n\n      <div class=\"entry e5\">\n        <span class=\"num\">5、</span><span class=\"content\">青年干部要扣好人生第一粒扣子，坚持每日三省，在思想上<span class=\"mark\">多照“镜<br>子”</span>、勤清洗“灰尘”、去除“杂质”　自觉同上级要求“对标”，拿党章党规“扫<br>描”，用人民期待“透视”。</span>\n      </div>\n\n      <div class=\"entry e6\">\n        <span class=\"num\">6、</span><span class=\"content\">“尽小者大，慎微者著”，青年干部要牢记<span class=\"mark\">“堤溃蚁穴，气泄针芒”</span>的古训，<br>从日常点滴做起，从一言一行做起。</span>\n      </div>\n\n      <div class=\"entry e7\">\n        <span class=\"num\">7、</span><span class=\"content\">要常怀敬畏之心，自觉防微杜渐，<span class=\"mark\">远离“高压线”、不碰“红线”、坚守“底<br>线”</span>，把家风建设摆在重要位置，持之以恒<span class=\"mark\">净化“生活圈、交往圈、娱乐圈”</span>。</span>\n      </div>\n\n      <div class=\"entry e8\">\n        <span class=\"num\">8、</span><span class=\"content\">欲知平直，则必准绳；欲知方圆，则必规矩。无以规矩不成方圆，纪律<br>是衡量党员干部行为的尺子，把纪律当作带电的高压线。</span>\n      </div>\n    </section>\n\n    <div class=\"footer\">Designed by freepik</div>\n  </main>\n</body>\n</html>"
