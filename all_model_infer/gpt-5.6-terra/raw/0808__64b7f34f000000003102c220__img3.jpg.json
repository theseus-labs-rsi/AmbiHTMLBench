        "content": "<!DOCTYPE html>\n<html lang=\"zh-Hant\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>生物與環境筆記</title>\n  <script>\n    window.MathJax = { tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] } };\n  </script>\n  <script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n  <style>\n    *{box-sizing:border-box}\n    body{margin:0;background:#fafafa;font-family:\"KaiTi\",\"DFKai-SB\",\"Noto Serif TC\",serif;color:#151515}\n    .paper{\n      position:relative;\n      width:540px;height:540px;margin:0 auto;background:#fff;overflow:hidden;\n      padding:8px 7px;\n    }\n    .v{\n      writing-mode:vertical-rl;\n      text-orientation:upright;\n      line-height:1.22;\n      letter-spacing:.5px;\n      font-size:13px;\n    }\n    .tiny{font-size:10px;line-height:1.12}\n    .small{font-size:11px}\n    .blue{color:#143f9a}\n    .red{color:#d62020}\n    .green{color:#167448}\n    .purple{color:#78368d}\n    .orange{color:#d66b00}\n    .hl-cyan{background:rgba(50,220,225,.48)}\n    .hl-yellow{background:rgba(255,228,30,.55)}\n    .hl-pink{background:rgba(255,111,177,.38)}\n    .hl-green{background:rgba(136,239,135,.34)}\n    .title{\n      position:absolute;right:18px;top:9px;height:250px;\n      font-size:21px;font-weight:bold;letter-spacing:2px;\n      writing-mode:vertical-rl;text-orientation:upright;\n    }\n    .rule{border-right:2px solid #111;padding-right:3px}\n    .line-blue{border-right:2px solid #1666b4;padding-right:3px}\n    .line-red{border-right:2px solid #dc3030;padding-right:3px}\n    .line-green{border-right:2px solid #248a57;padding-right:3px}\n    .block{position:absolute}\n    .n{font-weight:bold;font-size:16px}\n    .arrow{font-size:20px;color:#111}\n    .bracket{font-size:20px;color:#151515}\n  </style>\n</head>\n<body>\n  <main class=\"paper\">\n\n    <div class=\"title green\">生物與環境</div>\n\n    <section class=\"block v blue\" style=\"right:45px;top:10px;height:235px;\">\n      <span class=\"hl-cyan\">生物與環境</span><br>\n      ① 生態系<br>\n      生物與環境互相作用所形成的系統<br>\n      <span class=\"hl-cyan\">生物因素</span>、<span class=\"hl-cyan\">非生物因素</span>\n    </section>\n\n    <section class=\"block v\" style=\"right:77px;top:15px;height:265px;\">\n      <span class=\"n blue\">① 生物</span><br>\n      <span class=\"hl-cyan\">個體</span>　同種生物的一個個體<br>\n      <span class=\"hl-cyan\">族群</span>　同種生物在同一時間、同一地區的集合<br>\n      <span class=\"hl-cyan\">群集</span>　不同族群共同生活的集合<br>\n      <span class=\"hl-cyan\">生態系</span>　生物群集與非生物環境\n    </section>\n\n    <section class=\"block v tiny purple\" style=\"right:106px;top:19px;height:238px;\">\n      <span class=\"hl-pink\">族群特徵</span><br>\n      出生率、死亡率<br>\n      遷入率、遷出率<br>\n      年齡組成、性比<br>\n      族群密度<br>\n      環境阻力<br>\n      [illegible]\n    </section>\n\n    <section class=\"block v small\" style=\"right:127px;top:10px;height:270px;\">\n      <span class=\"n\">② 族群</span><br>\n      <span class=\"hl-yellow\">族群密度</span><br>\n      單位面積或單位體積內<br>\n      個體的數量<br>\n      密度增加時，種內競爭增加<br>\n      <span class=\"blue\">族群成長曲線</span><br>\n      J 型成長、S 型成長<br>\n      <span class=\"green\">環境容納量</span>\n    </section>\n\n    <section class=\"block v tiny blue\" style=\"right:150px;top:14px;height:255px;\">\n      出生率高於死亡率　族群增加<br>\n      出生率低於死亡率　族群減少<br>\n      食物、空間、天敵、疾病<br>\n      均會影響族群數量<br>\n      <span class=\"hl-cyan\">密度制約因子</span><br>\n      <span class=\"hl-cyan\">非密度制約因子</span><br>\n      乾旱、颱風、地震、火災\n    </section>\n\n    <section class=\"block v\" style=\"right:181px;top:9px;height:265px;\">\n      <span class=\"n purple\">③ 群集</span><br>\n      不同種族群共同生活<br>\n      <span class=\"hl-green\">種間關係</span><br>\n      競爭　掠食　寄生<br>\n      互利共生　片利共生<br>\n      偏利共生<br>\n      <span class=\"orange\">生態位</span><br>\n      生物在環境中所扮演的角色\n    </section>\n\n    <section class=\"block v tiny\" style=\"right:207px;top:19px;height:247px;\">\n      競爭：雙方皆受害<br>\n      掠食：一方獲利，一方受害<br>\n      寄生：寄生者獲利<br>\n      宿主受害<br>\n      互利共生：雙方獲利<br>\n      片利共生：一方獲利<br>\n      另一方不受影響\n    </section>\n\n    <section class=\"block v line-green\" style=\"right:231px;top:13px;height:262px;\">\n      <span class=\"n green\">生態系的組成</span><br>\n      <span class=\"hl-green\">生產者</span><br>\n      綠色植物、藻類<br>\n      利用光能製造養分<br>\n      <span class=\"hl-green\">消費者</span><br>\n      草食、肉食、雜食動物<br>\n      <span class=\"hl-green\">分解者</span><br>\n      細菌、真菌<br>\n      將遺體分解為無機物\n    </section>\n\n    <section class=\"block v blue tiny\" style=\"right:257px;top:15px;height:255px;\">\n      食物鏈<br>\n      生產者 → 初級消費者<br>\n      → 次級消費者 → 高級消費者<br>\n      食物網<br>\n      能量在營養階層間傳遞<br>\n      能量逐層遞減<br>\n      <span class=\"hl-cyan\">物質循環</span>\n    </section>\n\n    <section class=\"block v\" style=\"right:283px;top:16px;height:255px;\">\n      <span class=\"n\">④ 生態系的能量流動</span><br>\n      太陽能<br>\n      <span class=\"arrow\">↓</span><br>\n      生產者<br>\n      <span class=\"arrow\">↓</span><br>\n      消費者<br>\n      <span class=\"arrow\">↓</span><br>\n      分解者<br>\n      能量不能循環使用\n    </section>\n\n    <section class=\"block v red small\" style=\"right:310px;top:11px;height:270px;\">\n      <span class=\"hl-yellow\">能量金字塔</span><br>\n      高營養階層的能量較少<br>\n      能量傳遞效率約為 10%<br>\n      生物量金字塔<br>\n      數量金字塔<br>\n      [illegible]\n    </section>\n\n    <section class=\"block v line-blue\" style=\"right:337px;top:10px;height:267px;\">\n      <span class=\"n blue\">⑤ 物質循環</span><br>\n      水循環<br>\n      蒸發、凝結、降水<br>\n      碳循環<br>\n      光合作用、呼吸作用<br>\n      氮循環<br>\n      固氮、硝化、脫硝\n    </section>\n\n    <section class=\"block v tiny purple\" style=\"right:360px;top:18px;height:250px;\">\n      光合作用吸收二氧化碳<br>\n      呼吸作用釋放二氧化碳<br>\n      燃燒化石燃料<br>\n      造成二氧化碳增加<br>\n      <span class=\"red\">溫室效應</span><br>\n      <span class=\"red\">全球暖化</span>\n    </section>\n\n    <section class=\"block v\" style=\"right:385px;top:11px;height:267px;\">\n      <span class=\"n purple\">⑥ 人類與環境</span><br>\n      人口增加<br>\n      資源過度利用<br>\n      污染問題<br>\n      棲地破壞<br>\n      生物多樣性降低<br>\n      <span class=\"hl-pink\">保育</span><br>\n      永續發展\n    </section>\n\n    <section class=\"block v red tiny\" style=\"right:410px;top:13px;height:260px;\">\n      空氣污染<br>\n      水污染<br>\n      土壤污染<br>\n      垃圾與廢棄物<br>\n      酸雨<br>\n      臭氧層破洞<br>\n      外來種入侵<br>\n      [illegible]\n    </section>\n\n    <section class=\"block v line-red\" style=\"right:435px;top:11px;height:266px;\">\n      <span class=\"n red\">生態保育</span><br>\n      保護區設置<br>\n      復育瀕危物種<br>\n      減少污染<br>\n      節約能源<br>\n      資源回收再利用<br>\n      維持生物多樣性\n    </section>\n\n    <section class=\"block v blue\" style=\"right:462px;top:15px;height:260px;\">\n      <span class=\"n blue\">水域生態系</span><br>\n      淡水生態系<br>\n      河流、湖泊、池塘<br>\n      海洋生態系<br>\n      潮間帶、珊瑚礁<br>\n      浮游生物<br>\n      底棲生物\n    </section>\n\n    <section class=\"block v tiny\" style=\"right:486px;top:14px;height:255px;\">\n      陸域生態系<br>\n      森林、草原、沙漠<br>\n      苔原<br>\n      氣候影響生物分布<br>\n      溫度、降雨量<br>\n      光照與土壤<br>\n      [illegible]\n    </section>\n\n    <section class=\"block v purple\" style=\"right:511px;top:12px;height:270px;\">\n      <span class=\"n\">生物多樣性</span><br>\n      遺傳多樣性<br>\n      物種多樣性<br>\n      生態系多樣性<br>\n      保育的重要性\n    </section>\n\n    <section class=\"block v blue\" style=\"left:10px;top:13px;height:247px;\">\n      <span class=\"n\">生態系統</span><br>\n      [illegible]<br>\n      生物之間的交互作用<br>\n      與環境因子的影響<br>\n      [illegible]\n    </section>\n\n    <section class=\"block v red\" style=\"left:35px;top:16px;height:252px;\">\n      <span class=\"hl-pink\">生態平衡</span><br>\n      動態平衡<br>\n      當環境改變時<br>\n      生物族群也會改變<br>\n      [illegible]\n    </section>\n\n  </main>\n</body>\n</html>"
