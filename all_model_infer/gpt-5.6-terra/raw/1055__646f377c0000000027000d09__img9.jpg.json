ertical-label {\n      position: relative;\n      z-index: 1;\n      writing-mode: vertical-rl;\n      text-orientation: upright;\n      color: #091a88;\n      font-size: 15px;\n      font-weight: bold;\n      line-height: 1.15;\n      letter-spacing: 1px;\n      padding-right: 7px;\n    }\n    .main {\n      padding-left: 10px;\n      font-size: 15px;\n      line-height: 1.28;\n    }\n    .line { white-space: nowrap; }\n    .blue {\n      color: #101c8f;\n      font-weight: bold;\n    }\n    .indent { padding-left: 42px; }\n    .finance .main { padding-top: 0; }\n    .finance .part:first-child { margin-bottom: 15px; }\n    .part.fin2 { margin-bottom: 23px; }\n    .subgrid {\n      display: grid;\n      grid-template-columns: 43px 1fr;\n      margin-top: 4px;\n    }\n    .subside {\n      position: relative;\n      display: flex;\n      justify-content: center;\n      padding-top: 14px;\n    }\n    .subside .smallbrace {\n      position: absolute;\n      top: 9px;\n      bottom: 2px;\n      right: 1px;\n      width: 11px;\n      border-left: 1px solid #555;\n      border-radius: 9px 0 0 9px;\n    }\n    .subside .smallbrace:before,\n    .subside .smallbrace:after {\n      content: \"\";\n      position: absolute;\n      left: -1px;\n      width: 6px;\n      height: 1px;\n      background: #555;\n    }\n    .subside .smallbrace:before { top: 0; }\n    .subside .smallbrace:after { bottom: 0; }\n    .subvertical {\n      writing-mode: vertical-rl;\n      text-orientation: upright;\n      color: #101c8f;\n      font-weight: bold;\n      font-size: 14px;\n      letter-spacing: 1px;\n      position: relative;\n      z-index: 1;\n      padding-right: 4px;\n    }\n    .deyu .part {\n      margin-bottom: 12px;\n    }\n    .deyu .side {\n      padding-top: 18px;\n    }\n    .deyu .side .brace {\n      top: 13px;\n    }\n    .deyu .main {\n      padding-left: 9px;\n      font-size: 14px;\n      line-height: 1.23;\n    }\n    .deyu .subgrid {\n      margin-top: 2px;\n      grid-template-columns: 40px 1fr;\n    }\n    .deyu .subside {\n      padding-top: 8px;\n    }\n    .deyu .subside .smallbrace {\n      top: 5px;\n    }\n    .bottom {\n      margin-top: 2px;\n      font-size: 14px;\n      line-height: 1.24;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"page\">\n    <div class=\"chapter\"><span>第九章　学校财务与财务管理</span></div>\n\n    <div class=\"content finance\">\n      <div class=\"part\">\n        <div class=\"side\">\n          <div class=\"brace\"></div>\n          <div class=\"vertical-label\">财产管理</div>\n        </div>\n        <div class=\"main\">\n          <div class=\"line\"><span class=\"blue\">含义：</span>对学校物质财产的计划组织、使用保管活动。</div>\n          <div class=\"line indent\">包括固定资产和流动资产。</div>\n          <div class=\"line\"><span class=\"blue\">内容：</span>目标；制度；账务；添置；维修。</div>\n          <div class=\"line\"><span class=\"blue\">原则：</span>物尽其用；建章立制；帐物相符；管理育人。</div>\n        </div>\n      </div>\n\n      <div class=\"part fin2\">\n        <div class=\"side\">\n          <div class=\"brace\"></div>\n          <div class=\"vertical-label\">财务管理</div>\n        </div>\n        <div class=\"main\">\n          <div class=\"line\"><span class=\"blue\">含义：</span>指学校资金运转中的计划组织和控制。</div>\n          <div class=\"subgrid\">\n            <div class=\"subside\">\n              <div class=\"smallbrace\"></div>\n              <div class=\"subvertical\">内容</div>\n            </div>\n            <div>\n              <div class=\"line\"><span class=\"blue\">预算管理：</span>按一定程序和方法核定的年度收支预计；</div>\n              <div class=\"line\"><span class=\"blue\">收入管理：</span>对学校收入的计划组织和控制，</div>\n              <div class=\"line\">包括财政收入、经营收入、劳务费等收入；</div>\n              <div class=\"line\"><span class=\"blue\">支出管理：</span>经费支出的计划组织和控制；</div>\n              <div class=\"line\"><span class=\"blue\">资金管理：</span>现金、银行存款、往来管理；</div>\n              <div class=\"line\"><span class=\"blue\">财务报表：</span>收支、因素、结果分析；</div>\n              <div class=\"line\"><span class=\"blue\">财务制度和财务监督：</span><span class=\"blue\">财务人员要求：</span>持证</div>\n              <div class=\"line\">上岗、坚持原则、作风正派、履行职责；财</div>\n              <div class=\"line\"><span class=\"blue\">务监督</span>通过财务审计执行。</div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"deyu\">\n        <div style=\"display:flex;\">\n          <div class=\"chapter\" style=\"width:60px;flex:0 0 60px;padding-right:6px;\">\n            <span>第十章　学校德育管理</span>\n          </div>\n          <div style=\"width:398px;padding-left:3px;\">\n            <div class=\"part\">\n              <div class=\"side\">\n                <div class=\"brace\"></div>\n                <div class=\"vertical-label\">地位与特点</div>\n              </div>\n              <div class=\"main\">\n                <div class=\"line\"><span class=\"blue\">含义：</span>德育即思想品德教育（简称），包括政治教育、思想教</div>\n                <div class=\"line\">育、道德教育、法纪教育、心理教育。<span class=\"blue\">德育管理：</span>即</div>\n                <div class=\"line\">德育管理者运用方法手段，对德育过程进行管理的一种。</div>\n                <div class=\"subgrid\">\n                  <div class=\"subside\">\n                    <div class=\"smallbrace\"></div>\n                    <div class=\"subvertical\">地位</div>\n                  </div>\n                  <div>\n                    <div class=\"line\"><span class=\"blue\">地位（学校管理与德育的关系）：</span>学校管理包含德育管理；相</div>\n                    <div class=\"line\">互影响；相互渗透；相互促进。</div>\n                  </div>\n                </div>\n                <div class=\"line\"><span class=\"blue\">特点：</span>方向性；教育性；伦理性；全员性。</div>\n              </div>\n            </div>\n\n            <div class=\"part\">\n              <div class=\"side\">\n                <div class=\"brace\"></div>\n                <div class=\"vertical-label\">要素与层次</div>\n              </div>\n              <div class=\"main\">\n                <div class=\"subgrid\">\n                  <div class=\"subside\">\n                    <div class=\"smallbrace\"></div>\n                    <div class=\"subvertical\">要素</div>\n                  </div>\n                  <div>\n                    <div class=\"line\"><span class=\"blue\">德育管理目标：</span>具有定向、调节、评价作用；</div>\n                    <div class=\"line\"><span class=\"blue\">德育管理主体：</span>组织机构；管理者；自我管理；</div>\n                    <div class=\"line\"><span class=\"blue\">德育管理客体：</span>人、物、场、课程、时空等资源；</div>\n                    <div class=\"line\"><span class=\"blue\">德育管理制度：</span>中央到地方文件，学校与班级的规章；</div>\n                  </div>\n                </div>\n                <div class=\"subgrid\">\n                  <div class=\"subside\">\n                    <div class=\"smallbrace\"></div>\n                    <div class=\"subvertical\">层次</div>\n                  </div>\n                  <div>\n                    <div class=\"line\"><span class=\"blue\">层次：</span>学校上层是核心主方向；学校中层是组织抓落实；学校基</div>\n                    <div class=\"line\">层及班级是基本单位执行者。</div>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div class=\"part\" style=\"margin-bottom:4px;\">\n              <div class=\"side\">\n                <div class=\"brace\"></div>\n                <div class=\"vertical-label\">机制与实施</div>\n              </div>\n              <div class=\"main\">\n                <div class=\"subgrid\">\n                  <div class=\"subside\">\n                    <div class=\"smallbrace\"></div>\n                    <div class=\"subvertical\">机制</div>\n                  </div>\n                  <div>\n                    <div class=\"line\"><span class=\"blue\">机制：</span>德育要素进行相互作用、耦合、联系的运作方式。</div>\n                    <div class=\"line\"><span class=\"blue\">导向机制：</span>目标、舆论、行为、评价等导向；</div>\n                    <div class=\"line\"><span class=\"blue\">动力机制：</span>奖惩、竞争、意义或价值等激励；</div>\n                    <div class=\"line\"><span class=\"blue\">协调机制：</span>制度、文化协调；</div>\n                    <div class=\"line\"><span class=\"blue\">约束机制：</span>法规、道德约束。</div>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div class=\"bottom\">\n              <div class=\"line\"><span class=\"blue\">提高德育管理者管理能力的途径：</span>（1）提升管理水平（理念、方法、</div>\n              <div class=\"line\">道德）；（2）提高教育素养（教育观、教育理论）；（3）加强道德</div>\n              <div class=\"line\">修养（把握方向、管理公正、以身作则、作风民主）</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</body>\n</html>"
