80\" fill=\"url(#forest)\"/>\n                <g fill=\"#43752d\" opacity=\".9\"><circle cx=\"20\" cy=\"44\" r=\"33\"/><circle cx=\"64\" cy=\"30\" r=\"39\"/><circle cx=\"112\" cy=\"46\" r=\"46\"/><circle cx=\"156\" cy=\"28\" r=\"38\"/><circle cx=\"20\" cy=\"118\" r=\"44\"/><circle cx=\"163\" cy=\"115\" r=\"55\"/></g>\n                <path d=\"M73 280c19-72 25-109 55-154 8-11 10-21 12-30l25 1c-10 27-18 48-26 67-18 45-17 76-12 116z\" fill=\"#bda36f\"/>\n                <path d=\"M113 280c10-70 17-118 45-175\" stroke=\"#91815a\" stroke-width=\"5\" fill=\"none\"/>\n                <g stroke=\"#3e3122\" stroke-width=\"2\">\n                  <circle cx=\"62\" cy=\"194\" r=\"9\" fill=\"#d59b67\"/><path d=\"M53 205l10-8 9 17-15 4z\" fill=\"#4d7495\"/><path d=\"M55 214l-9 24M68 214l8 22\" fill=\"none\"/>\n                  <circle cx=\"118\" cy=\"213\" r=\"8\" fill=\"#d39b6d\"/><path d=\"M108 222l11-8 9 16-16 4z\" fill=\"#cf6d3f\"/><path d=\"M109 232l-7 23M123 232l8 20\" fill=\"none\"/>\n                  <path d=\"M42 231h28M100 250h29\" stroke=\"#252525\"/><circle cx=\"45\" cy=\"235\" r=\"5\" fill=\"none\"/><circle cx=\"67\" cy=\"235\" r=\"5\" fill=\"none\"/><circle cx=\"103\" cy=\"253\" r=\"5\" fill=\"none\"/><circle cx=\"126\" cy=\"253\" r=\"5\" fill=\"none\"/>\n                </g>\n              </svg>\n            </div>\n            <div class=\"photo temple\">\n              <svg viewBox=\"0 0 180 94\" preserveAspectRatio=\"none\" aria-label=\"古建筑照片\">\n                <rect width=\"180\" height=\"94\" fill=\"#b7c4c4\"/>\n                <path d=\"M13 52L61 19l48 31z\" fill=\"#777166\"/><path d=\"M72 50l50-34 45 36z\" fill=\"#615e57\"/>\n                <path d=\"M24 52h69v31H24zM83 52h75v33H83z\" fill=\"#a9684b\"/>\n                <path d=\"M50 56h18v27H50zM112 55h22v30h-22z\" fill=\"#393c35\"/>\n                <path d=\"M0 78h180v16H0z\" fill=\"#81755e\"/>\n              </svg>\n            </div>\n            <p class=\"caption\">图①：古香古色的远山民居与村落相映成趣。图②：小路两旁绿意