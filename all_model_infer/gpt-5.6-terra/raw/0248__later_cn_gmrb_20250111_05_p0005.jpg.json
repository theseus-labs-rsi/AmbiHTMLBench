        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>民主法治 05</title>\n  <script>\n    window.MathJax = {\n      tex: { inlineMath: [['$', '$'], ['\\\\(', '\\\\)']], displayMath: [['$$', '$$'], ['\\\\[', '\\\\]']] },\n      svg: { fontCache: 'global' }\n    };\n  </script>\n  <script async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    html, body { margin: 0; padding: 0; background: #fff; color: #111; }\n    body {\n      width: 1262px;\n      margin: 0 auto;\n      font-family: \"Noto Serif CJK SC\", \"Songti SC\", \"SimSun\", serif;\n      font-size: 13px;\n      line-height: 1.55;\n    }\n    .page {\n      position: relative;\n      padding: 22px 22px 18px;\n      overflow: hidden;\n    }\n    .top-rule {\n      height: 8px;\n      background: #91aecb;\n      margin-bottom: 8px;\n    }\n    .masthead {\n      height: 52px;\n      display: flex;\n      align-items: center;\n      border-bottom: 1px solid #777;\n      position: relative;\n    }\n    .logo {\n      width: 140px;\n      color: #a20d39;\n      font-family: \"KaiTi\", serif;\n      font-size: 31px;\n      font-weight: bold;\n      transform: skew(-8deg);\n      white-space: nowrap;\n    }\n    .metadata {\n      font-family: \"SimSun\", serif;\n      font-size: 10px;\n      font-weight: bold;\n      margin-left: 4px;\n      align-self: center;\n      white-space: nowrap;\n    }\n    .section-tab {\n      position: absolute;\n      right: 64px;\n      top: -1px;\n      height: 82px;\n      width: 345px;\n      background: #dfedf9;\n      border-left: 36px solid #d3e3f2;\n      border-right: 23px solid #8da9ce;\n      clip-path: polygon(0 0, 78% 0, 88% 100%, 10% 100%);\n      color: #89a6c7;\n      font-family: \"SimSun\", serif;\n      font-size: 43px;\n      font-weight: bold;\n      text-align: cent