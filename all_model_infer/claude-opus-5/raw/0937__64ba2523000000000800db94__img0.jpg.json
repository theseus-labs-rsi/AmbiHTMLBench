        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>10种最常见的心理障碍</title>\n<script>\nwindow.MathJax = {\n  tex: {\n    inlineMath: [['$', '$']],\n    displayMath: [['$$', '$$']]\n  }\n};\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chml.js\" async></script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    padding: 0;\n    background: #f7f7f7;\n    font-family: \"PingFang SC\", \"Microsoft YaHei\", \"Heiti SC\", sans-serif;\n  }\n  .page {\n    width: 540px;\n    margin: 0 auto;\n    background: #ffffff;\n  }\n  .top-banner {\n    text-align: center;\n    color: #9a9a9a;\n    font-size: 13px;\n    letter-spacing: 1px;\n    padding: 8px 0 4px 0;\n    font-family: Georgia, \"Times New Roman\", serif;\n  }\n  .main-title {\n    text-align: center;\n    font-size: 40px;\n    font-weight: 900;\n    letter-spacing: 1px;\n    padding: 2px 0 10px 0;\n    color: #111;\n  }\n  .grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n  }\n  .cell {\n    padding: 10px 12px 14px 12px;\n    min-height: 108px;\n    position: relative;\n  }\n  .cell h2 {\n    margin: 0 0 4px 0;\n    font-size: 21px;\n    font-weight: 700;\n    color: #111;\n  }\n  .row-inner {\n    display: flex;\n    align-items: flex-start;\n    gap: 6px;\n  }\n  .placeholder {\n    flex: 0 0 auto;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    font-weight: 800;\n    font-style: italic;\n    color: #ffffff;\n    line-height: 1.05;\n    border-radius: 50% 45% 48% 52% / 55% 50% 50% 45%;\n  }\n  .brain {\n    width: 108px;\n    height: 62px;\n    font-size: 13px;\n    padding: 4px;\n  }\n  .quote {\n    font-size: 13.5px;\n    line-height: 1.6;\n    color: #1a1a1a;\n    flex: 1 1 auto;\n  }\n  .quote .author {\n    display: block;\n    text-align: right;\n  }\n\n  /* Row 1 */\n  .c-anxiety { background: #dff3f3; }\n  .c-depression { background: #dff3f3; }\n  .b-anxiety { background: #f0509a; }\n  .b-depression { background: #e8467d; }\n\n  /* Row 2 */\n  .c-ptsd { background: #e2eee2; }\n  .c-ocd { background: #f9d9b8; }\n  .b-ptsd { background: #7aa96a; font-size: 20px; }\n  .b-ocd { background: #f2822c; font-size: 20px; }\n\n  /* Row 3 */\n  .c-bipolar { background: #dff3f3; }\n  .c-insomnia { background: #eddcf2; }\n  .b-bipolar { background: #3aa8b8; font-size: 16px; }\n  .b-insomnia { background: #d6469a; font-size: 13px; }\n\n  /* Row 4 */\n  .c-eating { background: #e2eee2; }\n  .c-schizo { background: #dff3f3; }\n  .b-eating { background: #d8d13a; }\n  .b-schizo { background: #ffffff; color: #b03a8a; }\n\n  /* Row 5 */\n  .c-bpd { background: #f6dede; }\n  .c-ppd { background: #d9efd9; }\n  .b-bpd { background: #b8365a; font-size: 22px; }\n  .b-ppd { background: #4b9b4b; font-size: 22px; }\n\n  .subtitle-en {\n    font-size: 14px;\n    font-weight: 700;\n    font-style: italic;\n    line-height: 1.4;\n    color: #111;\n  }\n  .watermark-mid {\n    text-align: center;\n    color: #cfcfcf;\n    font-size: 12px;\n    margin: 0;\n    padding: 0;\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 2px;\n  }\n  .footer {\n    text-align: center;\n    color: #9a9a9a;\n    font-size: 13px;\n    padding: 10px 0 12px 0;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"top-banner\">Self Love | Self Awareness | Self Mastery</div>\n\n  <div class=\"main-title\">10种最常见的心理障碍</div>\n\n  <div class=\"grid\">\n\n    <!-- Row 1 -->\n    <div class=\"cell c-anxiety\">\n      <h2>焦虑障碍</h2>\n      <div class=\"row-inner\">\n        <div class=\"placeholder brain b-anxiety\">[Brain graphic: pink]<br>ANXIETY DISORDER</div>\n        <div class=\"quote\">\n          你不必驯服焦虑，<br>\n          只需让它与你同行。<br>\n          <span class=\"author\">– 卡里·波特</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"cell c-depression\">\n      <h2>抑郁症</h2>\n      <div class=\"row-inner\">\n        <div class=\"placeholder brain b-depression\">[Brain graphic: pink]<br>DEPRESSION</div>\n        <div class=\"quote\">\n          即使在黑暗中，<br>\n          星星也会继续闪耀。\n        </div>\n      </div>\n    </div>\n\n    <!-- Row 2 -->\n    <div class=\"cell c-ptsd\">\n      <h2>创伤后应激障碍</h2>\n      <div class=\"row-inner\">\n        <div class=\"placeholder brain b-ptsd\">[Brain graphic: green]<br>PTSD</div>\n        <div class=\"quote\">\n          你不必忘记，但你可以<br>\n          学会生活在过去之外\n        </div>\n      </div>\n      <div class=\"watermark-mid\">@ 晓老师·成长教练</div>\n    </div>\n\n    <div class=\"cell c-ocd\">\n      <h2>强迫症</h2>\n      <div class=\"row-inner\">\n        <div class=\"placeholder brain b-ocd\">[Brain graphic: orange]<br>OCD</div>\n        <div class=\"quote\">\n          不要让强迫控制你，<br>\n          你可以控制强迫。\n        </div>\n      </div>\n    </div>\n\n    <!-- Row 3 -->\n    <div class=\"cell c-bipolar\">\n      <h2>双相情感障碍</h2>\n      <div class=\"row-inner\">\n        <div class=\"placeholder brain b-bipolar\">[Brain graphic: teal]<br>BIPOLAR</div>\n        <div class=\"quote\">\n          黑暗会过去，<br>\n          黎明会到来。<br>\n          <span class=\"author\">–乔治·戈登·拜伦</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"cell c-insomnia\">\n      <h2>失眠症</h2>\n      <div class=\"row-inner\">\n        <div class=\"placeholder brain b-insomnia\">[Brain graphic: magenta]<br>INSOMNIA DISORDER</div>\n        <div class=\"quote\">\n          即使黑夜漫长，<br>\n          你仍然有力量<br>\n          迎接黎明的曙光。\n        </div>\n      </div>\n    </div>\n\n    <!-- Row 4 -->\n    <div class=\"cell c-eating\">\n      <h2>进食障碍</h2>\n      <div class=\"row-inner\">\n        <div class=\"placeholder brain b-eating\">[Brain graphic: yellow]<br>EATING DISORDER</div>\n        <div class=\"quote\">\n          用爱和关怀填充你的<br>\n          盘子，让自由和平衡的<br>\n          味道充满你的生活。\n        </div>\n      </div>\n    </div>\n\n    <div class=\"cell c-schizo\">\n      <h2>精神分裂症</h2>\n      <div class=\"row-inner\">\n        <div class=\"placeholder brain b-schizo\">[Brain graphic: white/purple]<br>SCHIZOPHRENIA</div>\n        <div class=\"quote\">\n          我并不疯狂，<br>\n          只是在一个我自己<br>\n          创造的世界里生活。<br>\n          <span class=\"author\">– 弗里茨·佩尔斯</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- Row 5 -->\n    <div class=\"cell c-bpd\">\n      <h2>边缘人格障碍</h2>\n      <div class=\"row-inner\">\n        <div class=\"placeholder brain b-bpd\">[Brain graphic: dark red]<br>BPD</div>\n        <div class=\"subtitle-en\">\n          Borderline Personality<br>\n          Disorder\n        </div>\n      </div>\n    </div>\n\n    <div class=\"cell c-ppd\">\n      <h2>妄想性人格障碍</h2>\n      <div class=\"row-inner\">\n        <div class=\"placeholder brain b-ppd\">[Brain graphic: green]<br>PPD</div>\n        <div class=\"quote\">\n          在现实和想象之间<br>\n          找到平衡，让现实的<br>\n          光芒驱散妄想的阴影。\n        </div>\n      </div>\n    </div>\n\n  </div>\n\n  <div class=\"footer\">@ 晓老师 成长教练</div>\n\n</div>\n</body>\n</html>"
