-------- headings ---------- */\n  h2.sec {\n    font-size: 17px;\n    margin: 10px 8px 6px 8px;\n    padding: 1px 4px;\n    display: inline-block;\n    background: #cfc8f0;\n    color: #2f3690;\n    font-weight: bold;\n  }\n  h2.sec.small { font-size: 15px; }\n  /* ---------- column grids ---------- */\n  .grid4 {\n    display: flex;\n    gap: 6px;\n    padding: 0 8px;\n    align-items: flex-start;\n  }\n  .grid4 > .col { flex: 1 1 0; min-width: 0; }\n  .grid3 {\n    display: flex;\n    gap: 8px;\n    padding: 0 8px;\n    margin-top: 6px;\n    align-items: flex-start;\n  }\n  .grid3 > .col { flex: 1 1 0; min-width: 0; }\n  .grid3 > .col.wide { flex: 1.15 1 0; }\n  .line {\n    font-size: 12.5px;\n    line-height: 1.55;\n    letter-spacing: 0.2px;\n    word-break: break-word;\n  }\n  .cn { color: #3a3f8f; }\n  .hl-p { background: #d7d2f2; }\n  .hl-b { background: #cfe0f7; }\n  .gap { height: 4px; }\n  .blk { margin-bottom: 2px; }\n  .watermark {\n    position: absolute;\n    right: 12px;\n    bottom: 8px;\n    font-size: 10px;\n    color: #cbb8a8;\n    border: 1px solid #d8c8ba;\n    border-radius: 3px;\n    padding: 1px 4px;\n  }\n  .placeholder {\n    border: 1px dashed #b9b2a2;\n    color: #8a8577;\n    font-size: 9px;\n    text-align: center;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"toolbar\">\n    <span>&lt; Content</span>\n    <span>Template &gt;</span>\n  </div>\n\n  <div class=\"metabar\">\n    <span class=\"kw\">Keyword</span>\n    <span class=\"note\">Note</span>\n    <span class=\"date\">Date</span>\n    <div class=\"sticker\">充电</div>\n  </div>\n\n  <!-- ================= 三、to do/doing结构 ================= -->\n  <h2 class=\"sec\">三、to do/doing结构</h2>\n\n  <div class=\"grid4\">\n    <div class=\"col\">\n      <div class=\"blk line\">like to do sth<br>like doing sth.<br><span class=\"cn\">喜欢敢某事</span></div>\n      <div class=\"blk line\">love to do sth<br>love doing sth.<br><span class=\"cn\">喜欢敢某事</span></div>\n      <div class=\"blk line\">hate to do sth<br>hate doing sth.<br><span class=\"cn\">憎恨敢某事</span></div>\n      <div class=\"blk line\">try to do sth.<br><span class=\"cn\">设法要敢某事</span><br>try doing sth.<span class=\"cn\">敢某</span><br><span class=\"cn\">事试试看有何效果</span></div>\n      <div class=\"blk line\">forget to do sth.<br><span class=\"cn\">忘记要敢某事</span><br>forget doing sth.<br><span class=\"cn\">忘记曾敢过某事</span></div>\n    </div>\n\n    <div class=\"col\">\n      <div class=\"blk line\">bother to do sth<br>bother doing sth.<br><span class=\"cn\">麻烦敢某事</span></div>\n      <div class=\"blk line\">intend to do sth<br>intend doing sth.<br><span class=\"cn\">想要敢某事</span></div>\n      <div class=\"blk line\">continue to do sth<br>continue doing sth.<br><span class=\"cn\">继续敢某事</span></div>\n      <div class=\"blk line\">go on to do sth.<span class=\"cn\">敢</span><br><span class=\"cn\">完某事接着敢另事</span><br>go on doing sth<span class=\"cn\">继</span><br><span class=\"cn\">续敢一直在敢的事</span></div>\n      <div class=\"blk line\">mean to do sth.<br><span class=\"cn\">打算敢某事</span><br>mean doing sth.<br><span class=\"cn\">意味着敢某事</span></div>\n    </div>\n\n    <div class=\"col\">\n      <div class=\"blk line\">start to do sth<br>start doing sth.<br><span class=\"cn\">开始敢某事</span></div>\n      <div class=\"blk line\">prefer to do sth<br>prefer doing sth.<br><span class=\"cn\">宁可敢某事</span></div>\n      <div class=\"blk line\">begin to do sth<br>begin doing sth.<br><span class=\"cn\">开始敢某事</span></div>\n      <div class=\"blk line\">remember to do<br>sth <span class=\"cn\">记住要敢某事</span><br>remember doing<br>sth.<span class=\"cn\">记住敢过某事</span></div>\n      <div class=\"blk line\">regret to do sth.<br><span class=\"cn\">后悔要敢某事</span><br>regret doing sth.<br><span class=\"cn\">后悔曾敢过某事</span></div>\n    </div>\n\n    <div class=\"col\">\n      <div class=\"blk line\">attempt to do sth<br>attempt doing sth.<br><span class=\"cn\">试图敢某事</span></div>\n      <div class=\"blk line\">cease to do sth<br>cease doing sth.<br><span class=\"cn\">停止敢某事</span></div>\n      <div class=\"blk line\">can&rsquo;t bear to do<br>sth /can&rsquo;t bear<br>doing sth.<br><span class=\"cn\">不能忍受敢某事</span></div>\n      <div class=\"blk line\">can&rsquo;t help doing<br>sth.<span class=\"cn\">禁不住敢某事</span><br>can&rsquo;t help to do<br>sth.<span class=\"cn\">不能帮助敢某事</span></div>\n    </div>\n  </div>\n\n  <!-- ================= 四 / 五 / 六 / 七 / 八 ================= -->\n  <div class=\"grid3\">\n    <div class=\"col\">\n      <h2 class=\"sec small\" style=\"margin-left:0;\">四、动词+with</h2>\n      <div class=\"line\">\n        deal with<span class=\"cn\">处理;对付</span><br>\n        meet with<span class=\"cn\">遇到;遭受</span><br>\n        end with<span class=\"cn\">以…结束</span><br>\n        compare with<span class=\"cn\">与…相比</span><br>\n        equip with<span class=\"cn\">以…装备</span><br>\n        cover with<span class=\"cn\">用…覆盖</span><br>\n        agree with <span class=\"cn\">与…一致</span><br>\n        provide with<span class=\"cn\">以…供给</span><br>\n        begin with<span class=\"cn\">以…开始</span><br>\n        supply with<span class=\"cn\">以…供给</span><br>\n        play with <span class=\"cn\">玩弄</span><br>\n        do with<span class=\"cn\">处理;需要</span><br>\n        talk with <span class=\"cn\">同…交流</span>\n      </div>\n    </div>\n\n    <div class=\"col wide\">\n      <h2 class=\"sec small\" style=\"margin-left:0;\">五、动词＋from</h2>\n      <div class=\"line\">\n        hear from<span class=\"cn\">收到…的来信</span><br>\n        keep…from <span class=\"cn\">阻止;制止</span><br>\n        suffer from<span class=\"cn\">受…苦</span><br>\n        learn from<span class=\"cn\">向…学习</span><br>\n        die from<span class=\"cn\">因…而死</span><br>\n        separate…from<span class=\"cn\">把…分离</span><br>\n        differ from <span class=\"cn\">与…不同</span><br>\n        date from<span class=\"cn\">始于…时候</span><br>\n        stop…from <span class=\"cn\">阻止;制止</span><br>\n        prevent…from <span class=\"cn\">阻止;制止</span><br>\n        result from<span class=\"cn\">由于</span>\n      </div>\n      <h2 class=\"sec small\" style=\"margin-left:0; margin-top:10px;\">六、动词+through</h2>\n      <div class=\"line\">get through<span class=\"cn\">接通电话</span></div>\n    </div>\n\n    <div class=\"col\">\n      <div class=\"line\">\n        look through<span class=\"cn\">翻阅;看一遍</span><br>\n        put through<span class=\"cn\">接通电话</span><br>\n        check through<span class=\"cn\">核对</span><br>\n        go through<span class=\"cn\">检查;审查</span><br>\n        see through<span class=\"cn\">识破</span><br>\n        <span class=\"hl-b\">pull through <span class=\"cn\">渡过危机</span></span>\n      </div>\n      <h2 class=\"sec small\" style=\"margin-left:0; margin-top:8px;\">七、动词+back</h2>\n      <div class=\"line\">\n        keep back<span class=\"cn\">隐瞒;阻住</span><br>\n        look back <span class=\"cn\">回顾</span><br>\n        give back<span class=\"cn\">归还</span><br>\n        take back<span class=\"cn\">拿回，收回</span><br>\n        hold back<span class=\"cn\">抑制住</span><br>\n        call back <span class=\"cn\">回电话</span>\n      </div>\n      <h2 class=\"sec small\" style=\"margin-left:0; margin-top:8px;\">八、动词+away</h2>\n    </div>\n  </div>\n\n  <div class=\"watermark\">小红书</div>\n</div>\n</body>\n</html>",
