row-reverse;\n    gap:8px;\n  }\n  .vtitle{\n    writing-mode:vertical-rl;\n    text-orientation:upright;\n    font-family:\"Heiti SC\",\"SimHei\",sans-serif;\n    font-weight:bold;\n    font-size:26px;\n    letter-spacing:4px;\n    line-height:1.1;\n    margin-top:110px;\n  }\n  .vauthor{\n    writing-mode:vertical-rl;\n    font-size:11px;\n    letter-spacing:2px;\n    margin-top:110px;\n  }\n  .side-text{\n    flex:1;\n    font-size:11px;\n    line-height:1.95;\n    text-align:justify;\n  }\n  .side-text p{margin:0 0 4px 0;text-indent:2em;}\n  /* ---------- 学术眼 ---------- */\n  .xsy h4{\n    font-family:\"Heiti SC\",\"SimHei\",sans-serif;\n    font-size:13px;\n    text-align:center;\n    line-height:1.6;\n    margin:4px 0 6px 0;\n  }\n  .xsy p{font-size:11px;line-height:1.9;text-indent:2em;margin:0 0 4px 0;text-align:justify;}\n  .colophon{\n    font-size:10.5px;\n    line-height:1.9;\n    text-align:right;\n    margin-top:10px;\n    border-top:1px solid #bbb;\n    padding-top:6px;\n  }\n  /* ---------- 趣科普 ---------- */\n  .qkp{\n    margin-top:10px;\n    border-top:2px solid #c1272d;\n    padding-top:6px;\n  }\n  .qkp h2{\n    font-family:\"Heiti SC\",\"SimHei\",sans-serif;\n    color:#c1272d;\n    font-size:22px;\n    letter-spacing:3px;\n    margin:6px 0 4px 6px;\n  }\n  .qkp .lead{\n    font-size:11px;line-height:1.8;margin:0 0 10px 6px;color:#333;\n  }\n  .cards{\n    display:flex;\n    gap:12px;\n  }\n  .card{flex:1;}\n  .card .photo{\n    width:100%;\n    height:150px;\n  }\n  .card h3{\n    font-family:\"Heiti SC\",\"SimHei\",sans-serif;\n    font-size:16px;\n    margin:8px 0 5px 0;\n    text-align:center;\n  }\n  .card p{\n    font-size:10.5px;line-height:1.85;text-indent:2em;margin:0;text-align:justify;\n  }\n  .source{\n    text-align:right;font-size:10.5px;margin-top:6px;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <!-- ===== masthead ===== -->\n  <div class=\"masthead\">\n    <div class=\"logo\">[报头图: 人民日报]</div>\n    <div class=\"mast-right\">\n      <div class=\"mast-date\">2025年1月4日　星期六</div>\n      <div class=\"pageno\">5</div>\n      <div class=\"section-name\">科技·新知</div>\n    </div>\n  </div>\n\n  <!-- ===== content ===== -->\n  <div class=\"content\">\n\n    <!-- ================= LEFT / MAIN ================= -->\n    <div class=\"col-main\">\n\n      <div class=\"redlabel\"><span class=\"r\">R</span>瞰前沿</div>\n\n      <div class=\"headline\">数字人与机器人，更加“通情达理”</div>\n      <div class=\"byline\">[illegible]</div>\n\n      <div class=\"placeholder hero\">[插图: 通栏主图——数字人头像、机械臂、芯片与人形机器人组合示意，居中横贯版面上部]</div>\n\n      <!-- 编者的话 -->\n      <div class=\"editor-box\">\n        <h3>编者的话</h3>\n        <p>[illegible]</p>\n        <p>[illegible]</p>\n        <p>[illegible]</p>\n      </div>\n\n      <div class=\"article\">\n        <p>近年来，人工智能发展迅速，大模型、类脑智能等前沿技术不断取得突破，[illegible]</p>\n        <p>[illegible]</p>\n        <p>党的二十大报告指出，“以国家战略需求为导向，[illegible]”。[illegible]</p>\n        <p>[illegible]</p>\n\n        <p class=\"subhead\">突破之路：多技术协同<br>发展是关键</p>\n        <p>在自主性智能装备的数字人和机器人研究中，多学科的融合研究和跨领域的技术研发起着至关重要的作用。[illegible]</p>\n        <p>[illegible]</p>\n        <p>[illegible]</p>\n\n        <p class=\"subhead\">情智装备：认知与情感<br>的完美融合</p>\n        <p>情智装备融合了认知智能与情感智能，[illegible]</p>\n        <p>[illegible]</p>\n        <p>[illegible]</p>\n\n        <p class=\"subhead\">三大挑战：情绪感知、<br>个性化分析与仿生化交互</p>\n        <p>尽管我国在情感智能领域取得了众多进展，[illegible]</p>\n        <p>[illegible]</p>\n        <p>[illegible]</p>\n\n        <p class=\"subhead\">应用前景：医疗<br>护理、教育与企业服务</p>\n        <p>情感智能技术的广泛应用前景令人期待，特别是在医疗护理、教育和企业服务等领域，[illegible]</p>\n        <p>[illegible]</p>\n        <p>[illegible]</p>\n        <p class=\"credit\">（作者为[?]中国工程院院士、中国国家新型智能研究[illegible]，本文由本报记者[illegible]采访整理）</p>\n        <p class=\"credit\">题图来源：[illegible]</p>\n      </div>\n\n      <!-- ===== 趣科普 ===== -->\n      <div class=\"qkp\">\n        <div class=\"redlabel\"><span class=\"r\">R</span>趣科普</div>\n        <h2>人形机器人知多少</h2>\n        <p class=\"lead\">人形机器人正以前所未有的广度和深度融入人类的生产生活，最新的人形机器人具备什么本领？让我们一同走近这些未来的“伙伴”。</p>\n\n        <div class=\"cards\">\n          <div class=\"card\">\n            <div class=\"placeholder photo\">[照片: 波士顿动力 Atlas 机器人]</div>\n            <h3>波士顿动力公司的 Atlas</h3>\n            <p>波士顿动力公司推出的人形机器人 Atlas，[illegible]</p>\n          </div>\n          <div class=\"card\">\n            <div class=\"placeholder photo\">[照片: 特斯拉 Optimus 机器人]</div>\n            <h3>特斯拉发布的 Optimus</h3>\n            <p>Optimus 是特斯拉发布的人形机器人，[illegible]</p>\n          </div>\n          <div class=\"card\">\n            <div class=\"placeholder photo\">[照片: “青龙”人形机器人]</div>\n            <h3>“青龙”人形机器人</h3>\n            <p>“青龙”人形机器人是由人形机器人[illegible]</p>\n          </div>\n          <div class=\"card\">\n            <div class=\"placeholder photo\">[照片: 优必选 Walker S1 机器人]</div>\n            <h3>优必选的 Walker S1</h3>\n            <p>优必选发布的工业人形机器人 Walker S1，[illegible]</p>\n          </div>\n        </div>\n        <div class=\"source\">资料来源：中国电子学会</div>\n      </div>\n\n    </div><!-- /col-main -->\n\n    <!-- ================= RIGHT / SIDE ================= -->\n    <div class=\"col-side\">\n\n      <div class=\"redlabel\"><span class=\"r\">R</span>唠「科」</div>\n\n      <div class=\"side-article\">\n        <div class=\"vtitle\">准时，究竟以何为准</div>\n        <div class=\"vauthor\">[illegible]</div>\n        <div class=\"side-text\">\n          <p>时间，[illegible]</p>\n          <p>[illegible]</p>\n          <p>那么，我们说的“准时”，究竟以何为准呢？</p>\n          <p>[illegible]</p>\n          <p>[illegible]</p>\n          <p>[illegible]</p>\n          <p>[illegible]</p>\n          <p>[illegible]</p>\n          <p>[illegible]</p>\n          <p>[illegible]</p>\n        </div>\n      </div>\n\n      <div class=\"redlabel\"><span class=\"r\">R</span>学术眼</div>\n      <div class=\"xsy\">\n        <h4>国际首台低能量强流氘电荷态重离子研究装置通过验收</h4>\n        <p>本报北京1月3日电　（记者吴月辉）[illegible]</p>\n        <p>[illegible]</p>\n        <p>[illegible]</p>\n        <p>[illegibl