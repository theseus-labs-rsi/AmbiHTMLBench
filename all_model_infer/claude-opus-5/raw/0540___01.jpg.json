        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Word 常用快捷键大全</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] }\n};\n</script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    padding: 12px;\n    background: #eaf1f7;\n    font-family: \"PingFang SC\", \"Microsoft YaHei\", \"Hiragino Sans GB\", sans-serif;\n  }\n  .page {\n    max-width: 900px;\n    margin: 0 auto;\n    background: #fdfbf3;\n    border: 6px solid #cfe0ee;\n    border-radius: 10px;\n    padding: 18px 22px 30px;\n    position: relative;\n  }\n  h1.title {\n    text-align: center;\n    font-size: 58px;\n    margin: 6px 0 22px;\n    letter-spacing: 2px;\n    color: #7fb2d8;\n    -webkit-text-stroke: 1px #4b7ea8;\n  }\n  h1.title .cn { color: #f0a35a; -webkit-text-stroke: 1px #c4762f; }\n  h1.title .cn2 { color: #f6c344; -webkit-text-stroke: 1px #c49a1f; }\n\n  .columns { display: flex; gap: 18px; align-items: flex-start; }\n  .col { flex: 1; display: flex; flex-direction: column; gap: 22px; }\n\n  .card { border-radius: 26px; padding: 14px 16px 18px; }\n  .card h2 {\n    display: inline-block;\n    margin: -30px auto 14px;\n    padding: 6px 26px;\n    border-radius: 18px;\n    font-size: 24px;\n    color: #3c3c3c;\n  }\n  .card .head { text-align: center; }\n\n  .blue { background: #f4fafe; border: 3px solid #9cc9e6; }\n  .blue h2 { background: #d6ecfa; border: 3px solid #9cc9e6; }\n  .blue .key { background: #d6ecfa; }\n\n  .pink { background: #fdf3f4; border: 3px solid #e9a9b0; }\n  .pink h2 { background: #f8d9dd; border: 3px solid #e9a9b0; }\n  .pink .key { background: #f8d9dd; }\n\n  .yellow { background: #fdfaef; border: 3px solid #e3c268; }\n  .yellow h2 { background: #fbeec4; border: 3px solid #e3c268; }\n  .yellow .key { background: #fbeec4; }\n\n  .green { background: #f4faf1; border: 3px solid #a8cf9a; }\n  .green h2 { background: #dcefd3; border: 3px solid #a8cf9a; }\n  .green .key { background: #dcefd3; }\n\n  .row {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    margin-bottom: 10px;\n    font-size: 21px;\n    font-weight: 700;\n    color: #333;\n    flex-wrap: nowrap;\n  }\n  .key {\n    display: inline-block;\n    padding: 3px 10px;\n    border-radius: 12px;\n    font-family: Verdana, Geneva, sans-serif;\n    font-weight: 700;\n    white-space: nowrap;\n  }\n  .desc { white-space: nowrap; }\n  .pair { display: flex; align-items: center; gap: 8px; }\n  .pair.right { margin-left: auto; }\n\n  .placeholder {\n    border: 2px dashed #bbb;\n    border-radius: 12px;\n    color: #888;\n    font-size: 12px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    background: rgba(255,255,255,0.4);\n  }\n  .ph-bear-kb { width: 190px; height: 130px; margin: 6px auto 0; }\n  .ph-bear-kb2 { width: 150px; height: 110px; margin: 8px auto 0; }\n  .ph-tree { width: 110px; height: 120px; margin: 4px 0 0 auto; }\n  .ph-tree2 { width: 130px; height: 110px; margin: 4px 0 0 auto; }\n  .ph-corner { width: 100%; height: 40px; margin-bottom: 8px; }\n  .ph-watermark {\n    position: absolute; right: 26px; bottom: 22px;\n    width: 110px; height: 110px; border-radius: 50%;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"placeholder ph-corner\">[Decoration: doodle stickers &mdash; bears, stars, envelopes along top border]</div>\n\n  <h1 class=\"title\">Word <span class=\"cn\">常用</span><span class=\"cn2\">快捷键</span><span class=\"cn\">大全</span></h1>\n\n  <div class=\"columns\">\n\n    <!-- Left column -->\n    <div class=\"col\">\n\n      <section class=\"card blue\">\n        <div class=\"head\"><h2>文件与基本</h2></div>\n        <div class=\"row\">\n          <span class=\"pair\"><span class=\"key\">Ctrl+N</span><span class=\"desc\">新建</span></span>\n          <span class=\"pair right\"><span class=\"key\">Ctrl+S</span><span class=\"desc\">保存</span></span>\n        </div>\n        <div class=\"row\">\n          <span class=\"pair\"><span class=\"key\">Ctrl+O</span><span class=\"desc\">打开</span></span>\n          <span class=\"pair right\"><span class=\"key\">Ctrl+P</span><span class=\"desc\">打印</span></span>\n        </div>\n        <div class=\"placeholder ph-bear-kb\">[Illustration: bear typing on keyboard, centered]</div>\n      </section>\n\n      <section class=\"card yellow\">\n        <div class=\"head\"><h2>文本与排版</h2></div>\n        <div class=\"row\"><span class=\"key\">Ctrl+K</span><span class=\"desc\">超链接 🔗</span></div>\n        <div class=\"row\">\n          <span class=\"pair\"><span class=\"key\">Ctrl+E</span><span class=\"desc\">居中</span></span>\n          <span class=\"pair right\"><span class=\"key\">Ctrl+D</span><span class=\"desc\">格式</span></span>\n        </div>\n        <div class=\"row\"><span class=\"key\">Ctrl+1</span><span class=\"desc\">单倍行距</span></div>\n        <div class=\"row\"><span class=\"key\">Ctrl+2</span><span class=\"desc\">双倍行距</span></div>\n        <div class=\"row\"><span class=\"key\">Alt+Shift+Up</span><span class=\"desc\">上移段落 ↑</span></div>\n        <div class=\"row\"><span class=\"key\">Alt+Shift+Down</span><span class=\"desc\">下移段落 ↓</span></div>\n        <div class=\"row\">\n          <span class=\"pair\"><span class=\"key\">Ctrl+L</span><span class=\"desc\">左对齐</span></span>\n          <span class=\"pair right\"><span class=\"key\">Ctrl+R</span><span class=\"desc\">右对齐</span></span>\n        </div>\n        <div class=\"placeholder ph-tree\">[Illustration: green tree, bottom-right]</div>\n      </section>\n\n      <section class=\"card pink\">\n        <div class=\"head\"><h2>导航与查找</h2></div>\n        <div class=\"row\">\n          <span class=\"pair\"><span class=\"key\">Ctrl+F</span><span class=\"desc\">查找 🔍</span></span>\n          <span class=\"pair right\"><span class=\"key\">Ctrl+H</span><span class=\"desc\">替换</span></span>\n        </div>\n        <div class=\"row\"><span class=\"key\">Ctrl+G</span><span class=\"desc\">定位 🔍</span></div>\n        <div class=\"row\"><span class=\"key\">Ctrl+Home</span><span class=\"desc\">光标移至文首 🏠</span></div>\n        <div class=\"row\"><span class=\"key\">Ctrl+End</span><span class=\"desc\">光标移至文尾</span></div>\n        <div class=\"row\"><span class=\"key\">Ctrl+Alt+A</span><span class=\"desc\">QQ截图</span></div>\n        <div class=\"placeholder ph-tree2\">[Illustration: tree with word-tags, bottom-right]</div>\n      </section>\n\n    </div>\n\n    <!-- Right column -->\n    <div class=\"col\">\n\n      <section class=\"card pink\">\n        <div class=\"head\"><h2>编辑与格式</h2></div>\n        <div class=\"row\">\n          <span class=\"pair\"><span class=\"key\">Ctrl+C</span><span class=\"desc\">复制 📋</span></span>\n          <span class=\"pair right\"><span class=\"key\">Ctrl+Z</span><span class=\"desc\">撤销</span></span>\n        </div>\n        <div class=\"row\">\n          <span class=\"pair\"><span class=\"key\">Ctrl+Y</span><span class=\"desc\">恢复 ✂</span></span>\n          <span class=\"pair right\"><span class=\"key\">Ctrl+V</span><span class=\"desc\">粘贴</span></span>\n        </div>\n        <div class=\"row\">\n          <span class=\"pair\"><span class=\"key\">Ctrl+X</span><span class=\"desc\">剪切</span></span>\n          <span class=\"pair right\"><span class=\"key\">Ctrl+U</span><span class=\"desc\">下划线</span></span>\n        </div>\n        <div class=\"row\">\n          <span class=\"pair\"><span class=\"key\">Ctrl+A</span><span class=\"desc\">全选</span></span>\n          <span class=\"pair right\"><span class=\"desc\">增大字号 ↗</span></span>\n        </div>\n        <div class=\"row\">\n          <span class=\"pair\"><span class=\"key\">Ctrl+B</span><span class=\"desc\">加粗</span></span>\n          <span class=\"pair right\"><span class=\"desc\">减小字号 ↘</span></span>\n        </div>\n        <div class=\"row\"><span class=\"key\">Ctrl+Shift+F</span><span class=\"desc\">删除文本格式</span></div>\n        <div class=\"row\"><span class=\"key\">Ctrl+Shift+N</span><span class=\"desc\">更改格式</span></div>\n        <div class=\"row\"><span class=\"key\">Delete</span><span class=\"desc\">🗑</span><span class=\"pair right\"><span class=\"desc\">删除选中</span></span></div>\n        <div class=\"row\"><span class=\"key\">Backspace</span><span class=\"pair right\"><span class=\"desc\">删除表格</span></span></div>\n      </section>\n\n      <div class=\"placeholder ph-bear-kb2\">[Illustration: bear with keyboard, left of section]</div>\n\n      <section class=\"card green\">\n        <div class=\"head\"><h2>段落与高级</h2></div>\n        <div class=\"row\">\n          <span class=\"pair\"><span class=\"key\">Ctrl+L</span><span class=\"desc\">左对齐</span></span>\n          <span class=\"pair right\"><span class=\"desc\">Shift+Enter</span></span>\n        </div>\n        <div class=\"row\">\n          <span class=\"pair\"><span class=\"key\">Ctrl+R</span><span class=\"desc\">右对齐</span></span>\n          <span class=\"pair\"><span class=\"desc\">换行</span></span>\n        </div>\n        <div class=\"row\"><span class=\"key\">Ctrl+K</span><span class=\"pair right\"><span class=\"desc\">隐藏功能区</span></span></div>\n        <div class=\"row\"><span class=\"key\">Win+R</span><span class=\"pair right\"><span class=\"desc\">运行</span></span></div>\n        <div class=\"row\"><span class=\"key\">Win+Tab</span><span class=\"pair right\"><span class=\"desc\">3D桌面</span></span></div>\n        <div class=\"row\"><span class=\"key\">Alt+Shift+Up</span><span class=\"pair right\"><span class=\"desc\">上移段落</span></span></div>\n        <div class=\"row\"><span class=\"key\">Alt+Shift+Down</span><span class=\"desc\">下移段落</span></div>\n        <div class=\"row\"><span class=\"key\">Shift+Delete</span><span class=\"pair right\"><span class=\"desc\">永久删除</span></span></div>\n        <div class=\"row\"><span class=\"key\">Ctrl+Alt+M</span><span class=\"desc\">✏ 新建批注</span></div>\n        <div class=\"row\"><span class=\"key\">Ctrl+Alt+O</span><span class=\"desc\">📝 大纲视图</span></div>\n        <div class=\"row\"><span class=\"key\">Ctrl+Alt+P</span><span class=\"desc\">📝 页面视图</span></div>\n        <div class=\"row\"><span class=\"key\">Ctrl+F2</span><span class=\"desc\">🖨</span><span class=\"pair right\"><span class=\"desc\">打印</span></span></div>\n        <div class=\"row\"><span class=\"key\">Ctrl+Enter</span><span class=\"pair right\"><span class=\"desc\">分页</span></span></div>\n      </section>\n\n    </div>\n  </div>\n\n  <div class=\"placeholder ph-watermark\">[Watermark logo: \"V\" / VINCENT, bottom-right]</div>\n\n</div>\n</body>\n</html>"
