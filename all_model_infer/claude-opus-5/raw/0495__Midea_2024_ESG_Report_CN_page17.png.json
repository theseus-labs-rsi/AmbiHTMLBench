h2{\n    font-size:28px;\n    font-weight:500;\n    color:var(--teal);\n    margin:58px 0 26px;\n    letter-spacing:1px;\n  }\n  h3{\n    font-size:21px;\n    font-weight:500;\n    color:#2E3336;\n    margin:52px 0 22px;\n    letter-spacing:1px;\n  }\n  .body-col{max-width:640px;}\n  .body-col p{margin:0 0 22px;text-align:justify;}\n\n  .lower-left{\n    display:flex;\n    align-items:flex-start;\n    gap:60px;\n    margin-top:0;\n  }\n  .narrow-col{width:330px;}\n  .narrow-col p{margin:0;text-align:justify;}\n\n  /* stat card */\n  .stat-card{\n    width:300px;\n    border:1px solid var(--teal);\n    border-radius:14px;\n    overflow:hidden;\n    margin-top:8px;\n    flex:none;\n  }\n  .stat-card .cap{\n    background:var(--teal);\n    color:#fff;\n    text-align:center;\n    font-size:14px;\n    padding:8px 0;\n    border-radius:14px 14px 14px 14px;\n  }\n  .stat-card .inner{\n    display:flex;\n    align-items:center;\n    gap:18px;\n    padding:20px 18px 24px;\n  }\n  .stat-card .placeholder{\n    width:90px;height:90px;flex:none;\n  }\n  .stat-card .txt{color:var(--teal);}\n  .stat-card .txt .label{font-size:13.5px;line-height:1.6;}\n  .stat-card .txt .num{\n    font-size:46px;\n    font-weight:300;\n    line-height:1.1;\n    margin-top:6px;\n  }\n  .stat-card .txt .num small{font-size:16px;font-weight:400;}\n\n  /* illustration */\n  .illustration.placeholder{\n    margin-top:auto;\n    width:100%;\n    height:420px;\n  }\n\n  /* ---------- right page ---------- */\n  .panel{\n    background:var(--teal-lighter);\n    border-radius:12px;\n    padding:22px;\n    margin-top:120px;\n  }\n  .row{\n    display:flex;\n    align-items:stretch;\n    border:1px solid var(--teal);\n    border-radius:12px;\n    background:#fff;\n    margin-bottom:16px;\n    overflow:hidden;\n  }\n  .row:last-child{margin-bottom:0;}\n  .row .tag{\n    width:118px;\n    flex:none;\n    background:var(--teal);\n    color:#fff;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    justify-content:center;\n    gap:10px;\n    font-size:14px;\n    line-height:1.5;\n    text-align:center;\n    padding:18px 6px;\n  }\n  .row .tag .placeholder{\n    width:46px;height:46px;\n    border-color:rgba(255,255,255,.7);\n    color:#fff;\n    font-size:0;\n  }\n  .row .content{\n    padding:18px 26px 18px 22px;\n  }\n  .row ul{\n    margin:0;\n    padding-left:18px;\n    list-style:none;\n  }\n  .row ul li{\n    position:relative;\n    margin-bottom:12px;\n    text-align:justify;\n  }\n  .row ul li:last-child{margin-bottom:0;}\n  .row ul li::before{\n    content:\"•\";\n    position:absolute;\n    left:-18px;\n    color:var(--text);\n  }\n\n  /* bottom stats */\n  .bottom-stats{\n    display:flex;\n    gap:16px;\n    margin-top:40px;\n  }\n  .bs-label{\n    background:var(--teal);\n    color:#fff;\n    border-radius:10px;\n    width:150px;\n    flex:none;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    text-align:center;\n    font-size:15px;\n    line-height:1.6;\n  }\n  .bs-box{\n    background:var(--teal-light);\n    border-radius:10px;\n    flex:1;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    gap:26px;\n    padding:26px 20px;\n  }\n  .bs-box .t{font-size:16px;color:var(--text);line-height:1.7;}\n  .bs-box .t.green{color:var(--teal);}\n  .bs-box .v{\n    font-size:52px;\n    font-weight:300;\n    color:var(--teal);\n    line-height:1;\n  }\n  .bs-box .v small{font-size:18px;}\n\n  /* page numbers */\n  .folio{\n    position:absolute;\n    bottom:34px;\n    font-size:12.5px;\n    color:var(--grey);\n  }\n  .folio.left{left:70px;}\n  .folio.right{right:70px;}\n\n  /* placeholders */\n  .placeholder{\n    border:1px dashed #A9D9D3;\n    border-radius:8px;\n    background:#F4FBFA;\n    color:#7FBDB6;\n    font-size:11px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    text-align:center;\n  }\n</style>\n</head>\n<body>\n<div class=\"spread\">\n\n  <!-- ================= LEFT PAGE (31) ================= -->\n  <section class=\"page\">\n    <div class=\"running-head\">2024 · 美的集团ESG报告</div>\n\n    <div class=\"h1-wrap\">\n      <h1>绿色使命 推进环境友好</h1>\n    </div>\n\n    <div class=\"body-col\">\n      <p style=\"margin-top:34px;\">美的集团积极承担绿色低碳发展的企业使命，不断优化和完善环境管理体系，并持续推动节能降耗和资源的高效利用。同时，我们始终关注生物多样性保护，并通过绿色融资助力低碳发展，为实现可持续发展目标贡献力量。</p>\n\n      <h2>绿色制造践行者</h2>\n\n      <p>美的集团把绿色环保的理念纳入生产运营全流程，严格遵守运营所在国家和地区的法律法规，并根据自身各运营场所的适用情况，制定并持续完善各项环境管理制度，确保环境管理体系持续有效运行。报告期内，美的集团未发生重大环境事故，未因环境事件受到重大的行政处罚。</p>\n\n      <h3>环境管理体系</h3>\n    </div>\n\n    <div class=\"lower-left\">\n      <div class=\"narrow-col\">\n        <p>我们在“遵守法规，实现污染预防、营造绿色环境，共建美的家园”方针的指引下，从 EHS 治理架构、管理体系建设、信息化平台搭建、体系评审及认证等方面有效保障环境管理的稳健运作。2024年度，我们发布了《美的集团环境与职业健康安全管理政策》，明确EHS管理方针、管理目标等内容。</p>\n      </div>\n\n      <div class=\"stat-card\">\n        <div class=\"cap\">报告期末</div>\n        <div class=\"inner\">\n          <figure class=\"placeholder\">[Icon: 绿色工厂图标]</figure>\n          <div class=\"txt\">\n            <div class=\"label\">已成功建立国家级绿色工厂</div>\n            <div class=\"num\">37<small>家</small></div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <figure class=\"illustration placeholder\">[Illustration: 底部通栏等轴测插画 — 山峰、风力发电、光伏板、绿色城市与工厂建筑群]</figure>\n\n    <div class=\"folio left\">31</div>\n  </section>\n\n  <!-- ================= RIGHT PAGE (32) ================= -->\n  <section class=\"page\">\n    <div class=\"nav\">\n      <span>关于本报告</span>\n      <span>走进美的</span>\n      <span>可持续发展治理</span>\n      <span class=\"active\">守护蓝色星球</span>\n      <span>构建和谐社区</span>\n      <span>践行科技尽善</span>\n      <span>共创繁荣生态</span>\n      <span>附录</span>\n    </div>\n\n    <div class=\"panel\">\n\n      <div class=\"row\">\n        <div class=\"tag\">\n          <figure class=\"placeholder\">[Icon]</figure>\n          <div>EHS<br>治理架构</div>\n        </div>\n        <div class=\"content\">\n          <ul>\n            <li>安全管理委员会作为集团EHS最高决策机构，统筹决策环境保护、安全生产及职业卫生管理，负责EHS执行情况的监督与考核；</li>\n            <li>下设办公室作为执行机构，负责日常管理及定期汇报。各事业群/事业部建立属地化治理架构，落实EHS政策、目标及管理要求。</li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"row\">\n        <div class=\"tag\">\n          <figure class=\"placeholder\">[Icon]</figure>\n          <div>EHS<br>管理体系</div>\n        </div>\n        <div class=\"content\">\n          <ul>\n            <li>依据法规、行业最佳实践及业务特性，落实既定EHS政策、体系标准，确保目标达成；</li>\n            <li>制定《EHS管理控制框架手册》，统一管理边界、流程管控及数据记录标准；</li>\n            <li>贯彻“一个美的，一个体系，一个标准”原则，构建覆盖关键领域的EHS技术标准与审核体系，强化全集团规范化管理。</li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"row\">\n        <div class=\"tag\">\n          <figure class=\"placeholder\">[Icon]</figure>\n          <div>EHS<br>数智化平台</div>\n        </div>\n        <div class=\"content\">\n          <ul>\n            <li>建立基于“智能采集、智能预警、智能管控、智能预测、智能决策、智能分析”的EHS数智化平台，包括智慧环保、环保在线监测，环保设施维护、危废管理等模块；</li>\n            <li>对各基地主要排污口在线监测数据进行收集分析，实现对污染物的全面检测及精准超标预警管理，达到全时段全场景的环境排污数据精准监控，确保排放合规。</li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"row\">\n        <div class=\"tag\">\n          <figure class=\"placeholder\">[Icon]</figure>\n          <div>EHS<br>风险管理</div>\n        </div>\n        <div class=\"content\">\n          <ul>\n            <li>建立危险有害因素及环境因素辨识流程，主动识别、评估和监测自身运营过程中的环境等EHS风险源并对各风险进行等级划分，针对性落实风险管控措施；</li>\n            <li>建立并healthy全针对突发环境事件等的EHS应急机制，对EHS风险事件进行分级管理，并制定相应的预防和应急举措，确保建立快速有效的应急处理流程。</li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"row\">\n        <div class=\"tag\">\n          <figure class=\"placeholder\">[Icon]</figure>\n          <div>体系评审<br>与认证</div>\n        </div>\n        <div class=\"content\">\n          <ul>\n            <li>各事业群 / 事业部实施年度 EHS 评审，覆盖程序文件执行、合规性及目标达成等维度；</li>\n            <li>开展年度集团层面评审，重点评估 EHS 管理制度及重点工作执行情况；</li>\n            <li>工厂年度进行EHS管理评审，评审结果由安委会汇总整理后向管理层汇报，包括工厂合规管控、体系执行情况、不符合项关闭进度等。</li>\n          </ul>\n        </div>\n      </div>\n\n    </div>\n\n    <div class=\"bottom-stats\">\n      <div class=\"bs-label\">截至<br>报告期末</div>\n      <div class=\"bs-box\">\n        <div class=\"t\">ISO 14001 认证工厂</div>\n        <div class=\"v\">37<small>家</small></div>\n      </div>\n      <div class=\"bs-box\">\n        <div class=\"t green\">全球制造基地<br>环境管理体系<br>认证覆盖率</div>\n        <div class=\"v\">100<small>%</small></div>\n      </div>\n    </div>\n\n    <div class=\"folio right\">32</div>\n  </section>\n\n</div>\n</body>\n</html>"
