 /* two-zone rows */\n  .row {\n    display: flex;\n    align-items: flex-start;\n  }\n  .left-col { width: 48%; box-sizing: border-box; padding-left: 12px; }\n  .right-col { width: 52%; box-sizing: border-box; }\n\n  .cn-tag {\n    display: inline-block;\n    font-size: 22px;\n    font-weight: 700;\n    letter-spacing: 4px;\n    padding: 6px 18px;\n    border-radius: 20px;\n  }\n  .cn-tag.blue { background: #bfe0f2; color: #1a2d5a; }\n  .cn-tag.green { background: #dff0a8; color: #1a2d5a; }\n\n  .en-head {\n    font-size: 21px;\n    font-weight: 700;\n    color: #2b2b2b;\n    letter-spacing: 0.5px;\n    border-bottom: 3px solid #cfe6f7;\n    display: inline-block;\n    padding-bottom: 2px;\n  }\n  .en-head.pink { border-bottom-color: #f6c9d6; }\n\n  .word-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    row-gap: 12px;\n    column-gap: 10px;\n    margin-top: 14px;\n    font-size: 21px;\n    font-weight: 700;\n    color: #3a3a3a;\n  }\n\n  .pink-box {\n    background: #fbe3e6;\n    padding: 12px 14px;\n    font-size: 15px;\n    line-height: 1.7;\n    color: #333;\n    margin-top: 14px;\n  }\n  .pink-box.narrow {\n    width: 128px;\n    box-sizing: border-box;\n  }\n\n  .placeholder {\n    background: #f2f2f2;\n    border: 1px dashed #bbb;\n    color: #777;\n    font-size: 11px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    box-sizing: border-box;\n  }\n\n  .footer-note {\n    position: absolute;\n    bottom: 8px;\n    left: 0;\n    width: 100%;\n    text-align: center;\n    font-size: 13px;\n    color: #7a8fb5;\n  }\n  .footer-note .small { font-size: 10px; color: #9aa9c4; }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <div class=\"band-red-top\"></div>\n  <div class=\"band-red-right\"></div>\n  <div class=\"band-blue-left\"></div>\n  <div class=\"band-red-bottom\"></div>\n\n  <div class=\"inner-white\"></div>\n\n  <div class=\"content\">\n\n    <!-- top-right floral decoration -->