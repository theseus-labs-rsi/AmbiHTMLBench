        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Cloud Architecture Center | Google Cloud</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] }\n};\n</script>\n<script src=\"https://polyfill.io/v3/polyfill.min.js?features=es6\"></script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    font-family: Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    color: #202124;\n    font-size: 14px;\n    line-height: 1.5;\n    background: #fff;\n  }\n  a { color: #1a73e8; text-decoration: none; }\n\n  /* ---------- Top navigation ---------- */\n  .topnav {\n    display: flex;\n    align-items: center;\n    gap: 24px;\n    padding: 10px 24px;\n    border-bottom: 1px solid #dadce0;\n    background: #fff;\n  }\n  .logo { font-size: 22px; font-weight: 400; white-space: nowrap; }\n  .logo .g1 { color: #4285f4; }\n  .logo .o1 { color: #ea4335; }\n  .logo .o2 { color: #fbbc04; }\n  .logo .g2 { color: #4285f4; }\n  .logo .l  { color: #34a853; }\n  .logo .e  { color: #ea4335; }\n  .logo .cloud { color: #5f6368; margin-left: 6px; }\n  .navitem {\n    color: #3c4043;\n    font-size: 14px;\n    white-space: nowrap;\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n  }\n  .caret { font-size: 9px; color: #5f6368; }\n  .nav-right {\n    margin-left: auto;\n    display: flex;\n    align-items: center;\n    gap: 14px;\n  }\n  .search-box {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    border: 1px solid #dadce0;\n    border-radius: 4px;\n    padding: 7px 10px;\n    width: 200px;\n    color: #5f6368;\n  }\n  .search-box .slash {\n    margin-left: auto;\n    border: 1px solid #dadce0;\n    border-radius: 3px;\n    padding: 0 5px;\n    font-size: 11px;\n  }\n  .console-btn {\n    border: 1px solid #dadce0;\n    border-radius: 4px;\n    padding: 7px 12px;\n    color: #3c4043;\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n  }\n  .lang-btn {\n    border: 1px solid #dadce0;\n    border-radius: 4px;\n    padding: 7px 12px;\n    color: #3c4043;\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n  }\n  .signin { color: #1a73e8; font-weight: 500; }\n\n  /* ---------- Hero ---------- */\n  .hero {\n    position: relative;\n    background: linear-gradient(100deg, #e8f0fe 0%, #eaf3ec 55%, #e6f4ea 100%);\n    padding: 60px 24px 70px;\n    overflow: hidden;\n    min-height: 260px;\n  }\n  .hero h1 {\n    font-size: 42px;\n    font-weight: 400;\n    margin: 0 0 22px;\n    letter-spacing: -0.5px;\n  }\n  .hero p { margin: 0; font-size: 15px; max-width: 950px; }\n  .hero-art {\n    position: absolute;\n    right: 60px;\n    top: 0;\n    width: 480px;\n    height: 300px;\n    color: #80868b;\n    font-size: 11px;\n    display: flex;\n    align-items: flex-end;\n    justify-content: center;\n    padding-bottom: 6px;\n  }\n\n  /* ---------- Foundational section ---------- */\n  .section-grey {\n    background: #f1f3f4;\n    padding: 48px 24px 60px;\n  }\n  h2.section-title {\n    font-size: 27px;\n    font-weight: 400;\n    margin: 0 0 32px;\n  }\n  .card-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 22px;\n  }\n  .card {\n    background: #fff;\n    border: 1px solid #dadce0;\n    border-radius: 8px;\n    padding: 22px 22px 26px;\n  }\n  .card .card-title {\n    font-size: 17px;\n    color: #1a73e8;\n    display: block;\n    margin-bottom: 16px;\n  }\n  .card p { margin: 0; font-size: 13.5px; color: #3c4043; }\n  .ext-icon { font-size: 12px; }\n\n  /* ---------- Domain-specific section ---------- */\n  .section-white { padding: 48px 24px 40px; }\n  .domain-layout {\n    display: flex;\n    gap: 44px;\n    margin-top: 40px;\n  }\n  .filter-col { width: 330px; flex: 0 0 330px; }\n  .filter-pill {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    background: #f1f3f4;\n    border-radius: 20px;\n    padding: 10px 18px;\n    font-size: 12px;\n    font-weight: 500;\n    letter-spacing: 0.8px;\n    color: #3c4043;\n    text-transform: uppercase;\n  }\n  .filter-list {\n    list-style: none;\n    margin: 12px 0 0;\n    padding: 0 0 0 40px;\n  }\n  .filter-list li { padding: 10px 0; font-size: 14px; color: #3c4043; }\n\n  .results-col { flex: 1; }\n  .filter-input {\n    width: 100%;\n    border: 1px solid #dadce0;\n    border-radius: 4px;\n    padding: 12px 14px;\n    font-size: 14px;\n    color: #5f6368;\n  }\n  .results-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 24px;\n    margin-top: 28px;\n  }\n  .rcard {\n    border: 1px solid #dadce0;\n    border-radius: 8px;\n    padding: 20px 20px 26px;\n    background: #fff;\n  }\n  .rcard .rtitle {\n    font-size: 17px;\n    color: #1a73e8;\n    display: block;\n    line-height: 1.35;\n    margin-bottom: 22px;\n  }\n  .rcard .updated {\n    font-size: 12px;\n    color: #5f6368;\n    margin: 0 0 14px;\n  }\n  .rcard p.desc { margin: 0; font-size: 13.5px; color: #3c4043; }\n  .clipped { overflow: hidden; max-height: 46px; }\n</style>\n</head>\n<body>\n\n<!-- Top navigation -->\n<div class=\"topnav\">\n  <div class=\"logo\">\n    <span class=\"g1\">G</span><span class=\"o1\">o</span><span class=\"o2\">o</span><span class=\"g2\">g</span><span class=\"l\">l</span><span class=\"e\">e</span><span class=\"cloud\">Cloud</span>\n  </div>\n  <span class=\"navitem\">Technology areas <span class=\"caret\">&#9660;</span></span>\n  <span class=\"navitem\">Cross-product tools <span class=\"caret\">&#9660;</span></span>\n  <div class=\"nav-right\">\n    <div class=\"search-box\">\n      <span>&#9906;</span><span>Search</span><span class=\"slash\">/</span>\n    </div>\n    <span class=\"console-btn\">&#9744; Console</span>\n    <span>&#9788;</span>\n    <span class=\"lang-btn\">&#127760; English <span class=\"caret\">&#9660;</span></span>\n    <a class=\"signin\" href=\"#\">Sign in</a>\n  </div>\n</div>\n\n<!-- Hero -->\n<div class=\"hero\">\n  <h1>Cloud Architecture Center</h1>\n  <p>Discover reference architectures, design guidance, and best practices for building, migrating, and managing your cloud workloads.<br>\n  See <a href=\"#\">what's new</a>!</p>\n  <figure class=\"hero-art placeholder\">[Illustration: abstract cloud, hexagon, circles and arcs — top right of hero]</figure>\n</div>\n\n<!-- Foundational guidance -->\n<div class=\"section-grey\">\n  <h2 class=\"section-title\">Review foundational architecture guidance for enterprise deployments in Google Cloud</h2>\n  <div class=\"card-grid\">\n    <div class=\"card\">\n      <a class=\"card-title\" href=\"#\">Google Cloud Well-Architected Framework</a>\n      <p>Design cloud topologies that are secure, efficient, resilient, high-performing, cost-effective, and sustainable.</p>\n    </div>\n    <div class=\"card\">\n      <a class=\"card-title\" href=\"#\">Deployment archetypes</a>\n      <p>Learn about basic archetypes for cloud deployments: zonal, regional, multi-regional, global, hybrid, and multicloud.</p>\n    </div>\n    <div class=\"card\">\n      <a class=\"card-title\" href=\"#\">Infrastructure reliability guide</a>\n      <p>Design and build infrastructure to run workloads reliably in Google Cloud.</p>\n    </div>\n    <div class=\"card\">\n      <a class=\"card-title\" href=\"#\">Landing zone design</a>\n      <p>Build a landing zone that includes identity onboarding, resource hierarchy, network design, and security controls.</p>\n    </div>\n    <div class=\"card\">\n      <a class=\"card-title\" href=\"#\">Enterprise foundations blueprint</a>\n      <p>Build a foundation for governance, security scale, visibility, and access.</p>\n    </div>\n    <div class=\"card\">\n      <a class=\"card-title\" href=\"#\">Delivery Navigator <span class=\"ext-icon\">&#9099;</span></a>\n      <p>Accelerate cloud solution deployments with implementation plans and technical guides from Google Cloud Consulting.</p>\n    </div>\n  </div>\n</div>\n\n<!-- Domain-specific guidance -->\n<div class=\"section-white\">\n  <h2 class=\"section-title\">Discover domain-specific architecture guidance</h2>\n\n  <div class=\"domain-layout\">\n    <!-- Filter column -->\n    <div class=\"filter-col\">\n      <div class=\"filter-pill\">&#9776; Filter by</div>\n      <ul class=\"filter-list\">\n        <li>AI and ML</li>\n        <li>Application development</li>\n        <li>Big data and analytics</li>\n        <li>Databases</li>\n        <li>Hybrid and multicloud</li>\n        <li>Migration</li>\n        <li>Monitoring and Logging</li>\n        <li>Networking</li>\n        <li>Reliability and DR</li>\n        <li>Security and compliance</li>\n        <li>Storage</li>\n      </ul>\n    </div>\n\n    <!-- Results column -->\n    <div class=\"results-col\">\n      <input class=\"filter-input\" type=\"text\" placeholder=\"Filter results\">\n\n      <div class=\"results-grid\">\n        <div class=\"rcard\">\n          <a class=\"rtitle\" href=\"#\">DevOps capabilities</a>\n          <p class=\"updated\">Updated May 21, 2026</p>\n          <p class=\"desc\">A set of capabilities that drive higher software delivery and organizational performance, as identified and validated by the DevOps Research and Assessment (DORA) team.</p>\n        </div>\n        <div class=\"rcard\">\n          <a class=\"rtitle\" href=\"#\">Networking for AI inference model serving on all backends</a>\n          <p class=\"updated\">Updated May 20, 2026</p>\n          <p class=\"desc\">Guidance to help you create a unified frontend for multiple AI models that are hosted on-premises or by any provider, including third-party and Google Cloud.</p>\n        </div>\n        <div class=\"rcard\">\n          <a class=\"rtitle\" href=\"#\">Networking for AI inference model serving on GKE</a>\n          <p class=\"updated\">Updated May 20, 2026</p>\n          <p class=\"desc\">Guidance to help you create a multiple-model inference service using GKE.</p>\n        </div>\n\n        <div class=\"rcard\">\n          <a class=\"rtitle\" href=\"#\">Build trusted AI agents with Google Maps Platform</a>\n          <p class=\"updated\">Updated May 1, 2026</p>\n          <p class=\"desc\">A high-level architecture to build trusted and effective AI agents by grounding them in real-world contextual data from Google Maps Platform and Google Calendar.</p>\n        </div>\n        <div class=\"rcard\">\n          <a class=\"rtitle\" href=\"#\">Deployment guidance for Gemini for Government</a>\n          <p class=\"updated\">Updated April 23, 2026</p>\n          <p class=\"desc\">This document provides technical guidance for US Federal agencies and DoD departments on deploying and using Gemini for Government in compliance with FedRAMP&hellip;</p>\n        </div>\n        <div class=\"rcard\">\n          <a class=\"rtitle\" href=\"#\">Agentic AI use case: Build a multicloud open data lakehouse</a>\n          <p class=\"updated\">Updated April 22, 2026</p>\n          <p class=\"desc\">A high-level architecture to build a multicloud open data lakehouse that establishes a highly governed, secure pipeline from raw multicloud silos to AI and agentic driven actions.</p>\n        </div>\n\n        <div class=\"rcard clipped\">\n          <a class=\"rtitle\" href=\"#\">Choose your agentic AI architecture components</a>\n        </div>\n        <div class=\"rcard clipped\">\n          <a class=\"rtitle\" href=\"#\">FedRAMP and DoD compliance scope for Google Cloud and&hellip;</a>\n        </div>\n        <div class=\"rcard clipped\">\n          <a class=\"rtitle\" href=\"#\">DoD compliance scope for Distributed Cloud air-gapped</a>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n</body>\n</html>"
