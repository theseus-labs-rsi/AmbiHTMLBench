n    padding: 4px 16px 0 22px;\n    border-left: 2px solid #b9c9d0;\n    margin-left: -1px;\n  }\n  .topbar {\n    display: flex;\n    align-items: center;\n    justify-content: flex-end;\n    gap: 8px;\n    height: 46px;\n  }\n  .topbar .ph-arrow {\n    width: 62px;\n    height: 30px;\n  }\n  .topbar .label {\n    font-size: 22px;\n    font-weight: 700;\n    color: #2f7f9c;\n  }\n  .topbar .ph-mountain {\n    width: 40px;\n    height: 34px;\n  }\n  .section { position: relative; margin-bottom: 6px; }\n  .tag {\n    display: inline-block;\n    border: 2px solid #3d7f96;\n    border-radius: 12px;\n    padding: 6px 16px;\n    font-size: 22px;\n    font-weight: 700;\n    color: #2f7f9c;\n    letter-spacing: 2px;\n    margin: 6px 0 4px 8px;\n  }\n  .row {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n  }\n  .para {\n    font-size: 17px;\n    line-height: 1.75;\n    font-weight: 700;\n    margin: 6px 0 10px 0;\n    text-align: justify;\n  }\n  /* ---------- Placeholders ---------- */\n  .placeholder {\n    background: #eceff1;\n    border: 1px dashed #9aa7ad;\n    color: #5c6a70;\n    font-size: 11px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    padding: 2px;\n  }\n  .photo1 { width: 160px; height: 122px; margin-top: 30px; }\n  .photo2 { width: 160px; height: 108px; margin-top: 8px; }\n  .photo3 { width: 200px; height: 92px; margin-top: 6px; }\n  .curve { width: 30px; height: 26px; }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <!-- LEFT SIDEBAR -->\n  <aside class=\"sidebar\">\n    <div class=\"vtitle\">\n      <span>步</span><span>行</span><span>游</span><span>览</span><span>区</span>\n    </div>\n    <div class=\"subtitle\">\n      <span class=\"boxed\">北</span>\n      <span class=\"arrow\">▶</span>\n      <span class=\"boxed\">线</span>\n    </div>\n    <div class=\"watermark\">6</div>\n  </aside>\n\n  <!-- RIGHT CONTENT -->\n  <main class=\"content\">\n\n    <div class=\"topbar\">\n      <figure class=\"placeholder ph-arrow\" style=\"margin:0;\">[Icon: hand-drawn arrow]</figure>\n      <div class=\"label\">◆ 接上篇</div>\n      <figure class=\"placeholder ph-mountain\" style=\"margin:0;\">[Icon: mountain]</figure>\n    </div>\n\n    <!-- Section 1 -->\n    <section class=\"section\">\n      <div class=\"row\">\n        <div>\n          <div class=\"tag\">马达加斯加<br>丛林</div>\n        </div>\n        <figure class=\"placeholder photo1\" style=\"margin:30px 0 0 0;\">[Photo: visitor feeding lemurs in jungle enclosure, top-right]</figure>\n      </div>\n      <p class=\"para\">环尾狐猴的天堂，成群结队的环尾狐猴在这里攀爬跳跃，在零距离投喂专属食物的时候有可能会跳到你的肩膀上哦，这时候就是拍照留念的最佳时机啦！</p>\n    </section>\n\n    <!-- Section 2 -->\n    <section class=\"section\">\n      <div class=\"row\">\n        <div>\n          <div class=\"tag\">小熊猫展区</div>\n        </div>\n        <figure class=\"placeholder photo2\" style=\"margin:0 0 0 0;\">[Photo: red panda display area with plush toys and signage, right]</figure>\n      </div>\n      <p class=\"para\">北野里最受欢迎的网红打卡地之一，里面设有零食铺子可以购买竹叶和小熊猫互动，注：自带的食物不能给它吃哦！</p>\n    </section>\n\n    <!-- Section 3 -->\n    <section class=\"section\">\n      <div class=\"row\">\n        <div>\n          <div class=\"tag\">爬行动物馆</div>\n        </div>\n        <figure class=\"placeholder photo3\" style=\"margin:0;\">[Photo: coiled yellow python, right]</figure>\n      </div>\n      <p class=\"para\">喜欢蟒蛇、蜥蜴的小伙伴们千万不要错过这里，黄金蟒、网纹蟒、红鬣蜥、绿鬣蜥、黑白泰迦等等都有昂！PS:怕蛇的小伙伴就不要挑战自己啦！</p>\n    </section>\n\n  </main>\n</div>\n</body>\n</html>"
