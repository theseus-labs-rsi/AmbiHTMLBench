        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>NIST SP 800-160, Vol. 2, Rev. 1 — Appendix F, Page 170</title>\n<script>\nwindow.MathJax = {\n  tex: {inlineMath: [['$','$']], displayMath: [['$$','$$']]}\n};\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\" async></script>\n<style>\n  body {\n    font-family: Calibri, \"Segoe UI\", Arial, sans-serif;\n    font-size: 12px;\n    margin: 0;\n    padding: 0;\n    background: #fff;\n    color: #000;\n  }\n  .page {\n    width: 8.5in;\n    min-height: 11in;\n    margin: 0 auto;\n    padding: 0.7in 0.75in 0.5in 0.9in;\n    box-sizing: border-box;\n    position: relative;\n  }\n  .sidebar-text {\n    position: absolute;\n    left: 0.28in;\n    top: 2.6in;\n    writing-mode: vertical-rl;\n    transform: rotate(180deg);\n    font-size: 11px;\n    color: #8a8a8a;\n    letter-spacing: 0.5px;\n    white-space: nowrap;\n  }\n  .sidebar-rule {\n    position: absolute;\n    left: 0.62in;\n    top: 0.95in;\n    width: 1px;\n    height: 8.6in;\n    background: #b8b8b8;\n  }\n  header.page-head {\n    display: flex;\n    justify-content: space-between;\n    align-items: baseline;\n    font-size: 12.5px;\n    padding-bottom: 4px;\n  }\n  header.page-head .left {\n    font-variant: small-caps;\n  }\n  header.page-head .right {\n    font-variant: small-caps;\n    text-transform: uppercase;\n    font-size: 11.5px;\n    letter-spacing: 0.2px;\n  }\n  .head-rule {\n    border-bottom: 1px solid #000;\n    margin-bottom: 30px;\n  }\n  table.matrix {\n    width: 100%;\n    border-collapse: collapse;\n    table-layout: fixed;\n  }\n  table.matrix th {\n    background: #1f3864;\n    color: #ffffff;\n    font-weight: bold;\n    text-align: center;\n    padding: 10px 6px;\n    font-size: 13px;\n    border: 1px solid #1f3864;\n    vertical-align: middle;\n  }\n  table.matrix td {\n    background: #ccdcf2;\n    border: 1px solid #ffffff;\n    padding: 5px 7px;\n    vertical-align: top;\n    font-size: 12.5px;\n    line-height: 1.35;\n  }\n  table.matrix td.technique {\n    font-weight: bold;\n  }\n  table.matrix tr.footer-band td {\n    background: #3b5f9e;\n    height: 14px;\n    padding: 0;\n    border: 1px solid #3b5f9e;\n  }\n  a.ref {\n    color: #1155cc;\n    text-decoration: underline;\n  }\n  col.c1 { width: 16%; }\n  col.c2 { width: 25%; }\n  col.c3 { width: 20.5%; }\n  col.c4 { width: 15%; }\n  col.c5 { width: 16%; }\n  footer.page-foot {\n    display: flex;\n    justify-content: space-between;\n    font-size: 13px;\n    margin-top: 2.1in;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"sidebar-rule\"></div>\n  <div class=\"sidebar-text\">This publication is available free of charge from: https://doi.org/10.6028/NIST.SP.800-160v2r1</div>\n\n  <header class=\"page-head\">\n    <div class=\"left\">NIST SP 800-160, V<span style=\"font-size:10.5px\">OL</span>. 2, R<span style=\"font-size:10.5px\">EV</span>. 1</div>\n    <div class=\"right\">Developing Cyber-Resilient Systems</div>\n  </header>\n  <div class=\"head-rule\"></div>\n\n  <table class=\"matrix\">\n    <colgroup>\n      <col class=\"c1\"><col class=\"c2\"><col class=\"c3\"><col class=\"c4\"><col class=\"c5\">\n    </colgroup>\n    <thead>\n      <tr>\n        <th>ATT&amp;CK<br>Technique</th>\n        <th>Mitigation or Candidate Mitigation</th>\n        <th>Cyber Resiliency Implementation Approaches</th>\n        <th>Potential<br>Effects</th>\n        <th>Cyber Resiliency Controls</th>\n      </tr>\n    </thead>\n    <tbody>\n      <!-- Replication Through Removable Media -->\n      <tr>\n        <td class=\"technique\" rowspan=\"4\">Replication Through Removable Media (T1091)</td>\n        <td>Disable or Remove Feature or Program (M1042)</td>\n        <td>Restriction</td>\n        <td>Exert, Preempt</td>\n        <td>CM-7(2)</td>\n      </tr>\n      <tr>\n        <td rowspan=\"2\">Virtual Sandbox (<a class=\"ref\" href=\"#\">CM1109</a>)</td>\n        <td>Non-Persistent Services</td>\n        <td>Preempt, Shorten</td>\n        <td>SC-7(20)</td>\n      </tr>\n      <tr>\n        <td>Dynamic Segmentation and Isolation</td>\n        <td>Delay, Contain</td>\n        <td>SC-7(20)</td>\n      </tr>\n      <tr>\n        <td style=\"height:95px\">Removable Device Usage Detection (<a class=\"ref\" href=\"#\">CM2008</a>)</td>\n        <td>Monitoring and Damage Assessment</td>\n        <td>Detect</td>\n        <td>CM-8(3)</td>\n      </tr>\n\n      <!-- Supply Chain Compromise -->\n      <tr>\n        <td class=\"technique\" rowspan=\"8\">Supply Chain Compromise (T1195)</td>\n        <td rowspan=\"2\">Vulnerability Scanning (M1016)</td>\n        <td>Integrity Checks</td>\n        <td>Preempt, Detect</td>\n        <td>SA-9(7)</td>\n      </tr>\n      <tr>\n        <td>Provenance Tracking</td>\n        <td>Detect, Scrutinize</td>\n        <td>SR-4(3), SR-4(4)</td>\n      </tr>\n      <tr>\n        <td rowspan=\"2\">Software Integrity Check (<a class=\"ref\" href=\"#\">CM2009</a>)</td>\n        <td>Integrity Checks</td>\n        <td>Detect</td>\n        <td>SI-7, SI-7(1)</td>\n      </tr>\n      <tr>\n        <td>Integrity Checks, Provenance Tracking</td>\n        <td>Detect</td>\n        <td>CM-14, SR-4(3)</td>\n      </tr>\n      <tr>\n        <td>Software Stress Testing (<a class=\"ref\" href=\"#\">CM2010</a>)</td>\n        <td>Self-Challenge</td>\n        <td>Detect</td>\n        <td>SR-6(1)</td>\n      </tr>\n      <tr>\n        <td>Physical Inspection (<a class=\"ref\" href=\"#\">CM2011</a>)</td>\n        <td>Integrity Checks</td>\n        <td>Detect</td>\n        <td>SR-9, SR-10</td>\n      </tr>\n      <tr>\n        <td>Component Provenance Validation (<a class=\"ref\" href=\"#\">CM1105</a>)</td>\n        <td>Provenance Tracking</td>\n        <td>Detect, Delay, Exert</td>\n        <td>SR-4, SR-4(1), SR-4(2), SR-4(3), SR-4(4)</td