        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>人民日报金句—清正廉洁篇</title>\n<script src=\"https://polyfill.io/v3/polyfill.min.js?features=es6\"></script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  body {\n    margin: 0;\n    padding: 0;\n    background: #d8dcd6;\n    font-family: \"Kaiti SC\", \"KaiTi\", \"STKaiti\", serif;\n  }\n  .page {\n    position: relative;\n    width: 540px;\n    min-height: 720px;\n    margin: 0 auto;\n    background: #fdfdf8;\n    box-sizing: border-box;\n    padding: 14px 26px 30px 46px;\n    border-left: 1px solid #ddd;\n  }\n  /* spiral binding on the left edge */\n  .spiral {\n    position: absolute;\n    left: 6px;\n    top: 8px;\n    width: 26px;\n    height: 700px;\n    display: flex;\n    flex-direction: column;\n    justify-content: flex-start;\n    gap: 12px;\n  }\n  .ring {\n    width: 24px;\n    height: 8px;\n    border: 1px solid #b9b9b0;\n    border-radius: 6px;\n    background: #ececE4;\n  }\n  .topbar {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-bottom: 10px;\n  }\n  .notes-label {\n    color: #c94a58;\n    font-size: 11px;\n    letter-spacing: 1px;\n    font-family: Arial, Helvetica, sans-serif;\n  }\n  .tabs {\n    display: flex;\n    gap: 2px;\n  }\n  .tab {\n    width: 15px;\n    height: 15px;\n    border: 1px solid #cfcfc6;\n    border-radius: 3px;\n    font-size: 7px;\n    color: #a8a8a0;\n    text-align: center;\n    line-height: 15px;\n    font-family: Arial, Helvetica, sans-serif;\n  }\n  .titlebar {\n    border: 2px solid #333;\n    border-radius: 4px;\n    padding: 6px 10px;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    margin-bottom: 18px;\n    background: #fff;\n  }\n  .pill {\n    border: 1px solid #555;\n    border-radius: 10px;\n    font-size: 9px;\n    padding: 1px 7px;\n    color: #555;\n    font-family: Arial, Helvetica, sans-serif;\n    flex: none;\n  }\n  .maintitle {\n    font-size: 24px;\n    font-weight: bold;\n    letter-spacing: 1px;\n    flex: 1;\n  }\n  .date {\n    font-size: 20px;\n    color: #2b4fa0;\n    font-family: \"Comic Sans MS\", cursive;\n  }\n  .body-text p {\n    font-size: 14.5px;\n    line-height: 2.05;\n    margin: 0 0 16px 0;\n    text-align: justify;\n    color: #1c1c1c;\n  }\n  .hl {\n    border: 1px solid #d05a63;\n    background: #fdeff0;\n    padding: 0 2px;\n    border-radius: 2px;\n  }\n  .watermark {\n    position: absolute;\n    left: 50%;\n    top: 48%;\n    transform: translate(-50%, -50%) rotate(-12deg);\n    font-size: 62px;\n    color: rgba(180, 180, 170, 0.28);\n    white-space: nowrap;\n    pointer-events: none;\n    font-family: \"Kaiti SC\", \"KaiTi\", serif;\n  }\n  .footer {\n    text-align: right;\n    font-size: 8px;\n    color: #b9b9b0;\n    font-family: Arial, Helvetica, sans-serif;\n    margin-top: 6px;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <div class=\"spiral\">\n    <div class=\"ring\"></div><div class=\"ring\"></div><div class=\"ring\"></div>\n    <div class=\"ring\"></div><div class=\"ring\"></div><div class=\"ring\"></div>\n    <div class=\"ring\"></div><div class=\"ring\"></div><div class=\"ring\"></div>\n    <div class=\"ring\"></div><div class=\"ring\"></div><div class=\"ring\"></div>\n    <div class=\"ring\"></div><div class=\"ring\"></div><div class=\"ring\"></div>\n    <div class=\"ring\"></div><div class=\"ring\"></div><div class=\"ring\"></div>\n    <div class=\"ring\"></div><div class=\"ring\"></div><div class=\"ring\"></div>\n    <div class=\"ring\"></div><div class=\"ring\"></div><div class=\"ring\"></div>\n    <div class=\"ring\"></div><div class=\"ring\"></div><div class=\"ring\"></div>\n    <div class=\"ring\"></div><div class=\"ring\"></div><div class=\"ring\"></div>\n    <div class=\"ring\"></div><div 