    width: 100%;\n    height: 62px;\n    background: #f3f1e8;\n    border: 1px dashed #b9b4a4;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    font-size: 9px;\n    color: #8a8577;\n    box-sizing: border-box;\n  }\n  .food-cell { text-align: center; }\n  .food-cell .cap {\n    margin-top: 3px;\n    font-size: 10px;\n    color: #555;\n  }\n  table.advice {\n    width: 100%;\n    border-collapse: collapse;\n    margin-bottom: 8px;\n  }\n  table.advice td {\n    padding: 3px 4px;\n    vertical-align: top;\n    line-height: 1.5;\n  }\n  table.advice td.label {\n    width: 82px;\n    color: #7ab929;\n    white-space: nowrap;\n  }\n  .note {\n    color: #f0a30a;\n    font-size: 10px;\n    border-top: 1px dotted #d8d3c2;\n    padding-top: 4px;\n  }\n  .recipe-body {\n    line-height: 1.55;\n    margin: 0 0 4px 0;\n  }\n  .recipe-body .k { color: #7ab929; }\n  ol.steps {\n    margin: 2px 0 0 0;\n    padding-left: 18px;\n    line-height: 1.55;\n  }\n  .side-note {\n    float: right;\n    width: 70px;\n    height: 46px;\n    margin: 0 0 4px 8px;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"title-bar\">\n    <h1>12~18 月龄宝宝的辅食攻略</h1>\n  </div>\n\n  <div class=\"columns\">\n\n    <!-- 左栏 -->\n    <div class=\"col-left\">\n\n      <h2 class=\"sec\">喂养要点</h2>\n      <ul class=\"dots\">\n        <li>注意进餐仪式感，鼓励宝宝和家人共餐感受进餐氛围</li>\n        <li>开始鼓励宝宝自己[illegible]，只用勺子吃饭，鼓励独立进餐</li>\n        <li>如需宝宝对新食物有抗拒，可反复尝试，[illegible]</li>\n        <li>[illegible]谷薯类、蔬菜、豆制品、带壳海鲜、蛋类等食物</li>\n      </ul>\n\n      <h2 class=\"sec\">辅食性状</h2>\n      <div>片状、大块的食物（以米饭、面条、猪肉、蔬菜、南瓜为例）</div>\n\n      <div class=\"food-grid\">\n        <div class=\"food-cell\">\n          <div class=\"placeholder\">[照片：米饭]</div>\n          <div class=\"cap\">米饭</div>\n        </div>\n        <div class=\"food-cell\">\n          <div class=\"placeholder\">[照片：面条]</div>\n          <div class=\"cap\">面条</div>\n        </div>\n        <div class=\"food-cell\">\n          <div class=\"placeholder\">[照片：猪肉]</div>\n          <div class=\"cap\">猪肉</div>\n        </div>\n        <div class=\"food-cell\">\n          <div class=\"placeholder\">[照片：蔬菜]</div>\n          <div class=\"cap\">蔬菜</div>\n        </div>\n        <div class=\"food-cell\">\n          <div class=\"placeholder\">[照片：蔬菜]</div>\n          <div class=\"cap\">蔬菜</div>\n        </div>\n        <div class=\"food-cell\">\n          <div class=\"placeholder\">[照片：南瓜]</div>\n          <div class=\"cap\">南瓜</div>\n        </div>\n      </div>\n\n      <h2 class=\"sec\">喂养建议</h2>\n      <table class=\"advice\">\n        <tr>\n          <td class=\"label\">乳品类摄量</td>\n          <td>每日 2 次，每日约 400~500ml</td>\n        </tr>\n        <tr>\n          <td class=\"label\">辅食提供量</td>\n          <td>每日 3 次，每次 1 碗</td>\n        </tr>\n        <tr>\n          <td class=\"label\" rowspan=\"4\">食物选择</td>\n          <td><span>谷薯类</span>　各种谷薯类谷[?] 3/4~1 碗</td>\n        </tr>\n        <tr>\n          <td><span>蔬菜类</span>　各种蔬菜 1/2~2/3 碗</td>\n        </tr>\n        <tr>\n          <td><span>水果类</span>　各种水果 1/2~2/3 碗</td>\n        </tr>\n        <tr>\n          <td><span>肉、蛋、禽类、鱼、豆腐</span>　各 6~8 勺</td>\n        </tr>\n        <tr>\n          <td class=\"label\">油脂</td>\n          <td>每日油 10~15g，盐 &lt; 1.5g</td>\n        </tr>\n      </table>\n      <div class=\"note\">注意：以上都是食物提供量的建议，[illegible]</div>\n\n    </div>\n\n    <!-- 右栏 -->\n    <div class=\"col-right\">\n\n      <h2 class=\"sec\">经典食谱</h2>\n\n      <div class=\"placeholder side-note\">[图片：右上角装饰]</div>\n\n      <h3 class=\"recipe\">食谱一：木须肉</h3>\n      <p class=\"recipe-body\"><span class=\"k\">用料：</span>猪肉、木耳、黄瓜、鸡蛋、葱、姜、食用油、水</p>\n      <p class=\"recipe-body\"><span class=\"k\">做法：</span></p>\n      <ol class=\"steps\">\n        <li>猪肉切小片备用，木耳泡发[illegible]切小片，黄瓜洗净切片，鸡蛋打散备用。</li>\n        <li>热锅倒油，[illegible]鸡蛋打散放入锅内炒熟，盛出备用。</li>\n        <li>锅内[illegible]油，放入葱姜爆香，然后放入猪肉[illegible]变色后，再放入木耳、黄瓜、鸡蛋，加少量水，翻炒均匀即可。</li>\n      </ol>\n\n      <h3 class=\"recipe\">食谱二：青椒爆猪肝</h3>\n      <p class=\"recipe-body\"><span class=\"k\">用料：</span>猪肝、青椒、葱、姜、食用油</p>\n      <p class=\"recipe-body\"><span class=\"k\">做法：</span></p>\n      <ol class=\"steps\">\n        <li>猪肝洗净后，切成小片[illegible]，用少量[illegible]和淀粉抓匀腌制，青椒洗净切小片。</li>\n        <li>热锅倒油，放入葱姜爆香，加入猪肝快速翻炒至变色。</li>\n        <li>加入青椒片，翻炒[illegible]即可。</li>\n      </ol>\n\n      <h3 class=\"recipe\">食谱三：土豆胡萝卜炖鸡腿</h3>\n      <p class=\"recipe-body\"><span class=\"k\">用料：</span>土豆、胡萝卜、鸡腿、水</p>\n      <p class=\"recipe-body\"><span class=\"k\">做法：</span></p>\n      <ol class=\"steps\">\n        <li>土豆、胡萝卜洗净去皮切块，鸡腿洗净[illegible]。</li>\n        <li>锅中加水，放入鸡腿[illegible]，加入土豆块和胡萝卜块。</li>\n        <li>[illegible]小火炖至软烂即可。</li>\n      </ol>\n\n      <h3 class=\"recipe\">食谱四：鲜嫩玉米羹</h3>\n      <p class=\"recipe-body\"><span class=\"k\">用料：</span>鲜玉米、牛奶[?]、水、食用油</p>\n      <p class=\"recipe-body\"><span class=\"k\">做法：</span></p>\n      <ol class=\"steps\">\n        <li>鲜玉米剥粒[illegible]洗净备用。</li>\n        <li>[illegible]玉米粒放入锅中加水煮熟。</li>\n        <li>煮熟后[illegible]搅打成糊状，倒回锅中。</li>\n        <li>[illegible]加入牛奶[?]搅拌均匀，小火加热至[illegible]即可。</li>\n      </ol>\n\n    </div>\n  </div>\n</div>\n</body>\n</html>",
