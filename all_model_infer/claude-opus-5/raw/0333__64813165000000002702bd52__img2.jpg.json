px;\n  }\n\n  /* Dialogue block */\n  .dialogue {\n    position: relative;\n    height: 130px;\n  }\n  .dlg-cn {\n    position: absolute;\n    left: 136px;\n    top: 4px;\n    font-size: 13.5px;\n    font-weight: bold;\n    line-height: 1.62;\n    color: #111;\n  }\n  .dlg-jp {\n    position: absolute;\n    left: 300px;\n    top: 4px;\n    font-size: 12.5px;\n    line-height: 1.75;\n    color: #111;\n  }\n\n  /* Illustration */\n  .illustration {\n    position: relative;\n    height: 300px;\n    margin: 0 0 0 60px;\n  }\n  .illustration .placeholder {\n    width: 470px;\n    height: 300px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #999;\n    font-size: 12px;\n  }\n\n  /* Japanese body paragraph */\n  .jp-body {\n    margin: 6px 62px 0 60px;\n    font-size: 12px;\n    line-height: 1.85;\n    color: #111;\n    text-align: justify;\n  }\n\n  /* Chinese bold conclusion */\n  .cn-body {\n    margin: 14px 24px 0 46px;\n    font-size: 18px;\n    font-weight: bold;\n    line-height: 1.5;\n    color: #111;\n    text-align: justify;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"left-edge\">\n    <div class=\"placeholder\" style=\"width:60px;height:520px;display:flex;align-items:center;justify-content:center;\">[Illustration: left page edge, partial figure]</div>\n    <div style=\"position:absolute;left:2px;top:520px;font-size:11px;line-height:1.9;color:#111;\">\n      踏んでいる<br>\n      に肥満する<br>\n      指摘したく<br>\n      に見える\n    </div>\n  </div>\n\n  <div class=\"header\">\n    <div class=\"title-cn\">打岔别人的报告，然后重新把舞台交给他</div>\n    <div class=\"no35\">No.35</div>\n    <div class=\"title-jp1\">ひとの報告をさえぎり、その後、</div>\n    <div class=\"title-jp2\">再開させる<span class=\"small\">(カニエ・ウェストみたいに)</span></div>\n  </div>\n\n  <div class=\"dialogue\">\n    <div class=\"dlg-cn\">\n      安东尼，你稍等下<br>\n      大家安静下<br>\n      接下来安东尼要发表我们<br>\n      的第四季度目标报告了，<br>\n      大家要认真听哦！<br>\n      那么安东尼，请继续。\n    </div>\n    <div class=\"dlg-jp\">\n      アンソニー、ちょっとストップ<br>\n      　　　ねえみんな、<br>\n      アンソニーが私たちの<br>\n      四半期目標について報告するから、<br>\n      　　ちゃんと聞いてね<br>\n      じゃあアンソニー、続けて\n    </div>\n  </div>\n\n  <div class=\"illustration\">\n    <div class=\"placeholder\">[Illustration: two people at a table in a meeting, man in foreground pointing, woman seated with coffee cup — centered]</div>\n  </div>\n\n  <div class=\"jp-body\">\n    だれかがプロジェクトについて報告をはじめたら、それをさえぎって、この報告がどれほど大事かみんなに知らせる。そして、報告者に続けるよう言う。一瞬にしてあなたは会議の支配者となる。\n  </div>\n\n  <div class=\"cn-body\">\n    当别人准备进行项目报告的时候，抢险打岔他的报告，然后告诉大家这个报告有多重要。再让发言者继续发表报告。一瞬间你就可以成为这个会议的主宰者。\n  </div>\n\n</div>\n</body>\n</html>"
