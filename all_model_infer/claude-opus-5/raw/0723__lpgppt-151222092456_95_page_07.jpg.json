n  }\n  table.spec th {\n    background: #f5a623;\n    font-weight: normal;\n    font-size: 22px;\n    text-align: center;\n    padding: 6px 4px;\n    border: 1px solid #d4d4d4;\n  }\n  table.spec th.corner {\n    background: #d4d4d4;\n    border: none;\n  }\n  table.spec td {\n    background: #ffffff;\n    text-align: center;\n    padding: 6px 8px;\n    border: 1px solid #d4d4d4;\n    vertical-align: middle;\n  }\n  table.spec td.label {\n    background: #d4d4d4;\n    text-align: left;\n    border: none;\n    padding-left: 14px;\n    width: 42%;\n  }\n  table.spec td.val {\n    width: 29%;\n  }\n  sup {\n    font-size: 0.7em;\n  }\n  .footer-date {\n    position: absolute;\n    left: 60px;\n    bottom: 18px;\n    font-size: 15px;\n    color: #7ec8ee;\n  }\n  .footer-credit {\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 12px;\n    text-align: center;\n    font-size: 15px;\n    color: #7ec8ee;\n    line-height: 1.35;\n  }\n  .placeholder {\n    position: absolute;\n    right: 30px;\n    bottom: 20px;\n    width: 90px;\n    height: 90px;\n    border-radius: 50%;\n    background: #cfe8f7;\n    color: #33627d;\n    font-size: 10px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    box-sizing: border-box;\n    padding: 4px;\n  }\n</style>\n</head>\n<body>\n<div class=\"slide\">\n  <div class=\"swoosh-tr\"></div>\n  <div class=\"swoosh-bl\"></div>\n\n  <div class=\"content-panel\">\n    <h1 class=\"slide-title\">LP gas and technical specifications</h1>\n    <table class=\"spec\">\n      <tr>\n        <th class=\"corner\"></th>\n        <th>Butane</th>\n        <th>Propane</th>\n      </tr>\n      <tr>\n        <td class=\"label\">Chemical formula</td>\n        <td class=\"val\">C4H10</td>\n        <td class=\"val\">C3H8</td>\n      </tr>\n      <tr>\n        <td class=\"label\">Density at 15&deg;C</td>\n        <td class=\"val\">Heavier than air</td>\n        <td class=\"val\">Heavier than air</