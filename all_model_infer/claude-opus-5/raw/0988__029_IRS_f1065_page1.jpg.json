        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Form 1065 (2025) — U.S. Return of Partnership Income</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$','$']], displayMath: [['$$','$$']] }\n};\n</script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 12.5px;\n    margin: 0;\n    padding: 18px;\n    background: #fff;\n    color: #000;\n  }\n  .form {\n    width: 1000px;\n    margin: 0 auto;\n  }\n  table { border-collapse: collapse; width: 100%; }\n  td, th { vertical-align: top; padding: 1px 3px; }\n  .bx { border: 1px solid #000; }\n  .bt { border-top: 1px solid #000; }\n  .bb { border-bottom: 1px solid #000; }\n  .bl { border-left: 1px solid #000; }\n  .br { border-right: 1px solid #000; }\n  .lbl { font-size: 11px; }\n  .b { font-weight: bold; }\n  .i { font-style: italic; }\n  .ctr { text-align: center; }\n  .rt { text-align: right; }\n\n  /* ---------- Header ---------- */\n  .header { border: 1px solid #000; display: flex; align-items: stretch; }\n  .hdr-left { width: 235px; border-right: 1px solid #000; padding: 6px 8px 4px 8px; }\n  .hdr-left .formline { display: flex; align-items: flex-end; gap: 6px; }\n  .hdr-left .formword { font-size: 13px; padding-bottom: 6px; }\n  .hdr-left .num1065 { font-size: 42px; font-weight: bold; letter-spacing: -1px; line-height: 1; }\n  .hdr-left .dept { font-size: 12px; margin-top: 18px; line-height: 1.25; }\n  .hdr-mid { flex: 1; border-right: 1px solid #000; padding: 4px 6px; }\n  .title { text-align: center; font-size: 25px; font-weight: bold; margin: 4px 0 6px; }\n  .cal-line { font-size: 13px; font-weight: bold; display: flex; align-items: flex-end; justify-content: center; gap: 4px; }\n  .dline { border-bottom: 1px dashed #000; display: inline-block; }\n  .goto { text-align: center; font-size: 13.5px; font-weight: bold; margin-top: 6px; }\n  .hdr-right { width: 200px; padding: 4px 6px; }\n  .omb { text-align: center; font-size: 12px; }\n  .yearbig { text-align: center; font-size: 38px; font-weight: bold; line-height: 1; margin-top: 6px; letter-spacing: -1px; }\n  .yearbig .hollow { color: #fff; -webkit-text-stroke: 1.4px #000; }\n\n  /* ---------- Entity block ---------- */\n  .entity { border: 1px solid #000; border-top: none; }\n  .entity td { border: 1px solid #000; height: 52px; font-size: 12px; }\n  .entity td.noborder-left { border-left: none; }\n\n  /* ---------- G-K checkbox rows ---------- */\n  .gk { border: 1px solid #000; border-top: none; }\n  .gk .row { display: flex; align-items: center; padding: 3px 6px; font-size: 13.5px; }\n  .gk .ltr { width: 34px; font-weight: bold; text-align: center; flex: none; }\n  .cb { display: inline-block; width: 13px; height: 13px; border: 1px solid #000; vertical-align: -2px; margin: 0 4px; }\n  .fill { flex: 1; border-bottom: 1px dashed #000; margin: 0 4px 3px; height: 12px; }\n  .caution { border: 1px solid #000; border-top: none; padding: 3px 8px; font-size: 13.5px; }\n\n  /* ---------- Line item table ---------- */\n  .lines { border: 1px solid #000; border-top: none; }\n  .lines td { font-size: 13.5px; }\n  .side {\n    width: 30px;\n    border-right: 1px solid #000;\n    text-align: center;\n    vertical-align: middle;\n  }\n  .side span {\n    writing-mode: vertical-rl;\n    transform: rotate(180deg);\n    font-weight: bold;\n    white-space: nowrap;\n  }\n  .side span.small { font-weight: normal; font-size: 11px; }\n  .no { width: 46px; text-align: right; font-weight: bold; padding-right: 6px; }\n  .desc { }\n  .leader { }\n  .amtno { width: 46px; border-left: 1px solid #000; border-right: 1px solid #000; font-weight: bold; padding-left: 5px; }\n  .amt { width: 210px; border-right: 0; }\n  .rowline td { border-bottom: 1px solid #000; height: 25px; vertical-align: bottom; }\n  .gray { background: #c8c8c8; }\n  .midbox { width: 46px; border: 1px solid #000; font-weight: bold; padding-left: 4px; }\n  .midamt { width: 100px; border-right: 1px solid #000; }\n  .dots { letter-spacing: 2px; }\n\n  /* ---------- Signature ---------- */\n  .sign { border: 1px solid #000; border-top: none; display: flex; }\n  .sign-left { width: 145px; border-right: 1px solid #000; padding: 10px 8px; font-size: 22px; font-weight: bold; line-height: 1.25; }\n  .sign-right { flex: 1; padding: 4px 6px; }\n  .perjury { font-size: 11.5px; line-height: 1.3; }\n  .sigrow { display: flex; margin-top: 34px; }\n  .sigline { flex: 1; border-top: 1px solid #000; margin-right: 12px; font-size: 12px; padding-top: 2px; }\n  .dateline { width: 200px; border-top: 1px solid #000; font-size: 12px; padding-top: 2px; padding-left: 40px; }\n  .irsbox { width: 300px; border: 2px solid #000; padding: 4px 6px; font-size: 12px; line-height: 1.3; margin-left: 8px; }\n\n  .paid { border: 1px solid #000; border-top: none; display: flex; }\n  .paid-left { width: 145px; border-right: 1px solid #000; padding: 8px; font-size: 21px; font-weight: bold; line-height: 1.3; }\n  .paid-right { flex: 1; }\n  .paid-right table td { border: 1px solid #000; font-size: 12px; height: 34px; }\n  .paid-right table tr:first-child td { border-top: none; }\n  .paid-right table td:first-child { border-left: none; }\n  .paid-right table td:last-child { border-right: none; }\n\n  .footer { display: flex; align-items: baseline; margin-top: 4px; font-size: 13px; }\n  .footer .fl { font-weight: bold; }\n  .footer .fc { flex: 1; text-align: center; }\n  .footer .fr { }\n  .placeholder {\n    border: 1px dashed #888;\n    color: #555;\n    font-size: 11px;\n    text-align: center;\n  }\n  .routing { display: inline-block; }\n  .routing .cellbox {\n    display: inline-block;\n    width: 26px;\n    height: 20px;\n    border-right: 1px dashed #000;\n    border-top: 1px solid #000;\n    border-bottom: 1px solid #000;\n    vertical-align: middle;\n  }\n  .routing .cellbox:first-child { border-left: 1px solid #000; }\n</style>\n</head>\n<body>\n<div class=\"form\">\n\n  <!-- ================= HEADER ================= -->\n  <div class=\"header\">\n    <div class=\"hdr-left\">\n      <div class=\"formline\">\n        <span class=\"formword\">Form</span>\n        <span class=\"num1065\">1065</span>\n      </div>\n      <div class=\"dept\">Department of the Treasury<br>Internal Revenue Service</div>\n    </div>\n    <div class=\"hdr-mid\">\n      <div class=\"title\">U.S. Return of Partnership Income</div>\n      <div class=\"cal-line\">\n        <span>For calendar year 2025, or tax year beginning</span>\n        <span class=\"dline\" style=\"width:130px;\">&nbsp;</span>\n        <span>, 2025, ending</span>\n        <span class=\"dline\" style=\"width:130px;\">&nbsp;</span>\n        <span>, 20</span>\n        <span class=\"dline\" style=\"width:34px;\">&nbsp;</span>\n        <span>.</span>\n      </div>\n      <div class=\"goto\">Go to <span class=\"i\">www.irs.gov/Form1065</span> for instructions and the latest information.</div>\n    </div>\n    <div class=\"hdr-right\">\n      <div class=\"omb\">OMB No. 1545-0123</div>\n      <div class=\"yearbig\"><span class=\"hollow\">20</span>25</div>\n    </div>\n  </div>\n\n  <!-- ================= ENTITY BLOCK ================= -->\n  <table class=\"entity\">\n    <tr>\n      <td style=\"width:235px;\">A&nbsp; Principal business activity</td>\n      <td colspan=\"3\" style=\"width:none;\">Name of partnership</td>\n      <td rowspan=\"1\" style=\"width:225px;\"><span class=\"b\">D&nbsp; Employer<br>&nbsp;&nbsp;&nbsp;&nbsp; identification number</span></td>\n    </tr>\n    <tr>\n      <td>B&nbsp; Principal product or service</td>\n      <td colspan=\"2\">Number and street</td>\n      <td style=\"width:165px;\">Room or suite no.</td>\n      <td><span class=\"b\">E</span>&nbsp; Date business started</td>\n    </tr>\n    <tr>\n      <td>C&nbsp; Business code number</td>\n      <td style=\"width:190px;\">City or town</td>\n      <td style=\"width:190px;\">State or province</td>\n      <td>ZIP or foreign<br>postal code</td>\n      <td><span class=\"b\">F</span>&nbsp; Total assets <span class=\"lbl\">(see instructions)</span><br><br>$</td>\n    </tr>\n  </table>\n  <table class=\"entity\" style=\"border-top:none; display:none;\"></table>\n\n  <!-- Country column note: rendered in a second aligned row set below to preserve 5-column city row -->\n\n  <!-- ================= G through K ================= -->\n  <div class=\"gk\">\n    <div class=\"row\">\n      <div class=\"ltr\">G</div>\n      <div>Check applicable boxes:&nbsp;&nbsp; <span class=\"b\">(1)</span><span class=\"cb\"></span> Initial return&nbsp;&nbsp;&nbsp;\n        <span class=\"b\">(2)</span><span class=\"cb\"></span> Final return&nbsp;&nbsp;&nbsp;\n        <span class=\"b\">(3)</span><span class=\"cb\"></span> Name change&nbsp;&nbsp;&nbsp;\n        <span class=\"b\">(4)</span><span class=\"cb\"></span> Address change&nbsp;&nbsp;&nbsp;\n        <span class=\"b\">(5)</span><span class=\"cb\"></span> Amended return</div>\n    </div>\n    <div class=\"row\">\n      <div class=\"ltr\">H</div>\n      <div style=\"display:flex; flex:1; align-items:center;\">\n        <span>Check accounting method:&nbsp;&nbsp;&nbsp;&nbsp; <span class=\"b\">(1)</span><span class=\"cb\"></span> Cash&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\n        <span class=\"b\">(2)</span><span class=\"cb\"></span> Accrual&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\n        <span class=\"b\">(3)</span><span class=\"cb\"></span> Other (specify):</span>\n        <span class=\"fill\"></span>\n      </div>\n    </div>\n    <div class=\"row\">\n      <div class=\"ltr\">I</div>\n      <div style=\"display:flex; flex:1; align-items:center;\">\n        <span>Number of Schedules K-1. Attach one for each person who was a partner at any time during the tax year:</span>\n        <span class=\"fill\" style=\"max-width:170px;\"></span>\n      </div>\n    </div>\n    <div class=\"row\">\n      <div class=\"ltr\">J</div>\n      <div style=\"display:flex; flex:1; align-items:center;\">\n        <span>Check if Schedules C and M-3 are attached</span>\n        <span class=\"dots\" style=\"flex:1; margin:0 8px;\">. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .</span>\n        <span class=\"cb\" style=\"margin-right:0;\"></span>\n      </div>\n    </div>\n    <div class=\"row\">\n      <div class=\"ltr\">K</div>\n      <div>Check if partnership:&nbsp;&nbsp; <span class=\"b\">(1)</span><span class=\"cb\"></span> Aggregated activities for section 465 at-risk purposes&nbsp;&nbsp;&nbsp;\n        <span class=\"b\">(2)</span><span class=\"cb\"></span> Grouped activities for section 469 passive activity purposes</div>\n    </div>\n  </div>\n\n  <div class=\"caution\"><span class=\"b\">Caution:</span> Include <span class=\"b\">only</span> trade or business income and expenses on lines 1a through 23 below. See instructions for more information.</div>\n\n  <!-- ================= INCOME ================= -->\n  <table class=\"lines\">\n    <!-- Income section -->\n    <tr class=\"rowline\">\n      <td class=\"side\" rowspan=\"8\"><span>Income</span></td>\n      <td class=\"no\">1a</td>\n      <td class=\"desc\" colspan=\"2\">Gross receipts or sales <span style=\"display:inline-block;width:150px;border-bottom:1px solid #000;\">&nbsp;</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class=\"b\">b</span> Less returns and allowances <span style=\"display:inline-block;width:170px;border-bottom:1px solid #000;\">&nbsp;</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class=\"b\">c</span> Balance</td>\n      <td class=\"amtno\">1c</td>\n      <td class=\"amt\"></td>\n    </tr>\n    <tr class=\"rowline\">\n      <td class=\"no\">2</td>\n      <td class=\"desc\" colspan=\"2\">Cost of goods sold (attach Form 1125-A)&nbsp;&nbsp;<span class=\"dots\">. . . . . . . . . . . . . . . . . . .</span></td>\n      <td class=\"amtno\">2</td>\n      <td class=\"amt\"></td>\n    </tr>\n    <tr class=\"rowline\">\n      <td class=\"no\">3</td>\n      <td class=\"desc\" colspan=\"2\">Gross profit. Subtract line 2 from line 1c&nbsp;&nbsp;<span class=\"dots\">. . . . . . . . . . . . . . . . . . .</span></td>\n      <td class=\"amtno\">3</td>\n      <td class=\"amt\"></td>\n    </tr>\n    <tr class=\"rowline\">\n      <td class=\"no\">4</td>\n      <td class=\"desc\" colspan=\"2\">Ordinary income (loss) from other partnerships, estates, and trusts (attach statement)&nbsp;&nbsp;<span class=\"dots\">. . . .</span></td>\n      <td class=\"amtno\">4</td>\n      <td class=\"amt\"></td>\n    </tr>\n    <tr class=\"rowline\">\n      <td class=\"no\">5</td>\n      <td class=\"desc\" colspan=\"2\">Net farm profit (loss) (attach Schedule F (Form 1040))&nbsp;&nbsp;<span class=\"dots\">. . . . . . . . . . . . . . . .</span></td>\n      <td class=\"amtno\">5</td>\n      <td class=\"amt\"></td>\n    </tr>\n    <tr class=\"rowline\">\n      <td class=\"no\">6</td>\n      <td class=\"desc\" colspan=\"2\">Net gain (loss) from Form 4797, Part II, line 17 (attach Form 4797)&nbsp;&nbsp;<span class=\"dots\">. . . . . . . . . . .</span></td>\n      <td class=\"amtno\">6</td>\n      <td class=\"amt\"></td>\n    </tr>\n    <tr class=\"rowline\">\n      <td class=\"no\">7</td>\n      <td class=\"desc\" colspan=\"2\">Other income (loss) (attach statement)&nbsp;&nbsp;<span class=\"dots\">. . . . . . . . . . . . . . . . . . . .</span></td>\n      <td class=\"amtno\">7</td>\n      <td class=\"amt\"></td>\n    </tr>\n    <tr class=\"rowline\">\n      <td class=\"no\">8</td>\n      <td class=\"desc\" colspan=\"2\"><span class=\"b\">Total income (loss).</span> Combine lines 3 through 7&nbsp;&nbsp;<span class=\"dots\">. . . . . . . . . . . . . . . . .</span></td>\n      <td class=\"amtno\">8</td>\n      <td class=\"amt\"></td>\n    </tr>\n\n    <!-- Deductions section -->\n    <tr class=\"rowline\">\n      <td class=\"side\" rowspan=\"15\"><span>Deductions <span class=\"small\">(see instructions for limitations)</span></span></td>\n      <td class=\"no\">9</td>\n      <td class=\"desc\" colspan=\"2\">Salaries and wages (other than to partners) (less employment credits)&nbsp;<span class=\"dots\">. . . . . . . . .</span></td>\n      <td class=\"amtno\">9</td>\n      <td class=\"amt\"></td>\n    </tr>\n    <tr class=\"rowline\">\n      <td class=\"no\">10</td>\n      <td class=\"desc\" colspan=\"2\">Guaranteed payments to partners&nbsp;&nbsp;<span class=\"dots\">. . . . . . . . . . . . . . . . . . . . .</span></td>\n      <td class=\"amtno\">10</td>\n      <td class=\"amt\"></td>\n    </tr>\n    <tr class=\"rowline\">\n      <td class=\"no\">11</td>\n      <td class=\"desc\" colspan=\"2\">Repairs and maintenance&nbsp;&nbsp;<span class=\"dots\">. . . . . . . . . . . . . . . . . . . . . . . .</span></td>\n      <td class=\"amtno\">11</td>\n      <td class=\"amt\"></td>\n    </tr>\n    <tr class=\"rowline\">\n      <td class=\"no\">12</td>\n      <td class=\"desc\" colspan=\"2\">Bad debts&nbsp;&nbsp;<span class=\"dots\">. . . . . . . . . . . . . . . . . . . . . . . . . . . . .</span></td>\n      <td class=\"amtno\">12</td>\n      <td class=\"amt\"></td>\n    </tr>\n    <tr class=\"rowline\">\n      <td class=\"no\">13</td>\n      <td class=\"desc\" colspan=\"2\">Rent&nbsp;&nbsp;<span class=\"dots\">. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .</span></td>\n      <td class=\"amtno\">13</td>\n      <td class=\"amt\"></td>\n    </tr>\n    <tr class=\"rowline\">\n      <td class=\"no\">14</td>\n      <td class=\"desc\" colspan=\"2\">Taxes and licenses&nbsp;&nbsp;<span class=\"dots\">. . . . . . . . . . . . . . . . . . . . . . . . . .</span></td>\n      <td class=\"amtno\">14</td>\n      <td class=\"amt\"></td>\n    </tr>\n    <tr class=\"rowline\">\n      <td class=\"no\">15</td>\n      <td class=\"desc\" colspan=\"2\">Interest (see instructions)&nbsp;&nbsp;<span class=\"dots\">. . . . . . . . . . . . . . . . . . . . . . . .</span></td>\n      <td class=\"amtno\">15</td>\n      <td class=\"amt\"></td>\n    </tr>\n    <tr class=\"rowline\">\n      <td class=\"no\">16a</td>\n      <td class=\"desc\">Depreciation (if required, attach Form 4562)&nbsp;&nbsp;<span class=\"dots\">. . . . . . . . . .</span></td>\n      <td style=\"padding:0; border:none; white-space:nowrap;\">\n        <span style=\"display:inline-block;width:44px;border:1px solid #000;border-bottom:1px solid #000;font-weight:bold;padding-left:4px;\">16a</span><span style=\"display:inline-block;width:100px;border-right:1px solid #000;border-bottom:1px solid #000;\">&nbsp;</span>\n      </td>\n      <td class=\"amtno gray\"></td>\n      <td class=\"amt gray\"></td>\n    </tr>\n    <tr class=\"rowline\">\n      <td class=\"no\">b</td>\n      <td class=\"desc\">Less depreciation reported on Form 1125-A and elsewhere on return&nbsp;&nbsp;<span class=\"dots\">. .</span></td>\n      <td style=\"padding:0; border:none; white-space:nowrap;\">\n        <span style=\"display:inline-block;width:44px;border:1px solid #000;font-weight:bold;padding-left:4px;\">16b</span><span style=\"display:inline-block;width:100px;border-right:1px solid #000;\">&nbsp;</span>\n      </td>\n      <td class=\"amtno\">16c</td>\n      <td class=\"amt\"></td>\n    </tr>\n    <tr class=\"rowline\">\n      <td class=\"no\">17</td>\n      <td class=\"desc\" colspan=\"2\">Depletion <span class=\"b\">(Do not deduct oil and gas depletion.)</span>&nbsp;&nbsp;<span class=\"dots\">. . . . . . . . . . . . . .</span></td>\n      <td class=\"amtno\">17</td>\n      <td class=\"amt\"></td>\n    </tr>\n    <tr class=\"rowline\">\n      <td class=\"no\">18</td>\n      <td class=\"desc\" colspan=\"2\">Retirement plans, etc.&nbsp;&nbsp;<span class=\"dots\">. . . . . . . . . . . . . . . . . . . . . . . . .</span></td>\n      <td class=\"amtno\">18</td>\n      <td class=\"amt\"></td>\