        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Performance Materials &ndash; 2Q Results</title>\n<script>\nwindow.MathJax = { tex: { inlineMath: [['$','$']], displayMath: [['$$','$$']] } };\n</script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  html, body { margin:0; padding:0; }\n  body {\n    font-family: \"Calibri\", \"Carlito\", \"Trebuchet MS\", Arial, sans-serif;\n    color:#000;\n    background:#fff;\n    width:1024px;\n    position:relative;\n  }\n  /* ---- Top banner ---- */\n  .topbar {\n    height:46px;\n    background:#c8102e;\n    position:relative;\n  }\n  .topbar .fade {\n    position:absolute; top:0; right:150px; width:120px; height:46px;\n    background:linear-gradient(to right,#c8102e,#e8e8e8);\n  }\n  .topbar .logobox {\n    position:absolute; top:0; right:0; width:150px; height:46px;\n    background:#5a5a5a; color:#fff;\n    display:flex; align-items:center; justify-content:center;\n  }\n  .topbar .logobox .logo {\n    border:2px solid #fff;\n    border-radius:16px/50%;\n    padding:1px 14px;\n    font-family:Arial, sans-serif;\n    font-weight:bold;\n    font-size:22px;\n    letter-spacing:0.5px;\n  }\n  .topbar .logobox .reg { font-size:9px; vertical-align:bottom; }\n\n  /* ---- Titles ---- */\n  h1.title {\n    text-align:center;\n    font-size:23px;\n    font-weight:bold;\n    margin:14px 0 4px 0;\n  }\n  h2.subtitle {\n    text-align:center;\n    font-size:19px;\n    font-style:italic;\n    font-weight:normal;\n    margin:0 0 10px 0;\n  }\n\n  /* ---- Main two-column layout ---- */\n  .main {\n    display:flex;\n    align-items:flex-start;\n    padding:0 20px;\n    box-sizing:border-box;\n  }\n  .col-left { width:510px; }\n  .col-right { width:474px; margin-left:10px; }\n\n  /* ---- Section header bars ---- */\n  .bar {\n    background:#1f4e79;\n    background:linear-gradient(to bottom,#28588c,#1b4570);\n    color:#fff;\n    font-weight:bold;\n    font-size:17px;\n    text-align:center;\n    padding:4px 0;\n    margin:0 24px 6px 56px;\n  }\n\n  /* ---- Chart placeholders ---- */\n  .chartwrap { position:relative; }\n  .placeholder {\n    box-sizing:border-box;\n    position:relative;\n  }\n\n  .chart1 {\n    width:440px; height:230px;\n    margin-left:50px;\n  }\n  .chart2 {\n    width:470px; height:250px;\n    margin-left:40px;\n  }\n\n  /* axis label rotated */\n  .ylabel {\n    position:absolute;\n    left:-6px;\n    top:50%;\n    transform:translateY(-50%) rotate(-90deg);\n    font-size:13px;\n    font-weight:bold;\n    white-space:nowrap;\n  }\n  .ylabel-right {\n    position:absolute;\n    right:-8px;\n    top:55%;\n    transform:translateY(-50%) rotate(-90deg);\n    font-size:13px;\n    font-weight:bold;\n    white-space:nowrap;\n  }\n\n  .axisnums {\n    position:absolute;\n    left:0; top:0;\n    width:44px;\n    height:100%;\n    font-size:14px;\n    font-weight:bold;\n    text-align:right;\n    display:flex;\n    flex-direction:column;\n    justify-content:space-between;\n  }\n  .axisnums-right {\n    position:absolute;\n    right:0; top:0;\n    width:44px;\n    height:100%;\n    font-size:14px;\n    font-weight:bold;\n    text-align:left;\n    display:flex;\n    flex-direction:column;\n    justify-content:space-between;\n  }\n  .plotarea {\n    position:absolute;\n    left:52px; right:52px; top:8px; bottom:34px;\n    border-left:1px solid #808080;\n    border-bottom:1px solid #808080;\n    background:#fff;\n    display:flex;\n    align-items:flex-end;\n    justify-content:space-around;\n    font-size:11px;\n    color:#666;\n    text-align:center;\n  }\n  .plotarea .note {\n    width:100%;\n    text-align:center;\n    padding-bottom:4px;\n    color:#777;\n    font-style:italic;\n  }\n  .catlabels {\n    position:absolute;\n    left:52px; right:52px; bottom:6px;\n    display:flex;\n    justify-content:space-around;\n    font-size:14px;\n    font-weight:bold;\n  }\n\n  /* ---- Right side comment boxes ---- */\n  .box {\n    border:1px solid #b3b3b3;\n    border-radius:8px;\n    background:#f2f2f2;\n    padding:8px 12px 12px 12px;\n    box-sizing:border-box;\n  }\n  .box + .box { margin-top:14px; }\n  .box .boxtitle {\n    text-align:center;\n    font-weight:bold;\n    font-size:14px;\n    margin-bottom:6px;\n  }\n  .box ul {\n    list-style:none;\n    margin:0;\n    padding:0;\n  }\n  .box ul li {\n    position:relative;\n    padding-left:22px;\n    margin-bottom:10px;\n    font-size:14.5px;\n    font-weight:bold;\n    line-height:1.25;\n  }\n  .box ul li:before {\n    content:\"\\276F\";\n    content:\"\\2751\";\n    position:absolute;\n    left:0;\n    top:0;\n    font-weight:normal;\n    font-size:13px;\n  }\n\n  /* ---- Footnotes ---- */\n  .footnotes {\n    position:relative;\n    margin:6px 0 0 22px;\n    font-size:11.5px;\n    line-height:1.35;\n    width:700px;\n  }\n  .footnotes span.mark {\n    display:inline-block;\n    width:26px;\n  }\n  .pagenum {\n    position:absolute;\n    right:22px;\n    bottom:6px;\n    font-size:16px;\n    font-weight:bold;\n  }\n  .legendswatch {\n    position:absolute;\n    left:26px;\n    width:18px; height:18px;\n    background:#1f4e79;\n  }\n  .legendline {\n    position:absolute;\n    left:504px;\n    width:3px; height:22px;\n    background:#e8112d;\n  }\n</style>\n</head>\n<body>\n\n<div class=\"topbar\">\n  <div class=\"fade\"></div>\n  <div class=\"logobox\"><span class=\"logo\">DU PONT</span><span class=\"reg\">&reg;</span></div>\n</div>\n\n<h1 class=\"title\">Performance Materials***</h1>\n<h2 class=\"subtitle\">Performance Polymers (DPP), Packaging &amp; Industrial Polymers (P&amp;IP)</h2>\n\n<div class=\"main\">\n\n  <!-- ================= LEFT COLUMN ================= -->\n  <div class=\"col-left\">\n\n    <div class=\"bar\">2Q Sales *</div>\n\n    <div class=\"chartwrap\">\n      <figure class=\"placeholder chart1\">\n        <div class=\"ylabel\">$ in Billions</div>\n        <div class=\"axisnums\">\n          <div>2.0</div><div>1.6</div><div>1.2</div><div>0.8</div><div>0.4</div><div>0.0</div>\n        </div>\n        <div class=\"plotarea\">\n          <div class=\"note\">[Chart: vertical bar chart, three blue bars of near-equal height &mdash; centered]</div>\n        </div>\n        <div class=\"catlabels\">\n          <div>2Q12</div><div>2Q13</div><div>2Q14</div>\n        </div>\n      </figure>\n    </div>\n\n    <div class=\"bar\">2Q Operating Earnings **</div>\n\n    <div class=\"chartwrap\">\n      <figure class=\"placeholder chart2\">\n        <div class=\"ylabel\">$ in Millions</div>\n        <div class=\"ylabel-right\">Margin</div>\n        <div class=\"axisnums\">\n          <div>375</div><div>300</div><div>225</div><div>150</div><div>75</div><div>0</div>\n        </div>\n        <div class=\"axisnums-right\">\n          <div>25%</div><div>20%</div><div>15%</div><div>10%</div><div>5%</div><div>0%</div>\n        </div>\n        <div class=\"plotarea\">\n          <div class=\"note\">[Chart: blue bar chart with red margin line overlay &mdash; centered]</div>\n        </div>\n        <div class=\"catlabels\">\n          <div>2Q12</div><div>2Q13</div><div>2Q14</div>\n        </div>\n      </figure>\n    </div>\n\n  </div>\n\n  <!-- ================= RIGHT COLUMN ================= -->\n  <div class=\"col-right\">\n\n    <div class=\"box\">\n      <div class=\"boxtitle\">2Q Comments</div>\n      <ul>\n        <li>Sales down 2% due to lower volumes resulting from the scheduled ethylene outage and portfolio impact of the GLS/Vinyls sale</li>\n        <li>Demand for Performance Polymers up mid-single digits due to strengthening automotive market</li>\n        <li>Demand environment in consumer, construction, and food packaging markets remains stable</li>\n        <li>Operating earnings down 9% as higher sales in automotive were more than offset by reduced supply of ethylene and the portfolio impact of the GLS/Vinyls sale</li>\n      </ul>\n    </div>\n\n    <div class=\"box\">\n      <div class=\"boxtitle\">3Q Outlook</div>\n      <ul>\n        <li>3Q sales essentially flat due to the GLS/Vinyls sale</li>\n        <li>Consumer, construction, and food packaging volumes forecasted to remain stable</li>\n        <li>Automotive volumes anticipated to remain strong led by China and Europe</li>\n        <li>3Q operating earnings up modestly versus prior year which included a $30 million benefit related to a JV equity position</li>\n      </ul>\n    </div>\n\n  </div>\n</div>\n\n<div class=\"footnotes\">\n  <span class=\"mark\">*</span>Segment sales include transfers.<br>\n  <span class=\"mark\">**</span>See appendix for reconciliation of non-GAAP measures.<br>\n  <span class=\"mark\">***</span>Prior periods reflect reclassification of Viton&reg; fluoroelastomers from Performance Materials to Performance Chemicals\n</div>\n\n<div class=\"pagenum\">13</div>\n\n</body>\n</html>"
