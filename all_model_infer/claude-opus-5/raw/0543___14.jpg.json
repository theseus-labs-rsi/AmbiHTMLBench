        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>半导体 / AI 价值链全景图</title>\n<script>\nwindow.MathJax = {\n  tex: {inlineMath: [['$','$']], displayMath: [['$$','$$']]}\n};\n</script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    padding: 18px 14px 10px;\n    background: #ffffff;\n    font-family: \"Helvetica Neue\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n    color: #1a2540;\n  }\n  .page { max-width: 1024px; margin: 0 auto; }\n\n  h1.main-title {\n    text-align: center;\n    font-size: 47px;\n    font-weight: 800;\n    letter-spacing: 1px;\n    margin: 6px 0 4px;\n    color: #0e1b3d;\n  }\n  h1.main-title .accent { color: #1c86d6; }\n  .subtitle {\n    text-align: center;\n    font-size: 21px;\n    font-weight: 700;\n    color: #2b3a5c;\n    margin: 0 0 16px;\n  }\n\n  table.chain {\n    width: 100%;\n    border-collapse: collapse;\n    table-layout: fixed;\n    border: 1px solid #d7dce6;\n  }\n  table.chain thead th {\n    background: #10214a;\n    color: #ffffff;\n    font-size: 17px;\n    font-weight: 700;\n    padding: 12px 6px;\n    text-align: center;\n    border-right: 1px solid #2b3a63;\n  }\n  table.chain thead th:last-child { border-right: none; }\n\n  col.c1 { width: 24%; }\n  col.c2 { width: 19%; }\n  col.c3 { width: 33%; }\n  col.c4 { width: 24%; }\n\n  table.chain td {\n    border-top: 1px solid #dfe3ec;\n    border-right: 1px solid #dfe3ec;\n    padding: 14px 12px;\n    vertical-align: middle;\n    font-size: 15.5px;\n    line-height: 1.7;\n  }\n  table.chain td:last-child { border-right: none; }\n\n  /* 层级单元格 */\n  .layer-cell { padding: 12px 10px; }\n  .layer-head { display: flex; align-items: center; gap: 10px; }\n  .num {\n    display: inline-block;\n    width: 30px; height: 30px; line-height: 30px;\n    text-align: center;\n    border-radius: 6px;\n    font-weight: 800;\n    font-size: 17px;\n    color: #ffffff;\n    flex: 0 0 auto;\n  }\n  .layer-name { font-weight: 700; font-size: 16.5px; line-height: 1.45; }\n\n  .placeholder {\n    border: 1px dashed #b9c2d4;\n    background: #f7f9fc;\n    color: #6b7793;\n    font-size: 11px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    padding: 2px;\n  }\n  .icon-ph {\n    width: 62px; height: 58px;\n    margin: 6px 0 0 44px;\n  }\n  .role, .duty { text-align: center; }\n  .logos {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    align-items: center;\n    gap: 8px 18px;\n    font-weight: 700;\n  }\n  .logos span { white-space: nowrap; font-size: 17px; }\n  .logos .sm { font-size: 13px; }\n\n  /* 行主题色 */\n  .r1 { background:#faf7fd; } .r1 .num { background:#7b3fa0; } .r1 .layer-name { color:#7b3fa0; }\n  .r2 { background:#f4f8fd; } .r2 .num { background:#1e6fb8; } .r2 .layer-name { color:#1e6fb8; }\n  .r3 { background:#f3fafa; } .r3 .num { background:#0f7d78; } .r3 .layer-name { color:#0f7d78; }\n  .r4 { background:#f5faf5; } .r4 .num { background:#3d8b45; } .r4 .layer-name { color:#3d8b45; }\n  .r5 { background:#fdfaf1; } .r5 .num { background:#c8992a; } .r5 .layer-name { color:#c8992a; }\n  .r6 { background:#faf7fd; } .r6 .num { background:#5b3fa0; } .r6 .layer-name { color:#5b3fa0; }\n  .r7 { background:#fdf6f0; } .r7 .num { background:#e0761c; } .r7 .layer-name { color:#e0761c; }\n  .r8 { background:#f4f8fd; } .r8 .num { background:#1e6fb8; } .r8 .layer-name { color:#1e6fb8; }\n  .r9 { background:#f4f8fd; } .r9 .num { background:#1c5ea8; } .r9 .layer-name { color:#1c5ea8; }\n  .r10 { background:#ffffff; } .r10 .num { background:#6b3fa0; } .r10 .layer-name { color:#6b3fa0; }\n\n  /* 关键要点 */\n  .keypoints {\n    margin-top: 16px;\n    border: 1px solid #cfd6e4;\n    border-radius: 10px;\n    padding: 14px 16px;\n    display: flex;\n    align-items: center;\n    gap: 18px;\n  }\n  .kp-left { display: flex; align-items: flex-start; gap: 12px; flex: 0 0 42%; }\n  .kp-icon { width: 52px; height: 52px; flex: 0 0 auto; border-radius: 50%; }\n  .kp-title { font-weight: 800; font-size: 16px; color: #10214a; margin-bottom: 4px; }\n  .kp-text { font-size: 12.5px; line-height: 1.8; color: #2b3a5c; }\n\n  .flow {\n    flex: 1 1 auto;\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 2px;\n  }\n  .flow-item { text-align: center; width: 66px; }\n  .flow-logo {\n    height: 26px;\n    margin-bottom: 4px;\n    font-size: 11px;\n  }\n  .flow-label { font-size: 11.5px; color: #2b3a5c; white-space: nowrap; }\n  .arrow { color: #4a5878; font-size: 14px; padding-top: 8px; }\n\n  .footnote {\n    margin-top: 10px;\n    font-size: 11px;\n    color: #7a8398;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <h1 class=\"main-title\">半导体 / AI <span class=\"accent\">价值链全景图</span></h1>\n  <div class=\"subtitle\">从设计到智能：端到端生态体系</div>\n\n  <table class=\"chain\">\n    <colgroup>\n      <col class=\"c1\"><col class=\"c2\"><col class=\"c3\"><col class=\"c4\">\n    </colgroup>\n    <thead>\n      <tr>\n        <th>层级</th>\n        <th>主要作用</th>\n        <th>代表企业（示例）</th>\n        <th>在AI生态中的角色</th>\n      </tr>\n    </thead>\n    <tbody>\n\n      <tr class=\"r1\">\n        <td class=\"layer-cell\">\n          <div class=\"layer-head\"><span class=\"num\">1</span><span class=\"layer-name\">架构设计 / IP层</span></div>\n          <div class=\"placeholder icon-ph\">[图标: 芯片]</div>\n        </td>\n        <td class=\"duty\">创建基础IP<br>和芯片架构</td>\n        <td>\n          <div class=\"logos\">\n            <span>arm</span><span>cadence</span>\n            <span>SIEMENS</span><span>Allegro <span class=\"sm\">MicroSystems</span></span>\n          </div>\n        </td>\n        <td class=\"role\">定义芯片如何设计，<br>是关键的第一步</td>\n      </tr>\n\n      <tr class=\"r2\">\n        <td class=\"layer-cell\">\n          <div class=\"layer-head\"><span class=\"num\">2</span><span class=\"layer-name\">芯片设计<br>（无晶圆厂）</span></div>\n          <div class=\"placeholder icon-ph\">[图标: 显示器芯片]</div>\n        </td>\n        <td class=\"duty\">使用IP设计芯片，<br>但不生产</td>\n        <td>\n          <div class=\"logos\">\n            <span>NVIDIA</span><span>AMD</span>\n            <span>BROADCOM</span><span>Qualcomm</span>\n            <span>MARVELL</span><span>MACOM</span><span>NXP</span>\n          </div>\n        </td>\n        <td class=\"role\">打造高性能芯片<br>（GPU、CPU、ASIC、<br>SoC、网络芯片等）</td>\n      </tr>\n\n      <tr class=\"r3\">\n        <td class=\"layer-cell\">\n          <div class=\"layer-head\"><span class=\"num\">3</span><span class=\"layer-name\">晶圆制造<br>（代工）</span></div>\n          <div class=\"placeholder icon-ph\">[图标: 工厂]</div>\n        </td>\n        <td class=\"duty\">在晶圆上制造芯片，<br>使用先进制程</td>\n        <td>\n          <div class=\"logos\">\n            <span>tsmc</span><span>UMC</span>\n            <span>GlobalFoundries</span><span>intel</span>\n          </div>\n        </td>\n        <td class=\"role\">最资本密集的环节，<br>将设计变为现实</td>\n      </tr>\n\n      <tr class=\"r4\">\n        <td class=\"layer-cell\">\n          <div class=\"layer-head\"><span class=\"num\">4</span><span class=\"layer-name\">设备<br>（生产设备）</span></div>\n          <div class=\"placeholder icon-ph\">[图标: 设备]</div>\n        </td>\n        <td class=\"duty\">提供制造芯片所需<br>的机器和工具</td>\n        <td>\n          <div class=\"logos\">\n            <span>ASML</span><span>APPLIED MATERIALS</span>\n            <span>Lam <span class=\"sm\">RESEARCH</span></span><span>KLA</span><span>Onto innovation</span>\n          </div>\n        </td>\n        <td class=\"role\">支撑芯片制造的<br>每一步，是进入<br>的高门槛环节</td>\n      </tr>\n\n      <tr class=\"r5\">\n        <td class=\"layer-cell\">\n          <div class=\"layer-head\"><span class=\"num\">5</span><span class=\"layer-name\">封装与测试<br>（OSAT）</span></div>\n          <div class=\"placeholder icon-ph\">[图标: 封装芯片]</div>\n        </td>\n        <td class=\"duty\">封装、打包并测试<br>芯片以确保可用</td>\n        <td>\n          <div class=\"logos\">\n            <span>Amkor <span class=\"sm\">Technology</span></span><span>ASE</span>\n            <span>FormFactor</span>\n          </div>\n        </td>\n        <td class=\"role\">先进封装是AI芯片<br>（HBM、2.5D/3D等）<br>的关键瓶颈</td>\n      </tr>\n\n      <tr class=\"r6\">\n        <td class=\"layer-cell\">\n          <div class=\"layer-head\"><span class=\"num\">6</span><span class=\"layer-name\">内存</span></div>\n          <div class=\"placeholder icon-ph\">[图标: 内存条]</div>\n        </td>\n        <td class=\"duty\">提供内存芯片<br>（DRAM、HBM、<br>NAND），为AI<br>提供存储与带宽</td>\n        <td>\n          <div class=\"logos\">\n            <span>Micron</span><span>WD Western Digital</span>\n            <span>SanDisk</span><span>SEAGATE</span><span>DRAM</span>\n          </div>\n        </td>\n        <td class=\"role\">内存带宽是AI<br>工作负载的关键<br>瓶颈之一</td>\n      </tr>\n\n      <tr class=\"r7\">\n        <td class=\"layer-cell\">\n          <div class=\"layer-head\"><span class=\"num\">7</span><span class=\"layer-name\">电源芯片与<br>电力管理</span></div>\n          <div class=\"placeholder icon-ph\">[图标: 闪电]</div>\n        </td>\n        <td class=\"duty\">高效交付与管理<br>芯片和系统所需<br>的电力</td>\n        <td>\n          <div class=\"logos\">\n            <span>MPS <span class=\"sm\">MONOLITHIC POWER SYSTEMS</span></span><span>TEXAS INSTRUMENTS</span>\n            <span>ST</span><span>NXP</span><span>ON <span class=\"sm\">ON Semiconductor</span></span>\n          </div>\n        </td>\n        <td class=\"role\">对AI服务器、GPU、<br>电动车等电力效率<br>至关重要</td>\n      </tr>\n\n      <tr class=\"r8\">\n        <td class=\"layer-cell\">\n          <div class=\"layer-head\"><span class=\"num\">8</span><span class=\"layer-name\">连接与网络</span></div>\n          <div class=\"placeholder icon-ph\">[图标: 网络节点]</div>\n        </td>\n        <td class=\"duty\">在芯片、系统和<br>数据中心之间<br>高速传输数据</td>\n        <td>\n          <div class=\"logos\">\n            <span>LUMENTUM</span><span>MARVELL</span>\n            <span>ciena</span><span>COHERENT</span><span>CREDO <span class=\"sm\">we Connect.</span></span>\n          </div>\n        </td>\n        <td class=\"role\">高速连接是AI<br>基础设施的<br>关键骨干</td>\n      </tr>\n\n      <tr class=\"r9\">\n        <td class=\"layer-cell\">\n          <div class=\"layer-head\"><span class=\"num\">9</span><span class=\"layer-name\">系统与基础设施</span></div>\n          <div class=\"placeholder icon-ph\">[图标: 服务器机柜]</div>\n        </td>\n        <td class=\"duty\">将芯片集成到服务器、<br>系统和硬件解决方案</td>\n        <td>\n          <div class=\"logos\">\n            <span>DELL <span class=\"sm\">Technologies</span></span><span>Hewlett Packard Enterprise</span><span>TTM <span class=\"sm\">Technologies</span></span>\n            <span>NOKIA</span><span>CELESTICA <span class=\"sm\">ACIO</span></span><span>SMCI</span>\n          </div>\n        </td>\n        <td class=\"role\">将芯片变为可部署<br>的企业、云和AI<br>基础设施</td>\n      </tr>\n\n      <tr class=\"r10\">\n        <td class=\"layer-cell\">\n          <div class=\"layer-head\"><span class=\"num\">10</span><span class=\"layer-name\">云计算 / 超大规模<br>（终端用户）</span></div>\n          <div class=\"placeholder icon-ph\">[图标: 云]</div>\n        </td>\n        <td class=\"duty\">部署大规模计算<br>基础设施并运行<br>AI应用</td>\n        <td>\n          <div class=\"logos\">\n            <span>aws</span><span>Microsoft Azure</span><span>Google Cloud</span>\n            <span>Meta</span><span>@equitydd</span><span>ORACLE</span>\n          </div>\n        </td>\n        <td class=\"role\">推动整个AI<br>产业的计算需求</td>\n      </tr>\n\n    </tbody>\n  </table>\n\n  <div class=\"keypoints\">\n    <div class=\"kp-left\">\n      <div class=\"placeholder kp-icon\">[图标: 靶心]</div>\n      <div>\n        <div class=\"kp-title\">关键要点</div>\n        <div class=\"kp-text\">\n          AI不只是芯片，而是一个完整的生态系统。<br>\n          每一层都至关重要，任何一个环节的瓶颈，<br>\n          都会影响到大规模AI的落地。\n        </div>\n      </div>\n    </div>\n    <div class=\"flow\">\n      <div class=\"flow-item\">\n        <div class=\"placeholder flow-logo\">arm</div>\n        <div class=\"flow-label\">IP</div>\n      </div>\n      <div class=\"arrow\">→</div>\n      <div class=\"flow-item\">\n        <div class=\"placeholder flow-logo\">NVIDIA</div>\n        <div class=\"flow-label\">芯片设计</div>\n      </div>\n      <div class=\"arrow\">→</div>\n      <div class=\"flow-item\">\n        <div class=\"placeholder flow-logo\">tsmc</div>\n        <div class=\"flow-label\">晶圆制造</div>\n      </div>\n      <div class=\"arrow\">→</div>\n      <div class=\"flow-item\">\n        <div class=\"placeholder flow-logo\">Amkor</div>\n        <div class=\"flow-label\">封装测试</div>\n      </div>\n      <div class=\"arrow\">→</div>\n      <div class=\"flow-item\">\n        <div class=\"placeholder flow-logo\">Micron</div>\n        <div class=\"flow-label\">内存</div>\n      </div>\n      <div class=\"arrow\">→</div>\n      <div class=\"flow-item\">\n        <div class=\"placeholder flow-logo\">MPS</div>\n        <div class=\"flow-label\">电源管理</div>\n      </div>\n      <div class=\"arrow\">→</div>\n      <div class=\"flow-item\">\n        <div class=\"placeholder flow-logo\">MARVELL</div>\n        <div class=\"flow-label\">连接网络</div>\n      </div>\n      <div class=\"arrow\">→</div>\n      <div class=\"flow-item\">\n        <div class=\"placeholder flow-logo\">SUPERMICRO</div>\n        <div class=\"flow-label\">系统集成</div>\n      </div>\n      <div class=\"arrow\">→</div>\n      <div class=\"flow-item\">\n        <div class=\"placeholder flow-logo\">aws</div>\n        <div class=\"flow-label\">云部署</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"footnote\">注：不构成任何投资建议。图中企业为各层级代表性公司，非完整名单。</div>\n\n</div>\n</body>\n</html>"
