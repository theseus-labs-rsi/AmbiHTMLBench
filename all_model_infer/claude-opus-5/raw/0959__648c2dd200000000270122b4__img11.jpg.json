le=\"width:22%\">\n    <col style=\"width:30%\">\n    <col style=\"width:48%\">\n  </colgroup>\n  <thead>\n    <tr>\n      <th></th>\n      <th>考点</th>\n      <th>记忆方式</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr class=\"odd\">\n      <td>工党领袖Tony  Blair</td>\n      <td>introduced a Scottish Parliament and a Welsh Assembly. 苏苏格兰议会和威尔士议会</td>\n      <td>工党Labour Party，<span class=\"red bold\">劳动</span>是<span class=\"blue\">理发师Tony</span></td>\n    </tr>\n    <tr class=\"even\">\n      <td class=\"bold\">总理问答 'Prime Minister's Questions'</td>\n      <td>每周一次</td>\n      <td></td>\n    </tr>\n    <tr class=\"odd\">\n      <td class=\"bold\">2012年联盟的党派</td>\n      <td>保守党<span class=\"bold\">The Conservative Party 和自由民主党The Liberal Democrats Party</span>卡梅伦</td>\n      <td>选两个最长的选项</td>\n    </tr>\n    <tr class=\"even\">\n      <td class=\"bold\">英联邦<br>Commonwealth</td>\n      <td><span class=\"bold\">Commonwealth 是association of countries国家联盟</span></td>\n      <td>选国家联盟（group、组织、social 都是不对的）</td>\n    </tr>\n    <tr class=\"odd\">\n      <td>上议院House of Lords<br>下议院House of Commons</td>\n      <td>上议院是贵族君主<br>下议院需要 The Speaker</td>\n      <td>Lord老爷就是高高在上，就是上议院</td>\n    </tr>\n  </tbody>\n</table>\n\n<!-- Table 2 -->\n<table>\n  <colgroup>\n    <col style=\"width:40%\">\n    <col style=\"width:60%\">\n  </colgroup>\n  <thead>\n    <tr>\n      <th>议员MPs= Member of Parliament</th>\n      <th>考点</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr class=\"odd\">\n      <td>MPs的责任</td>\n      <td>1.对选民负责 2.参加辩论和对新法律进行投票 Law</td>\n    </tr>\n    <tr class=\"even\">\n      <td>MP的选举制度</td>\n      <td>By-election补缺选举，死了或者辞职补缺</td>\n    </tr>\n    <tr class=\"odd\">\n      <td>MP竞选</td>\n      <td>18岁可以竞选议员MP<br>选民vote之前会有一个A poll card</td>\n    </tr>\n    <tr class=\"even\">\n      <td></td>\n      <td>1.电视和broadcast公开-这个过程叫<span class=\"red\">Hansard</span><br><span class=\"bold\">2. <span class=\"red\">Canvassing</span>拉票</span></td>\n    </tr>\n  </tbody>\n</table>\n\n<!-- Table 3 -->\n<table>\n  <colgroup>\n    <col style=\"width:40%\">\n    <col style=\"width:60%\">\n  </colgroup>\n  <thead>\n    <tr>\n      <th>议员MPs= Member of Parliament</th>\n      <th>考点</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr class=\"odd\">\n      <td class=\"bold\">MPs的责任</td>\n      <td>1.对选民负责 2.<span class=\"blue\">新法律的投票辩论Law</span></td>\n    </tr>\n    <tr class=\"even\">\n      <td class=\"bold\">MP的选举制度</td>\n      <td><span class=\"bold\">By-election</span>补缺选举，死了或者辞职补缺</td>\n    </tr>\n    <tr class=\"odd\">\n      <td class=\"bold\">MP竞选</td>\n      <td class=\"bold\">18岁可以竞选议员MP</td>\n    </tr>\n  </tbody>\n</table>\n\n<!-- Table 4 -->\n<table>\n  <colgroup>\n    <col style=\"width:31%\">\n    <col style=\"width:18%\">\n    <col style=\"width:13%\">\n    <col style=\"width:38%\">\n  </colgroup>\n  <thead>\n    <tr>\n      <th></th>\n      <th>Home Secretary<br>内政部长</th>\n      <th>Parliament<br>国会</th>\n      <th>The devolved administrations分权行政部门=其他几个议会</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr class=\"odd\">\n      <td>犯罪Crime</td>\n      <td><span class=\"check\">✔</span></td>\n      <td></td>\n      <td></td>\n    </tr>\n    <tr class=\"even\">\n      <td>警察Policing</td>\n      <td><span class=\"check\">✔</span></td>\n      <td></td>\n      <td></td>\n    </tr>\n    <tr class=\"odd\">\n      <td>移民Immigration</td>\n      <td><span class=\"check\">✔</span></td>\n      <td><span class=\"check\">✔</span></td>\n      <td></td>\n    </tr>\n    <tr class=\"even\">\n      <td>国防Defence</td>\n      <td></td>\n      <td><span class=\"check\">✔</span></td>\n      <td></td>\n    </tr>\n    <tr class=\"odd\">\n      <td>经济</td>\n      <td></td>\n      <td></td>\n      <td>即其他议会（苏格兰、威尔士、北爱）</td>\n    </tr>\n    <tr class=\"even\">\n      <td>教育</td>\n      <td></td>\n      <td></td>\n      <td>即其他议会（苏格兰、威尔士、北爱）</td>\n    </tr>\n    <tr class=\"odd\">\n      <td>农业、环境、卫生、社会服务</td>\n      <td></td>\n      <td></td>\n      <td>即其他议会（苏格兰[illegi