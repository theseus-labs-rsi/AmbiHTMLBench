        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Mozilla 欢迎页面 - 学习 Web 开发 | MDN</title>\n<script>\nwindow.MathJax = { tex: { inlineMath: [['$','$']], displayMath: [['$$','$$']] } };\n</script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    font-family: \"Helvetica Neue\", Arial, \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif;\n    color: #1b1b1b;\n    font-size: 16px;\n    line-height: 1.6;\n    background: #fff;\n  }\n  a { color: #0069c2; }\n\n  /* ------- Top ad banner ------- */\n  .ad-banner {\n    display: flex;\n    align-items: center;\n    gap: 24px;\n    padding: 14px 24px 10px;\n    border-bottom: 1px solid #e0e0dc;\n    position: relative;\n    min-height: 58px;\n  }\n  .ad-logo { font-weight: 700; font-size: 13px; letter-spacing: .2px; }\n  .ad-logo .leaf { color: #00684a; }\n  .ad-text { font-size: 14px; }\n  .ad-cta {\n    background: #00684a; color: #fff; border-radius: 6px;\n    padding: 8px 18px; font-size: 14.5px; font-weight: 500;\n    text-decoration: none;\n  }\n  .ad-flag {\n    position: absolute; top: 6px; right: 24px;\n    border: 1px solid #b3b3b3; border-radius: 3px;\n    font-size: 10px; padding: 1px 6px; color: #4d4d4d;\n  }\n  .ad-optout {\n    position: absolute; top: 30px; right: 24px;\n    font-size: 12px; color: #0069c2; text-decoration: underline;\n  }\n\n  /* ------- Main header ------- */\n  header.mdn-header {\n    display: flex; align-items: center;\n    padding: 16px 24px;\n    border-bottom: 1px solid #e0e0dc;\n    gap: 20px;\n  }\n  .logo {\n    font-weight: 800; font-size: 26px; letter-spacing: -1px;\n    display: inline-flex; align-items: center; gap: 4px;\n  }\n  .logo .m { font-size: 30px; font-style: italic; }\n  nav.mdn-nav {\n    display: flex; gap: 26px; margin: 0 auto;\n    font-size: 16.5px;\n  }\n  nav.mdn-nav a { color: #1b1b1b; text-decoration: none; }\n  nav.mdn-nav .caret { font-size: 11px; color: #6b6b6b; }\n  .header-right { display: flex; align-items: center; gap: 18px; }\n  .searchbox {\n    display: flex; align-items: center; justify-content: space-between;\n    width: 130px; border: 1px solid #c9c9c4; border-radius: 20px;\n    padding: 6px 12px; color: #6b6b6b; font-size: 14px;\n  }\n\n  /* ------- Breadcrumb bar ------- */\n  .crumb-bar {\n    display: flex; align-items: center;\n    padding: 10px 24px;\n    border-bottom: 1px solid #e0e0dc;\n    font-size: 15px;\n  }\n  .crumbs { display: flex; gap: 8px; align-items: center; }\n  .crumbs a { text-decoration: none; }\n  .crumbs .sep { color: #6b6b6b; font-size: 12px; }\n  .crumbs .current { color: #1b1b1b; }\n  .crumb-tools { margin-left: auto; display: flex; gap: 24px; font-size: 15px; }\n  .crumb-tools span { color: #1b1b1b; }\n\n  /* ------- Page layout: 3 columns ------- */\n  .page {\n    display: flex;\n    align-items: flex-start;\n  }\n  aside.sidebar {\n    width: 305px;\n    flex: 0 0 305px;\n    padding: 14px 20px 40px 14px;\n    border-right: 1px solid #e0e0dc;\n    font-size: 16px;\n  }\n  .filter {\n    display: flex; align-items: center; gap: 8px;\n    border: 1px solid #c9c9c4; border-radius: 20px;\n    padding: 8px 14px; color: #6b6b6b; margin-bottom: 8px;\n    font-size: 15px;\n  }\n  .sidebar ul { list-style: none; margin: 0; padding: 0; }\n  .sidebar li { padding: 6px 12px; }\n  .sidebar li a { color: #1b1b1b; text-decoration: none; }\n  .sidebar .muted { color: #6b6b6b; font-size: 13px; }\n  .sidebar li.active {\n    background: #fdf2e8;\n    border-left: 3px solid #f2994a;\n    padding-left: 12px;\n  }\n  .sidebar li.faded { color: #b3b3b3; }\n  .sidebar .grp { padding-left: 0; }\n  .sidebar .grp::before { content: \"› \"; color: #6b6b6b; }\n  .sidebar .section-title { font-weight: 700; margin: 18px 0 4px; padding-left: 