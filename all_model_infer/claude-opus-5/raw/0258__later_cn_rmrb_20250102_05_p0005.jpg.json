px;\n  }\n  .v-lead {\n    writing-mode: vertical-rl;\n    font-size: 11px;\n    line-height: 1.9;\n    height: 120px;\n    text-align: justify;\n  }\n  .v-sign {\n    writing-mode: vertical-rl;\n    font-size: 11px;\n    height: 60px;\n    align-self: flex-end;\n  }\n\n  /* ---------- placeholders ---------- */\n  .placeholder {\n    background: #e9e9e6;\n    border: 1px dashed #999;\n    color: #555;\n    font-size: 12px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n  }\n  .photo-caption { font-size: 9.5px; margin-top: 4px; }\n  .photo-credit { font-size: 9.5px; text-align: right; margin-top: 2px; }\n\n  /* ---------- 现场评论 logo ---------- */\n  .xianchang {\n    width: 165px;\n    height: 62px;\n    margin: 14px 0 10px auto;\n    background: #fff;\n    border: 1px solid #ddd;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-family: \"STKaiti\", \"KaiTi\", serif;\n    font-weight: 700;\n    font-size: 22px;\n    color: #b02a1e;\n    letter-spacing: 2px;\n  }\n\n  .headline-sub {\n    font-family: \"STHeiti\", \"Heiti SC\", \"Microsoft YaHei\", sans-serif;\n    font-weight: 800;\n    font-size: 19px;\n    text-align: center;\n    margin: 8px 0 2px;\n  }\n  .headline-mid {\n    font-family: \"STHeiti\", \"Heiti SC\", \"Microsoft YaHei\", sans-serif;\n    font-weight: 800;\n    font-size: 30px;\n    margin: 8px 0 6px;\n  }\n  .headline-big2 {\n    font-family: \"STHeiti\", \"Heiti SC\", \"Microsoft YaHei\", sans-serif;\n    font-weight: 800;\n    font-size: 32px;\n    text-align: center;\n    margin: 8px 0 12px;\n    letter-spacing: 1px;\n  }\n  .sub-author { font-size: 10px; text-align: center; margin-bottom: 6px; }\n\n  /* ---------- editor note box ---------- */\n  .editorbox {\n    border: 1px solid #b02a1e;\n    padding: 8px;\n    font-size: 11px;\n    line-height: 1.8;\n    background: #fbf7f2;\n    margin-bottom: 10px;\n  }\n  .editorbox .sign { text-align: right; disp