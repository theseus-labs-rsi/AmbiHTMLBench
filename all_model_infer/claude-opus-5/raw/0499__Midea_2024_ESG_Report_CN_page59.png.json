ight:2.05;\n    color:#4a4a4a;\n  }\n\n  /* ---------- left diagram panel ---------- */\n  .diagram{\n    background:var(--panel-gray);\n    margin:34px -55px 0 -70px;\n    padding:34px 40px 46px 40px;\n  }\n  .diagram-title{\n    text-align:center;\n    color:var(--orange);\n    font-weight:600;\n    font-size:16px;\n    margin-bottom:26px;\n  }\n  .top-bar{\n    background:var(--amber);\n    color:#fff;\n    text-align:center;\n    font-weight:600;\n    font-size:16px;\n    border-radius:6px;\n    padding:12px 0;\n    width:60%;\n    margin:0 auto 0 auto;\n  }\n  .connector{\n    height:36px;\n    border-left:1px solid var(--amber);\n    width:0;\n    margin:0 auto;\n  }\n  .lines-row{\n    display:flex;\n    gap:22px;\n  }\n  .lane{flex:1;}\n  .lane-head{\n    background:var(--amber);\n    color:#fff;\n    text-align:center;\n    font-size:14.5px;\n    border-radius:4px;\n    padding:9px 0;\n  }\n  .lane-stem{\n    height:30px;\n    border-left:1px solid var(--amber);\n    width:0;\n    margin:0 auto;\n    position:relative;\n  }\n  .lane-stem:after{\n    content:\"\";\n    position:absolute;\n    left:-3.5px;bottom:-3px;\n    width:7px;height:7px;\n    border-radius:50%;\n    background:var(--amber);\n  }\n  .card{\n    border:1px solid var(--amber);\n    border-radius:10px;\n    background:#fff;\n    padding:22px 16px 26px 16px;\n    text-align:center;\n    min-height:280px;\n  }\n  .placeholder{\n    border:1px dashed #d9c88a;\n    background:#fffdf5;\n    color:#b39a4a;\n    font-size:11px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    text-align:center;\n    margin:0 auto 14px auto;\n  }\n  .icon-ph{width:90px;height:72px;}\n  .card-title{\n    color:var(--orange);\n    font-weight:600;\n    font-size:16px;\n    margin-bottom:12px;\n  }\n  .card-text{\n    font-size:13.5px;\n    line-height:1.95;\n    color:#4a4a4a;\n  }\n\n  /* ---------- right column ---------- */\n  .callout{\n    background:var(--amber-lighter);\n    border-radius:10px;\n    padding:34px 38px 26px 38px;\n    display:flex;\n    gap:30px;\n    align-items:flex-start;\n  }\n  .callout .txt{flex:1;font-size:14.5px;line-height:2.1;color:#4a4a4a;}\n  .cert-ph{\n    width:190px;height:270px;\n    border:1px solid #ddd;\n    background:#fff;\n    color:#999;\n    font-size:11px;\n  }\n  .cert-cap{\n    text-align:right;\n    font-size:13.5px;\n    color:#4a4a4a;\n    margin-top:14px;\n  }\n  .cert-cap .dot{\n    color:var(--amber);\n    font-size:16px;\n    vertical-align:middle;\n    margin-right:6px;\n  }\n\n  .mech-row{\n    display:flex;\n    align-items:stretch;\n    gap:0;\n    margin-bottom:22px;\n  }\n  .mech-label{\n    width:200px;\n    background:var(--amber-light);\n    border-radius:8px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    text-align:center;\n    font-size:15px;\n    color:#4a4a4a;\n    padding:22px 14px;\n    line-height:1.9;\n  }\n  .arrow{\n    width:52px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    color:var(--amber-light);\n    font-size:20px;\n  }\n  .mech-body{\n    flex:1;\n    border:1px solid var(--amber);\n    border-radius:8px;\n    padding:20px 24px;\n    font-size:14.5px;\n    line-height:2.05;\n    color:#4a4a4a;\n    display:flex;\n    align-items:center;\n  }\n\n  .folio{\n    margin-top:auto;\n    padding-top:60px;\n    font-size:13px;\n    color:#8a8a8a;\n  }\n  .folio.right{text-align:right;}\n</style>\n</head>\n<body>\n<div class=\"spread\">\n\n  <!-- ============ LEFT PAGE (115) ============ -->\n  <section class=\"page page-left\">\n    <div class=\"runhead\">2024 · 美的集团ESG报告</div>\n\n    <h1 class=\"title\">合规运营保障者</h1>\n\n    <p class=\"body\">\n      合法合规经营是企业长远发展的根本保障，同时也是企业迈向国际化的重要必修课。美的集团始终将合规与稳健视为经营底线，通过从组织架构、制度体系、运行机制到企业文化等多方面着手，逐步构建起覆盖全方位的合规管理体系。\n    </p>\n\n    <h2 class=\"sub\">管理架构</h2>\n\n    <p class=\"body\">\n      依托于三道防线的建设，我们不断完善相关机制，大力推进合规风险的识别、评估与防控工作落地。\n    </p>\n\n    <div class=\"diagram\">\n      <div class=\"diagram-title\">合规管理体系</div>\n\n      <div class=\"top-bar\">美的集团合规管理三道防线</div>\n      <div class=\"connector\"></div>\n\n      <div class=\"lines-row\">\n        <div class=\"lane\">\n          <div class=\"lane-head\">第一道防线</div>\n          <div class=\"lane-stem\"></div>\n          <div class=\"card\">\n            <div class=\"placeholder icon-ph\">[图标：管理者与员工，居中]</div>\n            <div class=\"card-title\">管理者、员工</div>\n            <div class=\"card-text\">合规风险所有者、管理者，负责本业务部门合规风险识别、评估、处置等</div>\n          </div>\n        </div>\n\n        <div class=\"lane\">\n          <div class=\"lane-head\">第二道防线</div>\n          <div class=\"lane-stem\"></div>\n          <div class=\"card\">\n            <div class=\"placeholder icon-ph\">[图标：合规专门组织，居中]</div>\n            <div class=\"card-title\">合规专门组织</div>\n            <div class=\"card-text\">牵头统筹协调、组织推动、督促落实</div>\n          </div>\n        </div>\n\n        <div class=\"lane\">\n          <div class=\"lane-head\">第三道防线</div>\n          <div class=\"lane-stem\"></div>\n          <div class=\"card\">\n            <div class=\"placeholder icon-ph\">[图标：审计稽查，居中]</div>\n            <div class=\"card-title\">审计、调查、稽查</div>\n            <div class=\"card-text\">监督与持续改进</div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"folio\">115</div>\n  </section>\n\n  <!-- ============ RIGHT PAGE (116) ============ -->\n  <section class=\"page page-right\">\n    <div class=\"nav\">\n      <span>关于本报告</span>\n      <span>走进美的</span>\n      <span>可持续发展治理</span>\n      <span>守护蓝色星球</span>\n      <span>构建和谐社区</span>\n      <span>践行科技尽善</span>\n      <span class=\"active\">共创繁荣生态</span>\n      <span>附录</span>\n    </div>\n\n    <div class=\"callout\">\n      <div class=\"txt\">\n        为持续完善合规体系建设和不断提升合规管理能力，美的集团由法务大合规中心和中国区域法务团队统筹，信息安全部门协助，成功获得ISO 37301:2021合规管理体系认证。该认证彰显了美的集团在合规管理方面的成熟度和专业水准，同时也为美的集团业务的持续稳健发展提供了坚实的基础。\n      </div>\n      <div class=\"placeholder cert-ph\">[图片：ISO 37301 认证证书扫描件（bsi. Certificate of Registration），右侧]</div>\n    </div>\n    <div class=\"cert-cap\"><span class=\"dot\">●</span>ISO 37301：2021合规管理体系认证</div>\n\n    <h2 class=\"sub\">管理制度与运行机制</h2>\n\n    <p class=\"body\">为强化合规管理，美的集团：</p>\n\n    <div class=\"mech-row\">\n      <div class=\"mech-label\">建立动态风险<br>防控机制</div>\n      <div class=\"arrow\">▶</div>\n      <div class=\"mech-body\">定期开展风险自评，结合法律研究与风险预警体系，构建“信息收集 - 风险标注 - 政策解读 - 预警发布 - 升级推送 - 反馈处理”闭环机制。</div>\n    </div>\n\n    <div class=\"mech-row\">\n      <div class=\"mech-label\">推进数字化合规建设</div>\n      <div class=\"arrow\">▶</div>\n      <div class=\"mech-body\">开发合规数字化系统，集成普适性服务功能与定制化场景解决方案，实现合规要求与业务流程深度融合。</div>\n    </div>\n\n    <div class=\"mech-row\">\n      <div class=\"mech-label\">深化重点领域合规</div>\n      <div class=\"arrow\">▶</div>\n      <div class=\"mech-body\">2024 年持续强化贸易合规与数据合规建设，进一步夯实管理基础，确保全球监管适应性。</div>\n    </div>\n\n    <div class=\"folio right\">116</div>\n  </section>\n\n</div>\n</body>\n</html>"
