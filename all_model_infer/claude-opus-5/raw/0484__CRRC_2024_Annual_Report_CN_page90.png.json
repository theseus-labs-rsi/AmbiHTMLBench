        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>中国中车股份有限公司2024年年度报告 - 合并资产负债表</title>\n<script>\nwindow.MathJax = {\n  tex: {inlineMath: [['$', '$']], displayMath: [['$$', '$$']]}\n};\n</script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  body {\n    font-family: \"SimSun\", \"Songti SC\", serif;\n    margin: 0;\n    padding: 40px 60px;\n    background: #fff;\n    color: #000;\n    font-size: 15px;\n  }\n  .page {\n    max-width: 900px;\n    margin: 0 auto;\n  }\n  .header {\n    text-align: center;\n    padding-bottom: 6px;\n    border-bottom: 1.5px solid #000;\n    font-size: 15px;\n    margin-bottom: 40px;\n  }\n  h1.section {\n    font-size: 18px;\n    font-weight: bold;\n    margin: 0 0 34px 20px;\n  }\n  h2.doc-title {\n    text-align: center;\n    font-size: 17px;\n    font-weight: bold;\n    margin: 0 0 26px 0;\n  }\n  .date-line {\n    text-align: center;\n    font-size: 15px;\n    margin-bottom: 18px;\n  }\n  .unit-line {\n    text-align: left;\n    font-size: 15px;\n    margin-bottom: 4px;\n  }\n  .currency-line {\n    text-align: right;\n    font-size: 15px;\n    margin-bottom: 6px;\n    padding-right: 20px;\n  }\n  table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 14.5px;\n  }\n  table, th, td {\n    border: 1px solid #000;\n  }\n  th, td {\n    padding: 4px 6px;\n    line-height: 1.5;\n  }\n  th {\n    text-align: center;\n    font-weight: normal;\n  }\n  col.item { width: 33%; }\n  col.note { width: 13%; }\n  col.amt { width: 27%; }\n  td.item { text-align: left; padding-left: 8px; }\n  td.item-indent { text-align: left; padding-left: 34px; }\n  td.item-indent2 { text-align: left; padding-left: 58px; }\n  td.note { text-align: center; }\n  td.amt { text-align: right; padding-right: 20px; }\n  td.bold { font-weight: bold; }\n  .footer {\n    text-align: center;\n    font-size: 15px;\n    margin-top: 260px;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"header\">中国中车股份有限公司2024年年度报告</div>\n\n  <h1 class=\"section\">二、财务报表</h1>\n\n  <h2 class=\"doc-title\">合并资产负债表</h2>\n\n  <div class=\"date-line\">2024 年 12 月 31 日</div>\n\n  <div class=\"unit-line\">编制单位:中国中车股份有限公司</div>\n\n  <div class=\"currency-line\">单位：千元&nbsp;&nbsp;&nbsp;币种：人民币</div>\n\n  <table>\n    <colgroup>\n      <col class=\"item\">\n      <col class=\"note\">\n      <col class=\"amt\">\n      <col class=\"amt\">\n    </colgroup>\n    <thead>\n      <tr>\n        <th>项目</th>\n        <th>附注</th>\n        <th>2024 年 12 月 31 日</th>\n        <th>2023 年 12 月 31 日</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr><td class=\"item bold\" colspan=\"4\">流动资产：</td></tr>\n      <tr><td class=\"item-indent\">货币资金</td><td class=\"note\">七、1</td><td class=\"amt\">67,512,492</td><td class=\"amt\">55,929,833</td></tr>\n      <tr><td class=\"item-indent\">交易性金融资产</td><td class=\"note\">七、2</td><td class=\"amt\">8,222,272</td><td class=\"amt\">8,932,728</td></tr>\n      <tr><td class=\"item-indent\">应收票据</td><td class=\"note\">七、3</td><td class=\"amt\">11,392,953</td><td class=\"amt\">11,843,906</td></tr>\n      <tr><td class=\"item-indent\">应收账款</td><td class=\"note\">七、4</td><td class=\"amt\">110,844,449</td><td class=\"amt\">105,705,827</td></tr>\n      <tr><td class=\"item-indent\">应收款项融资</td><td class=\"note\">七、6</td><td class=\"amt\">8,353,838</td><td class=\"amt\">11,498,099</td></tr>\n      <tr><td class=\"item-indent\">预付款项</td><td class=\"note\">七、7</td><td class=\"amt\">8,670,885</td><td class=\"amt\">8,097,483</td></tr>\n      <tr><td class=\"item-indent\">其他应收款</td><td class=\"note\">七、8</td><td class=\"amt\">2,336,602</td><td class=\"amt\">2,232,535</td></tr>\n      <tr><td class=\"item-indent\">存货</td><td class=\"note\">七、9</td><td class=\"amt\">78,946,885</td><td class=\"amt\">66,848,740</t