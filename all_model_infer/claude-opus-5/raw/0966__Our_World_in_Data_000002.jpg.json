        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Our World in Data — Research and data to make progress against the world's largest problems</title>\n<script>\nwindow.MathJax = { tex: { inlineMath: [['$','$']], displayMath: [['$$','$$']] } };\n</script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    font-family: \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n    color: #1d3d63;\n    background: #fff;\n    font-size: 14px;\n  }\n  a { color: #1d3d63; text-decoration: none; }\n\n  /* ---------- Top nav ---------- */\n  .topbar {\n    background: #002147;\n    border-bottom: 3px solid #d0021b;\n    display: flex;\n    align-items: center;\n    padding: 0 24px;\n    height: 72px;\n    color: #fff;\n  }\n  .logo {\n    color: #fff;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 19px;\n    line-height: 1.15;\n    font-weight: bold;\n    margin-right: 34px;\n  }\n  .topnav {\n    display: flex;\n    align-items: center;\n    gap: 26px;\n    font-size: 14.5px;\n    color: #fff;\n  }\n  .topnav span { color: #fff; }\n  .topbar-right {\n    margin-left: auto;\n    display: flex;\n    gap: 10px;\n    align-items: center;\n  }\n  .btn-outline {\n    border: 1px solid #fff;\n    color: #fff;\n    padding: 9px 26px;\n    font-size: 14px;\n  }\n  .btn-donate {\n    background: #d0021b;\n    color: #fff;\n    padding: 10px 26px;\n    font-size: 14px;\n  }\n\n  /* ---------- Popular pages ---------- */\n  .popular {\n    background: #ebeef2;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    padding: 12px 24px 12px 76px;\n    font-size: 12px;\n  }\n  .popular .label {\n    font-weight: bold;\n    letter-spacing: .06em;\n    color: #577291;\n    margin-right: 8px;\n  }\n  .pill {