        "content": "<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>祥除帖 昨表帖 楷書</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$','$']], displayMath: [['$$','$$']] }\n};\n</script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  body {\n    margin: 0;\n    background: #cfcabb;\n    font-family: \"Kaiti SC\", \"KaiTi\", \"STKaiti\", \"Songti SC\", serif;\n  }\n  .page {\n    position: relative;\n    width: 540px;\n    height: 1160px;\n    margin: 0 auto;\n    background: #cdc6b4;\n    box-sizing: border-box;\n    padding: 60px 30px 60px 30px;\n  }\n  .paper {\n    position: relative;\n    width: 100%;\n    height: 100%;\n    background: #d3ccba;\n  }\n  /* 竖排右起 */\n  .columns {\n    position: absolute;\n    top: 20px;\n    right: 10px;\n    height: 1000px;\n    display: flex;\n    flex-direction: row;      /* 从右到左依靠 row-reverse 的排列 */\n    flex-direction: row;\n    align-items: flex-start;\n  }\n  .col {\n    writing-mode: vertical-rl;\n    text-orientation: upright;\n    font-size: 27px;\n    line-height: 1.45;\n    letter-spacing: 4px;\n    color: #16120e;\n    margin-left: 4px;\n    height: 1000px;\n  }\n  .title-col {\n    font-size: 20px;\n    letter-spacing: 3px;\n    height: 200px;\n    margin-left: 14px;\n    padding-top: 60px;\n  }\n  .title-col .gap { letter-spacing: 3px; }\n  .col-short { height: 780px; }\n  .col-sig {\n    font-size: 24px;\n    height: 700px;\n    padding-top: 180px;\n  }\n  .seals {\n    position: absolute;\n    left: 40px;\n    top: 700px;\n    width: 40px;\n  }\n  .seal {\n    width: 26px;\n    height: 26px;\n    border: 2px solid #a83a2c;\n    color: #a83a2c;\n    font-size: 9px;\n    line-height: 1;\n    text-align: center;\n    margin-bottom: 14px;\n    box-sizing: border-box;\n    padding: 3px 1px;\n    writing-mode: vertical-rl;\n  }\n  .seal.big { height: 34px; }\n  .placeholder {\n    border: 1px dashed #8a7f6a;\n    color: #5a5145;\n    font-size: 10px;\n    text-align: center;\n    box-sizing: border-box;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n <div class=\"paper\">\n\n  <div class=\"columns\">\n\n    <!-- 第1行(最右) -->\n    <div class=\"col\">臣廙言臣祥除以復五日窮思永遠肝心寸截甘雪應時嚴寒奉被</div>\n\n    <!-- 第2行 -->\n    <div class=\"col\">手詔伏承聖體御膳勝常以慰下情臣故患匈滿乞氣上頓之匆匆慈</div>\n\n    <!-- 第3行 -->\n    <div class=\"col\">恩垂愍每見慰問感戴屏營不勝銜遇謹表陳聞臣廙誠惶頓首</div>\n\n    <!-- 第4行 -->\n    <div class=\"col\">頓首死罪死罪　臣廙言昨表不宣奉賜手詔伏承聖體勝常以</div>\n\n    <!-- 第5行 -->\n    <div class=\"col\">慰下情不審宿昔復何如承鄭夫人乃尔委頓今復增損伏惟哀[?]</div>\n\n    <!-- 第6行 -->\n    <div class=\"col col-short\">愍存益勞聖心謹附承動静臣廙言</div>\n\n    <!-- 第7行 落款 -->\n    <div class=\"col col-sig\">歲在癸卯眷耀陽書於未央雲舍</div>\n\n  </div>\n\n  <!-- 標題(位於最右上方,獨立小字) -->\n  <div class=\"title-col col\" style=\"position:absolute; top:20px; right:-0px; display:none;\"></div>\n\n  <!-- 印章 -->\n  <div class=\"seals\">\n    <div class=\"seal\">[印]</div>\n    <div class=\"seal big\">[印]</div>\n  </div>\n\n </div>\n</div>\n\n<!-- 標題以絕對定位置於畫面右側上方 -->\n<div style=\"display:none\"></div>\n\n<script>\n/* 將標題插入到 columns 最右側(圖中位於最右列左側偏上位置) */\n(function(){\n  var cols = document.querySelector('.columns');\n  var t = document.createElement('div');\n  t.className = 'col title-col';\n  t.textContent = '祥除帖　昨表帖';\n  cols.appendChild(t);\n  /* 圖中標題在最右邊,故移到首位 */\n  cols.insertBefore(t, cols.firstChild);\n  /* 實際圖像:標題在最右列的右側,故置於 flex 起點 */\n})();\n</script>\n</body>\n</html>"
