: 1px solid #bbb;\n    background: #ffffff;\n    padding: 6px 6px 8px;\n    min-height: 150px;\n  }\n  .card .type {\n    text-align: center;\n    font-size: 14px;\n    font-weight: 700;\n    margin-bottom: 2px;\n  }\n  .card .kw {\n    text-align: center;\n    font-size: 17px;\n    font-weight: 700;\n    margin-bottom: 6px;\n  }\n  .card ol {\n    margin: 0;\n    padding-left: 18px;\n    font-size: 11.5px;\n    line-height: 1.5;\n  }\n  .c1 { border-color: #e0a3a3; }\n  .c1 .type, .c1 .kw { color: #c0392b; }\n  .c2 { border-color: #a8b8dd; }\n  .c2 .type, .c2 .kw { color: #2b52a3; }\n  .c3 { border-color: #a8ccb0; }\n  .c3 .type, .c3 .kw { color: #1e7a3c; }\n  .c4 { border-color: #e0a3a3; }\n  .c4 .type, .c4 .kw { color: #c0392b; }\n  .hl-red { color: #c0392b; }\n  .hl-blue { color: #2b52a3; }\n  .hl-green { color: #1e7a3c; }\n\n  /* 中间三段式绿色标题条 */\n  .three-head {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    background: #cfe6b8;\n    border: 1px solid #9dc47a;\n    border-bottom: none;\n    text-align: center;\n    font-size: 15px;\n    font-weight: 700;\n    color: #2f5d1f;\n    padding: 5px 0;\n  }\n  .mid-body {\n    border: 1px solid #9dc47a;\n    background: #e9f4dd;\n    padding: 8px 10px 10px;\n    margin-bottom: 12px;\n  }\n  .mid-body ul {\n    margin: 0;\n    padding-left: 0;\n    list-style: none;\n    font-size: 12.5px;\n    line-height: 1.9;\n    text-align: center;\n  }\n  .mid-body ul li::before {\n    content: \"•  \";\n  }\n\n  /* 四种回复方式 */\n  .reply-cols {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 6px;\n    margin-bottom: 12px;\n  }\n  .rcard {\n    border: 1px solid #bbb;\n    background: #fff;\n    padding: 6px;\n    min-height: 155px;\n  }\n  .rcard .rtitle {\n    text-align: center;\n    font-size: 13px;\n    font-weight: 700;\n    line-height: 1.35;\n  }\n  .rcard .rcn {\n    text-align: center;\n    font-size: 16px;\n    font-weight: 700;\n    margin: 4px 0 8px;\n  }\n  .rcard ul {\n   