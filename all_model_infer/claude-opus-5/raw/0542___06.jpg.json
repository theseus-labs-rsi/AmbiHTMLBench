        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>软考高项 各子过程可用工具与技术大全</title>\n<script src=\"https://polyfill.io/v3/polyfill.min.js?features=es6\"></script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    background: #fffdf5;\n    font-family: \"Microsoft YaHei\", \"PingFang SC\", \"Heiti SC\", sans-serif;\n    color: #333;\n  }\n  .page {\n    width: 1024px;\n    margin: 0 auto;\n    padding: 8px 12px 16px;\n    background: #fffdf5;\n  }\n\n  /* ---------- Header ---------- */\n  .header {\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 78px;\n    margin-bottom: 4px;\n  }\n  .badge {\n    position: absolute;\n    left: 4px;\n    top: 0;\n    width: 118px;\n    height: 92px;\n    font-size: 10px;\n    color: #b06a00;\n    border: 1px dashed #f0c48a;\n    border-radius: 8px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    background: #fff8ec;\n  }\n  .main-title {\n    text-align: center;\n    line-height: 1;\n  }\n  .main-title .t1 {\n    font-size: 46px;\n    font-weight: 900;\n    color: #e8462a;\n    letter-spacing: 1px;\n  }\n  .main-title .t2 {\n    font-size: 44px;\n    font-weight: 900;\n    color: #1a2340;\n    letter-spacing: 1px;\n  }\n  .header-right {\n    position: absolute;\n    right: 4px;\n    top: 4px;\n    width: 130px;\n    height: 88px;\n    font-size: 10px;\n    color: #b06a00;\n    border: 1px dashed #f0c48a;\n    border-radius: 8px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    background: #fff8ec;\n  }\n  .subtitle-row {\n    display: flex;\n    justify-content: center;\n    align-items: flex-start;\n    gap: 10px;\n    margin-bottom: 10px;\n  }\n  .subtitle {\n    border: 2px solid #f0a53c;\n    background: #fff7e8;\n    border-radius: 8px;\n    padding: 7px 26px;\n    font-size: 16px;\n    font-weight: bold;\n    color: #444;\n  }\n  .tip-bubble {\n    position: absolute;\n    right: 140px;\n    top: 62px;\n    font-size: 15px;\n    font-weight: bold;\n    color: #333;\n    line-height: 1.35;\n    text-align: center;\n  }\n\n  /* ---------- Grid rows ---------- */\n  .row {\n    display: flex;\n    gap: 10px;\n    align-items: flex-start;\n    margin-bottom: 10px;\n  }\n\n  .card {\n    border-radius: 10px;\n    padding: 8px;\n    overflow: hidden;\n  }\n  .card h2 {\n    margin: 2px 0 8px;\n    text-align: center;\n    font-size: 20px;\n    font-weight: 900;\n    letter-spacing: 1px;\n  }\n  .card h2 .ico { font-size: 17px; }\n\n  table.k {\n    width: 100%;\n    border-collapse: collapse;\n    background: #fff;\n    font-size: 11.5px;\n    line-height: 1.45;\n  }\n  table.k th, table.k td {\n    border: 1px solid #d9d9d9;\n    padding: 4px 6px;\n    vertical-align: middle;\n  }\n  table.k thead th {\n    font-size: 12.5px;\n    font-weight: bold;\n    background: #f7f7f7;\n    text-align: center;\n  }\n  table.k td.sub {\n    width: 27%;\n    white-space: nowrap;\n  }\n\n  /* card colour themes */\n  .c-blue   { background:#dbe8fb; } .c-blue h2   { color:#1b4f9c; } .c-blue thead th   { background:#e8f0fd; }\n  .c-green  { background:#d9f0e3; } .c-green h2  { color:#1d7a4c; } .c-green thead th  { background:#e9f8ef; }\n  .c-orange { background:#fde5cf; } .c-orange h2 { color:#c96a11; } .c-orange thead th { background:#fdf0e2; }\n  .c-purple { background:#e6dcf5; } .c-purple h2 { color:#6a3fa0; } .c-purple thead th { background:#f1eaf9; }\n  .c-pink   { background:#fbdde6; } .c-pink h2   { color:#c2385f; } .c-pink thead th   { background:#fdedf2; }\n  .c-teal   { background:#d5eeee; } .c-teal h2   { color:#12797a; } .c-teal thead th   { background:#e7f6f6; }\n  .c-yellow { background:#fdeccc; } .c-yellow h2 { color:#c78a10; } .c-yellow thead th { background:#fdf5e3; }\n  .c-red    { background:#fcdcdc; } .c-red h2    { color:#cc3232; } .c-red thead th    { background:#fdeded; }\n  .c-lblue  { background:#dcecfb; } .c-lblue h2  { color:#2160a8; } .c-lblue thead th  { background:#ecf4fd; }\n\n  /* ---------- communication methods box ---------- */\n  .comm-box {\n    margin-top: 10px;\n    background: #fff;\n    border: 2px dashed #f0a53c;\n    border-radius: 10px;\n    padding: 8px 10px;\n    font-size: 12.5px;\n  }\n  .comm-box .ttl {\n    color: #e07a1f;\n    font-weight: bold;\n    font-size: 14px;\n    margin-bottom: 6px;\n  }\n  .comm-box .item {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    margin: 6px 0;\n  }\n  .comm-box .item b { color: #2a72c9; }\n  .comm-box .item .g { color: #3aa06a; font-weight: bold; }\n  .comm-box .item .r { color: #d5453f; font-weight: bold; }\n  .ph-icon {\n    display: inline-block;\n    width: 22px; height: 18px;\n    border: 1px dashed #bbb;\n    border-radius: 4px;\n    font-size: 7px;\n    color: #999;\n    text-align: center;\n    line-height: 18px;\n    flex: 0 0 auto;\n  }\n\n  /* ---------- risk checklist ---------- */\n  .risk-note {\n    margin-top: 8px;\n    background: #fff;\n    border: 2px dashed #f08c2e;\n    border-radius: 10px;\n    padding: 8px 10px 8px 34px;\n    position: relative;\n    font-size: 11.5px;\n    line-height: 1.65;\n  }\n  .risk-note .star {\n    position: absolute; left: 6px; top: 8px;\n    width: 22px; height: 22px;\n    border: 1px dashed #eec06a; border-radius: 50%;\n    font-size: 7px; color: #c99a2e; text-align: center; line-height: 22px;\n  }\n  .risk-note .hd { color: #e0431f; font-weight: bold; font-size: 12.5px; }\n  .risk-note b.lbl { color: #2a72c9; }\n\n  /* ---------- procurement 3 elements ---------- */\n  .proc-box {\n    margin-top: 10px;\n    background: #fff;\n    border: 2px dashed #4f9fe0;\n    border-radius: 10px;\n    padding: 8px 10px;\n    text-align: center;\n  }\n  .proc-box .ttl { color: #1f68b5; font-weight: bold; font-size: 13.5px; margin-bottom: 6px; text-align: left;}\n  .proc-box .chips { font-size: 15px; font-weight: bold; letter-spacing: 2px; }\n  .proc-box .chips .q { color: #d5453f; }\n  .proc-box .chips .c { color: #2a72c9; }\n  .proc-box .chips .d { color: #3aa06a; }\n\n  /* ---------- TOP10 ---------- */\n  .top10 {\n    background: #fff2f2;\n    border: 2px solid #f4a1a1;\n    border-radius: 10px;\n    padding: 8px 10px;\n  }\n  .top10 .ttl {\n    color: #e0431f; font-weight: 900; font-size: 17px; margin: 0 0 4px 26px;\n    position: relative;\n  }\n  .top10 .star {\n    position: absolute; left: -26px; top: 0;\n    width: 20px; height: 20px; border: 1px dashed #eec06a; border-radius: 50%;\n    font-size: 7px; color: #c99a2e; text-align: center; line-height: 20px;\n  }\n  .top10 ol { margin: 4px 0 0 20px; padding: 0; font-size: 13px; line-height: 1.75; }\n\n  /* ---------- risk response ---------- */\n  .rr {\n    background: #fff2f2;\n    border: 2px solid #f4a1a1;\n    border-radius: 10px;\n    padding: 8px 10px;\n  }\n  .rr h3 {\n    margin: 2px 0 8px; text-align: center; font-size: 18px; font-weight: 900; color: #cc3232;\n  }\n  .rr .cols { display: flex; gap: 10px; }\n  .rr .col { flex: 1; }\n  .rr .ch { text-align: center; font-weight: bold; font-size: 14px; margin-bottom: 6px; }\n  .rr .col1 .ch { color: #2a5fa8; }\n  .rr .col2 .ch { color: #d98c00; }\n  .rr .it { font-size: 12px; margin: 7px 0; line-height: 1.4; }\n  .rr .it b { font-size: 13.5px; }\n  .rr .col1 .it b { color: #2a5fa8; }\n  .rr .col2 .it b { color: #cf8b12; }\n  .rr .it .note { color: #666; font-size: 11px; }\n  .rr .mk {\n    display: inline-block; width: 16px; height: 16px; border: 1px dashed #bbb;\n    border-radius: 3px; font-size: 6px; color: #aaa; text-align: center; line-height: 16px;\n    margin-right: 3px; vertical-align: middle;\n  }\n\n  /* ---------- bottom section ---------- */\n  .bottom { display: flex; gap: 10px; align-items: stretch; margin-bottom: 10px; }\n  .seven {\n    flex: 0 0 430px;\n    background: #fff6e6;\n    border: 2px solid #f5c98a;\n    border-radius: 10px;\n    padding: 8px;\n  }\n  .seven h3 { margin: 2px 0 8px; text-align: center; font-size: 19px; font-weight: 900; color: #d5453f; }\n  .seven .grid {\n    display: grid;\n    grid-template-columns: repeat(6, 1fr);\n    gap: 4px;\n    background: #fff;\n    border: 1px solid #e6d5b8;\n    border-radius: 6px;\n    padding: 6px 4px;\n  }\n  .seven .cell { text-align: center; font-size: 11px; font-weight: bold; }\n  .seven .cell .ph {\n    margin-top: 4px;\n    height: 62px;\n    border: 1px dashed #cfcfcf;\n    border-radius: 4px;\n    font-size: 7px;\n    color: #aaa;\n    display: flex; align-items: center; justify-content: center;\n  }\n\n  .life {\n    flex: 1;\n    background: #eaf5fd;\n    border: 2px solid #a8d3f0;\n    border-radius: 10px;\n    padding: 8px;\n    text-align: center;\n  }\n  .life h3 { margin: 2px 0 8px; font-size: 19px; font-weight: 900; color: #1f68b5; }\n  .life .flow { font-size: 15px; font-weight: bold; color: #2a5fa8; letter-spacing: 1px; }\n  .life .flow .ar { color: #e0431f; margin: 0 6px; }\n  .life .desc { font-size: 13px; margin-top: 8px; color: #333; }\n  .life .desc .src { display: block; color: #1f8a5f; margin-top: 3px; }\n  .life .ph-diagram {\n    margin: 8px auto 0;\n    width: 92%;\n    height: 118px;\n    border: 1px dashed #a8d3f0;\n    border-radius: 6px;\n    background: #fff;\n    display: flex; align-items: center; justify-content: center;\n    font-size: 11px; color: #7aa9c9;\n  }\n\n  .cheer {\n    flex: 0 0 130px;\n    display: flex; flex-direction: column; align-items: center; justify-content: center;\n    gap: 6px;\n  }\n  .cheer .bub {\n    border: 2px solid #f0a53c;\n    border-radius: 14px;\n    background: #fff;\n    padding: 8px 10px;\n    font-size: 14px;\n    font-weight: bold;\n    color: #333;\n    text-align: center;\n    line-height: 1.4;\n  }\n  .cheer .ph {\n    width: 118px; height: 110px;\n    border: 1px dashed #f0c48a; border-radius: 8px;\n    background: #fff8ec;\n    font-size: 9px; color: #c79a53;\n    display: flex; align-items: center; justify-content: center; text-align: center;\n  }\n\n  /* ---------- footer ---------- */\n  .footer {\n    background: #dbe8fb;\n    border: 2px solid #a8c6ee;\n    border-radius: 10px;\n    padding: 10px 14px;\n    font-size: 14px;\n    font-weight: bold;\n    color: #24457f;\n    text-align: center;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <!-- ======= HEADER ======= -->\n  <div class=\"header\">\n    <div class=\"badge\">[插图: 卡通形象 + 必过! 徽章, 左上角]</div>\n    <div class=\"main-title\">\n      <span class=\"t1\">软考高项</span><span class=\"t2\">各子过程可用工具与技术大全</span>\n    </div>\n    <div class=\"header-right\">[插图: 柯基犬, 右上角]</div>\n  </div>\n\n  <div class=\"subtitle-row\" style=\"position:relative;\">\n    <div class=\"subtitle\">依据：《信息系统项目管理师教程（第4版）》</div>\n    <div class=\"tip-bubble\">工具在手<br>管理不愁！</div>\n  </div>\n\n  <!-- ======= ROW 1 ======= -->\n  <div class=\"row\">\n    <div class=\"card c-blue\" style=\"flex:1;\">\n      <h2>1. 整体管理 <span class=\"ico\">📋</span></h2>\n      <table class=\"k\">\n        <thead><tr><th class=\"sub\">子过程</th><th>工具与技术</th></tr></thead>\n        <tbody>\n          <tr><td class=\"sub\">1.1 制定项目章程</td><td>专家判断、引导技术、会议</td></tr>\n          <tr><td class=\"sub\">1.2 制定项目管理计划</td><td>专家判断、引导技术、会议</td></tr>\n          <tr><td class=\"sub\">1.3 指导与管理项目工作</td><td>项目管理信息系统、会议</td></tr>\n          <tr><td class=\"sub\">1.4 管理项目知识</td><td>知识管理、信息管理</td></tr>\n          <tr><td class=\"sub\">1.5 监控项目工作</td><td>数据分析、决策、会议</td></tr>\n          <tr><td class=\"sub\">1.6 实施整体变更控制</td><td>变更控制工具、决策、数据分析</td></tr>\n          <tr><td class=\"sub\">1.7 结束项目或阶段</td><td>专家判断、数据分析、会议</td></tr>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"card c-green\" style=\"flex:1;\">\n      <h2>2. 范围管理 <span class=\"ico\">📐</span></h2>\n      <table class=\"k\">\n        <thead><tr><th class=\"sub\">子过程</th><th>工具与技术</th></tr></thead>\n        <tbody>\n          <tr><td class=\"sub\">2.1 规划范围管理</td><td>专家判断、会议、数据分析</td></tr>\n          <tr><td class=\"sub\">2.2 收集需求</td><td>访谈、焦点小组、引导式研讨会、群体创新/决策技术、问卷、原型法、标杆对照、系统交互图、文件分析</td></tr>\n          <tr><td class=\"sub\">2.3 定义范围</td><td>产品分析、备选方案生成、引导式研讨会</td></tr>\n          <tr><td class=\"sub\">2.4 创建WBS</td><td>分解、专家判断</td></tr>\n          <tr><td class=\"sub\">2.5 确认范围</td><td>检查、群体决策技术</td></tr>\n          <tr><td class=\"sub\">2.6 控制范围</td><td>偏差分析</td></tr>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"card c-orange\" style=\"flex:1;\">\n      <h2>3. 进度管理 <span class=\"ico\">🕐</span></h2>\n      <table class=\"k\">\n        <thead><tr><th class=\"sub\">子过程</th><th>工具与技术</th></tr></thead>\n        <tbody>\n          <tr><td class=\"sub\">3.1 规划进度管理</td><td>专家判断、数据分析、会议</td></tr>\n          <tr><td class=\"sub\">3.2 定义活动</td><td>分解、滚动式规划、专家判断</td></tr>\n          <tr><td class=\"sub\">3.3 排列活动顺序</td><td>紧前关系绘图法（PDM）、确定和整合依赖关系、提前量和滞后量</td></tr>\n          <tr><td class=\"sub\">3.4 估算活动持续时间</td><td>类比估算、参数估算、三点估算、自下而上估算、储备分析</td></tr>\n          <tr><td class=\"sub\">3.5 制定进度计划</td><td>关键路径法（CPM）、资源优化、进度压缩、敏捷发布规划</td></tr>\n          <tr><td class=\"sub\">3.6 控制进度</td><td>数据分析（挣值分析、迭代燃尽图、绩效审查）、进度压缩、资源优化</td></tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n\n  <!-- ======= ROW 2 ======= -->\n  <div class=\"row\">\n    <div class=\"card c-purple\" style=\"flex:1;\">\n      <h2>4. 成本管理 <span class=\"ico\">💰</span></h2>\n      <table class=\"k\">\n        <thead><tr><th class=\"sub\">子过程</th><th>工具与技术</th></tr></thead>\n        <tbody>\n          <tr><td class=\"sub\">4.1 规划成本管理</td><td>专家判断、数据分析</td></tr>\n          <tr><td class=\"sub\">4.2 估算成本</td><td>类比估算、参数估算、自下而上估算、三点估算、储备分析、质量成本</td></tr>\n          <tr><td class=\"sub\">4.3 制定预算</td><td>成本汇总、储备分析、历史关系</td></tr>\n          <tr><td class=\"sub\">4.4 控制成本</td><td>挣值分析（EV/PV/AC）、偏差分析、趋势分析</td></tr>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"card c-pink\" style=\"flex:1;\">\n      <h2>5. 质量管理 <span class=\"ico\">🏅</span></h2>\n      <table class=\"k\">\n        <thead><tr><th class=\"sub\">子过程</th><th>工具与技术</th></tr></thead>\n        <tbody>\n          <tr><td class=\"sub\">5.1 规划质量管理</td><td>标杆对照、成本效益分析、质量成本</td></tr>\n          <tr><td class=\"sub\">5.2 管理质量</td><td>老七种工具（因果图/鱼骨图、流程图、直方图、帕累托图、控制图、散点图、核查表）、质量审计、过程分析、根本原因分析</td></tr>\n          <tr><td class=\"sub\">5.3 控制质量</td><td>老七种工具、统计抽样、检查、测试/产品评估</td></tr>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"card c-teal\" style=\"flex:1;\">\n      <h2>6. 资源管理 <span class=\"ico\">👥</span></h2>\n      <table class=\"k\">\n        <thead><tr><th class=\"sub\">子过程</th><th>工具与技术</th></tr></thead>\n        <tbody>\n          <tr><td class=\"sub\">6.1 规划资源管理</td><td>数据表现（责任分配矩阵RAM/组织分解结构OBS）、组织理论</td></tr>\n          <tr><td class=\"sub\">6.2 估算活动资源</td><td>自下而上估算、类比估算、参数估算、备选方案分析</td></tr>\n          <tr><td class=\"sub\">6.3 获取资源</td><td>预分配、谈判、虚拟团队</td></tr>\n          <tr><td class=\"sub\">6.4 建设团队</td><td>人际关系与团队技能（冲突管理、情商、影响力、领导力）、基本规则、培训、团队建设活动</td></tr>\n          <tr><td class=\"sub\">6.5 管理团队</td><td>冲突管理、情商、影响、领导力、观察/交流、绩效评估</td></tr>\n          <tr><td class=\"sub\">6.6 控制资源</td><td>数据分析（绩效审查）</td></tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n\n  <!-- ======= ROW 3 ======= -->\n  <div class=\"row\">\n    <div style=\"flex:0 0 288px;\">\n      <div class=\"card c-yellow\">\n        <h2>7. 沟通管理 <span class=\"ico\">📣</span></h2>\n        <table class=\"k\">\n          <thead><tr><th class=\"sub\">子过程</th><th>工具与技术</th></tr></thead>\n          <tbody>\n            <tr><td class=\"sub\">7.1 规划沟通管理</td><td>沟通需求分析、沟通技术、沟通模型</td></tr>\n            <tr><td class=\"sub\">7.2 管理沟通</td><td>沟通方法（推式/拉式/交互式沟通）、人际关系与团队技能、演示、项目报告</td></tr>\n            <tr><td class=\"sub\">7.3 监督沟通</td><td>干系人参与度评估矩阵、数据分析</td></tr>\n          </tbody>\n        </table>\n      </div>\n      <div class=\"comm-box\">\n        <div class=\"ttl\">沟通方法三大类：</div>\n        <div class=\"item\"><span class=\"ph-icon\">[图标]</span><span><b>推式沟通：</b>发送方主动推送信息</span></div>\n        <div class=\"item\"><span class=\"ph-icon\">[图标]</span><span><span class=\"g\">拉式沟通：</span>接收方自行获取信息</span></div>\n        <div class=\"item\"><span class=\"ph-icon\">[图标]</span><span><span class=\"r\">交互式沟通：</span>双方多向交流 <span class=\"ph-icon\">[图标]</span></span></div>\n      </div>\n    </div>\n\n    <div style=\"flex:1;\">\n      <div class=\"card c-red\">\n        <h2>8. 风险管理 <span class=\"ico\">⚠️</span></h2>\n        <table class=\"k\">\n          <thead><tr><th class=\"sub\">子过程</th><th>工具与技术</th></tr></thead>\n          <tbody>\n            <tr><td class=\"sub\">8.1 规划风险管理</td><td>专家判断、数据分析、会议</td></tr>\n            <tr><td class=\"sub\">8.2 识别风险</td><td>头脑风暴、德尔菲技术、根本原因分析、核对单、假设分析、SWOT分析、系统或过程流程图、因果图/鱼骨图、文件审查、专家判断</td></tr>\n            <tr><td class=\"sub\">8.3 实施定性风险分析</td><td>风险概率与影响评估、概率与影响矩阵、风险分类、数据质量评价、风险紧迫性评估、层级图</td></tr>\n            <tr><td class=\"sub\">8.4 实施定量风险分析</td><td>模拟/蒙特卡洛分析、敏感性分析（龙卷风图）、决策树分析、影响图</td></tr>\n            <tr><td class=\"sub\">8.5 规划风险应对</td><td>威胁应对策略（上报、规避、转移、减轻、接受）、机会应对策略（上报、开拓、分享、提高、接受）</td></tr>\n            <tr><td class=\"sub\">8.6 实施风险应对</td><td>专家判断、人际关系与团队技能、项目管理信息系统</td></tr>\n            <tr><td class=\"sub\">8.7 监督风险</td><td>数据分析（技术绩效分析、储备分析）、审计、会议</td></tr>\n          </tbody>\n        </table>\n      </div>\n      <div class=\"risk-note\">\n        <div class=\"star\">[星]</div>\n        <div class=\"hd\">识别风险常用清单：7种分析工具 + 6种数据收集方法 + 图解技术</div>\n        <div><b class=\"lbl\">分析工具：</b>专家判断、根本原因分析、假设分析、SWOT分析、流程图等</div>\n        <div><b class=\"lbl\">数据收集：</b>头脑风暴、德尔菲技术、核对单、文件审查、访谈、问卷等</div>\n        <div><b class=\"lbl\">图解技术：</b>因果图/鱼骨图、系统或过程流程图等</div>\n      </div>\n    </div>\n\n    <div style=\"flex:0 0 288px;\">\n      <div class=\"card c-lblue\">\n        <h2>9. 采购管理 <span class=\"ico\">🛒</span></h2>\n        <table class=\"k\">\n          <thead><tr><th class=\"sub\">子过程</th><th>工具与技术</th></tr></thead>\n          <tbody>\n            <tr><td class=\"sub\">9.1 规划采购管理</td><td>自制或外购分析、专家判断、市场调查、会议</td></tr>\n            <tr><td class=\"sub\">9.2 实施采购</td><td>专家判断、独立估算、广告/投标人会议、建议书评估技术</td></tr>\n            <tr><td class=\"sub\">9.3 控制采购</td><td>合同变更控制、采购绩效审查、检查与审计、索赔管理</td></tr>\n          </tbody>\n        </table>\n      </div>\n      <div class=\"proc-box\">\n        <div class=\"ttl\">采购三要素：</div>\n        <div class=\"chips\"><span class=\"q\">质量</span> ✿ <span class=\"c\">成本</span> ✿ <span class=\"d\">交付</span></div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ======= ROW 4 ======= -->\n  <div class=\"row\">\n    <div class=\"card c-lblue\" style=\"flex:0 0 350px;\">\n      <h2>10. 干系人管理 <span class=\"ico\">👨‍👩‍👧</span></h2>\n      <table class=\"k\">\n        <thead><tr><th class=\"sub\">子过程</th><th>工具与技术</th></tr></thead>\n        <tbody>\n          <tr><td class=\"sub\">10.1 识别干系人</td><td>干系人分析、权力利益方格、干系人立方体、影响方向、优先级排序、凸显模型、数据收集（问卷/访谈）</td></tr>\n          <tr><td class=\"sub\">10.2 规划干系人参与</td><td>干系人参与度评估矩阵、专家判断、会议</td></tr>\n          <tr><td class=\"sub\">10.3 管理干系人参与</td><td>沟通方法、人际关系与团队技能（冲突管理、谈判）、基本规则</td></tr>\n          <tr><td class=\"sub\">10.4 监督干系人参与</td><td>干系人参与度评估矩阵、数据分析、会议</td></tr>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"top10\" style=\"flex:0 0 200px;\">\n      <div class=\"ttl\"><span class=\"star\">[星]</span>高频考点TOP10</div>\n      <ol>\n        <li>挣值分析（EVM）</li>\n        <li>WBS 分解</li>\n        <li>关键路径法（CPM）</li>\n        <li>风险应对策略</li>\n        <li>干系人分析方法</li>\n        <li>质量管理七大工具</li>\n        <li>风险识别工具清单</li>\n        <li>沟通方法三大类</li>\n        <li>合同变更控制</li>\n        <li>偏差分析</li>\n      </ol>\n    </div>\n\n    <div class=\"rr\" style=\"flex:1;\">\n      <h3>风险应对策略（威胁&amp;机会各五种）</h3>\n      <div class=\"cols\">\n        <div class=\"col col1\">\n          <div class=\"ch\">威胁应对策略</div>\n          <div class=\"it\"><span class=\"mk\">[盾]</span><b>上报</b> <span class=\"note\">（提交给上级或相关方）</span></div>\n          <div class=\"it\"><span class=\"mk\">[盾]</span><b>规避</b> <span class=\"note\">（改变计划以消除威胁）</span></div>\n          <div class=\"it\"><span class=\"mk\">[盾]</span><b>转移</b> <span class=\"note\">（将风险转移给第三方）</span></div>\n          <div class=\"it\"><span class=\"mk\">[盾]</span><b>减轻</b> <span class=\"note\">（降低风险发生的概率或影响）</span></div>\n          <div class=\"it\"><span class=\"mk\">[盾]</span><b>接受</b> <span class=\"note\">（有意识地接受风险）</span></div>\n        </div>\n        <div class=\"col col2\">\n          <div class=\"ch\">机会应对策略</div>\n          <div class=\"it\"><span class=\"mk\">[星]</span><b>上报</b> <span class=\"note\">（提交给上级或相关方）</span></div>\n          <div class=\"it\"><span class=\"mk\">[星]</span><b>开拓</b> <span class=\"note\">（确保机会被利用）</span></div>\n          <div class=\"it\"><span class=\"mk\">[星]</span><b>分享</b> <span class=\"note\">（第三方共享机会）</span></div>\n          <div class=\"it\"><span class=\"mk\">[星]</span><b>提高</b> <span class=\"note\">（增加机会的发生概率或影响）</span></div>\n          <div class=\"it\"><span class=\"mk\">[星]</span><b>接受</b> <span class=\"note\">（有意识地接受机会）</span></div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ======= BOTTOM ======= -->\n  <div class=\"bottom\">\n    <div class=\"seven\">\n      <h3>质量管理七大工具</h3>\n      <div class=\"grid\">\n        <div class=\"cell\">因果图<br>（鱼骨图）<div class=\"ph\">[图: 鱼骨图]</div></div>\n        <div class=\"cell\">直方图<div class=\"ph\">[图: 直方图]</div></div>\n        <div class=\"cell\">帕累托图<div class=\"ph\">[图: 帕累托图]</div></div>\n        <div class=\"cell\">控制图<div class=\"ph\">[图: 控制图]</div></div>\n        <div class=\"cell\">散点图<div class=\"ph\">[图: 流程/散点]</div></div>\n        <div class=\"cell\">核查表<div class=\"ph\">[图: 核查表]</div></div>\n      </div>\n    </div>\n\n    <div class=\"life\">\n      <h3>项目的生命周期</h3>\n      <div class=\"flow\">启动 <span class=\"ar\">➡</span> 规划 <span class=\"ar\">➡</span> 执行 <span class=\"ar\">➡</span> 监控 <span class=\"ar\">➡</span> 收尾</div>\n      <div class=\"desc\">过程组之间相互作用，并行重复\n        <span class=\"src\">（过程组交互图 - PMBOK<sup>®</sup> 第六版）</span>\n      </div>\n      <div class=\"ph-diagram\">[图示: 过程组交互图 — 启动过程组、规划过程组、执行过程组、监控过程组、收尾过程组 循环箭头图，居中]</div>\n    </div>\n\n    <div class=\"cheer\">\n      <div class=\"bub\">加油！<br>一定可以！</div>\n      <div class=\"ph\">[插图: 柯基犬拿喇叭, 右下角]</div>\n    </div>\n  </div>\n\n  <div class=\"footer\">\n    提示：以上工具与技术均来自《信息系统项目管理师教程（第4版）》官方内容，软考高项必备！理解记忆，灵活运用，考试更轻松！ 👍\n  </div>\n\n</div>\n</body>\n</html>"
