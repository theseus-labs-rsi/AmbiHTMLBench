        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>人民日报 要闻 2 — 2025年1月6日</title>\n<script>\nwindow.MathJax = {\n  tex: {inlineMath: [['$','$']], displayMath: [['$$','$$']]}\n};\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\" async></script>\n<style>\n  body{\n    margin:0; padding:0;\n    background:#fff;\n    font-family:\"SimSun\",\"Songti SC\",serif;\n    color:#111;\n  }\n  .page{\n    width:1020px;\n    margin:0 auto;\n    padding:8px 12px 20px 12px;\n    box-sizing:border-box;\n  }\n  /* ---------- masthead ---------- */\n  .masthead{\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    border-bottom:3px solid #c00;\n    padding-bottom:4px;\n  }\n  .masthead-left{display:flex;align-items:flex-end;gap:14px;}\n  .sec-title{\n    background:#c8262a;\n    color:#fff;\n    font-weight:bold;\n    font-size:26px;\n    letter-spacing:2px;\n    padding:2px 12px 4px 12px;\n    font-family:\"SimHei\",\"Heiti SC\",sans-serif;\n  }\n  .sec-num{\n    font-size:26px;\n    font-weight:bold;\n    font-family:\"SimHei\",sans-serif;\n  }\n  .sec-date{font-size:12px;color:#333;padding-bottom:4px;}\n  .paper-name{\n    font-size:34px;\n    font-weight:bold;\n    letter-spacing:4px;\n    font-family:\"KaiTi\",\"STKaiti\",serif;\n    color:#111;\n  }\n  /* ---------- main grid ---------- */\n  .main{\n    display:flex;\n    gap:10px;\n    margin-top:10px;\n  }\n  .col-left{width:300px;flex:none;}\n  .col-mid{width:430px;flex:none;}\n  .col-right{width:250px;flex:none;border-left:1px solid #bbb;padding-left:10px;}\n\n  .rubric{\n    display:flex;align-items:center;gap:6px;\n    border-bottom:1px solid #c00;\n    padding-bottom:3px;\n    margin-bottom:6px;\n  }\n  .rubric .R{\n    background:#c8262a;color:#fff;font-weight:bold;\n    font-family:Arial,sans-serif;\n    font-size:13px;padding: