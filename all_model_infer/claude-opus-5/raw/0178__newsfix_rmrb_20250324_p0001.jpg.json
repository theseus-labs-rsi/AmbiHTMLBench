        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>人民日报 2025年3月24日 头版</title>\n<script>\nwindow.MathJax = { tex: { inlineMath: [['$','$']], displayMath: [['$$','$$']] } };\n</script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  body{margin:0;padding:12px;background:#f6f6f6;font-family:\"SimSun\",\"Songti SC\",serif;color:#111;}\n  .page{width:820px;margin:0 auto;background:#fff;padding:10px 14px 18px 14px;box-sizing:border-box;}\n  .masthead{display:flex;align-items:flex-start;border-bottom:2px solid #c00;padding-bottom:6px;}\n  .logo{width:270px;flex:0 0 270px;}\n  .logo .cn{font-family:\"KaiTi\",\"STKaiti\",serif;font-weight:bold;color:#c00;font-size:62px;letter-spacing:2px;line-height:1;}\n  .logo .en{color:#c00;font-size:14px;letter-spacing:3px;text-align:center;margin-top:2px;}\n  .logo .rule{border-top:1px solid #c00;margin:4px 0 3px 0;}\n  .logo .site{font-size:10px;text-align:center;}\n  .datebox{flex:0 0 96px;border-left:1px solid #999;border-right:1px solid #999;text-align:center;font-size:10px;line-height:1.5;padding:0 4px;}\n  .datebox .d1{font-size:11px;border-bottom:1px solid #999;padding-bottom:2px;}\n  .datebox .num{font-size:30px;font-weight:bold;line-height:1.1;}\n  .datebox .small{border-top:1px solid #999;margin-top:3px;padding-top:2px;}\n  .headzone{flex:1;padding-left:10px;}\n  .redbar{background:#c00;color:#fff;text-align:center;font-weight:bold;font-size:15px;padding:3px 0;letter-spacing:1px;}\n  .h-main{color:#c00;font-weight:bold;font-size:26px;text-align:center;margin:8px 0 4px 0;letter-spacing:1px;font-family:\"Microsoft YaHei\",\"Heiti SC\",sans-serif;}\n  .byline{font-size:10px;text-align:right;margin-bottom:4px;}\n  .cols2{display:flex;gap:10px;font-size:9px;line-height:1.5;text-align:justify;}\n  .cols2 > div{flex:1;}\n  .lead-tit