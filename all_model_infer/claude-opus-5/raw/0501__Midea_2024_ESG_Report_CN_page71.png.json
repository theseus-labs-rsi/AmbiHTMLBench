 {\n    font-size: 38px;\n    font-weight: 500;\n    color: #0a7fd0;\n    letter-spacing: 2px;\n    margin: 0 0 60px 0;\n  }\n\n  .pill {\n    display: inline-block;\n    border: 1.5px solid #0a7fd0;\n    border-radius: 24px;\n    color: #0a7fd0;\n    font-size: 22px;\n    padding: 8px 30px;\n    margin: 0 0 30px 0;\n  }\n  .pill-top { margin-top: 62px; }\n\n  /* ---------- Award entries ---------- */\n  .item { margin-bottom: 24px; }\n  .item .name {\n    font-size: 21px;\n    line-height: 1.55;\n    color: #1a1a1a;\n    padding-bottom: 12px;\n    border-bottom: 1px solid #d8d8d8;\n  }\n  .item .org {\n    font-size: 16px;\n    color: #8a8a8a;\n    padding-top: 12px;\n    line-height: 1.5;\n  }\n  .item .org-nobreak { border-bottom: none; }\n\n  /* ---------- Placeholder graphic ---------- */\n  .placeholder {\n    position: absolute;\n    right: 60px;\n    bottom: 60px;\n    width: 470px;\n    height: 470px;\n    border: 1px dashed #9ccdea;\n    color: #6aa9cf;\n    font-size: 16px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    padding: 10px;\n  }\n\n  /* ---------- Page numbers ---------- */\n  .pagenum-left,\n  .pagenum-right {\n    position: absolute;\n    bottom: 40px;\n    font-size: 18px;\n    color: #0a7fd0;\n  }\n  .pagenum-left { left: 110px; }\n  .pagenum-right { right: 110px; }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"header\">\n    <div class=\"doc-title\">2024 · 美的集团ESG报告</div>\n    <nav>\n      <span>关于本报告</span>\n      <span>走进美的</span>\n      <span>可持续发展治理</span>\n      <span>守护蓝色星球</span>\n      <span>构建和谐社区</span>\n      <span>践行科技尽善</span>\n      <span>共创繁荣生态</span>\n      <span class=\"current\">附录</span>\n    </nav>\n  </div>\n\n  <h1 class=\"big-title\">附录</h1>\n\n  <div class=\"columns\">\n\n    <!-- Column 1 -->\n    <div class=\"col col-1\">\n      <h2 class=\"section-title\">附录一 奖项与荣誉</h2>\n\n      <div class=\"pill\">品牌认可</div>\n\n      <div class=\"item\">\n        <div class=\"name\">连续九年入围财富500强，2024年位居277位</div>\n        <div class=\"org\">财富</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">荣获《财富》最受赞赏的中国公司</div>\n        <div class=\"org\">财富</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">入选福布斯中国跨国经营30强</div>\n        <div class=\"org\">福布斯中国</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">全球最佳雇主</div>\n        <div class=\"org\">福布斯</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">全球最适合女性工作的企业</div>\n        <div class=\"org\">福布斯</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">全球科技品牌（Technology 100）价值100强，美的排名40</div>\n        <div class=\"org\">Brand Finance</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">以旧换新领军品牌</div>\n        <div class=\"org\">人民日报社</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">中国企业科创力排行 家用电器 — 行业第一</div>\n        <div class=\"org\">南方周末</div>\n      </div>\n    </div>\n\n    <!-- Column 2 -->\n    <div class=\"col col-2\">\n      <div class=\"pill pill-top\">ESG奖项</div>\n\n      <div class=\"item\">\n        <div class=\"name\">入围财富中国ESG影响力榜</div>\n        <div class=\"org\">财富中国</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">福布斯中国2024可持续发展企业50强</div>\n        <div class=\"org\">福布斯中国</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">中国新增长ESG创新实践榜</div>\n        <div class=\"org\">哈佛商业评论</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">ESG新标杆企业奖</div>\n        <div class=\"org\">证券之星</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">年度低碳先锋</div>\n        <div class=\"org\">南方周末</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">ESG综合治理标杆企业</div>\n        <div class=\"org\">经济观察报</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">中国制造业上市公司社会责任五星金奖</div>\n        <div class=\"org\">时代责任四十人论坛</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">可持续品牌典范奖</div>\n        <div class=\"org\">虎嗅ESG</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">可持续发展优创奖</div>\n        <div class=\"org\">《电器》杂志社</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">2024中国最佳ESG雇主</div>\n        <div class=\"org\">怡安AON</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">杰出全球ESG影响力大奖</div>\n        <div class=\"org\">2024粤港澳大湾区可持续发展论坛暨香港ESG报告大奖（HERA）</div>\n      </div>\n    </div>\n\n    <!-- Column 3 -->\n    <div class=\"col col-3\">\n      <div class=\"pill pill-top\">技术认可</div>\n\n      <div class=\"item\">\n        <div class=\"name\">2024亚洲最佳移动技术突破奖</div>\n        <div class=\"org\">GSMA亚洲移动大奖（AMO）</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">国家科技进步奖二等奖（《空气源热泵多品位热能高效供应关键技术与应用》）</div>\n        <div class=\"org\">国务院</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">中国创新方法大赛一等奖（《基于TRIZ的干衣机低碳关键技术研究》项目）</div>\n        <div class=\"org\">中国科学技术协会、重庆市政府</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">2024年第三届高能团队奖</div>\n        <div class=\"org\">哈佛商业评论，北京国际人力资本集团股份有限公司</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">2024胡润中国元宇宙潜力企业榜</div>\n        <div class=\"org\">胡润研究院</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">美的集团联合项目《智能工厂全连接物流及精细化管理关键技术研究与应用》荣获了2024年度\"机械工业科学技术奖\"科技进步奖一等奖</div>\n        <div class=\"org\">中国机械工业联合会，中国机械工程学会</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">2024年度脉脉MAX雇主榜单</div>\n        <div class=\"org\">脉脉</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">2024绿点中国·可持续消费实践案例评选（美的集团-废旧家电绿色闭路循环创新项目）</div>\n        <div class=\"org\">第一财经</div>\n      </div>\n    </div>\n\n    <!-- Column 4 -->\n    <div class=\"col col-4\">\n      <div class=\"item\" style=\"margin-top:62px;\">\n        <div class=\"name\">美的洗衣机合肥工厂被评为\"可持续灯塔工厂\"</div>\n        <div class=\"org\">世界经济论坛</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">美的医疗\"中国脊梁守护计划\"公益活动成功入选「2024健康中国创新实践典型案例」</div>\n        <div class=\"org\">人民网</div>\n      </div>\n\n      <div class=\"item\">\n        <div class=\"name\">美的医疗荣获2024年度中国新质发展优秀案例</div>\n        <div class=\"org\">国家广告研究院、《中国名牌》杂志社</div>\n      </div>\n    </div>\n\n  </div>\n\n  <figure class=\"placeholder\">\n    [Illustration: 蓝色奖杯与月桂花环装饰图，页面右下角]\n  </figure>\n\n  <div class=\"pagenum-left\">139</div>\n  <div class=\"pagenum-right\">140</div>\n\n</div>\n</body>\n</html>"
