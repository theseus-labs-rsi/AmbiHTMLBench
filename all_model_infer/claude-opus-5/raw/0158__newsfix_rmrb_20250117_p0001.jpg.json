        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>人民日报 2025年1月17日 头版</title>\n<script src=\"https://polyfill.io/v3/polyfill.min.js?features=es6\"></script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<script>\nwindow.MathJax = {\n  tex: {\n    inlineMath: [['$', '$']],\n    displayMath: [['$$', '$$']]\n  }\n};\n</script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0 auto;\n    padding: 10px 14px;\n    max-width: 820px;\n    background: #fff;\n    color: #111;\n    font-family: \"Songti SC\", \"SimSun\", \"Noto Serif CJK SC\", serif;\n    font-size: 11px;\n    line-height: 1.5;\n  }\n  .placeholder {\n    border: 1px solid #999;\n    background: #f2f2f2;\n    color: #555;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    font-size: 10px;\n    padding: 4px;\n  }\n\n  /* ---------- Masthead ---------- */\n  .masthead {\n    display: flex;\n    align-items: stretch;\n    border-bottom: 2px solid #c00;\n    padding-bottom: 4px;\n  }\n  .masthead .logo {\n    width: 258px;\n    flex: 0 0 258px;\n    padding-right: 6px;\n  }\n  .logo .title-cn {\n    font-family: \"STKaiti\", \"KaiTi\", serif;\n    font-size: 62px;\n    font-weight: bold;\n    color: #c00;\n    letter-spacing: 4px;\n    line-height: 1;\n    margin: 4px 0 2px;\n  }\n  .logo hr { border: none; border-top: 2px solid #c00; margin: 2px 0; }\n  .logo .title-py {\n    font-size: 13px;\n    letter-spacing: 3px;\n    color: #c00;\n    text-align: center;\n  }\n  .logo .website {\n    font-size: 10px;\n    text-align: center;\n    margin-top: 12px;\n    border-top: 1px solid #c00;\n    padding-top: 4px;\n  }\n  .masthead .dateblock {\n    width: 96px;\n    flex: 0 0 96px;\n    border-left: 1px solid #999;\n    border-right: 1px solid #999;\n    text-align: center;\n    font-size: 9px;\n    line-height: 1.5;\n    padding: 2px 3px;\n  }\n  .dateblock .big-day {\n    font-size: 34px;\n    font-weight: bold;\n    line-height: 1;\n    margin: 2px 0;\n  }\n  .masthead .headzone {\n    flex: 1;\n    padding-left: 10px;\n  }\n  .headzone h1 {\n    font-family: \"Heiti SC\", \"SimHei\", sans-serif;\n    font-size: 25px;\n    font-weight: bold;\n    line-height: 1.25;\n    margin: 4px 0 8px;\n    letter-spacing: 1px;\n  }\n  .headzone .cols3 {\n    display: flex;\n    gap: 8px;\n    font-size: 9.5px;\n    line-height: 1.55;\n    text-align: justify;\n  }\n  .headzone .cols3 > div {\n    flex: 1;\n    border-left: 1px solid #ddd;\n    padding-left: 6px;\n  }\n  .headzone .cols3 > div:first-child { border-left: none; padding-left: 0; }\n\n  /* ---------- main grid ---------- */\n  .main {\n    display: flex;\n    gap: 8px;\n    margin-top: 6px;\n    border-top: 2px solid #333;\n    padding-top: 6px;\n  }\n  .left-zone { flex: 1 1 auto; }\n  .right-zone {\n    width: 306px;\n    flex: 0 0 306px;\n    border-left: 1px solid #999;\n    padding-left: 8px;\n  }\n\n  .lead-title {\n    font-family: \"STKaiti\", \"KaiTi\", serif;\n    font-size: 26px;\n    font-weight: bold;\n    line-height: 1.35;\n    text-align: center;\n    margin: 4px 0 8px;\n  }\n  .rule { border: none; border-top: 1px solid #333; margin: 8px 0; }\n  .rule-thin { border: none; border-top: 1px solid #bbb; margin: 6px 0; }\n\n  .body-cols {\n    display: flex;\n    gap: 8px;\n    font-size: 9px;\n    line-height: 1.6;\n    text-align: justify;\n  }\n  .body-cols > div { flex: 1; }\n  .body-cols p { margin: 0 0 5px; text-indent: 2em; }\n  .dateline { font-weight: bold; }\n\n  .sec-title-2 {\n    font-family: \"Heiti SC\", \"SimHei\", sans-serif;\n    font-size: 21px;\n    font-weight: bold;\n    text-align: center;\n    letter-spacing: 1px;\n    margin: 6px 0 8px;\n  }\n\n  /* vertical text blocks (right zone features) */\n  .vert-wrap {\n    display: fle