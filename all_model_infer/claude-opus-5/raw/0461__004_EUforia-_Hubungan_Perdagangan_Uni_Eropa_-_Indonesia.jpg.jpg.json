        "content": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Hubungan perdagangan Uni Eropa - Indonesia</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] }\n};\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\" async></script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    background: #1B36A8;\n    color: #ffffff;\n    font-family: \"Segoe UI\", \"Trebuchet MS\", Arial, sans-serif;\n  }\n  .page {\n    position: relative;\n    width: 1920px;\n    margin: 0 auto;\n    padding: 30px 40px 0 40px;\n    background: #1B36A8;\n  }\n  h1.title {\n    text-align: center;\n    font-size: 62px;\n    font-weight: 300;\n    margin: 10px 0 30px 0;\n    letter-spacing: 0.5px;\n  }\n  h1.title b { font-weight: 700; }\n\n  .main {\n    display: flex;\n    align-items: flex-start;\n    gap: 20px;\n  }\n  .col-left { width: 700px; flex: 0 0 700px; }\n  .col-right { flex: 1; }\n\n  .placeholder {\n    border: 2px dashed #F2C230;\n    color: #F2C230;\n    font-size: 15px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    padding: 6px;\n  }\n\n  .ph-handshake { width: 620px; height: 470px; margin: 0 auto 40px auto; }\n\n  .lead {\n    text-align: center;\n    font-size: 22px;\n    line-height: 1.35;\n    padding: 0 20px;\n    margin-bottom: 22px;\n  }\n  .lead b { font-weight: 700; }\n\n  .callout {\n    background: #F2C230;\n    color: #1B36A8;\n    font-weight: 700;\n    font-size: 26px;\n    line-height: 1.3;\n    text-align: center;\n    border-radius: 18px;\n    padding: 22px 26px;\n    width: 580px;\n    margin: 26px auto 0 auto;\n  }\n\n  .ph-people { width: 520px; height: 300px; margin: 30px 0 0 0; }\n\n  /* Right column */\n  .intro-row {\n    display: flex;\n    gap: 30px;\n    align-items: flex-start;\n  }\n  .ph-man { width: 200px; height: 320px; flex: 0 0 200px; }\n  .apa-itu {\n    font-size: 38px;\n    font-weight: 700;\n    color: #F2C230;\n    line-height: 1.15;\n    padding-top: 40px;\n    flex: 0 0 200px;\n  }\n  .intro-text {\n    flex: 1;\n    font-size: 19.5px;\n    line-height: 1.35;\n  }\n  .intro-text p { margin: 0 0 18px 0; }\n\n  .section-head {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    font-size: 30px;\n    font-weight: 400;\n    margin: 28px 0 10px 0;\n  }\n  .section-head .dot {\n    width: 22px; height: 22px; border-radius: 50%;\n    background: #ffffff; flex: 0 0 22px;\n  }\n  .section-head b { font-weight: 700; }\n\n  .icon-row {\n    display: flex;\n    justify-content: space-around;\n    align-items: flex-end;\n    gap: 20px;\n    margin: 10px 0 6px 0;\n  }\n  .icon-item { width: 200px; text-align: center; }\n  .icon-item .placeholder { width: 180px; height: 170px; margin: 0 auto 10px auto; }\n  .icon-item .cap { font-size: 22px; }\n\n  .timeline-badge {\n    border: 3px solid #ffffff;\n    border-radius: 40px;\n    padding: 12px 40px;\n    font-size: 44px;\n    font-weight: 700;\n    display: inline-block;\n    margin: 24px 0 0 auto;\n  }\n  .badge-wrap { display: flex; justify-content: flex-end; }\n\n  /* Timeline */\n  .timeline-zone {\n    display: flex;\n    align-items: flex-end;\n    margin-top: 10px;\n  }\n  .timeline {\n    flex: 1;\n    display: flex;\n    align-items: center;\n    padding-bottom: 20px;\n  }\n  .tl-item {\n    position: relative;\n    width: 74px;\n    text-align: center;\n    font-size: 15px;\n    line-height: 1.25;\n  }\n  .tl-item .above,\n  .tl-item .below {\n    height: 88px;\n    display: flex;\n    align-items: flex-end;\n    justify-content: center;\n  }\n  .tl-item .below { align-items: flex-start; }\n  .tl-item .num {\n    width: 34px; height: 34px; line-height: 30px;\n    border: 2px solid #F2C230;\n    border-radius: 50%;\n    margin: 8px auto;\n    font-size: 16px;\n    color: #ffffff;\n    background: #1B36A8;\n  }\n  .tl-item .num.last {\n    background: #F2C230;\n    color: #1B36A8;\n    font-weight: 700;\n  }\n  .tl-line {\n    position: absolute;\n    left: 0; right: 0;\n    top: 50%;\n    border-top: 2px solid #F2C230;\n    z-index: 0;\n  }\n  .tl-track { position: relative; display: flex; }\n\n  .footer {\n    background: #F2C230;\n    color: #1B36A8;\n    font-size: 19px;\n    text-align: center;\n    padding: 10px 0;\n    margin-top: 20px;\n  }\n  .footer span { margin: 0 40px; }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <h1 class=\"title\">Hubungan perdagangan <b>Uni Eropa - Indonesia</b></h1>\n\n  <div class=\"main\">\n\n    <!-- LEFT COLUMN -->\n    <div class=\"col-left\">\n      <figure class=\"placeholder ph-handshake\" style=\"margin:0 auto 40px auto;\">\n        [Illustration: handshake between a hand and a hand wrapped in the Indonesian flag, surrounded by yellow stars — top-left]\n      </figure>\n\n      <div class=\"lead\">\n        <b>Indonesia</b> dan <b>Uni Eropa</b> pada Selasa (23/9) meneken perjanjian kemitraan ekonomi komprehensif yang meliputi perdagangan barang serta jasa, investasi, perlindungan lingkungan, dan keberlanjutan.\n      </div>\n      <div class=\"lead\">\n        Diinisiasi sejak 2016, kesepakatan ini baru mencapai kesepakatan sembilan tahun kemudian, setelah melalui setidaknya 17 pertemuan.\n      </div>\n\n      <div class=\"callout\">\n        Menteri Koordinator Bidang<br>\n        Perekonomian Airlangga Hartarto<br>\n        menyebut perjanjian itu berpotensi<br>\n        meningkatkan ekonomi Indonesia hingga<br>\n        USD 2,8 Miliar\n      </div>\n\n      <figure class=\"placeholder ph-people\">\n        [Illustration: three people seated at a table with documents — bottom-left]\n      </figure>\n    </div>\n\n    <!-- RIGHT COLUMN -->\n    <div class=\"col-right\">\n\n      <div class=\"intro-row\">\n        <figure class=\"placeholder ph-man\" style=\"margin:0;\">\n          [Illustration: man in yellow jacket pointing — center-top]\n        </figure>\n        <div class=\"apa-itu\">Apa itu<br>IEU-CEPA?</div>\n        <div class=\"intro-text\">\n          <p>IEU-CEPA merupakan perjanjian kemitraan ekonomi komprehensif antara Indonesia dan Uni Eropa yang mencakup perdagangan barang dan jasa, investasi, hingga ekonomi berkelanjutan.</p>\n          <p>Lewat kerja sama ini, produk-produk ekspor Indonesia akan menikmati tarif nol persen di 90,4% pasar Uni Eropa, termasuk komoditas unggulan seperti sawit, teksil, alas kaki, produk perikanan, dan bahan baku energi terbarukan.</p>\n          <p>Perjanjian ini juga membuka akses bagi investor asal Uni Eropa untuk menanamkan modal di Indonesia sehingga berpotensi menciptakan lapangan kerja baru.</p>\n        </div>\n      </div>\n\n      <div class=\"section-head\">\n        <span class=\"dot\"></span>\n        <span>Ekspor utama <b>Indonesia ke Uni Eropa</b></span>\n      </div>\n\n      <div class=\"icon-row\">\n        <div class=\"icon-item\">\n          <figure class=\"placeholder\">[Icon: pile of beans/grains]</figure>\n          <div class=\"cap\">Perkebunan</div>\n        </div>\n        <div class=\"icon-item\">\n          <figure class=\"placeholder\">[Icon: folded textiles]</figure>\n          <div class=\"cap\">Tekstil</div>\n        </div>\n        <div class=\"icon-item\">\n          <figure class=\"placeholder\">[Icon: mineral rocks]</figure>\n          <div class=\"cap\">Mineral</div>\n        </div>\n        <div class=\"icon-item\">\n          <figure class=\"placeholder\">[Icon: PALM OIL bottle with palm fruit]</figure>\n          <div class=\"cap\">Minyak Sawit</div>\n        </div>\n      </div>\n\n      <div class=\"section-head\">\n        <span class=\"dot\"></span>\n        <span>Ekspor utama <b>Uni Eropa ke Indonesia</b></span>\n      </div>\n\n      <div class=\"icon-row\">\n        <div class=\"icon-item\">\n          <figure class=\"placeholder\">[Icon: airplane]</figure>\n          <div class=\"cap\">Alat Transportasi</div>\n        </div>\n        <div class=\"icon-item\">\n          <figure class=\"placeholder\">[Icon: pills and capsules]</figure>\n          <div class=\"cap\">Produk Farmasi</div>\n        </div>\n        <div class=\"icon-item\">\n          <figure class=\"placeholder\">[Icon: two laboratory flasks]</figure>\n          <div class=\"cap\">Bahan Kimia</div>\n        </div>\n        <div class=\"icon-item\">\n          <figure class=\"placeholder\">[Icon: bulldozer]</figure>\n          <div class=\"cap\">Mesin Industri</div>\n        </div>\n      </div>\n\n      <div class=\"badge-wrap\">\n        <div class=\"timeline-badge\">Linimasa IEU-CEPA</div>\n      </div>\n\n    </div>\n  </div>\n\n  <!-- TIMELINE -->\n  <div class=\"timeline-zone\">\n    <div class=\"timeline\">\n      <div class=\"tl-track\">\n        <div class=\"tl-line\"></div>\n\n        <div class=\"tl-item\"><div class=\"above\">20-21 Sep<br>2016,<br>Brussels</div><div class=\"num\">1</div><div class=\"below\"></div></div>\n        <div class=\"tl-item\"><div class=\"above\"></div><div class=\"num\">2</div><div class=\"below\">24-27 Jan<br>2017,<br>Bali</div></div>\n        <div class=\"tl-item\"><div class=\"above\">11-15 Sep<br>2017,<br>Brussels</div><div class=\"num\">3</div><div class=\"below\"></div></div>\n        <div class=\"tl-item\"><div class=\"above\"></div><div class=\"num\">4</div><div class=\"below\">19-23 Feb<br>2018,<br>Solo</div></div>\n        <div class=\"tl-item\"><div class=\"above\">9-13 Jul<br>2018,<br>Brussels</div><div class=\"num\">5</div><div class=\"below\"></div></div>\n        <div class=\"tl-item\"><div class=\"above\"></div><div class=\"num\">6</div><div class=\"below\">15-19 Okt<br>2018,<br>Palembang</div></div>\n        <div class=\"tl-item\"><div class=\"above\">11-15 Mar<br>2019,<br>Brussels</div><div class=\"num\">7</div><div class=\"below\"></div></div>\n        <div class=\"tl-item\"><div class=