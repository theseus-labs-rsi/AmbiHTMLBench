olid #000; box-sizing: border-box;\n  }\n  .pp-l2 { width: 92px; padding-left: 30px; box-sizing: border-box; }\n  .pp-b2 {\n    width: 240px; height: 33px;\n    border: 1.4px solid #000; box-sizing: border-box;\n  }\n  .pp-b2-date {\n    width: 155px; height: 33px;\n    border: 1.4px solid #000; box-sizing: border-box;\n    text-align: center; line-height: 33px;\n    letter-spacing: 14px;\n  }\n  .city-box {\n    width: 300px; height: 33px;\n    border: 1.4px solid #000; box-sizing: border-box;\n  }\n  .state-lbl { width: 82px; text-align: center; }\n  .state-box {\n    width: 62px; height: 33px;\n    border: 1.4px solid #000; box-sizing: border-box;\n  }\n\n  /* ---------- Footer ---------- */\n  .footer {\n    border-top: 1.4px solid #000;\n    margin-top: 300px;\n    padding-top: 6px;\n    display: flex;\n    justify-content: space-between;\n    align-items: baseline;\n  }\n  .footer .pg { font-size: 14px; }\n  .footer .pg b { font-size: 17px; }\n  .footer .fm { font-size: 14px; }\n  .footer .fm b { font-size: 18px; }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <!-- Header -->\n  <div class=\"hdr\">\n    <div class=\"left\"><b>Name</b> <i>(not your trade name)</i></div>\n    <div class=\"right\">\n      <b>Employer identification number (EIN)</b>\n      <div class=\"ein-dash\">&ndash;</div>\n    </div>\n  </div>\n\n  <!-- Bullets -->\n  <div class=\"bullets\">\n    <div class=\"row\">\n      <div class=\"txt\">&bull; <b>All filers:</b> If line 3 is less than $2,500, <b>don&rsquo;t</b> complete line 7 or Form 945-A.</div>\n    </div>\n    <div class=\"row\">\n      <div class=\"txt\">&bull; <b>Semiweekly schedule depositors:</b> Complete Form 945-A and check here <span class=\"dots\">. . . . . . . . . . . . . . . . . . .</span></div>\n      <div><span class=\"cbox\"></span></div>\n    </div>\n    <div class=\"row\">\n      <div class=\"txt\">&bull; <b>Monthly schedule depositors:</b> Complete line 7, entries 7a through 7m, and check here <span class=\"dots\">. . . . . . . . . . . . .</span></div>\n      <div><span class=\"cbox\"></span></div>\n    </div>\n  </div>\n\n  <!-- Line 7 -->\n  <div class=\"line7-title\"><span class=\"num\">7</span>Monthly Summary of Federal Tax Liability. (<b>Don&rsquo;t</b><span class=\"reg\"> complete if you were a semiweekly schedule depositor.)</span></div>\n\n  <table class=\"month-grid\">\n    <tr>\n      <td></td><td class=\"mlabel\">Jan.</td><td class=\"gap\"></td>\n      <td></td><td class=\"mlabel\">Apr.</td><td class=\"gap\"></td>\n      <td></td><td class=\"mlabel\">July</td><td class=\"gap\"></td>\n      <td></td><td class=\"mlabel\">Oct.</td>\n    </tr>\n    <tr>\n      <td class=\"code\">7a</td><td><div class=\"amt\"></div></td><td></td>\n      <td class=\"code\">7d</td><td><div class=\"amt\"></div></td><td></td>\n      <td class=\"code\">7g</td><td><div class=\"amt\"></div></td><td></td>\n      <td class=\"code\">7j</td><td><div class=\"amt\"></div></td>\n    </tr>\n    <tr>\n      <td></td><td class=\"mlabel\">Feb.</td><td class=\"gap\"></td>\n      <td></td><td class=\"mlabel\">May</td><td class=\"gap\"></td>\n      <td></td><td class=\"mlabel\">Aug.</td><td class=\"gap\"></td>\n      <td></td><td class=\"mlabel\">Nov.</td>\n    </tr>\n    <tr>\n      <td class=\"code\">7b</td><td><div class=\"amt\"></div></td><td></td>\n      <td class=\"code\">7e</td><td><div class=\"amt\"></div></td><td></td>\n      <td class=\"code\">7h</td><td><div class=\"amt\"></div></td><td></td>\n      <td class=\"code\">7k</td><td><div class=\"amt\"></div></td>\n    </tr>\n    <tr>\n      <td></td><td class=\"mlabel\">Mar.</td><td class=\"gap\"></td>\n      <td></td><td class=\"mlabel\">June</td><td class=\"gap\"></td>\n      <td></td><td class=\"mlabel\">Sept.</td><td class=\"gap\"></td>\n      <td></td><td class=\"mlabel\">Dec.</td>\n    </tr>\n    <tr>\n      <td class=\"code\">7c</td><td><div class=\"amt\"></div></td><td></td>\n      <td class=\"code\">7f</td><td><div class=\"amt\"></div><