-------- Table ---------- */\n  table.cmp {\n    border-collapse: collapse;\n    width: 100%;\n    font-size: 13.5px;\n  }\n  table.cmp td, table.cmp th {\n    border: 1px solid #808080;\n    padding: 5px 6px;\n    text-align: center;\n    vertical-align: middle;\n  }\n  table.cmp th { font-weight: bold; }\n  table.cmp td.fn, table.cmp th.fn {\n    text-align: left;\n    width: 30%;\n  }\n  .grp { font-weight: bold; text-align: left; }\n  .shade { background: #d4d4d4; }\n  .blue { color: #0000cc; }\n  a { color: #0000cc; }\n  sup { font-size: 9.5px; }\n  sup.ref { color: #0000cc; }\n  .col-dev { width: 11%; }\n\n  /* ---------- Footnotes ---------- */\n  ol.footnotes {\n    list-style: none;\n    margin: 14px 0 0 0;\n    padding: 0;\n    font-size: 13.5px;\n  }\n  ol.footnotes li {\n    display: flex;\n    margin-bottom: 2px;\n    line-height: 1.35;\n  }\n  ol.footnotes li .num { width: 46px; flex: 0 0 46px; }\n  ol.footnotes li .txt { flex: 1; }\n\n  /* ---------- Footer ---------- */\n  .page-footer {\n    border-top: 3px solid #000;\n    margin-top: 22px;\n    padding-top: 5px;\n  }\n  .footer-row {\n    display: flex;\n    justify-content: space-between;\n    align-items: baseline;\n  }\n  .footer-left { font-size: 13px; }\n  .footer-left .fb {\n    color: #0000cc;\n    font-style: italic;\n    font-weight: bold;\n    margin-left: 22px;\n  }\n  .footer-links {\n    text-align: center;\n    margin-top: 6px;\n    font-size: 13.5px;\n  }\n  .footer-links i { color: #0000cc; font-style: italic; }\n</style>\n</head>\n<body>\n\n<div class=\"page-header\">\n  <div class=\"header-left\">\n    <p class=\"doc-title\">AWR2943, AWR2944, AWR2944LC</p>\n    <p class=\"doc-sub\">SWRS273E – NOVEMBER 2021 – REVISED FEBRUARY 2026</p>\n  </div>\n  <div class=\"header-right\">\n    <div class=\"ti-logo\">\n      <div class=\"ti-mark\">Ti</div>\n      <div class=\"ti-words\">\n        <div class=\"t1\">TEXAS</div>\n        <div class=\"t2\">INSTRUMENTS</div>\n      </div>\n    </div>\n    <div class=\"ti-url\">www.ti.com</div>\n  </div>\n</div>\n\n<h1 class=\"section\">4 Device Comparison</h1>\n\n<div class=\"table-caption\">Table 4-1. Device Features Comparison</div>\n\n<table class=\"cmp\">\n  <tr>\n    <th class=\"fn\" colspan=\"2\">FUNCTION</th>\n    <th class=\"col-dev\">AWR2943</th>\n    <th class=\"col-dev\">AWR2944</th>\n    <th class=\"col-dev\">AWR2944LC</th>\n    <th class=\"col-dev blue\">AWR2243</th>\n    <th class=\"col-dev blue\">AWR1843</th>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">Number of receivers</td>\n    <td>4</td><td>4</td><td>4</td><td>4</td><td>4</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">Number of transmitters</td>\n    <td>3</td><td>4</td><td>4</td>\n    <td>3<sup class=\"ref\">(1)</sup></td>\n    <td>3<sup class=\"ref\">(1)</sup></td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">On-chip memory</td>\n    <td>3.5MB</td><td>4MB</td><td>3MB</td>\n    <td class=\"shade\">—</td><td>2MB</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">Max I/F (Intermediate Frequency) (MHz)</td>\n    <td>15</td><td>15</td><td>15</td><td>20</td><td>10</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">Max real/complex 2x sampling rate (Msps)</td>\n    <td>37.5 <sup class=\"ref\">(2)</sup></td>\n    <td>37.5 <sup class=\"ref\">(2)</sup></td>\n    <td>37.5 <sup class=\"ref\">(2)</sup></td>\n    <td>45</td><td>25</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">Max complex 1x sampling rate (Msps)</td>\n    <td class=\"shade\">—<sup class=\"ref\">(2)</sup></td>\n    <td class=\"shade\">—<sup class=\"ref\">(2)</sup></td>\n    <td class=\"shade\">—<sup class=\"ref\">(2)</sup></td>\n    <td>22.5</td><td>12.5</td>\n  </tr>\n  <tr>\n    <td class=\"fn grp\" colspan=\"2\">Safety and Security <sup class=\"ref\">(3)</sup></td>\n    <td></td>\n    <td colspan=\"4\"></td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">Device Security<sup class=\"ref\">(4)</sup></td>\n    <td>Yes</td><td>Yes</td><td>Yes</td>\n    <td class=\"shade\">—</td><td>Yes</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">AEC-Q100 Qualified</td>\n    <td>Yes</td><td>Yes</td><td>Yes</td><td>Yes</td><td>Yes</td>\n  </tr>\n  <tr>\n    <td class=\"fn grp\" colspan=\"2\">Processor</td>\n    <td colspan=\"3\"></td>\n    <td colspan=\"2\"></td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">MCU (RxF)</td>\n    <td>Yes<sup class=\"ref\">(5)</sup></td>\n    <td>Yes<sup class=\"ref\">(5)</sup></td>\n    <td>Yes<sup class=\"ref\">(5)</sup></td>\n    <td class=\"shade\">—</td><td>Yes</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">DSP (C6xx)</td>\n    <td>Yes<sup class=\"ref\">(6)</sup></td>\n    <td>Yes<sup class=\"ref\">(6)</sup></td>\n    <td class=\"shade\">—</td>\n    <td class=\"shade\">—</td><td>Yes</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">Hardware accelerator</td>\n    <td>Yes<sup class=\"ref\">(7)</sup></td>\n    <td>Yes<sup class=\"ref\">(7)</sup></td>\n    <td>Yes<sup class=\"ref\">(7)</sup></td>\n    <td class=\"shade\">—</td><td>Yes</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">Hardware Security Module (HSM) <sup class=\"ref\">(8)</sup></td>\n    <td>Yes</td><td>Yes</td><td>Yes</td>\n    <td class=\"shade\">—</td><td class=\"shade\">—</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">Security Accelerators <sup class=\"ref\">(8)</sup></td>\n    <td>Yes</td><td>Yes</td><td>Yes</td>\n    <td class=\"shade\">—</td><td>Yes</td>\n  </tr>\n  <tr>\n    <td class=\"fn grp\" colspan=\"2\">Peripherals</td>\n    <td colspan=\"3\"></td>\n    <td colspan=\"2\"></td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">Serial Peripheral Interface (SPI) ports</td>\n    <td>2</td><td>2</td><td>2</td><td>1</td><td>2</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">Quad Serial Peripheral Interface (QSPI)</td>\n    <td>Yes</td><td>Yes</td><td>Yes</td>\n    <td class=\"shade\">—</td><td>Yes</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">LVDS/Debug</td>\n    <td>Yes</td><td>Yes</td><td>Yes</td><td>Yes</td><td>Yes</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">Aurora LVDS</td>\n    <td>Yes</td><td>Yes</td>\n    <td class=\"shade\">—</td><td class=\"shade\">—</td><td class=\"shade\">—</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">Ethernet Interface</td>\n    <td>Yes</td><td>Yes</td>\n    <td class=\"shade\">—</td><td class=\"shade\">—</td><td class=\"shade\">—</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">Inter-Integrated Circuit (I<sup>2</sup>C) interface</td>\n    <td>1</td><td>1</td><td>1</td><td>1</td><td>1</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">Controller Area Network (DCAN) interface</td>\n    <td class=\"shade\">—</td><td class=\"shade\">—</td><td class=\"shade\">—</td>\n    <td class=\"shade\">—</td><td>Yes</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">CAN FD</td>\n    <td>2</td><td>2</td><td>2</td>\n    <td class=\"shade\">—</td><td>1</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">Trace</td>\n    <td>Yes</td><td>Yes</td><td>Yes</td>\n    <td class=\"shade\">—</td><td>Yes</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">ePWM</td>\n    <td>Yes</td><td>Yes</td><td>Yes</td>\n    <td class=\"shade\">—</td><td>Yes</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">DMM Interface</td>\n    <td>Yes</td><td>Yes</td><td>Yes</td>\n    <td class=\"shade\">—</td><td>Yes</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">GPADC</td>\n    <td>Yes<sup class=\"ref\">(9)</sup></td>\n    <td>Yes<sup class=\"ref\">(9)</sup></td>\n    <td>Yes<sup class=\"ref\">(9)</sup></td>\n    <td>Yes</td><td>Yes</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">CSI2 TX</td>\n    <td class=\"shade\">—</td><td class=\"shade\">—</td><td class=\"shade\">—</td>\n    <td>Yes</td><td class=\"shade\">—</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">CSI2 RX <sup class=\"ref\">(10)</sup></td>\n    <td>Yes</td><td>Yes</td>\n    <td class=\"shade\">—</td><td class=\"shade\">—</td><td class=\"shade\">—</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">Cascade (20-GHz sync)</td>\n    <td class=\"shade\">—</td><td class=\"shade\">—</td><td class=\"shade\">—</td>\n    <td>Yes</td><td class=\"shade\">—</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">JTAG</td>\n    <td>Yes</td><td>Yes</td><td>Yes</td>\n    <td class=\"shade\">—</td><td>Yes</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" colspan=\"2\">Per chirp configurable Tx phase shifter</td>\n    <td>Yes</td><td>Yes</td><td>Yes</td><td>Yes</td><td>Yes</td>\n  </tr>\n  <tr>\n    <td class=\"fn\" style=\"width:14%;\">Product status<sup class=\"ref\">(11)</sup></td>\n    <td style=\"width:16%;\">PRODUCT PREVIEW (PP),<br>ADVANCE INFORMATION (AI),<br>or PRODUCTION DATA (PD)</td>\n    <td>PD</td><td>PD</td><td>PD</td><td>PD</td><td>PD</td>\n  </tr>\n</table>\n\n<ol class=\"footnotes\">\n  <li><span class=\"num\">(1)</span><span class=\"txt\">3 Tx Simultaneous operation in AWR1843 and AWR2243 is supported only with 1V LDO bypass and PA LDO disable mode. In this mode 1V supply needs to be fed on the VOUT PA pin. Please refer to the respective datasheets for more information.</span></li>\n  <li><span class=\"num\">(2)</span><span class=\"txt\">AWR294x supports a real only receiver.</span></li>\n  <li><span class=\"num\">(3)</span><span class=\"txt\">Developed for Functional Safety applications, the AWR294x device is targeted to support hardware integrity up to ASIL-B. For other devices, refer to the respective Datasheets.</span></li>\n  <li><span class=\"num\">(4)</span><span class=\"txt\">Device security features including Secure Boot and Customer Programmable Keys are applicable to select part number variants as indicated by the Device Type identifier in the <a href=\"#\">Section 3</a>, Device Information table.</span></li>\n  <li><span class=\"num\">(5)</span><span class=\"txt\">In AWR294x, Main-Subsystem Processing core is changed from Arm CR4F in AWR1843 to Arm CR5F.</span></li>\n  <li><span class=\"num\">(6)</span><span class=\"txt\">The DSP processing core in AWR294x is upgraded from C67x in AWR1843 to C66x.</span></li>\n  <li><span class=\"num\">(7)</span><span class=\"txt\">The hardware accelerator in AWR294x is upgraded to HWA2.1 with additional features as compared to AWR1843. AWR2944LC has M4 core in HWA</span></li>\n</ol>\n\n<div class=\"page-footer\">\n  <div class=\"footer-row\">\n    <div class=\"footer-left\">6<span class=\"fb\">Submit Document Feedback</span></div>\n    <div>Copyright © 2026 Texas Instruments Incorporated</div>\n  </div>\n  <div class=\"footer-links\">\n    Product Folder Links: <i>AWR2943 AWR2944 AWR2944LC</i>\n  </div>\n</div>\n\n</body>\n</html>"
