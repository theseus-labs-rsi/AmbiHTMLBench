der-radius: 5px;\n    padding: 9px 12px;\n    color: #4a4a4a;\n    font-size: 15px;\n    margin-bottom: 22px;\n  }\n  .searchbox .mag { font-weight: 700; margin-right: 6px; }\n  ul.tree, ul.tree ul {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n  }\n  ul.tree li { margin: 9px 0; font-size: 15px; }\n  ul.tree ul { padding-left: 22px; }\n  .caret { display: inline-block; width: 12px; color: #303030; font-size: 10px; }\n  .tree .leaf { color: #303030; }\n  .tree .current { font-weight: 700; }\n\n  /* ---------- Right sidebar ---------- */\n  .pagelinks a {\n    display: block;\n    margin-bottom: 6px;\n    font-weight: 600;\n  }\n  .pagelinks .icon { margin-right: 6px; }\n  .toc { margin-top: 22px; }\n  .toc a {\n    display: block;\n    color: #326ce5;\n    margin-bottom: 6px;\n    line-height: 1.35;\n  }\n\n  /* ---------- Main content ---------- */\n  .card {\n    border: 1px solid #dcdcdc;\n    padding: 16px 18px 10px 18px;\n    margin-bottom: 40px;\n  }\n  h1 {\n    font-size: 34px;\n    font-weight: 400;\n    margin: 30px 0 12px 0;\n  }\n  h2 {\n    font-size: 27px;\n    font-weight: 400;\n    margin: 26px 0 12px 0;\n  }\n  .flagname {\n    background: #eeeeee;\n    padding: 9px 12px;\n    font-size: 15px;\n  }\n  .flagdesc {\n    padding: 12px 12px 14px 34px;\n    border-bottom: 1px solid #e6e6e6;\n    margin-bottom: 14px;\n  }\n  pre {\n    background: #f7f7f7;\n    padding: 12px 16px;\n    font-family: \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace;\n    font-size: 14px;\n    overflow: hidden;\n    white-space: pre;\n    margin: 16px 0;\n  }\n  .tabs {\n    margin-top: 24px;\n  }\n  .tab {\n    display: inline-block;\n    border: 1px solid #dcdcdc;\n    border-bottom: none;\n    padding: 10px 18px;\n    background: #fff;\n    position: relative;\n    top: 1px;\n    font-size: 16px;\n  }\n  .tabpanel {\n    border: 1px solid #dcdcdc;\n    padding: 12px 18px 20px 18px;\n  }\n  p { margin: 12px 0; }\n</style>\n</head>\n<body>\n\n<header 