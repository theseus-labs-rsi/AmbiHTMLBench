nt-family: Arial, Helvetica, sans-serif; font-size: 12px; margin: 10px 0 6px; }\n  .weber-box {\n    border: 1px solid #000;\n    text-align: center;\n    padding: 6px 0;\n    margin: 0 6px 6px 6px;\n  }\n  .weber-word {\n    font-family: \"Times New Roman\", serif;\n    font-weight: bold;\n    font-size: 30px;\n    letter-spacing: 4px;\n  }\n  .showcase {\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 13px;\n  }\n  .showcase-sub {\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 11px;\n  }\n  .write-call {\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 13px;\n    font-weight: bold;\n    margin-top: 12px;\n    line-height: 1.6;\n  }\n  .installs {\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 10px;\n    line-height: 1.5;\n    margin-top: 12px;\n  }\n\n  /* ---------- Left column: Ben Meadows ad ---------- */\n  .ben-wrap { margin-top: 24px; position: relative; }\n  .balloon {\n    border: 4px solid #000;\n    padding: 22px 18px 18px 18px;\n    background: #fff;\n  }\n  .depend {\n    font-family: Arial, Helvetica, sans-serif;\n    font-weight: bold;\n    font-size: 40px;\n    line-height: 1.05;\n    text-align: center;\n    letter-spacing: 1px;\n    margin: 8px 0 18px;\n  }\n  .eng-supplies {\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 19px;\n    margin-bottom: 16px;\n  }\n  .ben-body {\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 16.5px;\n    line-height: 1.55;\n    text-align: justify;\n    margin-bottom: 14px;\n  }\n  .tail {\n    width: 0; height: 0;\n    border-left: 55px solid #000;\n    border-top: 45px solid transparent;\n    margin-left: 95px;\n  }\n  .ben-footer {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    margin-top: 10px;\n  }\n  .ben-name {\n    font-family: Arial, Helvetica, sans-serif;\n  }\n  .ben-name .the { font-size: 12px; font-weight: bold; }\n  .ben-name .big { font-size: 22px; font-weight: bold; line-height: 1.15; }\n  .ben-name .addr { font-size: 11px; font-weight: bold; margin-top: 4px; line-height: 1.4; }\n  .ph-portrait { width: 120px; height: 130px; flex: 0 0 120px; }\n  .black-bar { height: 14px; background: #000; margin-top: 20px; }\n\n  /* ---------- Middle column: Advertisers' Index ---------- */\n  .adv-index-title {\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 19px;\n    letter-spacing: 1px;\n    text-align: center;\n    margin: 4px 0 8px;\n  }\n  .index-list {\n    text-align: center;\n    font-size: 21px;\n    line-height: 1.2;\n  }\n  .index-list .pg {\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 15px;\n    letter-spacing: 1px;\n  }\n  .index-list .pg-small {\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 12.5px;\n    letter-spacing: 0.5px;\n  }\n\n  /* ---------- Right column: Calendar ---------- */\n  .cal-rule-top { border-top: 4px solid #000; }\n  .cal-rule-thin { border-top: 1px solid #000; margin-top: 2px; }\n  .calendar-title {\n    font-family: Arial, Helvetica, sans-serif;\n    font-weight: bold;\n    font-size: 30px;\n    letter-spacing: 2px;\n    text-align: center;\n    margin: 6px 0 4px;\n  }\n  .cal-entry { margin-bottom: 14px; }\n  .cal-date {\n    font-family: Arial, Helvetica, sans-serif;\n    font-weight: bold;\n    font-size: 13px;\n    text-align: center;\n    letter-spacing: 0.5px;\n    margin-bottom: 3px;\n  }\n  .cal-text {\n    font-size: 16px;\n    line-height: 1.3;\n    text-align: justify;\n  }\n\n  /* ---------- Lower right: Hamilton / T-Square ---------- */\n  .lower-right { margin-top: 6px; }\n  .hr-thick { border-top: 4px solid #000; margin: 8px 0 0; }\n  .hamilton-row {\n    display: flex;\n    gap: 16px;\n    align-items: flex-start;\n    margin-top: 14px;\n  }\n  .ph-hamilton {\n    width: 470px; height: 570px; flex: 0 0 470px;\n    background: #e8e8e8;\n    flex-direction: column;\n  }\n  .ham-overlay {\n    font-family: Arial, Helvetica, sans-serif;\