        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>电工工具大全</title>\n<script src=\"https://polyfill.io/v3/polyfill.min.js?features=es6\"></script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    background: #e8e8e8;\n    font-family: \"Microsoft YaHei\", \"PingFang SC\", sans-serif;\n  }\n  .page {\n    width: 1080px;\n    margin: 0 auto;\n    background: #ff5a1f;\n    padding: 14px;\n  }\n  .inner {\n    background: #f2f4f8;\n    padding: 0;\n  }\n  /* ---------- Header ---------- */\n  .header {\n    background: #16233f;\n    display: flex;\n    align-items: center;\n    padding: 16px 24px 10px 24px;\n    position: relative;\n  }\n  .header .toolbox {\n    width: 160px;\n    height: 150px;\n    flex: 0 0 160px;\n    background: #22314f;\n    border: 1px dashed #6d7d9c;\n    color: #9fb0cc;\n    font-size: 12px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n  }\n  .header .titles {\n    flex: 1;\n    text-align: center;\n    color: #fff;\n  }\n  .header .titles h1 {\n    margin: 0;\n    font-size: 76px;\n    font-weight: 900;\n    letter-spacing: 6px;\n    line-height: 1.05;\n  }\n  .header .titles h1 .yellow { color: #ffd21e; }\n  .header .titles h2 {\n    margin: 8px 0 0 0;\n    font-size: 33px;\n    font-weight: 700;\n    letter-spacing: 2px;\n  }\n  .header .icons {\n    width: 110px;\n    height: 150px;\n    flex: 0 0 110px;\n    background: #22314f;\n    border: 1px dashed #6d7d9c;\n    color: #9fb0cc;\n    font-size: 11px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n  }\n  /* ---------- Section banners ---------- */\n  .banner {\n    text-align: center;\n    margin: 14px 0 8px 0;\n  }\n  .banner span {\n    display: inline-block;\n    background: #1f7a3f;\n    color: #fff;\n    font-size: 25px;\n    font-weight: 800;\n    letter-spacing: 4px;\n    padding: 7px 34px;\n    border-radius: 22px;\n  }\n  /* ---------- Tool grid ---------- */\n  .grid-wrap {\n    margin: 0 16px;\n    border: 2px solid #2f5fa8;\n    border-radius: 8px;\n    background: #fff;\n    overflow: hidden;\n  }\n  table.tools {\n    border-collapse: collapse;\n    width: 100%;\n    table-layout: fixed;\n  }\n  table.tools td {\n    border: 1px solid #b9cbe6;\n    vertical-align: top;\n    padding: 8px 9px 10px 9px;\n    width: 16.66%;\n  }\n  .tname {\n    font-size: 17px;\n    font-weight: 800;\n    color: #123a6b;\n    text-align: center;\n    margin-bottom: 4px;\n    white-space: nowrap;\n  }\n  .num {\n    display: inline-block;\n    width: 19px;\n    height: 19px;\n    line-height: 19px;\n    border-radius: 50%;\n    background: #2f5fa8;\n    color: #fff;\n    font-size: 12px;\n    text-align: center;\n    font-weight: 700;\n    margin-right: 6px;\n    vertical-align: 2px;\n  }\n  .placeholder {\n    background: #f4f6f9;\n    border: 1px dashed #a9b8cf;\n    color: #7d8ba3;\n    font-size: 11px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    margin: 0 auto 8px auto;\n  }\n  .ph-tool { width: 100%; height: 118px; }\n  .desc {\n    font-size: 12.5px;\n    line-height: 1.5;\n    color: #1a1a1a;\n  }\n  .desc b { color: #1f4f9c; }\n  .desc p { margin: 0 0 3px 0; }\n  /* ---------- Tutorial ---------- */\n  .tut-wrap {\n    margin: 0 16px;\n    border: 2px solid #1f7a3f;\n    border-radius: 10px;\n    background: #fff;\n    padding: 10px 10px 12px 10px;\n    display: flex;\n    gap: 8px;\n  }\n  .tut {\n    flex: 1;\n  }\n  .tut h4 {\n    margin: 0 0 6px 0;\n    font-size: 15px;\n    color: #1f7a3f;\n    font-weight: 800;\n    text-align: center;\n  }\n  .ph-tut { width: 100%; height: 128px; margin-bottom: 6px; }\n  .tut p {\n    margin: 0;\n    font-size: 12px;\n    line-height: 1.5;\n    color: #222;\n  }\n  /* ---------- Safety ---------- */\n  .safety {\n    margin: 14px 16px 16px 16px;\n    display: flex;\n    align-items: center;\n    gap: 14px;\n  }\n  .safety-badge {\n    flex: 0 0 145px;\n    height: 92px;\n    background: #d81f1f;\n    border-radius: 8px;\n    color: #fff;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    font-size: 18px;\n    font-weight: 800;\n  }\n  .safety-badge .tri {\n    font-size: 26px;\n    line-height: 1;\n    margin-bottom: 4px;\n  }\n  .safety-list {\n    flex: 1;\n    display: flex;\n    gap: 10px;\n  }\n  .safety-col {\n    flex: 1;\n  }\n  .safety-col div {\n    font-size: 13.5px;\n    line-height: 1.9;\n    color: #111;\n  }\n  .snum {\n    display: inline-block;\n    width: 17px;\n    height: 17px;\n    line-height: 17px;\n    border-radius: 50%;\n    background: #2f5fa8;\n    color: #fff;\n    font-size: 11px;\n    text-align: center;\n    margin-right: 6px;\n  }\n  .helmet {\n    flex: 0 0 130px;\n    height: 92px;\n    background: #f4f6f9;\n    border: 1px dashed #a9b8cf;\n    color: #7d8ba3;\n    font-size: 11px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n  }\n  .helmet b { color: #333; font-size: 12px; }\n  .watermark {\n    text-align: right;\n    font-size: 20px;\n    color: #9aa4b3;\n    padding: 0 24px 10px 0;\n    font-weight: 700;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n<div class=\"inner\">\n\n  <!-- Header -->\n  <div class=\"header\">\n    <div class=\"toolbox placeholder\">[Photo: 黄色工具箱及电工工具 — 左上角]</div>\n    <div class=\"titles\">\n      <h1>电工工具<span class=\"yellow\">大全</span></h1>\n      <h2>让您分分钟认清电工工具和用法</h2>\n    </div>\n    <div class=\"icons placeholder\">[Icons: 闪电符号 / 螺丝刀 — 右上角]</div>\n  </div>\n\n  <!-- Banner 1 -->\n  <div class=\"banner\"><span>常用电工工具盘点与用法</span></div>\n\n  <!-- Tools grid -->\n  <div class=\"grid-wrap\">\n  <table class=\"tools\">\n    <tr>\n      <td>\n        <div class=\"tname\"><span class=\"num\">1</span>一字螺丝刀</div>\n        <div class=\"placeholder ph-tool\">[Photo: 一字螺丝刀]</div>\n        <div class=\"desc\">\n          <p><b>用途：</b>拧一字槽螺丝</p>\n          <p><b>用法：</b>刀头对准螺丝槽，<br>垂直用力旋转。</p>\n        </div>\n      </td>\n      <td>\n        <div class=\"tname\"><span class=\"num\">2</span>十字螺丝刀</div>\n        <div class=\"placeholder ph-tool\">[Photo: 十字螺丝刀]</div>\n        <div class=\"desc\">\n          <p><b>用途：</b>拧十字槽螺丝</p>\n          <p><b>用法：</b>刀头对准螺丝槽，<br>垂直用力旋转。</p>\n        </div>\n      </td>\n      <td>\n        <div class=\"tname\"><span class=\"num\">3</span>测电笔</div>\n        <div class=\"placeholder ph-tool\">[Photo: 测电笔]</div>\n        <div class=\"desc\">\n          <p><b>用途：</b>检测火线</p>\n          <p><b>用法：</b>手指接触笔尾金属，<br>笔尖接触导线，氖管亮<br>表示为火线。</p>\n        </div>\n      </td>\n      <td>\n        <div class=\"tname\"><span class=\"num\">4</span>万用表</div>\n        <div class=\"placeholder ph-tool\">[Photo: 数字万用表]</div>\n        <div class=\"desc\">\n          <p><b>用途：</b>测电压、电流、电阻等</p>\n          <p><b>用法：</b>根据测量需求选择<br>档位，表笔正确接线后<br>进行测量。</p>\n        </div>\n      </td>\n      <td>\n        <div class=\"tname\"><span class=\"num\">5</span>钢丝钳</div>\n        <div class=\"placeholder ph-tool\">[Photo: 钢丝钳]</div>\n        <div class=\"desc\">\n          <p><b>用途：</b>夹持、弯曲、剪切导线</p>\n          <p><b>用法：</b>用钳口夹持物体，<br>需要剪切时用靠近铰链<br>处的刀口。</p>\n        </div>\n      </td>\n      <td>\n        <div class=\"tname\"><span class=\"num\">6</span>尖嘴钳</div>\n        <div class=\"placeholder ph-tool\">[Photo: 尖嘴钳]</div>\n        <div class=\"desc\">\n          <p><b>用途：</b>夹持小件、弯折导线</p>\n          <p><b>用法：</b>用钳尖夹持小件，<br>适合在狭小空间操作。</p>\n        </div>\n      </td>\n    </tr>\n    <tr>\n      <td>\n        <div class=\"tname\"><span class=\"num\">7</span>斜口钳</div>\n        <div class=\"placeholder ph-tool\">[Photo: 斜口钳]</div>\n        <div class=\"desc\">\n          <p><b>用途：</b>剪切导线、铜丝等</p>\n          <p><b>用法：</b>将导线放入钳口，<br>用力握紧即可剪断。</p>\n        </div>\n      </td>\n      <td>\n        <div class=\"tname\"><span class=\"num\">8</span>剥线钳</div>\n        <div class=\"placeholder ph-tool\">[Photo: 剥线钳]</div>\n        <div class=\"desc\">\n          <p><b>用途：</b>剥离导线绝缘层</p>\n          <p><b>用法：</b>根据导线规格选择<br>剥线口，夹紧后旋转或<br>轻压剥离。</p>\n        </div>\n      </td>\n      <td>\n        <div class=\"tname\"><span class=\"num\">9</span>电工刀</div>\n        <div class=\"placeholder ph-tool\">[Photo: 电工刀]</div>\n        <div class=\"desc\">\n          <p><b>用途：</b>剥线、削绝缘层</p>\n          <p><b>用法：</b>刀口朝外，轻划绝缘<br>层，切勿用力过猛以免<br>伤到导线。</p>\n        </div>\n      </td>\n      <td>\n        <div class=\"tname\"><span class=\"num\">10</span>卷尺</div>\n        <div class=\"placeholder ph-tool\">[Photo: 卷尺]</div>\n        <div class=\"desc\">\n          <p><b>用途：</b>测量长度</p>\n          <p><b>用法：</b>拉出尺带，勾住测量<br>起点，读取刻度。</p>\n        </div>\n      </td>\n      <td>\n        <div class=\"tname\"><span class=\"num\">11</span>绝缘胶带</div>\n        <div class=\"placeholder ph-tool\">[Photo: 绝缘胶带]</div>\n        <div class=\"desc\">\n          <p><b>用途：</b>绝缘包扎、标识</p>\n          <p><b>用法：</b>缠绕在导线接头处，<br>起到绝缘和保护作用。</p>\n        </div>\n      </td>\n      <td>\n        <div class=\"tname\"><span class=\"num\">12</span>热缩管</div>\n        <div class=\"placeholder ph-tool\">[Photo: 热缩管]</div>\n        <div class=\"desc\">\n          <p><b>用途：</b>绝缘保护</p>\n          <p><b>用法：</b>套在导线接头处，<br>用热风枪加热收缩即可。</p>\n        </div>\n      </td>\n    </tr>\n    <tr>\n      <td>\n        <div class=\"tname\"><span class=\"num\">13</span>电烙铁</div>\n        <div class=\"placeholder ph-tool\">[Photo: 电烙铁]</div>\n        <div class=\"desc\">\n          <p><b>用途：</b>焊接导线、元器件</p>\n          <p><b>用法：</b>通电加热后，配合焊锡<br>该行焊接，使用后注意<br>及时清理焊头。</p>\n        </div>\n      </td>\n      <td>\n        <div class=\"tname\"><span class=\"num\">14</span>焊锡丝</div>\n        <div class=\"placeholder ph-tool\">[Photo: 焊锡丝]</div>\n        <div class=\"desc\">\n          <p><b>用途：</b>配合电烙铁焊接</p>\n          <p><b>用法：</b>用于填充焊点，使焊<br>点牢固导电良好。</p>\n        </div>\n      </td>\n      <td>\n        <div class=\"tname\"><span class=\"num\">15</span>吸锡器</div>\n        <div class=\"placeholder ph-tool\">[Photo: 吸锡器]</div>\n        <div class=\"desc\">\n          <p><b>用途：</b>吸除多余焊锡</p>\n          <p><b>用法：</b>将吸锡器对准焊点，<br>按下按钮即可吸走焊锡。</p>\n        </div>\n      </td>\n      <td>\n        <div class=\"tname\"><span class=\"num\">16</span>电钻</div>\n        <div class=\"placeholder ph-tool\">[Photo: 电钻]</div>\n        <div class=\"desc\">\n          <p><b>用途：</b>钻孔、安装</p>\n          <p><b>用法：</b>安装合适钻头，<br>对准位置后启动电钻<br>进行钻孔。</p>\n        </div>\n      </td>\n      <td>\n        <div class=\"tname\"><span class=\"num\">17</span>冲击钻头</div>\n        <div class=\"placeholder ph-tool\">[Photo: 冲击钻头]</div>\n        <div class=\"desc\">\n          <p><b>用途：</b>在墙体、混凝土上钻孔</p>\n          <p><b>用法：</b>配合冲击钻使用，<br>选择合适直径钻头。</p>\n        </div>\n      </td>\n      <td>\n        <div class=\"tname\"><span class=\"num\">18</span>内六角扳手</div>\n        <div class=\"placeholder ph-tool\">[Photo: 内六角扳手]</div>\n        <div class=\"desc\">\n          <p><b>用途：</b>拧内六角螺丝</p>\n          <p><b>用法：</b>选择合适尺寸，插入<br>螺丝孔中旋转拧紧或松开。</p>\n        </div>\n      </td>\n    </tr>\n  </table>\n  </div>\n\n  <!-- Banner 2 -->\n  <div class=\"banner\"><span>电工工具使用小教程</span></div>\n\n  <!-- Tutorials -->\n  <div class=\"tut-wrap\">\n    <div class=\"tut\">\n      <h4>1. 测电笔使用</h4>\n      <div class=\"placeholder ph-tut\">[Photo: 手持测电笔插入插座]</div>\n      <p>手指接触笔尾金属，笔尖接触插孔，氖管亮表示该孔为火线。</p>\n    </div>\n    <div class=\"tut\">\n      <h4>2. 剥线钳使用</h4>\n      <div class=\"placeholder ph-tut\">[Photo: 剥线钳剥导线]</div>\n      <p>将导线放入对应线号的剥线口，轻压旋转即可剥离绝缘层。</p>\n    </div>\n    <div class=\"tut\">\n      <h4>3. 万用表测电压</h4>\n      <div class=\"placeholder ph-tut\">[Photo: 万用表测量电压]</div>\n      <p>调至交流电压档，将表笔分别接触火线和零线，读数即为电压值。</p>\n    </div>\n    <div class=\"tut\">\n      <h4>4. 电烙铁焊接</h4>\n      <div class=\"placeholder ph-tut\">[Photo: 电烙铁在电路板焊接]</div>\n      <p>电烙铁加热后，先加热焊点，再送入焊锡丝，待焊锡融化后移开焊锡丝。</p>\n    </div>\n    <div class=\"tut\">\n      <h4>5. 绝缘胶带包扎</h4>\n      <div class=\"placeholder ph-tut\">[Photo: 胶带缠绕导线接头]</div>\n      <p>将胶带拉紧缠绕在接头处，覆盖所有裸露导体，确保绝缘可靠。</p>\n    </div>\n    <div class=\"tut\">\n      <h4>6. 热缩管使用</h4>\n      <div class=\"placeholder ph-tut\">[Photo: 热缩管套在导线接头]</div>\n      <p>将热缩管套在接头处，用热风枪加热均匀，直至完全收缩贴合。</p>\n    </div>\n  </div>\n\n  <!-- Safety -->\n  <div class=\"safety\">\n    <div class=\"safety-badge\">\n      <div class=\"tri\">⚠</div>\n      安全使用提示\n    </div>\n    <div class=\"safety-list\">\n      <div class=\"safety-col\">\n        <div><span class=\"snum\">1</span>施工前务必断电，确认无电再操作。</div>\n        <div><span class=\"snum\">2</span>使用测电笔、万用表前先确认工具完好。</div>\n        <div><span class=\"snum\">3</span>工具使用后及时整理，避免遗失或损坏。</div>\n      </div>\n      <div class=\"safety-col\">\n        <div><span class=\"snum\">4</span>电工刀使用时刀口朝外，避免划伤。</div>\n        <div><span class=\"snum\">5</span>高处作业注意安全，佩戴安全带。</div>\n        <div><span class=\"snum\">6</span>非专业人员请勿带电操作，确保人身安全。</div>\n      </div>\n    </div>\n    <div class=\"helmet placeholder\">\n      [Icon: 安全帽与盾牌]<br><b>安全第一<br>规范操作</b>\n    </div>\n  </div>\n\n  <div class=\"watermark\">北区教育</div>\n\n</div>\n</div>\n</body>\n</html>"
      },
