 }\n  .c4 { flex: 1; }\n  .placeholder {\n    border: 1px dashed #b3a8a8;\n    color: #8a7f7f;\n    font-size: 11px;\n    text-align: center;\n    box-sizing: border-box;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .ph-top-right {\n    position: absolute;\n    top: 0;\n    right: 0;\n    width: 70px;\n    height: 60px;\n    background: #cfd3d6;\n  }\n  .ph-mid-right {\n    position: absolute;\n    top: 300px;\n    right: 0;\n    width: 26px;\n    height: 120px;\n    background: #dcdcdc;\n  }\n  .ph-bottom-right {\n    position: absolute;\n    top: 470px;\n    right: 0;\n    width: 34px;\n    height: 200px;\n    background: #e7dede;\n  }\n  .brace {\n    font-size: 60px;\n    line-height: 1;\n    color: #333;\n    margin-right: 4px;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"placeholder ph-top-right\">[Photo edge: top-right, desk/table surface]</div>\n  <div class=\"placeholder ph-mid-right\">[Photo edge: middle-right, background object]</div>\n  <div class=\"placeholder ph-bottom-right\">[Photo edge: bottom-right, paper/object]</div>\n\n  <!-- Section 1 -->\n  <div class=\"sec\">\n    <div class=\"num pink\">1.</div>\n    <div>\n      <div class=\"row\">\n        <span class=\"pink\">A가 B가</span>\n        <span class=\"pink\">A은/는 B이/가 아닙니다</span>\n      </div>\n      <div class=\"item small ink\">(저는) 학생이 아닙니다.</div>\n      <div class=\"item indent1 ink\">我不是学生.</div>\n      <div class=\"item indent1 ink\" style=\"margin-top:14px;\">이 사람은 가수가 아닙니다.</div>\n      <div class=\"item indent3 ink\">这个人不是歌手.</div>\n    </div>\n  </div>\n\n  <!-- Section 2 -->\n  <div class=\"sec\">\n    <div class=\"num pink\">2.</div>\n    <div>\n      <div class=\"pink\" style=\"font-size:15px;\">“ㄱ”的发音规则</div>\n\n      <div class=\"item indent1 blue\">① 当“ㄱ”位于词首并遇到“ㅇ”时 · 发[ㄱ]</div>\n      <div class=\"item indent4 red\">의사 · 의자</div>\n\n      <div class=\"item indent1 blue\">② 当“ㄱ”位于词中或遇到其他辅音时 · [ㄱ]</div>\n      <div 