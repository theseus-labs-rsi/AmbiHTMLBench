le=\"width:52px\">\n      <col style=\"width:58px\">\n      <col style=\"width:58px\">\n      <col style=\"width:58px\">\n    </colgroup>\n\n    <tr>\n      <td class=\"colhead\" colspan=\"2\">四幕结构定义</td>\n      <td class=\"colhead\">开端</td>\n      <td class=\"colhead\" colspan=\"5\">＜第二幕＞追求自在存在欲望</td>\n    </tr>\n    <tr>\n      <td class=\"colhead\" colspan=\"2\" style=\"background:#e6eee5;\"></td>\n      <td class=\"numhead\">(7)</td>\n      <td class=\"numhead\">(8)</td>\n      <td class=\"numhead\">(9)</td>\n      <td class=\"numhead\">(10)</td>\n      <td class=\"numhead\">(11)</td>\n      <td class=\"numhead\">(12)</td>\n    </tr>\n\n    <tr>\n      <td class=\"sidehead\" rowspan=\"3\">主要情节</td>\n      <td class=\"rowhead\">单元格定义</td>\n      <td>采取关键行动（做出决定）</td>\n      <td>主人公的资格考验+B故事开始</td>\n      <td>恶魔之爪（反派登场）</td>\n      <td>C故事的配角参与进来(C故事的配角并不参与故事结局）</td>\n      <td>与反派的斗争→实现自在存在欲望（错觉/误判）</td>\n      <td>陷入危机与挫折中</td>\n    </tr>\n    <tr>\n      <td class=\"rowhead\">故事（外在）事件</td>\n      <td>进入欲望的空间</td>\n      <td colspan=\"5\">用3~5个单元格号主要故事</td>\n    </tr>\n    <tr>\n      <td class=\"rowhead\">主人公（内在）情感</td>\n      <td>好吧，我再试一试吧！还有什么是我做不了的呢？</td>\n      <td colspan=\"4\">虽然看似以平静的观点和态度去追求和实现外在目标(欲望的对象），但出现了令人恐惧和担心的状况，又陷入挫折和危机中</td>\n      <td>看似自在存在欲望要实现了，但那只是错觉!危机和挫折到来</td>\n    </tr>\n\n    <tr>\n      <td class=\"sidehead\" rowspan=\"2\">次要情节</td>\n      <td class=\"rowhead\">B故事（浪漫／次要情节）</td>\n      <td></td>\n      <td>与B故事人物的关系开始（开始不愉快的同居）</td>\n      <td></td>\n      <td></td>\n      <td>B故事人物对主人公的感情变为好感</td>\n      <td></td>\n    </tr>\n    <tr>\n      <td class=\"rowhead\">C故事（助推人物情节）</td>\n      <td></td>\n      <td>考验官（考验事件）</td>\n      <td></td>\n      <td>C故事的配角开始合流</td>\n      <td></td>\n      <td>导师退场（死亡｜离别）</td>\n    </tr>\n\n    <tr class=\"durrow\">\n      <td class=\"rowhead\" colspan=\"2\">时长进度(±5%)</td>\n      <td class=\"pct\">25%</td>\n      <td class=\"pct\" colspan=\"5\">25%—50%</td>\n    </tr>\n  </table>\n</div>\n</body>\n<