        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>宝宝腹泻怎么办</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$','$']], displayMath: [['$$','$$']] }\n};\n</script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    padding: 0;\n    background: #e9e2f7;\n    font-family: \"PingFang SC\", \"Microsoft YaHei\", \"Heiti SC\", sans-serif;\n  }\n  .page {\n    width: 540px;\n    margin: 0 auto;\n    padding: 14px 14px 22px 14px;\n    background: #e9e2f7;\n  }\n  .main-title {\n    text-align: center;\n    font-size: 44px;\n    font-weight: 900;\n    color: #7b3fbf;\n    letter-spacing: 2px;\n    margin: 6px 0 18px 0;\n    -webkit-text-stroke: 6px #ffffff;\n    paint-order: stroke fill;\n  }\n  .grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    column-gap: 12px;\n    row-gap: 16px;\n  }\n  .card {\n    background: #f3eefc;\n    border-radius: 14px;\n    padding: 10px 10px 12px 10px;\n  }\n  .card-title {\n    text-align: center;\n    font-size: 23px;\n    font-weight: 800;\n    color: #7b3fbf;\n    background: #ddd0f2;\n    border-radius: 10px;\n    padding: 5px 4px;\n    margin-bottom: 10px;\n    letter-spacing: 1px;\n  }\n  .row {\n    display: flex;\n    align-items: flex-start;\n    margin-bottom: 8px;\n  }\n  .tag {\n    flex: 0 0 auto;\n    display: inline-block;\n    font-size: 15px;\n    font-weight: 700;\n    color: #7b3fbf;\n    background: #ffffff;\n    border: 1.5px solid #b48ee0;\n    border-radius: 6px;\n    padding: 2px 5px;\n    margin-right: 7px;\n    line-height: 1.15;\n    white-space: nowrap;\n  }\n  .txt {\n    font-size: 15px;\n    color: #3f2a5c;\n    line-height: 1.35;\n    padding-top: 2px;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"main-title\">宝宝腹泻怎么办</div>\n\n  <div class=\"grid\">\n\n    <div class=\"card\">\n      <div class=\"card-title\">病毒性腹泻</div>\n      <div class=\"row\"><span class=\"tag\">原因</span><span class=\"txt\">轮状病毒引起秋冬季多发</span></div>\n      <div class=\"row\"><span class=\"tag\">症状</span><span class=\"txt\">呕吐发烧，上呼吸道感染</span></div>\n      <div class=\"row\"><span class=\"tag\">大便</span><span class=\"txt\">大便呈水样</span></div>\n      <div class=\"row\"><span class=\"tag\">护理</span><span class=\"txt\">辅食清淡易消化</span></div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"card-title\">过敏性腹泻</div>\n      <div class=\"row\"><span class=\"tag\">原因</span><span class=\"txt\">食物中的蛋白质过敏</span></div>\n      <div class=\"row\"><span class=\"tag\">症状</span><span class=\"txt\">湿疹、荨麻疹、哮喘</span></div>\n      <div class=\"row\"><span class=\"tag\">大便</span><span class=\"txt\">大便增多，无明显水便便</span></div>\n      <div class=\"row\"><span class=\"tag\">护理</span><span class=\"txt\">辅食避开过敏原，<br>换深度水解奶粉</span></div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"card-title\">喂养不当腹泻</div>\n      <div class=\"row\"><span class=\"tag\">原因</span><span class=\"txt\">辅食添加过早过杂致消化不良</span></div>\n      <div class=\"row\"><span class=\"tag\">症状</span><span class=\"txt\">呕吐，哭闹</span></div>\n      <div class=\"row\"><span class=\"tag\">大便</span><span class=\"txt\">有泡沫，混有颗粒物/黏液</span></div>\n      <div class=\"row\"><span class=\"tag\">护理</span><span class=\"txt\">暂停或减少辅食，清淡<br>饮食，少量多次治疗</span></div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"card-title\">细菌性腹泻</div>\n      <div class=\"row\"><span class=\"tag\">原因</span><span class=\"txt\">病原微生物引起在夏季高发</span></div>\n      <div class=\"row\"><span class=\"tag\">症状</span><span class=\"txt\">腹痛恶心，发热，没食欲</span></div>\n      <div class=\"row\"><span class=\"tag\">大便</span><span class=\"txt\">大便稀且有黏液，严重时便血</span></div>\n      <div class=\"row\"><span class=\"tag\">护理</span><span class=\"txt\">补液避免脱水，<br>注意饮食卫生</span></div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"card-title\">乳糖不耐受腹泻</div>\n      <div class=\"row\"><span class=\"tag\">原因</span><span class=\"txt\">由于肠道中缺乏乳糖酶引起</span></div>\n      <div class=\"row\"><span class=\"tag\">症状</span><span class=\"txt\">肠胀气、肠绞痛，吃奶就拉</span></div>\n      <div class=\"row\"><span class=\"tag\">大便</span><span class=\"txt\">次数多，大便有奶瓣泡沫状</span></div>\n      <div class=\"row\"><span class=\"tag\">护理</span><span class=\"txt\">母乳妈妈忌口高糖和奶制品</span></div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"card-title\">受凉引起腹泻</div>\n      <div class=\"row\"><span class=\"tag\">原因</span><span class=\"txt\">由腹部或身体受凉引起</span></div>\n      <div class=\"row\"><span class=\"tag\">症状</span><span class=\"txt\">胃胀，恶心，呕吐，屁多</span></div>\n      <div class=\"row\"><span class=\"tag\">大便</span><span class=\"txt\">大便水样，有泡沫</span></div>\n      <div class=\"row\"><span class=\"tag\">护理</span><span class=\"txt\">注意身体和肚子保暖，<br>不吃生冷辛辣</span></div>\n    </div>\n\n  </div>\n</div>\n</body>\n</html>"
