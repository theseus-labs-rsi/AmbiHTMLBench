        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>全屋清洁检查清单</title>\n<script src=\"https://polyfill.io/v3/polyfill.min.js?features=es6\"></script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    padding: 18px 16px 24px;\n    background: #f2f0ee;\n    font-family: \"PingFang SC\", \"Microsoft YaHei\", \"Heiti SC\", sans-serif;\n    color: #2b2b2b;\n    max-width: 560px;\n  }\n  .header {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    margin-bottom: 16px;\n  }\n  .placeholder {\n    background: #f7e9ec;\n    border: 1px solid #e3d3d6;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    font-size: 9px;\n    color: #8a7a7d;\n    line-height: 1.3;\n    flex: 0 0 auto;\n  }\n  .receipt-ph {\n    width: 74px;\n    height: 62px;\n  }\n  h1 {\n    font-size: 34px;\n    font-weight: 900;\n    margin: 0;\n    letter-spacing: 1px;\n    color: #1c1c1c;\n    -webkit-text-stroke: 0.5px #1c1c1c;\n  }\n  .grid {\n    display: grid;\n    grid-template-columns: 1fr 1.15fr 1fr;\n    gap: 10px;\n    align-items: start;\n  }\n  .card {\n    background: #fbfaf9;\n    border: 1px solid #e7e4e1;\n    border-radius: 4px;\n    padding: 10px 8px 12px;\n  }\n  .card h2 {\n    font-size: 15px;\n    font-weight: 800;\n    margin: 0 0 8px 2px;\n  }\n  ul {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n  }\n  li {\n    display: flex;\n    align-items: flex-start;\n    gap: 6px;\n    font-size: 11.5px;\n    line-height: 1.35;\n    padding: 3.5px 0;\n  }\n  .box {\n    flex: 0 0 auto;\n    width: 11px;\n    height: 11px;\n    border: 1px solid #9a9a9a;\n    border-radius: 50%;\n    margin-top: 2px;\n  }\n  .note {\n    font-size: 11px;\n    padding-left: 17px;\n    line-height: 1.35;\n    color: #2b2b2b;\n  }\n  .footer {\n    margin-top: 18px;\n    padding-left: 6px;\n  }\n  .footer p {\n    margin: 6px 0;\n    font-size: 15px;\n    font-weight: 800;\n    color: #c26a86;\n  }\n</style>\n</head>\n<body>\n\n<div class=\"header\">\n  <div class=\"placeholder receipt-ph\">[Image: receipt illustration, top-left]</div>\n  <h1>全屋清洁检查清单</h1>\n</div>\n\n<div class=\"grid\">\n\n  <!-- Column 1 -->\n  <div>\n    <div class=\"card\">\n      <h2>阳台清洁</h2>\n      <ul>\n        <li><span class=\"box\"></span><span>剪掉植物枯枝叶</span></li>\n        <li><span class=\"box\"></span><span>阳台灰尘及泥土清扫</span></li>\n        <li><span class=\"box\"></span><span>阳台置物架清洁</span></li>\n        <li><span class=\"box\"></span><span>洗衣机深度清洗内部</span></li>\n        <li><span class=\"box\"></span><span>阳台晾衣杆擦一遍</span></li>\n        <li><span class=\"box\"></span><span>地面冲洗清洁</span></li>\n      </ul>\n    </div>\n\n    <div class=\"card\" style=\"margin-top:10px;\">\n      <h2>客厅清洁</h2>\n      <ul>\n        <li><span class=\"box\"></span><span>所有抽屉柜子物品整理</span></li>\n        <li><span class=\"box\"></span><span>沙发表面深度清洁</span></li>\n        <li><span class=\"box\"></span><span>地毯清洁杀菌</span></li>\n        <li><span class=\"box\"></span><span>客厅所有灯具清洁</span></li>\n        <li><span class=\"box\"></span><span>家居表面清洁擦拭</span></li>\n        <li><span class=\"box\"></span><span>小摆件清洁擦拭</span></li>\n        <li><span class=\"box\"></span><span>客厅角落及缝隙清洁</span></li>\n        <li><span class=\"box\"></span><span>地面深度清洁杀菌</span></li>\n      </ul>\n    </div>\n  </div>\n\n  <!-- Column 2 -->\n  <div>\n    <div class=\"card\">\n      <h2>全屋除灰大作战</h2>\n      <ul>\n        <li><span class=\"box\"></span><span>全屋天花板除尘</span></li>\n        <li><span class=\"box\"></span><span>窗帘杆及窗帘除尘</span></li>\n        <li><span class=\"box\"></span><span>户外栏杆擦拭</span></li>\n        <li><span class=\"box\"></span><span>湿布擦拭所有纱窗</span></li>\n        <li><span class=\"box\"></span><span>鱼