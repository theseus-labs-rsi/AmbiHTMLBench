        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Political Poster Show — SF Art Commission Gallery, 1977</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] }\n};\n</script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  html, body {\n    margin: 0;\n    padding: 0;\n    background: #6b6b6b;\n  }\n  body {\n    font-family: \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n    display: flex;\n    justify-content: center;\n  }\n  .poster {\n    position: relative;\n    width: 466px;\n    background: #2b211c;\n    padding: 16px 0 6px 0;\n    box-sizing: border-box;\n    text-align: center;\n    overflow: hidden;\n  }\n\n  /* ---------- Top header block ---------- */\n  .hdr-line1 {\n    color: #e0491f;\n    font-weight: 800;\n    font-size: 20px;\n    letter-spacing: 0.5px;\n    margin: 6px 0 2px 0;\n  }\n  .hdr-line2 {\n    color: #e0491f;\n    font-weight: 800;\n    font-size: 33px;\n    letter-spacing: 0.5px;\n    margin: 2px 0 2px 0;\n  }\n  .hdr-line3 {\n    color: #e0491f;\n    font-weight: 800;\n    font-size: 21px;\n    letter-spacing: 0.3px;\n    margin: 2px 0 10px 0;\n  }\n\n  /* ---------- Main title ---------- */\n  .title {\n    color: #f0a51e;\n    font-weight: 800;\n    font-size: 56px;\n    line-height: 0.98;\n    letter-spacing: 0.5px;\n    margin: 14px 0 18px 0;\n  }\n\n  /* ---------- Subtitle ---------- */\n  .subtitle {\n    color: #efefe6;\n    font-weight: 700;\n    font-size: 21px;\n    line-height: 1.15;\n    letter-spacing: 0.3px;\n    margin: 10px 0 14px 0;\n  }\n\n  /* ---------- Inner reproduced poster (image zone) ---------- */\n  .inner-poster {\n    position: relative;\n    width: 404px;\n    height: 508px;\n    margin: 0 auto 12px auto;\n    background: linear-gradient(to bottom, #e8611c 0%, #d8331f 32%, #c9241d 52%, #d9701a 72%, #e59a1c 88%, #eaa61d 100%);\n    overflow: hidden;\n  }\n  .inner-text {\n    position: relative;\n    z-index: 2;\n    padding: 14px 10px 0 12px;\n    color: #1b1512;\n    font-weight: 800;\n    text-align: left;\n  }\n  .it-1 {\n    font-size: 42px;\n    line-height: 1.0;\n    letter-spacing: -0.5px;\n  }\n  .it-1 .small {\n    font-size: 25px;\n  }\n  .it-2 {\n    font-size: 35px;\n    line-height: 1.05;\n    letter-spacing: -0.5px;\n    margin-top: 4px;\n  }\n  .it-3 {\n    font-size: 33px;\n    line-height: 1.05;\n    letter-spacing: -0.5px;\n    margin-top: 4px;\n  }\n\n  /* Placeholder for the linocut illustration of three figures */\n  .placeholder {\n    position: absolute;\n    left: 10px;\n    bottom: 0;\n    width: 384px;\n    height: 268px;\n    box-sizing: border-box;\n    border: 1px dashed rgba(27,21,18,0.75);\n    background: rgba(27,21,18,0.18);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    color: #1b1512;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 0.3px;\n    z-index: 1;\n  }\n  .placeholder figcaption {\n    margin: 0;\n    padding: 0 10px;\n    line-height: 1.35;\n  }\n\n  /* ---------- Dates block ---------- */\n  .dates {\n    margin: 12px 0 4px 0;\n  }\n  .d-month {\n    color: #f0a51e;\n    font-weight: 800;\n    font-size: 34px;\n    letter-spacing: 0.5px;\n    margin-bottom: 4px;\n  }\n  .d-hours {\n    color: #efefe6;\n    font-weight: 800;\n    font-size: 22px;\n    letter-spacing: 0.2px;\n    margin: 3px 0;\n  }\n  .d-hours .pm {\n    font-size: 14px;\n  }\n\n  /* ---------- Opening block ---------- */\n  .opening {\n    color: #f0a51e;\n    font-weight: 800;\n    font-size: 32px;\n    letter-spacing: 0.5px;\n    margin: 20px 0 4px 0;\n  }\n  .opening-when {\n    color: #efefe6;\n    font-weight: 800;\n    font-size: 22px;\n    letter-spacing: 0.3px;\n    margin: 2px 0 0 0;\n  }\n  .opening-when .sup { font-size: 13px; }\n  .opening-when .pm { font-size: 13px; }\n  .opening-when .gap { display: inline-block; width: 26px; }\n\n  /* ---------- Footer rule + fine print ---------- */\n  .footer-rule {\n    width: 404px;\n    height: 1px;\n    background: #7a4a2a;\n    margin: 18px auto 8px auto;\n  }\n  .fineprint {\n    color: #c98a55;\n    font-size: 11px;\n    letter-spacing: 0.6px;\n    font-weight: 500;\n    margin: 0 0 4px 0;\n  }\n  .tinyprint {\n    color: #8a5a38;\n    font-size: 6px;\n    letter-spacing: 0.4px;\n    margin: 2px 0 0 0;\n  }\n</style>\n</head>\n<body>\n\n<div class=\"poster\">\n\n  <div class=\"hdr-line1\">SF ART COMMISSION GALLERY</div>\n  <div class=\"hdr-line2\">CAPRICORN ASUNDER</div>\n  <div class=\"hdr-line3\">165 GROVE STREET SAN FRANCISCO</div>\n\n  <div class=\"title\">POLITICAL<br>POSTER<br>SHOW</div>\n\n  <div class=\"subtitle\">THE WORK OF POSTER MAKERS<br>IN SAN FRANCISCO 1977</div>\n\n  <div class=\"inner-poster\">\n    <div class=\"inner-text\">\n      <div class=\"it-1\">ViCTORY <span class=\"small\">TO THE</span></div>\n      <div class=\"it-2\">FREEDOM FIGHTERS</div>\n      <div class=\"it-3\">OF SOUTHERN AFRICA</div>\n    </div>\n\n    <figure class=\"placeholder\">\n      <figcaption>[Illustration: bold black-and-white linocut portrait of three figures — a woman in a patterned headscarf at left, a central figure in a dark head covering, and a third figure at right — occupying the lower half of the inner poster, centered]</figcaption>\n    </figure>\n  </div>\n\n  <div class=\"dates\">\n    <div class=\"d-month\">NOVEMBER 4-27</div>\n    <div class=\"d-hours\">MONDAY-FRIDAY 10-4:30<span class=\"pm\">PM</span></div>\n    <div class=\"d-hours\">SATURDAY AND SUNDAY 12-5<span class=\"pm\">PM</span></div>\n  </div>\n\n  <div class=\"opening\">OPENING</div>\n  <div class=\"opening-when\">FRIDAY NOV 4<span class=\"sup\">TH</span><span class=\"gap\"></span>7-11 <span class=\"pm\">PM</span></div>\n\n  <div class=\"footer-rule\"></div>\n  <