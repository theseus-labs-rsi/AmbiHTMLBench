        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>第九章 学校财产与财务管理 / 第十章 学校德育管理</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$','$']], displayMath: [['$$','$$']] }\n};\n</script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  body {\n    font-family: \"SimSun\", \"宋体\", serif;\n    background: #fff;\n    color: #000;\n    margin: 0;\n    padding: 10px;\n    font-size: 13px;\n    line-height: 1.5;\n  }\n  .page { width: 560px; margin: 0 auto; }\n\n  /* 章节整体：左侧竖排标题 + 右侧内容 */\n  .chapter {\n    display: flex;\n    align-items: stretch;\n    border: 1px solid #000;\n    margin-bottom: 18px;\n  }\n  .chapter-title {\n    writing-mode: vertical-rl;\n    text-orientation: upright;\n    font-weight: bold;\n    font-size: 15px;\n    letter-spacing: 3px;\n    text-align: center;\n    padding: 6px 4px;\n    border-right: 1px solid #000;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    min-width: 26px;\n  }\n  .chapter-body { flex: 1; }\n\n  /* 第二级分组：竖排小标题 + 条目 */\n  .group {\n    display: flex;\n    align-items: stretch;\n    border-bottom: 1px solid #000;\n  }\n  .group:last-child { border-bottom: none; }\n  .group-label {\n    writing-mode: vertical-rl;\n    text-orientation: upright;\n    font-weight: bold;\n    text-align: center;\n    padding: 4px 3px;\n    border-right: 1px solid #000;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    min-width: 22px;\n  }\n  .group-items { flex: 1; }\n\n  /* 每一行：小标签 + 内容 */\n  .row {\n    display: flex;\n    align-items: stretch;\n    border-bottom: 1px solid #000;\n  }\n  .row:last-child { border-bottom: none; }\n  .row-label {\n    writing-mode: vertical-rl;\n    text-orientation: upright;\n    text-align: center;\n    padding: 3px 2px;\n    border-right: 1px solid #000;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    min-width: 20px;\n    white-space: nowrap;\n  }\n  .row-label.h {\n    writing-mode: horizontal-tb;\n    min-width: 44px;\n  }\n  .row-text { flex: 1; padding: 3px 6px; }\n  .row-text p { margin: 0 0 1px 0; }\n  .indent { text-indent: 0; }\n  .blue { color: #1a1aff; }\n  .footer-note { padding: 4px 6px; }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <!-- 第九章 -->\n  <div class=\"chapter\">\n    <div class=\"chapter-title\">第九章　学校财产与财务管理</div>\n    <div class=\"chapter-body\">\n\n      <div class=\"group\">\n        <div class=\"group-label\">财产<br>管理</div>\n        <div class=\"group-items\">\n          <div class=\"row\">\n            <div class=\"row-label h\">含义：</div>\n            <div class=\"row-text\">\n              <p>对学校物质财富的计划组织、使用保管活动。</p>\n              <p>包括固定资产和流动资产。</p>\n            </div>\n          </div>\n          <div class=\"row\">\n            <div class=\"row-label h\">内容：</div>\n            <div class=\"row-text\"><p>目标；制度；账务；添置；维修。</p></div>\n          </div>\n          <div class=\"row\">\n            <div class=\"row-label h\">原则：</div>\n            <div class=\"row-text\"><p>物尽其用；建章立制；帐物相符；管理育人。</p></div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"group\">\n        <div class=\"group-label\">财务<br>管理</div>\n        <div class=\"group-items\">\n          <div class=\"row\">\n            <div class=\"row-label h\">含义：</div>\n            <div class=\"row-text\"><p>指学校资金运转中的计划组织和控制。</p></div>\n          </div>\n          <div class=\"row\">\n            <div class=\"row-label\">内容</div>\n            <div class=\"row-text\">\n              <p>预算管理：按一定程序和方法核定的年度收</p>\n              <p>支计划；</p>\n              <p>收入管理：对学校收入的计划组织和控制，</p>\n              <p>包括财政收入、经营收入、学杂费等收入；</p>\n              <p>支出管理：经费支出的计划组织和控制；</p>\n              <p>资金管理：现金、银行存款、往来管理；</p>\n              <p>财务报表：收支、因素、结果分析；</p>\n              <p>财务制度和财务监督：财务人员要求：持证</p>\n              <p>上岗、坚持原则、作风正派、履行职责；财</p>\n              <p>务监督通过财务审计执行。</p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n    </div>\n  </div>\n\n  <!-- 第十章 -->\n  <div class=\"chapter\">\n    <div class=\"chapter-title\">第十章　学校德育管理</div>\n    <div class=\"chapter-body\">\n\n      <div class=\"group\">\n        <div class=\"group-label\">地位<br>与<br>特点</div>\n        <div class=\"group-items\">\n          <div class=\"row\">\n            <div class=\"row-label h\"><span class=\"blue\">含义：</span></div>\n            <div class=\"row-text\">\n              <p><span class=\"blue\">德育即思想品德教育（育德）</span>，包括政治教育、思想教</p>\n              <p>育、品德教育、法纪教育、心理教育。<span class=\"blue\">德育管理</span>：即</p>\n              <p>德育管理者运用方法手段，…资源，……目标。</p>\n            </div>\n          </div>\n          <div class=\"row\">\n            <div class=\"row-label h\"><span class=\"blue\">地位</span></div>\n            <div class=\"row-text\">\n              <p><span class=\"blue\">（学校管理中的德育的关系）</span>：学校管理包含德育管理；相</p>\n              <p>互制约影响；相互渗透；相互促进。</p>\n            </div>\n          </div>\n          <div class=\"row\">\n            <div class=\"row-label h\"><span class=\"blue\">特点</span></div>\n            <div class=\"row-text\">\n              <p>方向性；教育性；伦理性；全员性。</p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"group\">\n        <div class=\"group-label\">要素<br>与<br>层次</div>\n        <div class=\"group-items\">\n          <div class=\"row\">\n            <div class=\"row-label h\"><span class=\"blue\">要素</span></div>\n            <div class=\"row-text\">\n              <p>德育管理目标：具有定向、调节、评价作用；</p>\n              <p>德育管理主体：组织机构；自我管理；</p>\n              <p>德育管理客体：人、财、物、课程、时空等资源；</p>\n              <p>德育管理制度：中央到地方文件，学校与班级的规章</p>\n            </div>\n          </div>\n          <div class=\"row\">\n            <div class=\"row-label h\"><span class=\"blue\">层次</span></div>\n            <div class=\"row-text\">\n              <p><span class=\"blue\">学校上层是核心定方向；学校中层是枢纽抓落实；学校基</span></p>\n              <p><span class=\"blue\">层及班级是基本单位执行者。</span></p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"group\">\n        <div class=\"group-label\">机制<br>与<br>实施</div>\n        <div class=\"group-items\">\n          <div class=\"row\">\n            <div class=\"row-label h\"><span class=\"blue\">机制：</span></div>\n            <div class=\"row-text\">\n              <p>德育要素进行相互作用、耦合、联系的运作方式。</p>\n            </div>\n          </div>\n          <div class=\"row\">\n            <div class=\"row-label h\"><span class=\"blue\">实施</span></div>\n            <div class=\"row-text\">\n              <p>导向机制：目标、舆论、行为、评价等导向；</p>\n              <p>动力机制：奖惩、竞争、意义或价值等激励；</p>\n              <p>协调机制：情境、文化协调；</p>\n              <p>约束机制：法规、道德约束。</p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"footer-note\">\n        <p><span class=\"blue\">提高德育德育管理者能力的途径：（1）提升管理水平（理念、方法、</span></p>\n        <p><span class=\"blue\">道德）；（2）提高教育素养（教育观、教育理论）；（3）加强道德</span></p>\n        <p><span class=\"blue\">修养（把握方向、管理公正、以身作则、作风民主）</span></p>\n      </div>\n\n    </div>\n  </div>\n\n</div>\n</body>\n</html>"
