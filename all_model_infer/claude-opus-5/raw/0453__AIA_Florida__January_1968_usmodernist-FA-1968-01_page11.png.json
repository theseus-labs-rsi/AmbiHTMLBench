        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Commission Organizational Chart</title>\n<script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\" async></script>\n<style>\n  body {\n    font-family: \"Times New Roman\", Times, serif;\n    background: #fff;\n    color: #000;\n    margin: 0;\n    padding: 20px 30px 40px 30px;\n  }\n\n  .chart {\n    max-width: 1400px;\n    margin: 0 auto;\n  }\n\n  /* ---- Top connector lines ---- */\n  .top-stem {\n    width: 2px;\n    height: 28px;\n    background: #000;\n    margin: 0 auto;\n  }\n\n  .horiz-bus {\n    position: relative;\n    height: 2px;\n    background: #000;\n    margin: 0 8.5%;\n  }\n\n  .drop-row {\n    display: flex;\n    gap: 1.6%;\n    height: 40px;\n  }\n\n  .drop-cell {\n    flex: 1;\n    position: relative;\n  }\n\n  .drop-cell::before {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    left: 50%;\n    width: 2px;\n    height: 100%;\n    background: #000;\n  }\n\n  /* ---- Column layout ---- */\n  .columns {\n    display: flex;\n    gap: 1.6%;\n    align-items: flex-start;\n  }\n\n  .col {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n  }\n\n  .box {\n    border: 2px solid #000;\n    text-align: center;\n    padding: 14px 8px;\n  }\n\n  .head-box {\n    min-height: 230px;\n  }\n\n  .title {\n    font-size: 1.02em;\n    letter-spacing: 0.04em;\n    line-height: 1.35;\n    margin-bottom: 14px;\n  }\n\n  .name {\n    line-height: 1.3;\n    margin-bottom: 12px;\n  }\n\n  .name:last-child { margin-bottom: 0; }\n\n  .connector {\n    width: 2px;\n    height: 46px;\n    background: #000;\n    margin: 0 auto;\n  }\n\n  /* stacked sub-boxes share borders */\n  .stack {\n    border: 2px solid #000;\n  }\n\n  .stack .cell {\n    border-bottom: 2px solid #000;\n    padding: 18px 10px;\n    text-align: center;\n  }\n\n  .stack .cell:last-child 