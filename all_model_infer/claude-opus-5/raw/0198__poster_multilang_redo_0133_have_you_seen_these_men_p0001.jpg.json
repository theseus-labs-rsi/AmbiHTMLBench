        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Have You Seen These Men? — COBRA / NUS Poster, 1977</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$','$']], displayMath: [['$$','$$']] }\n};\n</script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  html, body {\n    margin: 0;\n    padding: 0;\n    background: #ffffff;\n    font-family: Helvetica, Arial, sans-serif;\n  }\n  .poster {\n    position: relative;\n    width: 1040px;\n    margin: 0 auto;\n    background: #f4e820;\n    padding: 18px 22px 10px 22px;\n    box-sizing: border-box;\n    overflow: hidden;\n  }\n  .headline {\n    font-family: Helvetica, Arial, sans-serif;\n    font-weight: bold;\n    letter-spacing: -1px;\n    color: #111;\n    text-align: center;\n    margin: 4px 0 10px 0;\n    font-size: 62px;\n    line-height: 1;\n  }\n  .mono {\n    font-family: \"Courier New\", Courier, monospace;\n  }\n\n  /* ---------- Top black panel ---------- */\n  .top-panel {\n    background: #111;\n    color: #fff;\n    margin: 0 18px;\n    padding: 8px 8px 12px 8px;\n  }\n  .photo-row {\n    display: flex;\n    gap: 12px;\n    justify-content: center;\n  }\n  .placeholder {\n    background: #d9d9d9;\n    border: 1px solid #555;\n    color: #333;\n    font-family: \"Courier New\", Courier, monospace;\n    font-size: 12px;\n    display: flex;\n    align-items: flex-end;\n    justify-content: center;\n    text-align: center;\n    padding: 4px;\n    box-sizing: border-box;\n  }\n  .photo-lky { width: 440px; height: 430px; }\n  .photo-ho  { width: 400px; height: 430px; }\n\n  .caption-row {\n    display: flex;\n    gap: 12px;\n    justify-content: center;\n    background: #fff;\n    color: #111;\n    padding: 6px 0 8px 0;\n  }\n  .cap-block { width: 440px; }\n  .cap-block.second { width: 400px; }\n  .cap-name {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 26px;\n    letter-spacing: 1px;\n    margin: 0 0 2px 6px;\n  }\n  .cap-lines {\n    font-family: \"Courier New\", Courier, monospace;\n    font-size: 13px;\n    line-height: 1.2;\n    margin-left: 6px;\n  }\n\n  .perp {\n    text-align: center;\n    font-weight: bold;\n    font-size: 40px;\n    line-height: 1.05;\n    letter-spacing: -0.5px;\n    margin: 8px 0 6px 0;\n  }\n  .perp-body {\n    font-family: \"Courier New\", Courier, monospace;\n    font-size: 19px;\n    line-height: 1.35;\n    margin: 0 0 0 40px;\n  }\n\n  /* ---------- THEY JAIL AND KILL PEOPLE ---------- */\n  .jail {\n    font-weight: bold;\n    font-size: 60px;\n    text-align: center;\n    letter-spacing: -1px;\n    margin: 14px 0 10px 0;\n    color: #111;\n  }\n\n  /* ---------- British connection panel ---------- */\n  .british-outer {\n    background: #111;\n    margin: 0 30px 0 60px;\n    padding: 6px;\n  }\n  .british {\n    background: #fff;\n    color: #111;\n    padding: 8px 14px 14px 14px;\n  }\n  .british h2 {\n    text-align: center;\n    font-size: 40px;\n    font-weight: bold;\n    margin: 4px 0 10px 0;\n    letter-spacing: -0.5px;\n  }\n  .rubber {\n    font-family: \"Courier New\", Courier, monospace;\n    font-size: 14px;\n    line-height: 1.3;\n    margin: 0 0 8px 250px;\n  }\n  .bc-row {\n    display: flex;\n    gap: 14px;\n    align-items: flex-start;\n  }\n  .photo-tapper { width: 200px; height: 210px; flex: 0 0 200px; }\n  .photo-soldiers { width: 215px; height: 195px; flex: 0 0 215px; }\n  .bc-mid {\n    flex: 1 1 auto;\n    font-family: \"Courier New\", Courier, monospace;\n    font-size: 14px;\n    line-height: 1.35;\n  }\n  .bc-mid p { margin: 0 0 16px 0; }\n  .bc-foot {\n    font-family: \"Courier New\", Courier, monospace;\n    font-size: 14px;\n    line-height: 1.35;\n    margin: 10px 0 0 180px;\n  }\n\n  /* ---------- Bottom section ---------- */\n  .bottom {\n    position: relative;\n    margin: 14px 0 0 0;\n    padding: 0 20px 10px 40px;\n  }\n  .believed {\n    font-weight: bold;\n    font-size: 47px;\n    line-height: 1.02;\n    letter-spacing: -1px;\n    color: #111;\n    margin: 0;\n    max-width: 720px;\n  }\n  .june {\n    font-weight: bold;\n    font-size: 47px;\n    letter-spacing: -1px;\n    margin: 4px 0 10px 0;\n  }\n  .published {\n    font-family: \"Courier New\", Courier, monospace;\n    font-size: 14px;\n    line-height: 1.3;\n  }\n\n  /* Diagonal picket banner, bottom-right */\n  .picket {\n    position: absolute;\n    right: -40px;\n    bottom: 20px;\n    width: 470px;\n    transform: rotate(-21deg);\n    transform-origin: right bottom;\n    background: #fff;\n    color: #111;\n    padding: 10px 14px;\n    box-sizing: border-box;\n    border-top: 2px solid #111;\n    border-bottom: 2px solid #111;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n  .picket-word {\n    font-weight: bold;\n    font-size: 40px;\n    letter-spacing: -1px;\n    flex: 0 0 auto;\n  }\n  .picket-right {\n    font-family: \"Courier New\", Courier, monospace;\n    font-size: 13px;\n    line-height: 1.3;\n  }\n  .picket-names {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 22px;\n    letter-spacing: 0.5px;\n    margin-bottom: 4px;\n  }\n</style>\n</head>\n<body>\n<div class=\"poster\">\n\n  <h1 class=\"headline\">HAVE YOU SEEN THESE MEN?</h1>\n\n  <div class=\"top-panel\">\n    <div class=\"photo-row\">\n      <figure class=\"placeholder photo-lky\" style=\"margin:0;\">[Photograph: black-and-white portrait of a man in suit, facing right — top-left]</figure>\n      <figure class=\"placeholder photo-ho\" style=\"margin:0;\">[Photograph: black-and-white portrait of a man in peaked cap and uniform, facing left — top-right]</figure>\n    </div>\n\n    <div class=\"caption-row\">\n      <div class=\"cap-block\">\n        <div class=\"cap-name\">LEE KUAN YEW</div>\n        <div class=\"cap-lines\">\n          Prime Minister of Singapore<br>\n          Graduate from CAMBRIDGE<br>\n          Worked for Japanese fascists in the 2nd World War.\n        </div>\n      </div>\n      <div class=\"cap-block second\">\n        <div class=\"cap-name\">HUSSEIN ONN</div>\n        <div class=\"cap-lines\">\n          Prime Minister of Malaysia<br>\n          Trained by the British army in Malaya,India,Middle-East<br>\n          Graduate from LINCOLN's INN (London)\n        </div>\n      </div>\n    </div>\n\n    <div class=\"perp\">\n      PERPETRATORS OF CRIMES AGAINST THE<br>\n      PEOPLE OF MALAYSIA AND SINGAPORE\n    </div>\n\n    <div class=\"perp-body\">\n      To maintain the interests of British and other foreign capital<br>\n      and the local elites, THEY<br>\n      : SUPPRESS workers' and peasants' rights.<br>\n      : BAN independent trade unions and student unions.<br>\n      : MANIPULATE judicial process.<br>\n      : SUPPRESS parliamentary democracy and press freedom.\n    </div>\n  </div>\n\n  <div class=\"jail\">THEY JAIL AND KILL PEOPLE</div>\n\n  <div class=\"british-outer\">\n    <div class=\"british\">\n      <h2>THE BRITISH CONNECTION</h2>\n\n      <div class=\"rubber\">\n        RUBBER AND TIN from colonial Malaya were crucial to British<br>\n        post-war recovery.\n      </div>\n\n      <div class=\"bc-row\">\n        <figure class=\"placeholder photo-tapper\" style=\"margin:0;\">[Photograph: rubber tapper working at a tree — left]</figure>\n        <div class=\"bc-mid\">\n          <p>\"Without Malaya, the Sterling System, as we know<br>\n             &nbsp;&nbsp;it could not exist.\" Purcell</p>\n          <p>A 12-year British Military Rule was imposed after<br>\n             the World War II to protect British economic interests.</p>\n          <p>Repressive laws were first introduced by the British<br>\n             colonial regime, then further improved by the local<br>\n             elites.</p>\n        </div>\n        <figure class=\"placeholder photo-soldiers\" style=\"margin:0;\">[Photograph: armed soldiers with a bicycle in jungle — right]</figure>\n      </div>\n\n      <div class=\"bc-foot\">\n        Though formally 'independent', Britain CONTINUES to exert influence<br>\n        and control through<br>\n        &nbsp;&nbsp;- Domination of the economies<br>\n        &nbsp;&nbsp;- Collaboration with the repressive regimes<br>\n        &nbsp;&nbsp;- Cultural subversion<br>\n        &nbsp;&nbsp;- Five-Power-Defence-Arrangement (U.K., Australia, New Zealand,<br>\n        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Malaysia and Singapore).\n      </div>\n    </div>\n  </div>\n\n  <div class=\"bottom\">\n    <div class=\"believed\">BELIEVED TO BE IN LONDON ATTENDING<br>THE COMMONWEALTH P.M. CONF.</div>\n    <div class=\"june\">JUNE 8-16, 1977</div>\n    <div class=\"published\">\n      Published by &nbsp;COBRA and NUS<br>\n      COBRA &nbsp;-Conference for Basic Human and Democratic Rights in the ASEAN alliance<br>\n      &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;6, Endsleigh Street &nbsp;&nbsp;London WC1\n    </div>\n\n    <div class=\"picket\">\n      <div class=\"picket-word\">PICKET</div>\n      <div class=\"picket-right\">\n        <div class=\"picket-names\">LEE AND HUSSEIN ONN</div>\n        Place: &nbsp;Parliament Square, London SW1<br>\n        Date: &nbsp;&nbsp;9th June 1977<br>\n        Time : &nbsp;5 to 9 p.m.<br>\n        SEND LETTERS/TELEGRAMS of protest<br>\n        &nbsp;&nbsp;c/o Commonwealth Secretariat,<br>\n        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Marlborough House,<br>\n        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;London SW1.<br>\n        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Copies to COBRA.\n      </div>\n    </div>\n  </div>\n\n</div>\n</body>\n</html>"
