        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Custom Docs UI Static Assets (Self-Hosting) - FastAPI</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$','$']], displayMath: [['$$','$$']] }\n};\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\" async></script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    font-family: Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    color: #1f2225;\n    background: #fff;\n    font-size: 15px;\n  }\n  code, pre, .mono { font-family: \"Roboto Mono\", \"SFMono-Regular\", Consolas, monospace; }\n\n  /* ---------- Announcement bar ---------- */\n  .announce {\n    background: #1e2129;\n    color: #fff;\n    height: 64px;\n    display: flex;\n    align-items: center;\n    padding: 0 26px 0 78px;\n    position: relative;\n    font-size: 14.5px;\n  }\n  .announce .conf { font-weight: 700; }\n  .announce .conf-rest { font-weight: 400; color: #f2f2f2; }\n  .sponsor-box {\n    position: absolute;\n    right: 90px;\n    top: 12px;\n    background: #fff;\n    border-radius: 6px;\n    height: 40px;\n    width: 320px;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    padding: 0 12px;\n  }\n  .sponsor-tag {\n    position: absolute;\n    top: -12px;\n    right: 8px;\n    background: #4a4f57;\n    color: #dcdcdc;\n    font-size: 10px;\n    border-radius: 4px 4px 0 0;\n    padding: 1px 7px;\n  }\n  .sponsor-logo {\n    width: 22px; height: 22px; border-radius: 50%;\n    background: #f5b301;\n    display: inline-block;\n  }\n  .sponsor-name { color: #16232e; font-weight: 700; font-size: 14px; }\n  .sponsor-text { color: #0f6fbe; font-weight: 700; font-size: 12.5px; line-height: 1.25; }\n\n  /* ---------- Header ---------- */\n  .header {\n    background: #009485;\n    color: #fff;\n    padding: 0 78px;\n  }\n  .header-top {\n    display: flex;\n    align-items: center;\n    height: 62px;\n    gap: 14px;\n  }\n  .logo-circle {\n    width: 30px; height: 30px; border-radius: 50%;\n    background: #fff; color: #009485;\n    display: flex; align-items: center; justify-content: center;\n    font-size: 17px; font-weight: 700;\n  }\n  .brand { font-size: 22px; font-weight: 500; letter-spacing: .2px; }\n  .header-spacer { flex: 1; }\n  .icon-btn { font-size: 17px; opacity: .95; }\n  .search-box {\n    background: rgba(255,255,255,.15);\n    border-radius: 4px;\n    height: 34px;\n    width: 178px;\n    display: flex;\n    align-items: center;\n    padding: 0 10px;\n    gap: 8px;\n    font-size: 14px;\n    color: #eafaf7;\n  }\n  .search-box .kbd { margin-left: auto; font-size: 12px; opacity: .85; }\n  .repo {\n    display: flex; align-items: center; gap: 8px;\n    margin-left: 22px; font-size: 13px;\n  }\n  .repo-icon { font-size: 20px; }\n  .repo-name { font-size: 13.5px; }\n  .repo-stats { font-size: 11.5px; display: flex; gap: 10px; margin-top: 3px; opacity: .95; }\n  .header-nav {\n    display: flex;\n    gap: 26px;\n    height: 48px;\n    align-items: center;\n    font-size: 14.5px;\n  }\n  .header-nav .active { font-weight: 700; }\n\n  /* ---------- Main 3-column layout ---------- */\n  .page {\n    display: flex;\n    padding: 40px 78px 0 78px;\n    gap: 0;\n    align-items: flex-start;\n  }\n  .sidebar-left { width: 250px; flex: 0 0 250px; padding-top: 4px; }\n  .content { flex: 1 1 auto; max-width: 690px; padding: 0 30px 0 50px; }\n  .sidebar-right { width: 250px; flex: 0 0 250px; padding-top: 4px; }\n\n  /* left nav */\n  .nav-title { font-weight: 700; margin-bottom: 14px; font-size: 14.5px; }\n  ul.navlist { list-style: none; margin: 0; padding: 0; font-size: 14.5px; }\n  ul.navlist li { margin: 0 0 12px 0; position: relative; }\n  ul.navlist a { color: #1f2225; text-decoration: none; }\n  ul.navlist .chev { position: absolute; right: 4px; top: 0; color: #4a4f57; font-size: 12px; }\n  ul.sub 