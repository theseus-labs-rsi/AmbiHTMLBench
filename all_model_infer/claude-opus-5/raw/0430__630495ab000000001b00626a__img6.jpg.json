 text-align: center;\n    line-height: 1.1;\n  }\n  .annot-3 {\n    position: absolute;\n    left: 285px;\n    top: 2px;\n    font-size: 5.5px;\n    color: #c00000;\n    font-weight: bold;\n  }\n  .citation {\n    text-align: right;\n    font-size: 8px;\n    font-weight: bold;\n    margin: 6px 14px 0 0;\n  }\n</style>\n</head>\n<body>\n\n<!-- ===== SLIDE 1 ===== -->\n<div class=\"slide slide1\">\n  <div class=\"header\">\n    <div class=\"tab\">Safety</div>\n    <div class=\"title\">Therapeutic effect</div>\n  </div>\n\n  <div class=\"clinical-title\"><span class=\"bullet\">·</span> &nbsp;In this clinical trial:</div>\n\n  <ol class=\"abc\" start=\"3\">\n    <li value=\"3\">Treatment-related events of grade ≥3 severity were noted for\n      <b>only 2 patients in the vaccinated group, with 1 case each of hypokalemia and rash.</b></li>\n    <li>1 patient in the vaccinated group discontinued treatment for grade 2 gastritis.</li>\n    <li>No treatment-related serious adverse events were observed.</li>\n  </ol>\n\n  <div class=\"footer-nav\">\n    <div class=\"item\">Background</div>\n    <div class=\"item\">Study Design</div>\n    <div class=\"item active\">Result</div>\n    <div class=\"item\">Conclusion</div>\n  </div>\n  <div class=\"page-num\">13</div>\n</div>\n\n<!-- ===== SLIDE 2 ===== -->\n<div class=\"slide slide2\">\n  <div class=\"header\">\n    <div class=\"tab\">Safety</div>\n    <div class=\"title bold\">Therapeutic effect</div>\n    <div class=\"arrow-mark\"></div>\n  </div>\n\n  <div class=\"slide2-body\">\n    <div class=\"left-col\">\n      <div class=\"annot-wrap\">\n        <span class=\"annot-1\">客观缓解率</span>\n        <span class=\"annot-2\">（中位）<br>无进展生存期</span>\n        <span class=\"annot-3\">1年total生存率</span>\n      </div>\n\n      <table class=\"data\">\n        <colgroup>\n          <col style=\"width:26%\"><col style=\"width:7%\"><col style=\"width:13%\">\n          <col style=\"width:11%\"><col style=\"width:15%\"><col style=\"width:16%\"><col style=\"width:12%\">\n        </colgroup>\n        <tr>\n          <th class=\"grouphead\" colspan=\"7\" style=\"text-align:left\">Melanoma</th>\n        </tr>\n        <tr>\n          <td class=\"nb\"></td>\n          <th>N</th>\n          <th>Follow<br>Up*</th>\n          <th>Prior<br>Therapy</th>\n          <th>ORR (months)</th>\n          <th>Median<br>PFS (months)</th>\n          <th>12-Month<br>OS</th>\n        </tr>\n        <tr>\n          <td class=\"rowhead\">ITT Set (NT-001)</td>\n          <td>34</td><td>20</td><td>41%</td>\n          <td>47%<br>(30%, 65%)</td>\n          <td>15.1<br>(4.3, NE)</td>\n          <td>85%<br>(68%, 94%)</td>\n        </tr>\n        <tr>\n          <td class=\"rowhead\">Vaccinated Set (NT-001)</td>\n          <td>27</td><td>20</td><td>30%</td>\n          <td>59%<br>(39%, 78%)</td>\n          <td>23.5<br>(6.6, NE)</td>\n          <td>96%<br>(76%, 99%)</td>\n        </tr>\n\n        <tr>\n          <th class=\"grouphead\" colspan=\"7\" style=\"text-align:left\">Non-Small Cell Lung Cancer</th>\n        </tr>\n        <tr>\n          <td class=\"nb\"></td>\n          <th>N</th>\n          <th>Follow<br>Up (months)</th>\n          <th>Prior<br>Therapy</th>\n          <th>ORR</th>\n          <th>Median<br>PFS (months)</th>\n          <th>12-Month<br>OS</th>\n        </tr>\n        <tr>\n          <td class=\"rowhead\">ITT Set (NT-001)</td>\n          <td>27</td><td>15</td><td>67%</td>\n          <td>26%<br>(11%, 46%)</td>\n          <td>4.4<br>(2.0, 8.5)</td>\n          <td>59%<br>(39%, 75%)</td>\n        </tr>\n        <tr>\n          <td class=\"rowhead\">Vaccinated Set (NT-001)</td>\n          <td>18</td><td>15</td><td>61%</td>\n          <td>39%<br>(17%, 64%)</td>\n          <td>8.5<br>(3.9, NE)</td>\n          <td>83%<br>(57%, 94%)</td>\n        </tr>\n\n        <tr>\n          <th class=\"grouphead\" colspan=\"7\" style=\"text-align:left\">Transitional Cell Carcinoma of the Bladder</th>\n        </tr>\n        <tr>\n         