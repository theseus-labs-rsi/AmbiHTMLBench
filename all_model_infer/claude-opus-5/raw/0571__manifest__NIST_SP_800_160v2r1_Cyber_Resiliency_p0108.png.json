        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>NIST SP 800-160, Vol. 2, Rev. 1 — Appendix D, Page 92</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] }\n};\n</script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  html, body {\n    margin: 0;\n    padding: 0;\n    background: #fff;\n  }\n  body {\n    font-family: \"Calibri\", \"Carlito\", \"Segoe UI\", sans-serif;\n    color: #000;\n    font-size: 12pt;\n  }\n  .page {\n    width: 8.5in;\n    min-height: 11in;\n    margin: 0 auto;\n    padding: 0.55in 0.75in 0.4in 1.45in;\n    box-sizing: border-box;\n    position: relative;\n  }\n  /* Sidebar vertical DOI text */\n  .sidebar {\n    position: absolute;\n    left: 0.42in;\n    top: 2.6in;\n    width: 0.3in;\n    height: 6.6in;\n    font-size: 9.5pt;\n    color: #808080;\n    writing-mode: vertical-rl;\n    transform: rotate(180deg);\n    white-space: nowrap;\n    letter-spacing: 0.2px;\n  }\n  .sidebar-rule {\n    position: absolute;\n    left: 0.62in;\n    top: 0.95in;\n    width: 0;\n    height: 8.6in;\n    border-left: 1px solid #b9b9b9;\n  }\n  /* Header */\n  .doc-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-end;\n    font-size: 10pt;\n    padding-bottom: 4px;\n    border-bottom: 1px solid #000;\n    margin-bottom: 34px;\n  }\n  .doc-header .left, .doc-header .right {\n    white-space: nowrap;\n  }\n  .sc { font-variant: small-caps; }\n\n  /* Matrix table */\n  table.matrix {\n    border-collapse: collapse;\n    width: 100%;\n    table-layout: fixed;\n    border: 2px solid #4472a8;\n  }\n  table.matrix th.corner {\n    background: #4a6f9e;\n    border: 1px solid #ffffff;\n    width: 165px;\n  }\n  table.matrix th.vhead {\n    background: #1f3864;\n    color: #fff