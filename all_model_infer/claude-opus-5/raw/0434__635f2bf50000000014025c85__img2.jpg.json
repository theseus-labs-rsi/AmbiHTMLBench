zing: border-box;\n  }\n  .photo {\n    position: absolute;\n    right: 30px;\n    top: 100px;\n    width: 130px;\n    height: 175px;\n  }\n  .caption-white {\n    position: absolute;\n    right: 22px;\n    top: 258px;\n    color: #ffffff;\n    font-size: 25px;\n    font-weight: bold;\n    font-family: \"Microsoft YaHei\", \"Heiti SC\", sans-serif;\n    letter-spacing: 1px;\n    z-index: 3;\n  }\n  /* ---------- 下半部分 ---------- */\n  .bottom {\n    background: #4b4a68;\n    padding: 40px 40px 26px 40px;\n    position: relative;\n    box-sizing: border-box;\n  }\n  .bottom-head {\n    display: flex;\n    align-items: center;\n    margin-bottom: 26px;\n  }\n  .bottom-title {\n    font-size: 30px;\n    color: #ffffff;\n    letter-spacing: 2px;\n  }\n  .check {\n    margin-left: 14px;\n    color: #7ac943;\n    font-size: 48px;\n    line-height: 1;\n    font-weight: bold;\n    font-family: \"Arial\", sans-serif;\n  }\n  .bottom-body {\n    font-size: 21px;\n    line-height: 1.85;\n    color: #ffffff;\n    letter-spacing: 1px;\n    text-align: justify;\n  }\n  .source {\n    margin-top: 22px;\n    text-align: right;\n    color: #ffffff;\n    font-size: 16px;\n    letter-spacing: 1px;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"top\">\n    <div class=\"watermark wm1\">爱妈的美女纸</div>\n    <div class=\"watermark wm2\">爱妈的美女纸</div>\n\n    <div class=\"head-line\">\n      <span class=\"head-title\">我写的：</span>\n      <span class=\"circle-mark\"></span>\n    </div>\n\n    <div class=\"top-body\">\n      我们民族的追梦史充满<br>\n      艰辛。\n    </div>\n\n    <figure class=\"placeholder photo\" style=\"margin:0;\">\n      [Photo: 男孩头像，右上角]\n    </figure>\n    <div class=\"caption-white\">学习使我妈快乐</div>\n  </div>\n\n  <div class=\"bottom\">\n    <div class=\"watermark wm3\" style=\"position:absolute; top:130px; left:60px;\">爱妈的美女纸</div>\n\n    <div class=\"bottom-head\">\n      <span class=\"bottom-title\">人民日报写的：</span>\n      <span class=\"check\">✔</span>\n    </div>\n\n    <div class=\"bottom-body\">\n      我们这个民族，有数千年辉煌文明、有数百年深重苦难，也有百余年不息奋斗，追寻梦想的道路尤其艰难曲折。百余年来的救亡图存、道路探索，多少仁人志士留下“有心杀贼，无力回天”的悲愤，付出“春云碧血，秋雨黄花”的牺牲，发出“拼将十万头颅血，须把乾坤力挽回”的呐喊。\n    </div>\n\n    <div class=\"source\">——2013.4.1《筑就民族复兴的“中国梦”》</div>\n  </div>\n\n</div>\n</body>\n</html>"
