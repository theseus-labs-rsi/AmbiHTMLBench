        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>人民日报 2025年2月25日 头版</title>\n<script src=\"https://polyfill.io/v3/polyfill.min.js?features=es6\"></script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  body{margin:0;padding:10px;background:#fff;color:#000;font-family:\"SimSun\",\"Songti SC\",serif;font-size:11px;line-height:1.5;}\n  .page{width:1000px;margin:0 auto;}\n  .rule{border-top:1px solid #000;margin:6px 0;}\n  .rule-thick{border-top:2px solid #000;margin:6px 0;}\n  /* ---------- masthead ---------- */\n  .masthead{display:flex;align-items:stretch;gap:8px;}\n  .masthead-left{width:340px;text-align:center;}\n  .logo{font-family:\"STKaiti\",\"KaiTi\",serif;font-size:76px;font-weight:bold;color:#c0392b;letter-spacing:4px;line-height:1;}\n  .logo-pinyin{font-size:13px;letter-spacing:4px;color:#c0392b;border-top:1px solid #c0392b;border-bottom:1px solid #c0392b;margin:4px 30px 0;padding:2px 0;}\n  .logo-url{font-size:10px;margin-top:6px;}\n  .dateblock{width:110px;border-left:1px solid #000;border-right:1px solid #000;text-align:center;font-size:11px;padding:2px 4px;}\n  .dateblock .day{font-size:34px;font-weight:bold;line-height:1.1;}\n  .dateblock .line{border-top:1px solid #000;margin:3px 0;}\n  .imprint{width:150px;font-size:10px;text-align:center;line-height:1.8;padding-top:6px;}\n  .masthead-right{flex:1;}\n  .head-main{font-size:29px;font-weight:bold;letter-spacing:1px;text-align:center;line-height:1.2;}\n  /* ---------- generic column text ---------- */\n  .cols{display:flex;gap:10px;}\n  .col{flex:1;text-indent:2em;text-align:justify;}\n  .vertical{writing-mode:vertical-rl;text-orientation:upright;}\n  .placeholder{border:1px dashed #888;background:#f4f4f4;display:flex;align-items:center;justify-content:center;text-align:center;color:#555;font-size:11px;}\n  h2.sec{text-align:center;font-size:24px;font-weight:bold;margin:6px 0 2px;}\n  h3.sub{text-align:center;font-size:13px;font-weight:normal;margin:0 0 6px;}\n  .byline{text-align:center;font-size:11px;margin:4px 0;}\n  .subhead{text-align:center;font-weight:bold;font-size:13px;margin:6px 0 4px;}\n  .boxed{border:1px solid #000;padding:4px 8px;}\n  .redtag{color:#c0392b;font-weight:bold;}\n  table.guide{width:100%;border-collapse:collapse;}\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <!-- ================= MASTHEAD ROW ================= -->\n  <div class=\"masthead\">\n    <div class=\"masthead-left\">\n      <div class=\"logo\">人民日报</div>\n      <div class=\"logo-pinyin\">RENMIN RIBAO</div>\n      <div class=\"logo-url\">人民网网址：http://www.people.com.cn</div>\n    </div>\n\n    <div class=\"dateblock\">\n      2025年2月\n      <div class=\"line\"></div>\n      <div class=\"day\">25</div>\n      <div class=\"line\"></div>\n      星期二<br>\n      乙巳年正月廿八\n    </div>\n\n    <div class=\"imprint\">\n      人民日报社出版<br>\n      国内统一连续出版物号<br>\n      CN 11—0065<br>\n      代号1—1<br>\n      第27989期<br>\n      今日20版\n    </div>\n\n    <div class=\"masthead-right\">\n      <div class=\"head-main\">习近平同俄罗斯总统普京通电话</div>\n      <div class=\"rule\"></div>\n      <div class=\"cols\" style=\"font-size:10px;line-height:1.6;\">\n        <div class=\"col\">新华社北京2月24日电　2月24日下午，国家主席习近平应约同俄罗斯总统普京通电话。<br>\n          习近平指出，中国春节前夕我同你通电话以来的一个月里，中俄关系发展势头良好。[illegible]</div>\n        <div class=\"col\">[illegible]</div>\n        <div class=\"col\">[illegible]</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"rule-thick\"></div>\n\n  <!-- ================= SECOND BAND ================= -->\n  <div class=\"cols\">\n\n    <!-- left vertical headline block -->\n    <div style=\"width:120px;display:flex;justify-content:center;\">\n      <div class=\"vertical\" style=\"font-size:12px;letter-spacing:2px;\">向高竞攀　　向新笃行</div>\n      <div class=\"vertical\" style=\"font-size:26px;font-weight:bold;letter-spacing:3px;margin-right:10px;\">\n        湖北加快构建以创新为牵引的现代化产业体系\n      </div>\n    </div>\n\n    <!-- middle: 坚定信心 article -->\n    <div style=\"width:400px;\">\n      <div class=\"boxed\" style=\"text-align:center;font-size:17px;font-weight:bold;color:#c0392b;border:none;border-top:1px solid #c0392b;border-bottom:1px solid #c0392b;\">\n        坚定信心，打开改革发展新天地\n      </div>\n      <div class=\"cols\" style=\"margin-top:6px;font-size:10px;line-height:1.6;\">\n        <div class=\"col\">[illegible]</div>\n        <div class=\"col\">[illegible]</div>\n        <div class=\"col\">[illegible]</div>\n      </div>\n    </div>\n\n    <!-- right: 加紧经济社会发展全面绿色转型 -->\n    <div style=\"flex:1;\">\n      <h2 class=\"sec\">加紧经济社会发展全面绿色转型</h2>\n      <h3 class=\"sub\">——2025年，中国经济这么干⑧</h3>\n      <div class=\"byline\">本报记者　寇江泽　董丝雨</div>\n      <div class=\"rule\"></div>\n      <div class=\"cols\" style=\"font-size:10px;line-height:1.6;\">\n        <div class=\"col\">[illegible]</div>\n        <div class=\"col\">\n          <div class=\"subhead\">不断厚植高质量<br>发展的绿色底色</div>\n          [illegible]\n        </div>\n        <div class=\"col\">[illegible]</div>\n        <div class=\"col\">\n          [illegible]\n          <div style=\"text-align:right;font-weight:bold;text-indent:0;margin-top:6px;\">（下转第五版）</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"rule-thick\"></div>\n\n  <!-- ================= THIRD BAND ================= -->\n  <div class=\"cols\">\n\n    <!-- left big: 十四届全国人大常委会 -->\n    <div style=\"width:400px;\">\n      <h2 class=\"sec\" style=\"font-size:23px;\">十四届全国人大常委会第十四次会议在京举行</h2>\n      <h3 class=\"sub\" style=\"font-size:12px;\">审议全国人大常委会工作报告稿等　为召开十四届全国人大三次会议作准备</h3>\n      <div style=\"text-align:center;font-size:19px;font-weight:bold;margin:4px 0 8px;\">赵乐际主持</div>\n      <div class=\"rule\"></div>\n      <div class=\"cols\" style=\"font-size:10px;line-height:1.6;\">\n        <div class=\"col\">本报北京2月24日电　（记者鞠鹏）十四届全国人大