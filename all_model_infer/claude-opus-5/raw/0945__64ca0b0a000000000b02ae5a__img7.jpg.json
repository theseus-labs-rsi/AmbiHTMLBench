        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Self Check - Workbook Page 16</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] }\n};\n</script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  body {\n    margin: 0;\n    padding: 0;\n    background: #f2ece2;\n    font-family: Arial, Helvetica, sans-serif;\n    color: #1a1a2e;\n  }\n  .page {\n    position: relative;\n    width: 540px;\n    min-height: 405px;\n    margin: 0 auto;\n    background: #f5f0e6;\n    padding: 0;\n    box-sizing: border-box;\n  }\n  /* Self Check tab at top */\n  .self-check {\n    position: absolute;\n    top: -8px;\n    left: 30px;\n    background: #f7c948;\n    border: 2px solid #e08a1e;\n    border-radius: 14px;\n    padding: 2px 22px 4px 22px;\n    font-weight: bold;\n    font-style: italic;\n    font-size: 16px;\n    color: #3b3b8f;\n    z-index: 3;\n  }\n  .top-rule {\n    border: none;\n    border-top: 1px solid #9a9a9a;\n    margin: 22px 20px 0 20px;\n  }\n  /* Numbered items */\n  .item {\n    display: flex;\n    align-items: flex-start;\n    margin: 10px 0 6px 0;\n    padding-left: 44px;\n  }\n  .num {\n    color: #2b4b9b;\n    font-weight: bold;\n    font-size: 14px;\n    width: 18px;\n    flex: 0 0 18px;\n  }\n  .prompt {\n    font-weight: bold;\n    font-size: 13px;\n    line-height: 1.35;\n    padding-right: 30px;\n  }\n  /* Chart */\n  table.chart {\n    border-collapse: collapse;\n    width: 470px;\n    margin: 6px 0 0 34px;\n    font-size: 12px;\n    background: #f7f3ea;\n  }\n  table.chart th,\n  table.chart td {\n    border: 1px solid #7d7d7d;\n    height: 22px;\n    padding: 2px 6px;\n    text-align: center;\n    vertical-align: middle;\n  }\n  table.chart thead th {\n    color: #2b4b9b;\n    font-weight: bold;\n    background: #efe9dd;\n  }\n  table.chart tbody th {\n    text-align: left;\n    font-weight: normal;\n    color: #4a4a6a;\n    width: 74px;\n  }\n  table.chart tbody td { background: #fbf8f1; }\n  .corner { border: 1px solid #7d7d7d; background: #efe9dd; }\n  /* Conversation box */\n  .conv-box {\n    position: relative;\n    width: 430px;\n    margin: 14px 0 0 54px;\n    border: 1px solid #6b6b6b;\n    background: #fdfaf3;\n    padding: 10px 14px 12px 14px;\n    box-sizing: border-box;\n    transform: rotate(-0.6deg);\n  }\n  .line {\n    font-size: 12.5px;\n    line-height: 2.0;\n    white-space: nowrap;\n  }\n  .spk {\n    color: #2b4b9b;\n    font-weight: bold;\n    display: inline-block;\n    width: 22px;\n  }\n  .hand {\n    font-family: \"Comic Sans MS\", \"Segoe Script\", cursive;\n    font-size: 15px;\n    color: #1b1b6f;\n    border-bottom: 1px solid #444;\n    padding: 0 6px;\n    display: inline-block;\n    min-width: 90px;\n    text-align: center;\n    line-height: 1.1;\n  }\n  .blank {\n    border-bottom: 1px solid #444;\n    display: inline-block;\n    width: 90px;\n  }\n  /* Page number */\n  .page-num {\n    position: absolute;\n    left: 30px;\n    bottom: 12px;\n    width: 34px;\n    height: 22px;\n    background: #e8892b;\n    border-radius: 50%;\n    color: #fff;\n    font-weight: bold;\n    font-size: 13px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .placeholder {\n    border: 1px dashed #aaa;\n    color: #777;\n    font-size: 10px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    box-sizing: border-box;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"self-check\">Self Check</div>\n  <hr class=\"top-rule\">\n\n  <div class=\"item\">\n    <div class=\"num\">1</div>\n    <div class=\"prompt\">Complete the chart with activities you do and don't do. What<br>about your mother/father?</div>\n  </div>\n\n  <table class=\"chart\">\n    <thead>\n      <tr>\n  