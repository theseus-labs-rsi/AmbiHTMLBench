cle-title {\n    font-size: 17px;\n    font-weight: 700;\n    text-decoration: none;\n    color: #15141a;\n    display: inline-block;\n  }\n  .article-desc {\n    margin: 10px 0 0;\n    font-size: 16px;\n    line-height: 1.28;\n  }\n  .article-meta {\n    margin-top: 16px;\n    border-top: 1px solid #e6e6ec;\n    padding-top: 12px;\n    font-size: 15px;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n  .article-meta .products { font-weight: 700; margin-right: 18px; }\n  .pencil { font-size: 13px; }\n  .article-meta .label { font-weight: 700; }\n  .article-meta .date { color: #15141a; }\n\n  /* ---------- Sidebar ---------- */\n  .search-box {\n    display: flex;\n    align-items: center;\n    border: 1px solid #8f8f9d;\n    border-radius: 4px;\n    padding: 9px 12px;\n  }\n  .search-box input {\n    border: 0;\n    outline: none;\n    font-size: 15px;\n    width: 100%;\n    font-family: inherit;\n  }\n  .search-box .mag { font-size: 15px; color: #15141a; }\n\n  .side-col h2 {\n    font-size: 19px;\n    margin: 48px 0 14px;\n  }\n  .topic-list { list-style: none; padding: 0; margin: 0; }\n  .topic-list li { margin: 0; }\n  .topic-list a {\n    display: block;\n    color: #15141a;\n    text-decoration: none;\n    font-size: 16px;\n    padding: 8px 8px;\n    line-height: 1.3;\n  }\n  .topic-list a.current { background: #ededf0; font-weight: 700; }\n\n  .ask-card {\n    margin-top: 46px;\n    background: #241a49;\n    color: #fff;\n    border-radius: 8px;\n    padding: 26px 22px;\n    text-align: center;\n  }\n  .ask-card .ask-title {\n    font-weight: 700;\n    font-size: 17px;\n    margin-bottom: 12px;\n  }\n  .ask-card p { margin: 0; font-size: 15.5px; line-height: 1.3; }\n  .btn-continue {\n    display: inline-block;\n    margin-top: 18px;\n    background: #0060df;\n    color: #fff;\n    text-decoration: none;\n    font-weight: 700;\n    font-size: 15px;\n    padding: 9px 26px;\n    border-radius: 4px;\n  }\n  .cut-off { padding-bottom: 0; overflow: hidden; height: 26px; }\n</style>\n</head>\n<body>\n\n<header class=\"site-header\">\n  <div class=\"logo\">Mozilla<br>Support</div>\n  <nav class=\"site-nav\">\n    <a href=\"#\">Explore Help Articles</a>\n    <a href=\"#\">Community Forums</a>\n    <a href=\"#\">Ask a Question</a>\n    <a href=\"#\">Contribute</a>\n  </nav>\n  <div class=\"header-right\">\n    <a class=\"btn-outline\" href=\"#\">Sign In/Up</a>\n  </div>\n</header>\n\n<div class=\"page\">\n\n  <!-- ================= MAIN COLUMN ================= -->\n  <div class=\"main-col\">\n\n    <div class=\"breadcrumb\">\n      <a href=\"#\">Home</a> / <a href=\"#\">Firefox</a> / Privacy and security\n    </div>\n\n    <div class=\"hero\">\n      <figure class=\"placeholder firefox-logo\" style=\"margin:0;\">[Logo]</figure>\n\n      <div class=\"download-block\">\n        <a class=\"btn-download\" href=\"#\">Download Firefox</a>\n        <div class=\"download-links\">\n          <a href=\"#\">Systems and Languages</a>\n          <a href=\"#\">What's New</a>\n          <a href=\"#\">Privacy</a>\n        </div>\n      </div>\n\n      <h1>Privacy and security</h1>\n      <p class=\"lede\">Learn how to protect your privacy and secure your data.</p>\n    </div>\n\n    <nav class=\"tabs\">\n      <a class=\"tab active\" href=\"#\">All articles and threads</a>\n      <a class=\"tab\" href=\"#\">Tracking protection</a>\n      <a class=\"tab\" href=\"#\">Encryption</a>\n      <a class=\"tab\" href=\"#\">Security</a>\n    </nav>\n\n    <div class=\"article\">\n      <div class=\"doc-icon\"></div>\n      <div class=\"article-body\">\n        <a class=\"article-title\" href=\"#\">Use built-in VPN in Firefox</a>\n        <p class=\"article-desc\">Learn how to activate and use the built-in VPN feature in Firefox to protect your browsing.</p>\n        <div class=\"article-meta\">\n          <span class=\"products\">Firefox</span>\n          <span class=\"pencil\">&#9998;</span>\n          <span class=\"label\">Last updated:</span>\n          <span class=\"date\">1 day ago</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"article\">\n      <div class=\"doc-icon\"></div>\n      <div class=\"article-body\">\n        <a class=\"article-title\" href=\"#\">Common Myths about Private Browsing</a>\n        <p class=\"article-desc\">Learn more about common misconceptions about Private Browsing in Firefox.</p>\n        <div class=\"article-meta\">\n          <span class=\"products\">Firefox</span>\n          <span class=\"pencil\">&#9998;</span>\n          <span class=\"label\">Last updated:</span>\n          <span class=\"date\">11/3/25</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"article\">\n      <div class=\"doc-icon\"></div>\n      <div class=\"article-body\">\n        <a class=\"article-title\" href=\"#\">Avoid and report Mozilla tech support scams</a>\n        <p class=\"article-desc\">Mozilla does not provide telephone support and does not charge for software downloads, upgrades or technical help. Learn more.</p>\n        <div class=\"article-meta\">\n          <span class=\"products\">Firefox, Firefox for Android, Firefox for iOS,&#8230;</span>\n          <span class=\"pencil\">&#9998;</span>\n          <span class=\"label\">Last updated:</span>\n          <span class=\"date\">2/3/25</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"article\">\n      <div class=\"doc-icon\"></div>\n      <div class=\"article-body\">\n        <a class=\"article-title\" href=\"#\">Insecure connection password warning in Firefox</a>\n        <p class=\"article-desc\">Firefox will show you a \"connection is not secure\" warning message when a website login page is insecure and information could be stolen.</p>\n        <div class=\"article-meta\">\n          <span class=\"products\">Firefox</span>\n          <span class=\"pencil\">&#9998;</span>\n          <span class=\"label\">Last updated:</span>\n          <span class=\"date\">3/19/26</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"article\">\n      <div class=\"doc-icon\"></div>\n      <div class=\"article-body\">\n        <a class=\"article-title\" href=\"#\">Third-party trackers</a>\n        <p class=\"article-desc\">Learn about cross-site (third-party) cookies that collect information to track your browsing, which are used on many websites.</p>\n        <div class=\"article-meta\">\n          <span class=\"products\">Firefox</span>\n          <span class=\"pencil\">&#9998;</span>\n          <span class=\"label\">Last updated:</span>\n          <span class=\"date\">10/26/24</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"article\">\n      <div class=\"doc-icon\"></div>\n      <div class=\"article-body\">\n        <a class=\"article-title\" href=\"#\">Does Firefox share my location with websites?</a>\n        <p class=\"article-desc\">Learn what information Firefox sends to websites about your location and how to use and manage location-aware features of your browser.</p>\n        <div class=\"article-meta\">\n          <span class=\"products\">Firefox</span>\n          <span class=\"pencil\">&#9998;</span>\n          <span class=\"label\">Last updated:</span>\n          <span class=\"date\">3/22/26</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"article\">\n      <div class=\"doc-icon\"></div>\n      <div class=\"article-body\">\n        <a class=\"article-title\" href=\"#\">Configure DNS over HTTPS protection levels in Firefox</a>\n        <p class=\"article-desc\">DNS over HTTPS (DoH) is a recommended feature that enhances privacy. Learn more about the DoH protection levels you can configure in Firefox settings.</p>\n        <div class=\"article-meta\">\n          <span class=\"products\">Firefox</span>\n          <span class=\"pencil\">&#9998;</span>\n          <span class=\"label\">Last updated:</span>\n          <span class=\"date\">3/27/25</span>\n        </div>\n      </div>\n  