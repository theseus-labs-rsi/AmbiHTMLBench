        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Multidrug-resistant organisms (MDROs) are a threat to our residents.</title>\n<script src=\"https://polyfill.io/v3/polyfill.min.js?features=es6\"></script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    background: #fff;\n    font-family: \"Segoe UI\", \"Franklin Gothic\", Arial, sans-serif;\n    color: #1a1a1a;\n  }\n  .poster {\n    width: 1520px;\n    margin: 0 auto;\n    position: relative;\n  }\n\n  /* ---------- Header banner ---------- */\n  .header {\n    background: #1c5560;\n    color: #fff;\n    text-align: center;\n    padding: 34px 60px 40px;\n  }\n  .header h1 {\n    margin: 0;\n    font-size: 54px;\n    line-height: 1.15;\n    font-weight: 800;\n    letter-spacing: -0.5px;\n  }\n\n  /* ---------- EBP Steps ribbon ---------- */\n  .steps-label-row {\n    margin-top: 62px;\n    display: flex;\n  }\n  .steps-label {\n    background: #1c5560;\n    color: #fff;\n    font-size: 34px;\n    font-weight: 700;\n    padding: 14px 40px 14px 60px;\n    position: relative;\n    width: 940px;\n  }\n  .steps-label::after {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    right: -55px;\n    width: 0;\n    height: 0;\n    border-top: 33px solid transparent;\n    border-bottom: 33px solid transparent;\n    border-left: 55px solid #1c5560;\n  }\n\n  .steps-band {\n    margin-top: 22px;\n    background: linear-gradient(to right, #f3de70 0%, #f3de70 70%, #fbf3c8 100%);\n    display: flex;\n    align-items: center;\n    height: 248px;\n    padding: 0 40px;\n  }\n  .step-icon {\n    flex: 1;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    position: relative;\n  }\n  .circle {\n    width: 200px;\n    height: 200px;\n    border-radius: 50%;\n    background: #fff;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    font-size: 13px;\n    color: #6b6b6b;\n    line-height: 1.3;\n    padding: 10px;\n  }\n\n  .steps-captions {\n    display: flex;\n    padding: 20px 40px 0;\n  }\n  .steps-captions div {\n    flex: 1;\n    text-align: center;\n    color: #1c5560;\n    font-weight: 700;\n    font-size: 21px;\n    line-height: 1.3;\n  }\n\n  /* ---------- Middle two-column zone ---------- */\n  .middle {\n    display: flex;\n    gap: 50px;\n    padding: 90px 60px 60px;\n    align-items: flex-start;\n  }\n  .left-col { width: 640px; }\n  .right-col { width: 700px; }\n\n  .use-ebp {\n    font-size: 37px;\n    line-height: 1.28;\n    margin: 0 0 40px;\n  }\n  .use-ebp strong { font-weight: 800; }\n\n  ol.reasons {\n    list-style: none;\n    margin: 0;\n    padding: 0 0 0 30px;\n  }\n  ol.reasons > li {\n    display: flex;\n    align-items: flex-start;\n    margin-bottom: 26px;\n  }\n  .num {\n    flex: 0 0 auto;\n    width: 42px;\n    height: 42px;\n    border-radius: 50%;\n    background: #7b2382;\n    color: #fff;\n    font-size: 26px;\n    font-weight: 700;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-right: 22px;\n    margin-top: 4px;\n  }\n  .reason-text { font-size: 34px; line-height: 1.25; }\n  .reason-sub {\n    font-size: 20px;\n    line-height: 1.4;\n    margin-top: 10px;\n  }\n\n  .placeholder {\n    background: #e9e9e9;\n    border: 1px solid #cfcfcf;\n    color: #555;\n    font-size: 16px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    padding: 8px;\n  }\n  .photo {\n    width: 690px;\n    height: 700px;\n  }\n\n  /* ---------- Footer ---------- */\n  .footer {\n    background: #1c5560;\n    color: #fff;\n    padding: 44px 60px 40px;\n    display: flex;\n    align-items: flex-start;\n    position: relative;\n    min-height: 260px;\n  }\n  .footer-left { flex: 1; }\n  .footer-left p {\n    margin: 0;\n    font-size: 36px;\n    font-weight: 700;\n    line-height: 1.25;\n  }\n  .url-box {\n    background: #fff;\n    color: #1a1a1a;\n    font-weight: 800;\n    font-size: 30px;\n    padding: 26px 0 26px 0;\n    margin: 44px 0 0 -60px;\n    padding-left: 60px;\n    width: 560px;\n  }\n  .footer-right {\n    display: flex;\n    align-items: flex-start;\n    gap: 60px;\n    padding-top: 6px;\n  }\n  .scan-block { text-align: center; }\n  .scan-block p {\n    margin: 0 0 18px;\n    font-size: 24px;\n    font-weight: 700;\n    line-height: 1.3;\n  }\n  .qr {\n    width: 170px;\n    height: 170px;\n  }\n  .cdc-logo {\n    width: 230px;\n    height: 120px;\n    margin-top: 66px;\n    border-radius: 10px;\n  }\n</style>\n</head>\n<body>\n<div class=\"poster\">\n\n  <!-- Header -->\n  <div class=\"header\">\n    <h1>Multidrug-resistant organisms (MDROs)<br>are a threat to our residents.</h1>\n  </div>\n\n  <!-- EBP Steps -->\n  <div class=\"steps-label-row\">\n    <div class=\"steps-label\">Enhanced Barrier Precautions (EBP) Steps</div>\n  </div>\n\n  <div class=\"steps-band\">\n    <div class=\"step-icon\">\n      <div class=\"circle placeholder\" style=\"border-radius:50%;\">[Icon: ABHR hand sanitizer dispenser dispensing onto a hand]</div>\n    </div>\n    <div class=\"step-icon\">\n      <div class=\"circle placeholder\" style=\"border-radius:50%;\">[Icon: blue isolation gown]</div>\n    </div>\n    <div class=\"step-icon\">\n      <div class=\"circle placeholder\" style=\"border-radius:50%;\">[Icon: pair of blue gloves]</div>\n    </div>\n    <div class=\"step-icon\">\n      <div class=\"circle placeholder\" style=\"border-radius:50%;\">[Icon: waste bin / trash can]</div>\n    </div>\n  </div>\n\n  <div class=\"steps-captions\">\n    <div>Perform Hand Hygiene</div>\n    <div>Wear Gown</div>\n    <div>Wear Gloves</div>\n    <div>Dispose of Gown &amp;<br>Gloves in Room</div>\n  </div>\n\n  <!-- Middle zone -->\n  <div class=\"middle\">\n    <div class=\"left-col\">\n      <p class=\"use-ebp\"><strong>Use EBP</strong> during high-contact care activities for residents with:</p>\n\n      <ol class=\"reasons\">\n        <li>\n          <span class=\"num\">1</span>\n          <span>\n            <span class=\"reason-text\">Indwelling Medical Devices</span>\n            <div class=\"reason-sub\">(e.g., central line, urinary catheter,<br>feeding tube, tracheostomy/ventilator)</div>\n          </span>\n        </li>\n        <li>\n          <span class=\"num\">2</span>\n          <span class=\"reason-text\">Wounds</span>\n        </li>\n        <li>\n          <span class=\"num\">3</span>\n          <span class=\"reason-text\">Colonization or Infection<br>with a MDRO</span>\n        </li>\n      </ol>\n    </div>\n\n    <div class=\"right-col\">\n      <figure class=\"placeholder photo\" style=\"margin:0;\">\n        [Illustration: right side — animated caregiver in gloves attending to a resident lying in bed, with two magnified circle insets showing purple germ clusters at a device site and a wound site]\n      </figure>\n    </div>\n  </div>\n\n  <!-- Footer -->\n  <div class=\"footer\">\n    <div class=\"footer-left\">\n      <p>Protect residents and<br>stop the spread of germs.</p>\n      <div class=\"url-box\">bit.ly/PPE-LTCFs</div>\n    </div>\n    <div class=\"footer-right\">\n      <div class=\"scan-block\">\n        <p>Scan to watch<br>an EBP video.</p>\n        <div class=\"qr placeholder\">[QR code]</div>\n      </div>\n      <div class=\"cdc-logo placeholder\">[Logo: U.S. Department of Health &amp; Human Services / CDC]</div>\n    </div>\n  </div>\n\n</div>\n</body>\n</html>"
