        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Glimpse of pathogenesis</title>\n<script src=\"https://polyfill.io/v3/polyfill.min.js?features=es6\"></script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  body {\n    margin: 0;\n    padding: 0;\n    background: #ffffff;\n    font-family: \"Times New Roman\", Times, serif;\n    width: 1024px;\n    height: 768px;\n    position: relative;\n  }\n  .logo-left {\n    position: absolute;\n    top: 20px;\n    left: 15px;\n    width: 105px;\n    height: 120px;\n  }\n  .logo-right {\n    position: absolute;\n    top: 25px;\n    right: 25px;\n    width: 105px;\n    height: 110px;\n  }\n  .placeholder {\n    border: 1px dashed #bbb;\n    color: #888;\n    font-size: 10px;\n    text-align: center;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    box-sizing: border-box;\n  }\n  h1.title {\n    position: absolute;\n    top: 68px;\n    left: 0;\n    width: 100%;\n    text-align: center;\n    margin: 0;\n    color: #cc0000;\n    font-size: 34px;\n    font-weight: bold;\n  }\n  .table-wrap {\n    position: absolute;\n    top: 240px;\n    left: 14px;\n    width: 998px;\n  }\n  table.data {\n    border-collapse: collapse;\n    width: 100%;\n    font-size: 10.5px;\n    background: #d6ecab;\n  }\n  table.data thead td {\n    background: #ffffff;\n    font-weight: bold;\n    font-size: 11.5px;\n    border: none;\n    border-top: 1px solid #cc3333;\n    border-bottom: 1px solid #cc3333;\n    padding: 4px 6px;\n    vertical-align: middle;\n  }\n  table.data tbody td {\n    border-left: 1px solid #cc3333;\n    border-right: 1px solid #cc3333;\n    padding: 3px 6px;\n    vertical-align: top;\n  }\n  table.data tbody tr:last-child td {\n    border-bottom: 1px solid #cc3333;\n  }\n  .indent {\n    display: block;\n    padding-left: 12px;\n    text-indent: 0;\n  }\n  .hang {\n    padding-left: 12px;\n    text-indent: -12px;\n  }\n  .center {\n    text-align: center;\n  }\n  .credit {\n    position: absolute;\n    top: 700px;\n    right: 40px;\n    color: #cc0000;\n    font-weight: bold;\n    font-size: 15px;\n  }\n</style>\n</head>\n<body>\n\n<div class=\"placeholder logo-left\">[Logo: ICAR emblem, top-left]</div>\n<div class=\"placeholder logo-right\">[Logo: IVRI emblem, top-right]</div>\n\n<h1 class=\"title\">Glimpse of pathogenesis</h1>\n\n<div class=\"table-wrap\">\n<table class=\"data\">\n  <thead>\n    <tr>\n      <td style=\"width:6.5%;\">Pathotype</td>\n      <td style=\"width:16%;\">Host(s)</td>\n      <td style=\"width:13%;\">Site</td>\n      <td style=\"width:16%;\">Disease(S)</td>\n      <td style=\"width:12%;\">Resevoir(S)/sources</td>\n      <td style=\"width:15%;\">Rx</td>\n      <td style=\"width:11%;\">Adhesion</td>\n      <td style=\"width:10.5%;\">Genetic Identifiers</td>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td>tEPEC<br>aEPEC<br>STEC</td>\n      <td class=\"center hang\">Children &lt;5 yr, adults at high inocula<br><br>Adults, children</td>\n      <td>Small intestine<br><br><br>Distal ileum, colon</td>\n      <td>Profuse watery diarrhea<br><br><br>Watery diarrhea, hemorrhagic colitis, HUS</td>\n      <td>Humans<br>Humans, animals<br><br>Humans, animals, food, water</td>\n      <td class=\"center hang\">Oral rehydration, antibiotics for persistent cases<br>Hydration, supportive for HUS</td>\n      <td>Attaching and effacing<br><br><br>Attaching and effacing<sup>b</sup></td>\n      <td><em>eae</em><sup>+</sup>, <em>bfp</em><sup>+</sup>, <em>stx</em><sup>&#8722;</sup><br><em>eae</em><sup>+</sup>, <em>stx</em><sup>&#8722;</sup><br><em>eae</em><sup>+/&#8722;</sup>, <em>stx</em><sup>+</sup></td>\n    </tr>\n    <tr>\n      <td>EIEC/<em>Shigella</em></td>\n      <td class=\"center hang\">Children &lt;5 yr, adults, travelers, immunocompromised persons</td>\n      <td>Colon</td>\n      <td class=\"hang\">Shigellosis/bacillary dysentery, potential HUS</td>\n      <td>Humans, animals, food, water</td>\n      <td>Oral rehydration, antibiotics</td>\n      <td>NA (invasive)</td>\n      <td class=\"center hang\"><em>ipaH</em><sup>+</sup>, <em>ial</em><sup>+</sup>, <em>stx</em><sup>+</sup> (<em>S. dysenteriae</em>)</td>\n    </tr>\n    <tr>\n      <td>EAEC<br><br><br>&nbsp;</td>\n      <td>Adults<br><br><br>Children<br><br><br><br><em>Immunocompromised persons</em></td>\n      <td class=\"center hang\">Small intestine and/or colon</td>\n      <td class=\"hang\">Traveler's diarrhea, HUS (<em>stx</em><sup>+</sup>)<br>Persistent diarrhea<br><br><br><br>Persistent diarrhea</td>\n      <td class=\"center hang\">Food, occasionally adult carriers</td>\n      <td class=\"hang\">Antibiotics, oral rehydration<br><br>Antibiotics, oral rehydration, potentially probiotics<br>Fluoroquinolones</td>\n      <td>Stacked brick and/or invasive</td>\n      <td><em>aatA</em><sup>+</sup>, <em>aaiC</em><sup>+</sup><br>other candidates</td>\n    </tr>\n    <tr>\n      <td>ETEC</td>\n      <td>Children &lt;5 yr, travelers</td>\n      <td>Small intestine</td>\n      <td>Watery diarrhea</td>\n      <td class=\"center hang\">Food, water, humans, animals</td>\n      <td>Rehydration, antibiotics</td>\n      <td>CF mediated</td>\n      <td>CFs, LT, ST</td>\n    </tr>\n    <tr>\n      <td>DAEC</td>\n      <td class=\"center hang\">Children (increasing in severity from 18 mo to 5 yr), adults</td>\n      <td class=\"center hang\">Intestine (uncharacterized location)</td>\n      <td class=\"hang\">Persistent watery diarrhea in children, speculated to contribute to Crohn's disease in adults</td>\n      <td>Unknown</td>\n      <td>Rehydration</td>\n      <td>Diffuse adherent and/or invasive</td>\n      <td>No uniform markers</td>\n    </tr>\n    <tr>\n      <td>AIEC</td>\n      <td>Adults, children</td>\n      <td>Small intestine</td>\n      <td>Crohn's disease</td>\n      <td>Unknown</td>\n      <td class=\"center hang\">Antibiotics, surgical resection</td>\n      <td>NA (invasive)</td>\n      <td>Uncharacterized</td>\n    </tr>\n  </tbody>\n</table>\n</div>\n\n<div class=\"credit\">(Croxen et. al., 2013)</div>\n\n</body>\n</html>"
