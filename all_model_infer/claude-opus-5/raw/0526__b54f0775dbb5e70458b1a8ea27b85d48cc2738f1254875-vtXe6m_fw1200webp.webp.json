        "content": "<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>預見未來 — 現代藝術展</title>\n<script src=\"https://polyfill.io/v3/polyfill.min.js?features=es6\"></script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  html,body{margin:0;padding:0;background:#4a4744;}\n  body{font-family:\"Songti SC\",\"SimSun\",\"Times New Roman\",serif;}\n  .poster{\n    position:relative;\n    width:1181px;\n    height:1673px;\n    margin:0 auto;\n    background:linear-gradient(115deg,#b6b0a8 0%,#8d8781 22%,#5a5450 45%,#2f2c29 60%,#57514c 78%,#8b857e 100%);\n    overflow:hidden;\n    color:#f2efe9;\n  }\n  .ink{\n    position:absolute;\n    left:0;top:0;width:100%;height:100%;\n    background:\n      radial-gradient(ellipse 55% 70% at 78% 18%, rgba(20,18,16,.92) 0%, rgba(20,18,16,.5) 45%, rgba(20,18,16,0) 70%),\n      radial-gradient(ellipse 45% 55% at 62% 55%, rgba(25,22,20,.85) 0%, rgba(25,22,20,0) 70%),\n      radial-gradient(ellipse 60% 40% at 30% 95%, rgba(30,27,24,.6) 0%, rgba(30,27,24,0) 70%);\n    pointer-events:none;\n  }\n  .placeholder{\n    border:1px dashed rgba(255,255,255,.25);\n    color:rgba(255,255,255,.45);\n    font-size:12px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    letter-spacing:1px;\n  }\n\n  /* Top-left English */\n  .eng-left{\n    position:absolute;left:60px;top:95px;\n    font-size:34px;letter-spacing:6px;line-height:1.75;\n    font-weight:300;\n  }\n\n  /* Top-right vertical Chinese title */\n  .cn-title{\n    position:absolute;right:55px;top:60px;\n    display:flex;flex-direction:row-reverse;gap:20px;\n  }\n  .cn-title span{\n    writing-mode:vertical-rl;\n    font-size:76px;\n    letter-spacing:14px;\n    line-height:1;\n    font-weight:500;\n  }\n  .vert-small{\n    position:absolute;right:270px;top:75px;\n    writing-mode:vertical-rl;\n    font-size:19px;\n    letter-spacing:5px;\n    color:rgba(230,226,218,.55);\n    font-family:\"Times New Roman\",serif;\n  }\n\n  .eng-right{\n    position:absolute;right:20px;top:415px;\n    text-align:right;\n    font-size:27px;\n    letter-spacing:1.5px;\n    line-height:1.55;\n    font-family:\"Times New Roman\",serif;\n  }\n  .thin-line{\n    position:absolute;right:64px;top:625px;\n    width:1px;height:440px;\n    background:rgba(240,236,228,.65);\n  }\n\n  /* Big Chinese headline */\n  .headline{\n    position:absolute;left:52px;top:335px;\n    font-size:230px;\n    line-height:1.02;\n    letter-spacing:22px;\n    font-weight:500;\n    text-shadow:0 2px 18px rgba(0,0,0,.25);\n  }\n  .headline .row2{display:block;margin-top:8px;}\n\n  /* Dates */\n  .date{position:absolute;font-family:\"Times New Roman\",serif;color:#f0ece5;}\n  .d1{left:52px;top:940px;font-size:40px;letter-spacing:2px;}\n  .d1 .slash{display:inline-block;transform:rotate(15deg);margin:0 6px;font-size:46px;}\n  .d1 .num2{display:block;margin-left:52px;margin-top:-6px;}\n  .d2{left:70px;top:1120px;font-size:34px;writing-mode:vertical-rl;letter-spacing:8px;}\n  .d3{left:52px;top:1310px;font-size:40px;letter-spacing:2px;}\n  .d3 .num2{display:block;margin-left:52px;margin-top:-6px;}\n  .tick{position:absolute;left:116px;top:1120px;width:1px;height:118px;background:rgba(240,236,228,.8);}\n  .tick2{position:absolute;left:120px;top:1300px;width:1px;height:80px;background:rgba(240,236,228,.8);transform:rotate(18deg);}\n\n  /* Info blocks */\n  .info{position:absolute;left:232px;color:#f2efe9;}\n  .info .label{font-size:19px;letter-spacing:2px;margin-bottom:16px;}\n  .info .org{font-size:29px;letter-spacing:3px;}\n  .blk1{top:938px;}\n  .hr1{position:absolute;left:232px;top:1062px;width:408px;height:1px;background:rgba(240,236,228,.75);}\n  .blk2{top:1100px;}\n  .names{font-size:29px;letter-spacing:2px;line-height:1.55;}\n  .names span{display:inline-block;margin-right:32px;}\n  .hr2{position:absolute;left:232px;top:1290px;width:408px;height:2px;background:rgba(240,236,228,.85);}\n\n  .para{\n    position:absolute;left:225px;top:1325px;width:415px;\n    font-size:16.5px;line-height:2.0;letter-spacing:.5px;\n    text-align:justify;\n    color:#efece6;\n  }\n  .para p{margin:0 0 4px 0;text-indent:2em;}\n  .hr3{position:absolute;left:232px;top:1540px;width:408px;height:1px;background:rgba(240,236,228,.75);}\n\n  /* Right slogan */\n  .slogan{\n    position:absolute;right:38px;top:1140px;\n    text-align:right;\n  }\n  .slogan .big{\n    font-size:66px;letter-spacing:6px;line-height:1.28;font-weight:600;\n  }\n  .slogan .small{\n    margin-top:26px;font-size:31px;letter-spacing:6px;\n  }\n\n  /* Logo */\n  .logo{\n    position:absolute;left:60px;top:1480px;\n    width:80px;height:96px;\n    display:flex;flex-direction:column;align-items:center;justify-content:flex-end;\n    font-size:9px;letter-spacing:1px;line-height:1.3;text-align:center;\n    color:#efece6;\n  }\n  .logo .mark{\n    width:64px;height:52px;\n    background:\n      linear-gradient(to top,#efece6 0%,#efece6 55%,transparent 55%),\n      repeating-linear-gradient(to right,#efece6 0 6px,transparent 6px 12px);\n    -webkit-mask-image:linear-gradient(to top,#000 60%,rgba(0,0,0,.2) 100%);\n    mask-image:linear-gradient(to top,#000 60%,rgba(0,0,0,.2) 100%);\n    margin-bottom:6px;\n  }\n</style>\n</head>\n<body>\n<div class=\"poster\">\n  <div class=\"ink\"></div>\n\n  <div class=\"eng-left\">\n    Foresee<br>\n    The<br>\n    Future\n  </div>\n\n  <div class=\"vert-small\">Modern<br>art exhibition</div>\n\n  <div class=\"cn-title\">\n    <span>現代</span>\n    <span>藝術展</span>\n  </div>\n\n  <div class=\"eng-right\">\n    Modern art exhibition<br>\n    free to share<br>\n    big coffee guests\n  </div>\n  <div class=\"thin-line\"></div>\n\n  <div class=\"headline\">\n    預見<span class=\"row2\">未來</span>\n  </div>\n\n  <div class=\"date d1\">06<span class=\"slash\">/</span><span class=\"num2\">28</span></div>\n  <div class=\"tick\"></div>\n  <div class=\"date d2\">2020</div>\n  <div class=\"tick2\"></div>\n  <div class=\"date d3\">07<span class=\"slash\">/</span><span class=\"num2\">06</span></div>\n\n  <div class=\"info blk1\">\n    <div class=\"label\">主办方</div>\n    <div class=\"org\">麦礼贺夫人艺术馆/亚洲协会香港中心</div>\n  </div>\n  <div class=\"hr1\"></div>\n\n  <div class=\"info blk2\">\n    <div class=\"label\">主办方</div>\n    <div class=\"names\">\n      <span>曾&nbsp;翔</span><span>王&nbsp;铺</span><span>沃兴华</span><span>刘彦湖</span><br>\n      <span>于明诠</span><span>李成连</span><span>沈&nbsp;鹏</span><span>朱关田</span><br>\n      <span>王学仲</span><span>田英章</span>\n    </div>\n  </div>\n  <div class=\"hr2\"></div>\n\n  <div class=\"para\">\n    <p>现代艺术，又称现代派艺术，很难有一个准确的定义。大致来说，被称为“现代主义”或“现代派”的艺术，是指20世纪以来，区别于传统的，带有前卫和先锋色彩的各种艺术思潮和流派的总称。</p>\n    <p>现代艺术主要包括了野兽主义、立体主义、未来主义、表现主义、俄国的至上主义与构成主义、荷兰的风格派、达达主义、超现实主义、抽象主义、波普艺术等。</p>\n  </div>\n  <div class=\"hr3\"></div>\n\n  <div class=\"slogan\">\n    <div class=\"big\">未来的你<br>是否还在？</div>\n    <div class=\"small\">而我一直在这等着你</div>\n  </div>\n\n  <div class=\"logo\">\n    <div class=\"mark\"></div>\n    创意 香港<br>CREATE<br>HK\n  </div>\n</div>\n</body>\n</html>"
