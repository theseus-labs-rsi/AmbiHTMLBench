n  .italic-small {\n    font-size: 13px;\n    font-style: italic;\n    color: #2b2b2b;\n    letter-spacing: .5px;\n  }\n  .plus-importante {\n    font-size: 33px;\n    color: #c1121f;\n    font-weight: bold;\n    letter-spacing: .5px;\n    margin: 2px 0;\n  }\n  .institutions {\n    font-size: 14px;\n    font-style: italic;\n    color: #1c1c1c;\n    letter-spacing: .5px;\n    margin-bottom: 8px;\n  }\n  .sommes {\n    font-size: 19px;\n    color: #1c1c1c;\n    font-weight: bold;\n    letter-spacing: .5px;\n  }\n  .sommes .lead { font-size: 24px; }\n\n  /* figures rows */\n  .figrow {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    margin: 7px 4px 0 4px;\n    text-align: left;\n  }\n  .figrow .label { font-size: 23px; font-weight: bold; color: #1c1c1c; letter-spacing: .5px; }\n  .figrow .label .sm { font-size: 15px; font-weight: bold; }\n  .figrow .label .xs { display: block; font-size: 11px; letter-spacing: .3px; }\n  .figrow .mid { font-size: 14px; font-weight: bold; color: #1c1c1c; letter-spacing: .5px; }\n  .figrow .amount { font-size: 30px; font-weight: bold; color: #c1121f; letter-spacing: .5px; white-space: nowrap; }\n  .figrow .amount.huge { font-size: 36px; }\n\n  /* ---------- Bottom shields ---------- */\n  .bottom {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    margin-top: 14px;\n  }\n  .shield {\n    width: 132px;\n    border: 2px solid #6b5a8a;\n    padding: 6px 4px;\n    text-align: center;\n    font-size: 14px;\n    font-weight: bold;\n    color: #1c2d6b;\n    letter-spacing: .4px;\n    line-height: 1.25;\n  }\n  .shield .sm { font-size: 11px; font-weight: normal; }\n  .center-block { flex: 1; padding: 0 8px; text-align: center; }\n  .center-block .title {\n    font-size: 26px;\n    color: #c1121f;\n    font-weight: bold;\n    letter-spacing: .5px;\n  }\n  .center-block .micro {\n    font-size: 9px;\n    letter-spacing: .6px;\n    color: #3a3a3a;\n    text-transfor