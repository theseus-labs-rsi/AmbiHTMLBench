line-block;\n    width: 76px;\n    height: 60px;\n    border: 1px dashed #b9c2b9;\n    background: #fafbfa;\n    color: #8a938a;\n    font-size: 9px;\n    line-height: 1.2;\n    text-align: center;\n    padding: 4px 2px;\n    overflow: hidden;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"header\">\n    <h1>钩针工具选择指南</h1>\n    <div class=\"sub\">——only手作集——</div>\n  </div>\n\n  <table class=\"guide\">\n    <colgroup>\n      <col class=\"c1\"><col class=\"c2\"><col class=\"c3\"><col class=\"c4\">\n    </colgroup>\n    <thead>\n      <tr>\n        <th>工具</th>\n        <th>用途</th>\n        <th>初学者建议</th>\n        <th>实物图</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        <td class=\"tool\">钩针<span class=\"must\">（必备）</span></td>\n        <td class=\"use\">钩针是钩针编织的必备工具，有多种尺寸与规格，具体如何选择可参考《钩针毛线对照表》、《如何选择钩针和毛线》</td>\n        <td class=\"advice\">3mm左右的钩针最实用</td>\n        <td class=\"pic\"><div class=\"placeholder\">[Photo: 彩色钩针实物图]</div></td>\n      </tr>\n      <tr>\n        <td class=\"tool\">毛线<span class=\"must\">（必备）</span></td>\n        <td class=\"use\">毛线种类很多，新手建议选择股数较少的，可减少失误次数。具体如何选择参考《如何选择钩针和毛线》</td>\n        <td class=\"advice\">中粗的宝宝棉/牛奶棉</td>\n        <td class=\"pic\"><div class=\"placeholder\">[Photo: 篮子里的彩色毛线球]</div></td>\n      </tr>\n      <tr>\n        <td class=\"tool\">剪刀<span class=\"must\">（必备）</span></td>\n        <td class=\"use\">剪断编织过程中的编织线</td>\n        <td class=\"advice\">必备</td>\n        <td class=\"pic\"><div class=\"placeholder\">[Photo: 手工剪刀]</div></td>\n      </tr>\n      <tr>\n        <td class=\"tool\">缝合针</td>\n        <td class=\"use\">缝合、修补和连接编织面料</td>\n        <td class=\"advice\">非必须</td>\n        <td class=\"pic\"><div class=\"placeholder\">[Photo: 彩色塑料缝合针]</div></td>\n      </tr>\n    </tbody>\n  </table>\n\n</div>\n</body>\n</html>"
