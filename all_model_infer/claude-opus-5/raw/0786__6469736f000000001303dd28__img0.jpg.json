        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>金陵十二钗正册判词</title>\n<script src=\"https://polyfill.io/v3/polyfill.min.js?features=es6\"></script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  html, body {\n    margin: 0;\n    padding: 0;\n  }\n  body {\n    background-color: #fdfaf2;\n    background-image:\n      linear-gradient(to right, rgba(150,190,160,0.35) 1px, transparent 1px),\n      linear-gradient(to bottom, rgba(150,190,160,0.35) 1px, transparent 1px);\n    background-size: 22px 22px;\n    font-family: \"KaiTi\", \"STKaiti\", \"Kaiti SC\", serif;\n    color: #6b2f3a;\n  }\n  .page {\n    width: 540px;\n    margin: 0 auto;\n    padding: 14px 10px 24px 10px;\n    box-sizing: border-box;\n  }\n  .title-wrap {\n    text-align: center;\n    margin: 6px 0 14px 0;\n  }\n  .title {\n    display: inline-block;\n    border: 2px solid #e2707f;\n    border-radius: 4px;\n    padding: 5px 18px;\n    font-size: 20px;\n    font-weight: bold;\n    letter-spacing: 3px;\n    color: #c8404f;\n    background: rgba(255,255,255,0.55);\n  }\n  .grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    row-gap: 26px;\n    column-gap: 6px;\n  }\n  .cell {\n    display: flex;\n    align-items: flex-start;\n    justify-content: flex-start;\n  }\n  .placeholder {\n    width: 58px;\n    height: 118px;\n    flex: 0 0 58px;\n    border: 1px dashed #cbb7a0;\n    border-radius: 3px;\n    font-size: 8px;\n    line-height: 1.15;\n    color: #a08e7c;\n    text-align: center;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 2px;\n    box-sizing: border-box;\n    background: rgba(255,255,255,0.35);\n  }\n  .verse {\n    border: 1.5px solid #e2707f;\n    border-radius: 3px;\n    padding: 5px 7px;\n    margin-left: 4px;\n    background: rgba(255,255,255,0.5);\n    font-size: 11px;\n    line-height: 1.55;\n    letter-spacing: 0.5px;\n    white-space: nowrap;\n  }\n  .name {\n    display: block;\n    margin-bottom: 2px;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"title-wrap\">\n    <span class=\"title\">金陵十二钗正册判词</span>\n  </div>\n\n  <div class=\"grid\">\n\n    <!-- Row 1 -->\n    <div class=\"cell\">\n      <div class=\"placeholder\">[Illustration: 立像人物，持笛，左侧]</div>\n      <div class=\"verse\">\n        <span class=\"name\">林黛玉（情情）</span>\n        可叹停机德，<br>\n        堪怜咏絮才。<br>\n        玉带林中挂，<br>\n        金簪雪里埋。\n      </div>\n    </div>\n\n    <div class=\"cell\">\n      <div class=\"placeholder\">[Illustration: 立像人物，持扇，左侧]</div>\n      <div class=\"verse\">\n        <span class=\"name\">薛宝钗（无情）</span>\n        可叹停机德，<br>\n        堪怜咏絮才。<br>\n        玉带林中挂，<br>\n        金簪雪里埋。\n      </div>\n    </div>\n\n    <div class=\"cell\">\n      <div class=\"placeholder\">[Illustration: 立像人物，橙衣，左侧]</div>\n      <div class=\"verse\">\n        <span class=\"name\">王熙凤（情雕）</span>\n        凡鸟偏从末世来，<br>\n        都知爱慕此生才。<br>\n        一从二令三人木，<br>\n        哭向金陵事更哀。\n      </div>\n    </div>\n\n    <!-- Row 2 -->\n    <div class=\"cell\">\n      <div class=\"placeholder\">[Illustration: 立像人物，黄衣，左侧]</div>\n      <div class=\"verse\">\n        <span class=\"name\">贾元春（情尊）</span>\n        二十年来辨是非，<br>\n        榴花开处照宫闱。<br>\n        三春争及初春景，<br>\n        虎兔相逢大梦归。\n      </div>\n    </div>\n\n    <div class=\"cell\">\n      <div class=\"placeholder\">[Illustration: 立像人物，持扇，左侧]</div>\n      <div class=\"verse\">\n        <span class=\"name\">贾迎春（情桃）</span>\n        子系中山狼，<br>\n        得志便猖狂。<br>\n        金闺花柳质，<br>\n        一载赴黄粱。\n      </div>\n    </div>\n\n    <div class=\"cell\">\n      <div class=\"placeholder\">[Illustration: 立像人物，红衣，左侧]</div>\n      <div class=\"verse\">\n        <span class=\"name\">贾探春（情敏）</span>\n        才自精明志自高，<br>\n        生于末世运偏消。<br>\n        清明涕送江边望，<br>\n        千里东风一梦遥。\n      </div>\n    </div>\n\n    <!-- Row 3 -->\n    <div class=\"cell\">\n      <div class=\"placeholder\">[Illustration: 立像人物，黄衣，左侧]</div>\n      <div class=\"verse\">\n        <span class=\"name\">贾惜春（情冷）</span>\n        堪破三春景不长，<br>\n        缁衣顿改昔年装。<br>\n        可怜绣户侯门女，<br>\n        独卧青灯古佛旁。\n      </div>\n    </div>\n\n    <div class=\"cell\">\n      <div class=\"placeholder\">[Illustration: 立像人物，红衣，左侧]</div>\n      <div class=\"verse\">\n        <span class=\"name\">史湘云（情憨）</span>\n        富贵又何为，<br>\n        襁褓之间父母违。<br>\n        展眼吊斜晖，<br>\n        湘江水逝楚云飞。\n      </div>\n    </div>\n\n    <div class=\"cell\">\n      <div class=\"placeholder\">[Illustration: 立像人物，紫衣，左侧]</div>\n      <div class=\"verse\">\n        <span class=\"name\">秦可卿（情尊）</span>\n        情天情海幻情身，<br>\n        情既相逢必主淫。<br>\n        漫言不肖皆荣出，<br>\n        造衅开端实在宁。\n      </div>\n    </div>\n\n    <!-- Row 4 -->\n    <div class=\"cell\">\n      <div class=\"placeholder\">[Illustration: 立像人物，绿衣，左侧]</div>\n      <div class=\"verse\">\n        <span class=\"name\">妙玉（情隐）</span>\n        欲洁何曾洁？<br>\n        云空未必空。<br>\n        可怜金玉质，<br>\n        终陷淖泥中。\n      </div>\n    </div>\n\n    <div class=\"cell\">\n      <div class=\"placeholder\">[Illustration: 立像人物，粉裙，左侧]</div>\n      <div class=\"verse\">\n        <span class=\"name\">贾巧姐（情缘）</span>\n        势败休云贵，<br>\n        家亡莫论亲。<br>\n        偶因济刘氏，<br>\n        巧得遇恩人。\n      </div>\n    </div>\n\n    <div class=\"cell\">\n      <div class=\"placeholder\">[Illustration: 立像人物与小童，左侧]</div>\n      <div class=\"verse\">\n        <span class=\"name\">李纨（情编）</span>\n        桃李春风结子完，<br>\n        到头谁似一盆兰。<br>\n        如冰水好空相妒，<br>\n        枉与他人作笑谈。\n      </div>\n    </div>\n\n  </div>\n</div>\n</body>\n</html>"
