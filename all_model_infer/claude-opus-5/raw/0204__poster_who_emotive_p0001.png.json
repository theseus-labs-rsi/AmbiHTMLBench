        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Detect and Treat Postpartum Haemorrhage Early — E-MOTIVE</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$','$']], displayMath: [['$$','$$']] }\n};\n</script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  :root{\n    --purple:#5b2a86;\n    --purple2:#6b2d8b;\n    --teal:#1a7f9c;\n    --teal-dark:#0e6f8e;\n    --bg:#dff1f2;\n    --bg-left:#cfe9ea;\n    --highlight:#bfe6ea;\n    --border:#2f8fa8;\n  }\n  *{box-sizing:border-box;}\n  body{\n    margin:0;\n    background:var(--bg);\n    font-family:\"Helvetica Neue\", Arial, Helvetica, sans-serif;\n    color:var(--teal-dark);\n  }\n  .page{\n    position:relative;\n    width:2105px;\n    max-width:100%;\n    margin:0 auto;\n    background:var(--bg);\n    padding:0;\n    overflow:hidden;\n  }\n  .left-band{\n    position:absolute;\n    top:0; left:0;\n    width:19%;\n    height:100%;\n    background:var(--bg-left);\n    z-index:0;\n  }\n  .content{position:relative; z-index:1; padding:40px 60px 40px 70px;}\n\n  /* ---------- Header ---------- */\n  .header{\n    display:flex;\n    align-items:center;\n    gap:22px;\n    margin-bottom:10px;\n  }\n  .pill{\n    border:3px solid var(--purple);\n    border-radius:40px;\n    background:#fff;\n    padding:10px 30px;\n    font-size:52px;\n    font-weight:800;\n    color:var(--purple);\n    letter-spacing:1px;\n    line-height:1;\n  }\n  .and{\n    font-size:28px;\n    letter-spacing:3px;\n    color:var(--purple);\n    font-weight:400;\n  }\n  .header-title{\n    font-size:48px;\n    letter-spacing:6px;\n    color:var(--purple);\n    font-weight:400;\n  }\n\n  /* ---------- Flow row of letters/icons ---------- */\n  .flow{\n    display:flex;\n    align-items:flex-end;\n    gap:0;\n    margin-top:20px;\n    height:230px;\n  }\n  .flow-col{flex:1; text-align:center; position:relative;}\n  .big-letter{\n    font-size:110px;\n    font-weight:800;\n    color:var(--purple);\n    line-height:1;\n  }\n  .placeholder{\n    background:#59c1c9;\n    border-radius:50%;\n    color:#0b4f5f;\n    font-size:12px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    text-align:center;\n    margin:12px auto 0;\n    padding:6px;\n  }\n  .circle{width:118px;height:118px;}\n\n  /* ---------- Columns ---------- */\n  .columns{\n    display:flex;\n    align-items:flex-start;\n    gap:0;\n    margin-top:10px;\n  }\n  .col{\n    padding:0 26px;\n    flex:1;\n  }\n  .col.divider{border-left:2px solid #8fd0da;}\n  .col-e1{flex:0 0 19%; padding-left:0;}\n\n  .label{\n    display:inline-block;\n    background:#fff;\n    border:2px solid var(--border);\n    border-radius:22px;\n    padding:14px 24px;\n    font-size:26px;\n    color:var(--teal-dark);\n    line-height:1.25;\n    margin-bottom:26px;\n  }\n  .label b{color:var(--purple); font-weight:700;}\n\n  ul.bullets{\n    margin:0;\n    padding-left:26px;\n    font-size:25px;\n    line-height:1.45;\n    color:var(--teal-dark);\n  }\n  ul.bullets li{margin-bottom:16px;}\n  .hl{background:var(--highlight); font-weight:700; color:var(--teal-dark);}\n  strong{color:var(--teal-dark);}\n\n  /* ---------- Trigger criteria ---------- */\n  .trigger-box{\n    display:inline-block;\n    background:#fff;\n    border-radius:16px;\n    padding:10px 20px;\n    font-size:25px;\n    font-weight:700;\n    color:var(--purple);\n    margin:40px 0 22px;\n  }\n  ol.trigger{\n    list-style:none;\n    margin:0; padding:0;\n    font-size:25px;\n    line-height:1.4;\n  }\n  ol.trigger li{\n    margin-bottom:14px;\n    padding-left:34px;\n    position:relative;\n  }\n  ol.trigger li .num{\n    position:absolute; left:0; top:0;\n    color:var(--purple);\n    font-weight:800;\n  }\n\n  /* ---------- Implementation strategies ---------- */\n  .impl-wrap{\n    display:flex;\n    gap:30px;\n    margin-top:40px;\n    align-items:flex-start;\n  }\n  .impl-left{flex:0 0 19%;}\n  .impl{\n    flex:1;\n    background:#fff;\n    border:2px solid var(--border);\n    border-radius:22px;\n    padding:34px 40px;\n  }\n  .impl h2{\n    margin:0 0 26px;\n    font-size:32px;\n    color:var(--purple);\n    font-weight:700;\n  }\n  .impl-grid{\n    display:grid;\n    grid-template-columns:1fr 1fr;\n    gap:34px 50px;\n  }\n  .impl-item{display:flex; gap:22px; align-items:flex-start;}\n  .impl-item .placeholder-sq{\n    flex:0 0 105px;\n    height:105px;\n    background:#eaf6f8;\n    border:1px dashed #8fd0da;\n    border-radius:8px;\n    font-size:11px;\n    color:#0b4f5f;\n    display:flex; align-items:center; justify-content:center;\n    text-align:center; padding:4px;\n  }\n  .impl-item p{\n    margin:0;\n    font-size:24px;\n    line-height:1.42;\n  }\n  .impl-item p b{color:var(--teal-dark);}\n\n  /* ---------- Logo ---------- */\n  .logo{\n    margin-top:60px;\n    width:330px;height:90px;\n    background:#eaf6f8;\n    border:1px dashed #8fd0da;\n    border-radius:6px;\n    display:flex;align-items:center;justify-content:center;\n    font-size:12px;color:#0b4f5f;text-align:center;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <div class=\"left-band\"></div>\n  <div class=\"content\">\n\n    <!-- Header -->\n    <div class=\"header\">\n      <div class=\"pill\">DETECT</div>\n      <div class=\"and\">AND</div>\n      <div class=\"pill\">TREAT</div>\n      <div class=\"header-title\">POSTPARTUM HAEMORRHAGE EARLY</div>\n    </div>\n\n    <!-- Flow of letters and icons -->\n    <div class=\"flow\">\n      <div class=\"flow-col\" style=\"flex:0 0 19%;\">\n        <div class=\"big-letter\">E</div>\n        <div class=\"placeholder circle\">[Icon: calibrated drape, centred]</div>\n      </div>\n      <div class=\"flow-col\">\n        <div class=\"big-letter\">M</div>\n        <div class=\"placeholder circle\">[Icon: uterine massage, centred]</div>\n      </div>\n      <div class=\"flow-col\">\n        <div class=\"big-letter\">O</div>\n        <div class=\"placeholder circle\">[Icon: syringe, centred]</div>\n      </div>\n      <div class=\"flow-col\">\n        <div class=\"big-letter\">T</div>\n        <div class=\"placeholder circle\">[Icon: syringe, centred]</div>\n      </div>\n      <div class=\"flow-col\">\n        <div class=\"big-letter\">IV</div>\n        <div class=\"placeholder circle\">[Icon: IV drip bag, centred]</div>\n      </div>\n      <div class=\"flow-col\">\n        <div class=\"big-letter\">E</div>\n        <div class=\"placeholder circle\">[Icon: magnifying glass, centred]</div>\n      </div>\n    </div>\n\n    <!-- Six content columns -->\n    <div class=\"columns\">\n\n      <!-- E : Early detection -->\n      <div class=\"col col-e1\">\n        <div class=\"label\"><b>E</b>arly detection<br>and trigger criteria</div>\n        <ul class=\"bullets\">\n          <li>Calibrated drape for blood loss collection with trigger lines at <span class=\"hl\">300ml and 500ml</span> for the first hour after birth</li>\n          <li>Observations (blood loss, blood flow, uterine tone) every <span class=\"hl\">15 minutes</span> documented on the blood loss monitoring chart</li>\n          <li>Blood pressure and pulse carried out once in the <span class=\"hl\">1st hour</span> postpartum and documented on the blood loss monitoring chart</li>\n        </ul>\n\n        <div class=\"trigger-box\">Trigger criteria</div>\n        <ol class=\"trigger\">\n          <li><span class=\"num\">1</span>Clinical judgement</li>\n          <li><span class=\"num\">2</span>Blood loss 500ml or more</li>\n          <li><span class=\"num\">3</span>Blood loss 300ml or more plus one abnormal observation</li>\n        </ol>\n      </div>\n\n      <!-- M : Massage -->\n      <div class=\"col\">\n        <div class=\"label\"><b>M</b>assage of uterus</div>\n        <ul class=\"bullets\">\n          <li>Massage until uterus has contracted or for <span class=\"hl\">one minute</span></li>\n        </ul>\n        <div class=\"placeholder\" style=\"background:#fff;border-radius:60px;width:100%;height:150px;margin-top:60px;color:#7fbfcb;\">[Illustration: white cloud shape]</div>\n      </div>\n\n      <!-- O : Oxytocic drugs -->\n      <div class=\"col divider\">\n        <div class=\"label\"><b>O</b>xytocic drugs</div>\n        <ul class=\"bullets\">\n          <li><strong>10 IU IV oxytocin injection</strong> or diluted in <strong>200-500ml crystalloid</strong> over <strong>10 minutes</strong> plus a maintenance dose for <strong>20 IU IV oxytcin</strong> diluted in <strong>1000ml saline</strong> over <strong>4 hours</strong> (+- misoprostol 800mcg PR/SL if used)</li>\n        </ul>\n      </div>\n\n      <!-- T : Tranexamic acid -->\n      <div class=\"col divider\">\n        <div class=\"label\"><b>T</b>ranexamic acid</div>\n        <ul class=\"bullets\">\n          <li><strong>1g IV injection of tranexamic acid</strong> or diluted in <strong>200ml crystalloid</strong> over <strong>10 minutes</strong></li>\n        </ul>\n      </div>\n\n      <!-- IV : fluids -->\n      <div class=\"col divider\">\n        <div class=\"label\"><b>IV</b> fluids</div>\n        <ul class=\"bullets\">\n          <li>IV fluids in addition to the infusion should be given if clinically indicated for resuscitation and will require a <span class=\"hl\">2nd IV access</span></li>\n        </ul>\n      </div>\n\n      <!-- E : Examination and escalation -->\n      <div class=\"col divider\">\n        <div class=\"label\"><b>E</b>xamination<br>and escalation</div>\n        <ul class=\"bullets\">\n          <li>Ensure bladder is empty, evacuate clots, check for tears with an internal examination and placenta for completeness</li>\n          <li>Escalate if bleeding does not stop after first response or you are unable to identify or manage cause of bleeding</li>\n        </ul>\n      </div>\n    </div>\n\n    <!-- Implementation strategies -->\n    <div class=\"impl-wrap\">\n      <div class=\"impl-left\">\n        <div class=\"logo\">[Logos: World Health Organization; hrp human reproduction programme, research for impact — UNDP·UNFPA·UNICEF·WHO·WORLD BANK]</div>\n      </div>\n      <div class=\"impl\">\n        <h2>Implementation strategies</h2>\n        <div class=\"impl-grid\">\n          <div class=\"impl-item\">\n            <div class=\"placeholder-sq\">[Icon: document/newsletter]</div>\n            <p><b>Audit newsletters:</b> sharing with all staff monthly detection and bundle use rates along with PPH, severe PPH, blood transfusion, laparotomy and death from PPH rates and given feedback at monthly departmental meetings</p>\n          </div>\n          <div class=\"impl-item\">\n            <div class=\"placeholder-sq\">[Icon: carry case / trolley bag]</div>\n            <p><b>Trolley and/or carry case:</b> including all medicines and devices required for the treatment of PPH restocked after every use and complete a stocking checklist at the start of every shift</p>\n          </div>\n          <div class=\"impl-item\">\n            <div class=\"placeholder-sq\">[Icon: trophy]</div>\n            <p><b>Champions:</b> midwife and doctor to oversee change, troubleshoot, give feedback on audit newsletters, connect with other champions through chats, meeting and websites for sharing knowledge and lessons learnt</p>\n          </div>\n          <div class=\"impl-item\">\n            <div class=\"placeholder-sq\">[Icon: presentation board with chart]</div>\n            <p><b>Training:</b> on-site, simulation-based, and peer-assisted training of 90 minutes to a whole day facilitated by the use of provider guides, flipcharts and job aids displayed in labour wards</p>\n          </div>\n        </div>\n      </div>\n    </div>\n\n  </div>\n</div>\n</body>\n</html>"
