rfield — lower-right panel */\n  .ph-man-right { top: 330px; left: 275px; width: 183px; height: 165px; }\n\n  /* ---- Title block (overlaid, left of center) ---- */\n  .title-block {\n    position: absolute;\n    top: 200px;\n    left: 55px;\n    width: 200px;\n    border: 1px solid #7a6a4f;\n    background: #efece5;\n    padding: 12px 10px 14px;\n    text-align: center;\n  }\n  .director-top {\n    font-size: 9.5px;\n    font-weight: 700;\n    letter-spacing: 0.14em;\n    color: #7a5c33;\n    margin-bottom: 14px;\n  }\n  .title-line {\n    font-size: 26px;\n    font-weight: 400;\n    letter-spacing: 0.30em;\n    color: #1f1f1f;\n    line-height: 1.55;\n    text-indent: 0.30em;\n  }\n  .credits {\n    position: absolute;\n    top: 338px;\n    left: 58px;\n    width: 210px;\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 0.05em;\n    line-height: 1.6;\n    color: #2b2b2b;\n    text-transform: uppercase;\n  }\n\n  /* ---- Cast billing (bottom-center) ---- */\n  .cast {\n    position: absolute;\n    top: 558px;\n    left: 0;\n    width: 100%;\n    text-align: center;\n    color: #2b2b2b;\n  }\n  .cast .name {\n    margin-bottom: 9px;\n    line-height: 1.25;\n  }\n  .cast .first {\n    display: block;\n    font-size: 9.5px;\n    font-weight: 400;\n    letter-spacing: 0.14em;\n  }\n  .cast .last {\n    display: block;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 0.10em;\n  }\n  .release {\n    margin-top: 14px;\n    font-size: 11.5px;\n    letter-spacing: 0.10em;\n    color: #7a5c33;\n    line-height: 1.5;\n  }\n  .release .month { font-weight: 700; }\n\n  /* ---- Rating box (bottom-left) ---- */\n  .rating {\n    position: absolute;\n    bottom: 46px;\n    left: 34px;\n    display: inline-block;\n    border: 1px solid #6b6b6b;\n    padding: 2px 4px;\n  }\n  .rating .r {\n    display: inline-block;\n    font-size: 15px;\n    font-weight: 700;\n    padding-right: 4px;\n    border-right: 1px solid #6b6b6b;\n    vertical-align: middle;\n    color: #3a3a3a;\n  }\n  .rating .desc {\n    display: inline-block;\n    font-size: 3.6px;\n    letter-spacing: 0.02em;\n    line-height: 1.5;\n    text-align: left;\n    padding-left: 3px;\n    vertical-align: middle;\n    color: #3a3a3a;\n    text-transform: uppercase;\n  }\n</style>\n</head>\n<body>\n  <div class=\"poster\">\n\n    <div class=\"tagline\">\n      NOT EVERYTHING IS SUPPOSED<br>\n      TO MAKE YOU COMFORTABLE.\n    </div>\n\n    <div class=\"collage\">\n      <figure class=\"placeholder ph-man-left\">[Photo: bearded man in suit, top-left panel]</figure>\n      <figure class=\"placeholder ph-woman-center\">[Photo: blonde woman, top-center panel]</figure>\n      <figure class=\"placeholder ph-woman-right\">[Photo: young woman, top-right panel]</figure>\n      <figure class=\"placeholder ph-coat\">[Photo: plaid coat detail, lower-left panel]</figure>\n      <figure class=\"placeholder ph-man-right\">[Photo: bearded man in green jacket, lower-right panel]</figure>\n    </div>\n\n    <div class=\"title-block\">\n      <div class=\"director-top\">LUCA GUADAGNINO'S</div>\n      <div class=\"title-line\">AFTER</div>\n      <div class=\"title-line\">THE</div>\n      <div class=\"title-line\">HUNT</div>\n    </div>\n\n    <div class=\"credits\">\n      DIRECTED BY LUCA GUADAGNINO<br>\n      WRITTEN BY NORA GARRETT\n    </div>\n\n    <div class=\"cast\">\n      <div class=\"name\"><span class=\"first\">JULIA</span><span class=\"last\">ROBERTS</span></div>\n      <div class=\"name\"><span class=\"first\">AYO</span><span class=\"last\">EDEBIRI</span></div>\n      <div class=\"name\"><span class=\"first\">ANDREW</span><span class=\"last\">GARFIELD</span></div>\n      <div class=\"name\"><span class=\"first\">MICHAEL</span><span class=\"last\">STUHLBARG</span></div>\n      <div class=\"name\"><span class=\"first\">CHLOË</span><span class=\"last\">SEVIGNY</span></div>\n      <div class=\"release\">ONLY IN THEATERS<br><span class=\"month\">OCTOBER</span></div>\