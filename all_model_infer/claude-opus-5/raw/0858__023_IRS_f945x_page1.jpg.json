        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Form 945-X (Rev. February 2025) — Adjusted Annual Return of Withheld Federal Income Tax or Claim for Refund</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$','$']], displayMath: [['$$','$$']] }\n};\n</script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  html, body { margin:0; padding:0; background:#fff; }\n  body {\n    font-family: Helvetica, Arial, sans-serif;\n    color:#000;\n    font-size: 12.2pt;\n    line-height: 1.25;\n  }\n  .page {\n    width: 8.5in;\n    min-height: 11in;\n    margin: 0 auto;\n    padding: 0.55in 0.5in 0.4in 0.5in;\n    box-sizing: border-box;\n    position: relative;\n  }\n\n  /* ---------- Header ---------- */\n  .hdr-title { display:flex; align-items:flex-end; gap:8px; }\n  .hdr-title .lbl-form { font-size: 11pt; padding-bottom:3px; }\n  .hdr-title .num { font-size: 25pt; font-weight:bold; letter-spacing:-0.5px; }\n  .hdr-title .maintitle { font-size: 19pt; font-weight:bold; padding-left:14px; padding-bottom:1px; }\n\n  .hdr-sub { display:flex; justify-content:space-between; align-items:baseline; margin-top:4px; font-size:11.5pt; }\n  .hdr-sub .rev { width:32%; }\n  .hdr-sub .dept { width:44%; text-align:left; padding-left:26px; }\n  .hdr-sub .omb { width:24%; text-align:right; }\n\n  /* ---------- Top boxes row ---------- */\n  .top-row { display:flex; align-items:flex-start; margin-top:8px; }\n  .left-box { border:1.5px solid #000; width:64%; box-sizing:border-box; padding:8px 10px 4px 10px; }\n  .right-col { width:36%; box-sizing:border-box; padding-left:14px; }\n\n  b, strong { font-weight:bold; }\n  i, em { font-style:italic; }\n\n  .ein-row { display:flex; align-items:flex-start; }\n  .ein-label { font-size:11.5pt; font-weight:bold; line-height:1.3; width:200px; }\n  .ein-boxes { display:flex; align-items:center; gap:6px; margin-left:8px; }\n  .cell { border:1.4px solid #000; width:30px; height:30px; box-sizing:border-box; }\n  .dash { font-size:14pt; padding:0 2px; }\n\n  .field-row { display:flex; align-items:center; margin-top:10px; }\n  .field-lbl { font-size:11.5pt; white-space:nowrap; }\n  .fill { border:1.4px solid #000; height:30px; box-sizing:border-box; }\n\n  .addr-grid { margin-top:6px; }\n  .sublbl { font-size:11pt; text-align:center; }\n\n  .row-flex { display:flex; align-items:flex-end; gap:0; }\n\n  /* Right column boxes */\n  .rbox { border:1.5px solid #000; padding:8px 10px 12px 10px; }\n  .blackbar { background:#000; color:#fff; font-weight:bold; font-size:13pt; padding:2px 8px; display:inline-block; }\n  .rbox p { margin:6px 0 0 0; font-weight:bold; font-size:12pt; line-height:1.2; }\n  .yy-row { display:flex; align-items:center; gap:10px; margin-top:8px; }\n  .yy-box { border:1.4px solid #000; width:110px; height:28px; }\n  .date-row { display:flex; align-items:center; gap:6px; margin-top:10px; }\n  .date-box { border:1.4px solid #000; width:44px; height:28px; }\n  .slash { font-size:13pt; }\n\n  /* ---------- Intro text ---------- */\n  .intro { margin-top:8px; font-size:13pt; line-height:1.35; }\n\n  /* ---------- Part bars ---------- */\n  .partbar {\n    border-top:2px solid #000; border-bottom:2px solid #000;\n    margin-top:12px; padding:2px 0;\n    display:flex; align-items:center;\n  }\n  .partbar .tag { background:#000; color:#fff; font-weight:bold; font-size:13.5pt; padding:1px 10px; margin-left:0; }\n  .partbar .txt { font-weight:bold; font-size:14pt; margin-left:22px; }\n\n  /* ---------- Checkbox items ---------- */\n  .cbitem { display:flex; margin-top:22px; }\n  .cbox { border:1.5px solid #000; width:30px; height:30px; flex:0 0 30px; margin-left:22px; }\n  .cbtext { margin-left:22px; font-size:12.5pt; line-height:1.35; }\n\n  /* ---------- Part 2 columns header ---------- */\n  .colhdr { display:flex; margin-top:26px; }\n  .colhdr .spacer { width:31%; }\n  .colhdr .ch { width:16.5%; text-align:center; font-style:italic; font-weight:bold; font-size:12pt; line-height:1.25; }\n  .colhdr .op { width:3.5%; text-align:center; font-size:15pt; padding-top:56px; }\n  .colhdr .chtitle { font-style:italic; font-size:12.5pt; font-weight:normal; }\n  .colhdr .titlerow { display:flex; }\n  .colhdr .amt { padding-top:14px; }\n\n  /* ---------- Numbered money lines ---------- */\n  .mline { display:flex; align-items:flex-start; margin-top:20px; }\n  .mline .no { width:52px; text-align:right; font-weight:bold; font-size:12.5pt; padding-left:0; }\n  .mline .desc { width:300px; margin-left:14px; font-size:12.5pt; line-height:1.3; }\n  .mline .desc b { font-weight:bold; }\n  .money {\n    border:1.4px solid #000; width:150px; height:44px; box-sizing:border-box;\n    position:relative;\n  }\n  .money::after {\n    content:\".\"; position:absolute; right:26px; bottom:0px; font-size:15pt; font-weight:bold;\n  }\n  .op2 { width:34px; text-align:center; font-size:15pt; padding-top:12px; }\n\n  .total-line { display:flex; align-items:flex-start; margin-top:26px; }\n  .total-line .no { width:52px; text-align:right; font-weight:bold; font-size:12.5pt; }\n  .total-line .txt { margin-left:14px; font-size:12.5pt; }\n  .leaders { letter-spacing:6px; padding:0 8px; }\n\n  .subnote { margin-left:120px; margin-top:22px; font-size:12.5pt; }\n  .bullets { margin-left:120px; margin-top:14px; font-size:12.5pt; line-height:1.35; }\n  .bullets div { margin-bottom:8px; text-indent:-14px; padding-left:14px; }\n\n  /* ---------- Footer ---------- */\n  .footer {\n    border-top:2px solid #000; margin-top:34px; padding-top:6px;\n    display:flex; align-items:baseline; font-size:12pt;\n  }\n  .footer .f1 { flex:0 0 46%; font-weight:bold; }\n  .footer .f2 { flex:0 0 18%; font-style:italic; }\n  .footer .f3 { flex:0 0 18%; text-align:center; }\n  .footer .f4 { flex:1; text-align:right; }\n  .footer .f4 b { font-size:14pt; }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <!-- HEADER -->\n  <div class=\"hdr-title\">\n    <span class=\"lbl-form\">Form</span>\n    <span class=\"num\">945-X:</span>\n    <span class=\"maintitle\">Adjusted Annual Return of Withheld Federal Income Tax or Claim for Refund</span>\n  </div>\n\n  <div class=\"hdr-sub\">\n    <div class=\"rev\">(Rev. February 2025)</div>\n    <div class=\"dept\">Department of the Treasury — Internal Revenue Service</div>\n    <div class=\"omb\">OMB No. 1545-0029</div>\n  </div>\n\n  <!-- TOP ROW -->\n  <div class=\"top-row\">\n\n    <!-- LEFT BOX -->\n    <div class=\"left-box\">\n      <div class=\"ein-row\">\n        <div class=\"ein-label\">Employer identification number<br>(EIN)</div>\n        <div class=\"ein-boxes\">\n          <div class=\"cell\"></div>\n          <div class=\"cell\"></div>\n          <span class=\"dash\">–</span>\n          <div class=\"cell\"></div>\n          <div class=\"cell\"></div>\n          <div class=\"cell\"></div>\n          <div class=\"cell\"></div>\n          <div class=\"cell\"></div>\n          <div class=\"cell\"></div>\n          <div class=\"cell\"></div>\n        </div>\n      </div>\n\n      <div class=\"field-row\">\n        <div class=\"field-lbl\"><b>Name</b> <i>(not your trade name)</i></div>\n        <div class=\"fill\" style=\"flex:1; margin-left:8px;\"></div>\n      </div>\n\n      <div class=\"field-row\">\n        <div class=\"field-lbl\"><b>Trade name</b> <i>(if any)</i></div>\n        <div class=\"fill\" style=\"flex:1; margin-left:8px;\"></div>\n      </div>\n\n      <div class=\"field-row\">\n        <div class=\"field-lbl\"><b>Address</b></div>\n        <div class=\"fill\" style=\"flex:1; margin-left:2px;\"></div>\n      </div>\n\n      <div class=\"addr-grid\">\n        <div class=\"row-flex\" style=\"padding-left:78px;\">\n          <div class=\"sublbl\" style=\"width:210px;\">Number</div>\n          <div class=\"sublbl\" style=\"width:340px;\">Street</div>\n          <div class=\"sublbl\" style=\"width:230px;\">Suite or room number</div>\n        </div>\n\n        <div class=\"row-flex\" style=\"padding-left:78px; margin-top:2px;\">\n          <div class=\"fill\" style=\"width:560px;\"></div>\n          <div class=\"fill\" style=\"width:66px; margin-left:14px;\"></div>\n          <div class=\"fill\" style=\"width:210px; margin-left:14px;\"></div>\n        </div>\n        <div class=\"row-flex\" style=\"padding-left:78px; margin-top:2px;\">\n          <div class=\"sublbl\" style=\"width:560px; text-align:left; padding-left:14px;\">City</div>\n          <div class=\"sublbl\" style=\"width:80px;\">State</div>\n          <div class=\"sublbl\" style=\"width:224px;\">ZIP code</div>\n        </div>\n\n        <div class=\"row-flex\" style=\"padding-left:78px; margin-top:6px;\">\n          <div class=\"fill\" style=\"width:430px;\"></div>\n          <div class=\"fill\" style=\"width:222px; margin-left:20px;\"></div>\n          <div class=\"fill\" style=\"width:210px; margin-left:14px;\"></div>\n        </div>\n        <div class=\"row-flex\" style=\"padding-left:78px; margin-top:2px;\">\n          <div class=\"sublbl\" style=\"width:430px;\">Foreign country name</div>\n          <div class=\"sublbl\" style=\"width:242px;\">Foreign province/county</div>\n          <div class=\"sublbl\" style=\"width:224px;\">Foreign postal code</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- RIGHT COLUMN -->\n    <div class=\"right-col\">\n      <div class=\"rbox\">\n        <span class=\"blackbar\">Return You're Correcting ...</span>\n        <p>Enter the calendar year of the return<br>you're correcting:</p>\n        <div class=\"yy-row\">\n          <div class=\"yy-box\"></div>\n          <span style=\"font-size:13pt;\">(YYYY)</span>\n        </div>\n      </div>\n\n      <div class=\"rbox\" style=\"margin-top:26px;\">\n        <span class=\"blackbar\">Enter the date you discovered errors:</span>\n        <div class=\"date-row\">\n          <div class=\"date-box\"></div>\n          <span class=\"slash\">/</span>\n          <div class=\"date-box\"></div>\n          <span class=\"slash\">/</span>\n          <div class=\"date-box\" style=\"width:66px;\"></div>\n        </div>\n        <div style=\"font-size:13pt; margin-top:6px;\">(MM / DD / YYYY)</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- INTRO -->\n  <div class=\"intro\">\n    Read the separate instructions before you complete this form. Use this form to correct administrative errors made on Form 945,\n    Annual Return of Withheld Federal Income Tax. Use a separate Form 945-X for each year that needs correction. Type or print within\n    the boxes. You MUST complete both pages. Don't attach this form to Form 945.\n  </div>\n\n  <!-- PART 1 -->\n  <div class=\"partbar\">\n    <span class=\"tag\">Part 1:</span>\n    <span class=\"txt\">Select ONLY one process.</span>\n  </div>\n\n  <div class=\"cbitem\">\n    <div class=\"cbox\"></div>\n    <div class=\"cbtext\">\n      <b>1. Adjusted return of withheld federal income tax.</b> Check this box if you underreported amounts. Also check this box if you overreported\n      amounts and you would like to use the adjustment process to correct the errors. You must check this box if you're correcting both\n      underreported and overreported amounts on this form. The amount shown on line 5, if less than zero, may only be applied as a credit to\n      your Form 945 for the tax period in which you're filing this form.\n    </div>\n  </div>\n\n  <div class=\"cbitem\">\n    <div class=\"cbox\"></div>\n    <div class=\"cbtext\">\n      <b>2. Claim.</b> Check this box if you overreported amounts only and you would like to use the claim process to ask for a refund or abatement of the\n      amount shown on line 5. Don't check this box if you're correcting ANY underreported amounts on this form.\n    </div>\n  </div>\n\n  <!-- PART 2 -->\n  <div class=\"partbar\">\n    <span class=\"tag\">Part 2:</span>\n    <span class=\"txt\">Enter the corrections for the calendar year you're correcting. If any line doesn't apply, leave it blank.</span>\n  </div>\n\n  <!-- COLUMN HEADERS -->\n  <div class=\"colhdr\">\n    <div class=\"spacer\"></div>\n    <div class=\"ch\">\n      <div class=\"chtitle\">Column 1</div>\n      <div class=\"amt\">Total corrected<br>amount<br>(for ALL payees)</div>\n    </div>\n    <div class=\"op\">–</div>\n    <div class=\"ch\">\n      <div class=\"chtitle\">Column 2</div>\n      <div class=\"amt\">Amount originally<br>reported or as<br>previously corrected<br>(for ALL payees)</div>\n    </div>\n    <div class=\"op\">=</div>\n    <div class=\"ch\">\n      <div class=\"chtitle\">Column 3</div>\n      <div class=\"amt\">Difference<br>(If this amount is a<br>negative number,&nbsp; use<br>a minus sign.)</div>\n    </div>\n  </div>\n\n  <!-- LINE 3 -->\n  <div class=\"mline\">\n    <div class=\"no\">3.</div>\n    <div class=\"desc\"><b>Federal income tax withheld</b><br>(Form 945, line 1)</div>\n    <div class=\"money\"></div>\n    <div class=\"op2\">–</div>\n    <div class=\"money\"></div>\n    <div class=\"op2\">=</div>\n    <div class=\"money\"></div>\n  </div>\n\n  <!-- LINE 4 -->\n  <div class=\"mline\">\n    <div class=\"no\">4.</div>\n    <div class=\"desc\"><b>Backup withholding</b><br>(Form 945, line 2)</div>\n    <div class=\"money\"></div>\n    <div class=\"op2\">–</div>\n    <div class=\"money\"></div>\n    <div class=\"op2\">=</div>\n    <div class=\"money\"></div>\n  </div>\n\n  <!-- LINE 5 -->\n  <div class=\"total-line\">\n    <div class=\"no\">5.</div>\n    <div class=\"txt\" style=\"display:flex; align-items:flex-start;\">\n      <span style=\"padding-top:10px;\"><b>Total.</b> Combine the amounts on lines 3 and 4 of Column 3</span>\n      <span class=\"leaders\" style=\"padding-top:10px;\">. . . . . . . . .</span>\n      <span class=\"money\" style=\"margin-left:6px;\"></span>\n    </div>\n  </div>\n\n  <div class=\"subnote\"><b>If line 5 is less than zero:</b></div>\n\n  <div class=\"bullets\">\n    <div>• If you checked line 1, this is the amount you want applied as a credit to your Form 945 for the tax period in which you're<br>&nbsp;&nbsp;filing this form.</div>\n    <div>• If you checked line 2, this is the amount you want refunded or abated.</div>\n  </div>\n\n  <div class=\"bullets\" style=\"margin-top:34px;\">\n    <div style=\"text-indent:0; padding-left:0;\"><b>If line 5 is more than zero, this is the amount you owe.</b> Pay this amount when you file this return. For information on how to pay, see\n    <i>Amount you owe</i> in the instructions for line 5.</div>\n  </div>\n\n  <!-- FOOTER -->\n  <div class=\"footer\">\n    <div class=\"f1\">For Paperwork Reduction Act Notice, see the separate instructions.</div>\n    <div class=\"f2\">www.irs.gov/Form945X</div>\n    <div class=\"f3\">Cat. No. 20336X</div>\n    <div class=\"f4\">Form <b>945-X</b> (Rev. 2-2025)</div>\n  </div>\n\n</div>\n</body>\n</html>"
