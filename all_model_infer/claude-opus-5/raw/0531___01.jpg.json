        "content": "<!DOCTYPE html>\n<html lang=\"zh-Hant\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>申報 THE SHENG PAO — MARCH 20th 1939</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$','$']], displayMath: [['$$','$$']] }\n};\n</script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  body{\n    margin:0;\n    padding:10px 14px 20px;\n    background:#e9e2d0;\n    font-family:\"Songti SC\",\"SimSun\",\"Noto Serif TC\",serif;\n    color:#1a1a1a;\n  }\n  .page{\n    max-width:1030px;\n    margin:0 auto;\n  }\n  /* ---------- masthead strip ---------- */\n  .topbar{\n    display:flex;\n    justify-content:space-between;\n    align-items:baseline;\n    font-family:\"Courier New\",monospace;\n    letter-spacing:2px;\n    font-size:15px;\n    padding:0 20px 6px;\n  }\n  .topbar .center{\n    font-size:19px;\n    letter-spacing:5px;\n  }\n  /* ---------- outer frame ---------- */\n  .frame{\n    border:2px solid #111;\n    padding:6px;\n  }\n  .inner{\n    border:1px solid #111;\n    padding:8px 10px;\n  }\n  /* ---------- vertical text helpers ---------- */\n  .vwrap{\n    display:flex;\n    flex-direction:row-reverse;\n    justify-content:flex-start;\n    align-items:flex-start;\n  }\n  .v{\n    writing-mode:vertical-rl;\n    text-orientation:upright;\n    line-height:1.45;\n  }\n  /* ---------- section 1 ---------- */\n  .sec1{\n    display:flex;\n    flex-direction:row-reverse;\n    align-items:stretch;\n    border-bottom:2px solid #111;\n    padding-bottom:8px;\n  }\n  .nameplate{\n    width:270px;\n    flex:0 0 270px;\n    border-left:1px solid #111;\n    padding:0 10px;\n    text-align:center;\n  }\n  .nameplate .logo{\n    font-size:96px;\n    font-weight:700;\n    line-height:1.02;\n    letter-spacing:4px;\n    margin:8px 0 14px;\n    font-family:\"STKaiti\",\"KaiTi\",\"Noto Serif TC\",serif;\n  }\n  .nameplate .dateline{\n    border-top:1px solid #111;\n    padding:6px 0;\n    font-size:19px;\n    letter-spacing:2px;\n  }\n  .sec1-text{\n    flex:1 1 auto;\n    display:flex;\n    flex-direction:row-reverse;\n    padding:0 8px;\n  }\n  .headline1{\n    writing-mode:vertical-rl;\n    text-orientation:upright;\n    font-size:30px;\n    font-weight:700;\n    letter-spacing:3px;\n    line-height:1.5;\n    height:600px;\n    margin-left:6px;\n  }\n  .body1{\n    writing-mode:vertical-rl;\n    text-orientation:upright;\n    font-size:21px;\n    letter-spacing:1px;\n    line-height:1.55;\n    height:600px;\n  }\n  .photo-wrap{\n    flex:0 0 auto;\n    width:380px;\n    margin-left:8px;\n  }\n  .placeholder{\n    background:#8a8578;\n    color:#f4f1e8;\n    border:1px solid #111;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    text-align:center;\n    font-family:\"Courier New\",monospace;\n    font-size:13px;\n    letter-spacing:1px;\n    padding:4px;\n    box-sizing:border-box;\n  }\n  .photo1{ width:380px; height:420px; }\n  .cap1{\n    writing-mode:vertical-rl;\n    text-orientation:upright;\n    font-size:21px;\n    line-height:1.55;\n    height:200px;\n    margin-top:8px;\n  }\n  /* ---------- section 2 ---------- */\n  .sec2{\n    display:flex;\n    flex-direction:row-reverse;\n    align-items:flex-start;\n    padding-top:10px;\n  }\n  .headline2{\n    writing-mode:vertical-rl;\n    text-orientation:upright;\n    font-size:34px;\n    font-weight:700;\n    letter-spacing:3px;\n    line-height:1.55;\n    height:780px;\n    padding-left:6px;\n  }\n  .body2{\n    writing-mode:vertical-rl;\n    text-orientation:upright;\n    font-size:21px;\n    letter-spacing:1px;\n    line-height:1.55;\n    height:780px;\n    border-left:1px dashed #333;\n    padding-left:8px;\n    margin-left:8px;\n  }\n  .col-mid{\n    display:flex;\n    flex-direction:column;\n    align-items:flex-end;\n    margin:0 8px;\n  }\n  .photo2{ width:210px; height:300px; }\n  .body3{\n    writing-mode:vertical-rl;\n    text-orientation:upright;\n    font-size:21px;\n    line-height:1.55;\n    height:470px;\n    margin-top:8px;\n  }\n  .banks{\n    display:flex;\n    flex-direction:column;\n    align-items:flex-end;\n    border-right:1px solid #111;\n    padding-right:8px;\n  }\n  .nanjing{\n    font-size:44px;\n    font-weight:700;\n    writing-mode:vertical-rl;\n    text-orientation:upright;\n    letter-spacing:4px;\n    height:180px;\n    font-family:\"STKaiti\",\"KaiTi\",serif;\n  }\n  .banklist{\n    display:flex;\n    flex-direction:row-reverse;\n    align-items:flex-start;\n    margin-top:6px;\n  }\n  .banklist .v{\n    font-size:22px;\n    letter-spacing:2px;\n    height:520px;\n    margin-left:2px;\n  }\n  .notice{\n    writing-mode:vertical-rl;\n    text-orientation:upright;\n    font-size:30px;\n    font-weight:700;\n    letter-spacing:3px;\n    height:120px;\n    margin-left:4px;\n  }\n  .notice-small{\n    writing-mode:vertical-rl;\n    text-orientation:upright;\n    font-size:19px;\n    letter-spacing:1px;\n    height:180px;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"topbar\">\n    <span>MARCH&nbsp;&nbsp;20<sup>th</sup>&nbsp;&nbsp;1939</span>\n    <span class=\"center\">THE&nbsp; SHENG&nbsp; PAO</span>\n    <span>PUBLISHED DAILY</span>\n  </div>\n\n  <div class=\"frame\">\n   <div class=\"inner\">\n\n    <!-- ================= SECTION 1 ================= -->\n    <div class=\"sec1\">\n\n      <div class=\"nameplate\">\n        <div class=\"logo\">申<br>報</div>\n        <div class=\"dateline\">年八十三國民華中</div>\n        <div class=\"dateline\">年九三百九千一曆西</div>\n        <div class=\"dateline\">一期星&nbsp;&nbsp;號十二月三</div>\n      </div>\n\n      <div class=\"sec1-text\">\n        <div class=\"headline1\">\n          新政府經濟司要員明樓抵滬<br>\n          攜弟明誠履新 主持物資統制事宜\n        </div>\n        <div class=\"body1\">\n          【本報上海訊】新政府經濟司要員明樓氏昨日抵滬，隨行者有其弟明誠。據悉，明氏將主持華東物資統制事宜，並兼任特務委員會副主任。明誠則出任經濟司秘書處長，協助其兄處理日常公務。明氏兄弟抵滬後，已拜會各方要員，近期將正式開展工作。\n        </div>\n      </div>\n\n      <div class=\"photo-wrap\">\n        <figure class=\"placeholder photo1\" style=\"margin:0;\">\n          [Photo: two men in overcoats walking through an arcade — top-left of page]\n        </figure>\n      </div>\n    </div>\n\n    <!-- ================= SECTION 2 ================= -->\n    <div class=\"sec2\">\n\n      <div class=\"headline2\">\n        比商有利銀公司今日開幕<br>\n        全歐抗聯會致函利物浦僑胞<br>\n        呼籲加緊輸財救國\n      </div>\n\n      <div class=\"body2\">\n        【本報巴黎訊】全歐華僑抗日救國聯合會昨致函利物浦中國國民抗日救國會，通報國內戰局，動員僑胞繼續捐款捐物、抵制日貨。函稱，祖國抗戰正值艱難，海外支援不可稍懈，望利物浦僑胞再接再厲，共盡救國責任。\n      </div>\n\n      <div class=\"col-mid\">\n        <figure class=\"placeholder photo2\" style=\"margin:0;\">\n          [Photo: crowded old street with shop banners — middle of lower page]\n        </figure>\n        <div class=\"body3\">\n          閶門石路漸復元氣，菜館茶館反較戰前興隆。鄉民紛紛返城，北局入夜遊人如織。然物價日昂，升鬥小民謀一飽亦難，「天堂」光景終非昔比。\n        </div>\n      </div>\n\n      <div class=\"banks\">\n        <div class=\"nanjing\">南京</div>\n        <div class=\"banklist\">\n          <div class=\"v\">江蘇銀行&nbsp;&nbsp;金城銀行&nbsp;&nbsp;浙江興業銀行</div>\n          <div class=\"v\">中國銀行&nbsp;&nbsp;大陸銀行&nbsp;&nbsp;中國農工銀行</div>\n          <div class=\"v\">中央銀行&nbsp;&nbsp;中南銀行&nbsp;&nbsp;中國實業銀行</div>\n          <div class=\"v\">交通銀行&nbsp;&nbsp;國華銀行&nbsp;&nbsp;中國國貨銀行</div>\n          <div class=\"v\">上海銀行&nbsp;&nbsp;興民銀行&nbsp;&nbsp;四行儲蓄會</div>\n          <div class=\"notice\">通告</div>\n          <div class=\"notice-small\">休業五日<br>三月二十<br>五日后<br>照常營業</div>\n        </div>\n      </div>\n\n    </div>\n\n   </div>\n  </div>\n</div>\n</body>\n</html>"
