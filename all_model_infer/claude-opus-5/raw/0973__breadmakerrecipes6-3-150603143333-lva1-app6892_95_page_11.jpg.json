        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Jalapeno Bread - 1 lb. Loaf Recipe</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] }\n};\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\" async></script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    font-family: \"Calibri\", \"Candara\", \"Segoe UI\", sans-serif;\n    background: #f2ece4;\n  }\n  .slide {\n    position: relative;\n    width: 1024px;\n    height: 768px;\n    margin: 0 auto;\n    background: #efe4d8;\n    overflow: hidden;\n  }\n\n  /* Decorative photographic background band (bread photo) */\n  .bg-photo {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background: linear-gradient(160deg, #e8d4bd 0%, #d9bfa2 40%, #e5d2bb 70%, #f4ece2 100%);\n    opacity: 0.85;\n  }\n\n  /* Left orange vertical bar */\n  .left-bar {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 14px;\n    height: 100%;\n    background: #f7941e;\n    z-index: 5;\n  }\n\n  /* Black header band */\n  .header-band {\n    position: absolute;\n    top: 14px;\n    left: 14px;\n    right: 0;\n    height: 82px;\n    background: #000000;\n    z-index: 3;\n  }\n  .header-band .title {\n    position: absolute;\n    top: 50%;\n    left: 0;\n    right: 0;\n    transform: translateY(-50%);\n    text-align: center;\n    color: #ffffff;\n    font-size: 40px;\n    font-weight: normal;\n    letter-spacing: 0.2px;\n  }\n\n  /* Peach ribbon banner with \"1 lb. Loaf\" */\n  .ribbon {\n    position: absolute;\n    top: 14px;\n    left: 14px;\n    width: 212px;\n    height: 106px;\n    background: #f6cba9;\n    border-radius: 0 0 60% 30% / 0 0 45% 100%;\n    z-index: 6;\n    box-shadow: 0 2px 3px rgba(0,0,0,0.12);\n  }\n  .ribbon span {\n    position: absolute;\n    top: 44px;\n    left: 42px;\n    font-size: 21px;\n    color: #231f20;\n  }\n\n  /* Main content region: table (left) + directions (right) */\n  .content {\n    position: absolute;\n    top: 152px;\n    left: 32px;\n    right: 24px;\n    display: flex;\n    align-items: flex-start;\n    z-index: 4;\n  }\n\n  table.recipe {\n    width: 640px;\n    border-collapse: collapse;\n    background: #ffffff;\n    border: 2px solid #000000;\n    font-size: 20px;\n  }\n  table.recipe th {\n    background: #000000;\n    color: #ffffff;\n    font-size: 21px;\n    padding: 9px 12px;\n    border: 1px solid #000000;\n  }\n  table.recipe th.ing { text-align: left; width: 313px; }\n  table.recipe th.amt { text-align: center; }\n  table.recipe td {\n    border: 1px solid #000000;\n    padding: 9px 12px;\n    vertical-align: middle;\n    line-height: 1.25;\n  }\n  table.recipe td.ing { text-align: left; width: 313px; }\n  table.recipe td.amt { text-align: center; }\n\n  .directions {\n    flex: 1;\n    margin-left: 22px;\n    font-size: 19px;\n    line-height: 1.32;\n    color: #1a1a1a;\n  }\n  .directions h2 {\n    margin: 0 0 10px 0;\n    text-align: center;\n    font-size: 27px;\n    font-weight: normal;\n    letter-spacing: 0.3px;\n  }\n  .directions p {\n    margin: 0 0 16px 0;\n    text-indent: 0;\n  }\n  .directions p.tight { margin-bottom: 6px; }\n</style>\n</head>\n<body>\n  <div class=\"slide\">\n    <div class=\"bg-photo\"></div>\n    <div class=\"header-band\">\n      <div class=\"title\">Jalapeno Bread</div>\n    </div>\n    <div class=\"left-bar\"></div>\n    <div class=\"ribbon\"><span>1 lb. Loaf</span></div>\n\n    <div class=\"content\">\n      <table class=\"recipe\">\n        <thead>\n          <tr>\n            <th class=\"ing\">Ingredients</th>\n            <th class=\"amt\">1 lb.</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr><td class=\"ing\">Water (80&deg;F &ndash; 90&deg;F)</td><td class=\"amt\">&frac12; cup</td></tr>\n          <tr><td class=\"ing\">Oil</td><td class=\"amt\">1 &frac12; tbsp.</td></tr>\n          <tr><td class=\"ing\">Canned Whole Kernel Corn,<br>well drained</td><td class=\"amt\">&frac12; cup</td></tr>\n          <tr><td class=\"ing\">Jalapeno Peppers, well<br>drained</td><td class=\"amt\">2 TBL</td></tr>\n          <tr><td class=\"ing\">Sugar</td><td class=\"amt\">&frac34; tsp.</td></tr>\n          <tr><td class=\"ing\">Salt</td><td class=\"amt\">&frac14; tsp.</td></tr>\n          <tr><td class=\"ing\">Bread Four</td><td class=\"amt\">2 cups</td></tr>\n          <tr><td class=\"ing\">Bread Machine Yeast</td><td class=\"amt\">&frac34; tsp.</td></tr>\n          <tr><td class=\"ing\">Corn Meal</td><td class=\"amt\">&#8531; cup</td></tr>\n          <tr><td class=\"ing\">Fresh Cilantro, chopped</td><td class=\"amt\">2 tsp.</td></tr>\n          <tr><td class=\"ing\">Active Dry Yeast</td><td class=\"amt\">1 &frac34;&nbsp; tsp.</td></tr>\n        </tbody>\n      </table>\n\n      <div class=\"directions\">\n        <h2>DIRECTIONS</h2>\n        <p>&bull; Place ingredients in the pan of the bread machine in the order the ingredients are listed.</p>\n        <p>&bull; Insert bread pan securely into baking chamber; close lid. Plug unit into wall outlet.</p>\n        <p>&bull; Select white bread cycle, crust color, and the correct&nbsp; loaf size; press Start.</p>\n        <p>&bull; When the bread is finished and all cycles are complete, remove the pan from the chamber (using potholders).</p>\n        <p class=\"tight\">&bull; Remove the bread from the pan and allow to cool (at least 20 minutes).</p>\n      </div>\n    </div>\n  </div>\n</body>\n</html>"
