idth: 430px;\n    height: 400px;\n    margin: 4px auto 0;\n  }\n\n  /* Title */\n  .title {\n    margin-top: 6px;\n    font-size: 46px;\n    line-height: 1;\n    white-space: nowrap;\n  }\n  .title .script {\n    font-family: \"Brush Script MT\", \"Segoe Script\", cursive;\n    font-style: italic;\n    color: #1f3fa0;\n    font-weight: 400;\n  }\n  .title .bold {\n    font-family: \"Helvetica Neue\", Arial, sans-serif;\n    font-weight: 700;\n    color: #b02b8f;\n    letter-spacing: -1px;\n  }\n\n  /* Billing block */\n  .billing {\n    margin-top: 26px;\n    font-size: 10px;\n    letter-spacing: 1.1px;\n    color: #1f3fa0;\n    text-transform: uppercase;\n  }\n  .billing .small {\n    font-size: 7px;\n    letter-spacing: 0.8px;\n    vertical-align: 1px;\n  }\n  .billing .name {\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 1px;\n  }\n\n  /* Bottom bar */\n  .bottom-bar {\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 10px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 0 18px;\n    box-sizing: border-box;\n  }\n  .logos-left, .logos-right {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n  }\n  .logo-ph {\n    border: 1px dashed #b9a6c4;\n    background: #fbf4f8;\n    color: #8a7794;\n    font-size: 7px;\n    letter-spacing: 0.4px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    padding: 2px;\n    box-sizing: border-box;\n  }\n  .logo-orion { width: 46px; height: 20px; }\n  .logo-ua    { width: 30px; height: 22px; }\n  .logo-rating{ width: 52px; height: 18px; }\n  .logo-amazon{ width: 44px; height: 20px; }\n\n  .release {\n    font-size: 22px;\n    font-weight: 500;\n    letter-spacing: 0.5px;\n    color: #111;\n    white-space: nowrap;\n  }\n  .release .divider {\n    color: #111;\n    margin: 0 8px;\n    font-weight: 300;\n  }\n</style>\n</head>\n<body>\n  <div class=\"poster\">\n\n    <div class