        </thead>\n        <tbody>\n          <tr><td>give</td><td>gave</td><td>given <span class=\"note\">给去</span></td></tr>\n          <tr><td>go</td><td>went</td><td>gone <span class=\"note\">去</span></td></tr>\n          <tr><td>grow</td><td>grew</td><td>grown <span class=\"note\">生长</span></td></tr>\n          <tr><td>hang</td><td>hung</td><td>hung <span class=\"note\">悬挂</span></td></tr>\n          <tr><td>have (has)</td><td>had</td><td>had <span class=\"note\">有</span></td></tr>\n          <tr><td>hear</td><td>heard</td><td>heard <span class=\"note\">听见</span></td></tr>\n          <tr><td>hide</td><td>hid</td><td>hidden <span class=\"note\">隐藏</span></td></tr>\n          <tr><td>hit</td><td>hit</td><td>hit <span class=\"note\">打</span></td></tr>\n          <tr><td>hold</td><td>held</td><td>held <span class=\"note\">拿住抓住</span></td></tr>\n          <tr><td>hurt</td><td>hurt</td><td>hurt <span class=\"note\">使受伤</span></td></tr>\n          <tr><td>keep</td><td>kept</td><td>kept <span class=\"note\">保持</span></td></tr>\n          <tr><td>know</td><td>knew</td><td>known <span class=\"note\">知道</span></td></tr>\n          <tr><td>lay</td><td>laid</td><td>laid <span class=\"note\">放置</span></td></tr>\n          <tr><td>lead</td><td>led</td><td>led <span class=\"note\">领导</span></td></tr>\n          <tr><td>learn</td><td>learnt/learned</td><td>learnt/learned <span class=\"note\">学习</span></td></tr>\n          <tr><td>leave</td><td>left</td><td>left <span class=\"note\">离开</span></td></tr>\n          <tr><td>lend</td><td>lent</td><td>lent <span class=\"note\">借出</span></td></tr>\n          <tr><td>let</td><td>let</td><td>let <span class=\"note\">让</span></td></tr>\n          <tr><td>lie (躺)</td><td>lay</td><td>lain</td></tr>\n          <tr><td>light</td><td>lit/lighted</td><td>lit/lighted <span class=\"note\">点燃</span></td></tr>\n          <tr><td>lose</td><td>lost</td><td>lost <span class=\"note\">失去</span></td></tr>\n          <tr><td>make</td><td>made</td><td>made