        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Irregular Verbs 不规则动词</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$','$']], displayMath: [['$$','$$']] }\n};\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\" async></script>\n<style>\n  body {\n    font-family: Arial, Helvetica, sans-serif;\n    background: #f2f0ec;\n    margin: 0;\n    padding: 10px 18px 30px 18px;\n    color: #222;\n  }\n  .page {\n    max-width: 760px;\n    margin: 0 auto;\n    background: #f7f5f1;\n    padding: 8px 14px 20px 14px;\n    box-sizing: border-box;\n  }\n  .header {\n    text-align: right;\n    font-size: 11px;\n    color: #333;\n    border-bottom: 1px solid #999;\n    padding-bottom: 2px;\n    margin-bottom: 10px;\n  }\n  h1 {\n    text-align: center;\n    font-size: 20px;\n    margin: 6px 0 2px 0;\n    font-weight: bold;\n  }\n  .ann {\n    color: #c00000;\n    font-size: 11px;\n  }\n  .ann-row {\n    display: flex;\n    gap: 0;\n    margin: 2px 0 1px 0;\n  }\n  .ann-row .col {\n    flex: 1;\n    display: flex;\n  }\n  .ann-row .cell {\n    flex: 1;\n    text-align: center;\n  }\n  .columns {\n    display: flex;\n    gap: 12px;\n    align-items: flex-start;\n  }\n  .col {\n    flex: 1;\n  }\n  table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 11px;\n    table-layout: fixed;\n  }\n  th, td {\n    border: 1px solid #555;\n    padding: 3px 4px;\n    height: 18px;\n    vertical-align: middle;\n    word-wrap: break-word;\n  }\n  th {\n    text-align: center;\n    font-weight: bold;\n  }\n  th:first-child, td:first-child { width: 30%; }\n  .note {\n    color: #c00000;\n    font-family: \"KaiTi\", \"STKaiti\", serif;\n    font-size: 11px;\n    padding-left: 3px;\n  }\n  .placeholder {\n    border: 1px dashed #999;\n    color: #666;\n    font-size: 10px;\n    text-align: center;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"header\">Irregular Verbs</div>\n\n  <h1>Irregular Verbs <span style=\"font-weight:bold;\">不规则动词</span></h1>\n\n  <div class=\"ann-row\">\n    <div class=\"col\">\n      <div class=\"cell ann\">动词原形</div>\n      <div class=\"cell ann\">过去式</div>\n      <div class=\"cell ann\">过去分词</div>\n    </div>\n    <div class=\"col\">\n      <div class=\"cell ann\">动词原形</div>\n      <div class=\"cell ann\">过去式</div>\n      <div class=\"cell ann\">过去分词</div>\n    </div>\n  </div>\n\n  <div class=\"columns\">\n\n    <!-- LEFT COLUMN -->\n    <div class=\"col\">\n      <table>\n        <thead>\n          <tr><th>Verb</th><th>Past tense</th><th>Past participle</th></tr>\n        </thead>\n        <tbody>\n          <tr><td>be (am, is, are)</td><td>was, were</td><td>been <span class=\"note\">是</span></td></tr>\n          <tr><td>bear</td><td>bore</td><td>born, borne <span class=\"note\">忍受</span></td></tr>\n          <tr><td>beat</td><td>beat</td><td>beaten <span class=\"note\">击打</span></td></tr>\n          <tr><td>become</td><td>became</td><td>become <span class=\"note\">变得成为</span></td></tr>\n          <tr><td>begin</td><td>began</td><td>begun <span class=\"note\">开始</span></td></tr>\n          <tr><td>blow</td><td>blew</td><td>blown <span class=\"note\">吹</span></td></tr>\n          <tr><td>break</td><td>broke</td><td>broken <span class=\"note\">使破碎</span></td></tr>\n          <tr><td>bring</td><td>brought</td><td>brought <span class=\"note\">带来</span></td></tr>\n          <tr><td>build</td><td>built</td><td>built <span class=\"note\">建造</span></td></tr>\n          <tr><td>burn</td><td>burnt/burned</td><td>burnt/burned <span class=\"note\">燃烧</span></td></tr>\n          <tr><td>buy</td><td>bought</td><td>bought <span class=\"note\">买</span></td></tr>\n          <tr><td>catch</td><td>caught</td><td>caught <span class=\"note\">捉住抓</span></td></tr>\n          <tr><td>choose</td><td>chose</td><td>chosen <span class=\"note\