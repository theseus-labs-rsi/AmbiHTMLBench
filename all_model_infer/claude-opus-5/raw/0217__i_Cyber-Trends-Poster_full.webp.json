        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Stay in the Know. Lead the Change. — Cybersecurity Infographic</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] }\n};\n</script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    background: #2A1A63;\n    font-family: \"Helvetica Neue\", Arial, Helvetica, sans-serif;\n    color: #ffffff;\n  }\n  .page {\n    width: 1656px;\n    margin: 0 auto;\n    padding: 120px 100px 90px 100px;\n    position: relative;\n  }\n\n  /* ---------- Headline ---------- */\n  h1.headline {\n    font-size: 112px;\n    line-height: 0.98;\n    font-weight: 800;\n    letter-spacing: -2px;\n    margin: 0 0 150px 0;\n    text-align: left;\n    padding-left: 8px;\n  }\n\n  /* ---------- Section titles ---------- */\n  .section-title {\n    font-size: 34px;\n    font-weight: 700;\n    margin: 0 0 22px 12px;\n  }\n  .title-purple { color: #B29BF5; }\n  .title-pink   { color: #F5A8DC; text-align: right; margin-right: 12px; }\n  .title-white  { color: #FFFFFF; }\n\n  /* ---------- Cards ---------- */\n  .card {\n    border-radius: 30px;\n    display: flex;\n    align-items: stretch;\n    overflow: hidden;\n  }\n  .card-purple { background: #B08CF5; color: #1B1240; }\n  .card-pink   { background: #F9A8D9; color: #3A1230; }\n  .card-cream  { background: #FCE7DE; color: #3A2020; }\n\n  /* ---------- Tables ---------- */\n  table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 19px;\n  }\n  thead th {\n    font-size: 16px;\n    font-weight: 700;\n    letter-spacing: 0.5px;\n    padding: 26px 10px 22px 10px;\n    text-align: center;\n    line-height: 1.25;\n  }\n  thead tr { border-bottom: 1.5px solid rgba(60,40,110,0.45); }\n  tbody td {\n    text-align: center;\n    padding: 21px 10px;\n    font-weight: 400;\n  }\n\n  .table-zone { padding: 22px 40px 34px 40px; }\n\n  /* ---------- Placeholders (illustrations) ---------- */\n  .placeholder {\n    background: rgba(255,255,255,0.18);\n    border: 2px dashed rgba(80,50,140,0.45);\n    border-radius: 20px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    font-size: 15px;\n    color: #3B2470;\n    padding: 10px;\n    flex: none;\n  }\n\n  /* Section 1 layout */\n  .sec1 .table-zone { width: 1000px; }\n  .sec1 .placeholder { width: 470px; height: 430px; margin: 25px 25px 25px 0; }\n\n  /* Section 2 layout */\n  .sec2 { margin-top: 90px; }\n  .sec2 .placeholder { width: 500px; height: 430px; margin: 25px 0 25px 25px; }\n  .sec2 .table-zone { width: 930px; }\n\n  /* Section 3 layout */\n  .sec3 { margin-top: 110px; }\n  .sec3 .table-zone { width: 900px; }\n  .sec3 .placeholder { width: 520px; height: 340px; margin: 25px 25px 25px 0; }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <h1 class=\"headline\">STAY IN THE KNOW.<br>LEAD THE CHANGE.</h1>\n\n  <!-- ===== Section 1 : Top Cybersecurity Threats ===== -->\n  <div class=\"section sec1\">\n    <div class=\"section-title title-purple\">Top Cybersecurity Threats</div>\n    <div class=\"card card-purple\">\n      <div class=\"table-zone\">\n        <table>\n          <thead>\n            <tr>\n              <th style=\"width:16%\">RANK</th>\n              <th style=\"width:28%\">THREAT</th>\n              <th style=\"width:28%\">FREQUENCY OF<br>OCCURRENCE (%)</th>\n              <th style=\"width:28%\">YOY GROWTH (%)</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr><td>1</td><td>Phishing Attacks</td><td>35%</td><td>15%</td></tr>\n            <tr><td>2</td><td>Ransomware</td><td>25%</td><td>10%</td></tr>\n            <tr><td>3</td><td>Insider Threats</td><td>18%</td><td>8%</td></tr>\n            <tr><t