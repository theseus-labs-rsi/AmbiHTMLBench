        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Materia Alba, Dental Plaque and Calculus Comparison</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$','$']], displayMath: [['$$','$$']] }\n};\n</script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  html, body {\n    margin: 0;\n    padding: 0;\n  }\n  body {\n    background: linear-gradient(135deg, #8c8a93 0%, #6f6d78 35%, #8b8992 60%, #57555f 100%);\n    font-family: \"Gill Sans\", \"Trebuchet MS\", Arial, sans-serif;\n    width: 1024px;\n    height: 768px;\n    position: relative;\n    overflow: hidden;\n  }\n  .slide {\n    width: 1024px;\n    height: 768px;\n    position: relative;\n  }\n  .table-frame {\n    position: absolute;\n    left: 18px;\n    top: 122px;\n    width: 988px;\n    height: 578px;\n    background: #000;\n    padding: 10px;\n    box-sizing: border-box;\n  }\n  .table-inner {\n    background: #ffffff;\n    width: 100%;\n    height: 100%;\n    display: flex;\n    box-sizing: border-box;\n  }\n  .col {\n    box-sizing: border-box;\n    padding: 14px 10px 10px 10px;\n  }\n  .col1 { width: 39%; border-right: 1px solid #b8b8b8; }\n  .col2 { width: 34%; border-right: 1px solid #b8b8b8; }\n  .col3 { width: 27%; }\n\n  .col h2 {\n    font-size: 21px;\n    font-weight: normal;\n    color: #3a3a3a;\n    margin: 4px 0 12px 4px;\n    padding-bottom: 10px;\n    letter-spacing: 0.2px;\n  }\n  .col1 h2, .col2 h2, .col3 h2 {\n    border-bottom: 1px solid #cfcfcf;\n    margin-right: -10px;\n    margin-left: -10px;\n    padding-left: 14px;\n  }\n  .col ul {\n    list-style: none;\n    margin: 0;\n    padding: 0 4px 0 4px;\n  }\n  .col li {\n    position: relative;\n    padding-left: 24px;\n    margin-bottom: 6px;\n    font-size: 22px;\n    line-height: 1.35;\n    color: #333;\n  }\n  .col li:before {\n    content: \"\\2022\";\n    position: absolute;\n    left: 4px;\n    top: -1px;\n    font-size: 16px;\n    color: #444;\n  }\n  .col3 ul {\n    margin-top: 78px;\n  }\n  .citation {\n    position: absolute;\n    left: 78px;\n    top: 706px;\n    color: #ffd21f;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 26px;\n  }\n  .footer {\n    position: absolute;\n    left: 0;\n    top: 734px;\n    width: 1024px;\n    color: #f2f2f2;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 17px;\n  }\n  .footer .date { position: absolute; left: 56px; }\n  .footer .center { position: absolute; left: 442px; }\n  .footer .page { position: absolute; left: 950px; }\n</style>\n</head>\n<body>\n<div class=\"slide\">\n\n  <div class=\"table-frame\">\n    <div class=\"table-inner\">\n\n      <div class=\"col col1\">\n        <h2>Materia Alba</h2>\n        <ul>\n          <li>White cheeselike accumulation</li>\n          <li>A soft accumulation of salivary proteins, some bacteria, many desquamated epithelial cells, and occasional disintegrating food debris</li>\n          <li>Lacks an organized structure and is therefore not as complex as dental plaque</li>\n          <li>Easily displaced with a water spray</li>\n        </ul>\n      </div>\n\n      <div class=\"col col2\">\n        <h2>Dental Plaque</h2>\n        <ul>\n          <li>Resilient clear to yellow-grayish substance</li>\n          <li>Primarily composed of bacteria in a matrix of salivary glycoproteins and extracellular polysaccharides</li>\n          <li>Considered to be a biofilm</li>\n          <li>Impossible to remove by rinsing or the use of sprays</li>\n        </ul>\n      </div>\n\n      <div class=\"col col3\">\n        <h2>Calculus</h2>\n        <ul>\n          <li>Hard deposit that forms by mineralization of dental plaque</li>\n          <li>Generally covered by a layer of unmineralized dental plaque</li>\n        </ul>\n      </div>\n\n    </div>\n  </div>\n\n  <div class=\"citation\">Carranza 11<sup>th</sup> edition</div>\n\n  <div class=\"footer\">\n    <span class=\"date\">12/27/2011</span>\n    <span class=\"center\">DENTAL PAQUE</span>\n    <span class=\"page\">17</span>\n  </div>\n\n</div>\n</body>\n</html>"
