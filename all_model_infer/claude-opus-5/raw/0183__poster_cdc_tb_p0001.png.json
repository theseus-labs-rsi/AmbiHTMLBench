        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>STOP TB — CDC Poster (Publication Number: 6474)</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] }\n};\n</script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    background: #ffffff;\n    font-family: \"Segoe UI\", \"Open Sans\", Arial, Helvetica, sans-serif;\n    color: #1a1a1a;\n  }\n  .poster {\n    width: 1000px;\n    margin: 0 auto;\n    background: #ffffff;\n  }\n  .placeholder {\n    background: #f2f2f2;\n    border: 1px dashed #9a9a9a;\n    color: #555;\n    font-size: 11px;\n    text-align: center;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 4px;\n    line-height: 1.2;\n  }\n\n  /* ---------- Banner ---------- */\n  .banner {\n    background: #b8221e;\n    padding: 18px 0 26px;\n    text-align: center;\n  }\n  .banner .title {\n    color: #ffffff;\n    font-size: 132px;\n    font-weight: 700;\n    letter-spacing: 4px;\n    line-height: 1;\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n  }\n  .banner .octagon {\n    width: 130px;\n    height: 130px;\n    border: 6px solid #ffffff;\n    background: #b8221e;\n    clip-path: polygon(30% 0%, 70% 0%, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0% 70%, 0% 30%);\n    color: #ffdada;\n    font-size: 11px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    font-weight: 400;\n    letter-spacing: 0;\n  }\n\n  /* ---------- Section 1 (white) ---------- */\n  .sec1 {\n    display: flex;\n    align-items: flex-start;\n    padding: 30px 0 0 0;\n  }\n  .sec1 .txt { width: 42%; padding: 30px 20px 20px 40px; }\n  .sec1 h2 {\n    font-size: 33px;\n    font-weight: 400;\n    line-height: 1.25;\n    margin: 0 0 18px;\n  }\n  .sec1 .art { width: 58%; display: flex; align-items: flex-start; gap: 8px; padding-top: 0; }\n\n  ul.bullets { list-style: none; margin: 0; padding: 0; }\n  ul.bullets li {\n    position: relative;\n    padding-left: 14px;\n    margin-bottom: 12px;\n    font-size: 15.5px;\n    line-height: 1.45;\n  }\n  ul.bullets li:before {\n    content: \"•\";\n    position: absolute;\n    left: 0;\n  }\n\n  /* ---------- Section 2 (orange) ---------- */\n  .sec2 {\n    background: #f0a01e;\n    display: flex;\n    align-items: flex-start;\n    padding: 0;\n  }\n  .sec2 .art { width: 36%; display: flex; align-items: flex-start; }\n  .sec2 .txt { width: 64%; padding: 34px 30px 30px 0; }\n  .sec2 h2 {\n    font-size: 30px;\n    font-weight: 400;\n    line-height: 1.28;\n    margin: 0 0 20px;\n    color: #1a1a1a;\n  }\n  .sec2 .called {\n    font-size: 25px;\n    color: #b8221e;\n    font-weight: 400;\n    margin: 0 0 22px;\n  }\n  .sec2 ul.bullets li { font-size: 15px; margin-bottom: 16px; }\n\n  /* ---------- Section 3 (white, two columns) ---------- */\n  .sec3 { display: flex; align-items: flex-start; padding: 28px 0 0 0; }\n  .sec3 .left { width: 47%; padding: 10px 24px 0 40px; }\n  .sec3 h2 {\n    font-size: 31px;\n    font-weight: 400;\n    line-height: 1.28;\n    margin: 0 0 18px;\n  }\n  .sec3 ul.bullets li { font-size: 17px; margin-bottom: 16px; line-height: 1.42; }\n\n  .symptoms {\n    width: 53%;\n    border: 3px solid #24478f;\n    padding: 16px 14px 18px;\n    margin-right: 22px;\n  }\n  .symptoms h3 {\n    text-align: center;\n    font-size: 22px;\n    margin: 0 0 14px;\n    font-weight: 700;\n  }\n  .sym-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 14px 8px;\n  }\n  .sym {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n  }\n  .sym .placeholder { width: 92px; height: 92px; }\n  .sym .cap {\n    font-size: 11.5px;\n    font-weight: 700;\n    margin-top: 8px;\n    line-height: 1.25;\n  }\n  .sym .cap em { font-weight: 400; }\n\n  /* ---------- Section 4 (blue) ---------- */\n  .sec4 {\n    background: #9dc2dd;\n    display: flex;\n    align-items: flex-end;\n    padding: 0;\n    position: relative;\n  }\n  .sec4 .art { width: 46%; }\n  .sec4 .txt { width: 54%; padding: 60px 40px 40px 0; }\n  .sec4 h2 {\n    font-size: 34px;\n    font-weight: 400;\n    line-height: 1.3;\n    margin: 0;\n    color: #12314f;\n  }\n  .cdc-logo {\n    margin: 26px 0 0 auto;\n    width: 300px;\n    height: 78px;\n    background: #ffffff;\n    border: 2px solid #24478f;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    padding: 6px 8px;\n    font-size: 10px;\n  }\n  .cdc-logo .mark { width: 110px; height: 60px; font-size: 10px; }\n  .cdc-logo .words { color: #24478f; line-height: 1.25; }\n  .cdc-logo .words strong { font-size: 11px; display: block; }\n\n  /* ---------- Footer ---------- */\n  .footer {\n    background: #b8221e;\n    color: #ffffff;\n    padding: 12px 0 12px 40px;\n    font-size: 15px;\n  }\n</style>\n</head>\n<body>\n<div class=\"poster\">\n\n  <!-- Banner -->\n  <div class=\"banner\">\n    <div class=\"title\">\n      <span>ST</span><span class=\"octagon\">[Icon: lungs inside stop-sign octagon replacing the letter O]</span><span>P&nbsp;TB</span>\n    </div>\n  </div>\n\n  <!-- Section 1 -->\n  <div class=\"sec1\">\n    <div class=\"txt\">\n      <h2>Tuberculosis (TB) <strong>spreads through the air</strong> from one person to another.</h2>\n      <ul class=\"bullets\">\n        <li>TB germs spread when a person with infectious TB disease <strong>coughs, speaks, or sings.</strong></li>\n        <li>TB germs usually <strong>attack the lungs</strong> but can also move to any part of the body.</li>\n      </ul>\n    </div>\n    <div class=\"art\">\n      <div class=\"placeholder\" style=\"width:190px;height:180px;margin-top:60px;\">[Illustration: lungs with TB germs on orange square, left of the figures]</div>\n      <div class=\"placeholder\" style=\"width:340px;height:280px;\">[Illustration: man coughing airborne TB germs toward a woman, with lung callout at right]</div>\n    </div>\n  </div>\n\n  <!-- Section 2 -->\n  <div class=\"sec2\">\n    <div class=\"art\">\n      <div class=\"placeholder\" style=\"width:340px;height:255px;background:#f0a01e;border-color:#8a5a00;color:#4a3000;\">[Illustration: man in overalls with circular lung callout showing TB germs, top-left of orange band]</div>\n    </div>\n    <div class=\"txt\">\n      <h2>TB germs can live in the body <strong>without making you sick.</strong></h2>\n      <p class=\"called\">This is called <strong>latent TB infection</strong> or <strong>inactive TB.</strong></p>\n      <ul class=\"bullets\">\n        <li>TB germs can live in your body for years without causing symptoms. Without treatment, <strong>inactive TB can develop into active TB disease and make you sick.</strong></li>\n        <li>If you have inactive TB, you can take TB medicine to <strong>prevent the development of active TB disease</strong> even if you do not feel sick.</li>\n      </ul>\n    </div>\n  </div>\n\n  <!-- Section 3 -->\n  <div class=\"sec3\">\n    <div class=\"left\">\n      <h2>If your body cannot stop TB germs from growing, <strong>you develop active TB disease.</strong></h2>\n      <ul class=\"bullets\">\n        <li>You may <strong>feel sick</strong> and <strong>spread TB germs</strong> to your family, friends, and others around you.</li>\n        <li>You need to <strong>take and finish all your TB medicine</strong> to help you feel better and prevent other people from getting sick.</li>\n      </ul>\n      <div class=\"placeholder\" style=\"width:400px;height:190px;margin-top:26px;\">[Illustration: woman in headscarf talking with a doctor, bottom-left]</div>\n    </div>\n\n    <div class=\"symptoms\">\n      <h3>Symptoms of active TB disease:</h3>\n      <div class=\"sym-grid\">\n        <div class=\"sym\">\n          <div class=\"placeholder\">[Icon: person coughing]</div>\n          <div class=\"cap\">Cough lasting<br>3+ weeks</div>\n        </div>\n        <div class=\"sym\">\n          <div class=\"placeholder\">[Icon: person coughing into tissue]</div>\n          <div class=\"cap\">Coughing up blood or sputum <em>(phlegm from deep inside the lungs)</em></div>\n        </div>\n        <div class=\"sym\">\n          <div class=\"placeholder\">[Icon: person holding chest]</div>\n          <div class=\"cap\">Chest pain</div>\n        </div>\n        <div class=\"sym\">\n          <div class=\"placeholder\">[Icon: tired person]</div>\n          <div class=\"cap\">Weakness<br>or fatigue</div>\n        </div>\n        <div class=\"sym\">\n          <div class=\"placeholder\">[Icon: person refusing food]</div>\n          <div class=\"cap\">No appetite</div>\n        </div>\n        <div class=\"sym\">\n          <div class=\"placeholder\">[Icon: scale with downward arrow]</div>\n          <div class=\"cap\">Weight loss</div>\n        </div>\n        <div class=\"sym\">\n          <div class=\"placeholder\">[Icon: person with thermometer]</div>\n          <div class=\"cap\">Fever and/or chills</div>\n        </div>\n        <div class=\"sym\">\n          <div class=\"placeholder\">[Icon: sweating person with moon]</div>\n          <div class=\"cap\">Night sweats</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Section 4 -->\n  <div class=\"sec4\">\n    <div class=\"art\">\n      <div class=\"placeholder\" style=\"width:100%;height:230px;background:#9dc2dd;border-color:#3f6f95;color:#12314f;\">[Illustration: woman and doctor behind a table of medicine bottles, bottom-left]</div>\n    </div>\n    <div class=\"txt\">\n      <h2>Take and finish all of your TB medicine to <strong>kill TB germs</strong> and <strong>STOP TB!</strong></h2>\n      <div class=\"cdc-logo\">\n        <div class=\"placeholder mark\">[Logo: HHS seal + CDC]</div>\n        <div class=\"words\">\n          <strong>Centers for Disease</strong>\n          <strong>Control and Prevention</strong>\n          National Center for HIV,<br>\n          Viral Hepatitis, STD, and<br>\n          TB Prevention\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Footer -->\n  <div class=\"footer\">Publication Number: 6474</div>\n\n</div>\n</body>\n</html>"
