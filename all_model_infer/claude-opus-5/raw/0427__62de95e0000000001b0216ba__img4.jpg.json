box-top .l3 { text-align: right; }\n\n  .yellow-zone {\n    position: relative;\n    background: #f2f24a;\n    border: 2px solid #111;\n    border-top: none;\n    padding: 26px 10px 14px 10px;\n    min-height: 200px;\n  }\n  .fist {\n    position: absolute;\n    width: 46px; height: 46px;\n    border: 2px solid #111;\n    border-radius: 50%;\n  }\n  .fist.left { background: #3b4bd8; left: 6px; top: 96px; }\n  .fist.right { background: #f2568f; right: 6px; top: 90px; }\n\n  .slogan {\n    background: #111;\n    color: #fff;\n    display: block;\n    text-align: center;\n    font-weight: 900;\n    letter-spacing: 3px;\n    padding: 5px 6px;\n    margin: 0 auto 10px auto;\n  }\n  .slogan.s1 { width: 190px; font-size: 17px; }\n  .slogan.s2 { width: 96px;  font-size: 17px; }\n  .slogan.s3 { width: 218px; font-size: 16px; letter-spacing: 1px; }\n\n  .pk-zone {\n    position: relative;\n    height: 210px;\n    border: 2px solid #111;\n    border-top: none;\n    background: linear-gradient(180deg,#f2f24a 0%,#f2f24a 40%,#b7f000 40%,#b7f000 100%);\n    overflow: hidden;\n  }\n  .pk-word {\n    position: absolute;\n    top: 18px; left: 22px;\n    font-size: 86px;\n    font-weight: 900;\n    color: #6b5bd6;\n    -webkit-text-stroke: 3px #111;\n    letter-spacing: -4px;\n    line-height: 1;\n  }\n  .pk-banner {\n    position: absolute;\n    left: -6px;\n    bottom: 14px;\n    width: 262px;\n    background: #3b4bd8;\n    border: 2px solid #111;\n    color: #fff;\n    font-weight: 900;\n    font-size: 20px;\n    letter-spacing: 1px;\n    padding: 6px 8px;\n    transform: rotate(-8deg);\n    text-align: center;\n  }\n  .pk-banner .white { color: #fff; }\n\n  .box-rules {\n    border: 2px solid #111;\n    border-top: none;\n    padding: 8px 8px 10px 8px;\n    font-size: 11.5px;\n    line-height: 1.9;\n  }\n  .box-rules .rules-title {\n    text-align: center;\n    font-weight: 900;\n    font-size: 14px;\n    letter-spacing: 2px;\n    margin-bottom: 4px;\n  }\n  .rules-body { display: flex; gap: 6px; }\n  .rules-icons {\n    width: 16px;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-around;\n    align-items: center;\n    font-size: 11px;\n  }\n  .rules-lines { flex: 1; text-align: center; }\n\n  .box-bottom {\n    border: 2px solid #111;\n    border-top: none;\n    padding: 8px;\n    font-size: 12px;\n    line-height: 2.1;\n  }\n  .box-bottom .r1 { text-align: right; padding-right: 20px; }\n  .tag-winner {\n    display: inline-block;\n    background: #f2f24a;\n    border: 2px solid #111;\n    font-weight: 900;\n    font-size: 13px;\n    padding: 1px 8px;\n    transform: rotate(-4deg);\n  }\n  .box-bottom .r2 {\n    text-align: right;\n    font-weight: 900;\n    font-size: 13.5px;\n  }\n  .box-bottom .r3 { display: flex; justify-content: space-between; align-items: center; }\n  .box-bottom .r3 .excl { font-weight: 900; letter-spacing: 2px; }\n  .box-bottom .r3 .q { font-weight: 900; font-size: 13.5px; }\n\n  /* ---- Right column ---- */\n  .rings-zone {\n    position: relative;\n    height: 230px;\n    background: #b7f000;\n  }\n  .ring {\n    position: absolute;\n    border: 16px solid #6b5bd6;\n    border-radius: 50%;\n    color: #cfe9ff;\n    font-size: 9px;\n    font-weight: 700;\n  }\n  .ring.r1 { width: 150px; height: 108px; right: 10px; top: 6px; }\n  .ring.r2 { width: 150px; height: 108px; right: 26px; top: 62px; }\n  .ring.r3 { width: 150px; height: 108px; right: 6px; top: 120px; }\n  .ring-text {\n    position: absolute;\n    inset: -14px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 9px;\n    color: #dfe9ff;\n    letter-spacing: 1px;\n    pointer-events: none;\n  }\n  .ring-label {\n    position: absolute;\n    color: #e6f0ff;\n    font-size: 9.5px;\n    font-weight: 700;\n    letter-spacing: 1px;\n  }\n  .rl1 { right: 30px; top: 12px; }\n  .rl2 { right: 46px; top: 74px; }\n  .rl3 { right: 28px; top: 152px; }\n\n  .stars { text-align: right; padding: 4px 6px 