entation:upright;\n    font-size:15px;\n    letter-spacing:6px;\n    margin-top:120px;\n  }\n  .pagenum{\n    position:absolute;\n    right:4px;\n    bottom:70px;\n    font-size:14px;\n  }\n  .placeholder{\n    border:1px dashed #999;\n    color:#666;\n    font-size:9px;\n    text-align:center;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    box-sizing:border-box;\n  }\n  .orn-top{\n    width:26px;height:26px;border-radius:50%;\n    position:absolute;top:0;right:6px;\n  }\n  .orn-bar{\n    width:24px;height:10px;\n    position:absolute;right:8px;\n  }\n  .orn-bottom{\n    width:26px;height:26px;border-radius:50%;\n    position:absolute;bottom:0;right:6px;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n <div class=\"frame\">\n  <div class=\"inner\">\n\n   <div class=\"verses\">\n\n    <div class=\"line\">\n      <div class=\"cell\"><span class=\"py\">guāng wǔ xīng</span><span class=\"hz\">光武兴，</span></div>\n      <div class=\"cell\"><span class=\"py\">wéi dōng hàn</span><span class=\"hz\">为东汉。</span></div>\n      <div class=\"cell\"><span class=\"py\">sì bǎi nián</span><span class=\"hz\">四百年，</span></div>\n      <div class=\"cell\"><span class=\"py\">zhōng yú xiàn</span><span class=\"hz\">终于献。</span></div>\n    </div>\n\n    <div class=\"line\">\n      <div class=\"cell\"><span class=\"py\">wèi shǔ wú</span><span class=\"hz\">魏蜀吴，</span></div>\n      <div class=\"cell\"><span class=\"py\">zhēng hàn dǐng</span><span class=\"hz\">争汉鼎。</span></div>\n      <div class=\"cell\"><span class=\"py\">hào sān guó</span><span class=\"hz\">号三国，</span></div>\n      <div class=\"cell\"><span class=\"py\">qì liǎng jìn</span><span class=\"hz\">迄两晋。</span></div>\n    </div>\n\n    <div class=\"line\">\n      <div class=\"cell\"><span class=\"py\">sòng qí jì</span><span class=\"hz\">宋齐继，</span></div>\n      <div class=\"cell\"><span class=\"py\">liáng chén chéng</span><span class=\"hz\">梁陈承。</span></div>\n      <div class=\"cell\"><span class=\"py\">wéi nán cháo</span><span class=\"hz\">为南朝，</span></div>\n      <div class=\"cell\"><span class=\"py\">dū jīn líng</span><span class=\"hz\">都金陵。</span></div>\n    </div>\n\n    <div class=\"line\">\n      <div class=\"cell\"><span class=\"py\">běi yuán wèi</span><span class=\"hz\">北元魏，</span></div>\n      <div class=\"cell\"><span class=\"py\">fēn dōng xī</span><span class=\"hz\">分东西。</span></div>\n      <div class=\"cell\"><span class=\"py\">yǔ wén zhōu</span><span class=\"hz\">宇文周，</span></div>\n      <div class=\"cell\"><span class=\"py\">yǔ gāo qí</span><span class=\"hz\">与高齐。</span></div>\n    </div>\n\n    <div class=\"line\">\n      <div class=\"cell\"><span class=\"py\">dài zhì suí</span><span class=\"hz\">迨至隋，</span></div>\n      <div class=\"cell\"><span class=\"py\">yì tǔ yǔ</span><span class=\"hz\">一土宇。</span></div>\n      <div class=\"cell\"><span class=\"py\">bú zài chuán</span><span class=\"hz\">不再传，</span></div>\n      <div class=\"cell\"><span class=\"py\">shī tǒng xù</span><span class=\"hz\">失统绪。</span></div>\n    </div>\n\n    <div class=\"line\">\n      <div class=\"cell\"><span class=\"py\">táng gāo zǔ</span><span class=\"hz\">唐高祖，</span></div>\n      <div class=\"cell\"><span class=\"py\">qǐ yì shī</span><span class=\"hz\">起义师。</span></div>\n      <div class=\"cell\"><span class=\"py\">chú suí luàn</span><span class=\"hz\">除隋乱，</span></div>\n      <div class=\"cell\"><span class=\"py\">chuàng guó jī</span><span class=\"hz\">创国基。</span></div>\n    </div>\n\n    <div class=\"line\">\n      <div class=\"cell\"><span class=\"py\">èr shí chuán</span><span class=\"hz\">二十传，</span></div>\n      <div class=\"cell\"><span class=\"py\">sān bǎi zǎi</span><span class=\"hz\">三百载。</span></div>\n      <div class=\"cell\"><span class=\"py\">liáng miè zhī</span><span class=\"hz\">梁灭之，</span></div>\n      <div class=\"cell\"><span class=\"py\">guó nǎi gǎi</span><span class=\"hz\">国乃改。</span></div>\n    </div>\n\n    <div class=\"line\">\n      <div class=\"cell\"><span class=\"py\">liáng táng jìn</span><span class=\"hz\">梁唐晋，</span></div>\n      <div class=\"cell\"><span class=\"py\">jí hàn zhōu</span><span class=\"hz\">及汉周。</span></div>\n      <div class=\"cell\"><span class=\"py\">chēng wǔ dài</span><span class=\"hz\">称五代，</span></div>\n      <div class=\"cell\"><span class=\"py\">jiē yǒu yóu</span><span class=\"hz\">皆有由。</span></div>\n    </div>\n\n    <div class=\"line\">\n      <div class=\"cell\"><span class=\"py\">yán sòng xīng</span><span class=\"hz\">炎宋兴，</span></div>\n      <div class=\"cell\"><span class=\"py\">shòu zhōu shàn</span><span class=\"hz\">受周禅。</span></div>\n      <div class=\"cell\"><span class=\"py\">shí bā chuán</span><span class=\"hz\">十八传，</span></div>\n      <div class=\"cell\"><span class=\"py\">nán běi hùn</span><span class=\"hz\">南北混。</span></div>\n    </div>\n\n    <div class=\"line\">\n      <div class=\"cell\"><span class=\"py\">liáo yǔ jīn</span><span class=\"hz\">辽与金，</span></div>\n      <div class=\"cell\"><span class=\"py\">dì hào fēn</span><span class=\"hz\">帝号纷。</span></div>\n      <div class=\"cell\"><span class=\"py\">dài miè liáo</span><span class=\"hz\">迨灭辽，</span></div>\n      <div class=\"cell\"><span class=\"py\">sòng yóu cún</span><span class=\"hz\">宋犹存。</span></div>\n    </div>\n\n    <div class=\"line\">\n      <div class=\"cell\"><span class=\"py\">zhì yuánxīng</span><span class=\"hz\">至元兴，</span></div>\n      <div class=\"cell\"><span class=\"py\">jīn xù xiē</span><span class=\"hz\">金绪歇。</span></div>\n      <div class=\"cell\"><span class=\"py\">yǒu sòng shì</span><span class=\"hz\">有宋世，</span></div>\n      <div class=\"cell\"><span class=\"py\">yì tóng miè</span><span class=\"hz\">一同灭。</span></div>\n    </div>\n\n    <div class=\"line\">\n      <div class=\"cell\"><span class=\"py\">bìng zhōng guó</span><span class=\"hz\">并中国，</span></div>\n      <div class=\"cell\"><span class=\"py\">jiān róng dí</span><span class=\"hz\">兼戎狄。</span></div>\n      <div class=\"cell\"><span class=\"py\">jiǔ shí niàn</span><span class=\"hz\">九十年，</span></div>\n      <div class=\"cell\"><span class=\"py\">guó zuò fèi</span><span class=\"hz\">国祚废。</span></div>\n    </div>\n\n    <div class=\"line\">\n      <div class=\"cell\"><span class=\"py\">míng tài zǔ</span><span class=\"hz\">明太祖，</span></div>\n      <div class=\"cell\"><span class=\"py\">jiǔ qīn shī</span><span class=\"hz\">久亲师。</span></div>\n      <div class=\"cell\"><span class=\"py\">chuán jiàn wén</span><span class=\"hz\">传建文，</span></div>\n      <div class=\"cell\"><span class=\"py\">fāng sì sì</span><span class=\"hz\">方四祀。</span></div>\n    </div>\n\n    <div class=\"line\">\n      <div class=\"cell\"><span class=\"py\">qiān běi jīng</span><span class=\"hz\">迁北京，</span></div>\n      <div class=\"cell\"><span class=\"py\">yǒng lè sì</span><span class=\"hz\">永乐嗣。</span></div>\n      <div class=\"cell\"><span class=\"py\">dài chóng zhēn</span><span class=\"hz\">迨崇祯，</span></div>\n      <div class=\"cell\"><span class=\"py\">méi shān shì</span><span class=\"hz\">煤山逝。</span></div>\n    </div>\n\n    <div class=\"line\">\n      <div class=\"cell\"><span class=\"py\">qīng tài zǔ</span><span class=\"hz\">清太祖，</span></div>\n      <div class=\"cell\"><span class=\"py\">yīng jǐng mìng</span><span class=\"hz\">膺景命。</span></div>\n      <div class=\"cell\"><span class=\"py\">jìng sì fāng</span><span class=\"hz\">靖四方，</span></div>\n      <div class=\"cell\"><span class=\"py\">kè dà dìng</span><span class=\"hz\">克大定。</span></div>\n    </div>\n\n   </div>\n\n   <div class=\"sidebar\">\n     <div class=\"placeholder orn-top\">[Ornament: circular floral motif, top-right]</div>\n     <div class=\"placeholder orn-bar\" style=\"top:34px;\">[Rule]</div>\n\n     <div class=\"side-sub\">国学君子吟　幸福家国兴</div>\n     <div class=\"side-title\">三字经</div>\n\n     <div class=\"pagenum\">三</div>\n     <div class=\"placeholder orn-bar\" style=\"bottom:34px;\">[Rule]</div>\n     <div class=\"placeholder orn-bottom\">[Ornament: c