        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>历史笔记 — 苏联经济、资本主义经济、全球化趋势</title>\n<script src=\"https://polyfill.io/v3/polyfill.min.js?features=es6\"></script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<script>\nwindow.MathJax = {\n  tex: {\n    inlineMath: [['$', '$']],\n    displayMath: [['$$', '$$']]\n  }\n};\n</script>\n<style>\n  html, body {\n    margin: 0;\n    padding: 0;\n    background: #efefee;\n  }\n  body {\n    font-family: \"SimSun\", \"Songti SC\", serif;\n    font-size: 13.5px;\n    color: #1b1b1b;\n    line-height: 1.75;\n  }\n  .page {\n    position: relative;\n    width: 540px;\n    min-height: 720px;\n    margin: 0 auto;\n    background: #f2f1ef;\n    padding: 28px 26px 20px 46px;\n    box-sizing: border-box;\n    overflow: hidden;\n  }\n  /* left edge vertical text of the facing page */\n  .left-edge {\n    position: absolute;\n    left: 2px;\n    top: 20px;\n    width: 22px;\n    height: 260px;\n    font-size: 9px;\n    color: #8a8a8a;\n    writing-mode: vertical-rl;\n    text-orientation: mixed;\n    letter-spacing: 2px;\n    overflow: hidden;\n  }\n  .timestamp {\n    position: absolute;\n    left: 10px;\n    bottom: 40px;\n    writing-mode: vertical-rl;\n    text-orientation: mixed;\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 11px;\n    color: #6f6f6f;\n    letter-spacing: 1px;\n  }\n  h2.section {\n    font-weight: bold;\n    font-size: 14.5px;\n    margin: 18px 0 6px 0;\n    letter-spacing: 1px;\n  }\n  ol.numbered {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n  }\n  ol.numbered > li {\n    display: flex;\n    align-items: flex-start;\n    margin-bottom: 2px;\n  }\n  .num {\n    flex: 0 0 40px;\n    text-align: left;\n  }\n  .num.circled {\n    color: #b4501e;\n  }\n  .yr {\n    flex: 0 0 108px;\n  }\n  .txt {\n    flex: 1 1 auto;\n  }\n  .cont {\n    padding-left: 148px;\n  }\n  .cont2 {\n    padding-left: 196px;\n  }\n  .cont3 {\n    padding-left: 118px;\n  }\n  .highlight-red {\n    color: #b4501e;\n  }\n  .loose {\n    padding-left: 40px;\n    margin-top: 4px;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"left-edge\">[illegible: 装订线处竖排手写文字]</div>\n  <div class=\"timestamp\">2021.07.28 23:57</div>\n\n  <ol class=\"numbered\">\n    <li><span class=\"num circled\">（1）</span><span class=\"yr\">1918—1921</span><span class=\"txt\">战时共产主义政策（余粮收集制）</span></li>\n    <li><span class=\"num circled\">（2）</span><span class=\"yr\">1921—1927</span><span class=\"txt\">新经济政策（粮食税，利用市场和商品货币关系发展生产）</span></li>\n    <li><span class=\"num\">（3）</span><span class=\"yr\">1928—1932</span><span class=\"txt\">第一个五年计划（优先发展重工业）</span></li>\n    <li><span class=\"num\">（4）</span><span class=\"yr\">1929—1937</span><span class=\"txt\">农业集体化（为保证国家工业化建设的顺利进行）</span></li>\n    <li><span class=\"num\">（5）</span><span class=\"yr\">1933—1937</span><span class=\"txt\">第二个五年计划（成为世界第二大工业强国）</span></li>\n    <li><span class=\"num\">（6）</span><span class=\"yr\">1991</span><span class=\"txt\">苏联解体，两极（冷战）格局瓦解&nbsp;&nbsp;1947 年杜鲁门主义冷战开始，马歇尔计划，1949 年北约，</span></li>\n  </ol>\n  <div class=\"cont3\">1955 年华沙条约美苏两极格局形成</div>\n\n  <h2 class=\"section\">资本主义经济：</h2>\n  <ol class=\"numbered\">\n    <li><span class=\"num\">（1）</span><span class=\"yr\">1929—1933</span><span class=\"txt\">以美国为首的资本主义国家爆发经济大危机</span></li>\n    <li><span class=\"num\">（2）</span><span class=\"yr\">20 世纪 30 年代</span><span class=\"txt\">罗斯福新政，开创了资本主义国家干预经济发展的新模式</span></li>\n    <li><span class=\"num\">（3）</span><span class=\"yr\" style=\"flex:0 0 210px;\">20 世纪 50 年代—20 世纪 60 年代末</span><span class=\"txt\">美国经济“黄金时代”（凯恩斯主义，政府运用经济手段对国民</span></li>\n  </ol>\n  <div class=\"cont2\">经济积极干预）</div>\n  <ol class=\"numbered\">\n    <li><span class=\"num\">（4）</span><span class=\"yr\" style=\"flex:0 0 130px;\">20 世纪 70 年代</span><span class=\"txt\">美国经济陷入“滞胀”（凯恩斯主义失灵））</span></li>\n    <li><span class=\"num\">（5）</span><span class=\"yr\" style=\"flex:0 0 130px;\">20 世纪 70 年代</span><span class=\"txt\">美国经济回升（货币学派和供给学派）</span></li>\n    <li><span class=\"num\">（6）</span><span class=\"yr\" style=\"flex:0 0 130px;\">20 世纪 80 年代</span><span class=\"txt\">“新经济”时代（“宏观调控、微观自主”，既反对完全自由放任，又反对过度的政</span></li>\n  </ol>\n  <div class=\"cont2\">府干预</div>\n\n  <h2 class=\"section\">全球化趋势</h2>\n  <ol class=\"numbered\">\n    <li><span class=\"num\">（1）</span><span class=\"yr\" style=\"flex:0 0 60px;\">1944</span><span class=\"txt\">布雷顿森林体系（美元与黄金直接挂钩，是以美元为中心的资本</span></li>\n  </ol>\n  <div style=\"padding-left:150px;\">主义世界货币体系）</div>\n  <ol class=\"numbered\">\n    <li><span class=\"num\">（2）</span><span class=\"yr\" style=\"flex:0 0 60px;\">1945</span><span class=\"txt\">世界银行建立（WB）；国际货币基金组织建立（IMF）</span></li>\n    <li><span class=\"num\">（3）</span><span class=\"yr\" style=\"flex:0 0 60px;\">1948</span><span class=\"txt\">关税与贸易总协定</span></li>\n    <li><span class=\"num\">（4）</span><span class=\"yr\" style=\"flex:0 0 60px;\">1967</span><span class=\"txt\">欧洲共同体成立（经济一体化）</span></li>\n    <li><span class=\"num\">（5）</span><span class=\"yr\" style=\"flex:0 0 60px;\">1993</span><span class=\"txt\">欧盟成立（经济政治一体化）</span></li>\n    <li><span class=\"num\">（6）</span><span class=\"yr\" style=\"flex:0 0 60px;\">1999</span><span class=\"txt\">欧元问世</span></li>\n    <li><span class=\"num\">（7）</span><span class=\"yr\" style=\"flex:0 0 60px;\">1995</span><span class=\"txt\">“关贸总协定”发展为“世界贸易组织”（WTO）</span></li>\n  </ol>\n  <div class=\"loose\">1960 年被称作非洲年</div>\n\n</div>\n</body>\n</html>"
