#fff;\n    font-weight: 700;\n    font-size: 15px;\n    padding: 12px 14px;\n    text-align: right;\n  }\n  thead th.left { text-align: left; }\n\n  /* GHG table (left page) */\n  .t-ghg tbody td {\n    border-bottom: 1px solid #b9dff5;\n    padding: 26px 14px;\n    text-align: center;\n    vertical-align: middle;\n  }\n  .t-ghg tbody td.name {\n    text-align: left;\n    line-height: 1.7;\n  }\n  .t-ghg tbody tr:last-child td { border-bottom: 1px solid #b9dff5; }\n\n  /* Other env table (right page) */\n  .t-env td {\n    border-bottom: 1px solid #cfe8f7;\n    padding: 11px 14px;\n    vertical-align: middle;\n  }\n  .t-env td.cat {\n    background: #eaf6fd;\n    color: #0093dd;\n    border-right: 1px solid #cfe8f7;\n    width: 20%;\n    vertical-align: middle;\n  }\n  .t-env td.item { width: 46%; }\n  .t-env td.unit { width: 16%; }\n  .t-env td.val { text-align: right; width: 18%; }\n\n  sup { font-size: 0.66em; }\n\n  /* ---------- Footnotes ---------- */\n  .notes {\n    margin-top: auto;\n    padding-top: 18px;\n    font-size: 12.5px;\n    line-height: 1.85;\n    color: #333;\n    position: relative;\n  }\n  .notes::before {\n    content: \"\";\n    display: block;\n    width: 190px;\n    border-top: 1px solid #555;\n    margin-bottom: 12px;\n  }\n  .notes p { margin: 0 0 6px 0; }\n\n  .folio {\n    margin-top: 34px;\n    font-size: 15px;\n    color: #4a4a4a;\n  }\n  .folio.right { text-align: right; }\n</style>\n</head>\n<body>\n\n<div class=\"spread\">\n\n  <!-- ================= LEFT PAGE (143) ================= -->\n  <section class=\"page\">\n    <div class=\"runhead\">2024 · 美的集团ESG报告</div>\n\n    <h1 class=\"apx-title\">附录三 关键绩效数据表</h1>\n\n    <div><span class=\"pill\">温室气体排放数据</span></div>\n\n    <table class=\"t-ghg\">\n      <thead>\n        <tr>\n          <th class=\"left\" style=\"width:40%\">指标名称</th>\n          <th style=\"width:20%\">2024年</th>\n          <th style=\"width:20%\">2023年</th>\n          <th style=\"width:20%\">2022年</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td class=\"name\">温室气体排放总量（范围1+2）<br>（吨二氧化碳当量）</td>\n          <td>2,203,472</td>\n          <td>2,298,311</td>\n          <td>1,505,877</td>\n        </tr>\n        <tr>\n          <td class=\"name\">温室气体排放强度<br>（吨二氧化碳当量/万元产值）</td>\n          <td>0.055</td>\n          <td>0.061</td>\n          <td>/</td>\n        </tr>\n        <tr>\n          <td class=\"name\">范围1<sup>25</sup>温室气体排放</td>\n          <td>681,036</td>\n          <td>1,017,606</td>\n          <td>129,400</td>\n        </tr>\n        <tr>\n          <td class=\"name\">范围2<sup>26</sup>温室气体排放</td>\n          <td>1,522,436</td>\n          <td>1,280,705</td>\n          <td>1,376,477</td>\n        </tr>\n        <tr>\n          <td class=\"name\">范围3<sup>27</sup>温室气体排放</td>\n          <td>196,247,729</td>\n          <td>4,960,000</td>\n          <td>/</td>\n        </tr>\n        <tr>\n          <td class=\"name\">范围3 - 类别1采购的产品与服务</td>\n          <td>8,494,973</td>\n          <td>/</td>\n          <td>/</td>\n        </tr>\n        <tr>\n          <td class=\"name\">范围3 - 类别4 上游运输</td>\n          <td>1,340,856</td>\n          <td>/</td>\n          <td>/</td>\n        </tr>\n        <tr>\n          <td class=\"name\">范围3 - 类别11 已售出产品使用</td>\n          <td>186,411,900</td>\n          <td>4,960,000</td>\n          <td>/</td>\n        </tr>\n        <tr>\n          <td class=\"name\">温室气体排放总量（范围1+2+3）<br>（吨二氧化碳当量）</td>\n          <td>198,451,201</td>\n          <td>7,258,311</td>\n          <td>1,505,877</td>\n        </tr>\n      </tbody>\n    </table>\n\n    <div class=\"notes\">\n      <p><sup>25</sup> 范围1温室气体主要来自于固定生产设备、移动源及食堂等化石能源消耗和产品制造过程中冷媒逸散等。</p>\n      <p><sup>26</sup> 范围2温室气体包括外购电力、热力。以上排放源活动数据来源于费用发票、生产报表等。电力碳排放因子取自生态环境部《关于发布2022年电力二氧化碳排放因子的公告》及国际能源署《IEA Emission Factors 2022》，外购热力排放系数参考国家发展改革委《企业温室气体排放核算方法与报告指南（试行）》。采购物料的碳排放因子取自 ecoinvent 3.8数据库。其他碳排放系数参考 IPCC 2006 年《国家温室气体清单编制指南（试行）》等。</p>\n      <p><sup>27</sup> 2024年度较往年范围3温室气体排放源新增统计了采购的产品与服务、上游运输，且进一步完善了已售出产品品类。</p>\n    </div>\n\n    <div class=\"folio\">143</div>\n  </section>\n\n  <!-- ================= RIGHT PAGE (144) ================= -->\n  <section class=\"page\">\n    <div class=\"runhead-right\">\n      <span>关于本报告</span>\n      <span>走进美的</span>\n      <span>可持续发展治理</span>\n      <span>守护蓝色星球</span>\n      <span>构建和谐社区</span>\n      <span>践行科技尽善</span>\n      <span>共创繁荣生态</span>\n      <span class=\"active\">附录</span>\n    </div>\n\n    <div><span class=\"pill\">其他环境数据</span></div>\n\n    <table class=\"t-env\">\n      <thead>\n        <tr>\n          <th class=\"left\" colspan=\"2\">指标名称</th>\n          <th class=\"left\">单位</th>\n          <th>2024年</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td class=\"cat\" rowspan=\"5\">废气排放</td>\n          <td class=\"item\">废气排放总量</td>\n          <td class=\"unit\">吨</td>\n          <td class=\"val\">388.79</td>\n        </tr>\n        <tr>\n          <td class=\"item\">氮氧化物（NOx）排放量</td>\n          <td class=\"unit\">吨</td>\n          <td class=\"val\">56.58</td>\n        </tr>\n        <tr>\n          <td class=\"item\">硫氧化物（SOX）排放量</td>\n          <td class=\"unit\">吨</td>\n          <td class=\"val\">45.60</td>\n        </tr>\n        <tr>\n          <td class=\"item\">挥发性有机化合物（VOC）</td>\n          <td class=\"unit\">吨</td>\n          <td class=\"val\">165.47</td>\n        </tr>\n        <tr>\n          <td class=\"item\">颗粒物质（PM）</td>\n          <td class=\"unit\">吨</td>\n          <td class=\"val\">119.99</td>\n        </tr>\n\n        <tr>\n          <td class=\"cat\" rowspan=\"5\">废弃物</td>\n          <td class=\"item\">有害废弃物总量</td>\n          <td class=\"unit\">吨</td>\n          <td class=\"val\">20,451.20</td>\n        </tr>\n        <tr>\n          <td class=\"item\">有害废弃物强度</td>\n          <td class=\"unit\">吨/万元产值</td>\n          <td class=\"val\">0.0005</td>\n        </tr>\n        <tr>\n          <td class=\"item\">一般固废总量</td>\n          <td class=\"unit\">吨</td>\n          <td class=\"val\">729,790.00</td>\n        </tr>\n        <tr>\n          <td class=\"item\">一般固废强度</td>\n          <td class=\"unit\">吨/万元产值</td>\n          <td class=\"val\">0.0182</td>\n        </tr>\n        <tr>\n          <td class=\"item\">一般固废回收利用量</td>\n          <td class=\"unit\">吨</td>\n          <td class=\"val\">19,811.00</td>\n        </tr>\n\n        <tr>\n          <td class=\"cat\" rowspan=\"8\">能源使用<sup>28</sup></td>\n          <td class=\"item\">综合能源消耗总量</td>\n          <td class=\"unit\">千个千瓦时</td>\n          <td class=\"val\">3,528,346.64</td>\n        </tr>\n        <tr>\n          <td class=\"item\">直接能源消耗总量</td>\n          <td class=\"unit\">千个千瓦时</td>\n          <td class=\"val\">748,516.55</td>\n        </tr>\n        <tr>\n          <td class=\"item\">间接能源消耗总量</td>\n          <td class=\"unit\">千个千瓦时</td>\n          <td class=\"val\">2,779,830.09</td>\n        </tr>\n        <tr>\n          <td class=\"item\">能耗强度</td>\n          <td class=\"unit\">千个千瓦时/万元产值</td>\n          <td class=\"val\">0.088</td>\n        </tr>\n        <tr>\n          <td class=\"item\">汽油耗量</td>\n          <td class=\"unit\">升</td>\n          <td class=\"val\">67,721.00</td>\n        </tr>\n        <tr>\n          <td class=\"item\">柴油耗量</td>\n          <td class=\"unit\">升</td>\n          <td class=\"val\">279,583.00</td>\n        </tr>\n        <tr>\n          <td class=\"item\">压缩/管道天然气耗量</td>\n          <td class=\"unit\">立方米</td>\n          <td class=\"val\">68,895,974.49</td>\n        </tr>\n\n        <tr>\n          <td class=\"cat\" rowspan=\"2\">水资源使用</td>\n          <td class=\"item\">总耗水量</td>\n          <td class=\"unit\">吨</td>\n          <td class=\"val\">23,862,429.00</td>\n        </tr>\n        <tr>\n          <td class=\"item\">总耗水强度</td>\n          <td class=\"unit\">吨/万元产值</td>\n          <td class=\"val\">0.5966</td>\n        </tr>\n\n        <tr>\n          <td class=\"cat\" rowspan=\"2\">包装材料使用<sup>29</sup></td>\n          <td class=\"item\">总使用量</td>\n          <td class=\"unit\">吨</td>\n          <td class=\"val\">655,836.00</td>\n        </tr>\n        <tr>\n          <td class=\"item\">使用密度</td>\n          <td class=\"unit\">吨/万元产值</td>\n          <td class=\"val\">0.0164</td>\n        </tr>\n      </tbody>\n    </table>\n\n    <div class=\"notes\">\n      <p><sup>28</sup> 2024年，本集团消耗的能源类型包括固定设备燃料耗用、公务车燃油、员工食堂燃料、外购电力、外购热力，以上数据来源为相关燃料发票或生产报表；能耗系数参考国际能源署提供的转换因子以及国家《GB/T 2589-2020 综合能耗计算通则》。</p>\n      <p><sup>29</sup> 包装材料包括瓦楞纸、特种纸等纸质材料。</p>\n    </div>\n\n    <div class=\"folio right\">144</div>\n  </section>\n\n</div>\n\n</body>\n</html>"
