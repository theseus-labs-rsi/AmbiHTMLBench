        "role": "assistant",
        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>宝宝米粉添加指南</title>\n<script src=\"https://polyfill.io/v3/polyfill.min.js?features=es6\"></script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<script>\nwindow.MathJax = {\n  tex: {inlineMath: [['$','$']], displayMath: [['$$','$$']]}\n};\n</script>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    padding: 14px;\n    font-family: \"PingFang SC\", \"Microsoft YaHei\", \"Heiti SC\", sans-serif;\n    background: linear-gradient(160deg,#f7a24a 0%,#f5c86a 40%,#f4b45c 100%);\n  }\n  .page {\n    background: #fdf6e6;\n    border-radius: 18px;\n    padding: 14px 12px 18px;\n    max-width: 560px;\n    margin: 0 auto;\n    position: relative;\n  }\n  /* ---------- Title ---------- */\n  .title-band {\n    position: relative;\n    text-align: center;\n    padding: 10px 0 14px;\n  }\n  .blobs { height: 26px; position: relative; }\n  .blob {\n    position: absolute; border-radius: 50%; opacity: .85;\n  }\n  .b1 { width: 60px; height: 46px; background: #f6b8c8; left: 12%; top: -6px; }\n  .b2 { width: 74px; height: 52px; background: #bfe3f5; left: 34%; top: -12px; }\n  .b3 { width: 62px; height: 46px; background: #f8d98a; left: 58%; top: -6px; }\n  .b4 { width: 48px; height: 40px; background: #cfeacb; left: 76%; top: -2px; }\n  h1 {\n    position: relative;\n    margin: 0;\n    font-size: 34px;\n    letter-spacing: 2px;\n    color: #f0682f;\n    -webkit-text-stroke: 1px #ffffff;\n    text-shadow: 3px 3px 0 #ffffff, 5px 5px 0 rgba(240,104,47,.25);\n  }\n  /* ---------- Grid ---------- */\n  .grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 12px;\n  }\n  .panel {\n    border-radius: 12px;\n    padding: 8px 8px 12px;\n  }\n  .p1 { background: #ffe9d0; }\n  .p2 { background: #fdf3c9; }\n  .p3 { background: #fdf3c9; }\n  .p4 { background: #ffe0d2; }\n  .head {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    margin-bottom: 8px;\n  }\n  .num {\n    flex: 0 0 auto;\n    width: 26px; height: 26px;\n    border-radius: 50%;\n    background: #ec5a3c;\n    color: #fff;\n    font-size: 15px; font-weight: 700;\n    display: flex; align-items: center; justify-content: center;\n    border: 2px solid #fff;\n  }\n  .head h2 {\n    margin: 0;\n    font-size: 18px;\n    color: #e2551f;\n    background: #fff7dc;\n    border-radius: 6px;\n    padding: 3px 8px;\n    flex: 1 1 auto;\n    letter-spacing: 1px;\n    -webkit-text-stroke: .3px #fff;\n    text-shadow: 1px 1px 0 #fff;\n  }\n  .p3 .head h2, .p4 .head h2 { color: #e0821c; }\n  .card {\n    background: #ffffff;\n    border-radius: 10px;\n    padding: 8px 9px;\n    font-size: 10.5px;\n    line-height: 1.6;\n    color: #4a3a2e;\n  }\n  .intro { margin: 0 0 8px; }\n  /* stage blocks (panel 1) */\n  .stage { position: relative; margin-bottom: 10px; }\n  .stage-title {\n    display: inline-block;\n    background: #fbe2a0;\n    color: #d2521c;\n    font-weight: 700;\n    font-size: 11px;\n    border-radius: 4px;\n    padding: 2px 8px;\n    margin-bottom: 3px;\n  }\n  .stage p { margin: 0; padding-right: 46px; }\n  .stage-icon {\n    position: absolute;\n    right: 0; top: 0;\n  }\n  /* placeholders */\n  .placeholder {\n    background: #eef3f7;\n    border: 1px dashed #9db4c4;\n    border-radius: 6px;\n    color: #6a7d8b;\n    font-size: 7px;\n    line-height: 1.2;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    padding: 2px;\n  }\n  .ph-stage { width: 44px; height: 40px; }\n  .ph-row { width: 54px; height: 34px; flex: 0 0 auto; }\n  .ph-small { width: 30px; height: 34px; flex: 0 0 auto; }\n  /* benefit list (panel 2) */\n  .benefit {\n    display: flex;\n    align-items: flex-start;\n    gap: 6px;\n    margin-bottom: 9px;\n  }\n  .benefit .txt { flex: 1 1 auto; }\n  .benefit b { display: block; color: #d2521c; font-size: 11px; font-weight: 700; }\n  .benefit p { margin: 0; }\n  /* select list (panel 3) */\n  .select-item { display: flex; gap: 6px; align-items: flex-start; margin-bottom: 9px; }\n  .select-item .txt { flex: 1 1 auto; }\n  .select-item b { display: block; color: #d2521c; font-size: 11px; }\n  .select-item p { margin: 0; }\n  /* notes grid (panel 4) */\n  .notes {\n    display: grid;\n    grid-template-columns: 1fr 1fr 1fr;\n    gap: 6px;\n  }\n  .note {\n    background: #fff;\n    border-radius: 8px;\n    padding: 6px 5px;\n    font-size: 9px;\n    line-height: 1.5;\n    color: #4a3a2e;\n  }\n  .note p { margin: 0 0 5px; }\n  .icons { display: flex; align-items: flex-end; justify-content: center; gap: 4px; }\n  .mark { font-size: 8px; font-weight: 700; text-align: center; }\n  .no { color: #e03b3b; }\n  .yes { color: #2f9e44; }\n  .icon-col { display: flex; flex-direction: column; align-items: center; gap: 2px; }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"title-band\">\n    <div class=\"blobs\">\n      <span class=\"blob b1\"></span>\n      <span class=\"blob b2\"></span>\n      <span class=\"blob b3\"></span>\n      <span class=\"blob b4\"></span>\n    </div>\n    <h1>宝宝米粉添加指南</h1>\n  </div>\n\n  <div class=\"grid\">\n\n    <!-- ===== Panel 1 ===== -->\n    <section class=\"panel p1\">\n      <div class=\"head\">\n        <div class=\"num\">1</div>\n        <h2>不同阶段宝宝米粉选择</h2>\n      </div>\n      <div class=\"card\">\n        <p class=\"intro\">每个阶段宝宝对辅食的营养需求会存在差异，根据宝宝生长发育选择分阶段米粉，为宝宝提供更精准更科学的营养。</p>\n\n        <div class=\"stage\">\n          <div class=\"stage-icon placeholder ph-stage\">[Icon: 阶段1 坐姿宝宝 / Sitting]</div>\n          <span class=\"stage-title\">第一阶段：宝宝坐起来了</span>\n          <p>宝宝可以辅助靠垫坐起——这时添加1阶米粉。<br>\n          1段米粉含铁高，颗粒细腻好吸收。<br>\n          适应后可添加蔬菜泥和水果泥。</p>\n        </div>\n\n        <div class=\"stage\">\n          <div class=\"stage-icon placeholder ph-stage\">[Icon: 阶段2 咬嚼宝宝 / Chewing]</div>\n          <span class=\"stage-title\">第二阶段：宝宝爱咬了</span>\n          <p>宝宝萌牙期——这时可添加2阶米粉。<br>\n          2段米粉在1段基础上会添加一些蔬果颗粒，用以启蒙咀嚼，另外维生素D可促进钙吸收。</p>\n        </div>\n\n        <div class=\"stage\">\n          <div class=\"stage-icon placeholder ph-stage\">[Icon: 阶段3 爬行宝宝 / Crawling]</div>\n          <span class=\"stage-title\">第三阶段：宝宝爬行了</span>\n          <p>宝宝就会爬行——这时可添加3阶米粉。<br>\n          3阶米粉相比2阶米粉添加了多种更大的蔬果颗粒，以此强化锻炼宝宝咀嚼力，并且多种食材搭配，口感丰富，更能激发宝宝食欲，让宝宝爱上吃饭。</p>\n        </div>\n      </div>\n    </section>\n\n    <!-- ===== Panel 2 ===== -->\n    <section class=\"panel p2\">\n      <div class=\"head\">\n        <div class=\"num\">2</div>\n        <h2>宝宝吃米粉的好处</h2>\n      </div>\n      <div class=\"card\">\n        <div class=\"benefit\">\n          <div class=\"txt\">\n            <b>1、补充肉类中不足的营养</b>\n            <p>添加米粉解决了，及时补充母乳中铁和维生素D的不足。</p>\n          </div>\n          <div class=\"placeholder ph-row\">[Icon: Fe / VD 圆形标签与米粉碗]</div>\n        </div>\n\n        <div class=\"benefit\">\n          <div class=\"txt\">\n            <b>2、训练宝宝的吞咽能力</b>\n            <p>宝宝可以从吮吸状、细软的食品开始，逐步适应、接受成年人吃的固体食物。</p>\n          </div>\n          <div class=\"placeholder ph-row\">[Illustration: 手部与食物]</div>\n        </div>\n\n        <div class=\"benefit\">\n          <div class=\"txt\">\n            <b>3、为断奶做准备</b>\n            <p>辅食逐渐取代乳类，让宝宝逐渐由吸食乳类变为用成年人的方式咀嚼食物。</p>\n          </div>\n          <div class=\"placeholder ph-row\">[Illustration: 宝宝头像与碗]</div>\n        </div>\n\n        <div class=\"benefit\">\n          <div class=\"txt\">\n            <b>4、开启宝宝智力</b>\n            <p>添加辅食会给宝宝多种刺激，使得[illegible]，逐渐达到[illegible]的过程。</p>\n          </div>\n          <div class=\"placeholder ph-row\">[Illustration: 大脑与勺子]</div>\n        </div>\n\n        <div class=\"benefit\">\n          <div class=\"txt\">\n            <b>5、训练咀嚼能力</b>\n            <p>及时添加辅食有利于训练宝宝的咀嚼能力，有利于颌骨的发育和牙齿的萌出。</p>\n          </div>\n          <div class=\"placeholder ph-row\">[Illustration: 宝宝侧脸与牙齿]</div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ===== Panel 3 ===== -->\n    <section class=\"panel p3\">\n      <div class=\"head\">\n        <div class=\"num\">3</div>\n        <h2>如何挑选宝宝米粉</h2>\n      </div>\n      <div class=\"card\">\n        <div class=\"select-item\">\n          <div class=\"txt\">\n            <b>1、选择品牌产品</b>\n            <p>建议选择大品牌、口碑好的产品，其质量相对而言更有保障。</p>\n          </div>\n          <div class=\"placeholder ph-row\">[Illustration: 米粉包装盒]</div>\n        </div>\n\n        <div class=\"select-item\">\n          <div class=\"txt\">\n            <b>2、查看产品标识</b>\n            <p>看一看正常商品应该有的标识是否齐全，宝宝产品特有的标识以及说明是否印在包装上。</p>\n          </div>\n          <div class=\"placeholder ph-row\">[Icon: 认证标志]</div>\n        </div>\n\n        <div class=\"select-item\">\n          <div class=\"txt\">\n            <b>3、查阅营养成分表</b>\n            <p>查看的具体营养成分及其含量是否在合理范围内。</p>\n          </div>\n          <div class=\"placeholder ph-row\">[Illustration: 营养成分表]</div>\n        </div>\n\n        <div class=\"select-item\">\n          <div class=\"txt\">\n            <b>4、查看包装说明</b>\n            <p>查看介绍上是否有提示性说明，比如断奶期补充食物等。</p>\n          </div>\n        </div>\n\n        <div class=\"select-item\">\n          <div class=\"txt\">\n            <b>5、看颜色与气味</b>\n            <p>正常是米白色，大小均匀，香味纯正，散发米粉独有的香味，且无其他异味。</p>\n          </div>\n          <div class=\"placeholder ph-row\">[Illustration: 米粉与碗]</div>\n        </div>\n\n        <div class=\"select-item\">\n          <div class=\"txt\">\n            <b>6、看组织形态和冲调性</b>\n            <p>其性状松散无结块，冲调后为泥糊状。</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ===== Panel 4 ===== -->\n    <section class=\"panel p4\">\n      <div class=\"head\">\n        <div class=\"num\">4</div>\n        <h2>宝宝吃米粉的注意事项</h2>\n      </div>\n      <div class=\"notes\">\n\n        <div class=\"note\">\n          <p>1、冲调米粉水温不宜过高，用[illegible]的水温，冲调水温约40-50度的温水即可。</p>\n          <div class=\"icons\">\n            <div class=\"icon-col\">\n              <div class=\"placeholder ph-small\">[Icon: 温度计 高温]</div>\n              <span class=\"mark no\">✗ No</span>\n            </div>\n            <div class=\"icon-col\">\n              <div class=\"placeholder ph-small\">[Icon: 温度计 适温]</div>\n              <span class=\"mark yes\">✓ Yes</span>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"note\">\n          <p>2、喂米粉时需要专用的碗和小勺，不要使用奶瓶。</p>\n          <div class=\"icons\">\n            <div class=\"icon-col\">\n              <div class=\"placeholder ph-small\">[Icon: 奶瓶]</div>\n              <span class=\"mark no\">✗ No</span>\n            </div>\n            <div class=\"icon-col\">\n              <div class=\"placeholder ph-small\">[Icon: 碗与勺]</div>\n              <span class=\"mark yes\">✓ Yes</span>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"note\">\n          <p>3、选择营养素含量多的配方米粉，不添加蔗糖和食盐。</p>\n          <div class=\"icons\">\n            <div class=\"icon-col\">\n              <div class=\"placeholder ph-small\">[Icon: 糖与盐]</div>\n              <span class=\"mark no\">✗ No</span>\n            </div>\n            <div class=\"icon-col\">\n              <div class=\"placeholder ph-small\">[Icon: 营养素包装]</div>\n              <span class=\"mark yes\">✓ Yes</span>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"note\">\n          <p>4、不宜把米粉当成正餐，以免无法满足婴儿生长发育需要。</p>\n          <div class=\"icons\">\n            <div class=\"placeholder ph-small\">[Icon: 米粉碗]</div>\n            <span class=\"mark\">→</span>\n            <div class=\"placeholder ph-small\">[Icon: 米粉碗]</div>\n          </div>\n        </div>\n\n        <div class=\"note\">\n          <p>5、调制米粉应先稀后逐渐增加稠度。</p>\n          <div class=\"icons\">\n            <div class=\"placeholder ph-small\">[Icon: 稀米糊碗]</div>\n            <span class=\"mark\">→</span>\n            <div class=\"placeholder ph-small\">[Icon: 稠米糊碗]</div>\n          </div>\n        </div>\n\n        <div class=\"note\">\n          <p>6、宝宝满1-2个月，宝宝适应后慢慢增加到3-4次，每天喂1-2次。</p>\n          <div class=\"icons\">\n            <div class=\"placeholder ph-small\">[Icon: 勺子]</div>\n            <div class=\"placeholder ph-small\">[Icon: 勺子]</div>\n          </div>\n        </div>\n\n      </div>\n    </section>\n\n  </div>\n</div>\n</body>\n</html>"
      },
