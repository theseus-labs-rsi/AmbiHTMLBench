archbox .btn {\n    width: 34px;\n    border-left: 1px solid #d1d9e0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #59636e;\n    background: #f6f8fa;\n  }\n  .header-right {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    margin-left: auto;\n  }\n  .icon-btn {\n    width: 32px; height: 32px;\n    border: 1px solid #d1d9e0;\n    border-radius: 6px;\n    display: flex; align-items: center; justify-content: center;\n    color: #1f2328;\n    font-size: 15px;\n  }\n  .signup {\n    border: 1px solid #d1d9e0;\n    border-radius: 6px;\n    padding: 6px 16px;\n    font-size: 14px;\n    font-weight: 500;\n  }\n\n  /* ---------- Hero ---------- */\n  .hero {\n    position: relative;\n    background: #f6f8fa;\n    height: 340px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n    border-bottom: 1px solid #e5e8eb;\n  }\n  .hero h1 {\n    font-size: 68px;\n    font-weight: 400;\n    margin: 0 0 18px 0;\n    letter-spacing: -1px;\n  }\n  .hero p {\n    margin: 0;\n    font-size: 20px;\n    color: #59636e;\n  }\n  .placeholder {\n    position: absolute;\n    border: 1px dashed #b8c0c8;\n    color: #6e7781;\n    font-size: 12px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    background: rgba(255,255,255,0.35);\n  }\n  .art-left {\n    left: 0; bottom: 0;\n    width: 440px; height: 330px;\n  }\n  .art-right {\n    right: 0; top: 0;\n    width: 320px; height: 340px;\n  }\n\n  /* ---------- Category grid ---------- */\n  .container {\n    max-width: 1320px;\n    margin: 0 auto;\n    padding: 0 118px;\n  }\n  .cat-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    column-gap: 32px;\n    row-gap: 68px;\n    padding-top: 48px;\n  }\n  .cat h2 {\n    font-size: 24px;\n    font-weight: 600;\n    margin: 0 0 20px 0;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n  .cat h2 .ico { font-size: 18px; color: #1f2328; }\n  .cat ul {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n  }\n  .cat li { margin-bottom: 12px; font-size: 15px; }\n  .ext { font-size: 11px; }\n\n  /* ---------- Bottom two-column ---------- */\n  .bottom {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    column-gap: 46px;\n    padding-top: 110px;\n    padding-bottom: 40px;\n  }\n  .bottom h3 {\n    font-size: 16px;\n    font-weight: 400;\n    margin: 0 0 22px 0;\n    color: #1f2328;\n  }\n  .article {\n    border-top: 1px solid #d1d9e0;\n    padding: 16px 12px 20px 12px;\n  }\n  .article a.title {\n    font-size: 16px;\n    font-weight: 600;\n    display: inline-block;\n    margin-bottom: 8px;\n  }\n  .article p {\n    margin: 0;\n    font-size: 14px;\n    color: #1f2328;\n    line-height: 1.5;\n  }\n</style>\n</head>\n<body>\n\n<header class=\"topbar\">\n  <div class=\"brand\"><span class=\"mark\"></span>GitHub Docs</div>\n  <div class=\"divider\"></div>\n  <div class=\"version\"><strong>Version:</strong> Free, Pro, &amp; Team <span class=\"caret\">&#9662;</span></div>\n  <div class=\"searchbox\">\n    <div class=\"field\">Search or ask &#9881; Copilot</div>\n    <div class=\"btn\">&#128269;</div>\n  </div>\n  <div class=\"header-right\">\n    <div class=\"icon-btn\">&#127760;</div>\n    <div class=\"divider\"></div>\n    <div class=\"signup\">Sign up</div>\n  </div>\n</header>\n\n<section class=\"hero\">\n  <div class=\"placeholder art-left\">[Illustration: pink abstract 3D shapes, bottom-left]</div>\n  <div class=\"placeholder art-right\">[Illustration: green, purple, and magenta abstract 3D shapes, top-right]</div>\n  <h1>GitHub Docs</h1>\n  <p>Help for wherever you are on your GitHub journey.</p>\n</section>\n\n<div class=\"container\">\n  <div class=\"cat-grid\">\n\n    <div class=\"cat\">\n      <h2><span class=\"ico\">&#128640;</span>Get started</h2>\n      <ul>\n        <li><a href=\"#\">Get started</a></li>\n    