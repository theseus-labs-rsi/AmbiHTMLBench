        "content": "<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>佛教的创立与传播</title>\n<script>\nwindow.MathJax = {\n  tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']] }\n};\n</script>\n<script id=\"MathJax-script\" async src=\"https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js\"></script>\n<style>\n  body {\n    margin: 0;\n    padding: 0;\n    background: #f7f5f0;\n    font-family: \"Songti SC\", \"SimSun\", serif;\n  }\n  .page {\n    position: relative;\n    width: 540px;\n    height: 720px;\n    margin: 0 auto;\n    background: #fdfcf8;\n    box-sizing: border-box;\n    padding: 12px;\n    overflow: hidden;\n  }\n  /* Vertical text flows right-to-left as in the original scan */\n  .vertical {\n    writing-mode: vertical-rl;\n    text-orientation: upright;\n    -webkit-writing-mode: vertical-rl;\n  }\n  .columns {\n    display: flex;\n    flex-direction: row;\n    height: 100%;\n    align-items: flex-start;\n  }\n  .col-right {\n    writing-mode: vertical-rl;\n    -webkit-writing-mode: vertical-rl;\n    height: 660px;\n    font-size: 14px;\n    line-height: 2.0;\n    letter-spacing: 1px;\n    margin-left: 8px;\n  }\n  .col-left {\n    writing-mode: vertical-rl;\n    -webkit-writing-mode: vertical-rl;\n    height: 660px;\n    font-size: 14px;\n    line-height: 2.0;\n    letter-spacing: 1px;\n  }\n  .highlight {\n    background: #ffe9a8;\n  }\n  .handwriting {\n    color: #7a4fc0;\n    font-family: \"Kaiti SC\", \"KaiTi\", cursive;\n    font-size: 16px;\n    letter-spacing: 2px;\n  }\n  .section-head {\n    display: inline-flex;\n    align-items: center;\n    font-weight: bold;\n    font-size: 15px;\n    letter-spacing: 2px;\n  }\n  .icon {\n    display: inline-block;\n    width: 22px;\n    height: 22px;\n    border-radius: 50%;\n    background: #b23a48;\n    color: #fff;\n    text-align: center;\n    line-height: 22px;\n    font-size: 12px;\n    margin-bottom: 6px;\n  }\n  .think-block {\n    font-size: 13px;\n    line-height: 2.1;\n    color: #333;\n  }\n  .placeholder {\n    border: 1px solid #999;\n    background: #dfe6ea;\n    color: #444;\n    font-size: 11px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    font-family: sans-serif;\n    writing-mode: horizontal-tb;\n  }\n  .photo {\n    position: absolute;\n    left: 12px;\n    bottom: 12px;\n    width: 96px;\n    height: 300px;\n  }\n  .arrow-line {\n    color: #7a4fc0;\n    font-family: \"Kaiti SC\", \"KaiTi\", cursive;\n    font-size: 15px;\n    letter-spacing: 1px;\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <div class=\"columns\">\n\n    <!-- Rightmost column: heading area -->\n    <div class=\"col-right\" style=\"width:120px;\">\n      <div style=\"font-weight:bold;\">\n        创始人<br>\n        创始人乔达摩·悉<br>\n        达多，后来被称为“释迦牟尼”。\n      </div>\n    </div>\n\n    <!-- Main body column -->\n    <div class=\"col-left\" style=\"width:150px;\">\n      释迦牟尼创立佛教<br>\n      时间 佛教约在公元前6世纪。<br>\n      早期佛教反对第一等级婆罗门的特权，提出“众\n      <span class=\"highlight\">生平等”，不拒绝低种姓的人入教；同时，佛教宣</span>\n      扬“忍耐顺从”，得到国王和一些富人的支持。信\n      仰佛教的民众日益增多，佛教一度成为印度最重要\n      的宗教之一①。\n    </div>\n\n    <!-- Spread / transmission column -->\n    <div class=\"col-left\" style=\"width:150px;\">\n      传播 公元前3世纪后，佛教开始向外传播。公元前\n      1世纪，佛教经中亚传到中国新疆，再传入中国内\n      地，后又传到朝鲜、日本和越南等国。佛教往南经\n      锡兰②，传到缅甸、泰国、柬埔寨等国。\n    </div>\n\n    <!-- Handwritten annotation column -->\n    <div class=\"col-left\" style=\"width:110px;\">\n      <div class=\"handwriting\">印度 ⇒ 中亚 ⇒ 中国 ⇒ 朝鲜、日本、越南</div>\n      <div class=\"arrow-line\" style=\"margin-left:10px;\">斯里兰卡 ⇒ 缅甸、泰国、柬埔寨</div>\n    </div>\n\n    <!-- Left column: 问题思考 and 人物扫描 -->\n    <div class=\"col-left\" style=\"width:130px;\">\n      <div class=\"section-head\"><span class=\"icon\">?</span>问题思考</div>\n      <div class=\"think-block\">\n        古代印度是佛教艺术\n        对